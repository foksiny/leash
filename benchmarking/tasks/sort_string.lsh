fnc quicksort(v vec<string>, lo int, hi int) : void {
    if lo >= hi { return; }
    pivot: string = v.get(lo + (hi - lo) / 2);
    i: int = lo;
    j: int = hi;
    while i <= j {
        while v.get(i) < pivot { i = i + 1; }
        while v.get(j) > pivot { j = j - 1; }
        if i <= j {
            tmp: string = v.get(i);
            v.set(i, v.get(j));
            v.set(j, tmp);
            i = i + 1;
            j = j - 1;
        }
    }
    if lo < j { quicksort(v, lo, j); }
    if i < hi { quicksort(v, i, hi); }
}

fnc main() {
    n: int = 5000;
    v: vec<string>;
    state: int<64> = 123456789;
    for r: int = 0; r < n; r = r + 1 {
        state = state * 1103515245 + 12345;
        len: int = 5 + ((state >> 8) % 11);
        s: string = "";
        for c: int = 0; c < len; c = c + 1 {
            state = state * 1103515245 + 12345;
            ch: char = (char)(97 + ((state >> 10) % 26));
            s = s + ch;
        }
        v.pushb(s);
    }
    quicksort(v, 0, v.size - 1);
    total: int<64> = 0;
    dups: int = 0;
    for i: int = 0; i < v.size; i = i + 1 {
        s2: string = v.get(i);
        for k: int = 0; k < s2.bsize; k = k + 1 {
            total = total + (int<64>)s2[k] * (i + 1);
        }
        if i > 0 && v.get(i) == v.get(i - 1) { dups = dups + 1; }
    }
    show(n, " ", total, " ", dups);
}
