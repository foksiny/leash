// Tiny two-layer MLP inference benchmark (no external ML framework).
// One hidden layer with a smooth activation, one output neuron, and a
// small batch of samples. The same public output is produced by the
// Python reference task so the benchmark can compare speed and code size.

fnc activate(x float) : float {
    // tanh-like smooth activation without library calls.
    if x > 12.0 { return 1.0; }
    if x < -12.0 { return -1.0; }
    ax: float = x < 0.0 ? 0.0 - x : x;
    return x / (1.0 + ax * 0.25);
}

fnc predict(x float, w0 float, w1 float, w2 float, b0 float, b1 float) : float {
    h0: float = activate(x * w0 + b0);
    h1: float = activate(x * w1 + b0 * 0.5);
    return activate(h0 * w2 + h1 * (w2 * 0.75) + b1);
}

fnc main() {
    w0: float = 0.31;
    w1: float = -0.17;
    w2: float = 0.53;
    b0: float = 0.07;
    b1: float = -0.03;

    sum: float = 0.0;
    n: int = 4000;
    i: int = 0;
    while i < n {
        x: float = tofloat(float, (i % 32) - 16) / 16.0;
        y: float = predict(x, w0, w1, w2, b0, b1);
        sum = sum + y;
        i = i + 1;
    }
    show("ai_mlp n=", n, " mean=", sum / tofloat(float, n));
}
