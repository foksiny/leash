fnc quicksort(v vec<int>, lo int, hi int) : void {
    if lo >= hi { return; }
    pivot: int = v.get(lo + (hi - lo) / 2);
    i: int = lo;
    j: int = hi;
    while i <= j {
        while v.get(i) < pivot { i = i + 1; }
        while v.get(j) > pivot { j = j - 1; }
        if i <= j {
            tmp: int = v.get(i);
            v.set(i, v.get(j));
            v.set(j, tmp);
            i = i + 1;
            j = j - 1;
        }
    }
    if lo < j { quicksort(v, lo, j); }
    if i < hi { quicksort(v, i, hi); }
}

fnc main() {
    n: int = 50000;
    v: vec<int>;
    for i: int = n - 1; i >= 0; i = i - 1 {
        // descending input worst case for pivot
        v.pushb((i * 131 + 12345 + (i % 97)) % 1000003);
    }
    quicksort(v, 0, v.size - 1);
    sum: int<64> = 0;
    for i: int = 0; i < v.size; i = i + 1 {
        sum = sum + (int<64>)v.get(i) * (int<64>)(i + 1);
    }
    show("sort_int n=", n, " sum=", sum);
}
