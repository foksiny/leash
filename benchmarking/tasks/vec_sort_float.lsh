fnc quicksort(v vec<float>, lo int, hi int) : void {
    if lo >= hi { return; }
    pivot: float = v.get(lo + (hi - lo) / 2);
    i: int = lo;
    j: int = hi;
    while i <= j {
        while v.get(i) < pivot { i = i + 1; }
        while v.get(j) > pivot { j = j - 1; }
        if i <= j {
            tmp: float = v.get(i);
            v.set(i, v.get(j));
            v.set(j, tmp);
            i = i + 1;
            j = j - 1;
        }
    }
    if lo < j { quicksort(v, lo, j); }
    if i < hi { quicksort(v, i, hi); }
}

fnc main() {
    n: int = 20000;
    v: vec<float>;
    for i: int = 0; i < n; i = i + 1 {
        v.pushb((float)(i % 997) / 7.0 + (float)((i / 997) % 3) * 0.5);
    }
    quicksort(v, 0, v.size - 1);
    checksum: int<64> = 0;
    for i: int = 0; i < v.size; i = i + 1 {
        k: int = v.get(i) * 1000 + 1;
        checksum = checksum + (k % 10007) * (i + 1);
    }
    show(n, " ", checksum);
}
