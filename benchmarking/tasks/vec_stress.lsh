fnc main() {
    v: vec<int>;
    n: int = 200000;
    for i: int = 0; i < n; i = i + 1 {
        v.pushb((i * 131 + 12345 + (i % 97)) % 1000003);
    }
    sum: int<64> = 0;
    for i: int = 0; i < v.size; i = i + 1 {
        sum = sum + (int<64>)v.get(i);
    }
    popped: int = v.popb();
    show("vec_stress n=", n, " sum=", sum, " size=", v.size, " popped=", popped);
}
