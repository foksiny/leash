use ast::*;

// AST-level constant folding / dead-code elimination (Stage 2 quality parity).
// Port of the core of leash/ast_optimize.py to Leash. In-place mutation on class nodes.

pub def Optimizer : class {
    pub macros: hash<string, MacroDef>;   // zero-arg macros (post-import)
    pub macro_depth: int;

    // Deep copy of an expression node tree (macro bodies are shared, every
    // use site needs its own copy before mutation).
    pub fnc copy_expr(e Expr) : Expr {
        if e == null { return e; }
        if e.kind == ExprKind.IDENT || e.kind == ExprKind.INT || e.kind == ExprKind.FLOAT
           || e.kind == ExprKind.STRING || e.kind == ExprKind.CHAR
           || e.kind == ExprKind.BOOL || e.kind == ExprKind.NIL {
            return e;
        }
        if e.kind == ExprKind.BINOP {
            return Expr.make_binop(e.op, this.copy_expr(e.left), this.copy_expr(e.right));
        }
        if e.kind == ExprKind.UNARY {
            return Expr.make_unary(e.op, this.copy_expr(e.left));
        }
        if e.kind == ExprKind.TERNARY {
            return Expr.make_ternary(this.copy_expr(e.cond), this.copy_expr(e.left), this.copy_expr(e.right));
        }
        if e.kind == ExprKind.CAST {
            return Expr.make_cast(e.sval, this.copy_expr(e.left));
        }
        if e.kind == ExprKind.MEMBER {
            return Expr.make_member(this.copy_expr(e.left), e.sval);
        }
        if e.kind == ExprKind.POINTER_MEMBER {
            return Expr.make_pointer_member(this.copy_expr(e.left), e.sval);
        }
        if e.kind == ExprKind.INDEX {
            return Expr.make_index(this.copy_expr(e.left), this.copy_expr(e.right));
        }
        if e.kind == ExprKind.CALL {
            ca: vec<Expr>;
            foreach _, a in<vector> e.args { ca.pushb(this.copy_expr(a)); }
            return Expr.make_call(e.sval, ca);
        }
        if e.kind == ExprKind.METHOD_CALL {
            ma: vec<Expr>;
            foreach _, a in<vector> e.args { ma.pushb(this.copy_expr(a)); }
            return Expr.make_method_call(this.copy_expr(e.left), e.sval, ma);
        }
        if e.kind == ExprKind.STRUCT_INIT || e.kind == ExprKind.ARRAY_LIT {
            sa: vec<Expr>;
            foreach _, a in<vector> e.args { sa.pushb(this.copy_expr(a)); }
            if e.kind == ExprKind.STRUCT_INIT {
                return Expr.make_struct_init(e.sval, e.field_names, sa);
            }
            return Expr.make_array_lit(sa);
        }
        return e;
    }

    // Deep-copy substitution of macro parameters (the Parser's subst_macro
    // equivalent, operating on copied nodes).
    pub fnc subst_copy(e Expr, params vec<string>, args vec<Expr>) : Expr {
        if e == null { return e; }
        if e.kind == ExprKind.IDENT {
            pi: int = 0;
            while pi < params.size {
                if params.get(pi) == e.sval {
                    if pi < args.size { return args.get(pi); }
                    stop;
                }
                pi = pi + 1;
            }
            return e;
        }
        if e.kind == ExprKind.INT || e.kind == ExprKind.FLOAT || e.kind == ExprKind.STRING
           || e.kind == ExprKind.CHAR || e.kind == ExprKind.BOOL || e.kind == ExprKind.NIL {
            return e;
        }
        if e.kind == ExprKind.BINOP {
            return Expr.make_binop(e.op, this.subst_copy(e.left, params, args), this.subst_copy(e.right, params, args));
        }
        if e.kind == ExprKind.UNARY {
            return Expr.make_unary(e.op, this.subst_copy(e.left, params, args));
        }
        if e.kind == ExprKind.TERNARY {
            return Expr.make_ternary(this.subst_copy(e.cond, params, args), this.subst_copy(e.left, params, args), this.subst_copy(e.right, params, args));
        }
        if e.kind == ExprKind.CALL {
            ca: vec<Expr>;
            foreach _, a in<vector> e.args { ca.pushb(this.subst_copy(a, params, args)); }
            return Expr.make_call(e.sval, ca);
        }
        if e.kind == ExprKind.METHOD_CALL {
            ma: vec<Expr>;
            foreach _, a in<vector> e.args { ma.pushb(this.subst_copy(a, params, args)); }
            return Expr.make_method_call(this.subst_copy(e.left, params, args), e.sval, ma);
        }
        if e.kind == ExprKind.MEMBER {
            return Expr.make_member(this.subst_copy(e.left, params, args), e.sval);
        }
        if e.kind == ExprKind.INDEX {
            return Expr.make_index(this.subst_copy(e.left, params, args), this.subst_copy(e.right, params, args));
        }
        if e.kind == ExprKind.CAST {
            return Expr.make_cast(e.sval, this.subst_copy(e.left, params, args));
        }
        if e.kind == ExprKind.STRUCT_INIT {
            sa: vec<Expr>;
            foreach _, a in<vector> e.args { sa.pushb(this.subst_copy(a, params, args)); }
            return Expr.make_struct_init(e.sval, e.field_names, sa);
        }
        return this.copy_expr(e);
    }

    pub fnc opt_expr(e Expr) : Expr {
        if e == null { return e; }

        // Zero-parameter macro used as a bare identifier: expand it here,
        // after import splicing, so macros defined in imported modules
        // resolve too (Python expands macros after resolve_imports).
        if e.kind == ExprKind.IDENT && this.macro_depth < 8 && this.macros.isin(e.sval) {
            m: MacroDef = this.macros[e.sval];
            if m.body != null && m.params.size == 0 {
                this.macro_depth = this.macro_depth + 1;
                expanded: Expr = this.opt_expr(this.copy_expr(m.body));
                this.macro_depth = this.macro_depth - 1;
                return expanded;
            }
        }

        // Parameterized macro CALL: substitute the arguments (the parser
        // only expands same-file macro calls; module macros land here).
        if e.kind == ExprKind.CALL && this.macro_depth < 8 && this.macros.isin(e.sval) {
            mc_m: MacroDef = this.macros[e.sval];
            if mc_m.body != null && mc_m.params.size == e.args.size {
                mc_args: vec<Expr>;
                foreach _, ma in<vector> e.args { mc_args.pushb(this.opt_expr(this.copy_expr(ma))); }
                this.macro_depth = this.macro_depth + 1;
                mc_sub: Expr = this.subst_copy(mc_m.body, mc_m.params, mc_args);
                expanded2: Expr = this.opt_expr(mc_sub);
                this.macro_depth = this.macro_depth - 1;
                return expanded2;
            }
        }

        if e.kind == ExprKind.BINOP {
            l: Expr = this.opt_expr(e.left);
            r: Expr = this.opt_expr(e.right);
            if l.kind == ExprKind.INT && r.kind == ExprKind.INT {
                lv: int = l.ival;
                rv: int = r.ival;
                // Big literals keep their raw text in sval: folding through
                // the i64 ival would wrap them. Leave those to codegen.
                if e.left.kind == ExprKind.INT && e.left.sval.size > 0 { return e; }
                if e.right.kind == ExprKind.INT && e.right.sval.size > 0 { return e; }
                if e.op == "+" { return Expr.make_int(lv + rv); }
                if e.op == "-" { return Expr.make_int(lv - rv); }
                if e.op == "*" { return Expr.make_int(lv * rv); }
                if e.op == "/" && rv != 0 { return Expr.make_int(lv / rv); }
                if e.op == "%" && rv != 0 { return Expr.make_int(lv % rv); }
                if e.op == "==" { return Expr.make_bool(lv == rv); }
                if e.op == "!=" { return Expr.make_bool(lv != rv); }
                if e.op == "<" { return Expr.make_bool(lv < rv); }
                if e.op == ">" { return Expr.make_bool(lv > rv); }
                if e.op == "<=" { return Expr.make_bool(lv <= rv); }
                if e.op == ">=" { return Expr.make_bool(lv >= rv); }
            }
            if l.kind == ExprKind.FLOAT && r.kind == ExprKind.FLOAT {
                lf: float = l.fval;
                rf: float = r.fval;
                if e.op == "+" { return Expr.make_float(lf + rf); }
                if e.op == "-" { return Expr.make_float(lf - rf); }
                if e.op == "*" { return Expr.make_float(lf * rf); }
                if e.op == "/" && rf != 0 { return Expr.make_float(lf / rf); }
                if e.op == "==" { return Expr.make_bool(lf == rf); }
                if e.op == "!=" { return Expr.make_bool(lf != rf); }
                if e.op == "<" { return Expr.make_bool(lf < rf); }
                if e.op == ">" { return Expr.make_bool(lf > rf); }
                if e.op == "<=" { return Expr.make_bool(lf <= rf); }
                if e.op == ">=" { return Expr.make_bool(lf >= rf); }
            }
            if l.kind == ExprKind.STRING && r.kind == ExprKind.STRING {
                ls: string = l.sval;
                rs: string = r.sval;
                if e.op == "+" { return Expr.make_string(ls + rs); }
                if e.op == "==" { return Expr.make_bool(ls == rs); }
                if e.op == "!=" { return Expr.make_bool(ls != rs); }
            }
            if l.kind == ExprKind.BOOL && r.kind == ExprKind.BOOL {
                lb: bool = l.bval;
                rb: bool = r.bval;
                if e.op == "&&" { return Expr.make_bool(lb && rb); }
                if e.op == "||" { return Expr.make_bool(lb || rb); }
                if e.op == "==" { return Expr.make_bool(lb == rb); }
                if e.op == "!=" { return Expr.make_bool(lb != rb); }
            }
            e.left = l;
            e.right = r;
            return e;
        }

        if e.kind == ExprKind.UNARY {
            o: Expr = this.opt_expr(e.left);
            if e.op == "-" && o.kind == ExprKind.INT && o.sval.size == 0 { return Expr.make_int(-o.ival); }
            if e.op == "-" && o.kind == ExprKind.FLOAT { return Expr.make_float(-o.fval); }
            if e.op == "!" && o.kind == ExprKind.BOOL { return Expr.make_bool(!o.bval); }
            e.left = o;
            return e;
        }

        if e.kind == ExprKind.CALL {
            // Compile-time builtin folds on literals (python parity)
            if e.sval == "tostring" && e.args.size == 1 && e.args.get(0).kind == ExprKind.STRING {
                return e.args.get(0);
            }
            na: vec<Expr>;
            foreach _, a in<vector> e.args { na.pushb(this.opt_expr(a)); }
            e.args = na;
            return e;
        }

        if e.kind == ExprKind.METHOD_CALL {
            e.left = this.opt_expr(e.left);
            na: vec<Expr>;
            foreach _, a in<vector> e.args { na.pushb(this.opt_expr(a)); }
            e.args = na;
            return e;
        }

        if e.kind == ExprKind.MEMBER {
            e.left = this.opt_expr(e.left);
            return e;
        }

        if e.kind == ExprKind.INDEX {
            e.left = this.opt_expr(e.left);
            e.right = this.opt_expr(e.right);
            return e;
        }

        if e.kind == ExprKind.TERNARY {
            e.cond = this.opt_expr(e.cond);
            e.left = this.opt_expr(e.left);
            e.right = this.opt_expr(e.right);
            if e.cond.kind == ExprKind.BOOL {
                if e.cond.bval { return e.left; }
                return e.right;
            }
            return e;
        }

        if e.kind == ExprKind.CAST {
            e.left = this.opt_expr(e.left);
            return e;
        }

        if e.kind == ExprKind.STRUCT_INIT {
            na: vec<Expr>;
            foreach _, a in<vector> e.args { na.pushb(this.opt_expr(a)); }
            e.args = na;
            return e;
        }

        if e.kind == ExprKind.ARRAY_LIT {
            na: vec<Expr>;
            foreach _, a in<vector> e.args { na.pushb(this.opt_expr(a)); }
            e.args = na;
            return e;
        }

        return e;
    }

    pub fnc opt_stmts(stmts vec<Stmt>) : void {
        ai: int = 0;
        while ai < stmts.size {
            s: Stmt = stmts.get(ai);
            this.opt_stmt(s);
            ai = ai + 1;
        }
    }

    pub fnc opt_stmt(s Stmt) : void {
        if s == null { return; }
        if s.kind == StmtKind.VAR_DECL && s.value != null {
            s.value = this.opt_expr(s.value);
            return;
        }
        if s.kind == StmtKind.ASSIGN {
            s.value = this.opt_expr(s.value);
            return;
        }
        if s.kind == StmtKind.RETURN && s.value != null {
            s.value = this.opt_expr(s.value);
            return;
        }
        if s.kind == StmtKind.IF {
            s.cond = this.opt_expr(s.cond);
            this.opt_stmts(s.then_block);
            this.opt_stmts(s.else_block);
            if s.cond.kind == ExprKind.BOOL {
                if s.cond.bval { s.kind = StmtKind.BLOCK; s.body = s.then_block; s.cond = null; s.then_block = null; s.else_block = null; }
                else { s.kind = StmtKind.BLOCK; s.body = s.else_block; s.cond = null; s.then_block = null; s.else_block = null; }
            }
            return;
        }
        if s.kind == StmtKind.WHILE {
            s.cond = this.opt_expr(s.cond);
            this.opt_stmts(s.body);
            return;
        }
        if s.kind == StmtKind.LOOP {
            this.opt_stmts(s.body);
            return;
        }
        if s.kind == StmtKind.FOR {
            if s.for_init != null { this.opt_stmt(s.for_init); }
            if s.cond != null { s.cond = this.opt_expr(s.cond); }
            if s.for_step != null { this.opt_stmt(s.for_step); }
            this.opt_stmts(s.body);
            return;
        }
        if s.kind == StmtKind.BLOCK {
            this.opt_stmts(s.body);
            return;
        }
        if s.kind == StmtKind.SHOW {
            na: vec<Expr>;
            foreach _, a in<vector> s.args { na.pushb(this.opt_expr(a)); }
            s.args = na;
            return;
        }
        if s.kind == StmtKind.EXPR {
            s.value = this.opt_expr(s.value);
            return;
        }
        if s.kind == StmtKind.SWITCH {
            s.value = this.opt_expr(s.value);
            this.opt_stmts(s.switch_cases);
            this.opt_stmts(s.default_block);
            return;
        }
        if s.kind == StmtKind.CASE {
            if s.value != null { s.value = this.opt_expr(s.value); }
            this.opt_stmts(s.body);
            return;
        }
    }

    pub fnc opt_program(prog Program) : void {
        this.macros = prog.macros;
        foreach _, f in<vector> prog.funcs {
            this.opt_stmts(f.body);
        }
        foreach _, c in<vector> prog.classes {
            foreach _, m in<vector> c.methods {
                this.opt_stmts(m.body);
            }
        }
        foreach _, g in<vector> prog.globals {
            if g.init_val != null { g.init_val = this.opt_expr(g.init_val); }
        }
    }
}
