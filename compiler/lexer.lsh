use tokens::*;

pub def Lexer : class {
    pub src: string;
    pub pos: int;
    pub len: int;
    pub line: int;
    pub col: int;
    pub errs: int;   // fatal lex errors (e.g. NUL in a string literal)
    pub warns: int;  // recoverable lex warnings (unknown characters)
    pub quiet: bool; // suppress warnings (sub-lexers inside interpolation)
    pub err_msg: string; // first fatal lexer error (driver prints with location)
    pub err_line: int;
    pub err_col: int;

    // Record a fatal lexer error. The driver renders the first one with its
    // source location (python raises on the first error and aborts).
    pub fnc fail(msg string, line_no int, col int) : void {
        this.errs = this.errs + 1;
        if this.err_msg.size == 0 {
            this.err_msg = msg;
            this.err_line = line_no;
            this.err_col = col;
        }
    }

    static pub fnc is_digit(c char) : bool {
        return c >= '0' && c <= '9';
    }

    static pub fnc is_alpha(c char) : bool {
        return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z');
    }

    static pub fnc is_ident_start(c char) : bool {
        return Lexer.is_alpha(c) || c == '_';
    }

    static pub fnc is_ident_part(c char) : bool {
        return Lexer.is_ident_start(c) || Lexer.is_digit(c);
    }

    static pub fnc is_hex_digit(c char) : bool {
        return Lexer.is_digit(c) || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F');
    }

    static pub fnc is_bin_digit(c char) : bool {
        return c == '0' || c == '1';
    }

    static pub fnc is_oct_digit(c char) : bool {
        return c >= '0' && c <= '7';
    }

    // Python's BADNUM character classes: the first non-[valid-digit] char
    // that makes a prefixed literal malformed. `p`/`P` are excluded from
    // the hex class (they start a hex-float exponent).
    static pub fnc is_bad_bin_char(c char) : bool {
        return (c >= '2' && c <= '9') || Lexer.is_alpha(c);
    }

    static pub fnc is_bad_oct_char(c char) : bool {
        return c == '8' || c == '9' || Lexer.is_alpha(c);
    }

    static pub fnc is_bad_hex_letter(c char) : bool {
        if c >= 'a' && c <= 'z' { return !(c >= 'a' && c <= 'f') && c != 'p'; }
        if c >= 'A' && c <= 'Z' { return !(c >= 'A' && c <= 'F') && c != 'P'; }
        return false;
    }

    // `1_000` -> `1000`: token text feeds strtod/parse_int_text, which do
    // not know about separators.
    static pub fnc strip_seps(s string) : string {
        out: string = "";
        foreach _, c in<string> s {
            if c != '_' { out = out + c; }
        }
        return out;
    }

    static pub fnc all_decimal(s string) : bool {
        ok: bool = true;
        foreach _, c in<string> s {
            if c != '_' && !Lexer.is_digit(c) { ok = false; }
        }
        return ok;
    }

    static pub fnc hex_val(c char) : int {
        if c >= '0' && c <= '9' { return c - '0'; }
        if c >= 'a' && c <= 'f' { return c - 'a' + 10; }
        if c >= 'A' && c <= 'F' { return c - 'A' + 10; }
        return -1;
    }

    // python _LEASH_ESCAPE_MAP keys: one decoded character each.
    static pub fnc is_simple_esc(c char) : bool {
        if c == 'n' || c == 't' || c == 'r' || c == '0' || c == 'a' || c == 'b' || c == 'f' || c == 'v' {
            return true;
        }
        if c == '\\' || c == '\'' || c == '"' || c == '?' || c == '{' || c == '}' {
            return true;
        }
        return false;
    }

    static pub fnc hex_str_val(s string) : int {
        v: int = 0;
        foreach _, c in<string> s {
            v = v * 16 + Lexer.hex_val(c);
        }
        return v;
    }

    static pub fnc hex_upper(cp int, min_width int) : string {
        digits: string = "0123456789ABCDEF";
        out: string = "";
        v: int = cp;
        if v < 0 { v = 0; }
        n: int = 0;
        while v > 0 || n < min_width {
            d: int = v % 16;
            out = digits[d] + out;
            v = v / 16;
            n = n + 1;
        }
        return out;
    }

    // Consume exactly `width` hex digits after \x / \u / \U. Emits python's
    // "expected exactly N hex digits" error and returns a short string when
    // the input is malformed; callers only use the digits when
    // digits.size == width.
    pub fnc scan_esc_digits(what char, width int, sline int, scol int) : string {
        digits: string = "";
        i: int = 0;
        while i < width && Lexer.hex_val(this.peek()) >= 0 {
            digits = digits + this.advance();
            i = i + 1;
        }
        if digits.size != width {
            ws: string = "";
            ws = ws + what;
            ex: string = "";
            pad: int = width - 2;
            while pad > 0 { ex = ex + "0"; pad = pad - 1; }
            ex = ex + "41";
            this.fail("Invalid \\" + ws + " escape: expected exactly " + tostring(width) + " hex digits (e.g. \\" + ws + ex + ").", sline, scol);
        }
        return digits;
    }

    // python leash_unescape validation for a successfully scanned escape:
    // range first, then surrogate; strings additionally reject NULs.
    pub fnc check_esc_cp(what char, width int, cp int, is_string bool, sline int, scol int) : void {
        if width >= 8 && cp > 0x10FFFF {
            this.fail("Invalid \\U escape: code point U+" + Lexer.hex_upper(cp, 8) + " is out of range (max U+10FFFF).", sline, scol);
            return;
        }
        if cp >= 0xD800 && cp <= 0xDFFF {
            ws2: string = "";
            ws2 = ws2 + what;
            this.fail("Invalid \\" + ws2 + " escape: U+" + Lexer.hex_upper(cp, 4) + " is a lone UTF-16 surrogate; encode non-BMP characters directly instead.", sline, scol);
            return;
        }
        if is_string && cp == 0 {
            this.fail("NUL byte ('\\0') is not allowed inside string literals: Leash strings cannot hold embedded NULs.", sline, scol);
        }
    }

    static pub fnc make(src string) : Lexer {
        return Lexer { src: src, pos: 0, len: src.size, line: 1, col: 1, errs: 0, warns: 0, quiet: false, err_msg: "", err_line: 0, err_col: 0 };
    }

    pub fnc peek() : char {
        if this.pos >= this.len {
            return '\0';
        }
        return this.src[this.pos];
    }

    pub fnc peek_at(offset int) : char {
        p: int = this.pos + offset;
        if p >= this.len {
            return '\0';
        }
        return this.src[p];
    }

    pub fnc advance() : char {
        if this.pos >= this.len {
            return '\0';
        }
        c: char = this.src[this.pos];
        this.pos = this.pos + 1;
        this.col = this.col + 1;
        if c == '\n' {
            this.line = this.line + 1;
            this.col = 1;
        }
        return c;
    }

    pub fnc skip_whitespace_and_comments() : void {
        loop {
            c: char = this.peek();
            if c == ' ' || c == '\t' || c == '\r' || c == '\n' {
                this.advance();
            } also c == '/' && this.peek_at(1) == '/' {
                // Line comment
                this.advance();
                this.advance();
                while this.peek() != '\n' && this.peek() != '\0' {
                    this.advance();
                }
            } also c == '/' && this.peek_at(1) == '*' {
                // Block comment
                bc_line: int = this.line;
                bc_col: int = this.col;
                this.advance();
                this.advance();
                bc_closed: bool = false;
                while this.peek() != '\0' {
                    if this.peek() == '*' && this.peek_at(1) == '/' {
                        this.advance();
                        this.advance();
                        bc_closed = true;
                        stop;
                    }
                    this.advance();
                }
                if !bc_closed {
                    // python parity: unterminated block comments are a hard
                    // lexer error.
                    this.fail("Unterminated block comment: missing '*/'.", bc_line, bc_col);
                }
            } else {
                stop;
            }
        }
    }

    pub fnc read_identifier() : Token {
        start_line: int = this.line;
        start_col: int = this.col;
        ident: string = "";

        while Lexer.is_ident_part(this.peek()) {
            ident = ident + this.advance();
        }

        // Keywords mapping
        kind: int = Tok.IDENT;
        if ident == "fnc" { kind = Tok.FNC; }
        also ident == "return" { kind = Tok.RETURN; }
        also ident == "if" { kind = Tok.IF; }
        also ident == "also" { kind = Tok.ALSO; }
        also ident == "else" { kind = Tok.ELSE; }
        also ident == "while" { kind = Tok.WHILE; }
        also ident == "for" { kind = Tok.FOR; }
        also ident == "loop" { kind = Tok.LOOP; }
        also ident == "stop" { kind = Tok.STOP; }
        also ident == "skip" { kind = Tok.CONTINUE; }
        also ident == "continue" { kind = Tok.CONTINUE; }
        also ident == "switch" { kind = Tok.SWITCH; }
        also ident == "case" { kind = Tok.CASE; }
        also ident == "default" { kind = Tok.DEFAULT; }
        also ident == "def" { kind = Tok.DEF; }
        also ident == "struct" { kind = Tok.STRUCT; }
        also ident == "class" { kind = Tok.CLASS; }
        also ident == "enum" { kind = Tok.ENUM; }
        also ident == "union" { kind = Tok.UNION; }
        also ident == "type" { kind = Tok.TYPE; }
        also ident == "pub" { kind = Tok.PUB; }
        also ident == "priv" { kind = Tok.PRIV; }
        also ident == "imut" { kind = Tok.IMUT; }
        also ident == "static" { kind = Tok.STATIC; }
        also ident == "unsafe" { kind = Tok.UNSAFE; }
        also ident == "inline" { kind = Tok.INLINE; }
        also ident == "nogc" { kind = Tok.NOGC; }
        also ident == "async" { kind = Tok.ASYNC; }
        also ident == "worker" { kind = Tok.WORKER; }
        also ident == "spawn" { kind = Tok.SPAWN; }
        also ident == "shared" { kind = Tok.SHARED; }
        also ident == "fusion" { kind = Tok.FUSION; }
        also ident == "show" { kind = Tok.SHOW; }
        also ident == "showb" { kind = Tok.SHOWB; }
        also ident == "exec" { kind = Tok.EXEC; }
        also ident == "use" { kind = Tok.USE; }
        also ident == "import" { kind = Tok.IMPORT; }
        also ident == "is" { kind = Tok.IS; }
        also ident == "isnt" { kind = Tok.ISNT; }
        also ident == "in" { kind = Tok.IN; }
        also ident == "foreach" { kind = Tok.FOREACH; }
        also ident == "do" { kind = Tok.DO; }
        also ident == "unless" { kind = Tok.UNLESS; }
        also ident == "alsou" { kind = Tok.ALSOU; }
        also ident == "as" { kind = Tok.AS; }
        also ident == "delete" { kind = Tok.DELETE; }
        also ident == "del" { kind = Tok.DELETE; }
        also ident == "true" { kind = Tok.BOOL; }
        also ident == "false" { kind = Tok.BOOL; }
        also ident == "nil" { kind = Tok.NIL; }
        also ident == "null" { kind = Tok.NIL; }

        return Token.make(kind, ident, start_line, start_col);
    }

    pub fnc read_number() : Token {
        start_line: int = this.line;
        start_col: int = this.col;
        raw: string = "";

        // Hexadecimal: 0x1F, 0x1_FFFF, 0x1.8p1, 0xDEAD.BEEF (python parity)
        if this.peek() == '0' && (this.peek_at(1) == 'x' || this.peek_at(1) == 'X') {
            raw = raw + this.advance();
            raw = raw + this.advance();
            nh: int = 0;
            got: bool = false;
            loop {
                if Lexer.is_hex_digit(this.peek()) {
                    raw = raw + this.advance();
                    nh = nh + 1;
                    got = true;
                } also this.peek() == '_' && nh > 0 && Lexer.is_hex_digit(this.peek_at(1)) {
                    raw = raw + this.advance();
                    nh = 0;
                } else { stop; }
            }
            is_hf: bool = false;
            if got && this.peek() == '.' && Lexer.is_hex_digit(this.peek_at(1)) {
                is_hf = true;
                raw = raw + this.advance();
                nh = 0;
                loop {
                    if Lexer.is_hex_digit(this.peek()) {
                        raw = raw + this.advance();
                        nh = nh + 1;
                    } also this.peek() == '_' && nh > 0 && Lexer.is_hex_digit(this.peek_at(1)) {
                        raw = raw + this.advance();
                        nh = 0;
                    } else { stop; }
                }
            }
            pexp: bool = false;
            if this.peek() == 'p' || this.peek() == 'P' {
                if Lexer.is_digit(this.peek_at(1)) { pexp = true; }
                also (this.peek_at(1) == '+' || this.peek_at(1) == '-') && Lexer.is_digit(this.peek_at(2)) { pexp = true; }
            }
            if pexp {
                is_hf = true;
                raw = raw + this.advance();
                if this.peek() == '+' || this.peek() == '-' { raw = raw + this.advance(); }
                while Lexer.is_digit(this.peek()) { raw = raw + this.advance(); }
            }
            if !got {
                // Malformed hex (python BADNUM): '0x' + optional bad letter.
                c: char = this.peek();
                if Lexer.is_bad_hex_letter(c) { raw = raw + this.advance(); }
                this.fail("Invalid hexadecimal numeric literal '" + raw + "'.", start_line, start_col);
            } also Lexer.is_bad_hex_letter(this.peek()) {
                raw = raw + this.advance();
                this.fail("Invalid hexadecimal numeric literal '" + raw + "'.", start_line, start_col);
            }
            if is_hf {
                return Token.make(Tok.FLOAT, Lexer.strip_seps(raw), start_line, start_col);
            }
            return Token.make(Tok.INT, Lexer.strip_seps(raw), start_line, start_col);
        }

        // Binary: 0b1010, 0b1111_0000
        if this.peek() == '0' && (this.peek_at(1) == 'b' || this.peek_at(1) == 'B') {
            raw = raw + this.advance();
            raw = raw + this.advance();
            nb: int = 0;
            got: bool = false;
            loop {
                if Lexer.is_bin_digit(this.peek()) {
                    raw = raw + this.advance();
                    nb = nb + 1;
                    got = true;
                } also this.peek() == '_' && nb > 0 && Lexer.is_bin_digit(this.peek_at(1)) {
                    raw = raw + this.advance();
                    nb = 0;
                } else { stop; }
            }
            bad: bool = !got;
            c: char = this.peek();
            if Lexer.is_bad_bin_char(c) { raw = raw + this.advance(); bad = true; }
            if bad {
                this.fail("Invalid binary numeric literal '" + raw + "'.", start_line, start_col);
            }
            return Token.make(Tok.INT, Lexer.strip_seps(raw), start_line, start_col);
        }

        // Octal: 0o755, 0o7_55
        if this.peek() == '0' && (this.peek_at(1) == 'o' || this.peek_at(1) == 'O') {
            raw = raw + this.advance();
            raw = raw + this.advance();
            no: int = 0;
            got: bool = false;
            loop {
                if Lexer.is_oct_digit(this.peek()) {
                    raw = raw + this.advance();
                    no = no + 1;
                    got = true;
                } also this.peek() == '_' && no > 0 && Lexer.is_oct_digit(this.peek_at(1)) {
                    raw = raw + this.advance();
                    no = 0;
                } else { stop; }
            }
            bad: bool = !got;
            c: char = this.peek();
            if Lexer.is_bad_oct_char(c) { raw = raw + this.advance(); bad = true; }
            if bad {
                this.fail("Invalid octal numeric literal '" + raw + "'.", start_line, start_col);
            }
            return Token.make(Tok.INT, Lexer.strip_seps(raw), start_line, start_col);
        }

        // Decimal: 42, 3.14, .5, 3., 1e10, 2.5E-3, 1_000
        nd: int = 0;
        loop {
            if Lexer.is_digit(this.peek()) {
                raw = raw + this.advance();
                nd = nd + 1;
            } also this.peek() == '_' && nd > 0 && Lexer.is_digit(this.peek_at(1)) {
                raw = raw + this.advance();
                nd = 0;
            } else { stop; }
        }

        is_flt: bool = false;
        if this.peek() == '.' {
            is_flt = true;
            raw = raw + this.advance(); // consume '.'
            nd = 0;
            loop {
                if Lexer.is_digit(this.peek()) {
                    raw = raw + this.advance();
                    nd = nd + 1;
                } also this.peek() == '_' && nd > 0 && Lexer.is_digit(this.peek_at(1)) {
                    raw = raw + this.advance();
                    nd = 0;
                } else { stop; }
            }
        }

        eok: bool = false;
        if this.peek() == 'e' || this.peek() == 'E' {
            if Lexer.is_digit(this.peek_at(1)) { eok = true; }
            also (this.peek_at(1) == '+' || this.peek_at(1) == '-') && Lexer.is_digit(this.peek_at(2)) { eok = true; }
        }
        if eok {
            is_flt = true;
            raw = raw + this.advance();
            if this.peek() == '+' || this.peek() == '-' {
                raw = raw + this.advance();
            }
            while Lexer.is_digit(this.peek()) {
                raw = raw + this.advance();
            }
        }

        if is_flt {
            v: float = (float)strtod(Lexer.strip_seps(raw), nil);
            // `v - v` is NaN for infinity and leash's `!=` is ordered, so
            // compare against DBL_MAX (strtod overflows to +inf).
            if v > 1.7976931348623157e308 {
                this.fail("Invalid numeric literal '" + raw + "': '" + raw + "' is out of range (evaluates to infinity).", start_line, start_col);
            }
            return Token.make(Tok.FLOAT, Lexer.strip_seps(raw), start_line, start_col);
        }

        // Plain decimal integer — reject ambiguous leading zeros (007)
        if raw.size > 1 && raw[0] == '0' && Lexer.all_decimal(raw) {
            this.fail("Invalid numeric literal '" + raw + "': leading zeros are not allowed in decimal literals.", start_line, start_col);
        }
        return Token.make(Tok.INT, Lexer.strip_seps(raw), start_line, start_col);
    }

    pub fnc read_string() : Token {
        start_line: int = this.line;
        start_col: int = this.col;
        this.advance(); // consume opening "
        val: string = "";

        loop {
            c: char = this.peek();
            if c == '"' {
                this.advance(); // consume closing "
                stop;
            }
            if c == '\n' || c == '\0' {
                // Raw newlines / EOF are python's MISMATCH cases.
                this.fail("Unterminated or malformed string literal.", start_line, start_col);
                return Token.make(Tok.STRING, val, start_line, start_col);
            }
            if c == '\\' {
                val = val + this.advance();
                esc: char = this.peek();
                if esc == '\n' || esc == '\0' {
                    this.fail("Unterminated or malformed string literal.", start_line, start_col);
                    return Token.make(Tok.STRING, val, start_line, start_col);
                }
                val = val + this.advance();
                if esc == '0' {
                    // Python parity: `\0` in a string literal is a hard
                    // error — Leash strings are C strings and an embedded
                    // NUL would silently truncate. Keep the pair text so
                    // later phases see sane tokens; the driver aborts on
                    // the error count.
                    this.fail("NUL byte ('\\0') is not allowed inside string literals: Leash strings cannot hold embedded NULs.", start_line, start_col);
                } also esc == 'x' || esc == 'u' || esc == 'U' {
                    // python validates fixed-width escapes at lex time;
                    // decoding happens once in the parser (raw text kept).
                    w: int = 2;
                    if esc == 'u' { w = 4; }
                    if esc == 'U' { w = 8; }
                    digs: string = this.scan_esc_digits(esc, w, start_line, start_col);
                    val = val + digs;
                    if digs.size == w {
                        this.check_esc_cp(esc, w, Lexer.hex_str_val(digs), true, start_line, start_col);
                    }
                }
                // Token values stay RAW (python keeps `tok.raw`): the parser
                // unescapes exactly once after the interpolation scan, so
                // `\\n` or `\\{` sequences are never decoded twice.
            } else {
                val = val + this.advance();
            }
        }

        return Token.make(Tok.STRING, val, start_line, start_col);
    }

    // Lookahead: does a bare `delim delim delim` occur ahead? (`'''` is only
    // a multi-line string in python when it actually closes; otherwise the
    // lexer falls back to the empty character literal.)
    pub fnc has_closing_triple(delim char) : bool {
        i: int = 3;
        while this.pos + i < this.len {
            if this.peek_at(i) == delim && this.peek_at(i + 1) == delim && this.peek_at(i + 2) == delim {
                return true;
            }
            i = i + 1;
        }
        return false;
    }

    pub fnc read_multiline_string(delim char) : Token {
        start_line: int = this.line;
        start_col: int = this.col;
        this.advance();
        this.advance();
        this.advance(); // consume opening delimiter
        val: string = "";

        while this.peek() != '\0' {
            if this.peek() == delim && this.peek_at(1) == delim && this.peek_at(2) == delim {
                this.advance();
                this.advance();
                this.advance();
                return Token.make(Tok.STRING, val, start_line, start_col);
            }
            c: char = this.advance();
            if c == '\\' {
                e: char = this.peek();
                if e == '\0' {
                    // EOF right after a backslash: no closing delimiter.
                    this.fail("Unterminated multi-line string literal: missing closing \"\"\".", start_line, start_col);
                    return Token.make(Tok.STRING, val, start_line, start_col);
                }
                val = val + '\\' + this.advance();
                if e == '0' {
                    // Python parity: `\0` in a string literal is a hard
                    // error (same as the single-quoted form)
                    this.fail("NUL byte ('\\0') is not allowed inside string literals: Leash strings cannot hold embedded NULs.", start_line, start_col);
                } also e == 'x' || e == 'u' || e == 'U' {
                    w: int = 2;
                    if e == 'u' { w = 4; }
                    if e == 'U' { w = 8; }
                    digs: string = this.scan_esc_digits(e, w, start_line, start_col);
                    val = val + digs;
                    if digs.size == w {
                        this.check_esc_cp(e, w, Lexer.hex_str_val(digs), true, start_line, start_col);
                    }
                }
            } else {
                val = val + c;
            }
        }

        // EOF without closing """.
        this.fail("Unterminated multi-line string literal: missing closing \"\"\".", start_line, start_col);
        return Token.make(Tok.STRING, val, start_line, start_col);
    }

    pub fnc read_char() : Token {
        start_line: int = this.line;
        start_col: int = this.col;
        this.advance(); // consume opening '
        raw: string = "";
        count: int = 0;

        loop {
            c: char = this.peek();
            if c == '\'' {
                this.advance(); // consume closing '
                stop;
            }
            if c == '\n' || c == '\0' {
                this.fail("Unterminated or malformed character literal.", start_line, start_col);
                return Token.make(Tok.CHAR, raw, start_line, start_col);
            }
            if c == '\\' {
                raw = raw + this.advance();
                e: char = this.peek();
                if e == '\n' || e == '\0' {
                    this.fail("Unterminated or malformed character literal.", start_line, start_col);
                    return Token.make(Tok.CHAR, raw, start_line, start_col);
                }
                raw = raw + this.advance();
                if Lexer.is_simple_esc(e) {
                    count = count + 1;
                } also e == 'x' || e == 'u' || e == 'U' {
                    w: int = 2;
                    if e == 'u' { w = 4; }
                    if e == 'U' { w = 8; }
                    digs: string = this.scan_esc_digits(e, w, start_line, start_col);
                    raw = raw + digs;
                    if digs.size == w {
                        this.check_esc_cp(e, w, Lexer.hex_str_val(digs), false, start_line, start_col);
                        count = count + 1;
                    } else {
                        count = count + 2;
                    }
                } else {
                    // Unknown escapes keep the backslash: two characters.
                    count = count + 2;
                }
            } else {
                raw = raw + this.advance();
                count = count + 1;
            }
        }

        if count != 1 {
            this.fail("Character literal must contain exactly one character (found " + tostring(count) + ").", start_line, start_col);
        }
        return Token.make(Tok.CHAR, raw, start_line, start_col);
    }

    pub fnc tokenize() : vec<Token> {
        tokens: vec<Token>;

        loop {
            this.skip_whitespace_and_comments();
            c: char = this.peek();

            if c == '\0' {
                tokens.pushb(Token.make(Tok.EOF, "", this.line, this.col));
                stop;
            }

            cur_line: int = this.line;
            cur_col: int = this.col;

            // Identifier or keyword
            if Lexer.is_ident_start(c) {
                tokens.pushb(this.read_identifier());
                continue;
            }

            // Number (also leading-dot float literals like `.5`)
            if Lexer.is_digit(c) || (c == '.' && Lexer.is_digit(this.peek_at(1))) {
                tokens.pushb(this.read_number());
                continue;
            }

            // String
            if c == '"' {
                if this.peek_at(1) == '"' && this.peek_at(2) == '"' {
                    tokens.pushb(this.read_multiline_string('"'));
                } else {
                    tokens.pushb(this.read_string());
                }
                continue;
            }

            // Char (`'''` opens a multi-line string only when it closes)
            if c == '\'' {
                if this.peek_at(1) == '\'' && this.peek_at(2) == '\'' && this.has_closing_triple('\'') {
                    tokens.pushb(this.read_multiline_string('\''));
                } else {
                    tokens.pushb(this.read_char());
                }
                continue;
            }

            // Two-character operators and delimiters
            c2: char = this.peek_at(1);
            if c == ':' && c2 == ':' {
                this.advance(); this.advance();
                tokens.pushb(Token.make(Tok.COLONCOLON, "::", cur_line, cur_col));
                continue;
            }
            if c == ':' && c2 == '=' {
                this.advance(); this.advance();
                tokens.pushb(Token.make(Tok.COLONEQ, ":=", cur_line, cur_col));
                continue;
            }
            if c == '-' && c2 == '>' {
                this.advance(); this.advance();
                tokens.pushb(Token.make(Tok.ARROW, "->", cur_line, cur_col));
                continue;
            }
            if c == '=' && c2 == '=' {
                this.advance(); this.advance();
                tokens.pushb(Token.make(Tok.EQ, "==", cur_line, cur_col));
                continue;
            }
            if c == '!' && c2 == '=' {
                this.advance(); this.advance();
                tokens.pushb(Token.make(Tok.NEQ, "!=", cur_line, cur_col));
                continue;
            }
            if c == '<' && c2 == '=' {
                this.advance(); this.advance();
                tokens.pushb(Token.make(Tok.LTE, "<=", cur_line, cur_col));
                continue;
            }
            if c == '>' && c2 == '=' {
                this.advance(); this.advance();
                tokens.pushb(Token.make(Tok.GTE, ">=", cur_line, cur_col));
                continue;
            }
            if c == '<' && c2 == '<' && this.peek_at(2) == '=' {
                this.advance(); this.advance(); this.advance();
                tokens.pushb(Token.make(Tok.SHIFTEQL, "<<=", cur_line, cur_col));
                continue;
            }
            if c == '<' && c2 == '<' {
                this.advance(); this.advance();
                tokens.pushb(Token.make(Tok.LSHIFT, "<<", cur_line, cur_col));
                continue;
            }
            if c == '>' && c2 == '>' && this.peek_at(2) == '=' {
                this.advance(); this.advance(); this.advance();
                tokens.pushb(Token.make(Tok.SHIFTEQR, ">>=", cur_line, cur_col));
                continue;
            }
            if c == '>' && c2 == '>' {
                this.advance(); this.advance();
                tokens.pushb(Token.make(Tok.RSHIFT, ">>", cur_line, cur_col));
                continue;
            }
            if c == '&' && c2 == '&' {
                this.advance(); this.advance();
                tokens.pushb(Token.make(Tok.AND, "&&", cur_line, cur_col));
                continue;
            }
            if c == '&' && c2 == '=' {
                this.advance(); this.advance();
                tokens.pushb(Token.make(Tok.AMPEQ, "&=", cur_line, cur_col));
                continue;
            }
            if c == '|' && c2 == '|' {
                this.advance(); this.advance();
                tokens.pushb(Token.make(Tok.OR, "||", cur_line, cur_col));
                continue;
            }
            if c == '|' && c2 == '=' {
                this.advance(); this.advance();
                tokens.pushb(Token.make(Tok.PIPEEQ, "|=", cur_line, cur_col));
                continue;
            }
            if c == '^' && c2 == '=' {
                this.advance(); this.advance();
                tokens.pushb(Token.make(Tok.CARETEQ, "^=", cur_line, cur_col));
                continue;
            }
            if c == '+' && c2 == '+' {
                this.advance(); this.advance();
                tokens.pushb(Token.make(Tok.PLUSPLUS, "++", cur_line, cur_col));
                continue;
            }
            if c == '-' && c2 == '-' {
                this.advance(); this.advance();
                tokens.pushb(Token.make(Tok.MINUSMINUS, "--", cur_line, cur_col));
                continue;
            }
            if c == '+' && c2 == '=' {
                this.advance(); this.advance();
                tokens.pushb(Token.make(Tok.PLUSEQ, "+=", cur_line, cur_col));
                continue;
            }
            if c == '-' && c2 == '=' {
                this.advance(); this.advance();
                tokens.pushb(Token.make(Tok.MINUSEQ, "-=", cur_line, cur_col));
                continue;
            }
            if c == '*' && c2 == '=' {
                this.advance(); this.advance();
                tokens.pushb(Token.make(Tok.STAREQ, "*=", cur_line, cur_col));
                continue;
            }
            if c == '/' && c2 == '=' {
                this.advance(); this.advance();
                tokens.pushb(Token.make(Tok.SLASHEQ, "/=", cur_line, cur_col));
                continue;
            }
            if c == '%' && c2 == '=' {
                this.advance(); this.advance();
                tokens.pushb(Token.make(Tok.PERCENTEQ, "%=", cur_line, cur_col));
                continue;
            }

            // Single-character tokens
            this.advance();
            if c == '(' { tokens.pushb(Token.make(Tok.LPAREN, "(", cur_line, cur_col)); }
            also c == ')' { tokens.pushb(Token.make(Tok.RPAREN, ")", cur_line, cur_col)); }
            also c == '{' { tokens.pushb(Token.make(Tok.LBRACE, "{", cur_line, cur_col)); }
            also c == '}' { tokens.pushb(Token.make(Tok.RBRACE, "}", cur_line, cur_col)); }
            also c == '[' { tokens.pushb(Token.make(Tok.LBRACKET, "[", cur_line, cur_col)); }
            also c == ']' { tokens.pushb(Token.make(Tok.RBRACKET, "]", cur_line, cur_col)); }
            also c == ';' { tokens.pushb(Token.make(Tok.SEMI, ";", cur_line, cur_col)); }
            also c == ':' { tokens.pushb(Token.make(Tok.COLON, ":", cur_line, cur_col)); }
            also c == ',' { tokens.pushb(Token.make(Tok.COMMA, ",", cur_line, cur_col)); }
            also c == '.' { tokens.pushb(Token.make(Tok.DOT, ".", cur_line, cur_col)); }
            also c == '?' { tokens.pushb(Token.make(Tok.QUESTION, "?", cur_line, cur_col)); }
            also c == '=' { tokens.pushb(Token.make(Tok.ASSIGN, "=", cur_line, cur_col)); }
            also c == '+' { tokens.pushb(Token.make(Tok.PLUS, "+", cur_line, cur_col)); }
            also c == '-' { tokens.pushb(Token.make(Tok.MINUS, "-", cur_line, cur_col)); }
            also c == '*' { tokens.pushb(Token.make(Tok.STAR, "*", cur_line, cur_col)); }
            also c == '/' { tokens.pushb(Token.make(Tok.SLASH, "/", cur_line, cur_col)); }
            also c == '%' { tokens.pushb(Token.make(Tok.PERCENT, "%", cur_line, cur_col)); }
            also c == '&' { tokens.pushb(Token.make(Tok.AMP, "&", cur_line, cur_col)); }
            also c == '|' { tokens.pushb(Token.make(Tok.PIPE, "|", cur_line, cur_col)); }
            also c == '^' { tokens.pushb(Token.make(Tok.CARET, "^", cur_line, cur_col)); }
            also c == '~' { tokens.pushb(Token.make(Tok.TILDE, "~", cur_line, cur_col)); }
            also c == '<' {
                if this.peek() == '>' {
                    this.advance();
                    tokens.pushb(Token.make(Tok.ISINOP, "<>", cur_line, cur_col));
                } else {
                    tokens.pushb(Token.make(Tok.LT, "<", cur_line, cur_col));
                }
            }
            also c == '>' { tokens.pushb(Token.make(Tok.GT, ">", cur_line, cur_col)); }
            also c == '!' { tokens.pushb(Token.make(Tok.NOT, "!", cur_line, cur_col)); }
            also c == '@' { tokens.pushb(Token.make(Tok.AT, "@", cur_line, cur_col)); }
            else {
                // python parity: an unexpected character is a hard lexer
                // error (`Unexpected character: '#'`).
                this.fail("Unexpected character: '" + c + "'", cur_line, cur_col);
            }
        }

        return tokens;
    }
}
