use optimize::*;
use tokens::*;
use ast::*;
use lexer::*;
use parser::*;
use typechecker::*;
use codegen::*;
use jvm::*;

pub def Path : class {
    static pub fnc dirname(p string) : string {
        last_slash: int = -1;
        foreach i, c in<string> p {
            if c == '/' || c == '\\' {
                last_slash = i;
            }
        }
        if last_slash < 0 {
            return ".";
        }
        if last_slash == 0 {
            return "/";
        }
        out: string = "";
        idx: int = 0;
        while idx < last_slash {
            out = out + p[idx];
            idx = idx + 1;
        }
        return out;
    }

    static pub fnc basename(p string) : string {
        last_slash: int = -1;
        foreach i, c in<string> p {
            if c == '/' || c == '\\' {
                last_slash = i;
            }
        }
        if last_slash < 0 {
            return p;
        }
        out: string = "";
        idx: int = last_slash + 1;
        while idx < p.size {
            out = out + p[idx];
            idx = idx + 1;
        }
        return out;
    }

    static pub fnc strip_ext(p string) : string {
        if p.size > 4 && p[p.size - 4] == '.' && p[p.size - 3] == 'l' && p[p.size - 2] == 's' && p[p.size - 1] == 'h' {
            out: string = "";
            idx: int = 0;
            while idx < p.size - 4 {
                out = out + p[idx];
                idx = idx + 1;
            }
            return out;
        }
        return p;
    }
}

pub def CompilerDriver : class {
    pub extra_import_dirs: vec<string>;
    pub loaded_modules: hash<string, bool>;
    pub self_path: string;   // argv[0]: how this compiler was invoked
    pub treat_from_safe: bool;   // -tfs: suppress @from native-lib security warnings
    pub imports_fatal: bool;     // a use-import failed to resolve (python raises)
    pub deferred_parse_errors: vec<string>;  // parser diagnostics surfaced as typecheck errors (M5)

    static pub fnc make() : CompilerDriver {
        return CompilerDriver {};
    }

    pub fnc add_import_dir(d string) : void {
        this.extra_import_dirs.pushb(d);
    }

    pub fnc read_file_string(path string) : string {
        f: File = File.open(path, "r");
        if f == null {
            show("error: cannot open file '", path, "'");
            return "";
        }
        content: string = f.read();
        f.close();
        return content;
    }

    pub fnc str_slice(s string, a int, b int) : string {
        out: string = "";
        i: int = a;
        while i < b && i < s.size {
            out = out + s[i];
            i = i + 1;
        }
        return out;
    }

    pub fnc home_dir() : string {
        out: string = exec("echo $HOME", "wait");
        trimmed: string = "";
        ti: int = 0;
        while ti < out.size && out[ti] != '\n' {
            trimmed = trimmed + out[ti];
            ti = ti + 1;
        }
        return trimmed;
    }

    pub fnc realpath_str(p string) : string {
        out: string = exec("realpath -m " + p, "wait");
        trimmed: string = "";
        ti: int = 0;
        while ti < out.size && out[ti] != '\n' {
            trimmed = trimmed + out[ti];
            ti = ti + 1;
        }
        if trimmed.size == 0 { return p; }
        return trimmed;
    }

    pub fnc find_module_file(mod_path string, base_dir string) : string {
        // Convert module::name into module/name.lsh or name.lsh
        rel_path: string = "";
        last_seg: string = "";
        cur_seg: string = "";

        i: int = 0;
        while i < mod_path.size {
            c: char = mod_path[i];
            if c == ':' && i + 1 < mod_path.size && mod_path[i + 1] == ':' {
                if cur_seg != "*" {
                    if rel_path.size > 0 { rel_path = rel_path + "/"; }
                    rel_path = rel_path + cur_seg;
                    last_seg = cur_seg;
                }
                cur_seg = "";
                i = i + 2;
                continue;
            }
            cur_seg = cur_seg + c;
            i = i + 1;
        }
        if cur_seg != "*" && cur_seg.size > 0 {
            if rel_path.size > 0 { rel_path = rel_path + "/"; }
            rel_path = rel_path + cur_seg;
            last_seg = cur_seg;
        }

        // Try base_dir / rel_path + ".lsh"
        p1: string = base_dir + "/" + rel_path + ".lsh";
        f1: File = File.open(p1, "r");
        if f1 != null { f1.close(); return p1; }

        // Try base_dir / last_seg + ".lsh"
        p2: string = base_dir + "/" + last_seg + ".lsh";
        f2: File = File.open(p2, "r");
        if f2 != null { f2.close(); return p2; }

        // Try extra import dirs
        foreach _, ed in<vector> this.extra_import_dirs {
            p3: string = ed + "/" + rel_path + ".lsh";
            f3: File = File.open(p3, "r");
            if f3 != null { f3.close(); return p3; }

            p4: string = ed + "/" + last_seg + ".lsh";
            f4: File = File.open(p4, "r");
            if f4 != null { f4.close(); return p4; }
        }

        // Global installed libraries: ~/.leash/libs (python parity). The
        // direct paths first, then a recursive walk matching the module
        // name at any depth.
        home: string = this.home_dir();
        if home.size > 0 {
            libs: string = home + "/.leash/libs";
            pg1: string = libs + "/" + rel_path + ".lsh";
            fg1: File = File.open(pg1, "r");
            if fg1 != null { fg1.close(); return pg1; }

            pg2: string = libs + "/" + last_seg + ".lsh";
            fg2: File = File.open(pg2, "r");
            if fg2 != null { fg2.close(); return pg2; }

            if last_seg.size > 0 {
                f_out: string = exec("find " + libs + " -type f -name '" + last_seg + ".lsh' 2>/dev/null", "wait");
                f_count: int = 0;
                f_first: string = "";
                foi: int = 0;
                while foi < f_out.size {
                    f_ln: string = "";
                    while foi < f_out.size && f_out[foi] != '\n' {
                        f_ln = f_ln + f_out[foi];
                        foi = foi + 1;
                    }
                    if f_ln.size > 0 {
                        f_count = f_count + 1;
                        if f_count == 1 { f_first = f_ln; }
                    }
                    foi = foi + 1;
                }
                if f_count == 1 { return f_first; }
                if f_count > 1 {
                    // Multiple matches: ambiguous (python raises the same)
                    show("error: Module '" + this.strip_wildcard(mod_path) + "' not found or ambiguous");
                    return "";
                }
            }
        }

        // Nothing resolved anywhere (python raises the same)
        show("error: Module '" + this.strip_wildcard(mod_path) + "' not found or ambiguous");
        return "";
    }

    // Module path without a trailing `::*` wildcard, for diagnostics.
    pub fnc strip_wildcard(mod_path string) : string {
        if mod_path.size > 3 && mod_path[mod_path.size - 1] == '*' && mod_path[mod_path.size - 2] == ':' && mod_path[mod_path.size - 3] == ':' {
            return this.str_slice(mod_path, 0, mod_path.size - 3);
        }
        return mod_path;
    }

    // True when every '::'-separated segment of a module path is a plain
    // identifier (never '', '.', '..' or digit-leading — traversal defense,
    // python parity).
    pub fnc valid_module_path(imp string) : bool {
        seg: string = "";
        vi: int = 0;
        while vi <= imp.size {
            at_end: bool = vi == imp.size;
            c: char = ':';
            if !at_end { c = imp[vi]; }
            // The `::*` wildcard tail is consumed by the parser's item
            // section (python strips it from the path): skip it here.
            if c == ':' && vi + 1 < imp.size && imp[vi + 1] == '*' {
                vi = vi + 2;
                continue;
            }
            if at_end || (c == ':' && vi + 1 < imp.size && imp[vi + 1] == ':') {
                // A bare "*" — the wildcard item (the parser consumes it
                // as the item section's wildcard): valid, skip it.
                if seg == "*" {
                    if at_end { return true; }
                    seg = "";
                    vi = vi + 1;
                    continue;
                }
                if seg.size == 0 { return false; }
                if seg == "." || seg == ".." { return false; }
                if seg[0] >= '0' && seg[0] <= '9' { return false; }
                si2: int = 0;
                while si2 < seg.size {
                    sc: char = seg[si2];
                    okc: bool = (sc >= 'a' && sc <= 'z') || (sc >= 'A' && sc <= 'Z') || (sc >= '0' && sc <= '9') || sc == '_';
                    if !okc { return false; }
                    si2 = si2 + 1;
                }
                seg = "";
                if !at_end { vi = vi + 2; continue; }
            } else {
                seg = seg + c;
            }
            vi = vi + 1;
        }
        return true;
    }

    pub fnc resolve_imports(prog Program, base_dir string, check_mode bool) : void {
        imports_to_process: vec<string> = prog.imports;
        empty_imps: vec<string>;
        prog.imports = empty_imps; // clear so we don't duplicate

        foreach _, imp in<vector> imports_to_process {
            if !this.valid_module_path(imp) {
                show("error: Invalid module path in import — module paths must be plain identifiers");
                this.imports_fatal = true;
                return;
            }
            mod_file: string = this.find_module_file(imp, base_dir);
            if mod_file.size == 0 {
                // The not-found/ambiguous message was printed by the
                // resolver; the import failure is fatal (python raises)
                this.imports_fatal = true;
                return;
            }

            if this.loaded_modules.isin(mod_file) {
                continue;
            }
            this.loaded_modules.push(mod_file, true);

            mod_code: string = this.read_file_string(mod_file);
            mod_lex: Lexer = Lexer.make(mod_code);
            mod_toks: vec<Token> = mod_lex.tokenize();
            if mod_lex.errs > 0 {
                if mod_lex.err_msg.size > 0 {
                    this.print_parse_error(mod_lex.err_msg, "", this.realpath_str(mod_file), mod_lex.err_line, mod_lex.err_col);
                }
                this.imports_fatal = true;
                return;
            }
            mod_parser: Parser = Parser.make(mod_toks);
            mod_parser.src_file = this.realpath_str(mod_file);
            mod_prog: Program = mod_parser.parse_program();
            foreach _, mde in<vector> mod_parser.deferred_errors {
                this.deferred_parse_errors.pushb(mde);
            }
            if mod_parser.fatal {
                // Python parses modules with the same parser, so a fatal
                // error inside an imported module is fatal there too.
                this.print_parse_error(mod_parser.fatal_msg, mod_parser.fatal_tip, mod_parser.src_file, mod_parser.fatal_line, mod_parser.fatal_col);
                this.imports_fatal = true;
                return;
            }
            if mod_parser.parse_errs > 0 && !check_mode {
                show("error: ", tostring(mod_parser.parse_errs), " parse error(s) in imported module '", mod_file, "' (see above)");
                this.imports_fatal = true;
                return;
            }

            // Recursively resolve sub-imports
            this.resolve_imports(mod_prog, Path.dirname(mod_file), check_mode);
            if this.imports_fatal { return; }

            // A module imported with an alias gets its contents namespaced
            alias_for_this: string = "";
            if prog.import_aliases.isin(imp) {
                alias_for_this = prog.import_aliases[imp];
            }

            // Splice module declarations into current program
            foreach _, s in<vector> mod_prog.structs { prog.structs.pushb(s); }
            foreach _, c in<vector> mod_prog.classes { prog.classes.pushb(c); }
            foreach _, e in<vector> mod_prog.enums { prog.enums.pushb(e); }
            foreach _, u in<vector> mod_prog.unions { prog.unions.pushb(u); }
            foreach _, g in<vector> mod_prog.globals {
                if alias_for_this.size > 0 { g.name = alias_for_this + "_" + g.name; }
                prog.globals.pushb(g);
            }
            foreach _, f in<vector> mod_prog.funcs {
                if alias_for_this.size > 0 { f.name = alias_for_this + "_" + f.name; }
                prog.funcs.pushb(f);
            }
            // Macro definitions ride along too: the post-import
            // expansion pass resolves them in the importing program.
            foreach _, md in<vector> mod_prog.macro_defs {
                prog.macros.push(md.name, md);
            }
            // Type aliases ride along as ordered name/target pairs.
            ta_j: int = 0;
            while ta_j + 1 < mod_prog.type_alias_defs.size {
                prog.type_alias_defs.pushb(mod_prog.type_alias_defs.get(ta_j));
                prog.type_alias_defs.pushb(mod_prog.type_alias_defs.get(ta_j + 1));
                ta_j = ta_j + 2;
            }
            // Native library requests (@from blocks) carry their source
            // attribution along so the security scan can tell transitive
            // links from the main file's own declarations.
            foreach _, nl in<vector> mod_prog.native_libs { prog.native_libs.pushb(nl); }
            foreach mj, nf in<vector> mod_prog.native_lib_files {
                prog.native_lib_files.pushb(nf);
                prog.native_lib_lines.pushb(mod_prog.native_lib_lines[mj]);
                prog.native_lib_cols.pushb(mod_prog.native_lib_cols[mj]);
            }
        }
    }

    // Fetch one line (1-based) from a source file for diagnostic display.
    pub fnc read_source_line(path string, line_no int) : string {
        if line_no < 1 { return ""; }
        content: string = this.read_file_string(path);
        if content.size == 0 { return ""; }
        cur: int = 1;
        start: int = 0;
        i: int = 0;
        while i < content.size {
            if content[i] == '\n' {
                if cur == line_no {
                    out: string = "";
                    k: int = start;
                    while k < i { out = out + content[k]; k = k + 1; }
                    return out;
                }
                cur = cur + 1;
                start = i + 1;
            }
            i = i + 1;
        }
        if cur == line_no {
            out: string = "";
            k: int = start;
            while k < content.size { out = out + content[k]; k = k + 1; }
            return out;
        }
        return "";
    }

    // The gutter pad Python's diagnostics use: spaces to the line-number column.
    pub fnc diag_pad(line_no int) : string {
        if line_no < 1 { return "  "; }
        digits: int = 0;
        n: int = line_no;
        while n > 0 { digits = digits + 1; n = n / 10; }
        pad: string = "";
        di: int = 0;
        while di < digits + 1 { pad = pad + " "; di = di + 1; }
        return pad;
    }

    pub fnc print_sec_error(msg string, tip string, disp string, line_no int, col int) : void {
        show("error [E_SECURITY]: ", msg);
        show("  --> ", disp, ":", line_no, ":", col);
        pad: string = this.diag_pad(line_no);
        src_line: string = this.read_source_line(disp, line_no);
        if src_line.size > 0 {
            show(pad, "|");
            show(line_no, " | ", src_line);
            cpad: string = "";
            ci: int = 0;
            while ci < col { cpad = cpad + " "; ci = ci + 1; }
            show(pad, "| ", cpad, "^");
            show(pad, "|");
        }
        if tip.size > 0 {
            show(pad, "= tip: ", tip);
        }
    }

    // Python-parity plain error (same rustc-style layout the cli prints
    // for LeashError, e.g. the unsupported-keyword misuse rejection).
    // `col` is stage1's 1-based token column; python's diagnostics print
    // its 0-based column, so the header uses col-1.
    pub fnc print_parse_error(msg string, tip string, disp string, line_no int, col int) : void {
        pcol: int = col - 1;
        if pcol < 0 { pcol = 0; }
        show("error: ", msg);
        show("  --> ", disp, ":", line_no, ":", pcol);
        pad: string = this.diag_pad(line_no);
        src_line: string = this.read_source_line(disp, line_no);
        if src_line.size > 0 {
            show(pad, "|");
            show(line_no, " | ", src_line);
            cpad: string = "";
            ci: int = 0;
            while ci < pcol { cpad = cpad + " "; ci = ci + 1; }
            show(pad, "| ", cpad, "^");
            show(pad, "|");
        }
        if tip.size > 0 {
            show(pad, "= tip: ", tip);
        }
    }

    pub fnc print_sec_warning(msg string, tip string, src string, line_no int, col int) : void {
        show("warning: ", msg);
        show("  --> ", src, ":", line_no, ":", col, " [W_SECURITY]");
        pad: string = this.diag_pad(line_no);
        src_line: string = this.read_source_line(src, line_no);
        if src_line.size > 0 {
            show(pad, "|");
            show(line_no, " | ", src_line);
            cpad: string = "";
            ci: int = 0;
            while ci < col { cpad = cpad + " "; ci = ci + 1; }
            show(pad, "| ", cpad, "^");
            show(pad, "|");
        }
        if tip.size > 0 {
            show(pad, "= tip: ", tip);
        }
    }

    // Security pass over @from native-link declarations (Python cli.py parity).
    //   E_SECURITY (fatal): lib paths escaping the module dir — absolute
    //   paths, '~', '..' segments, or symlinked candidates outside it.
    //   W_SECURITY: transitive @from from imported modules (unless -tfs).
    // Returns the number of fatal errors. main_file is the realpath'd entry
    // source (identity comparisons); input_file is the path as given (used
    // verbatim in diagnostics pointing at the main file, like Python).
    pub fnc security_scan(prog Program, main_file string, input_file string, target_name string) : int {
        fatal: int = 0;
        exts: vec<string>;
        exts.pushb(".so");
        exts.pushb(".a");
        exts.pushb(".dylib");
        exts.pushb(".lib");
        exts.pushb(".dll");

        idx: int = 0;
        while idx < prog.native_libs.size {
            lib: string = prog.native_libs[idx];
            src: string = prog.native_lib_files[idx];
            sline: int = prog.native_lib_lines[idx];
            scol: int = prog.native_lib_cols[idx];
            if sline < 1 { sline = 1; }
            if scol < 0 { scol = 0; }

            // Path sanity: relative, no '~', no '..' segments
            bad: bool = false;
            if lib.size > 0 && (lib[0] == '/' || lib[0] == '~') { bad = true; }
            norm: string = "";
            bi: int = 0;
            while bi < lib.size {
                if lib[bi] == '\\' { norm = norm + "/"; } else { norm = norm + lib[bi]; }
                bi = bi + 1;
            }
            seg: string = "";
            si: int = 0;
            while si < norm.size {
                if norm[si] == '/' {
                    if seg == ".." { bad = true; }
                    seg = "";
                } else {
                    seg = seg + norm[si];
                }
                si = si + 1;
            }
            if seg == ".." { bad = true; }

            base_dir: string = Path.dirname(main_file);
            if src.size > 0 { base_dir = Path.dirname(src); }
            real_base: string = this.realpath_str(base_dir);
            // Diagnostics on the main file show the path as the user gave it
            disp: string = src;
            if disp.size == 0 || disp == main_file { disp = input_file; }

            if bad {
                this.print_sec_error(
                    "Security: native library path '" + lib + "' in @from must be a relative path that stays inside the module directory — absolute paths and '..' segments can link an arbitrary binary into your program",
                    "Place the library next to the source file and reference it by file name, e.g. @from(\"libfoo.a\").",
                    disp, sline, scol);
                fatal = fatal + 1;
                idx = idx + 1;
                continue;
            }

            // Symlink containment: every existing candidate must stay inside
            // the declaring module's directory after realpath.
            escaped: bool = false;
            ci: int = 0;
            while ci <= 5 && !escaped {
                cand: string = lib;
                if ci > 0 { cand = lib + exts[ci - 1]; }
                cand_path: string = cand;
                if cand_path.size > 0 && cand_path[0] != '/' {
                    cand_path = base_dir + "/" + cand_path;
                }
                if this.file_exists(cand_path) {
                    real_cand: string = this.realpath_str(cand_path);
                    if real_cand != real_base {
                        inside: bool = false;
                        if real_cand.size > real_base.size {
                            pref_ok: bool = true;
                            ki: int = 0;
                            while ki < real_base.size {
                                if real_cand[ki] != real_base[ki] { pref_ok = false; }
                                ki = ki + 1;
                            }
                            if pref_ok && real_cand[real_base.size] == '/' { inside = true; }
                        }
                        if !inside { escaped = true; }
                    }
                }
                ci = ci + 1;
            }
            if escaped {
                this.print_sec_error(
                    "Security: native library path '" + lib + "' in @from resolves (via symlink) outside the module directory — it could link an arbitrary binary into your program",
                    "Remove the symlink and place the real library next to the source file.",
                    disp, sline, scol);
                fatal = fatal + 1;
                idx = idx + 1;
                continue;
            }

            // Transitive native-link request from an imported module. The
            // JVM target links no archive (@from only declares signatures
            // there; the backend lowers them to bundled Java shims), so
            // the "links a native library" warning would be noise.
            if target_name == "jvm" { }
            also src.size > 0 && src != main_file && !this.treat_from_safe {
                this.print_sec_warning(
                    "Security: imported module '" + Path.basename(src) + "' links native library '" + lib + "' into this build via @from — native libraries from dependencies run with your program's full privileges",
                    "Confirm the dependency is expected to ship a native library, or review/build it from source.",
                    src, sline, scol);
            }
            idx = idx + 1;
        }
        return fatal;
    }

    pub fnc fnv_char(h int, c char) : int {
        h = h ^ c;
        h = h * 16777619;
        return h;
    }

    pub fnc fnv_str(s string) : int {
        h: int = -2128831035;
        i: int = 0;
        while i < s.size {
            h = this.fnv_char(h, s[i]);
            i = i + 1;
        }
        return h;
    }

    pub fnc fnv_lines(lines vec<string>) : int {
        h: int = -2128831035;
        foreach _, ln in<vector> lines {
            i: int = 0;
            while i < ln.size {
                h = this.fnv_char(h, ln[i]);
                i = i + 1;
            }
            h = this.fnv_char(h, '\n');
        }
        return h;
    }

    pub fnc file_exists(p string) : bool {
        f: File = File.open(p, "r");
        if f != null {
            f.close();
            return true;
        }
        return false;
    }

    // Refuse to write through a planted symlink: `open(path, "w")` and
    // clang's `-o` truncate whatever the link points at, so a cloned repo
    // could clobber files outside it (python _safe_write_bytes parity).
    pub fnc refuse_symlink_output(p string) : bool {
        if p.size == 0 { return false; }
        q: string = "'";
        qi: int = 0;
        while qi < p.size {
            if p[qi] == '\'' {
                q = q + "'\\''";
            } else {
                q = q + p[qi];
            }
            qi = qi + 1;
        }
        q = q + "'";
        hit: string = exec("test -L " + q + " && echo 1", "wait");
        if hit.size > 0 {
            show("error: refusing to write '", p, "': it is a symlink");
            return true;
        }
        return false;
    }

    pub fnc exec_code(cmd string) : string {
        // Python-compiled exec("x","code") returns "N\n"; self-hosted returns "N".
        // "code" mode drains output silently, so on failure the command is
        // re-run with the terminal attached: the user sees clang's actual
        // error instead of a bare "compilation failed".
        ec: string = exec(cmd, "code");
        if ec != "0" && ec != "0\n" {
            exec(cmd, nil);
        }
        trimmed: string = "";
        i: int = 0;
        while i < ec.size && ec[i] != '\n' {
            trimmed = trimmed + ec[i];
            i = i + 1;
        }
        return trimmed;
    }

    pub fnc exec_out(cmd string) : string {
        out: string = exec(cmd, "wait");
        trimmed: string = "";
        i: int = 0;
        while i < out.size && out[i] != '\n' {
            trimmed = trimmed + out[i];
            i = i + 1;
        }
        return trimmed;
    }

    // Validate cross-execution of a built binary (Python parity): wine for
    // win64 off-Windows, qemu-aarch64 for ARM64 off-ARM, hard error for
    // macOS. Returns the validated prefix, or "" on failure after printing.
    pub fnc cross_run_prefix(target_name string) : string {
        if target_name.size == 0 || target_name == "linux64" || target_name == "linux32" {
            return "";
        }
        if target_name == "linux-arm" {
            if this.exec_out("uname -m") == "aarch64" {
                return "";
            }
            if this.exec_out("command -v qemu-aarch64").size == 0 {
                show("error: Cannot run linux-arm binary on a non-ARM host. Install qemu-user (qemu-aarch64) to execute ARM64 binaries.");
                return "";
            }
            return "qemu-aarch64 -L /usr/aarch64-linux-gnu ";
        }
        if target_name == "win64" {
            if this.exec_out("uname -m") != "x86_64" {
                return "wine ";
            }
            if this.exec_out("command -v wine").size == 0 {
                show("error: Cannot run win64 binary on non-Windows without wine");
                return "";
            }
            return "wine ";
        }
        if target_name == "macos" || target_name == "macos-arm" {
            show("error: Cannot run macOS binary on non-macOS");
            return "";
        }
        return "";
    }

    pub fnc compile_file(input_file string, output_file string, emit_llvm bool, run_mode bool, run_args string, opt_level string, check_mode bool, extra_libs vec<string>, verbose bool, warn_err bool, debug_instrument bool, target_name string, no_gc bool, static_link bool, output_type string, autofree bool) : int {
        if verbose { show("[verbose] reading ", input_file); }
        source: string = this.read_file_string(input_file);
        if source.size == 0 {
            if verbose { show("[verbose] empty or unreadable source — aborting"); }
            return 1;
        }

        base_dir: string = Path.dirname(input_file);

        // Lex
        if verbose { show("[verbose] lexing (", tostring(source.size), " bytes)"); }
        lexer: Lexer = Lexer.make(source);
        tokens: vec<Token> = lexer.tokenize();
        if lexer.errs > 0 {
            // Fatal lex errors stop the compile before parsing (python's
            // lexer raises on the first one); render it with its location.
            if lexer.err_msg.size > 0 {
                this.print_parse_error(lexer.err_msg, "", this.realpath_str(input_file), lexer.err_line, lexer.err_col);
            }
            return 1;
        }

        // Parse
        if verbose { show("[verbose] parsing (", tostring(tokens.size), " tokens)"); }
        abs_main: string = this.realpath_str(input_file);
        parser: Parser = Parser.make(tokens);
        parser.src_file = abs_main;
        prog: Program = parser.parse_program();
        if parser.fatal {
            // Python parity: these parser errors are fatal there (the cli
            // exits 1); no codegen, no output binary.
            this.print_parse_error(parser.fatal_msg, parser.fatal_tip, abs_main, parser.fatal_line, parser.fatal_col);
            return 1;
        }
        if parser.parse_errs > 0 && !check_mode {
            // Recovery errors used to be ignored: mistyped constructs
            // were silently dropped and the build "succeeded" (e.g. an
            // unknown `fusion` modifier vanishing into a plain global).
            // Python raises on the first syntax error, so fail here too.
            // `--check` stays lenient: doc fragments and editor buffers
            // are often incomplete, and the doc-test suite checks the
            // declarations inside such fragments.
            show("error: ", tostring(parser.parse_errs), " parse error(s) in '", input_file, "' (see above); not emitting output");
            return 1;
        }
        if verbose {
            show("[verbose] parsed: ", tostring(prog.funcs.size), " funcs, ",
                 tostring(prog.structs.size), " structs, ", tostring(prog.classes.size), " classes, ",
                 tostring(prog.globals.size), " globals");
        }

        // Resolve imports
        if verbose { show("[verbose] resolving imports (", tostring(prog.imports.size), ")"); }
        this.resolve_imports(prog, base_dir, check_mode);
        if this.imports_fatal {
            if verbose { show("[verbose] import resolution failed"); }
            return 1;
        }
        if verbose { show("[verbose] imports resolved: ", tostring(prog.funcs.size), " funcs after splice"); }

        // Security scan (Python cli.py parity): @from path checks +
        // transitive native-library warnings; fatal errors short-circuit.
        if verbose { show("[verbose] security scan (", tostring(prog.native_libs.size), " @from blocks)"); }
        if this.security_scan(prog, abs_main, input_file, target_name) > 0 {
            return 1;
        }

        // AST optimization
        if verbose { show("[verbose] optimizing AST"); }
        opt_driver: Optimizer = Optimizer {};
        opt_driver.opt_program(prog);

        // Typecheck
        if verbose { show("[verbose] type-checking"); }
        tc: TypeChecker = TypeChecker.make();
        // JVM backend parity: python's propagated-divisor/overflow statics
        // live in the LLVM codegen only; the JVM path guards at runtime.
        if target_name == "jvm" { tc.propagated_checks_enabled = false; }
        tc.check_program(prog);
        // Surface parser-deferred diagnostics (M5 runtime array sizes) as
        // regular typecheck errors — both the main file and imports.
        foreach _, de in<vector> parser.deferred_errors {
            tc.errors.pushb(de);
        }
        foreach _, de2 in<vector> this.deferred_parse_errors {
            tc.errors.pushb(de2);
        }
        if verbose {
            show("[verbose] type-check finished: ", tostring(tc.errors.size), " errors");
        }
        if tc.errors.size > 0 {
            // Gate codegen behind a clean type-check: a type-errored
            // program used to reach clang and fail with confusing IR
            // errors instead of the real diagnostics.
            foreach _, e in<vector> tc.errors {
                show("error: ", e);
            }
            return 1;
        }
        if check_mode {
            if tc.errors.size == 0 {
                show("[leash] Type-check OK");
                return 0;
            }
            foreach _, e in<vector> tc.errors {
                show("error: ", e);
            }
            return 1;
        }

        // JVM bytecode backend (no clang, no GC runtime, no linking).
        if target_name == "jvm" {
                return this.compile_jvm(input_file, output_file, prog, tc, run_mode, run_args, verbose, output_type, emit_llvm);
        }

        // Codegen
        if verbose { show("[verbose] generating LLVM IR"); }
        cg: CodeGen = CodeGen.make(tc);
        abs_file: string = exec("realpath " + input_file, "wait");
        if abs_file.size > 0 {
            trimmed: string = "";
            ai: int = 0;
            while ai < abs_file.size && abs_file[ai] != '\n' {
                trimmed = trimmed + abs_file[ai];
                ai = ai + 1;
            }
            if trimmed.size > 0 { cg.main_file = trimmed; }
        }
        if cg.main_file.size == 0 {
            cg.main_file = input_file;
        }
        cg.debug_instrument = debug_instrument;
        cg.autofree = autofree;
        // Library outputs omit the @main wrapper (a consumer linking its
        // own main would otherwise get a duplicate symbol).
        cg.is_lib = output_type == "dynamic" || output_type == "static";
        ir_lines: vec<string> = cg.generate_module(prog);
        if verbose { show("[verbose] generated ", tostring(ir_lines.size), " IR lines"); }
        if output_type == "" && !emit_llvm && !check_mode && !cg.has_entry {
            show("error: no entry point: '", input_file, "' defines no 'main' function (build a library with to-dynamic/to-static, or add 'fnc main')");
            return 1;
        }

        out_bin: string = output_file;
        if out_bin.size == 0 {
            out_bin = Path.strip_ext(input_file);
        }
        if output_type != "" && output_type != "dynamic" && output_type != "static" {
            show("error: unknown output type '", output_type, "' (expected to-dynamic or to-static)");
            return 1;
        }
        if output_type == "dynamic" || output_type == "static" {
            // Target-gated extensions (host-gated naming puts .so on
            // macOS/Windows cross outputs, which is wrong).
            ext: string = ".so";
            if output_type == "static" { ext = ".a"; }
            if target_name == "win64" {
                ext = ".dll";
                if output_type == "static" { ext = ".lib"; }
            }
            also target_name == "macos" || target_name == "macos-arm" {
                ext = ".dylib";
                if output_type == "static" { ext = ".a"; }
            }
            has_ext: bool = false;
            if out_bin.size >= ext.size {
                tail_ok: bool = true;
                ei: int = 0;
                while ei < ext.size {
                    if out_bin[out_bin.size - ext.size + ei] != ext[ei] { tail_ok = false; }
                    ei = ei + 1;
                }
                has_ext = tail_ok;
            }
            if !has_ext { out_bin = out_bin + ext; }
        }

        if emit_llvm {
            ll_path: string = out_bin + ".ll";
            if this.refuse_symlink_output(ll_path) { return 1; }
            f_ll: File = File.open(ll_path, "w");
            if f_ll == null {
                show("error: cannot write to '", ll_path, "'");
                return 1;
            }
            foreach _, ir_ln in<vector> ir_lines {
                f_ll.write(ir_ln);
                f_ll.write("\n");
            }
            f_ll.close();
            show("[leash] Wrote LLVM IR to ", ll_path);
            return 0;
        }

        // ---- Object cache (mirrors the Python compiler's ~/.leash/objcache) ----
        // Keyed by an FNV-1a hash of the IR lines + opt level; the runtime
        // (gc.c + stubs) is compiled once per (size,mtime) tag. Warm compiles
        // link prebuilt objects only: fast and ~70MB total RSS.
        opt_flag: string = "-O2";
        if opt_level == "0" { opt_flag = "-O0"; }
        also opt_level == "1" { opt_flag = "-O1"; }
        also opt_level == "3" { opt_flag = "-O3"; }
        also opt_level == "4" {
            // Python-parity O4: the O3 pipeline with a raised inliner
            // threshold (default 225 -> 600) so more functions inline and
            // downstream GVN/LICM/DSE find more; SLP vectorization is part
            // of clang's -O3 already, and the extra cleanup passes (GVN,
            // SCCP, DCE, global DCE) run inside -O3.
            opt_flag = "-O3 -mllvm -inline-threshold=600";
        }
        also opt_level == "s" { opt_flag = "-Os"; }
        also opt_level == "z" { opt_flag = "-Oz"; }
        lib_flags: string = "";
        foreach _, lib in<vector> extra_libs {
            lib_flags = lib_flags + " -l" + lib;
        }
        // @from("lib.so"/"lib.a") paths link directly; bare names link as -l.
        // Relative paths resolve against the declaring module's directory
        // (python parity: resolve_native_lib_path joins source_dir).
        nl_i: int = 0;
        foreach _, nlib in<vector> prog.native_libs {
            resolved: string = nlib;
            if nlib.size > 0 && nlib[0] != '/' && nl_i < prog.native_lib_files.size {
                nlib_dir: string = Path.dirname(prog.native_lib_files[nl_i]);
                dot_i: int = -1;
                di: int = nlib.size - 1;
                while di >= 0 {
                    if nlib[di] == '.' { dot_i = di; stop; }
                    di = di - 1;
                }
                if dot_i <= 0 {
                    // Extension-less: probe platform extensions next to the
                    // module (python tries .so/.a, then falls back to .so).
                    c1: string = nlib_dir + "/" + nlib + ".so";
                    c2: string = nlib_dir + "/" + nlib + ".a";
                    c3: string = nlib_dir + "/" + nlib + ".dylib";
                    if this.file_exists(c1) { resolved = c1; }
                    also this.file_exists(c2) { resolved = c2; }
                    also this.file_exists(c3) { resolved = c3; }
                    else { resolved = c1; }
                } else {
                    resolved = nlib_dir + "/" + nlib;
                }
            }
            if resolved.size > 3 && (resolved[resolved.size - 3] == '.' && resolved[resolved.size - 2] == 's' && resolved[resolved.size - 1] == 'o') {
                lib_flags = lib_flags + " " + resolved;
            } also resolved.size > 2 && resolved[resolved.size - 2] == '.' && resolved[resolved.size - 1] == 'a' {
                lib_flags = lib_flags + " " + resolved;
            } else {
                lib_flags = lib_flags + " -l" + resolved;
            }
            nl_i = nl_i + 1;
        }

        // ---- Target / link-mode flags (Python parity) -----------------------
        // The self-hosted compiler drives the host clang, so cross targets
        // are clang driver flags. Objects and the runtime are compiled for
        // the target; the IR text itself is target-agnostic (clang warns
        // and overrides the module triple with the --target given here).
        cc_bin: string = "clang";
        cc_flags: string = "";
        rt_extra: string = "";
        is_win: bool = false;
        is_macos: bool = false;
        run_prefix: string = "";
        if target_name == "linux32" {
            cc_flags = "-m32";
        } also target_name == "linux-arm" {
            cc_flags = "--target=aarch64-linux-gnu";
            if this.exec_out("uname -m") != "aarch64" {
                run_prefix = "qemu-aarch64 -L /usr/aarch64-linux-gnu ";
            }
        } also target_name == "win64" {
            cc_flags = "--target=x86_64-w64-mingw32";
            is_win = true;
            if this.exec_out("uname -m") != "x86_64" {
                run_prefix = "wine ";
            }
        } also target_name == "macos" {
            cc_flags = "--target=x86_64-apple-darwin";
            is_macos = true;
        } also target_name == "macos-arm" {
            cc_flags = "--target=aarch64-apple-darwin";
            is_macos = true;
        }
        if no_gc || autofree {
            // Stub runtime: plain malloc/free behind the same API.
            // Autofree additionally frees tracked allocations at scope
            // exit, so every allocation must be plain malloc (never GC
            // cells, which libc free() cannot release).
            rt_extra = rt_extra + " -DNO_GC";
        }
        if static_link {
            if target_name.size > 0 && target_name != "linux64" && target_name != "linux32" {
                show("error: --static is supported for linux64/linux32 only");
                return 1;
            }
            if this.exec_out("command -v musl-clang").size > 0 {
                cc_bin = "musl-clang";
                cc_flags = cc_flags + " -static";
            } also this.exec_out("command -v musl-gcc").size > 0 {
                cc_bin = "musl-gcc";
                cc_flags = cc_flags + " -static";
            } else {
                cc_flags = cc_flags + " --target=x86_64-linux-musl -static";
            }
        }

        // Windows output naming: out.exe (Python parity). Libraries
        // keep their own suffix (.dll/.lib from above, never .exe).
        if is_win && out_bin.size > 4 && output_type != "dynamic" && output_type != "static" {
            win_sfx: bool = true;
            wi: int = out_bin.size - 4;
            if out_bin[wi] == '.' && out_bin[wi + 1] == 'e' && out_bin[wi + 2] == 'x' && out_bin[wi + 3] == 'e' { win_sfx = false; }
            if win_sfx { out_bin = out_bin + ".exe"; }
        }

        // Refuse to write the final artifact through a planted symlink
        // (python's _safe_write_bytes guard for `-o` targets).
        if this.refuse_symlink_output(out_bin) { return 1; }

        // Link flags vary by target (Python's targets.py). rsp form rides in
        // a response file; inline form is the no-rsp fallback.
        link_rsp_flags: string = "-no-pie\n" +
                                 "-Wl,--gc-sections\n" +
                                 "-Wl,--strip-all\n" +
                                 "-Wl,--build-id=none\n" +
                                 "-Wl,-O1\n" +
                                 "-Wl,--hash-style=gnu\n";
        link_flags_inline: string = "-no-pie -Wl,--gc-sections -Wl,--strip-all -Wl,--build-id=none -Wl,-O1 -Wl,--hash-style=gnu";
        tail_flags: string = " -pthread -lm -ldl";
        if is_win {
            link_rsp_flags = "-mconsole\n" +
                             "-Wl,--gc-sections\n" +
                             "-Wl,--strip-all\n";
            link_flags_inline = "-mconsole -Wl,--gc-sections -Wl,--strip-all";
            /* SChannel (serve_tls) plus Crypt32/NCrypt (PEM cert/key) and
             * Winsock: all shipped with Windows. Unused import libs are
             * dropped by the linker, so this is safe for every program. */
            tail_flags = " -lws2_32 -lsecur32 -lcrypt32 -lncrypt";
        } also is_macos {
            link_rsp_flags = "-Wl,-dead_strip\n" +
                             "-Wl,-S\n";
            link_flags_inline = "-Wl,-dead_strip -Wl,-S";
            tail_flags = " -lm";
        }

        home_dir: string = this.exec_out("echo $HOME");
        cache_dir: string = home_dir + "/.leash/shcache";
        if home_dir.size > 0 {
            exec("mkdir -p " + cache_dir, nil);
        }

        // Find leash gc.c location
        // Locate the runtime sources (gc.c + cross_compile_stubs.c):
        //   1. repo layout: run from the repository root (leash/gc.c)
        //   2. pip layout: the launcher exports LEASH_RUNTIME=<pkg>/leash
        //   3. argv[0]-relative: the binary sits next to the runtime
        //      (dev: <repo>/bin/leashc, pip: <pkg>/leash/native/leashc)
        gc_path: string = "leash/gc.c";
        if !this.file_exists(gc_path) {
            rt_env: string = this.exec_out("printenv LEASH_RUNTIME");
            if rt_env.size > 0 {
                env_cand: string = rt_env + "/gc.c";
                if this.file_exists(env_cand) { gc_path = env_cand; }
            }
        }
        if !this.file_exists(gc_path) && this.self_path.size > 0 {
            sp: string = this.self_path;
            sp_has_slash: bool = false;
            spi: int = 0;
            while spi < sp.size {
                if sp[spi] == '/' { sp_has_slash = true; }
                spi = spi + 1;
            }
            if !sp_has_slash { sp = this.exec_out("command -v " + sp); }
            if sp.size > 0 {
                abs_exe: string = this.exec_out("readlink -f " + sp);
                slash: int = -1;
                si: int = 0;
                while si < abs_exe.size {
                    if abs_exe[si] == '/' { slash = si; }
                    si = si + 1;
                }
                if slash > 0 {
                    exe_dir: string = "";
                    si = 0;
                    while si < slash {
                        exe_dir = exe_dir + abs_exe[si];
                        si = si + 1;
                    }
                    // dev build:  <repo>/bin/leashc         -> <repo>/leash/gc.c
                    // pip build:  <pkg>/leash/native/leashc  -> <pkg>/leash/gc.c
                    cand1: string = exe_dir + "/../leash/gc.c";
                    cand2: string = exe_dir + "/../gc.c";
                    cand3: string = exe_dir + "/gc.c";
                    if this.file_exists(cand1) { gc_path = cand1; }
                    also this.file_exists(cand2) { gc_path = cand2; }
                    also this.file_exists(cand3) { gc_path = cand3; }
                }
            }
        }
        if !this.file_exists(gc_path) {
            show("error: cannot find the Leash runtime (leash/gc.c)");
            show("       run from the repository root, or install the leash package");
            return 1;
        }

        // Runtime stubs live next to gc.c
        dir_part: string = "";
        di: int = 0;
        while di < gc_path.size - 4 {
            dir_part = dir_part + gc_path[di];
            di = di + 1;
        }
        stubs_path: string = dir_part + "cross_compile_stubs.c";
        if is_win {
            stubs_path = dir_part + "windows_stubs.c";
        }
        if !this.file_exists(stubs_path) {
            stubs_path = "";
        }

        use_cache: bool = home_dir.size > 0 && this.file_exists(cache_dir);

        obj_path: string = "";
        runtime_objs: string = "";

        // Response file with the cc flags for this invocation: exec()
        // commands are length-capped, and target/static/O4 flag sets do
        // not fit inline. One rsp per purpose, written under the cache dir
        // (or /tmp without one).
        rsp_dir: string = cache_dir;
        if !use_cache { rsp_dir = "/tmp"; }
        rsp_rt: string = rsp_dir + "/ccrt_" + tostring(this.fnv_str("rt|" + cc_bin + "|" + cc_flags + "|" + rt_extra)) + ".rsp";
        f_rt_rsp: File = File.open(rsp_rt, "w");
        if f_rt_rsp != null {
            f_rt_rsp.write("-O2 -pthread -ffunction-sections -fdata-sections" + rt_extra + "\n");
            f_rt_rsp.write(cc_flags + "\n");
            f_rt_rsp.close();
        }

        // Prebuild the runtime objects once per (size, mtime, flags) tag
        if use_cache {
            // Key on (mtime, size, flags): a runtime-flag change must
            // invalidate the cached object or --gc-sections finds no
            // function sections to strip (Python does the same).
            gc_tag: string = this.exec_out("stat -c '%s_%Y' " + gc_path) + "|O2|fsections|" + cc_flags + "|" + rt_extra;
            rt_gc: string = cache_dir + "/rt" + tostring(this.fnv_str(gc_tag)) + "_gc.o";
            if !this.file_exists(rt_gc) {
                if verbose { show("[verbose] compiling runtime gc.c"); }
                ec_rt: string = this.exec_code(cc_bin + " " + gc_path + " -c -o " + rt_gc + " @" + rsp_rt);
                if ec_rt != "0" {
                    show("error: cannot compile runtime gc.c");
                    return 1;
                }
            }
            runtime_objs = rt_gc;

            if stubs_path.size > 0 {
                stubs_tag: string = this.exec_out("stat -c '%s_%Y' " + stubs_path) + "|O2|fsections|" + cc_flags + "|" + rt_extra;
                rt_stubs: string = cache_dir + "/rt" + tostring(this.fnv_str(stubs_tag)) + "_stubs.o";
                if !this.file_exists(rt_stubs) {
                    ec_st: string = this.exec_code(cc_bin + " " + stubs_path + " -c -o " + rt_stubs + " @" + rsp_rt);
                    if ec_st != "0" {
                        show("error: cannot compile runtime stubs");
                        return 1;
                    }
                }
                runtime_objs = runtime_objs + " " + rt_stubs;
            }

            // Program object keyed by IR content + opt level + target flags.
            // Library objects are PIC (executables link -no-pie, but a
            // non-PIC .a/.so cannot link into PIE executables or .so files).
            pic_flag: string = "";
            if output_type == "dynamic" || output_type == "static" {
                pic_flag = "-fPIC";
            }
            ir_key: int = this.fnv_lines(ir_lines);
            obj_path = cache_dir + "/o" + tostring(this.fnv_str(opt_flag + "|" + cc_flags + "|" + pic_flag + "|" + tostring(ir_key))) + ".o";

            if verbose { show("[verbose] object cache: ", this.file_exists(obj_path) ? "hit" : "miss"); }
            if !this.file_exists(obj_path) {
                temp_ll: string = "/tmp/leashc_" + Path.basename(out_bin) + ".ll";
                f_tmp: File = File.open(temp_ll, "w");
                if f_tmp == null {
                    show("error: cannot write to '", temp_ll, "'");
                    return 1;
                }
                foreach _, ir_ln2 in<vector> ir_lines {
                    f_tmp.write(ir_ln2);
                    f_tmp.write("\n");
                }
                f_tmp.close();
                rsp_obj: string = "/tmp/leashc_" + Path.basename(out_bin) + "_obj.rsp";
                f_obj_rsp: File = File.open(rsp_obj, "w");
                if f_obj_rsp != null {
                    f_obj_rsp.write(opt_flag + "\n");
                    f_obj_rsp.write(cc_flags + "\n");
                    f_obj_rsp.write(pic_flag + "\n");
                    f_obj_rsp.close();
                    ec_obj: string = this.exec_code(cc_bin + " " + temp_ll + " -c -o " + obj_path + " @" + rsp_obj);
                    if ec_obj != "0" {
                        show("error: clang IR compilation failed");
                        return 1;
                    }
                } else {
                    ec_obj2: string = this.exec_code(cc_bin + " " + temp_ll + " -c -o " + obj_path + " " + opt_flag + " " + cc_flags + " " + pic_flag);
                    if ec_obj2 != "0" {
                        show("error: clang IR compilation failed");
                        return 1;
                    }
                }
            }
        } else {
            // Cold path, no usable cache dir: compile + link in one go
            temp_ll: string = "/tmp/leashc_" + Path.basename(out_bin) + ".ll";
            f_tmp: File = File.open(temp_ll, "w");
            if f_tmp == null {
                show("error: cannot write to '", temp_ll, "'");
                return 1;
            }
            foreach _, ir_ln2 in<vector> ir_lines {
                f_tmp.write(ir_ln2);
                f_tmp.write("\n");
            }
            f_tmp.close();
            if output_type == "dynamic" || output_type == "static" {
                // Cold-path libraries: PIC object first, then shared/ar.
                cold_pic: string = "-fPIC";
                cold_obj: string = "/tmp/leashc_" + Path.basename(out_bin) + ".o";
                ec_cobj: string = this.exec_code(cc_bin + " " + temp_ll + " -c -o " + cold_obj + " " + opt_flag + " " + cc_flags + " " + cold_pic);
                if ec_cobj != "0" {
                    show("error: clang IR compilation failed");
                    return 1;
                }
                if output_type == "dynamic" {
                    // PE DLLs cannot have undefined symbols: link the
                    // runtime sources in on win64 (ELF leaves them for
                    // the consumer, like the cached path above).
                    cold_rt: string = "";
                    if target_name == "win64" {
                        cold_rt = gc_path;
                        if stubs_path.size > 0 {
                            cold_rt = cold_rt + " " + stubs_path;
                        }
                    }
                    ec_cd: string = this.exec_code(cc_bin + " " + cold_obj + " " + cold_rt + " -shared -o " + out_bin + " " + opt_flag + " " + cc_flags + " " + lib_flags);
                    if ec_cd != "0" {
                        show("error: clang shared-library link failed");
                        return 1;
                    }
                } else {
                    cold_ar: string = "ar";
                    if target_name == "win64" { cold_ar = "x86_64-w64-mingw32-ar"; }
                    ec_ca: string = this.exec_code(cold_ar + " rcs " + out_bin + " " + cold_obj);
                    if ec_ca != "0" {
                        show("error: static archive build failed");
                        return 1;
                    }
                }
                if !run_mode {
                    show("[leash] Compiled ", input_file, " -> ", out_bin);
                }
                return 0;
            }
            rt_files_cold: string = gc_path;
            if stubs_path.size > 0 {
                rt_files_cold = rt_files_cold + " " + stubs_path;
            }
            rsp_cold: string = "/tmp/leashc_" + Path.basename(out_bin) + ".rsp";
            f_rc: File = File.open(rsp_cold, "w");
            clang_cmd: string = cc_bin + " " + temp_ll + " " + rt_files_cold + " -o " + out_bin + " " + opt_flag + " " + cc_flags + link_flags_inline + tail_flags + lib_flags;
            if f_rc != null {
                f_rc.write(link_rsp_flags);
                f_rc.write(lib_flags + "\n");
                f_rc.close();
                clang_cmd = cc_bin + " " + temp_ll + " " + rt_files_cold + " @" + rsp_cold + " -o " + out_bin + " " + opt_flag + " " + cc_flags + tail_flags;
            }
            ec_cold: string = this.exec_code(clang_cmd);
            if ec_cold != "0" {
                show("error: clang compilation failed");
                return 1;
            }
            if !run_mode {
                show("[leash] Compiled ", input_file, " -> ", out_bin);
            }
            if run_mode {
                xpre: string = this.cross_run_prefix(target_name);
                if target_name == "macos" || target_name == "macos-arm" {
                    return 1;
                }
                run_cmd: string = out_bin;
                if xpre.size == 0 && run_cmd.size > 0 && run_cmd[0] != '/' && run_cmd[0] != '.' {
                    run_cmd = "./" + run_cmd;
                }
                if run_args.size > 0 {
                    run_cmd = run_cmd + " " + run_args;
                }
                show("--- Executed at ", this.exec_out("date '+%Y-%m-%d %H:%M:%S'"), " ---");
                rc_out0: string = exec(xpre + run_cmd, "run");
                rv0: int = 0;
                p0: int = 0;
                neg0: bool = false;
                if rc_out0.size > 0 && rc_out0[0] == '-' {
                    neg0 = true;
                    p0 = 1;
                }
                while p0 < rc_out0.size && rc_out0[p0] >= '0' && rc_out0[p0] <= '9' {
                    rv0 = rv0 * 10 + (rc_out0[p0] - '0');
                    p0 = p0 + 1;
                }
                if neg0 { rv0 = 0 - rv0; }
                return rv0;
            }
            return 0;
        }

        // The link command must stay short: exec() commands are length-
        // capped by the language runtime. Everything bulky (object paths,
        // the Python-parity link flags) rides in a clang response file.
        // Libraries link only the program object (+ user -l flags): no
        // runtime objects (the consumer links gc.c/stubs itself), and
        // archives go through ar, not clang.
        if output_type == "dynamic" {
            // ELF allows undefined symbols (the consumer links gc.c +
            // stubs); PE does not, so Windows DLLs link the runtime in.
            dyn_rt: string = "";
            if target_name == "win64" { dyn_rt = runtime_objs; }
            dyn_cmd: string = cc_bin + " " + obj_path + " " + dyn_rt + " -shared -o " + out_bin + " " + opt_flag + " " + cc_flags + " " + lib_flags;
            ec_dyn: string = this.exec_code(dyn_cmd);
            if ec_dyn != "0" {
                show("error: clang shared-library link failed");
                return 1;
            }
            if !run_mode {
                show("[leash] Compiled ", input_file, " -> ", out_bin);
            }
            return 0;
        }
        if output_type == "static" {
            ar_bin: string = "ar";
            if target_name == "win64" { ar_bin = "x86_64-w64-mingw32-ar"; }
            ec_ar: string = this.exec_code(ar_bin + " rcs " + out_bin + " " + obj_path);
            if ec_ar != "0" {
                show("error: static archive build failed");
                return 1;
            }
            if !run_mode {
                show("[leash] Compiled ", input_file, " -> ", out_bin);
            }
            return 0;
        }
        rsp_file: string = "/tmp/leashc_" + Path.basename(out_bin) + ".rsp";
        link_cmd: string = cc_bin + " " + obj_path + " " + runtime_objs + " -o " + out_bin + " " + opt_flag + " " + cc_flags + link_flags_inline + tail_flags + lib_flags;
        f_rsp: File = File.open(rsp_file, "w");
        if f_rsp != null {
            f_rsp.write(obj_path + "\n");
            f_rsp.write(runtime_objs + "\n");
            f_rsp.write(link_rsp_flags);
            f_rsp.write(lib_flags + "\n");
            f_rsp.close();
            link_cmd = cc_bin + " @" + rsp_file + " -o " + out_bin + " " + opt_flag + " " + cc_flags + tail_flags;
        }

        // Link-only: prebuilt program object + runtime objects
        if verbose { show("[verbose] linking: ", link_cmd); }
        ec_link: string = this.exec_code(link_cmd);
        if ec_link != "0" {
            show("error: clang link failed");
            return 1;
        }

        if !run_mode {
            show("[leash] Compiled ", input_file, " -> ", out_bin);
        }

        // If run mode, execute the binary (inheriting the terminal) and
        // propagate its exit code (Python parity: temp run + banner + rc).
        // Cross targets run through wine / qemu-aarch64.
        if run_mode {
            xpre: string = this.cross_run_prefix(target_name);
            if target_name == "macos" || target_name == "macos-arm" {
                return 1;
            }
            run_cmd: string = out_bin;
            if xpre.size == 0 && run_cmd.size > 0 && run_cmd[0] != '/' && run_cmd[0] != '.' {
                run_cmd = "./" + run_cmd;
            }
            if run_args.size > 0 {
                run_cmd = run_cmd + " " + run_args;
            }
            show("--- Executed at ", this.exec_out("date '+%Y-%m-%d %H:%M:%S'"), " ---");
            rc_out: string = exec(xpre + run_cmd, "run");
            rv: int = 0;
            ri2: int = 0;
            rneg: bool = false;
            if rc_out.size > 0 && rc_out[0] == '-' {
                rneg = true;
                ri2 = 1;
            }
            while ri2 < rc_out.size && rc_out[ri2] >= '0' && rc_out[ri2] <= '9' {
                rv = rv * 10 + (rc_out[ri2] - '0');
                ri2 = ri2 + 1;
            }
            if rneg { rv = 0 - rv; }
            return rv;
        }

        return 0;
    }

    // JVM bytecode target: emit .class files directly (no clang, no
    // native runtime, no link step). Libraries are not supported yet.
    pub fnc compile_jvm(input_file string, output_file string, prog Program, tc TypeChecker, run_mode bool, run_args string, verbose bool, output_type string, emit_llvm bool) : int {
        if output_type == "dynamic" || output_type == "static" {
            show("error: library outputs (to-dynamic/to-static) are not supported for --target jvm yet (executables only)");
            return 1;
        }
        if emit_llvm {
            show("error: --emit-llvm is not supported for --target jvm (JVM bytecode is not LLVM IR)");
            return 1;
        }
        out_path: string = output_file;
        if out_path.size == 0 {
            out_path = Path.strip_ext(input_file);
        }
        cls_name: string = this.jvm_class_name(Path.basename(out_path));
        if cls_name.size == 0 { cls_name = "Main"; }
        dir: string = Path.dirname(out_path);
        class_path: string = dir + "/" + cls_name + ".class";
        cls: JvmClass = JvmClass.make(cls_name, "java/lang/Object");
        jg: JvmGen = JvmGen.make(tc, cls_name);
        jg.src_file = input_file;
        jg.gen_program(prog, cls);
        if jg.errors.size > 0 {
            foreach _, e in<vector> jg.errors {
                show("error: ", e);
            }
            return 1;
        }
        if output_type == "" && !jg.has_entry {
            show("error: no entry point: '", input_file, "' defines no 'main' function (build a library with to-dynamic/to-static, or add 'fnc main')");
            return 1;
        }
        bytes: vec<int>;
        bytes = cls.write_to();
        exec("mkdir -p " + dir, nil);
        f: File = File.open(class_path, "w");
        if f == null {
            show("error: cannot write to '", class_path, "'");
            return 1;
        }
        f.writebytes(bytes);
        f.close();
        // One class file per struct/class (same directory).
        foreach _, kc in<vector> jg.klasses {
            kb: vec<int> = kc.write_to();
            kp: string = dir + "/" + kc.name + ".class";
            kf: File = File.open(kp, "w");
            if kf == null {
                show("error: cannot write to '", kp, "'");
                return 1;
            }
            kf.writebytes(kb);
            kf.close();
        }
        // Bundled-shim natives (http/httpserver on the JVM): copy the
        // whole shim runtime (client, server, handler interface) next
        // to the output so `java -cp <dir>` resolves everything.
        if jg.used_shims.size > 0 {
            jvm_rt: string = this.find_jvm_runtime_dir();
            if jvm_rt.size == 0 {
                show("error: cannot find the Leash JVM runtime (leash/jvm/)");
                show("       run from the repository root, or install the leash package");
                return 1;
            }
            if this.exec_code("cp " + jvm_rt + "/*.class " + dir + "/") != "0" {
                show("error: cannot copy the JVM runtime shims into '" + dir + "'");
                return 1;
            }
        }
        if !run_mode {
            show("[leash] Compiled ", input_file, " -> ", class_path);
        }
        if run_mode {
            if this.exec_out("command -v java").size == 0 {
                show("error: 'java' not found on PATH (needed to run --target jvm programs)");
                return 1;
            }
            absdir: string = this.realpath_str(dir);
            if absdir.size == 0 { absdir = dir; }
            run_cmd: string = "java -cp " + absdir + " " + cls_name;
            if run_args.size > 0 {
                run_cmd = run_cmd + " " + run_args;
            }
            show("--- Executed at ", this.exec_out("date '+%Y-%m-%d %H:%M:%S'"), " ---");
            rc_out: string = exec(run_cmd, "run");
            rv: int = 0;
            ri2: int = 0;
            rneg: bool = false;
            if rc_out.size > 0 && rc_out[0] == '-' {
                rneg = true;
                ri2 = 1;
            }
            while ri2 < rc_out.size && rc_out[ri2] >= '0' && rc_out[ri2] <= '9' {
                rv = rv * 10 + (rc_out[ri2] - '0');
                ri2 = ri2 + 1;
            }
            if rneg { rv = 0 - rv; }
            return rv;
        }
        return 0;
    }

    // Locate the JVM shim runtime directory (leash/jvm/*.class),
    // mirroring the gc.c discovery: cwd first, then LEASH_RUNTIME,
    // then argv[0]-relative (dev: <repo>/bin/leashc -> <repo>/leash/jvm).
    pub fnc find_jvm_runtime_dir() : string {
        if this.file_exists("leash/jvm/LeashHttp.class") {
            return "leash/jvm";
        }
        rt_env: string = this.exec_out("printenv LEASH_RUNTIME");
        if rt_env.size > 0 && this.file_exists(rt_env + "/jvm/LeashHttp.class") {
            return rt_env + "/jvm";
        }
        if this.self_path.size > 0 {
            sp: string = this.self_path;
            sp_has_slash: bool = false;
            spi: int = 0;
            while spi < sp.size {
                if sp[spi] == '/' { sp_has_slash = true; }
                spi = spi + 1;
            }
            if !sp_has_slash { sp = this.exec_out("command -v " + sp); }
            if sp.size > 0 {
                abs_exe: string = this.exec_out("readlink -f " + sp);
                slash: int = -1;
                si: int = 0;
                while si < abs_exe.size {
                    if abs_exe[si] == '/' { slash = si; }
                    si = si + 1;
                }
                if slash > 0 {
                    exe_dir: string = "";
                    si = 0;
                    while si < slash {
                        exe_dir = exe_dir + abs_exe[si];
                        si = si + 1;
                    }
                    cand1: string = exe_dir + "/../leash/jvm";
                    cand2: string = exe_dir + "/../jvm";
                    cand3: string = exe_dir + "/jvm";
                    if this.file_exists(cand1 + "/LeashHttp.class") { return cand1; }
                    also this.file_exists(cand2 + "/LeashHttp.class") { return cand2; }
                    also this.file_exists(cand3 + "/LeashHttp.class") { return cand3; }
                }
            }
        }
        return "";
    }

    // Sanitize an output basename into a valid Java class name.
    pub fnc jvm_class_name(base string) : string {
        if base.size > 6 && base[base.size - 6] == '.' && base[base.size - 5] == 'c' && base[base.size - 4] == 'l' && base[base.size - 3] == 'a' && base[base.size - 2] == 's' && base[base.size - 1] == 's' {
            trimmed: string = "";
            ti: int = 0;
            while ti < base.size - 6 {
                trimmed = trimmed + base[ti];
                ti = ti + 1;
            }
            base = trimmed;
        }
        out: string = "";
        i: int = 0;
        while i < base.size {
            c: char = base[i];
            ok: bool = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_' || c == '$';
            if i > 0 && c >= '0' && c <= '9' { ok = true; }
            if ok {
                out = out + c;
            } else {
                out = out + "_";
            }
            i = i + 1;
        }
        if out.size > 0 && out[0] >= '0' && out[0] <= '9' {
            out = "_" + out;
        }
        return out;
    }
}
