use tokens::*;
use ast::*;

pub def StructInfo : class {
    pub name: string;
    pub field_names: vec<string>;
    pub field_types: vec<string>;
    pub field_defaults: vec<bool>;   // field has a declared default value

    static pub fnc make(name string) : StructInfo {
        return StructInfo { name: name };
    }

    pub fnc add_field(fname string, ftype string, has_default bool) : void {
        this.field_names.pushb(fname);
        this.field_types.pushb(ftype);
        this.field_defaults.pushb(has_default);
    }

    pub fnc get_field_type(fname string) : string {
        foreach i, n in<vector> this.field_names {
            if n == fname {
                return this.field_types.get(i);
            }
        }
        return "";
    }
}

pub def ClassInfo : class {
    pub name: string;
    pub parent: string;
    pub field_names: vec<string>;
    pub field_types: vec<string>;
    pub method_names: vec<string>;
    pub method_rets: vec<string>;
    pub method_statics: vec<bool>;
    pub method_params: hash<string, vec<string>>;   // method name -> param types
    pub method_order: vec<string>;   // virtual slot order: parent slots + own new

    static pub fnc make(name string, parent string) : ClassInfo {
        return ClassInfo { name: name, parent: parent };
    }

    pub fnc add_field(fname string, ftype string) : void {
        this.field_names.pushb(fname);
        this.field_types.pushb(ftype);
    }

    pub fnc add_method(mname string, ret string, is_static bool, params vec<string>) : void {
        this.method_names.pushb(mname);
        this.method_rets.pushb(ret);
        this.method_statics.pushb(is_static);
        this.method_params.push(mname, params);
    }

    pub fnc get_method_params(mname string) : vec<string> {
        if this.method_params.isin(mname) {
            return this.method_params[mname];
        }
        empty_ps: vec<string>;
        return empty_ps;
    }

    pub fnc is_method_static(mname string) : bool {
        foreach i, n in<vector> this.method_names {
            if n == mname {
                return this.method_statics.get(i);
            }
        }
        return false;
    }

    pub fnc has_method(mname string) : bool {
        foreach _, n in<vector> this.method_names {
            if n == mname {
                return true;
            }
        }
        return false;
    }

    pub fnc get_field_type(fname string) : string {
        foreach i, n in<vector> this.field_names {
            if n == fname {
                return this.field_types.get(i);
            }
        }
        return "";
    }

    pub fnc get_method_ret(mname string) : string {
        foreach i, n in<vector> this.method_names {
            if n == mname {
                return this.method_rets.get(i);
            }
        }
        return "";
    }
}

pub def TypeChecker : class {
    pub funcs: hash<string, string>;            // name -> return type
    pub func_params: hash<string, vec<string>>; // name -> param types (for ref-arg passing)
    pub func_param_names: hash<string, vec<string>>; // name -> param names
    pub func_defaults: hash<string, Expr>;          // "name::i" -> default expr
    pub globals: hash<string, string>;          // name -> type
    pub shared_globals: hash<string, bool>;     // `shared` globals (one writer)
    pub shared_writers: hash<string, string>;   // shared name -> writing func
    pub current_func_name: string;              // body being checked ("<global>")
    pub structs: hash<string, StructInfo>;      // name -> struct info
    pub classes: hash<string, ClassInfo>;      // name -> class info
    pub enums: hash<string, bool>;              // name -> true
    pub scopes: vec<hash<string, string>>;      // local variable scopes
    pub errors: vec<string>;
    pub current_func_ret: string;
    pub works_error: string;                   // captured works-block error message
    pub in_works: bool;                        // inside a works block
    pub ctor_defaults: hash<string, vec<Expr>>; // class -> ctor param default exprs
    pub static_fields: hash<string, string>;    // "Class_field" -> type
    pub enum_consts: hash<string, int>;         // "Enum::VARIANT" -> value
    pub enum_str_consts: hash<string, string>;  // "Enum::VARIANT" -> string value
    pub enum_member_types: hash<string, string>;// "Enum::VARIANT" -> declared type
    pub enum_names: hash<string, vec<string>>; // "Enum" -> ordered variant names
    pub enum_counts: hash<string, int>;         // "Enum" -> variant count
    pub unions: hash<string, bool>;             // "UnionName" -> true
    pub union_names: hash<string, vec<string>>; // "UnionName" -> ordered variant names
    pub union_types: hash<string, vec<string>>; // "UnionName" -> variant types
    pub class_tparams: hash<string, vec<string>>; // class -> declared type params
    pub template_types: hash<string, bool>;      // `def T : template` names
    pub class_decls: vec<ClassDecl>;             // every class decl (name lookup)
    pub generic_classes: hash<string, bool>;      // class<T> template names
    pub inst_classes: hash<string, bool>;        // mangled class instantiation -> true
    pub inst_class_nodes: vec<ClassDecl>;        // instantiated class clones
    pub inst_tmaps: hash<string, vec<string>>;   // mangled -> [param names..., concrete types...]
    pub generic_funcs: hash<string, FuncDecl>;      // generic template name -> decl
    pub generic_tparams: hash<string, vec<string>>; // template name -> derived type params
    pub generic_ptypes: hash<string, vec<string>>;  // template name -> param types (substituted)
    pub generic_rtype: hash<string, string>;        // template name -> return type (substituted)
    pub inst_nodes: vec<FuncDecl>;                  // concrete instantiations
    pub inst_keys: hash<string, bool>;              // mangled name -> already built
    pub variadic_builtins: vec<string>;             // C builtins callable with extra args
    pub readonly_borrows: vec<string>;             // current function's read-only array params
    pub imut_vars: hash<string, bool>;             // current function's `imut` locals/params
    pub alias_map: hash<string, int>;              // var -> alias-group index (p := o)
    pub alias_groups: vec<vec<string>>;            // alias-group members
    pub deleted_vars: hash<string, bool>;          // names poisoned by `del`
    pub union_active: hash<string, string>;        // "var"|"var.field" -> active union variant (locals)
    pub union_active_ty: hash<string, string>;     // key -> union type
    pub global_union_active: hash<string, string>; // global union var -> active variant
    pub global_union_active_ty: hash<string, string>;
    pub prog_aliases: hash<string, string>;        // post-import type aliases (def X : type Y)
    pub fatal_idx: int;                            // raise-class error index (Python abort parity)
    pub worker_funcs: hash<string, bool>;          // `worker fnc` names
    pub async_funcs: hash<string, bool>;            // `async fnc` names
    pub in_unsafe_func: bool;                      // inside an `unsafe fnc` (pointer math gate)

    static pub fnc make() : TypeChecker {
        tc: TypeChecker = TypeChecker { current_func_ret: "void", works_error: "", fatal_idx: -1, current_func_name: "<global>", in_unsafe_func: false };
        empty_shared: hash<string, bool>;
        tc.shared_globals = empty_shared;
        empty_writers: hash<string, string>;
        tc.shared_writers = empty_writers;
        tc.init_builtins();
        return tc;
    }

    // Register one C stub signature (Python _register_c_stubs parity).
    // packed is "type name;type name;..." (empty for no params).
    pub fnc seed_stub(name string, ret string, packed string) : void {
        this.funcs.push(name, ret);
        ps: vec<string>;
        ns: vec<string>;
        if packed.size > 0 {
            cur: string = "";
            pi: int = 0;
            while pi <= packed.size {
                at_end: bool = pi == packed.size;
                c: char = ';';
                if !at_end { c = packed[pi]; }
                if at_end || c == ';' {
                    sp: int = 0;
                    while sp < cur.size && cur[sp] != ' ' { sp = sp + 1; }
                    if sp > 0 && sp + 1 <= cur.size - 1 {
                        ps.pushb(this.str_slice(cur, 0, sp));
                        ns.pushb(this.str_slice(cur, sp + 1, cur.size));
                    }
                    cur = "";
                } else {
                    cur = cur + c;
                }
                pi = pi + 1;
            }
        }
        this.func_params.push(name, ps);
        this.func_param_names.push(name, ns);
    }

    pub fnc init_builtins() : void {
        // Standard C and Leash runtime built-ins
        this.funcs.push("show", "void");
        this.funcs.push("showb", "void");
        // Special-cased builtins (special_builtin_call) also need their
        // return types in the funcs table: codegen's get_expr_type reads
        // them when typing enclosing expressions. The typechecker itself
        // resolves these names through special_builtin_call first.
        this.funcs.push("exec", "string");
        this.funcs.push("cstr", "char[]");
        this.funcs.push("lstr", "string");
        this.funcs.push("tostring", "string");
        this.funcs.push("rand", "int");
        this.funcs.push("randf", "float");
        this.funcs.push("seed", "void");
        this.funcs.push("choose", "string");
        this.funcs.push("wait", "void");
        this.funcs.push("timepass", "float");
        this.funcs.push("keyget", "char");
        this.funcs.push("get", "string");
        this.funcs.push("normescape", "string");
        this.funcs.push("exit", "void");
        this.funcs.push("gc_collect", "void");
        this.funcs.push("gc_stats", "void");
        this.variadic_builtins.pushb("printf");
        this.variadic_builtins.pushb("sprintf");
        this.variadic_builtins.pushb("snprintf");
        this.variadic_builtins.pushb("fprintf");
        this.variadic_builtins.pushb("scanf");
        this.variadic_builtins.pushb("fscanf");
        this.variadic_builtins.pushb("sscanf");

        // C library stubs (Python _register_c_stubs parity)
        this.seed_stub("abort", "void", "");
        this.seed_stub("abs", "int", "int x");
        this.seed_stub("acos", "float", "float x");
        this.seed_stub("asctime", "*char", "*char tm");
        this.seed_stub("asin", "float", "float x");
        this.seed_stub("atan", "float", "float x");
        this.seed_stub("atan2", "float", "float y;float x");
        this.seed_stub("atexit", "int", "*char func");
        this.seed_stub("atoi", "int", "*char str");
        this.seed_stub("atol", "int", "*char str");
        this.seed_stub("atoll", "int", "*char str");
        this.seed_stub("bsearch", "*char", "*char key;*char base;int nmemb;int size;*char compar");
        this.seed_stub("calloc", "*char", "int nmemb;int size");
        this.seed_stub("cbrt", "float", "float x");
        this.seed_stub("ceil", "float", "float x");
        this.seed_stub("clock", "int", "");
        this.seed_stub("cos", "float", "float x");
        this.seed_stub("cosh", "float", "float x");
        this.seed_stub("ctime", "*char", "*char timer");
