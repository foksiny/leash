    pub fnc enter_scope() : void {
        s: hash<string, string>;
        this.scopes.pushb(s);
    }

    pub fnc exit_scope() : void {
        if this.scopes.size > 0 {
            this.scopes.popb();
        }
    }

    pub fnc define_var(name string, typ string) : void {
        if this.scopes.size > 0 {
            top_idx: int = this.scopes.size - 1;
            s: hash<string, string> = this.scopes.get(top_idx);
            s.push(name, typ);
            this.scopes.set(top_idx, s);
        } else {
            this.globals.push(name, typ);
        }
    }

    pub fnc lookup_var(name string) : string {
        // Search local scopes from innermost to outermost
        i: int = this.scopes.size - 1;
        while i >= 0 {
            s: hash<string, string> = this.scopes.get(i);
            if s.isin(name) {
                return s[name];
            }
            i = i - 1;
        }

        // Search globals
        if this.globals.isin(name) {
            return this.globals[name];
        }

        return "";
    }

    // True when name is declared in one of the local (call-frame) scopes.
    // Globals and class statics do not live on the frame, so borrowing
    // from them does not dangle.
    pub fnc is_local_var(name string) : bool {
        i: int = 0;
        while i < this.scopes.size {
            s: hash<string, string> = this.scopes.get(i);
            if s.isin(name) { return true; }
            i = i + 1;
        }
        return false;
    }

    // The identifier at the root of an access chain: (&v).m[0] -> "v".
    // Returns "" when the chain is not rooted at a plain identifier.
    pub fnc root_identifier(e Expr) : string {
        while e != null && (e.kind == ExprKind.MEMBER || e.kind == ExprKind.INDEX || e.kind == ExprKind.POINTER_MEMBER) {
            e = e.left;
        }
        if e != null && e.kind == ExprKind.IDENT { return e.sval; }
        return "";
    }

    // If expr contains an address-of rooted at a local variable — a value
    // living in the current call frame — return that variable's name; else "".
    // Mirrors Python's _frame_escape_in (LEASH-E010 dangling-return check).
    pub fnc frame_escape_in(e Expr) : string {
        if e == null { return ""; }
        if e.kind == ExprKind.UNARY && e.op == "&" {
            root: string = this.root_identifier(e.left);
            if root.size > 0 && this.is_local_var(root) { return root; }
            return "";
        }
        if e.kind == ExprKind.TERNARY {
            a: string = this.frame_escape_in(e.left);
            if a.size > 0 { return a; }
            return this.frame_escape_in(e.right);
        }
        if e.kind == ExprKind.BINOP {
            a: string = this.frame_escape_in(e.left);
            if a.size > 0 { return a; }
            return this.frame_escape_in(e.right);
        }
        // Multi-value return: return e1, e2, ...; (parser wraps in a tuple)
        if e.kind == ExprKind.ARRAY_LIT && e.sval == "__tuple__" {
            foreach _, v in<vector> e.args {
                a: string = this.frame_escape_in(v);
                if a.size > 0 { return a; }
            }
        }
        return "";
    }

    // ---- Python-parity call-site diagnostics -------------------------------

    pub fnc is_variadic_builtin(name string) : bool {
        foreach _, v in<vector> this.variadic_builtins {
            if v == name { return true; }
        }
        return false;
    }

    pub fnc is_numeric_type(t string) : bool {
        return this.is_int_family(t) || this.is_float_family(t);
    }

    pub fnc char_digit(c char) : int {
        if c == '0' { return 0; }
        if c == '1' { return 1; }
        if c == '2' { return 2; }
        if c == '3' { return 3; }
        if c == '4' { return 4; }
        if c == '5' { return 5; }
        if c == '6' { return 6; }
        if c == '7' { return 7; }
        if c == '8' { return 8; }
        if c == '9' { return 9; }
        return -1;
    }

    pub fnc parse_small_int(s string) : int {
        out: int = 0;
        pi: int = 0;
        while pi < s.size {
            d: int = this.char_digit(s[pi]);
            if d < 0 { return -1; }
            out = out * 10 + d;
            pi = pi + 1;
        }
        if s.size == 0 { return -1; }
        return out;
    }

    // LEASH-E015 parity: reject integer literals outside the target type's
    // sign/width. The range math runs in int<64> so the bounds themselves
    // never wrap (a bare `int` wraps at 32 bits in some builds). Widths
    // where a bound would overflow int<64> (>= 63) are skipped.
    pub fnc check_int_literal_fits(e Expr, tt string) : void {
        if e == null || tt.size == 0 { return; }
        neg: bool = false;
        v: Expr = e;
        while v != null && v.kind == ExprKind.UNARY && (v.op == "-" || v.op == "+") {
            if v.op == "-" { neg = !neg; }
            v = v.left;
        }
        if v == null || v.kind != ExprKind.INT { return; }
        val: int<64> = v.ival;
        if neg { val = 0 - val; }
        t: string = this.strip_imut(tt);
        bits: int<64> = -1;
        signed: bool = true;
        if t == "int" {
            bits = 32;
        } also t == "uint" {
            bits = 32;
            signed = false;
        } also t.size > 5 && t[0] == 'i' && t[1] == 'n' && t[2] == 't' && t[3] == '<' && t[t.size - 1] == '>' {
            bits = this.parse_small_int(this.str_slice(t, 4, t.size - 1));
        } also t.size > 6 && t[0] == 'u' && t[1] == 'i' && t[2] == 'n' && t[3] == 't' && t[4] == '<' && t[t.size - 1] == '>' {
            bits = this.parse_small_int(this.str_slice(t, 5, t.size - 1));
            signed = false;
        } else {
            return;
        }
        if bits <= 0 || bits > 62 { return; }
        limit: int<64> = 1;
        bi: int<64> = 0;
        while bi < bits - 1 {
            limit = limit * 2;
            bi = bi + 1;
        }
        lo: int<64> = 0;
        hi: int<64> = 0;
        if signed {
            lo = 0 - limit;
            hi = limit - 1;
        } else {
            hi = limit * 2 - 1;
        }
        if val < lo || val > hi {
            this.errors.pushb("Number literal '" + tostring(val) + "' is out of range for type '" + t + "' (allowed: " + tostring(lo) + " to " + tostring(hi) + ").");
        }
    }

    pub fnc str_less(a string, b string) : bool {
        i: int = 0;
        while i < a.size && i < b.size {
            if a[i] < b[i] { return true; }
            if a[i] > b[i] { return false; }
            i = i + 1;
        }
        return a.size < b.size;
    }

    pub fnc sort_strs(v vec<string>) : void {
        i: int = 1;
        while i < v.size {
            tmp: string = v.get(i);
            j: int = i - 1;
            while j >= 0 && this.str_less(tmp, v.get(j)) {
                v.set(j + 1, v.get(j));
                j = j - 1;
            }
            v.set(j + 1, tmp);
            i = i + 1;
        }
    }

    pub fnc sig_index_of(names vec<string>, name string) : int {
        foreach i, n in<vector> names {
            if n == name { return i; }
        }
        return -1;
    }

    pub fnc is_readonly_borrow(name string) : bool {
        foreach _, r in<vector> this.readonly_borrows {
            if r == name { return true; }
        }
        return false;
    }

    // Argument-type compatibility for call sites. `&T` parameters accept an
    // explicit borrow (&T), a raw pointer (*T) or the bare value (the
    // compiler auto-addresses at the call site) — Python _types_compatible
    // grants the same leniency.
    pub fnc ref_arg_compatible(at string, expected string) : bool {
        if expected.size > 0 && expected[0] == '&' {
            inner: string = this.str_slice(expected, 1, expected.size);
            if at.size > 0 && at[0] == '&' {
                return this.types_compatible(this.str_slice(at, 1, at.size), inner);
            }
            if at == "*" + inner { return true; }
            return this.types_compatible(at, inner);
        }
        return this.types_compatible(at, expected);
    }

    // Display form of a type for diagnostics: Python prints fnc types
    // with " : " before the return type ("fnc() : void").
    pub fnc disp_type(t string) : string {
        if t.size > 4 && t[0] == 'f' && t[1] == 'n' && t[2] == 'c' && t[3] == '(' {
            ci: int = 4;
            depth: int = 0;
            while ci < t.size {
                c: char = t[ci];
                if c == '(' { depth = depth + 1; }
                if c == ')' {
                    if depth == 0 {
                        if ci + 1 < t.size && t[ci + 1] == ':' {
                            ri: int = ci + 2;
                            while ri < t.size && (t[ri] == ' ' || t[ri] == '\t') { ri = ri + 1; }
                            return this.str_slice(t, 0, ci + 1) + " : " + this.str_slice(t, ri, t.size);
                        }
                        stop;
                    }
                    depth = depth - 1;
                }
                ci = ci + 1;
            }
        }
        return t;
    }

    // Full call-site check against a registered signature: kwargs,
    // positional arity, duplicates, missing required arguments and
    // per-argument type compatibility (Python _check_call parity).
    pub fnc check_call_args(fname string, e Expr) : void {
        if !this.func_params.isin(fname) { return; }
        params: vec<string> = this.func_params[fname];
        pnames: vec<string> = this.func_param_names[fname];

        // Named arguments parse as BINOP "=" IDENT value; split them out.
        pos_args: vec<Expr>;
        kw_names: vec<string>;
        kw_vals: vec<Expr>;
        foreach _, a in<vector> e.args {
            if a != null && a.kind == ExprKind.BINOP && a.op == "=" && a.left != null && a.left.kind == ExprKind.IDENT {
                kw_names.pushb(a.left.sval);
                kw_vals.pushb(a.right);
            } else {
                pos_args.pushb(a);
            }
        }

        // Unknown keyword arguments
        foreach _, kw in<vector> kw_names {
            if this.sig_index_of(pnames, kw) < 0 {
                this.errors.pushb("Unexpected keyword argument '" + kw + "' for function '" + fname + "'");
            }
        }

        // Too many positional arguments (variadic C builtins exempt)
        if pos_args.size > params.size && !this.is_variadic_builtin(fname) {
            this.errors.pushb("Function '" + fname + "' expects at most " + tostring(params.size) + " argument(s), but got " + tostring(pos_args.size) + " positional");
        }

        // A parameter filled positionally and also given as a kwarg
        dupes: vec<string>;
        foreach _, kw in<vector> kw_names {
            kidx: int = this.sig_index_of(pnames, kw);
            if kidx >= 0 && kidx < pos_args.size {
                seen: bool = false;
                foreach _, d in<vector> dupes {
                    if d == kw { seen = true; }
                }
                if !seen { dupes.pushb(kw); }
            }
        }
        if dupes.size > 0 {
            this.sort_strs(dupes);
            msg: string = "Function '" + fname + "' got multiple values for argument(s): ";
            di: int = 0;
            while di < dupes.size {
                if di > 0 { msg = msg + ", "; }
                msg = msg + "'" + dupes[di] + "'";
                di = di + 1;
            }
            this.errors.pushb(msg);
        }

        // Required arguments must be provided (positional, kwarg or default)
        pi: int = 0;
        while pi < pnames.size {
            if pi < pos_args.size { pi = pi + 1; continue; }
            if this.sig_index_of(kw_names, pnames[pi]) >= 0 { pi = pi + 1; continue; }
            if this.func_defaults.isin(fname + "::" + tostring(pi)) { pi = pi + 1; continue; }
            this.errors.pushb("Missing required argument '" + pnames[pi] + "' for function '" + fname + "'");
            pi = pi + 1;
        }

        // Positional argument types (zip: extra positionals unchecked here)
        ai2: int = 0;
        while ai2 < pos_args.size && ai2 < params.size {
            at: string = this.infer_expr(pos_args.get(ai2));
            if at.size > 0 && !this.ref_arg_compatible(this.strip_imut(at), this.strip_imut(params.get(ai2))) {
                this.errors.pushb("Argument " + tostring(ai2 + 1) + " of '" + fname + "' expects '" + this.strip_imut(params.get(ai2)) + "' but got '" + this.strip_imut(at) + "'.");
            }
            this.check_int_literal_fits(pos_args.get(ai2), params.get(ai2));
            // A read-only borrowed array handed to a mutable `&T` parameter
            pa: Expr = pos_args.get(ai2);
            pt_i: string = params.get(ai2);
            if pt_i.size > 0 && pt_i[0] == '&' && pa != null && pa.kind == ExprKind.IDENT
               && this.is_readonly_borrow(pa.sval) {
                this.errors.pushb("Argument " + tostring(ai2 + 1) + " of '" + fname + "' requires a mutable borrow ('&'), but '" + pa.sval + "' was borrowed read-only.");
            }
            ai2 = ai2 + 1;
        }

        // Keyword argument types
        ki2: int = 0;
        while ki2 < kw_names.size {
            kidx2: int = this.sig_index_of(pnames, kw_names[ki2]);
            if kidx2 >= 0 && kidx2 < params.size {
                kat: string = this.infer_expr(kw_vals.get(ki2));
                if kat.size > 0 && !this.ref_arg_compatible(this.strip_imut(kat), this.strip_imut(params.get(kidx2))) {
                    this.errors.pushb("Argument '" + kw_names[ki2] + "' of '" + fname + "' expects '" + this.strip_imut(params.get(kidx2)) + "' but got '" + this.strip_imut(kat) + "'.");
                }
                this.check_int_literal_fits(kw_vals[ki2], params[kidx2]);
            }
            ki2 = ki2 + 1;
        }
    }

    // Type of a vec<T> / matrix<T> element type.
    pub fnc vec_inner_of(t string) : string {
        if t.size > 8 && t[0] == 'm' && t[1] == 'a' && t[2] == 't' && t[3] == 'r'
           && t[4] == 'i' && t[5] == 'x' && t[6] == '<' {
            return this.str_slice(t, 7, t.size - 1);
        }
        if t.size > 5 && t[0] == 'v' && t[1] == 'e' && t[2] == 'c' && t[3] == '<' {
            return this.str_slice(t, 4, t.size - 1);
        }
        return "";
    }

    pub fnc is_array_type(t string) : bool {
        tt: string = this.strip_imut(t);
        if tt.size == 0 { return false; }
        if tt[tt.size - 1] != ']' { return false; }
        has_bracket: bool = false;
        ai: int = 0;
        while ai < tt.size {
            if tt[ai] == '[' { has_bracket = true; }
            ai = ai + 1;
        }
        return has_bracket;
    }

    // Key type of hash<K, V>.
    pub fnc hash_key_of(t string) : string {
        if t.size > 6 && t[0] == 'h' && t[1] == 'a' && t[2] == 's' && t[3] == 'h' && t[4] == '<' {
            depth: int = 0;
            i: int = 5;
            while i < t.size - 1 {
                c: char = t[i];
                if c == ',' && depth == 0 {
                    return this.trim_ty(this.str_slice(t, 5, i));
                }
                if c == '<' { depth = depth + 1; }
                if c == '>' { depth = depth - 1; }
                i = i + 1;
            }
        }
        return "";
    }

    // Value type of hash<K, V>.
    pub fnc hash_value_of(t string) : string {
        if t.size > 6 && t[0] == 'h' && t[1] == 'a' && t[2] == 's' && t[3] == 'h' && t[4] == '<' {
            depth: int = 0;
            i: int = 5;
            while i < t.size - 1 {
                c: char = t[i];
                if c == ',' && depth == 0 {
                    rest: string = this.trim_ty(this.str_slice(t, i + 1, t.size - 1));
                    return rest;
                }
                if c == '<' { depth = depth + 1; }
                if c == '>' { depth = depth - 1; }
                i = i + 1;
            }
        }
        return "";
    }

    // Special-cased builtin functions (Python _check_call prefix parity).
    // Returns the inferred type, or "" when the name is not one of these.
    pub fnc special_builtin_call(e Expr) : string {
        n: string = e.sval;
        if n == "show" { return "void"; }
        if n == "cstr" {
            if e.args.size != 1 {
                this.errors.pushb("Function 'cstr' expects 1 argument");
                return "char[]";
            }
            at: string = this.infer_expr(e.args.get(0));
            if at.size > 0 && at != "string" && at != "char[]" {
                this.errors.pushb("Argument 1 of 'cstr' must be 'string', got '" + at + "'");
            }
            return "char[]";
        }
        if n == "lstr" {
            if e.args.size != 1 {
                this.errors.pushb("Function 'lstr' expects 1 argument");
                return "string";
            }
            at: string = this.infer_expr(e.args.get(0));
            if at.size > 0 && at != "char[]" && at != "string" {
                this.errors.pushb("Argument 1 of 'lstr' must be 'char[]', got '" + at + "'");
            }
            return "string";
        }
        if n == "get" {
            if e.args.size > 1 {
                this.errors.pushb("Function 'get' expects 0 or 1 argument(s), but got " + tostring(e.args.size));
            }
            if e.args.size == 1 {
                at: string = this.infer_expr(e.args.get(0));
                if at.size > 0 && at != "string" {
                    this.errors.pushb("Argument 1 of 'get' must be 'string', got '" + at + "'");
                }
            }
            return "string";
        }
        if n == "tostring" {
            if e.args.size != 1 {
                this.errors.pushb("Function 'tostring' expects 1 argument, but got " + tostring(e.args.size));
                return "string";
            }
            return "string";
        }
        // Typed conversions: toint(int<64>, x) / tofloat(double, x) — the
        // first argument is a type name (python's TypeConvExpr).
        if (n == "toint" || n == "tofloat") && e.args.size == 2 && e.args.get(0).kind == ExprKind.STRING {
            return this.resolve_type_alias(e.args.get(0).sval);
        }
        if n == "rand" {
            if e.args.size != 2 {
                this.errors.pushb("Function 'rand' expects 2 arguments (min, max), but got " + tostring(e.args.size));
                return "int";
            }
            at1: string = this.infer_expr(e.args.get(0));
            at2: string = this.infer_expr(e.args.get(1));
            if at1.size > 0 && !this.is_int_family(at1) {
                this.errors.pushb("Argument 1 of 'rand' must be an integer type, got '" + at1 + "'");
            }
            if at2.size > 0 && !this.is_int_family(at2) {
                this.errors.pushb("Argument 2 of 'rand' must be an integer type, got '" + at2 + "'");
            }
            return "int";
        }
        if n == "randf" {
            if e.args.size != 2 {
                this.errors.pushb("Function 'randf' expects 2 arguments (min, max), but got " + tostring(e.args.size));
                return "float";
            }
            at1: string = this.infer_expr(e.args.get(0));
            at2: string = this.infer_expr(e.args.get(1));
            if at1.size > 0 && !this.is_numeric_type(at1) {
                this.errors.pushb("Argument 1 of 'randf' must be a numeric type, got '" + at1 + "'");
            }
            if at2.size > 0 && !this.is_numeric_type(at2) {
                this.errors.pushb("Argument 2 of 'randf' must be a numeric type, got '" + at2 + "'");
            }
            return "float";
        }
        if n == "seed" {
            if e.args.size != 1 {
                this.errors.pushb("Function 'seed' expects 1 argument, but got " + tostring(e.args.size));
                return "void";
            }
            at: string = this.infer_expr(e.args.get(0));
            if at.size > 0 && !this.is_int_family(at) {
                this.errors.pushb("Argument 1 of 'seed' must be an integer type, got '" + at + "'");
            }
            return "void";
        }
        if n == "choose" {
            if e.args.size < 2 {
                this.errors.pushb("Function 'choose' expects at least 2 arguments, but got " + tostring(e.args.size));
            }
            foreach ai, arg in<vector> e.args {
                at: string = this.infer_expr(arg);
                if at.size > 0 && at != "string" {
                    this.errors.pushb("Argument " + tostring(ai + 1) + " of 'choose' must be 'string', got '" + at + "'");
                }
            }
            return "string";
        }
        if n == "wait" {
            if e.args.size != 1 {
                this.errors.pushb("Function 'wait' expects 1 argument (seconds), but got " + tostring(e.args.size));
                return "void";
            }
            at: string = this.infer_expr(e.args.get(0));
            if at.size > 0 && !this.is_numeric_type(at) {
                this.errors.pushb("Argument 1 of 'wait' must be a numeric type, got '" + at + "'");
            }
            return "void";
        }
        if n == "exec" {
            if e.args.size < 1 || e.args.size > 2 {
                this.errors.pushb("Function 'exec' expects 1 or 2 arguments (command, mode), but got " + tostring(e.args.size));
                return "string";
            }
            at1: string = this.infer_expr(e.args.get(0));
            if at1.size > 0 && at1 != "string" {
                this.errors.pushb("Argument 1 of 'exec' must be 'string', got '" + at1 + "'");
            }
            if e.args.size == 2 {
                at2: string = this.infer_expr(e.args.get(1));
                if at2.size > 0 && at2 != "string" && at2 != "nil" {
                    this.errors.pushb("Argument 2 of 'exec' must be 'string' or 'nil', got '" + at2 + "'");
                }
            }
            return "string";
        }
        if n == "timepass" {
            if e.args.size != 0 {
                this.errors.pushb("Function 'timepass' expects 0 arguments, but got " + tostring(e.args.size));
            }
            return "float";
        }
        if n == "keyget" {
            if e.args.size != 0 {
                this.errors.pushb("Function 'keyget' expects 0 arguments, but got " + tostring(e.args.size));
            }
            return "char";
        }
        if n == "exit" {
            if e.args.size != 1 {
                this.errors.pushb("Function 'exit' expects 1 argument (exit code), but got " + tostring(e.args.size));
                return "void";
            }
            at: string = this.infer_expr(e.args.get(0));
            if at.size > 0 && !this.is_int_family(at) {
                this.errors.pushb("Argument 1 of 'exit' must be an integer type, got '" + at + "'");
            }
            return "void";
        }
        if n == "gc_collect" || n == "gc_stats" {
            if e.args.size != 0 {
                this.errors.pushb("Function '" + n + "' expects 0 arguments, but got " + tostring(e.args.size));
            }
            return "void";
        }
        if n == "normescape" {
            if e.args.size != 1 {
                this.errors.pushb("Function 'normescape' expects 1 argument, but got " + tostring(e.args.size));
                return "string";
            }
            at: string = this.infer_expr(e.args.get(0));
            if at.size > 0 && at != "string" {
                this.errors.pushb("Argument 1 of 'normescape' must be 'string', got '" + at + "'");
            }
            return "string";
        }
        return "";
    }

    // Arity + argument types for the builtin File class methods
    // (Python checks them like user class methods).
    pub fnc file_method_arity(m string) : int {
        if m == "open" { return 2; }
        if m == "rename" { return 2; }
        if m == "delete" { return 1; }
        if m == "write" { return 1; }
        if m == "writeb" { return 1; }
        if m == "writebytes" { return 1; }
        if m == "replace" { return 2; }
        if m == "replaceall" { return 2; }
        return 0;
    }

    pub fnc file_method_param(m string, i int) : string {
        if m == "open" {
            if i == 0 { return "string"; }
            return "string";
        }
        if m == "rename" { return "string"; }
        if m == "delete" { return "string"; }
        if m == "write" { return "string"; }
        if m == "writeb" { return "char[]"; }
        if m == "writebytes" { return "vec<int>"; }
        if m == "replace" { return "string"; }
        if m == "replaceall" { return "string"; }
        return "";
    }

    pub fnc file_is_static_method(m string) : bool {
        return m == "open" || m == "rename" || m == "delete";
    }

    pub fnc check_file_method(e Expr) : void {
        want: int = this.file_method_arity(e.sval);
        if e.args.size != want {
            this.errors.pushb("Method '" + e.sval + "' of class 'File' expects " + tostring(want) + " arguments, but got " + tostring(e.args.size));
            this.fatal_idx = this.errors.size - 1;
            return;
        }
        ai: int = 0;
        while ai < e.args.size {
            pt: string = this.file_method_param(e.sval, ai);
            at: string = this.infer_expr(e.args.get(ai));
            if pt.size > 0 && at.size > 0 && !this.types_compatible(this.strip_imut(at), pt) {
                this.errors.pushb("Argument " + tostring(ai + 1) + " of method '" + e.sval + "' expects '" + pt + "' but got '" + this.strip_imut(at) + "'");
            }
            ai = ai + 1;
        }
    }

    // Container built-in method checks (vec / matrix / string / hash / array).
    // Returns the inferred type, or "" when the receiver is not one of these
    // (falling through to class / struct / opdef dispatch).
    pub fnc container_method_check(e Expr, obj_t string) : string {
        bare: string = this.strip_imut(obj_t);
        base: string = this.base_of(bare);

        if base == "vec" {
            inner: string = this.vec_inner_of(bare);
            m: string = e.sval;
            if m == "pushb" || m == "pushf" {
                if e.args.size != 1 {
                    this.errors.pushb("Vector method '" + m + "' expects 1 argument, got " + tostring(e.args.size));
                } else {
                    at: string = this.infer_expr(e.args.get(0));
                    if at.size > 0 && !this.types_compatible(at, inner) {
                        this.errors.pushb("Vector method '" + m + "' expects argument of type '" + inner + "' but got '" + at + "'");
                    }
                }
                return "void";
            }
            if m == "insert" {
                if e.args.size != 2 {
                    this.errors.pushb("Vector method '" + m + "' expects 2 arguments, got " + tostring(e.args.size));
                }
                return "void";
            }
            if m == "popb" || m == "popf" {
                if e.args.size != 0 {
                    this.errors.pushb("Vector method '" + m + "' expects 0 arguments, got " + tostring(e.args.size));
                }
                return inner;
            }
            if m == "size" {
                if e.args.size != 0 {
                    this.errors.pushb("Vector method '" + m + "' expects 0 arguments, got " + tostring(e.args.size));
                }
                return "int";
            }
            if m == "get" {
                if e.args.size != 1 {
                    this.errors.pushb("Vector method '" + m + "' expects 1 argument, got " + tostring(e.args.size));
                }
                return inner;
            }
            if m == "set" {
                if e.args.size != 2 {
                    this.errors.pushb("Vector method '" + m + "' expects 2 arguments, got " + tostring(e.args.size));
                } else {
                    vt: string = this.infer_expr(e.args.get(1));
                    if vt.size > 0 && !this.types_compatible(vt, inner) {
                        this.errors.pushb("Vector method '" + m + "' expects second argument of type '" + inner + "' but got '" + vt + "'");
                    }
                }
                return "void";
            }
            if m == "clear" {
                if e.args.size != 0 {
                    this.errors.pushb("Vector method '" + m + "' expects 0 arguments, got " + tostring(e.args.size));
                }
                return "void";
            }
            if m == "remove" {
                if e.args.size != 1 {
                    this.errors.pushb("Vector method '" + m + "' expects 1 argument, got " + tostring(e.args.size));
                }
                return "void";
            }
            if m == "isin" {
                if e.args.size != 1 {
                    this.errors.pushb("Vector method '" + m + "' expects 1 argument, got " + tostring(e.args.size));
                }
                return "bool";
            }
            if m == "extend" {
                if e.args.size != 1 {
                    this.errors.pushb("Vector method '" + m + "' expects 1 argument, got " + tostring(e.args.size));
                } else {
                    at: string = this.infer_expr(e.args.get(0));
                    if at.size > 0 && !this.types_compatible(at, inner + "[]") && !this.types_compatible(at, "*" + inner) {
                        this.errors.pushb("Vector method '" + m + "' expects argument of type '" + inner + "[]' or '*" + inner + "', but got '" + at + "'");
                    }
                }
                return "void";
            }
            if m == "extendv" {
                if e.args.size != 1 {
                    this.errors.pushb("Vector method '" + m + "' expects 1 argument, got " + tostring(e.args.size));
                } else {
                    at: string = this.infer_expr(e.args.get(0));
                    if at.size > 0 && !this.types_compatible(at, "vec<" + inner + ">") {
                        this.errors.pushb("Vector method '" + m + "' expects argument of type 'vec<" + inner + ">', but got '" + at + "'");
                    }
                }
                return "void";
            }
            if m == "insertv" {
                if e.args.size != 2 {
                    this.errors.pushb("Vector method '" + m + "' expects 2 arguments, got " + tostring(e.args.size));
                } else {
                    at: string = this.infer_expr(e.args.get(1));
                    if at.size > 0 && !this.types_compatible(at, "vec<" + inner + ">") {
                        this.errors.pushb("Vector method '" + m + "' expects argument of type 'vec<" + inner + ">', but got '" + at + "'");
                    }
                }
                return "void";
            }
            if m == "inserta" {
                if e.args.size != 2 {
                    this.errors.pushb("Vector method '" + m + "' expects 2 arguments, got " + tostring(e.args.size));
                }
                return "void";
            }
            this.errors.pushb("Vector has no method named '" + e.sval + "'");
            this.fatal_idx = this.errors.size - 1;
            return "void";
        }

        if base == "matrix" {
            inner: string = this.vec_inner_of(bare);
            m: string = e.sval;
            if m == "pushb" || m == "pushf" {
                if e.args.size == 1 {
                    at: string = this.infer_expr(e.args.get(0));
                    if at.size > 0 && !this.types_compatible(at, inner) {
                        this.errors.pushb("Matrix method '" + m + "' expects argument of type '" + inner + "' but got '" + at + "'");
                    }
                } else {
                    if e.args.size > 1 {
                        this.errors.pushb("Matrix method '" + m + "' expects 0 or 1 arguments, got " + tostring(e.args.size));
                    }
                }
                return "void";
            }
            if m == "insert" {
                if e.args.size != 1 && e.args.size != 2 {
                    this.errors.pushb("Matrix method '" + m + "' expects 1 or 2 arguments, got " + tostring(e.args.size));
                }
                return "void";
            }
            if m == "popb" || m == "popf" {
                if e.args.size != 0 && e.args.size != 1 {
                    this.errors.pushb("Matrix method '" + m + "' expects 0 or 1 arguments, got " + tostring(e.args.size));
                }
                return "void";
            }
            if m == "size" {
                if e.args.size != 0 {
                    this.errors.pushb("Matrix method '" + m + "' expects 0 arguments, got " + tostring(e.args.size));
                }
                return "int";
            }
            if m == "get" {
                if e.args.size < 1 {
                    this.errors.pushb("Matrix method '" + m + "' expects at least 1 argument, got " + tostring(e.args.size));
                } else {
                    foreach ai, arg in<vector> e.args {
                        at: string = this.infer_expr(arg);
                        if at.size > 0 && !this.types_compatible(at, "int") {
                            this.errors.pushb("Matrix method '" + m + "' expects argument " + tostring(ai + 1) + " of type 'int' (index) but got '" + at + "'");
                        }
                    }
                }
                return inner;
            }
            if m == "set" {
                if e.args.size < 2 {
                    this.errors.pushb("Matrix method '" + m + "' expects at least 2 arguments, got " + tostring(e.args.size));
                } else {
                    vt: string = this.infer_expr(e.args.get(e.args.size - 1));
                    if vt.size > 0 && !this.types_compatible(vt, inner) {
                        this.errors.pushb("Matrix method '" + m + "' expects last argument of type '" + inner + "' but got '" + vt + "'");
                    }
                }
                return "void";
            }
            if m == "clear" {
                if e.args.size != 0 {
                    this.errors.pushb("Matrix method '" + m + "' expects 0 arguments, got " + tostring(e.args.size));
                }
                return "void";
            }
            if m == "remove" {
                if e.args.size < 1 {
                    this.errors.pushb("Matrix method '" + m + "' expects at least 1 argument, got " + tostring(e.args.size));
                } else {
                    foreach ai, arg in<vector> e.args {
                        at: string = this.infer_expr(arg);
                        if at.size > 0 && !this.types_compatible(at, "int") {
                            this.errors.pushb("Matrix method '" + m + "' expects argument " + tostring(ai + 1) + " of type 'int' (index) but got '" + at + "'");
                        }
                    }
                }
                return "void";
            }
            if m == "isin" {
                if e.args.size != 1 {
                    this.errors.pushb("Matrix method '" + m + "' expects 1 argument, got " + tostring(e.args.size));
                } else {
                    at: string = this.infer_expr(e.args.get(0));
                    if at.size > 0 && !this.types_compatible(at, inner) {
                        this.errors.pushb("Matrix method '" + m + "' expects argument of type '" + inner + "' but got '" + at + "'");
                    }
                }
                return "bool";
            }
            if m == "shape" {
                if e.args.size != 0 {
                    this.errors.pushb("Matrix method '" + m + "' expects 0 arguments, got " + tostring(e.args.size));
                }
                return "vec<int>";
            }
            this.errors.pushb("Matrix has no method named '" + e.sval + "'");
            this.fatal_idx = this.errors.size - 1;
            return "void";
        }

        if this.is_array_type(bare) && e.sval == "size" {
            return "int";
        }

        if base == "string" {
            if e.sval == "size" { return "int"; }
            if e.sval == "replace" {
                if e.args.size != 2 {
                    this.errors.pushb(".replace() requires exactly 2 arguments (old, new)");
                    this.fatal_idx = this.errors.size - 1;
                    return "string";
                }
                a1: string = this.infer_expr(e.args.get(0));
                a2: string = this.infer_expr(e.args.get(1));
                if a1 != "string" || a2 != "string" {
                    this.errors.pushb(".replace() requires both arguments to be strings");
                    this.fatal_idx = this.errors.size - 1;
                }
                return "string";
            }
            return "";
        }

        if base == "hash" {
            key_t: string = this.hash_key_of(bare);
            val_t: string = this.hash_value_of(bare);
            m: string = e.sval;
            if m == "size" {
                if e.args.size != 0 {
                    this.errors.pushb("Hash method '" + m + "' expects 0 arguments, got " + tostring(e.args.size));
                }
                return "int";
            }
            if m == "keys" {
                if e.args.size != 0 {
                    this.errors.pushb("Hash method '" + m + "' expects 0 arguments, got " + tostring(e.args.size));
                }
                return "vec<" + key_t + ">";
            }
            if m == "values" {
                if e.args.size != 0 {
                    this.errors.pushb("Hash method '" + m + "' expects 0 arguments, got " + tostring(e.args.size));
                }
                return "vec<" + val_t + ">";
            }
            if m == "getKey" {
                if e.args.size != 1 {
                    this.errors.pushb("Hash method '" + m + "' expects 1 argument, got " + tostring(e.args.size));
                } else {
                    at: string = this.infer_expr(e.args.get(0));
                    if at.size > 0 && !this.types_compatible(at, val_t) {
                        this.errors.pushb("Hash method '" + m + "' expects argument of type '" + val_t + "' but got '" + at + "'");
                    }
                }
                return key_t;
            }
            if m == "isin" {
                if e.args.size != 1 {
                    this.errors.pushb("Hash method '" + m + "' expects 1 argument, got " + tostring(e.args.size));
                }
                return "bool";
            }
            if m == "delete" {
                if e.args.size != 1 {
                    this.errors.pushb("Hash method '" + m + "' expects 1 argument, got " + tostring(e.args.size));
                }
                return "void";
            }
            if m == "push" {
                if e.args.size != 2 {
                    this.errors.pushb("Hash method '" + m + "' expects 2 arguments, got " + tostring(e.args.size));
                } else {
                    at1: string = this.infer_expr(e.args.get(0));
                    if at1.size > 0 && !this.types_compatible(at1, key_t) {
                        this.errors.pushb("Hash method '" + m + "' expects first argument of type '" + key_t + "' but got '" + at1 + "'");
                    }
                    at2: string = this.infer_expr(e.args.get(1));
                    if at2.size > 0 && !this.types_compatible(at2, val_t) {
                        this.errors.pushb("Hash method '" + m + "' expects second argument of type '" + val_t + "' but got '" + at2 + "'");
                    }
                }
                return "void";
            }
            this.errors.pushb("Hash has no method named '" + e.sval + "'");
            this.fatal_idx = this.errors.size - 1;
            return "void";
        }

        return "";
    }

    pub fnc tuple_elem_type(tup string, idx int) : string {
        inner: string = "";
        ii: int = 1;
        while ii < tup.size - 1 {
            inner = inner + tup[ii];
            ii = ii + 1;
        }
        depth: int = 0;
        cur: string = "";
        ei: int = 0;
        pi: int = 0;
        while pi < inner.size {
            pch: char = inner[pi];
            if pch == '<' || pch == '(' { depth = depth + 1; }
            if pch == '>' || pch == ')' { depth = depth - 1; }
            if pch == ',' && depth == 0 {
                if ei == idx { return this.trim_type_str(cur); }
                cur = "";
                ei = ei + 1;
            } else {
                cur = cur + pch;
            }
            pi = pi + 1;
        }
        if ei == idx { return this.trim_type_str(cur); }
        return "int";
    }

    pub fnc trim_type_str(s string) : string {
        a: int = 0;
        b: int = s.size - 1;
        while a < s.size && s[a] == ' ' { a = a + 1; }
        while b >= a && s[b] == ' ' { b = b - 1; }
        out: string = "";
        while a <= b {
            out = out + s[a];
            a = a + 1;
        }
        return out;
    }

    pub fnc lookup_var_fresh(name string) : bool {
        i: int = this.scopes.size - 1;
        while i >= 0 {
            if this.scopes.get(i).isin(name) {
                return true;
            }
            i = i - 1;
        }
        return false;
    }

    pub fnc is_fnc_type(t string) : bool {
        return t.size > 4 && t[0] == 'f' && t[1] == 'n' && t[2] == 'c' && t[3] == '(';
    }

    pub fnc trim_ty(s string) : string {
        a: int = 0;
        b: int = s.size - 1;
        while a < s.size && (s[a] == ' ' || s[a] == '\t') { a = a + 1; }
        while b >= a && (s[b] == ' ' || s[b] == '\t') { b = b - 1; }
        out: string = "";
        while a <= b { out = out + s[a]; a = a + 1; }
        return out;
    }

    // "fnc(int, int): int" -> [ret, p1, p2, ...]
    pub fnc fnc_parts(t string) : vec<string> {
        res: vec<string>;
        depth: int = 0;
        pi: int = 4;
        close_i: int = -1;
        while pi < t.size {
            c: char = t[pi];
            if c == '(' { depth = depth + 1; }
            also c == ')' {
                if depth == 0 { close_i = pi; stop; }
                depth = depth - 1;
            }
            pi = pi + 1;
        }
        if close_i < 0 { res.pushb("int"); return res; }
        ret: string = "int";
        rp: int = close_i + 1;
        while rp < t.size && (t[rp] == ' ' || t[rp] == '\t') { rp = rp + 1; }
        if rp < t.size && t[rp] == ':' {
            ret = "";
            qi: int = rp + 1;
            while qi < t.size { ret = ret + t[qi]; qi = qi + 1; }
            ret = this.trim_ty(ret);
            if ret.size == 0 { ret = "int"; }
        }
        res.pushb(ret);
        if close_i > 4 {
            cur: string = "";
            pi = 4;
            while pi < close_i {
                c2: char = t[pi];
                if c2 == ',' { res.pushb(this.trim_ty(cur)); cur = ""; }
                else { cur = cur + c2; }
                pi = pi + 1;
            }
            res.pushb(this.trim_ty(cur));
        }
        return res;
    }

    pub fnc fn_type_str(name string) : string {
        out: string = "fnc(";
        has_p: bool = false;
        if this.func_params.isin(name) {
            ps: vec<string> = this.func_params[name];
            pi: int = 0;
            while pi < ps.size {
                if has_p { out = out + ", "; }
                out = out + ps.get(pi);
                has_p = true;
                pi = pi + 1;
            }
        }
        out = out + ") : ";
        if this.funcs.isin(name) { out = out + this.funcs[name]; }
        else { out = out + "int"; }
        return out;
    }

    pub fnc strip_ref(t string) : string {
        if t.size > 1 && t[0] == '&' {
            out: string = "";
            i: int = 1;
            while i < t.size {
                out = out + t[i];
                i = i + 1;
            }
            return out;
        }
        return t;
    }

    pub fnc is_union(t string) : bool {
        return this.unions.isin(t);
    }

    pub fnc union_variant_index(uname string, vname string) : int {
        if !this.union_names.isin(uname) { return -1; }
        names: vec<string> = this.union_names[uname];
        foreach i, n in<vector> names {
            if n == vname { return i; }
        }
        return -1;
    }

    pub fnc union_variant_type(uname string, idx int) : string {
        if !this.union_types.isin(uname) { return "int"; }
        types: vec<string> = this.union_types[uname];
        if idx < 0 || idx >= types.size { return "int"; }
        return types.get(idx);
    }

    pub fnc union_has_ptr_variant(uname string) : bool {
        if !this.union_types.isin(uname) { return false; }
        types: vec<string> = this.union_types[uname];
        foreach _, t in<vector> types {
            if t == "string" || t == "char[]" { return true; }
        }
        return false;
    }

    pub fnc union_has_float_variant(uname string) : bool {
        if !this.union_types.isin(uname) { return false; }
        types: vec<string> = this.union_types[uname];
        foreach _, t in<vector> types {
            if t == "float" { return true; }
        }
        return false;
    }

    // Infer type of an expression
    pub fnc strip_future(t string) : string {
        if t.size > 8 && t[0] == 'f' && t[1] == 'u' && t[2] == 't' && t[3] == 'u'
           && t[4] == 'r' && t[5] == 'e' && t[6] == '<' && t[t.size - 1] == '>' {
            out: string = "";
            i: int = 7;
            while i < t.size - 1 {
                out = out + t[i];
                i = i + 1;
            }
            return out;
        }
        return t;
    }

    pub fnc file_method_ret(m string) : string {
        if m == "open" { return "File"; }
        if m == "read" { return "string"; }
        if m == "write" { return "int"; }
        if m == "close" { return "int"; }
        if m == "writeb" { return "int"; }
        if m == "writebytes" { return "int"; }
        if m == "readb" { return "char[]"; }
        if m == "readln" { return "string"; }
        if m == "readlnb" { return "char[]"; }
        if m == "replace" { return "int"; }
        if m == "replaceall" { return "int"; }
        if m == "rewind" { return "void"; }
        return "int";
    }

    pub fnc infer_expr(e Expr) : string {
        if e == null { return "void"; }

        if e.kind == ExprKind.INT { return "int"; }
        if e.kind == ExprKind.FLOAT { return "float"; }
        if e.kind == ExprKind.STRING { return "string"; }
        if e.kind == ExprKind.CHAR { return "char"; }
        if e.kind == ExprKind.BOOL { return "bool"; }
        if e.kind == ExprKind.NIL { return "nil"; }

        if e.kind == ExprKind.IDENT {
            if this.in_works && this.works_error.size == 0 && !this.lookup_var_fresh(e.sval) && !this.funcs.isin(e.sval) && !this.enum_consts.isin(e.sval) && !this.globals.isin(e.sval) {
                this.works_error = "Undefined variable: '" + e.sval + "'";
            }
            if (e.sval == "self" || e.sval == "self::Class" || e.sval == "self::Parent") && !this.lookup_var_fresh("self") {
                return "string";
            }
            // Compile-time builtin variables (codegen get_expr_type parity):
            // unknown to the scopes but typed as strings
            if (e.sval == "_PLATFORM" || e.sval == "_FILEPATH" || e.sval == "_FILENAME") && !this.lookup_var_fresh(e.sval) {
                return "string";
            }
            if this.enum_str_consts.isin(e.sval) { return "string"; }
            if this.enum_member_types.isin(e.sval) { return this.enum_member_types[e.sval]; }
            if this.enum_consts.isin(e.sval) {
                prefix: string = "";
                pi: int = 0;
                while pi < e.sval.size {
                    if e.sval[pi] == ':' { return prefix; }
                    prefix = prefix + e.sval[pi];
                    pi = pi + 1;
                }
            }
            t: string = this.lookup_var(e.sval);
            if t.size > 0 {
                // Use-after-free (python parity): reading a name poisoned
                // by `del` — directly or through an alias — is an error.
                if this.alias_in(e.sval) {
                    this.errors.pushb("Use of deleted variable '" + e.sval + "': it was already destroyed with 'del'.");
                }
                return t;
            }
            if this.funcs.isin(e.sval) { return this.funcs[e.sval]; }
            // A bare type name used as a value (class/struct/union) has
            // that type — needed for `Animal.new(...)` receivers.
            if this.structs.isin(e.sval) || this.classes.isin(e.sval) || this.unions.isin(e.sval) {
                return e.sval;
            }
            // Python parity: referencing an undefined variable is an error,
            // not a silent int fallback (works blocks keep their own
            // runtime-error path). `_` is the wildcard/discard name.
            if !this.in_works && e.sval != "_" && e.sval != "this" {
                this.errors.pushb("Undefined variable: '" + e.sval + "'");
            }
            return "int"; // fallback
        }

        if e.kind == ExprKind.BINOP {
            // Named-call-argument marker: `name = value` inside call args is
            // encoded as a binop — the left ident is an argument NAME, not a
            // variable reference.
            if e.op == "=" && e.left != null && e.left.kind == ExprKind.IDENT {
                return this.infer_expr(e.right);
            }
            // Operand types are computed ONCE here: the opdef rewrite and
            // the promotion rules below both reuse them (inferring twice
            // would duplicate any diagnostics the inference reports).
            // `x is Type` / `x isnt Type` carry a type NAME on the right
            // — never inferred as a value expression.
            lt_full: string = this.infer_expr(e.left);
            rt_full: string = "";
            if e.op != "isT" && e.op != "isntT" {
                rt_full = this.infer_expr(e.right);
            }
            // opdef operator overload: rewrite into a call of the (possibly
            // generic) `_opdef_<base>_<op>` function with both operands.
            obl: string = this.base_of(this.strip_ref(lt_full));
            obr: string = this.base_of(this.strip_ref(rt_full));
            if obl.size > 0 && obl == obr {
                okey: string = "_opdef_" + obl + "_" + this.op_word(e.op);
                if !this.funcs.isin(okey) && this.generic_funcs.isin(okey) {
                    ocargs: vec<Expr>;
                    ocargs.pushb(e.left);
                    ocargs.pushb(e.right);
                    om: string = this.instantiate_generic(okey, ocargs);
                    e.kind = ExprKind.CALL;
                    e.sval = om;
                    e.args = ocargs;
                    if this.funcs.isin(om) { return this.funcs[om]; }
                    return "int";
                }
                if this.funcs.isin(okey) {
                    ocargs2: vec<Expr>;
                    ocargs2.pushb(e.left);
                    ocargs2.pushb(e.right);
                    e.kind = ExprKind.CALL;
                    e.sval = okey;
                    e.args = ocargs2;
                    return this.funcs[okey];
                }
            }
            // Containment: value <> collection — strings, vectors, arrays
            if e.op == "<>" {
                rh_t2: string = this.strip_ref(rt_full);
                rh_ok2: bool = rh_t2 == "string" || this.is_vec_type2(rh_t2) || (rh_t2.size > 2 && rh_t2[rh_t2.size - 1] == ']');
                if !rh_ok2 {
                    this.errors.pushb("Operator '<>' is only supported for array types, got '" + rh_t2 + "'");
                } else {
                    // Arrays also require the left operand to match the
                    // element type (python parity).
                    if rh_t2.size > 2 && rh_t2[rh_t2.size - 1] == ']' && !this.is_vec_type2(rh_t2) {
                        arr_inner: string = "";
                        ai2: int = 0;
                        while ai2 < rh_t2.size && rh_t2[ai2] != '[' {
                            arr_inner = arr_inner + rh_t2[ai2];
                            ai2 = ai2 + 1;
                        }
                        if arr_inner.size > 0 && !this.types_compatible(lt_full, arr_inner) {
                            this.errors.pushb("Operator '<>' expects left operand of type '" + arr_inner + "' but got '" + lt_full + "'");
                        }
                    }
                }
                return "bool";
            }
            if e.op == "&&" || e.op == "||" {
                if this.base_of(this.strip_ref(lt_full)) != "bool" && !this.is_type_param(this.base_of(this.strip_ref(lt_full))) {
                    this.errors.pushb("Operator '" + e.op + "' requires 'bool' operands, but got '" + this.disp_type(lt_full) + "'.");
                }
                if this.base_of(this.strip_ref(rt_full)) != "bool" && !this.is_type_param(this.base_of(this.strip_ref(rt_full))) {
                    this.errors.pushb("Operator '" + e.op + "' requires 'bool' operands, but got '" + this.disp_type(rt_full) + "'.");
                }
            }
            if e.op == "<" || e.op == "<=" || e.op == ">" || e.op == ">=" ||
               e.op == "&&" || e.op == "||" ||
               e.op == "is" || e.op == "isnt" || e.op == "isT" || e.op == "isntT" {
                return "bool";
            }
            // Mixed string concatenation (python parity): string + scalar
            // (char/int/uint/float/bool) or char[] builds a string, in
            // either order. Without this rule scalar + string was typed as
            // the scalar and chained concatenations collapsed to int, while
            // codegen emitted real concatenations (silently wrong IR).
            if e.op == "+" {
                lb2: string = this.base_of(this.strip_ref(lt_full));
                rb2: string = this.base_of(this.strip_ref(rt_full));
                l_str: bool = lb2 == "string" &&
                    (this.is_numeric_base(rb2) || (rt_full.size >= 5 && this.str_slice(rt_full, 0, 5) == "char["));
                r_str: bool = rb2 == "string" &&
                    (this.is_numeric_base(lb2) || (lt_full.size >= 5 && this.str_slice(lt_full, 0, 5) == "char["));
                if l_str || r_str { return "string"; }
            }
            // For +, -, *, /, % the result follows the numeric promotion:
            // float wins, uint+uint stays uint, char promotes to int
            // Bitwise/modulo operators are integer-only (python parity:
            // the reference rejects them on float operands — stage1 used
            // to accept and then emit broken IR for float %).
            lt: string = lt_full;
            rt_b: string = rt_full;
            if (e.op == "%" || e.op == "&" || e.op == "|" || e.op == "^" || e.op == "<<" || e.op == ">>")
               && (this.is_float_family(lt) || this.is_float_family(rt_b)) {
                this.errors.pushb("Operator '" + e.op + "' is only supported for integer types (operands '" + lt + "' and '" + rt_b + "').");
                this.fatal_idx = this.errors.size - 1;
                return "int";
            }
            // Static division by zero (python parity: a literal zero
            // divisor always crashes, so reject it instead of emitting
            // silently-wrong code). Float division by zero is IEEE-well-
            // defined (inf), so only integer divisors are rejected.
            // Opdef rewrites change the kind, so custom-type division
            // never trips this.
            if e.kind == ExprKind.BINOP && (e.op == "/" || e.op == "%") && e.right != null {
                if e.right.kind == ExprKind.INT && e.right.ival == 0 {
                    if e.op == "/" {
                        this.errors.pushb("Division by zero detected statically!");
                    } else {
                        this.errors.pushb("Modulo by zero detected statically!");
                    }
                }
            }

            // Static shift range check (python parity): a constant shift
            // amount outside [0, bits-1] is undefined behavior.
            if e.kind == ExprKind.BINOP && (e.op == "<<" || e.op == ">>") && e.right != null {
                shift_amt: int = 0;
                has_amt: bool = false;
                if e.right.kind == ExprKind.INT {
                    shift_amt = e.right.ival;
                    has_amt = true;
                } else {
                    if e.right.kind == ExprKind.UNARY && e.right.op == "-"
                       && e.right.left != null && e.right.left.kind == ExprKind.INT {
                        shift_amt = 0 - e.right.left.ival;
                        has_amt = true;
                    }
                }
                if has_amt {
                    bits: int = 0;
                    // Width detection must run on the FULL type spelling —
                    // base_of strips `uint<128>` to `uint`, which would cap
                    // every sized int at the bare 32-bit default.
                    lt_full_s: string = this.strip_imut(this.strip_ref(this.resolve_type_alias(lt_full)));
                    if lt_full_s.size > 5 && lt_full_s[0] == 'i' && lt_full_s[1] == 'n' && lt_full_s[2] == 't' && lt_full_s[3] == '<' && lt_full_s[lt_full_s.size - 1] == '>' {
                        bits = this.parse_small_int(this.str_slice(lt_full_s, 4, lt_full_s.size - 1));
                    }
                    if lt_full_s.size > 6 && lt_full_s[0] == 'u' && lt_full_s[1] == 'i' && lt_full_s[2] == 'n' && lt_full_s[3] == 't' && lt_full_s[4] == '<' && lt_full_s[lt_full_s.size - 1] == '>' {
                        bits = this.parse_small_int(this.str_slice(lt_full_s, 5, lt_full_s.size - 1));
                    }
                    if bits == 0 {
                        if lt_full_s == "int" || lt_full_s == "uint" { bits = 32; }
                        if lt_full_s == "char" { bits = 8; }
                        if lt_full_s == "bool" { bits = 1; }
                    }
                    if bits > 0 {
                        if shift_amt < 0 {
                            this.errors.pushb("Shift amount " + tostring(shift_amt) + " is negative.");
                        } else {
                            if shift_amt >= bits {
                                this.errors.pushb("Shift amount " + tostring(shift_amt) + " is greater than or equal to bit-width " + tostring(bits) + " of '" + lt + "'.");
                            }
                        }
                    }
                }
            }

            if this.is_numeric_base(lt) && this.is_numeric_base(rt_b) {
                // Numeric comparisons are always bool (python parity):
                // promotion must not turn `1.5 == 2` into float.
                if e.op == "==" || e.op == "!=" {
                    return "bool";
                }
                if lt == "float" || rt_b == "float" || lt == "double" || rt_b == "double" { return "float"; }
                if lt == "uint" && rt_b == "uint" { return "uint"; }
                if lt == "char" || rt_b == "char" { return "int"; }
                // Wider int operands keep their width: the binop runs at the
                // wider llvm type, so the inferred type must match it or
                // store-side coercions would re-widen an already-wide reg.
                if lt == "int64" || lt == "int<64>" || rt_b == "int64" || rt_b == "int<64>" {
                    return "int<64>";
                }
            }
            // == / != on non-numeric operands (python parity): nil against
            // a pointer/reference/class instance is a null test; otherwise
            // the operands must be type-compatible.
            if e.op == "==" || e.op == "!=" {
                if (lt_full == "nil") != (rt_full == "nil") {
                    other_t: string = lt_full;
                    if lt_full == "nil" { other_t = rt_full; }
                    other_base: string = this.base_of(this.strip_ref(other_t));
                    // `File` is a builtin class in the reference (registered
                    // in class_types) — the self-hosted keeps it special, so
                    // allow it explicitly for null tests.
                    if (other_base.size > 1 && other_base[0] == '*')
                       || other_t == "File" || this.classes.isin(other_t) {
                        return "bool";
                    }
                }
                if this.types_compatible(lt_full, rt_full) { return "bool"; }
                this.errors.pushb("Cannot use operator '" + e.op + "' between '" + lt_full + "' and '" + rt_full + "'.");
                return "bool";
            }
            // Element-wise matrix arithmetic (python parity).
            lt_is_mat: bool = lt_full.size > 7 && lt_full[0] == 'm' && lt_full[1] == 'a' && lt_full[2] == 't' && lt_full[3] == 'r' && lt_full[4] == 'i' && lt_full[5] == 'x' && lt_full[6] == '<';
            rt_is_mat: bool = rt_full.size > 7 && rt_full[0] == 'm' && rt_full[1] == 'a' && rt_full[2] == 't' && rt_full[3] == 'r' && rt_full[4] == 'i' && rt_full[5] == 'x' && rt_full[6] == '<';
            if lt_is_mat && rt_is_mat {
                if e.op == "+" || e.op == "-" || e.op == "*" || e.op == "/" {
                    if !this.types_compatible(lt_full, rt_full) {
                        this.errors.pushb("Cannot apply operator '" + e.op + "' to matrices of different types: '" + lt_full + "' and '" + rt_full + "'");
                    }
                    return lt_full;
                }
                this.errors.pushb("Operator '" + e.op + "' is not supported for matrix types");
                return lt_full;
            }
            // Vector arithmetic (python parity): element-wise, with
            // scalar broadcasting on either side.
            lt_v: bool = this.is_vec_type2(this.strip_ref(lt_full));
            rt_v: bool = this.is_vec_type2(this.strip_ref(rt_full));
            lt_sc: bool = lt_full == "int" || lt_full == "uint" || lt_full == "float";
            rt_sc: bool = rt_full == "int" || rt_full == "uint" || rt_full == "float";
            if (lt_v && rt_v) || (lt_v && rt_sc) || (rt_v && lt_sc) {
                if e.op == "+" || e.op == "-" || e.op == "*" || e.op == "/" {
                    if lt_v && rt_v {
                        if !this.types_compatible(lt_full, rt_full) {
                            this.errors.pushb("Cannot apply operator '" + e.op + "' to vectors of different types: '" + lt_full + "' and '" + rt_full + "'");
                        }
                        return lt_full;
                    }
                    if lt_v {
                        v_inner: string = this.vec_inner_type2(this.strip_ref(lt_full));
                        if !this.types_compatible(rt_full, v_inner) {
                            this.errors.pushb("Cannot apply operator '" + e.op + "' to vector '" + lt_full + "' with incompatible scalar type '" + rt_full + "'");
                        }
                        return lt_full;
                    }
                    v_inner2: string = this.vec_inner_type2(this.strip_ref(rt_full));
                    if !this.types_compatible(lt_full, v_inner2) {
                        this.errors.pushb("Cannot apply operator '" + e.op + "' to scalar type '" + lt_full + "' with vector '" + rt_full + "'");
                    }
                    return rt_full;
                }
                if e.op == "==" || e.op == "!=" {
                    if lt_v && rt_v && !this.types_compatible(lt_full, rt_full) {
                        this.errors.pushb("Cannot compare vectors of different types: '" + lt_full + "' and '" + rt_full + "'");
                    }
                    return "bool";
                }
                this.errors.pushb("Operator '" + e.op + "' is not supported for vector types");
                return lt_full;
            }
            // String operations (python parity): + and - build/remove;
            // anything else on two strings is rejected.
            if lt_full == "string" && rt_full == "string" {
                if e.op == "+" || e.op == "-" { return "string"; }
                this.errors.pushb("Operator '" + e.op + "' is not supported for strings");
                return "string";
            }
            // Raw-pointer arithmetic (python parity): pointer/reference
            // +- int keeps the pointer side; raw `*` math additionally
            // requires an `unsafe fnc` (safe `&` references are exempt).
            ltb3: string = this.base_of(lt_full);
            rtb3: string = this.base_of(rt_full);
            if ltb3.size > 1 && (ltb3[0] == '*' || ltb3[0] == '&') && rtb3 == "int" {
                if ltb3[0] == '*' && !this.in_unsafe_func {
                    this.errors.pushb("Pointer arithmetic on '" + lt_full + "' requires an `unsafe fnc`.");
                }
                return lt_full;
            }
            if ltb3 == "int" && rtb3.size > 1 && (rtb3[0] == '*' || rtb3[0] == '&') {
                if rtb3[0] == '*' && !this.in_unsafe_func {
                    this.errors.pushb("Pointer arithmetic on '" + rt_full + "' requires an `unsafe fnc`.");
                }
                return rt_full;
            }
            // Fallback (python parity): mismatched operands used to fall
            // through as the left type, letting e.g. struct + int reach
            // codegen and die with internal LLVM errors — reject instead.
            // Both-numeric pairs keep the left type (the promotion block
            // above only returns for the widening combos).
            if lt_full.size > 0 && rt_full.size > 0
               && !this.is_type_param(ltb3) && !this.is_type_param(rtb3)
               && !this.mentions_discard(e, 0)
               && !(this.is_numeric_base(lt_full) && this.is_numeric_base(rt_full)) {
                this.errors.pushb("Cannot use operator '" + e.op + "' between '" + lt_full + "' and '" + rt_full + "'.");
            }
            if lt.size > 0 { return lt; }
            return "int";
        }

        if e.kind == ExprKind.UNARY {
            if e.op == "await" { return this.strip_future(this.infer_expr(e.left)); }
            if e.op == "!" { return "bool"; }
            // Inc/dec requires an assignable target (variable, field,
            // element, or dereference); anything else is rejected here
            // instead of silently dropping the store in codegen.
            if e.op == "++p" || e.op == "--p" || e.op == "++" || e.op == "--" {
                tgt_ok: bool = false;
                if e.left != null {
                    if e.left.kind == ExprKind.IDENT || e.left.kind == ExprKind.MEMBER || e.left.kind == ExprKind.INDEX || e.left.kind == ExprKind.POINTER_MEMBER { tgt_ok = true; }
                    also e.left.kind == ExprKind.UNARY && e.left.op == "*" { tgt_ok = true; }
                }
                if !tgt_ok {
                    this.errors.pushb("'" + e.op + "' target must be a variable, field, or element that can be assigned to.");
                }
                if e.left != null { return this.infer_expr(e.left); }
                return "int";
            }
            if e.op == "&" {
                if e.left.kind == ExprKind.IDENT && !this.lookup_var_fresh(e.left.sval) && this.funcs.isin(e.left.sval) {
                    return this.fn_type_str(e.left.sval);
                }
                return "*" + this.infer_expr(e.left);
            }
            if e.op == "*" {
                pt: string = this.infer_expr(e.left);
                if pt.size > 1 && pt[0] == '*' {
                    // strip leading '*'
                    out: string = "";
                    si: int = 1;
                    while si < pt.size {
                        out = out + pt[si];
                        si = si + 1;
                    }
                    return out;
                }
            }
            return this.infer_expr(e.left);
        }

        if e.kind == ExprKind.CALL {
            if e.sval == "__toint_conv" && e.args.size > 0 && e.args.get(0).kind == ExprKind.STRING {
                return e.args.get(0).sval;
            }
            if !this.funcs.isin(e.sval) && this.generic_funcs.isin(e.sval) {
                this.handle_generic_call(e);
            }
            // Function-pointer variable being called: arity + argument
            // types against the declared signature (Python parity)
            if !this.funcs.isin(e.sval) && this.lookup_var_fresh(e.sval) && this.is_fnc_type(this.lookup_var(e.sval)) {
                tc_fp: vec<string> = this.fnc_parts(this.lookup_var(e.sval));
                fp_params: vec<string>;
                fpi: int = 1;
                while fpi < tc_fp.size {
                    fp_params.pushb(tc_fp.get(fpi));
                    fpi = fpi + 1;
                }
                if e.args.size != fp_params.size {
                    this.errors.pushb("Function pointer expects " + tostring(fp_params.size) + " argument(s), but got " + tostring(e.args.size));
                } else {
                    fpai: int = 0;
                    while fpai < fp_params.size {
                        fpat: string = this.infer_expr(e.args.get(fpai));
                        if fpat.size > 0 && !this.ref_arg_compatible(this.strip_imut(fpat), this.strip_imut(fp_params[fpai])) {
                            this.errors.pushb("Argument " + tostring(fpai + 1) + " of function pointer expects '" + this.strip_imut(fp_params[fpai]) + "' but got '" + this.strip_imut(fpat) + "'.");
                        }
                        fpai = fpai + 1;
                    }
                }
                return tc_fp.get(0);
            }
            // Interpolation parts arrive wrapped in tostring(): the inner
            // expression must be type-checked (python infers interpolated
            // parts directly).
            if e.sval == "tostring" && e.args.size > 0 {
                this.infer_expr(e.args.get(0));
            }
            // Special-cased builtin functions run before user functions
            // (Python checks them in this order too, so a user function
            // shadowing one of these names loses, on both compilers)
            sb: string = this.special_builtin_call(e);
            if sb.size > 0 { return sb; }
            if this.funcs.isin(e.sval) {
                this.check_call_args(e.sval, e);
                return this.funcs[e.sval];
            }
            // `create Class(...)` — allocation expression (python
            // CreateExpr parity). A bare `Class(...)` call is NOT
            // construction: python rejects it as an undefined function,
            // so it falls through to the error below.
            if e.is_create {
                if this.generic_classes.isin(e.sval) {
                    this.errors.pushb("Cannot use 'create' with generic class '" + e.sval + "'. Use the static method syntax instead, e.g., '" + e.sval + "<Type1, Type2>.new()'");
                    return e.sval;
                }
                if !this.classes.isin(e.sval) {
                    this.errors.pushb("Cannot create instance of unknown class '" + e.sval + "'");
                    return e.sval;
                }
                ci_c: ClassInfo = this.classes[e.sval];
                if ci_c.has_method(e.sval) {
                    // Same-named ctor: arity + per-argument types, exactly
                    // like python's _check_create (defaults fill trailing
                    // gaps at codegen).
                    cparams: vec<string> = ci_c.get_method_params(e.sval);
                    total_p: int = cparams.size;
                    required_p: int = 0;
                    if this.ctor_defaults.isin(e.sval) {
                        cdefs_c: vec<Expr> = this.ctor_defaults[e.sval];
                        di_c: int = 0;
                        while di_c < cdefs_c.size && di_c < total_p {
                            if cdefs_c.get(di_c) == null { required_p = required_p + 1; }
                            di_c = di_c + 1;
                        }
                        if cdefs_c.size < total_p { required_p = required_p + (total_p - cdefs_c.size); }
                    } else {
                        required_p = total_p;
                    }
                    actual_c: int = e.args.size;
                    if actual_c < required_p {
                        this.errors.pushb("Constructor '" + e.sval + "' expects at least " + tostring(required_p) + " arguments, but " + tostring(actual_c) + " were given");
                    } also actual_c > total_p {
                        this.errors.pushb("Constructor '" + e.sval + "' expects at most " + tostring(total_p) + " arguments, but " + tostring(actual_c) + " were given");
                    }
                    ai_c: int = 0;
                    while ai_c < actual_c && ai_c < total_p {
                        at_c: string = this.infer_expr(e.args.get(ai_c));
                        if at_c.size > 0 && !this.ref_arg_compatible(this.strip_imut(at_c), this.strip_imut(cparams.get(ai_c))) {
                            this.errors.pushb("Argument " + tostring(ai_c + 1) + " of constructor has type '" + at_c + "', but expected '" + cparams.get(ai_c) + "'");
                        }
                        ai_c = ai_c + 1;
                    }
                }
                return e.sval;
            }
            if e.sval == "tounion" && e.args.size > 0 && e.args.get(0).kind == ExprKind.STRING {
                return e.args.get(0).sval;
            }
            // scast: the first parser argument carries the target type
            if e.sval == "scast" && e.args.size > 0 && e.args.get(0).kind == ExprKind.STRING {
                return e.args.get(0).sval;
            }
            // Leash conversion builtins without a Python Call-form
            // counterpart (Python parses these as dedicated expression
            // kinds, so they never reach its call checker)
            if e.sval == "tofloat" { return "float"; }
            if e.sval == "toint" { return "int"; }
            if e.sval == "sizeof" { return "int"; }
            if e.sval == "typeof" { return "string"; }
            if e.sval == "inttobytes" || e.sval == "floattobytes" { return "char[]"; }
            if e.sval == "bytestoint" { return "int"; }
            if e.sval == "bytestofloat" { return "float"; }
            if e.sval == "__tupget" {
                tup_t: string = this.infer_expr(e.args.get(0));
                if tup_t.size > 1 && tup_t[0] == '(' {
                    return this.tuple_elem_type(tup_t, e.args.get(1).ival);
                }
            }
            this.errors.pushb("Call to undefined function: '" + e.sval + "'");
            return "int";
        }

        if e.kind == ExprKind.METHOD_CALL {
            // A `create` result is not addressable (python codegen
            // rejects receivers like this as `Invalid l-value:
            // CreateExpr`).
            if e.left != null && e.left.kind == ExprKind.CALL && e.left.is_create {
                this.errors.pushb("Invalid l-value: CreateExpr");
                return "int";
            }
            // File class: builtin methods with real signatures, checked
            // like user class methods (arity + argument types)
            file_recv: bool = false;
            if e.left != null && e.left.kind == ExprKind.IDENT && e.left.sval == "File" {
                file_recv = true;
            }
            if !file_recv && e.left != null && e.left.kind == ExprKind.IDENT && this.lookup_var(e.left.sval) == "File" {
                file_recv = true;
            }
            if !file_recv && e.left != null {
                if this.strip_ref(this.infer_expr(e.left)) == "File" { file_recv = true; }
            }
            if file_recv {
                this.check_file_method(e);
                return this.file_method_ret(e.sval);
            }

            obj_type: string = this.strip_ref(this.infer_expr(e.left));

            // Container built-in methods (vec / matrix / hash / string /
            // array) with arity + type checks (Python _check_method_call)
            cmc: string = this.container_method_check(e, obj_type);
            if cmc.size > 0 { return cmc; }

            // Generic STATIC class methods: instantiate for the concrete
            // types and rewrite the call (VecMath<int>.sum -> VecMath_sum_int)
            if e.left != null && e.left.kind == ExprKind.IDENT {
                gs_key: string = e.left.sval + "_" + e.sval;
                if this.generic_funcs.isin(gs_key) {
                    this.handle_generic_method_call(e);
                    if this.funcs.isin(e.sval) { return this.funcs[e.sval]; }
                    return "void";
                }
            }
            // User class methods: existence, static/instance, arity and
            // per-argument types (Python parity). Methods live on the
            // defining class, so resolve through the inheritance chain.
            if this.classes.isin(obj_type) {
                m_owner: string = obj_type;
                m_walk: int = 0;
                while this.classes.isin(m_owner) && m_walk < 16 {
                    if this.classes[m_owner].has_method(e.sval) { stop; }
                    m_owner = this.classes[m_owner].parent;
                    m_walk = m_walk + 1;
                }
                if !this.classes.isin(m_owner) || m_walk >= 16 {
                    this.errors.pushb("Class '" + obj_type + "' has no method named '" + e.sval + "'");
                    this.fatal_idx = this.errors.size - 1;
                    return "void";
                }
                ci: ClassInfo = this.classes[m_owner];
                m_static: bool = ci.is_method_static(e.sval);
                this_recv: bool = e.left != null && e.left.kind == ExprKind.IDENT && e.left.sval == "this";
                static_call: bool = e.left != null && e.left.kind == ExprKind.IDENT
                    && (this.classes.isin(e.left.sval) || this.generic_classes.isin(e.left.sval));
                if static_call && !m_static {
                    this.errors.pushb("Cannot call instance method '" + e.sval + "' statically on class '" + obj_type + "'");
                }
                if !static_call && m_static && !this_recv {
                    this.errors.pushb("Cannot call static method '" + e.sval + "' on an instance of class '" + obj_type + "'");
                }
                mparams: vec<string> = ci.get_method_params(e.sval);
                if e.args.size != mparams.size {
                    this.errors.pushb("Method '" + e.sval + "' of class '" + obj_type + "' expects " + tostring(mparams.size) + " arguments, but got " + tostring(e.args.size));
                    this.fatal_idx = this.errors.size - 1;
                } else {
                    // Generic class templates: only arity is checked (the
                    // concrete types arrive at the instantiation)
                    skip_types: bool = this.generic_classes.isin(obj_type);
                    mai: int = 0;
                    while mai < mparams.size {
                        if !skip_types {
                            mat: string = this.infer_expr(e.args.get(mai));
                            if mat.size > 0 && !this.ref_arg_compatible(this.strip_imut(mat), this.strip_imut(mparams[mai])) {
                                this.errors.pushb("Argument " + tostring(mai + 1) + " of method '" + e.sval + "' expects '" + this.strip_imut(mparams[mai]) + "' but got '" + this.strip_imut(mat) + "'");
                            }
                        }
                        mai = mai + 1;
                    }
                }
                mret: string = ci.get_method_ret(e.sval);
                if mret.size > 0 { return mret; }
                return "void";
            }
            // Struct methods (`fnc ... -> StructType`): resolved through
            // the owner-mangled signature
            if this.structs.isin(obj_type) {
                skey: string = obj_type + "_" + e.sval;
                if this.funcs.isin(skey) {
                    if this.func_params.isin(skey) {
                        mps: vec<string> = this.func_params[skey];
                        if e.args.size != mps.size {
                            this.errors.pushb("Struct method '" + e.sval + "' of struct '" + obj_type + "' expects " + tostring(mps.size) + " arguments, but got " + tostring(e.args.size));
                            this.fatal_idx = this.errors.size - 1;
                        } else {
                            smi: int = 0;
                            while smi < mps.size {
                                smat: string = this.infer_expr(e.args.get(smi));
                                if smat.size > 0 && !this.ref_arg_compatible(this.strip_imut(smat), this.strip_imut(mps[smi])) {
                                    this.errors.pushb("Argument " + tostring(smi + 1) + " of struct method '" + e.sval + "' expects '" + this.strip_imut(mps[smi]) + "' but got '" + this.strip_imut(smat) + "'");
                                }
                                smi = smi + 1;
                            }
                        }
                    }
                    return this.funcs[skey];
                }
            }
            // opdef extension methods: `recv.method(args)` becomes a plain
            // call of `_opdef_<base>_<method>` with the receiver first.
            oobj: string = this.base_of(obj_type);
            if oobj.size > 0 {
                omname: string = e.sval;
                mkey2: string = "_opdef_" + oobj + "_" + e.sval;
                if !this.funcs.isin(mkey2) && this.generic_funcs.isin(mkey2) {
                    mcargs: vec<Expr>;
                    mcargs.pushb(e.left);
                    foreach _, ma in<vector> e.args { mcargs.pushb(ma); }
                    mm: string = this.instantiate_generic(mkey2, mcargs);
                    e.kind = ExprKind.CALL;
                    e.sval = mm;
                    e.args = mcargs;
                    this.check_opdef_method_args(mm, omname, oobj, mcargs);
                    if this.funcs.isin(mm) { return this.funcs[mm]; }
                    return "void";
                }
                if this.funcs.isin(mkey2) {
                    mcargs2: vec<Expr>;
                    mcargs2.pushb(e.left);
                    foreach _, ma2 in<vector> e.args { mcargs2.pushb(ma2); }
                    e.kind = ExprKind.CALL;
                    e.sval = mkey2;
                    e.args = mcargs2;
                    this.check_opdef_method_args(mkey2, omname, oobj, mcargs2);
                    return this.funcs[mkey2];
                }
            }
            this.errors.pushb("Type '" + obj_type + "' has no method named '" + e.sval + "'");
            this.fatal_idx = this.errors.size - 1;
            return "void";
        }

        if e.kind == ExprKind.MEMBER {
            // A `create` result is not addressable (python codegen
            // rejects receivers like this as `Invalid l-value:
            // CreateExpr`).
            if e.left != null && e.left.kind == ExprKind.CALL && e.left.is_create {
                this.errors.pushb("Invalid l-value: CreateExpr");
                return "int";
            }
            if e.sval == "size" { return "int"; }
            mem_obj_t: string = this.strip_ref(this.infer_expr(e.left));
            if e.sval == "name" && this.enums.isin(mem_obj_t) { return "string"; }
            obj_type: string = this.strip_ref(this.infer_expr(e.left));
            if this.unions.isin(obj_type) {
                if e.sval == "cur" { return obj_type; }
                // Type-punning check (python lowlevel parity): reading a
                // variant other than the active one is unsafe outside
                // `unsafe fnc`s. Locals first, then globals; struct-field
                // paths ("w.u") resolve through the member chain.
                if !this.in_unsafe_func && e.left != null {
                    pkey: string = this.member_path(e.left);
                    if pkey.size > 0 {
                        act_v: string = "";
                        u_ty: string = "";
                        if this.union_active.isin(pkey) {
                            act_v = this.union_active[pkey];
                            u_ty = this.union_active_ty[pkey];
                        } else {
                            if this.global_union_active.isin(pkey) {
                                act_v = this.global_union_active[pkey];
                                u_ty = this.global_union_active_ty[pkey];
                            }
                        }
                        if act_v.size > 0 && u_ty == obj_type && act_v != e.sval {
                            this.errors.pushb("Reading union '" + obj_type + "' variant '" + e.sval + "' when '" + act_v + "' is active is type-punning and unsafe outside an `unsafe` function");
                        }
                    }
                }
                return this.union_variant_type(obj_type, this.union_variant_index(obj_type, e.sval));
            }
            if this.structs.isin(obj_type) {
                st: StructInfo = this.structs[obj_type];
                sft: string = st.get_field_type(e.sval);
                if sft.size > 0 { return sft; }
                // Static struct fields live in the flat static_fields map.
                if this.static_fields.isin(obj_type + "_" + e.sval) {
                    return this.static_fields[obj_type + "_" + e.sval];
                }
                return sft;
            }
            if this.classes.isin(obj_type) {
                cl: ClassInfo = this.classes[obj_type];
                cft: string = cl.get_field_type(e.sval);
                if cft.size > 0 { return cft; }
                // Static fields live in the flat static_fields map
                // (`Class_field`) — the instance layout misses them, so
                // `this.staticField` inside (static) methods resolves here.
                if this.static_fields.isin(obj_type + "_" + e.sval) {
                    return this.static_fields[obj_type + "_" + e.sval];
                }
                return cft;
            }
            // Unknown member on a primitive/builtin value type (Python parity).
            mem_base: string = this.base_of(mem_obj_t);
            if mem_base == "int" || mem_base == "uint" || mem_base == "char" || mem_base == "bool" || mem_base == "float" || mem_base == "string" ||
               (mem_obj_t.size > 2 && mem_obj_t[mem_obj_t.size - 1] == ']') {
                this.errors.pushb("Type '" + mem_obj_t + "' has no member named '" + e.sval + "'");
            }
            return "int";
        }

        if e.kind == ExprKind.POINTER_MEMBER {
            // ptr->field: resolve the field against the pointee type.
            // Python parity: `->` needs a real pointer base (`*T`/`&T`);
            // a value (class, union, ...) is rejected, and the cascade
            // strips one char for the follow-up diagnostic, exactly like
            // python's _check_pointer_member_access.
            praw: string = this.infer_expr(e.left);
            if !(praw.size > 1 && (praw[0] == '*' || praw[0] == '&')) {
                this.errors.pushb("Cannot use '->' on non-pointer type '" + praw + "'");
                this.errors.pushb("Type '" + this.str_slice(praw, 1, praw.size) + "' is not a struct or class");
                return "int";
            }
            pobj: string = this.strip_ref(praw);
            if pobj.size > 1 && pobj[0] == '*' {
                pobj = this.str_slice(pobj, 1, pobj.size);
            }
            if this.unions.isin(pobj) {
                if e.sval == "cur" { return pobj; }
                return this.union_variant_type(pobj, this.union_variant_index(pobj, e.sval));
            }
            if this.structs.isin(pobj) {
                pst: StructInfo = this.structs[pobj];
                return pst.get_field_type(e.sval);
            }
            if this.classes.isin(pobj) {
                pcl: ClassInfo = this.classes[pobj];
                return pcl.get_field_type(e.sval);
            }
            return "int";
        }

        if e.kind == ExprKind.INDEX {
            arr_t: string = this.strip_ref(this.infer_expr(e.left));
            idx_t2: string = "";
            if e.right != null { idx_t2 = this.infer_expr(e.right); }
            // Arrays and strings require an integer index (python parity).
            if (arr_t == "string" || (arr_t.size > 2 && arr_t[arr_t.size - 1] == ']'))
               && idx_t2.size > 0 && !this.is_int_family(idx_t2) {
                this.errors.pushb("Array/string index must be an integer, but got '" + idx_t2 + "'");
            }
            if arr_t == "string" { return "char"; }
            // vec<T> -> T
            if (arr_t.size > 5 && arr_t[0] == 'v' && arr_t[1] == 'e' && arr_t[2] == 'c' && arr_t[3] == '<')
               || (arr_t.size > 7 && arr_t[0] == 'm' && arr_t[1] == 'a' && arr_t[2] == 't') {
                inner: string = "";
                i2: int = 4;
                if arr_t.size > 7 && arr_t[0] == 'm' { i2 = 7; }
                while i2 < arr_t.size - 1 {
                    inner = inner + arr_t[i2];
                    i2 = i2 + 1;
                }
                return inner;
            }
            // hash<K, V> -> V
            if arr_t.size > 6 && arr_t[0] == 'h' && arr_t[1] == 'a' && arr_t[2] == 's' && arr_t[3] == 'h' && arr_t[4] == '<' {
                depth: int = 0;
                val: string = "";
                found: bool = false;
                i3: int = 5;
                while i3 < arr_t.size - 1 && !found {
                    ch: char = arr_t[i3];
                    if ch == ',' && depth == 0 {
                        found = true;
                        i3 = i3 + 1;
                        while i3 < arr_t.size - 1 && arr_t[i3] == ' ' {
                            i3 = i3 + 1;
                        }
                        while i3 < arr_t.size - 1 {
                            c2: char = arr_t[i3];
                            val = val + c2;
                            i3 = i3 + 1;
                        }
                    }
                    if ch == '<' { depth = depth + 1; }
                    if ch == '>' { depth = depth - 1; }
                    i3 = i3 + 1;
                }
                return val;
            }
            // Static array bounds check (python parity): a literal index
            // beyond [-(N), N-1] can never land in bounds (negative
            // indices wrap from the end, so -1..-N stay valid).
            if arr_t.size > 2 && arr_t[arr_t.size - 1] == ']' {
                sbo: int = 0;
                while sbo < arr_t.size && arr_t[sbo] != '[' { sbo = sbo + 1; }
                if sbo + 1 < arr_t.size && arr_t[sbo + 1] != ']' {
                    ssz_s: string = "";
                    ssi: int = sbo + 1;
                    while ssi < arr_t.size && arr_t[ssi] != ']' {
                        ssz_s = ssz_s + arr_t[ssi];
                        ssi = ssi + 1;
                    }
                    ssz_ok: bool = ssz_s.size > 0;
                    ssd: int = 0;
                    while ssd < ssz_s.size {
                        if ssz_s[ssd] < '0' || ssz_s[ssd] > '9' { ssz_ok = false; }
                        ssd = ssd + 1;
                    }
                    if ssz_ok {
                        arr_sz: int = this.parse_small_int(ssz_s);
                        idx_v: int = 0;
                        idx_ok: bool = false;
                        if e.right != null && e.right.kind == ExprKind.INT {
                            idx_v = e.right.ival;
                            idx_ok = true;
                        } else {
                            if e.right != null && e.right.kind == ExprKind.UNARY && e.right.op == "-"
                               && e.right.left != null && e.right.left.kind == ExprKind.INT {
                                idx_v = 0 - e.right.left.ival;
                                idx_ok = true;
                            }
                        }
                        if idx_ok && arr_sz > 0 && !this.in_unsafe_func {
                            if idx_v >= arr_sz || (0 - idx_v) > arr_sz {
                                this.errors.pushb("Array index " + tostring(idx_v) + " is out of bounds for '" + arr_t + "'");
                            }
                        }
                    }
                }
            }
            // T[] -> T
            if arr_t.size > 2 && arr_t[arr_t.size - 1] == ']' {
                base_t: string = "";
                bi: int = 0;
                while bi < arr_t.size && arr_t[bi] != '[' {
                    base_t = base_t + arr_t[bi];
                    bi = bi + 1;
                }
                return base_t;
            }
            // Cannot index a non-indexable value (Python parity).
            arr_base: string = this.base_of(arr_t);
            if arr_base == "int" || arr_base == "uint" || arr_base == "char" || arr_base == "bool" || arr_base == "float" {
                this.errors.pushb("Cannot index a value of type '" + arr_t + "'");
            }
            return "int";
        }

        if e.kind == ExprKind.TERNARY {
            return this.infer_expr(e.left);
        }

        if e.kind == ExprKind.CAST {
            // Pointer->integer casts hide pointers from the GC (python
            // lowlevel-checker parity): legal only inside `unsafe fnc`s.
            // Unknown source expressions are not flagged, like the
            // reference.
            if !this.in_unsafe_func && e.left != null {
                cast_dst: string = this.strip_imut(this.resolve_type_alias(e.sval));
                dst_is_intish: bool = this.is_int_family(cast_dst) || cast_dst == "char" || cast_dst == "bool";
                if dst_is_intish {
                    src_ptr: bool = false;
                    if e.left.kind == ExprKind.UNARY && e.left.op == "&" {
                        src_ptr = true;
                    } else {
                        if e.left.kind == ExprKind.IDENT {
                            src_t: string = this.strip_imut(this.lookup_var(e.left.sval));
                            if src_t.size > 0 && (src_t[0] == '*' || src_t[0] == '&') { src_ptr = true; }
                        }
                    }
                    if src_ptr {
                        this.errors.pushb("Casting a pointer to integer with `as` is unsafe outside an `unsafe` function — this can hide pointers from the Garbage Collector");
                    }
                }
            }
            return e.sval;
        }

        if e.kind == ExprKind.STRUCT_INIT {
            // LEASH-E016 parity: every field without a declared default
            // must be present in the initializer.
            if this.structs.isin(e.sval) {
                sinfo: StructInfo = this.structs[e.sval];
                missing: vec<string>;
                fi: int = 0;
                while fi < sinfo.field_names.size {
                    fname: string = sinfo.field_names.get(fi);
                    provided: bool = false;
                    foreach _, pn in<vector> e.field_names {
                        if pn == fname { provided = true; }
                    }
                    has_def: bool = sinfo.field_defaults.get(fi);
                    if !provided && !has_def { missing.pushb(fname); }
                    fi = fi + 1;
                }
                if missing.size > 0 {
                    msg: string = "Struct '" + e.sval + "' initializer is missing field(s): ";
                    mi: int = 0;
                    while mi < missing.size {
                        if mi > 0 { msg = msg + ", "; }
                        msg = msg + missing[mi];
                        mi = mi + 1;
                    }
                    this.errors.pushb(msg + ".");
                }
                // Every provided field value must match the declared field
                // type (python _check_struct_init parity).
                sfi: int = 0;
                while sfi < e.field_names.size {
                    skey: string = e.field_names.get(sfi);
                    sfti: int = 0;
                    while sfti < sinfo.field_names.size {
                        if sinfo.field_names.get(sfti) == skey { stop; }
                        sfti = sfti + 1;
                    }
                    if sfti < sinfo.field_names.size {
                        s_expected: string = this.resolve_type_alias(sinfo.field_types.get(sfti));
                        s_actual: string = this.infer_expr(e.args.get(sfi));
                        this.check_int_literal_fits(e.args.get(sfi), s_expected);
                        if s_actual.size > 0 && !this.types_compatible(s_actual, s_expected) {
                            this.errors.pushb("Struct '" + e.sval + "' field '" + skey + "' expects '" + this.disp_type(s_expected) + "' but got '" + this.disp_type(s_actual) + "'.");
                        }
                    }
                    sfi = sfi + 1;
                }
            }
            return e.sval;
        }

        if e.kind == ExprKind.ARRAY_LIT {
            if e.args.size > 0 {
                first_et: string = this.infer_expr(e.args.get(0));
                // Hash literals ({k: v, ...}) carry field_names and
                // multi-return tuples (sval == "__tuple__") are both
                // legitimately heterogeneous — only plain array literals
                // reject mixed element types (python _check_array_init).
                if e.field_names.size == 0 && e.sval != "__tuple__" {
                    // Mixed-type array literals are rejected (python
                    // _check_array_init parity).
                    ei3: int = 1;
                    while ei3 < e.args.size {
                        elem_t: string = this.infer_expr(e.args.get(ei3));
                        if first_et.size > 0 && elem_t.size > 0
                           && !this.types_compatible(elem_t, first_et) {
                            this.errors.pushb("Array contains mixed types: '" + first_et + "' and '" + elem_t + "'.");
                        }
                        ei3 = ei3 + 1;
                    }
                }
                return first_et + "[]";
            }
            return "int[]";
        }

        return "int";
    }

    pub fnc check_statement(s Stmt) : void {
        if s == null { return; }
        if this.fatal_idx >= 0 { return; }

        if s.kind == StmtKind.VAR_DECL {
            var_t: string = this.resolve_type_alias(s.var_type);
            s.var_type = var_t;
            // Unknown type names (int32, Bogus, ...) are rejected, not
            // silently compiled to a fallback (Python E003 parity).
            if var_t.size > 0 && !s.is_infer && !this.is_known_type(var_t) {
                this.errors.pushb("Variable '" + s.name + "' declared with unknown type '" + var_t + "'");
                this.define_var(s.name, var_t);
                // Python keeps checking the initializer after E003 (its
                // errors and the E004-style mismatch all surface), so walk
                // the value too instead of bailing out silently.
                if s.value != null {
                    v_unk: string = this.infer_expr(s.value);
                    if this.fatal_idx < 0 && !this.types_compatible(v_unk, var_t) {
                        this.errors.pushb("Variable '" + s.name + "' declared as '" + this.disp_type(var_t) + "' but assigned a value of type '" + this.disp_type(v_unk) + "'.");
                    }
                }
                return;
            }
            // M5 (python parity): array sizes must be positive, bounded, or
            // paired with an initializer. Larger values crashed IR emission;
            // non-positive sizes crashed array construction; runtime-sized
            // arrays without an initializer crashed the compiler.
            if var_t.size > 2 && var_t[var_t.size - 1] == ']' {
                ob_i: int = 0;
                while ob_i < var_t.size && var_t[ob_i] != '[' { ob_i = ob_i + 1; }
                if ob_i + 1 < var_t.size && var_t[ob_i + 1] != ']' {
                    inner_sz: string = "";
                    is_i: int = ob_i + 1;
                    while is_i < var_t.size && var_t[is_i] != ']' {
                        inner_sz = inner_sz + var_t[is_i];
                        is_i = is_i + 1;
                    }
                    sz_const: bool = inner_sz.size > 0;
                    sz_neg: bool = false;
                    sz_di: int = 0;
                    if inner_sz.size > 0 && (inner_sz[0] == '-' || inner_sz[0] == '+') {
                        if inner_sz[0] == '-' { sz_neg = true; }
                        sz_di = 1;
                    }
                    while sz_di < inner_sz.size {
                        if inner_sz[sz_di] < '0' || inner_sz[sz_di] > '9' { sz_const = false; }
                        sz_di = sz_di + 1;
                    }
                    if sz_const {
                        if sz_neg || inner_sz == "0" {
                            this.errors.pushb("Array size for '" + s.name + "' must be a positive integer, got 0 or negative.");
                        } else {
                            // int is 32-bit in this compiler: compare the
                            // digit string instead of parsing huge values.
                            sz_big: bool = inner_sz.size > 10;
                            if inner_sz.size == 10 && this.str_less("2147483647", inner_sz) { sz_big = true; }
                            if sz_big {
                                this.errors.pushb("Array size " + inner_sz + " for '" + s.name + "' is too large (maximum 2147483647).");
                            }
                        }
                    } else {
                        if s.value == null {
                            this.errors.pushb("Array '" + s.name + "' has a non-constant size '" + inner_sz + "' but no initializer.");
                        }
                    }
                }
            }
            if s.is_infer || var_t.size == 0 {
                var_t = this.infer_expr(s.value);
                s.var_type = var_t;
            } also s.value != null {
                gc_base: string = this.generic_class_base(var_t);
                if gc_base.size > 0 {
                    // `x: Tpl<A, B>` — instantiate and rewrite `Tpl.new()`
                    gc_lt: int = 0;
                    while gc_lt < var_t.size {
                        if var_t[gc_lt] == '<' { stop; }
                        gc_lt = gc_lt + 1;
                    }
                    gc_args: vec<string> = this.split_commas(this.str_slice(var_t, gc_lt + 1, var_t.size - 1));
                    gc_mangled: string = this.instantiate_generic_class(gc_base, gc_args);
                    var_t = gc_mangled;
                    s.var_type = var_t;
                    if s.value.kind == ExprKind.METHOD_CALL && s.value.left != null
                       && s.value.left.kind == ExprKind.IDENT && s.value.left.sval == gc_base {
                        // `x: Tpl<A>.new()` and any other static method call
                        // on the template base (`Set.from_vals(v)`) resolve to
                        // the instantiated clone's method.
                        s.value.left.sval = gc_mangled;
                    }
                    v_gi: string = this.infer_expr(s.value);
                    if this.fatal_idx < 0 && !this.types_compatible(v_gi, var_t) {
                        this.errors.pushb("Variable '" + s.name + "' declared as '" + this.disp_type(s.var_type) + "' but assigned a value of type '" + this.disp_type(v_gi) + "'.");
                    }
                } also s.value.kind == ExprKind.METHOD_CALL
                   && s.value.left != null && s.value.left.kind == ExprKind.IDENT
                   && s.value.sval == "new"
                   && this.generic_classes.isin(s.value.left.sval) {
                    // `x := Tpl.new()` without declared args: placeholder
                    // instantiation so names still resolve.
                    ph_args: vec<string>;
                    ph_tps: vec<string> = this.class_tparams[s.value.left.sval];
                    foreach _, _pt in<vector> ph_tps { ph_args.pushb("int"); }
                    ph_m: string = this.instantiate_generic_class(s.value.left.sval, ph_args);
                    s.value.left.sval = ph_m;
                } else {
                    // Explicitly typed: walk the initializer (generic call
                    // sites specialise here) and check the assignment type.
                    // Hash literals carry no type of their own: their keys
                    // and values are checked against the declared hash.
                    v_ei: string = this.infer_expr(s.value);
                    v_hashlit: bool = s.value.kind == ExprKind.ARRAY_LIT && s.value.field_names.size > 0;
                    if this.fatal_idx < 0 && !v_hashlit && !this.types_compatible(v_ei, var_t) {
                        this.errors.pushb("Variable '" + s.name + "' declared as '" + this.disp_type(var_t) + "' but assigned a value of type '" + this.disp_type(v_ei) + "'.");
                    }
                }
            }
            // C2: a literal initializer must fit the declared type's
            // sign/width (Python LEASH-E015 parity)
            if s.value != null && var_t.size > 0 {
                this.check_int_literal_fits(s.value, var_t);
            }
            if s.is_imut { this.imut_vars.push(s.name, true); }
            // Alias tracking (python parity): `p := o` for a class instance
            // makes p and o aliases — del poisons every alias.
            if s.is_infer && s.value != null && s.value.kind == ExprKind.IDENT
               && this.classes.isin(this.strip_imut(this.resolve_type_alias(var_t))) {
                this.alias_union(s.name, s.value.sval);
            }
            // Union active-variant tracking (python lowlevel parity):
            // `u: U = 5` records the active variant; struct-literal fields
            // holding unions record "<var>.<field>" paths.
            u_res2: string = this.strip_imut(this.resolve_type_alias(var_t));
            if this.unions.isin(u_res2) {
                this.union_active_ty.push(s.name, u_res2);
                if s.value != null {
                    uv2: string = this.find_union_variant(u_res2, s.value);
                    if uv2.size > 0 { this.union_active.push(s.name, uv2); }
                }
            }
            if s.value != null && s.value.kind == ExprKind.STRUCT_INIT {
                si_name2: string = this.strip_imut(this.resolve_type_alias(s.value.sval));
                if this.structs.isin(si_name2) {
                    s_sinfo: StructInfo = this.structs[si_name2];
                    sfi2: int = 0;
                    while sfi2 < s.value.field_names.size {
                        sfname: string = s.value.field_names.get(sfi2);
                        fti2: int = 0;
                        while fti2 < s_sinfo.field_names.size {
                            if s_sinfo.field_names.get(fti2) == sfname { stop; }
                            fti2 = fti2 + 1;
                        }
                        if fti2 < s_sinfo.field_names.size {
                            sft2: string = this.strip_imut(this.resolve_type_alias(s_sinfo.field_types.get(fti2)));
                            if this.unions.isin(sft2) {
                                this.union_active_ty.push(s.name + "." + sfname, sft2);
                                sfv: string = this.find_union_variant(sft2, s.value.args.get(sfi2));
                                if sfv.size > 0 { this.union_active.push(s.name + "." + sfname, sfv); }
                            }
                        }
                        sfi2 = sfi2 + 1;
                    }
                }
            }
            this.define_var(s.name, var_t);
            return;
        }

        if s.kind == StmtKind.ASSIGN {
            a_tt: string = this.infer_expr(s.target);
            a_tv: string = this.infer_expr(s.value);
            // Strings are immutable: reject element writes like s[0] = 'x'
            // (python LEASH-E013 parity).
            if s.target.kind == ExprKind.INDEX && s.target.left != null {
                str_base: string = this.infer_expr(s.target.left);
                if str_base == "string" {
                    this.errors.pushb("Strings are immutable: individual characters cannot be assigned.");
                }
            }
            // Element/field writes through read-only array params or `imut`
            // variables mutate storage that must not change (python parity:
            // only bare reassignment of the name itself was rejected before).
            if s.target.kind == ExprKind.INDEX || s.target.kind == ExprKind.MEMBER {
                mut_root: string = this.root_identifier(s.target);
                if mut_root.size > 0 {
                    if this.readonly_borrows.isin(mut_root) {
                        this.errors.pushb("Cannot mutate '" + mut_root + "': array parameters are read-only borrows.");
                    }
                    if this.imut_vars.isin(mut_root) {
                        this.errors.pushb("Cannot mutate '" + mut_root + "': it was declared `imut`.");
                    }
                }
            }
            // One-writer rule for `shared` globals (any write counts,
            // including element/field writes through the root identifier).
            // Writes through a shadowing local do not count.
            sh_root: string = "";
            if s.target.kind == ExprKind.IDENT {
                sh_root = s.target.sval;
            } else {
                sh_root = this.root_identifier(s.target);
            }
            if sh_root.size > 0 && this.shared_globals.isin(sh_root) && !this.lookup_var_fresh(sh_root) {
                prev_writer: string = "";
                if this.shared_writers.isin(sh_root) { prev_writer = this.shared_writers[sh_root]; }
                if prev_writer.size > 0 && prev_writer != this.current_func_name {
                    this.errors.pushb("shared variable '" + sh_root + "' is written by both '" + prev_writer + "' and '" + this.current_func_name + "'. `shared` allows exactly ONE writer with any number of readers. Use a `fusion` variable (atomic) if several workers must write it, or give each worker its own variable.");
                } else {
                    this.shared_writers.push(sh_root, this.current_func_name);
                }
            }
            // Union variant writes (python lowlevel parity): `u.f = x`
            // switches the active variant — switching from a DIFFERENT
            // active variant is type-punning outside `unsafe fnc`s.
            // Plain `u = x` refreshes the variant from the value.
            if s.target != null && s.target.kind == ExprKind.MEMBER {
                wpath: string = this.member_path(s.target);
                if wpath.size > 0 {
                    dot_i: int = 0;
                    di2: int = 0;
                    while di2 < wpath.size {
                        if wpath[di2] == '.' { dot_i = di2; }
                        di2 = di2 + 1;
                    }
                    if dot_i > 0 && dot_i + 1 < wpath.size {
                        ukey: string = this.str_slice(wpath, 0, dot_i);
                        uvar: string = this.str_slice(wpath, dot_i + 1, wpath.size);
                        ukey_ty: string = "";
                        ukey_act: string = "";
                        u_is_local: bool = false;
                        if this.union_active_ty.isin(ukey) {
                            ukey_ty = this.union_active_ty[ukey];
                            if this.union_active.isin(ukey) { ukey_act = this.union_active[ukey]; }
                            u_is_local = true;
                        } else {
                            if this.global_union_active_ty.isin(ukey) {
                                ukey_ty = this.global_union_active_ty[ukey];
                                if this.global_union_active.isin(ukey) { ukey_act = this.global_union_active[ukey]; }
                            }
                        }
                        if ukey_ty.size > 0 {
                            vnames: vec<string> = this.union_names[ukey_ty];
                            v_ok: bool = false;
                            vi: int = 0;
                            while vi < vnames.size {
                                if vnames.get(vi) == uvar { v_ok = true; }
                                vi = vi + 1;
                            }
                            if v_ok {
                                if ukey_act.size > 0 && ukey_act != uvar && !this.in_unsafe_func {
                                    this.errors.pushb("Changing union '" + ukey_ty + "' active variant from '" + ukey_act + "' to '" + uvar + "' is type-punning and unsafe outside an `unsafe` function");
                                }
                                if u_is_local {
                                    this.union_active.push(ukey, uvar);
                                } else {
                                    this.global_union_active.push(ukey, uvar);
                                }
                            }
                        }
                    }
                }
            }
            // Inc/dec assignment ops need an assignable target too.
            if s.op == "++" || s.op == "--" {
                aok: bool = false;
                if s.target.kind == ExprKind.IDENT || s.target.kind == ExprKind.MEMBER || s.target.kind == ExprKind.INDEX || s.target.kind == ExprKind.POINTER_MEMBER { aok = true; }
                also s.target.kind == ExprKind.UNARY && s.target.op == "*" { aok = true; }
                if !aok {
                    this.errors.pushb("'" + s.op + "' target must be a variable, field, or element that can be assigned to.");
                }
            }
            if this.fatal_idx < 0 && a_tt.size > 0 && a_tv.size > 0 && !this.types_compatible(a_tv, a_tt) {
                this.errors.pushb("Cannot assign a value of type '" + this.disp_type(a_tv) + "' to a variable of type '" + this.disp_type(a_tt) + "'.");
            }
            // C2: a literal RHS must fit the target variable's sign/width
            if a_tt.size > 0 {
                this.check_int_literal_fits(s.value, a_tt);
            }
            return;
        }

        if s.kind == StmtKind.RETURN {
            if s.value != null {
                this.infer_expr(s.value);
                // LEASH-E010: the address of a call-frame local escapes the
                // function and would dangle once the frame is gone.
                off: string = this.frame_escape_in(s.value);
                if off.size > 0 {
                    this.errors.pushb("Cannot return the address of local '" + off + "': it lives on the current call frame and would dangle.");
                }
            }
            return;
        }

        if s.kind == StmtKind.SPAWN {
            // Python _check_spawn parity
            if s.op != "call" {
                this.errors.pushb("spawn requires a function call");
                return;
            }
            fname: string = s.name;
            if this.async_funcs.isin(fname) {
                this.errors.pushb("Cannot spawn async function '" + fname + "' — it already runs on a worker; just call it and await the future");
                return;
            }
            if !this.funcs.isin(fname) {
                this.errors.pushb("Cannot spawn unknown function '" + fname + "'");
                return;
            }
            if !this.worker_funcs.isin(fname) {
                this.errors.pushb("Cannot spawn non-worker function '" + fname + "' — spawn only runs `worker fnc` functions");
                return;
            }
            sp_params: vec<string>;
            if this.func_params.isin(fname) { sp_params = this.func_params[fname]; }
            if s.args.size != sp_params.size {
                this.errors.pushb("Function '" + fname + "' expects " + tostring(sp_params.size) + " arguments, but spawn call provides " + tostring(s.args.size));
            } else {
                spi: int = 0;
                while spi < sp_params.size {
                    spat: string = this.infer_expr(s.args.get(spi));
                    if spat.size > 0 && !this.ref_arg_compatible(this.strip_imut(spat), this.strip_imut(sp_params.get(spi))) {
                        this.errors.pushb("Argument " + tostring(spi + 1) + " of spawn '" + fname + "' expects '" + this.strip_imut(sp_params.get(spi)) + "', got '" + this.strip_imut(spat) + "'");
                    }
                    spi = spi + 1;
                }
            }
            sp_ret: string = this.funcs[fname];
            if sp_ret != "void" {
                this.errors.pushb("Spawned function '" + fname + "' must return void, but returns '" + sp_ret + "'");
            }
            return;
        }

        if s.kind == StmtKind.THROW {
            foreach _, ta in<vector> s.args {
                this.infer_expr(ta);
            }
            return;
        }

        if s.kind == StmtKind.IF {
            cond_t: string = this.infer_expr(s.cond);
            cond_b: string = this.base_of(this.strip_ref(cond_t));
            if cond_b != "bool" && !this.is_type_param(cond_b) {
                this.errors.pushb("'if' condition must be 'bool', but got '" + this.disp_type(cond_t) + "'.");
            }
            this.enter_scope();
            foreach _, st in<vector> s.then_block { this.check_statement(st); }
            this.exit_scope();

            this.enter_scope();
            foreach _, se in<vector> s.else_block { this.check_statement(se); }
            this.exit_scope();
            return;
        }

        if s.kind == StmtKind.WHILE {
            cond_t: string = this.infer_expr(s.cond);
            cond_b: string = this.base_of(this.strip_ref(cond_t));
            if cond_b != "bool" && !this.is_type_param(cond_b) {
                this.errors.pushb("'while' condition must be 'bool', but got '" + this.disp_type(cond_t) + "'.");
            }
            this.enter_scope();
            foreach _, st in<vector> s.body { this.check_statement(st); }
            this.exit_scope();
            return;
        }

        if s.kind == StmtKind.FOR {
            this.enter_scope();
            if s.for_init != null { this.check_statement(s.for_init); }
            if s.cond != null {
                fcond_t: string = this.infer_expr(s.cond);
                fcond_b: string = this.base_of(this.strip_ref(fcond_t));
                if fcond_b != "bool" && !this.is_type_param(fcond_b) {
                    this.errors.pushb("'for' condition must be 'bool', but got '" + this.disp_type(fcond_t) + "'.");
                }
            }
            if s.for_step != null { this.check_statement(s.for_step); }
            foreach _, st in<vector> s.body { this.check_statement(st); }
            this.exit_scope();
            return;
        }

        if s.kind == StmtKind.LOOP {
            this.enter_scope();
            foreach _, st in<vector> s.body { this.check_statement(st); }
            this.exit_scope();
            return;
        }

        if s.kind == StmtKind.BLOCK {
            // Multi-assign desugars to a block whose vars belong to the
            // enclosing scope — no nested scoping there.
            if s.name != "__ma__" {
                this.enter_scope();
            }
            foreach _, st in<vector> s.body { this.check_statement(st); }
            if s.name != "__ma__" {
                this.exit_scope();
            }
            return;
        }

        if s.kind == StmtKind.SHOW {
            foreach _, a in<vector> s.args { this.infer_expr(a); }
            return;
        }

        if s.kind == StmtKind.SWITCH {
            this.infer_expr(s.value);
            foreach _, c in<vector> s.switch_cases {
                this.enter_scope();
                foreach _, cs in<vector> c.body { this.check_statement(cs); }
                this.exit_scope();
            }
            if s.default_block.size > 0 {
                this.enter_scope();
                foreach _, ds in<vector> s.default_block { this.check_statement(ds); }
                this.exit_scope();
            }
            return;
        }

        if s.kind == StmtKind.FOREACH_STRUCT {
            selfT: string = this.strip_ref(this.infer_expr(s.target));
            fnames: vec<string>;
            ftypes: vec<string>;
            have_meta: bool = false;
            if this.structs.isin(selfT) {
                st_i: StructInfo = this.structs[selfT];
                fnames = st_i.field_names;
                ftypes = st_i.field_types;
                have_meta = true;
            } else {
                if this.classes.isin(selfT) {
                    cl_i: ClassInfo = this.classes[selfT];
                    fnames = cl_i.field_names;
                    ftypes = cl_i.field_types;
                    have_meta = true;
                }
            }
            if !have_meta {
                show("error: in<struct> foreach on non-struct type '", selfT, "'");
                return;
            }
            li: int = 0;
            while li < fnames.size {
                this.enter_scope();
                this.define_var(s.name, "string");
                this.define_var(s.var_type, ftypes.get(li));
                foreach _, bst in<vector> s.body { this.check_statement(bst); }
                this.exit_scope();
                li = li + 1;
            }
            return;
        }

        if s.kind == StmtKind.WORKS {
            this.enter_scope();
            prev_in_works: bool = this.in_works;
            this.in_works = true;
            foreach _, wb in<vector> s.body { this.check_statement(wb); }
            this.in_works = prev_in_works;
            this.define_var(s.name, "string");
            foreach _, hb in<vector> s.else_block { this.check_statement(hb); }
            this.exit_scope();
            return;
        }

        if s.kind == StmtKind.EXPR {
            // `del <target>;` parses as an EXPR statement named __del__.
            // Class-instance destruction (python parity): double deletes
            // are rejected and every alias of the instance is poisoned —
            // `p := o; del o; p.v` is a use-after-free too.
            if s.name == "__del__" && s.value != null {
                if s.value.kind == ExprKind.IDENT {
                    dname: string = s.value.sval;
                    if this.alias_in(dname) {
                        this.errors.pushb("Double delete: '" + dname + "' has already been deleted.");
                        return;
                    }
                    dt: string = this.strip_imut(this.resolve_type_alias(this.lookup_var(dname)));
                    if dt.size > 0 && !this.classes.isin(dt) && dt[0] != '*' {
                        this.errors.pushb("Cannot use 'del' on '" + dt + "': not a class instance");
                        return;
                    }
                    this.deleted_vars.push(dname, true);
                    if this.alias_map.isin(dname) {
                        dg: vec<string> = this.alias_groups[this.alias_map[dname]];
                        foreach _, dn2 in<vector> dg {
                            this.deleted_vars.push(dn2, true);
                        }
                    }
                    return;
                }
                this.infer_expr(s.value);
                return;
            }
            this.infer_expr(s.value);
            return;
        }
    }

    // ------------------------------------------------------------------
    // Generic (multi-type / template) function support.
    //
    // A function whose signature contains `[T1, T2, ...]` is kept as a
    // template: each multi-type slot becomes a synthetic type parameter
    // (`_T_0`, `_T_1`, ...). Every call site is specialised at type-check
    // time into a concrete mangled function (`add_int_int`), which is what
    // the rest of the pipeline (and codegen) sees.
    // ------------------------------------------------------------------

    pub fnc str_slice(s string, a int, b int) : string {
        out: string = "";
        i: int = a;
        while i < b && i < s.size {
            out = out + s[i];
            i = i + 1;
        }
        return out;
    }

    pub fnc trim_ws(s string) : string {
        a: int = 0;
        while a < s.size && s[a] == ' ' { a = a + 1; }
        b: int = s.size;
        while b > a && s[b - 1] == ' ' { b = b - 1; }
        return this.str_slice(s, a, b);
    }

    pub fnc strip_imut(t string) : string {
        if t.size > 5 && t[0] == 'i' && t[1] == 'm' && t[2] == 'u' && t[3] == 't' && t[4] == ' ' {
            return this.str_slice(t, 5, t.size);
        }
        return t;
    }

    pub fnc is_multi_type(t string) : bool {
        tt: string = this.strip_imut(t);
        if tt.size < 2 { return false; }
        if tt[0] != '[' { return false; }
        return tt[tt.size - 1] == ']';
    }

    // Split on top-level commas (angle brackets and parens nest).
    pub fnc split_commas(s string) : vec<string> {
        res: vec<string>;
        angle: int = 0;
        paren: int = 0;
        cur: string = "";
        i: int = 0;
        while i < s.size {
            c: char = s[i];
            if c == '<' {
                angle = angle + 1; cur = cur + c;
            } also c == '>' {
                angle = angle - 1; cur = cur + c;
            } also c == '(' {
                paren = paren + 1; cur = cur + c;
            } also c == ')' {
                paren = paren - 1; cur = cur + c;
            } also c == ',' {
                if angle == 0 && paren == 0 {
                    res.pushb(this.trim_ws(cur));
                    cur = "";
                } else {
                    cur = cur + c;
                }
            } else {
                cur = cur + c;
            }
            i = i + 1;
        }
        last: string = this.trim_ws(cur);
        if last.size > 0 { res.pushb(last); }
        return res;
    }

    pub fnc parse_multi_type(t string) : vec<string> {
        tt: string = this.strip_imut(t);
        if !this.is_multi_type(tt) {
            no_parts: vec<string>;
            return no_parts;
        }
        return this.split_commas(this.str_slice(tt, 1, tt.size - 1));
    }

    // Substitute synthetic type parameters inside a (possibly composite) type.
    pub fnc substitute_type_params(t string, tmap hash<string, string>) : string {
        if t.size == 0 { return t; }
        if tmap.isin(t) { return tmap[t]; }
        stripped: string = this.strip_imut(t);
        if stripped != t {
            return "imut " + this.substitute_type_params(stripped, tmap);
        }
        if this.is_multi_type(t) {
            parts: vec<string> = this.parse_multi_type(t);
            out: string = "[";
            foreach i, part in<vector> parts {
                if i > 0 { out = out + ", "; }
                out = out + this.substitute_type_params(part, tmap);
            }
            return out + "]";
        }
        if t.size > 1 && t[0] == '*' {
            return "*" + this.substitute_type_params(this.str_slice(t, 1, t.size), tmap);
        }
        if t.size > 1 && t[0] == '&' {
            return "&" + this.substitute_type_params(this.str_slice(t, 1, t.size), tmap);
        }
        // Generic / tuple containers: Base<...> and (a, b) share the same shape
        open_ch: char = '<';
        close_ch: char = '>';
        if t[0] == '(' { open_ch = '('; close_ch = ')'; }
        if (t[0] == '<' || t[0] == '(') && t[t.size - 1] == close_ch {
            inner: vec<string> = this.split_commas(this.str_slice(t, 1, t.size - 1));
            out2: string = "" + open_ch;
            foreach i2, part2 in<vector> inner {
                if i2 > 0 { out2 = out2 + ", "; }
                out2 = out2 + this.substitute_type_params(part2, tmap);
            }
            return out2 + close_ch;
        }
        lt: int = -1;
        li: int = 0;
        while li < t.size {
            if t[li] == '<' { lt = li; stop; }
            li = li + 1;
        }
        if lt > 0 && t[t.size - 1] == '>' {
            base: string = this.str_slice(t, 0, lt);
            inner2: vec<string> = this.split_commas(this.str_slice(t, lt + 1, t.size - 1));
            out3: string = base + "<";
            foreach i3, part3 in<vector> inner2 {
                if i3 > 0 { out3 = out3 + ", "; }
                out3 = out3 + this.substitute_type_params(part3, tmap);
            }
            return out3 + ">";
        }
        // Array suffix: T[] / K[] — substitute the base, re-suffix
        if t.size > 2 && t[t.size - 1] == ']' && t[t.size - 2] == '[' {
            return this.substitute_type_params(this.str_slice(t, 0, t.size - 2), tmap) + "[]";
        }
        return t;
    }

    pub fnc mangle_generic(base string, targs vec<string>) : string {
        out: string = base;
        foreach _, a in<vector> targs {
            piece: string = "";
            i: int = 0;
            while i < a.size {
                c: char = a[i];
                if c == '<' || c == '>' || c == ',' { piece = piece + '_'; }
                also c == ' ' { }
                else { piece = piece + c; }
                i = i + 1;
            }
            out = out + "_" + piece;
        }
        return out;
    }

    // Detect a generic signature and record the template + derived params.
    // NOTE: the derivation runs inline. Container parameters are passed by
    // value (`{ptr, size, cap}` structs), so a helper taking `vec`/`hash`
    // out-params would mutate a private copy — the caller would never see
    // the result. Locals and fields are addressable and safe to mutate.
    pub fnc derive_generic_params(f FuncDecl) : bool {
        if f.owner.size > 0 { return false; }
        has_mt: bool = this.is_multi_type(f.ret_type);
        foreach _, p in<vector> f.params {
            if this.is_multi_type(p.typ) { has_mt = true; }
        }
        has_tpl: bool = this.uses_template_type(f.ret_type);
        if !has_tpl {
            foreach _, p in<vector> f.params {
                if this.uses_template_type(p.typ) { has_tpl = true; }
            }
        }
        if !has_mt && !has_tpl { return false; }

        tset: vec<string>;
        tmap: hash<string, string>;
        foreach _, p in<vector> f.params {
            if this.is_multi_type(p.typ) && !tmap.isin(p.typ) {
                nm: string = "_T_" + tostring(tset.size);
                tmap.push(p.typ, nm);
                tset.pushb(nm);
            }
        }
        if this.is_multi_type(f.ret_type) && !tmap.isin(f.ret_type) {
            rnm: string = "_T_" + tostring(tset.size);
            tmap.push(f.ret_type, rnm);
            tset.pushb(rnm);
        }
        // template-type generics: the template names themselves are the
        // parameters; concrete types arrive at the call site
        if has_tpl {
            rnames: vec<string> = this.template_names_in(f.ret_type);
            foreach _, tn in<vector> rnames {
                if !this.name_in_vec(tset, tn) { tset.pushb(tn); }
            }
            foreach _, p in<vector> f.params {
                pnames: vec<string> = this.template_names_in(p.typ);
                foreach _, tn2 in<vector> pnames {
                    if !this.name_in_vec(tset, tn2) { tset.pushb(tn2); }
                }
            }
        }

        ptypes: vec<string>;
        foreach _, p in<vector> f.params {
            if has_mt {
                ptypes.pushb(this.substitute_type_params(p.typ, tmap));
            } else {
                ptypes.pushb(p.typ);
            }
        }
        this.generic_funcs.push(f.name, f);
        this.generic_tparams.push(f.name, tset);
        this.generic_ptypes.push(f.name, ptypes);
        if has_mt {
            this.generic_rtype.push(f.name, this.substitute_type_params(f.ret_type, tmap));
        } else {
            this.generic_rtype.push(f.name, f.ret_type);
        }
        return true;
    }

    // Collect the template names inside a (possibly composite) type.
    pub fnc template_names_in(t string) : vec<string> {
        res: vec<string>;
        tt: string = this.strip_imut(t);
        if tt.size == 0 { return res; }
        if this.template_types.isin(tt) {
            if !this.name_in_vec(res, tt) { res.pushb(tt); }
            return res;
        }
        if this.is_multi_type(tt) {
            parts: vec<string> = this.parse_multi_type(tt);
            foreach _, part in<vector> parts {
                sub: vec<string> = this.template_names_in(part);
                foreach _, s2 in<vector> sub {
                    if !this.name_in_vec(res, s2) { res.pushb(s2); }
                }
            }
            return res;
        }
        if tt.size > 1 && (tt[0] == '*' || tt[0] == '&') {
            return this.template_names_in(this.str_slice(tt, 1, tt.size));
        }
        if tt.size > 3 && tt[tt.size - 1] == '>' {
            lt3: int = -1;
            li3: int = 0;
            while li3 < tt.size {
                if tt[li3] == '<' { lt3 = li3; stop; }
                li3 = li3 + 1;
            }
            if lt3 > 0 {
                inner: vec<string> = this.split_commas(this.str_slice(tt, lt3 + 1, tt.size - 1));
                foreach _, part2 in<vector> inner {
                    sub2: vec<string> = this.template_names_in(part2);
                    foreach _, s3 in<vector> sub2 {
                        if !this.name_in_vec(res, s3) { res.pushb(s3); }
                    }
                }
            }
        }
        return res;
    }

    // Recursive template usage: a type uses a template if it is one, or
    // contains one inside vec<...>/matrix<...>/hash<...>/[...]/Base<...>.
    pub fnc uses_template_type(t string) : bool {
        tt: string = this.strip_imut(t);
        if tt.size == 0 { return false; }
        if this.template_types.isin(tt) { return true; }
        if this.is_multi_type(tt) {
            parts: vec<string> = this.parse_multi_type(tt);
            foreach _, part in<vector> parts {
                if this.uses_template_type(part) { return true; }
            }
            return false;
        }
        if tt.size > 1 && (tt[0] == '*' || tt[0] == '&') {
            return this.uses_template_type(this.str_slice(tt, 1, tt.size));
        }
        if tt.size > 3 && tt[tt.size - 1] == '>' {
            lt2: int = -1;
            li2: int = 0;
            while li2 < tt.size {
                if tt[li2] == '<' { lt2 = li2; stop; }
                li2 = li2 + 1;
            }
            if lt2 > 0 {
                inner: vec<string> = this.split_commas(this.str_slice(tt, lt2 + 1, tt.size - 1));
                foreach _, part2 in<vector> inner {
                    if this.uses_template_type(part2) { return true; }
                }
            }
        }
        return false;
    }

    // Detect a generic STATIC class method and record the template.
    pub fnc derive_class_method(m FuncDecl, cname string, class_tps vec<string>) : bool {
        has_tpl: bool = false;
        rnames: vec<string> = this.template_names_in(m.ret_type);
        foreach _, tn in<vector> rnames {
            if this.name_in_vec(class_tps, tn) || this.template_types.isin(tn) { has_tpl = true; }
        }
        if !has_tpl {
            foreach _, p in<vector> m.params {
                pnames: vec<string> = this.template_names_in(p.typ);
                foreach _, tn2 in<vector> pnames {
                    if this.name_in_vec(class_tps, tn2) || this.template_types.isin(tn2) { has_tpl = true; }
                }
            }
        }
        if !has_tpl { return false; }

        key: string = cname + "_" + m.name;
        tset: vec<string>;
        foreach _, tn3 in<vector> class_tps { tset.pushb(tn3); }
        foreach _, tn4 in<vector> rnames {
            if !this.name_in_vec(tset, tn4) { tset.pushb(tn4); }
        }
        foreach _, p in<vector> m.params {
            pnames2: vec<string> = this.template_names_in(p.typ);
            foreach _, tn5 in<vector> pnames2 {
                if !this.name_in_vec(tset, tn5) { tset.pushb(tn5); }
            }
        }

        ptypes: vec<string>;
        foreach _, p2 in<vector> m.params { ptypes.pushb(p2.typ); }
        this.generic_funcs.push(key, m);
        this.generic_tparams.push(key, tset);
        this.generic_ptypes.push(key, ptypes);
        this.generic_rtype.push(key, m.ret_type);
        return true;
    }

    pub fnc name_in_vec(v vec<string>, n string) : bool {
        foreach _, x in<vector> v {
            if x == n { return true; }
        }
        return false;
    }

    // If `t` names a generic class instantiation (`Hash<string, int>`),
    // return the template base name, else "".
    pub fnc generic_class_base(t string) : string {
        tt: string = this.strip_imut(t);
        if tt.size < 3 { return ""; }
        if tt[tt.size - 1] != '>' { return ""; }
        bi: int = 0;
        while bi < tt.size {
            if tt[bi] == '<' {
                base: string = this.str_slice(tt, 0, bi);
                if this.generic_classes.isin(base) { return base; }
                return "";
            }
            bi = bi + 1;
        }
        return "";
    }

    // Clone a generic class with concrete type arguments, register it under
    // the mangled name, and stage it for codegen. Instantiations share the
    // template's method bodies: the boxed runtime keeps every vec<T> field
    // at the same layout, so only signatures need substituting.
    pub fnc instantiate_generic_class(base string, targs vec<string>) : string {
        mangled: string = this.mangle_generic(base, targs);
        if this.inst_classes.isin(mangled) { return mangled; }
        this.inst_classes.push(mangled, true);

        tmap: hash<string, string>;
        tps: vec<string> = this.class_tparams[base];
        foreach ti, tp in<vector> tps {
            if ti < targs.size { tmap.push(tp, targs.get(ti)); }
        }

        tmpl: ClassDecl = null;
        foreach _, cd in<vector> this.class_decls {
            if cd.name == base { tmpl = cd; }
        }
        if tmpl == null { return mangled; }

        new_fields: vec<FieldDecl>;
        foreach _, fd in<vector> tmpl.fields {
            new_fields.pushb(FieldDecl.make(fd.name, this.substitute_type_params(fd.typ, tmap), fd.is_pub, fd.is_static, fd.init));
        }
        new_methods: vec<FuncDecl>;
        foreach _, m in<vector> tmpl.methods {
            nmps: vec<FuncParam>;
            foreach _, mp in<vector> m.params {
                nmps.pushb(FuncParam.make(mp.name, this.substitute_type_params(mp.typ, tmap), mp.is_imut, mp.default_val));
            }
            nret: string = this.substitute_type_params(m.ret_type, tmap);
            if nret == base { nret = mangled; }
            nmf: FuncDecl = FuncDecl.make(m.name, nmps, nret, m.body, m.is_static, m.is_pub);
            nmf.is_unsafe = m.is_unsafe;
            nmf.is_nogc = m.is_nogc;
            nmf.is_inline = m.is_inline;
            nmf.is_async = m.is_async;
            new_methods.pushb(nmf);
        }

        no_tps: vec<string>;
        clone: ClassDecl = ClassDecl.make(mangled, "", new_fields, new_methods, no_tps);
        this.inst_class_nodes.pushb(clone);
        // Remember the parameter map as a flat [name, type, name, type...]
        // list: method BODIES keep the placeholder spellings (vec<T>) and
        // codegen resolves them through this.
        tm_flat: vec<string>;
        foreach _, tp in<vector> tmpl.type_params {
            tm_flat.pushb(tp);
            if tmap.isin(tp) { tm_flat.pushb(tmap[tp]); }
        }
        this.inst_tmaps.push(mangled, tm_flat);

        // Register like a normal class (mirrors pass 1)
        ci: ClassInfo = ClassInfo.make(mangled, "");
        foreach _, fd2 in<vector> new_fields {
            if fd2.is_static {
                this.static_fields.push(mangled + "_" + fd2.name, this.resolve_type_alias(fd2.typ));
            } else {
                ci.add_field(fd2.name, this.resolve_type_alias(fd2.typ));
            }
        }
        foreach _, m2 in<vector> new_methods {
            m2_ps: vec<string>;
            foreach _, m2_p in<vector> m2.params { m2_ps.pushb(m2_p.typ); }
            ci.add_method(m2.name, m2.ret_type, m2.is_static, m2_ps);
            this.funcs.push(mangled + "_" + m2.name, m2.ret_type);
            if !m2.is_static {
                found2: bool = false;
                foreach _, mo in<vector> ci.method_order {
                    if mo == m2.name { found2 = true; }
                }
                if !found2 { ci.method_order.pushb(m2.name); }
            }
        }
        this.classes.push(mangled, ci);
        return mangled;
    }

    // Structural pattern match of a (possibly composite) parameter type
    // against a concrete argument type. Returns a flat vec of (name, type)
    // pairs for every template parameter discovered.
    pub fnc match_templates(pattern string, actual string, tparams vec<string>) : vec<string> {
        res: vec<string>;
        pt: string = this.strip_imut(pattern);
        at: string = this.strip_imut(actual);
        if pt.size == 0 || at.size == 0 { return res; }
        is_tp: bool = false;
        foreach _, tp in<vector> tparams {
            if tp == pt { is_tp = true; }
        }
        if is_tp {
            res.pushb(pt);
            res.pushb(at);
            return res;
        }
        if this.is_multi_type(pt) && this.is_multi_type(at) {
            ps: vec<string> = this.parse_multi_type(pt);
            av: vec<string> = this.parse_multi_type(at);
            if ps.size > 0 && ps.size == av.size {
                foreach mi, pp in<vector> ps {
                    sub: vec<string> = this.match_templates(pp, av.get(mi), tparams);
                    foreach _, s2 in<vector> sub { res.pushb(s2); }
                }
            }
            return res;
        }
        if pt.size > 1 && at.size > 1 && (pt[0] == '*' || pt[0] == '&') && (at[0] == '*' || at[0] == '&') {
            return this.match_templates(this.str_slice(pt, 1, pt.size), this.str_slice(at, 1, at.size), tparams);
        }
        // Base<...> containers: recurse when the base names agree
        plt: int = -1;
        pi2: int = 0;
        while pi2 < pt.size {
            if pt[pi2] == '<' { plt = pi2; stop; }
            pi2 = pi2 + 1;
        }
        alt: int = -1;
        ai3: int = 0;
        while ai3 < at.size {
            if at[ai3] == '<' { alt = ai3; stop; }
            ai3 = ai3 + 1;
        }
        if plt > 0 && alt > 0 && pt[pt.size - 1] == '>' && at[at.size - 1] == '>' {
            pbase: string = this.str_slice(pt, 0, plt);
            abase: string = this.str_slice(at, 0, alt);
            if pbase == abase {
                pin: vec<string> = this.split_commas(this.str_slice(pt, plt + 1, pt.size - 1));
                ain: vec<string> = this.split_commas(this.str_slice(at, alt + 1, at.size - 1));
                if pin.size == ain.size {
                    foreach gi, pp2 in<vector> pin {
                        sub2: vec<string> = this.match_templates(pp2, ain.get(gi), tparams);
                        foreach _, s3 in<vector> sub2 { res.pushb(s3); }
                    }
                }
            }
        }
        return res;
    }

    // Base type of a possibly-generic type name: `vec<int>` -> `vec`.
    pub fnc base_of(t string) : string {
        tt: string = this.strip_imut(t);
        if tt.size == 0 { return ""; }
        bi: int = 0;
        while bi < tt.size {
            if tt[bi] == '<' { return this.str_slice(tt, 0, bi); }
            bi = bi + 1;
        }
        return tt;
    }

    // Check if a type name is a template type parameter (T, T1, _T, ...).
    // Mirrors Python _is_type_param. Concrete declared types are never
    // type params.
    pub fnc is_type_param(t string) : bool {
        if t.size == 0 { return false; }
        if this.structs.isin(t) { return false; }
        if this.classes.isin(t) { return false; }
        if this.unions.isin(t) { return false; }
        if this.enums.isin(t) { return false; }
        if this.prog_aliases.isin(t) { return false; }
        if t[0] == '_' { return true; }
        // single uppercase letter (or letter + digit)
        if t.size == 1 && t[0] >= 'A' && t[0] <= 'Z' { return true; }
        if t.size == 2 && t[0] >= 'A' && t[0] <= 'Z' && t[1] >= '0' && t[1] <= '9' { return true; }
        if t.size >= 2 && t[0] == 'T' {
            rest: string = this.str_slice(t, 1, t.size);
            if rest.size <= 2 {
                all_digit: bool = true;
                ri: int = 0;
                while ri < rest.size {
                    if rest[ri] < '0' || rest[ri] > '9' { all_digit = false; }
                    ri = ri + 1;
                }
                if all_digit { return true; }
            }
        }
        return false;
    }

    // Opdef extension-method call argument check (python parity). Two
    // receiver conventions:
    //  - struct targets: the receiver is implicit — call args (after the
    //    receiver) map to the declared params one-to-one.
    //  - builtin-container targets (string/vec/matrix/hash): the receiver
    //    IS the first declared param (e.g. `opdef string.join(a, b)` gets
    //    the receiver as `a`).
    // (The METHOD_CALL -> CALL rewrite makes this self-guarding: a second
    // inference takes the CALL path.)
    pub fnc check_opdef_method_args(fkey string, mname string, sname string, call_args vec<Expr>) : void {
        if !this.func_params.isin(fkey) { return; }
        mps: vec<string> = this.func_params[fkey];
        if this.structs.isin(sname) {
            got_n: int = call_args.size - 1;
            if got_n != mps.size {
                this.errors.pushb("Struct method '" + mname + "' of struct '" + sname + "' expects " + tostring(mps.size) + " argument(s), but got " + tostring(got_n));
                return;
            }
            ai4: int = 0;
            while ai4 < mps.size {
                at4: string = this.infer_expr(call_args.get(ai4 + 1));
                if at4.size > 0 && !this.types_compatible(at4, this.strip_imut(mps[ai4])) {
                    this.errors.pushb("Argument " + tostring(ai4 + 1) + " of struct method '" + mname + "' expects '" + this.strip_imut(mps[ai4]) + "' but got '" + this.disp_type(at4) + "'");
                }
                ai4 = ai4 + 1;
            }
        } else {
            if call_args.size != mps.size {
                this.errors.pushb("Struct method '" + mname + "' of struct '" + sname + "' expects " + tostring(mps.size) + " argument(s), but got " + tostring(call_args.size));
                return;
            }
            bi4: int = 0;
            while bi4 < mps.size {
                bt4: string = this.infer_expr(call_args.get(bi4));
                if bt4.size > 0 && !this.types_compatible(bt4, this.strip_imut(mps[bi4])) {
                    this.errors.pushb("Argument " + tostring(bi4 + 1) + " of struct method '" + mname + "' expects '" + this.strip_imut(mps[bi4]) + "' but got '" + this.disp_type(bt4) + "'");
                }
                bi4 = bi4 + 1;
            }
        }
    }

    // Record that names a and b alias the same object (python _alias_union
    // parity): `p := o` for a class instance makes p and o interchangeable
    // for del-poisoning.
    pub fnc alias_union(a string, b string) : void {
        ia: int = -1;
        if this.alias_map.isin(a) { ia = this.alias_map[a]; }
        ib: int = -1;
        if this.alias_map.isin(b) { ib = this.alias_map[b]; }
        if ia >= 0 && ib >= 0 {
            if ia == ib { return; }
            ga: vec<string> = this.alias_groups[ia];
            gb: vec<string> = this.alias_groups[ib];
            foreach _, n in<vector> gb {
                ga.pushb(n);
                this.alias_map.push(n, ia);
            }
            empty_g: vec<string>;
            this.alias_groups.set(ib, empty_g);
        } else {
            if ia >= 0 {
                ga2: vec<string> = this.alias_groups[ia];
                ga2.pushb(b);
                this.alias_groups.set(ia, ga2);
                this.alias_map.push(b, ia);
            } else {
                if ib >= 0 {
                    gb2: vec<string> = this.alias_groups[ib];
                    gb2.pushb(a);
                    this.alias_groups.set(ib, gb2);
                    this.alias_map.push(a, ib);
                } else {
                    ng: vec<string>;
                    ng.pushb(a);
                    ng.pushb(b);
                    this.alias_groups.pushb(ng);
                    nidx: int = this.alias_groups.size - 1;
                    this.alias_map.push(a, nidx);
                    this.alias_map.push(b, nidx);
                }
            }
        }
    }

    // True if name, or any alias of it, was deleted (python _alias_in).
    pub fnc alias_in(name string) : bool {
        if this.deleted_vars.isin(name) { return true; }
        if this.alias_map.isin(name) {
            g: vec<string> = this.alias_groups[this.alias_map[name]];
            foreach _, n in<vector> g {
                if n != name && this.deleted_vars.isin(n) { return true; }
            }
        }
        return false;
    }

    // Find the union variant whose type matches the value's inferred type
    // (python _find_matching_variant): declaration order wins.
    pub fnc find_union_variant(ut string, val Expr) : string {
        if val == null || !this.unions.isin(ut) { return ""; }
        vt: string = this.strip_imut(this.strip_ref(this.resolve_type_alias(this.infer_expr(val))));
        if vt.size == 0 { return ""; }
        names: vec<string> = this.union_names[ut];
        types: vec<string> = this.union_types[ut];
        i: int = 0;
        while i < names.size {
            ct: string = this.strip_imut(this.strip_ref(this.resolve_type_alias(types.get(i))));
            if this.types_compatible(vt, ct) { return names.get(i); }
            i = i + 1;
        }
        return "";
    }

    // Dotted path of a member chain (`w.u.f` -> "w.u.f"), or "" when the
    // chain is not a plain identifier/field walk.
    pub fnc member_path(e Expr) : string {
        if e == null { return ""; }
        if e.kind == ExprKind.IDENT { return e.sval; }
        if e.kind == ExprKind.MEMBER {
            base: string = this.member_path(e.left);
            if base.size > 0 { return base + "." + e.sval; }
        }
        return "";
    }

    // True if this statement unconditionally ends its path with a return
    // (python _stmt_returns parity): a return, or an if/else where every
    // arm returns.
    pub fnc stmt_returns(s Stmt) : bool {
        if s == null { return false; }
        if s.kind == StmtKind.RETURN { return true; }
        if s.kind == StmtKind.IF {
            if s.else_block.size == 0 { return false; }
            if !this.stmt_list_returns(s.then_block) { return false; }
            return this.stmt_list_returns(s.else_block);
        }
        return false;
    }

    // True if some statement in the list always ends the path with a
    // return (python _stmt_list_returns parity).
    pub fnc stmt_list_returns(stmts vec<Stmt>) : bool {
        foreach _, st in<vector> stmts {
            if this.stmt_returns(st) { return true; }
        }
        return false;
    }

    // True if the expression tree mentions the discard identifier `_`
    // (python parity: the stdlib idiom `_ = _ + 1 - 1;` marks a foreach
    // binding as used and must never trip operator checks).
    pub fnc mentions_discard(e Expr, depth int) : bool {
        if e == null || depth > 32 { return false; }
        if e.kind == ExprKind.IDENT && e.sval == "_" { return true; }
        if e.kind == ExprKind.UNARY { return this.mentions_discard(e.left, depth + 1); }
        if e.kind == ExprKind.BINOP {
            if this.mentions_discard(e.left, depth + 1) { return true; }
            return this.mentions_discard(e.right, depth + 1);
        }
        return false;
    }

    // Word form of an operator, safe for mangled function names.
    pub fnc op_word(op string) : string {
        if op == "+" { return "add"; }
        if op == "-" { return "sub"; }
        if op == "*" { return "mul"; }
        if op == "/" { return "div"; }
        if op == "%" { return "mod"; }
        if op == "==" { return "eq"; }
        if op == "!=" { return "neq"; }
        if op == "<" { return "lt"; }
        if op == ">" { return "gt"; }
        if op == "<=" { return "lte"; }
        if op == ">=" { return "gte"; }
        if op == "&" { return "band"; }
        if op == "|" { return "bor"; }
        if op == "^" { return "bxor"; }
        if op == "<<" { return "shl"; }
        if op == ">>" { return "shr"; }
        if op == "<>" { return "isin"; }
        if op == "[]" { return "idx"; }
        return op;
    }

    // Specialise a generic template for the concrete argument types at this
    // call site. Returns the mangled instance name (no expression rewrite).
    pub fnc instantiate_generic(base string, args vec<Expr>) : string {
        tparams: vec<string> = this.generic_tparams[base];
        ptypes: vec<string> = this.generic_ptypes[base];
        rtype: string = this.generic_rtype[base];
        tmpl: FuncDecl = this.generic_funcs[base];

        tmap: hash<string, string>;
        ai: int = 0;
        while ai < args.size && ai < ptypes.size {
            pairs: vec<string> = this.match_templates(ptypes.get(ai), this.strip_imut(this.infer_expr(args.get(ai))), tparams);
            pi3: int = 0;
            while pi3 + 1 < pairs.size {
                if !tmap.isin(pairs.get(pi3)) {
                    tmap.push(pairs.get(pi3), pairs.get(pi3 + 1));
                }
                pi3 = pi3 + 2;
            }
            ai = ai + 1;
        }

        targs: vec<string>;
        foreach _, tp in<vector> tparams {
            if tmap.isin(tp) { targs.pushb(tmap[tp]); }
            else { targs.pushb(tp); }
        }
        mangled: string = this.mangle_generic(base, targs);
        if this.inst_keys.isin(mangled) { return mangled; }
        this.inst_keys.push(mangled, true);

        // Substitute through the DERIVED param types (`_T_N`), not the raw
        // template params: the multi-type originals are only keys for the
        // derivation, the synthetic names are what tmap is keyed by.
        new_params: vec<FuncParam>;
        nptypes: vec<string>;
        npnames: vec<string>;
        foreach i, p in<vector> tmpl.params {
            nt: string = this.substitute_type_params(ptypes.get(i), tmap);
            new_params.pushb(FuncParam.make(p.name, nt, p.is_imut, p.default_val));
            nptypes.pushb(nt);
            npnames.pushb(p.name);
            if p.default_val != null {
                this.func_defaults.push(mangled + "::" + tostring(i), p.default_val);
            }
        }
        nrt: string = this.substitute_type_params(rtype, tmap);

        nf: FuncDecl = FuncDecl.make(mangled, new_params, nrt, tmpl.body, tmpl.is_static, tmpl.is_pub);
        nf.owner = tmpl.owner;
        nf.is_unsafe = tmpl.is_unsafe;
        nf.is_nogc = tmpl.is_nogc;
        nf.is_inline = tmpl.is_inline;
        nf.is_async = tmpl.is_async;

        this.funcs.push(mangled, nrt);
        this.func_params.push(mangled, nptypes);
        this.func_param_names.push(mangled, npnames);
        this.inst_nodes.pushb(nf);
        return mangled;
    }

    pub fnc handle_generic_call(e Expr) : string {
        m: string = this.instantiate_generic(e.sval, e.args);
        e.sval = m;
        return m;
    }

    // Generic STATIC class method: rewrite the METHOD_CALL into a plain
    // CALL of the mangled instance. Static calls have no instance: the
    // receiver (the class name) is not an argument.
    pub fnc handle_generic_method_call(e Expr) : string {
        gkey: string = e.left.sval + "_" + e.sval;
        gm: string = this.instantiate_generic(gkey, e.args);
        e.kind = ExprKind.CALL;
        e.sval = gm;
        return gm;
    }

    // Type compatibility for assignments/initializers (Python E004 parity).
    // Base numeric category of a type: int/uint/float/char/bool, with
    // sized variants (int<8>, uint<16>, float<32>, ...) reduced to the
    // bare name. Python's _base_type does the same reduction.
    pub fnc is_numeric_base(t string) : bool {
        b: string = this.base_of(this.strip_imut(this.resolve_type_alias(t)));
        if b == "int" { return true; }
        if b == "uint" { return true; }
        if b == "float" { return true; }
        if b == "char" { return true; }
        if b == "bool" { return true; }
        return false;
    }

    pub fnc types_compatible(src string, dst string) : bool {
        if src == dst { return true; }
        if src.size == 0 || dst.size == 0 { return true; }
        if src == "nil" { return true; }
        if dst == "void" { return true; }
        // A union variable accepts any variant-compatible value (the
        // runtime tags it): python's assign path returns early for unions.
        if this.unions.isin(this.strip_imut(dst)) { return true; }
        // A char value assigns into a string (single-char materialization)
        if src == "char" && dst == "string" { return true; }
        // A generic-class value is compatible with its instantiation
        // (python: dst.startswith(src + "_") for mangled clones)
        if this.inst_classes.isin(dst) && dst.size > src.size && this.str_slice(dst, 0, src.size) == src {
            return true;
        }
        // Numeric types (incl. sized variants) are broadly compatible with
        // each other — Python: int/uint/float/char/bool all interassign.
        if this.is_numeric_base(src) && this.is_numeric_base(dst) { return true; }
        // Pointers: *X -> *Y compares the pointee types (Python recursion)
        if src.size > 1 && dst.size > 1 && src[0] == '*' && dst[0] == '*' {
            return this.types_compatible(this.str_slice(src, 1, src.size), this.str_slice(dst, 1, dst.size));
        }
        // string <-> *char
        if src == "string" && dst.size > 1 && dst[0] == '*' { return true; }
        if dst == "string" && src.size > 1 && src[0] == '*' { return true; }
        // arrays: int[N] <-> int[] when the bases match
        if src.size > 2 && src[src.size - 1] == ']' && dst.size > 2 && dst[dst.size - 1] == ']' {
            sbase: string = "";
            sbi: int = 0;
            while sbi < src.size && src[sbi] != '[' {
                sbase = sbase + src[sbi];
                sbi = sbi + 1;
            }
            dbase: string = "";
            dbi: int = 0;
            while dbi < dst.size && dst[dbi] != '[' {
                dbase = dbase + dst[dbi];
                dbi = dbi + 1;
            }
            if sbase == dbase && sbase.size > 0 { return true; }
            // Sized numeric spellings reduce to their bare base
            // (int<64>[10] <-> int[] — python _base_type parity).
            if sbase.size > 0 && this.is_numeric_base(sbase) && this.is_numeric_base(dbase) { return true; }
        }
        // slices: T[] -> vec<T>, *T, T[]
        if src.size > 2 && src[src.size - 1] == ']' {
            base: string = "";
            bi: int = 0;
            while bi < src.size && src[bi] != '[' {
                base = base + src[bi];
                bi = bi + 1;
            }
            if this.is_vec_type2(dst) && this.vec_inner_type2(dst) == base { return true; }
            if dst.size > 7 && dst[0] == 'm' && dst[1] == 'a' && dst[2] == 't' && dst[3] == 'r' && dst[4] == 'i' && dst[5] == 'x' && dst[6] == '<' && dst[dst.size - 1] == '>' {
                if this.str_slice(dst, 7, dst.size - 1) == base { return true; }
            }
            if dst == "*" + base { return true; }
        }
        // class inheritance: a Dog is an Animal (walk the parent chain)
        if this.classes.isin(src) && this.classes.isin(dst) {
            cur: string = src;
            hops: int = 0;
            while hops < 16 {
                if cur == dst { return true; }
                if !this.classes.isin(cur) { return false; }
                par: string = this.classes[cur].parent;
                if par.size == 0 { return false; }
                cur = par;
                hops = hops + 1;
            }
            return false;
        }
        // union assignment: the value must match one of the variants
        if this.unions.isin(dst) {
            utypes: vec<string> = this.union_types[dst];
            foreach _, uvt in<vector> utypes {
                if this.types_compatible(src, uvt) { return true; }
            }
            return false;
        }
        // generic class template -> any of its instantiations
        if this.generic_classes.isin(src) && dst.size > src.size {
            pref_ok: bool = true;
            pi: int = 0;
            while pi < src.size {
                if dst[pi] != src[pi] { pref_ok = false; stop; }
                pi = pi + 1;
            }
            if pref_ok && (dst[src.size] == '_' || dst[src.size] == '<') { return true; }
        }
        return false;
    }

    pub fnc is_int_family(t string) : bool {
        if t == "int" || t == "uint" { return true; }
        return this.is_sized_int_type2(t);
    }

    pub fnc is_float_family(t string) : bool {
        if t == "float" { return true; }
        return t.size > 6 && t[0] == 'f' && t[1] == 'l' && t[2] == 'o' && t[3] == 'a' && t[4] == 't' && t[5] == '<';
    }

    // Known type names (Python E003 parity): unknown types like `int32`
    // are rejected instead of silently compiling to a fallback.
    pub fnc is_known_type(t string) : bool {
        if t.size == 0 { return true; }
        tt: string = this.strip_imut(t);
        tt = this.resolve_type_alias(tt);
        if tt == "int" || tt == "uint" || tt == "float" || tt == "char" || tt == "bool" || tt == "string" || tt == "void" { return true; }
        // FFI conventions: macro-typed constants and pointer<T> spellings
        if tt == "macro" { return true; }
        if tt.size > 9 && tt[0] == 'p' && tt[1] == 'o' && tt[2] == 'i' && tt[3] == 'n' && tt[4] == 't' && tt[5] == 'e' && tt[6] == 'r' && tt[7] == '<' && tt[tt.size - 1] == '>' {
            return true;
        }
        if this.is_sized_int_type2(tt) { return true; }
        if this.is_float_family(tt) && tt.size > 6 { return true; }
        if this.is_vec_type2(tt) { return this.is_known_type(this.vec_inner_type2(tt)); }
        if tt.size > 7 && tt[0] == 'm' && tt[1] == 'a' && tt[2] == 't' && tt[3] == 'r' && tt[4] == 'i' && tt[5] == 'x' && tt[6] == '<' && tt[tt.size - 1] == '>' {
            return this.is_known_type(this.str_slice(tt, 7, tt.size - 1));
        }
        if tt.size > 6 && tt[0] == 'h' && tt[1] == 'a' && tt[2] == 's' && tt[3] == 'h' && tt[4] == '<' && tt[tt.size - 1] == '>' {
            parts: vec<string> = this.split_commas(this.str_slice(tt, 5, tt.size - 1));
            foreach _, part in<vector> parts {
                if !this.is_known_type(part) { return false; }
            }
            return true;
        }
        if tt.size > 1 && (tt[0] == '*' || tt[0] == '&') {
            return this.is_known_type(this.str_slice(tt, 1, tt.size));
        }
        if tt.size > 8 && tt[0] == 'f' && tt[1] == 'u' && tt[2] == 't' && tt[3] == 'u' && tt[4] == 'r' && tt[5] == 'e' && tt[6] == '<' {
            return this.is_known_type(this.str_slice(tt, 7, tt.size - 1));
        }
        if this.is_fnc_type(tt) { return true; }
        if tt == "File" { return true; }
        if this.template_types.isin(tt) { return true; }
        // generic-class instantiation: Hash<string, int> -> known
        if tt.size > 3 && tt[tt.size - 1] == '>' {
            gbase: string = "";
            gi2: int = 0;
            while gi2 < tt.size {
                if tt[gi2] == '<' { gbase = this.str_slice(tt, 0, gi2); stop; }
                gi2 = gi2 + 1;
            }
            if this.generic_classes.isin(gbase) { return true; }
        }
        // array suffixes: T[] and T[N]
        if tt.size > 2 && tt[tt.size - 1] == ']' {
            abase: string = "";
            abi2: int = 0;
            while abi2 < tt.size && tt[abi2] != '[' {
                abase = abase + tt[abi2];
                abi2 = abi2 + 1;
            }
            if abase.size > 0 { return this.is_known_type(abase); }
        }
        if this.structs.isin(tt) || this.classes.isin(tt) || this.enums.isin(tt) || this.unions.isin(tt) { return true; }
        if this.generic_classes.isin(tt) { return true; }
        // tuple types (a, b)
        if tt.size >= 2 && tt[0] == '(' && tt[tt.size - 1] == ')' { return true; }
        return false;
    }

    pub fnc is_sized_int_type2(t string) : bool {
        if t.size < 6 { return false; }
        if t[t.size - 1] != '>' { return false; }
        if t[0] == 'i' && t[1] == 'n' && t[2] == 't' && t[3] == '<' { return true; }
        if t[0] == 'u' && t[1] == 'i' && t[2] == 'n' && t[3] == 't' && t[4] == '<' { return true; }
        return false;
    }

    pub fnc vec_inner_type2(t string) : string {
        if t.size > 4 && t[0] == 'v' && t[1] == 'e' && t[2] == 'c' && t[3] == '<' {
            return this.str_slice(t, 4, t.size - 1);
        }
        return t;
    }

    pub fnc is_vec_type2(t string) : bool {
        if t.size < 6 { return false; }
        return t[t.size - 1] == '>' && t[0] == 'v' && t[1] == 'e' && t[2] == 'c' && t[3] == '<';
    }

    // Resolve a type through the post-import alias table, then apply the
    // width normalization the parser applies for same-file spellings.
    pub fnc resolve_type_alias(t string) : string {
        tt: string = t;
        guard: int = 0;
        while this.prog_aliases.isin(tt) && guard < 8 {
            tt = this.prog_aliases[tt];
            guard = guard + 1;
        }
        if tt == "float<64>" || tt == "float<32>" || tt == "float<16>" || tt == "float<128>" { return "float"; }
        if tt == "int<32>" { return "int"; }
        return tt;
    }

    pub fnc check_program(prog Program) : void {
        empty_al: hash<string, string>;
        this.prog_aliases = empty_al;
        pa_i: int = 0;
        while pa_i + 1 < prog.type_alias_defs.size {
            this.prog_aliases.push(prog.type_alias_defs.get(pa_i), prog.type_alias_defs.get(pa_i + 1));
            pa_i = pa_i + 2;
        }
        // Pass 1: Register structs, classes, enums, globals
        foreach _, s in<vector> prog.structs {
            si: StructInfo = StructInfo.make(s.name);
            foreach _, fd in<vector> s.fields {
                if fd.is_static {
                    this.static_fields.push(s.name + "_" + fd.name, fd.typ);
                } else {
                    si.add_field(fd.name, fd.typ, fd.init != null);
                }
            }
            this.structs.push(s.name, si);
        }

        foreach _, tpl in<vector> prog.templates {
            this.template_types.push(tpl, true);
        }

        foreach _, c in<vector> prog.classes {
            this.class_decls.pushb(c);
            this.class_tparams.push(c.name, c.type_params);
            if c.type_params.size > 0 {
                this.generic_classes.push(c.name, true);
            }
            ci: ClassInfo = ClassInfo.make(c.name, c.parent);
            foreach _, fd in<vector> c.fields {
                if fd.is_static {
                    this.static_fields.push(c.name + "_" + fd.name, fd.typ);
                } else {
                    ci.add_field(fd.name, fd.typ);
                }
            }
            foreach _, m in<vector> c.methods {
                m_ps: vec<string>;
                foreach _, m_p in<vector> m.params { m_ps.pushb(this.resolve_type_alias(m_p.typ)); }
                ci.add_method(m.name, this.resolve_type_alias(m.ret_type), m.is_static, m_ps);
                // Generic static methods (vec<T> params etc.) become
                // templates under the Class_method key; concrete types
                // arrive at the call site.
                if m.is_static && this.derive_class_method(m, c.name, c.type_params) {
                } else {
                    // Also register static methods: Class.method
                    this.funcs.push(c.name + "_" + m.name, m.ret_type);
                }
                // Constructor: record its parameter defaults for autoinit
                if m.name == c.name {
                    ctor_defs: vec<Expr>;
                    foreach _, cp in<vector> m.params {
                        ctor_defs.pushb(cp.default_val);
                    }
                    this.ctor_defaults.push(c.name, ctor_defs);
                }
            }
            this.classes.push(c.name, ci);
        }

        // Inheritance: prepend parent instance fields to each child's layout
        foreach _, c in<vector> prog.classes {
            c_info: ClassInfo = this.classes[c.name];
            if c.parent.size > 0 && this.classes.isin(c.parent) {
                p_info: ClassInfo = this.classes[c.parent];
                nn: vec<string>;
                nt: vec<string>;
                foreach _, pn in<vector> p_info.field_names { nn.pushb(pn); }
                foreach _, pt in<vector> p_info.field_types { nt.pushb(pt); }
                foreach _, cn in<vector> c_info.field_names { nn.pushb(cn); }
                foreach _, ct in<vector> c_info.field_types { nt.pushb(ct); }
                c_info.field_names = nn;
                c_info.field_types = nt;
            }
            // Virtual slot order: parent's non-static slots first, then own new
            if c.parent.size > 0 && this.classes.isin(c.parent) {
                p_ord: vec<string> = this.classes[c.parent].method_order;
                foreach _, pm in<vector> p_ord { c_info.method_order.pushb(pm); }
            }
            foreach _, m in<vector> c.methods {
                if !m.is_static {
                    found: bool = false;
                    foreach _, mo in<vector> c_info.method_order {
                        if mo == m.name { found = true; }
                    }
                    if !found { c_info.method_order.pushb(m.name); }
                }
            }
        }

        foreach _, e in<vector> prog.enums {
            this.enums.push(e.name, true);
            variant_names: vec<string>;
            foreach _, v in<vector> e.variants {
                variant_names.pushb(v.name);
                this.enum_consts.push(e.name + "::" + v.name, v.val);
                if v.has_str { this.enum_str_consts.push(e.name + "::" + v.name, v.str_val); }
                if v.typ.size > 0 { this.enum_member_types.push(e.name + "::" + v.name, v.typ); }
            }
            this.enum_names.push(e.name, variant_names);
            this.enum_counts.push(e.name, variant_names.size);
        }

        foreach _, u in<vector> prog.unions {
            uv_names: vec<string>;
            uv_types: vec<string>;
            foreach _, uv in<vector> u.variants {
                uv_names.pushb(uv.name);
                uv_types.pushb(this.resolve_type_alias(uv.typ));
            }
            this.unions.push(u.name, true);
            this.union_names.push(u.name, uv_names);
            this.union_types.push(u.name, uv_types);
        }

        foreach _, g in<vector> prog.globals {
            this.globals.push(g.name, this.resolve_type_alias(g.typ));
            if g.is_shared { this.shared_globals.push(g.name, true); }
            // Global union active-variant tracking (python lowlevel
            // parity): `gu: U = 5;` fixes the variant for later reads.
            // Only literal-ish initializers are tracked here — funcs are
            // not registered yet at this pass.
            g_ur: string = this.strip_imut(this.resolve_type_alias(g.typ));
            if this.unions.isin(g_ur) && g.init_val != null {
                g_lit: bool = g.init_val.kind == ExprKind.INT || g.init_val.kind == ExprKind.FLOAT
                    || g.init_val.kind == ExprKind.BOOL || g.init_val.kind == ExprKind.STRING
                    || g.init_val.kind == ExprKind.CHAR;
                if !g_lit && g.init_val.kind == ExprKind.UNARY {
                    g_lit = g.init_val.left != null && (g.init_val.left.kind == ExprKind.INT || g.init_val.left.kind == ExprKind.FLOAT);
                }
                if g_lit {
                    gvv: string = this.find_union_variant(g_ur, g.init_val);
                    if gvv.size > 0 {
                        this.global_union_active.push(g.name, gvv);
                        this.global_union_active_ty.push(g.name, g_ur);
                    }
                }
            }
        }

        // Pass 2: Register function signatures
        foreach _, f in<vector> prog.funcs {
            if this.derive_generic_params(f) { continue; }
            // Unknown param/return types (Python M4 parity)
            ret_bare: string = this.strip_imut(f.ret_type);
            if f.ret_type.size > 0 && ret_bare != "void" && !this.is_multi_type(f.ret_type) && !this.is_known_type(ret_bare) {
                this.errors.pushb("Function '" + f.name + "': return type '" + f.ret_type + "' is unknown");
            }
            foreach _, p in<vector> f.params {
                pbare: string = this.strip_imut(p.typ);
                if !this.is_multi_type(p.typ) && !this.is_known_type(pbare) {
                    this.errors.pushb("Function '" + f.name + "': parameter '" + p.name + "' has unknown type '" + p.typ + "'");
                }
            }
            fkey: string = f.name;
            if f.owner.size > 0 { fkey = f.owner + "_" + f.name; }
            f_ret: string = this.resolve_type_alias(f.ret_type);
            if f.is_async { f_ret = "future<" + f.ret_type + ">"; }
            this.funcs.push(fkey, f_ret);
            ptypes: vec<string>;
            pnames: vec<string>;
            pi_i: int = 0;
            foreach _, p in<vector> f.params {
                ptypes.pushb(this.resolve_type_alias(p.typ));
                pnames.pushb(p.name);
                if p.default_val != null {
                    this.func_defaults.push(fkey + "::" + tostring(pi_i), p.default_val);
                }
                pi_i = pi_i + 1;
            }
            this.func_params.push(fkey, ptypes);
            this.func_param_names.push(fkey, pnames);
            if f.is_async { this.async_funcs.push(fkey, true); }
            if f.is_worker { this.worker_funcs.push(fkey, true); }
        }

        // Pass 3: Typecheck function bodies
        foreach _, f in<vector> prog.funcs {
            if this.generic_funcs.isin(f.name) { continue; }
            this.current_func_ret = this.resolve_type_alias(f.ret_type);
            this.in_unsafe_func = f.is_unsafe;
            fkey2: string = f.name;
            if f.owner.size > 0 { fkey2 = f.owner + "_" + f.name; }
            this.current_func_name = fkey2;
            this.enter_scope();

            // Register 'this' for struct-attached functions (`-> Type`):
            // the receiver is the struct instance (python parity — without
            // this, `this.field` inside a struct fnc inferred as int).
            if f.owner.size > 0 && this.structs.isin(f.owner) {
                this.define_var("this", f.owner);
            }
            // Inside an opdef body, `this` is the receiver instance
            // (python current_opdef_type parity).
            if f.opdef_type.size > 0 {
                this.define_var("this", f.opdef_type);
            }

            // Bind parameters; arrays passed without '&' alias the caller's
            // storage and are read-only borrows inside the callee
            rb_clear: vec<string>;
            this.readonly_borrows = rb_clear;
            imut_clear: hash<string, bool>;
            this.imut_vars = imut_clear;
            am_clear: hash<string, int>;
            this.alias_map = am_clear;
            ag_clear: vec<vec<string>>;
            this.alias_groups = ag_clear;
            dv_clear: hash<string, bool>;
            this.deleted_vars = dv_clear;
            ua_clear: hash<string, string>;
            this.union_active = ua_clear;
            uat_clear: hash<string, string>;
            this.union_active_ty = uat_clear;
            foreach _, p in<vector> f.params {
                if p.is_imut { this.imut_vars.push(p.name, true); }
                this.define_var(p.name, this.resolve_type_alias(p.typ));
                // M3: default parameter values must type-check against
                // the declared parameter type (python parity — a bad
                // default used to fall through to codegen as garbage).
                if p.default_val != null {
                    pd_bare: string = this.strip_imut(this.resolve_type_alias(p.typ));
                    if !this.is_type_param(pd_bare) && !this.is_multi_type(p.typ) {
                        pd_t: string = this.infer_expr(p.default_val);
                        if pd_t.size > 0 && pd_t != "nil" && !this.types_compatible(pd_t, pd_bare) {
                            this.errors.pushb("Default value for parameter '" + p.name + "' has type '" + this.disp_type(pd_t) + "', but the parameter is declared '" + p.typ + "'.");
                        }
                    }
                }
                pbt: string = this.strip_imut(p.typ);
                if p.typ.size > 0 && p.typ[0] != '&' && this.is_array_type(pbt)
                   && !(pbt.size > 4 && pbt[0] == 'v' && pbt[1] == 'e' && pbt[2] == 'c' && pbt[3] == '<') {
                    this.readonly_borrows.pushb(p.name);
                }
            }

            // Check statements
            foreach _, stmt in<vector> f.body {
                this.check_statement(stmt);
            }

            // Non-void functions must return on all paths (python parity).
            // External @from declarations have no body — exempt.
            if f.ret_type.size > 0 && !f.is_external {
                fret_bare: string = this.strip_imut(this.resolve_type_alias(f.ret_type));
                if fret_bare != "void" && !this.stmt_list_returns(f.body) {
                    this.errors.pushb("Function '" + f.name + "' might not return a value on all paths.");
                }
            }

            this.exit_scope();
        }

        // Pass 4: Typecheck class method bodies
        foreach _, c in<vector> prog.classes {
            if this.generic_classes.isin(c.name) { continue; }
            foreach _, m in<vector> c.methods {
                this.current_func_ret = this.resolve_type_alias(m.ret_type);
                this.in_unsafe_func = m.is_unsafe;
                this.current_func_name = c.name + "_" + m.name;
                this.enter_scope();
                // Always add 'this', even for static methods — python
                // parity: class-level access (`this.staticField`) inside
                // static methods relies on it.
                this.define_var("this", c.name);
                imut_clear2: hash<string, bool>;
                this.imut_vars = imut_clear2;
                am_clear2: hash<string, int>;
                this.alias_map = am_clear2;
                ag_clear2: vec<vec<string>>;
                this.alias_groups = ag_clear2;
                dv_clear2: hash<string, bool>;
                this.deleted_vars = dv_clear2;
                ua_clear2: hash<string, string>;
                this.union_active = ua_clear2;
                uat_clear2: hash<string, string>;
                this.union_active_ty = uat_clear2;
                foreach _, p in<vector> m.params {
                    if p.is_imut { this.imut_vars.push(p.name, true); }
                    this.define_var(p.name, this.resolve_type_alias(p.typ));
                    // M3 (python parity): default values must match the
                    // declared parameter type — class methods too.
                    if p.default_val != null {
                        md_bare: string = this.strip_imut(this.resolve_type_alias(p.typ));
                        if !this.is_type_param(md_bare) && !this.is_multi_type(p.typ) {
                            md_t: string = this.infer_expr(p.default_val);
                            if md_t.size > 0 && md_t != "nil" && !this.types_compatible(md_t, md_bare) {
                                this.errors.pushb("Default value for parameter '" + p.name + "' has type '" + this.disp_type(md_t) + "', but the parameter is declared '" + p.typ + "'.");
                            }
                        }
                    }
                }
                foreach _, stmt in<vector> m.body {
                    this.check_statement(stmt);
                }
                // Non-void methods must return on all paths (python parity).
                if m.ret_type.size > 0 {
                    mret_bare2: string = this.strip_imut(this.resolve_type_alias(m.ret_type));
                    if mret_bare2 != "void" && !this.stmt_list_returns(m.body) {
                        this.errors.pushb("Function '" + c.name + "_" + m.name + "' might not return a value on all paths.");
                    }
                }
                this.exit_scope();
            }
        }

        // Instantiated generic classes join the program for codegen.
        if this.inst_class_nodes.size > 0 {
            foreach _, ic in<vector> this.inst_class_nodes {
                prog.classes.pushb(ic);
            }
        }

        // Generic templates are never emitted; swap them for the concrete
        // instantiations created while checking their call sites.
        if this.inst_nodes.size > 0 {
            new_funcs: vec<FuncDecl>;
            foreach _, f in<vector> prog.funcs {
                if f.owner.size == 0 && this.generic_funcs.isin(f.name) {
                    // top-level generic template: never emitted
                } else {
                    new_funcs.pushb(f);
                }
            }
            foreach _, nf in<vector> this.inst_nodes {
                new_funcs.pushb(nf);
            }
            prog.funcs = new_funcs;
        }

    }
}
