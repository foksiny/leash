use tokens::*;
use ast::*;
use typechecker::*;

pub def CodeGen : class {
    pub debug_instrument: bool;   // `leash dbg`: emit __leash_dbg_stmt hooks
    pub is_lib: bool;   // to-dynamic/to-static: omit the @main wrapper (a
                        // library with its own main cannot link its consumer)
    pub autofree: bool;   // --autofree: track heap allocations per function
                          // and free them at function exit (no GC)
    pub has_entry: bool;  // an entry point exists (top-level or class
                          // static main): executables require one, libraries
                          // must not gain one
    pub fusion_globals: hash<string, bool>;   // `fusion` globals: atomic
                                              // loads/stores (seq_cst)

    // Atomic access width for a fusion global, or 0 when plain access
    // applies (non-integers, sub-byte widths like bool, or widths the
    // LLVM atomic instructions cannot express). Mirrors the reference:
    // integer type, width >= 8, byte-multiple.
    pub fnc fusion_int_width(name string) : int {
        if !this.fusion_globals.isin(name) { return 0; }
        if !this.global_vars.isin(name) { return 0; }
        lty: string = this.llvm_type(this.global_vars[name]);
        if !this.is_int_lty(lty) { return 0; }
        w: int = this.lty_width(lty);
        if w < 8 { return 0; }
        if w % 8 != 0 { return 0; }
        return w;
    }

    pub fnc fusion_align(lty string) : int {
        w: int = this.lty_width(lty);
        b: int = (w + 7) / 8;
        if b >= 16 { return 16; }
        if b >= 8 { return 8; }
        if b >= 4 { return 4; }
        if b >= 2 { return 2; }
        return 1;
    }
    pub af_arr: string;   // tracking array alloca reg ("" when inactive)
    pub af_cnt: string;   // tracking counter alloca reg
    pub af_emitted: bool;   // cleanup already emitted for this function
    pub opdef_inner: string;     // concrete inner type of the opdef container being compiled
    pub cur_tmap_names: vec<string>;   // instantiated-class params (flat name,type pairs)
    pub lines: vec<string>;
    pub str_constants: vec<string>;
    pub str_pool: hash<string, string>;
    pub str_counter: int;
    pub reg_counter: int;
    pub label_counter: int;
    pub current_block_terminated: bool;
    pub loop_head_stack: vec<string>;
    pub loop_exit_stack: vec<string>;
    pub var_ptrs: hash<string, string>;
    pub var_types: hash<string, string>;
    pub tc: TypeChecker;
    pub current_func_ret: string;
    pub current_func_name: string;
    pub global_vars: hash<string, string>;
    pub main_file: string;
    pub defer_stack: vec<Stmt>;
    pub struct_field_inits: hash<string, vec<Expr>>;
    pub class_field_inits: hash<string, vec<Expr>>;
    pub current_class_name: string;
    pub current_class_parent: string;
    pub method_sigs: hash<string, string>;
    pub cur_func_unsafe: bool;

    static pub fnc make(tc TypeChecker) : CodeGen {
        cg: CodeGen = CodeGen {
            str_counter: 0,
            reg_counter: 1,
            label_counter: 1,
            current_block_terminated: false,
            tc: tc,
            current_func_ret: "void",
            cur_func_unsafe: false,
            // Uninitialized fields are GARBAGE under the stage1 backend
            // (allocations are not zeroed) — every field read before its
            // first write must be zeroed here.
            debug_instrument: false,
            is_lib: false,
            autofree: false,
            has_entry: false,
            af_arr: "",
            af_cnt: "",
            af_emitted: false,
            opdef_inner: "",
            main_file: "",
            current_func_name: "",
            current_class_name: "",
            current_class_parent: ""
        };
        return cg;
    }

    pub fnc emit(line string) : void {
        this.lines.pushb(line);
    }

    // Plain `int`/`uint` are 32-bit (Python reference semantics). These
    // convert at the boundaries with the 64-bit runtime ABI.
    pub fnc rt_i64_to_i32(val string) : string {
        r: string = this.new_reg();
        this.emit("  " + r + " = trunc i64 " + val + " to i32");
        return r;
    }

    pub fnc is_wide_int_lit(e Expr) : bool {
        if e == null || e.kind != ExprKind.INT { return false; }
        if e.ival > 2147483647 { return true; }
        if e.ival < -2147483648 { return true; }
        return false;
    }

    // Widen a 32-bit int register for a 64-bit runtime slot. Wide decimal
    // literals are already emitted at their widened width — pass through.
    pub fnc i32_to_rt_i64(e Expr, val string) : string {
        if this.is_wide_int_lit(e) { return val; }
        // The register may already be 64-bit (int<64> loads) or narrower
        // (char) — widen through the value's own width.
        elty: string = this.llvm_type(this.get_expr_type(e));
        if elty == "i64" { return val; }
        r: string = this.new_reg();
        if elty == "i32" || elty.size == 0 {
            this.emit("  " + r + " = sext i32 " + val + " to i64");
            return r;
        }
        this.emit("  " + r + " = sext " + elty + " " + val + " to i64");
        return r;
    }

    // --- autofree: per-function allocation tracking ---------------------
    // The array + counter live in the entry block (dominating all uses).
    // Every tracked heap pointer is freed at function exit by a countdown
    // loop (no PHI / predecessor label needed). Emission mirrors the
    // reference: first exit wins, later exits keep their temporaries.
    pub fnc af_init() : void {
        if !this.autofree { return; }
        arr: string = this.new_reg();
        this.emit("  " + arr + " = alloca [1024 x i8*], align 8");
        this.emit("  store [1024 x i8*] zeroinitializer, [1024 x i8*]* " + arr + ", align 8");
        cnt: string = this.new_reg();
        this.emit("  " + cnt + " = alloca i64, align 8");
        this.emit("  store i64 0, i64* " + cnt + ", align 8");
        this.af_arr = arr;
        this.af_cnt = cnt;
        this.af_emitted = false;
    }

    pub fnc af_reset() : void {
        this.af_arr = "";
        this.af_cnt = "";
        this.af_emitted = false;
    }

    // Record a fresh heap pointer (registers only — constants and globals
    // must never be freed). Beyond 1024 entries the excess is silently
    // dropped (leaked), mirroring the reference.
    pub fnc af_track(val string) : void {
        if !this.autofree { return; }
        if this.af_arr.size == 0 { return; }
        if val.size == 0 || val[0] != '%' { return; }
        t_do: string = this.new_label("af_track_do");
        t_skip: string = this.new_label("af_track_skip");
        c: string = this.new_reg();
        this.emit("  " + c + " = load i64, i64* " + this.af_cnt + ", align 8");
        ok: string = this.new_reg();
        this.emit("  " + ok + " = icmp ult i64 " + c + ", 1024");
        this.emit("  br i1 " + ok + ", label %" + t_do + ", label %" + t_skip);
        this.emit(t_do + ":");
        slot: string = this.new_reg();
        this.emit("  " + slot + " = getelementptr inbounds [1024 x i8*], [1024 x i8*]* " + this.af_arr + ", i32 0, i64 " + c);
        this.emit("  store i8* " + val + ", i8** " + slot + ", align 8");
        nxt: string = this.new_reg();
        this.emit("  " + nxt + " = add i64 " + c + ", 1");
        this.emit("  store i64 " + nxt + ", i64* " + this.af_cnt + ", align 8");
        this.emit("  br label %" + t_skip);
        this.emit(t_skip + ":");
    }

    // Emit the scope-exit free loop (once per function). `spared` is the
    // i8* register of the value being returned ("" when there is
    // nothing to keep): it is excluded from freeing so the caller
    // receives live memory — python's `_mark_as_return_value` intent.
    pub fnc af_cleanup(spared string) : void {
        if !this.autofree { return; }
        if this.af_arr.size == 0 { return; }
        if this.af_emitted { return; }
        this.af_emitted = true;
        l_loop: string = this.new_label("af_loop");
        l_body: string = this.new_label("af_body");
        l_free: string = this.new_label("af_free");
        l_exit: string = this.new_label("af_exit");
        this.emit("  br label %" + l_loop);
        this.emit(l_loop + ":");
        c: string = this.new_reg();
        this.emit("  " + c + " = load i64, i64* " + this.af_cnt + ", align 8");
        done: string = this.new_reg();
        this.emit("  " + done + " = icmp eq i64 " + c + ", 0");
        this.emit("  br i1 " + done + ", label %" + l_exit + ", label %" + l_body);
        this.emit(l_body + ":");
        prev: string = this.new_reg();
        this.emit("  " + prev + " = sub i64 " + c + ", 1");
        this.emit("  store i64 " + prev + ", i64* " + this.af_cnt + ", align 8");
        slot: string = this.new_reg();
        this.emit("  " + slot + " = getelementptr inbounds [1024 x i8*], [1024 x i8*]* " + this.af_arr + ", i32 0, i64 " + prev);
        ptr: string = this.new_reg();
        this.emit("  " + ptr + " = load i8*, i8** " + slot + ", align 8");
        keep: string = this.new_reg();
        if spared.size > 0 {
            this.emit("  " + keep + " = icmp eq i8* " + ptr + ", " + spared);
        } else {
            this.emit("  " + keep + " = icmp eq i8* " + ptr + ", null");
        }
        this.emit("  br i1 " + keep + ", label %" + l_loop + ", label %" + l_free);
        this.emit(l_free + ":");
        this.emit("  call void @free(i8* " + ptr + ")");
        this.emit("  br label %" + l_loop);
        this.emit(l_exit + ":");
    }

    // i8* view of a returned pointer value for the cleanup skip test
    // ("" for non-pointers — nothing to keep alive).
    pub fnc af_skip_reg(val string, lret string) : string {
        if lret.size == 0 { return ""; }
        if lret[lret.size - 1] != '*' { return ""; }
        if lret == "i8*" { return val; }
        r: string = this.new_reg();
        this.emit("  " + r + " = bitcast " + lret + " " + val + " to i8*");
        return r;
    }

    // Coerce a value register to the slot's llvm type at store/param/return
    // boundaries: the value's width comes from its leash type; plain int
    // arithmetic produces i32, runtime values arrive i64, char-sized slots
    // want i8. Integer literals embed at any width (small ones) — out-of-
    // range literals are wrapped like a C narrowing conversion.
    pub fnc coerce_store_val(e Expr, val string, lty string) : string {
        if e == null { return val; }

        if e.kind == ExprKind.INT || e.kind == ExprKind.FLOAT || e.kind == ExprKind.BOOL || e.kind == ExprKind.NIL {
            // Literal: wrap when the target is narrower than the value.
            // Widths above 64 bits embed the literal text unchanged — the
            // int<64> modulus overflows to zero there and `% 0` would trap.
            if e.kind == ExprKind.INT && this.is_int_lty(lty) && lty != "i64" && this.lty_width(lty) < 64 {
                w: int = this.lty_width(lty);
                mod_v: int<64> = 1;
                mi: int = 0;
                while mi < w { mod_v = mod_v * 2; mi = mi + 1; }
                v64: int<64> = e.ival;
                v64 = v64 % mod_v;
                if v64 < 0 { v64 = v64 + mod_v; }
                return tostring(v64);
            }
            return val;
        }
        // Tuple element extracts (multi-return) already land at the target
        // width — __tupget has no coercible leash type.
        if e.kind == ExprKind.CALL && e.sval == "__tupget" { return val; }
        vt: string = this.get_expr_type(e);
        vlty: string = this.llvm_type(vt);
        if vlty == lty { return val; }
        // char value into a string slot: materialize a 1-char string
        if vt == "char" && lty == "i8*" {
            m_r: string = this.new_reg();
            this.emit("  " + m_r + " = call i8* @leash_gc_malloc(i64 2)");
            this.emit("  store i8 " + val + ", i8* " + m_r);
            z_r: string = this.new_reg();
            this.emit("  " + z_r + " = getelementptr inbounds i8, i8* " + m_r + ", i64 1");
            this.emit("  store i8 0, i8* " + z_r);
            return m_r;
        }
        if this.is_int_lty(vlty) && this.is_int_lty(lty) {
            r: string = this.new_reg();
            if this.lty_width(vlty) > this.lty_width(lty) {
                this.emit("  " + r + " = trunc " + vlty + " " + val + " to " + lty);
            } also this.lty_width(lty) > this.lty_width(vlty) {
                if this.is_uint_type(vt) {
                    this.emit("  " + r + " = zext " + vlty + " " + val + " to " + lty);
                } else {
                    this.emit("  " + r + " = sext " + vlty + " " + val + " to " + lty);
                }
            } else {
                return val;
            }
            return r;
        }
        return val;
    }

    pub fnc new_reg() : string {
        r: string = "%r" + tostring(this.reg_counter);
        this.reg_counter = this.reg_counter + 1;
        return r;
    }

    pub fnc new_label(prefix string) : string {
        l: string = prefix + "_" + tostring(this.label_counter);
        this.label_counter = this.label_counter + 1;
        return l;
    }

    // Coerce a value to i1 the way Python's _cast_bool does: bool is
    // already i1, pointers/objects compare against null, floats use an
    // unordered compare (NaN counts as true), integers compare against 0.
    pub fnc to_bool_val(v string, typ string) : string {
        if typ == "bool" { return v; }
        if typ == "float" {
            r: string = this.new_reg();
            this.emit("  " + r + " = fcmp une double " + v + ", 0.0");
            return r;
        }
        if typ == "char" {
            r: string = this.new_reg();
            this.emit("  " + r + " = icmp ne i8 " + v + ", 0");
            return r;
        }
        if typ == "string" || this.is_vec_type(typ) || typ == "fnc" || (typ.size >= 3 && typ[0] == 'f' && typ[1] == 'n' && typ[2] == 'c') {
            r: string = this.new_reg();
            this.emit("  " + r + " = icmp ne i8* " + v + ", null");
            return r;
        }
        if typ.size > 1 && typ[0] == '*' {
            r: string = this.new_reg();
            this.emit("  " + r + " = icmp ne " + this.llvm_type(typ) + " " + v + ", null");
            return r;
        }
        r: string = this.new_reg();
        this.emit("  " + r + " = icmp ne i64 " + v + ", 0");
        return r;
    }

    pub fnc get_str_constant(s string) : string {
        if this.str_pool.isin(s) {
            return this.str_pool[s];
        }

        name: string = "@.str." + tostring(this.str_counter);
        this.str_counter = this.str_counter + 1;

        // Escape string for LLVM IR:
        // LLVM uses \xx for hex escapes
        escaped: string = "";
        byte_len: int = 1; // null terminator
        foreach _, c in<string> s {
            if c == '\\' { escaped = escaped + "\\5C"; }
            also c == '"' { escaped = escaped + "\\22"; }
            also c == '\n' { escaped = escaped + "\\0A"; }
            also c == '\t' { escaped = escaped + "\\09"; }
            also c == '\r' { escaped = escaped + "\\0D"; }
            else { escaped = escaped + c; }
            byte_len = byte_len + 1;
        }
        escaped = escaped + "\\00";

        decl: string = name + " = private unnamed_addr constant [" + tostring(byte_len) + " x i8] c\"" + escaped + "\", align 1";
        this.str_constants.pushb(decl);
        this.str_pool.push(s, name);

        return name;
    }

    pub fnc get_str_len(s string) : int {
        return s.size + 1;
    }

    pub fnc is_vec_type(typ string) : bool {
        if typ.size > 4 && typ[0] == 'v' && typ[1] == 'e' && typ[2] == 'c' && typ[3] == '<' { return true; }
        if typ.size > 7 && typ[0] == 'm' && typ[1] == 'a' && typ[2] == 't' && typ[3] == 'r'
           && typ[4] == 'i' && typ[5] == 'x' && typ[6] == '<' { return true; }
        return false;
    }

    pub fnc box_inner_start(typ string) : int {
        if typ.size > 7 && typ[0] == 'm' { return 7; }
        return 4;
    }

    pub fnc is_hash_type(typ string) : bool {
        return typ.size > 5 && typ[0] == 'h' && typ[1] == 'a' && typ[2] == 's' && typ[3] == 'h' && typ[4] == '<';
    }

    // --- Inline vector access ------------------------------------------------
    // LeashVec layout in IR: data ptr, size, cap, elem_size, scan.
    // (Braces are kept out of string literals: "{ a, b }" would be parsed
    // as a string interpolation.)
    pub fnc vec_hdr_ty() : string {
        return "{ " + "i8*, i64, i64, i64, i64" + " }";
    }

    pub fnc vec_field(handle string, idx int) : string {
        vh: string = this.new_reg();
        this.emit("  " + vh + " = bitcast i8* " + handle + " to " + this.vec_hdr_ty() + "*");
        vf: string = this.new_reg();
        this.emit("  " + vf + " = getelementptr inbounds " + this.vec_hdr_ty() + ", " + this.vec_hdr_ty() + "* " + vh + ", i32 0, i32 " + tostring(idx));
        vv: string = this.new_reg();
        if idx == 0 {
            this.emit("  " + vv + " = load i8*, i8** " + vf);
        } else {
            this.emit("  " + vv + " = load i64, i64* " + vf);
        }
        return vv;
    }

    pub fnc vec_store_size(handle string, val string) : void {
        vh2: string = this.new_reg();
        this.emit("  " + vh2 + " = bitcast i8* " + handle + " to " + this.vec_hdr_ty() + "*");
        vf2: string = this.new_reg();
        this.emit("  " + vf2 + " = getelementptr inbounds " + this.vec_hdr_ty() + ", " + this.vec_hdr_ty() + "* " + vh2 + ", i32 0, i32 1");
        this.emit("  store i64 " + val + ", i64* " + vf2);
    }

    // Negative indices wrap; out-of-range aborts with `msg` (Python parity).
    // Leaves the current block unterminated at the merge point.
    pub fnc vec_check_index(idx string, size string, msg string) : string {
        vneg: string = this.new_reg();
        this.emit("  " + vneg + " = icmp slt i64 " + idx + ", 0");
        vwrap: string = this.new_reg();
        this.emit("  " + vwrap + " = add i64 " + idx + ", " + size);
        vsel: string = this.new_reg();
        this.emit("  " + vsel + " = select i1 " + vneg + ", i64 " + vwrap + ", i64 " + idx);
        vok1: string = this.new_reg();
        this.emit("  " + vok1 + " = icmp sge i64 " + vsel + ", 0");
        vok2: string = this.new_reg();
        this.emit("  " + vok2 + " = icmp ult i64 " + vsel + ", " + size);
        vokr: string = this.new_reg();
        this.emit("  " + vokr + " = and i1 " + vok1 + ", " + vok2);
        vbad: string = this.new_label("b_vob");
        vgood: string = this.new_label("b_vok");
        this.emit("  br i1 " + vokr + ", label %" + vgood + ", label %" + vbad);
        this.emit(vbad + ":");
        vep: string = this.const_str_of(msg);
        this.emit("  call i32 (i8*, ...) @printf(i8* " + vep + ")");
        this.emit("  call void @exit(i64 1)");
        this.emit("  unreachable");
        this.emit(vgood + ":");
        this.current_block_terminated = false;
        return vsel;
    }

    // The shared 64-byte staging buffer (avoids per-op allocas in loops).
    pub fnc scratch_i8p() : string {
        r: string = this.new_reg();
        this.emit("  " + r + " = bitcast [64 x i8]* @__lsh_scratch to i8*");
        return r;
    }

    // Byte size of one vec element for the runtime layout (pointer-typed
    // elements are stored as 8-byte references).
    pub fnc vec_elem_bytes(inner string) : int {
        lty: string = this.llvm_type(inner);
        if lty.size > 1 && lty[lty.size - 1] == '*' { return 8; }
        esz: int = this.llvm_val_bytes(lty);
        if esz < 1 { return 8; }
        return esz;
    }

    // True when elements may contain GC pointers (the data buffer must be
    // scannable). Over-approximation is safe; primitives are exact.
    pub fnc vec_elem_scan(inner string) : bool {
        if inner == "int" || inner == "float" || inner == "char" || inner == "bool" { return false; }
        if this.is_sized_int_type(inner) { return false; }
        return true;
    }

    pub fnc vec_inner_type(typ string) : string {
        st: int = this.box_inner_start(typ);
        if typ.size <= st + 1 { return "int"; }
        inner: string = "";
        i: int = st;
        while i < typ.size - 1 {
            inner = inner + typ[i];
            i = i + 1;
        }
        // Opdef bodies keep the container placeholder in their local
        // declarations; the concrete inner type comes from the (already
        // substituted) parameters.
        if (inner == "__T_OPDEF__" || inner == "thisop.typ") && this.opdef_inner.size > 0 {
            return this.opdef_inner;
        }
        ti3: int = 0;
        while ti3 + 1 < this.cur_tmap_names.size {
            nm3: string = this.cur_tmap_names.get(ti3);
            if nm3 == inner {
                return this.cur_tmap_names.get(ti3 + 1);
            }
            ti3 = ti3 + 2;
        }
        return inner;
    }

    pub fnc hash_val_type(typ string) : string {
        if typ.size <= 7 { return "int"; }
        depth: int = 0;
        i: int = 5;
        while i < typ.size {
            c: char = typ[i];
            if c == '<' { depth = depth + 1; }
            also c == '>' { depth = depth - 1; }
            also c == ',' && depth == 0 {
                i = i + 1;
                while i < typ.size && typ[i] == ' ' { i = i + 1; }
                val_t: string = "";
                while i < typ.size - 1 {
                    val_t = val_t + typ[i];
                    i = i + 1;
                }
                return val_t;
            }
            i = i + 1;
        }
        return "int";
    }

    // hash<K,V> key type
    pub fnc hash_key_type(typ string) : string {
        if typ.size <= 7 { return "int"; }
        depth: int = 1;
        i: int = 5;
        key_t: string = "";
        while i < typ.size {
            c: char = typ[i];
            if c == '<' { depth = depth + 1; }
            also c == '>' { depth = depth - 1; }
            also c == ',' && depth == 1 {
                return key_t;
            }
            key_t = key_t + c;
            i = i + 1;
        }
        return "int";
    }

    // The runtime hash is string-keyed: coerce a key of any scalar type to
    // its i8* string form (strings pass through untouched).
    pub fnc hash_key_arg(key_val string, key_t string) : string {
        klty: string = this.llvm_type(key_t);
        if klty == "i8*" { return key_val; }
        if klty == "double" {
            fw: string = this.new_reg();
            this.emit("  " + fw + " = call i8* @leash_sh_float_key(double " + key_val + ")");
            return fw;
        }
        kw: string = this.new_reg();
        if klty == "i64" {
            if this.is_uint_type(key_t) {
                this.emit("  " + kw + " = call i8* @leash_sh_uint_key(i64 " + key_val + ")");
            } else {
                this.emit("  " + kw + " = call i8* @leash_sh_int_key(i64 " + key_val + ")");
            }
            return kw;
        }
        // i32 / i16 / i8 / i1 / char: widen to i64 first
        wide: string = this.new_reg();
        if this.is_uint_type(key_t) || key_t == "bool" {
            this.emit("  " + wide + " = zext " + klty + " " + key_val + " to i64");
        } else {
            this.emit("  " + wide + " = sext " + klty + " " + key_val + " to i64");
        }
        this.emit("  " + kw + " = call i8* @leash_sh_int_key(i64 " + wide + ")");
        return kw;
    }

    // Build a LeashVec { data, size, cap } (i8*) from a slice value { len, T* }
    // Build a vec from a {len, ptr} slice. `elem_t` is the target element
    // type (the vec's declared inner type) — the layout authority. When the
    // slice's own element width differs (e.g. int literals feeding a
    // vec<uint<2>>), elements are copied across one by one.
    // `track` is false when the fresh header is stored into a heap
    // object field (struct/class): the object owns it, so the
    // function-exit sweep must not free it (else use-after-free).
    pub fnc slice_to_vec(val string, slice_typ string, elem_t string, track bool) : string {
        lty: string = this.llvm_type(slice_typ);
        dreg: string = this.new_reg();
        this.emit("  " + dreg + " = extractvalue " + lty + " " + val + ", 1");
        nreg: string = this.new_reg();
        this.emit("  " + nreg + " = extractvalue " + lty + " " + val + ", 0");
        base: string = "";
        bi: int = 0;
        while bi < slice_typ.size && slice_typ[bi] != '[' {
            base = base + slice_typ[bi];
            bi = bi + 1;
        }
        dptr: string = this.new_reg();
        this.emit("  " + dptr + " = bitcast " + this.llvm_type(base) + "* " + dreg + " to i8*");
        vez: int = this.vec_elem_bytes(elem_t);
        vsc: int = 0;
        if this.vec_elem_scan(elem_t) { vsc = 1; }
        src_esz: int = this.vec_elem_bytes(base);
        if src_esz != vez {
            vconv: string = this.new_reg();
            this.emit("  " + vconv + " = call i8* @leash_sh_vec_new(i64 " + tostring(vez) + ", i64 " + tostring(vsc) + ")");
            if track { this.af_track(vconv); }
            this.emit("  call void @leash_sh_vec_extend(i8* " + vconv + ", i8* " + dptr + ", i64 " + nreg + ", i64 " + tostring(src_esz) + ")");
            return vconv;
        }
        vreg: string = this.new_reg();
        this.emit("  " + vreg + " = call i8* @leash_sh_vec_from_parts(i8* " + dptr + ", i64 " + nreg + ", i64 " + tostring(vez) + ", i64 " + tostring(vsc) + ")");
        if track { this.af_track(vreg); }
        return vreg;
    }

    pub fnc is_slice_like(typ string) : bool {
        return typ.size > 2 && typ[typ.size - 1] == ']';
    }

    // Element-wise slice conversion for fixed-array / slice stores whose
    // element widths differ (e.g. `int<64>[3]` initialized from an `int[]`
    // literal): without it the narrow backing store is read at the wide
    // stride, producing packed garbage and out-of-bounds reads. Same-width
    // stores return the value unchanged. Mirrors the scalar table in
    // coerce_store_val (trunc/sext/zext, sitofp/uitofp, fptosi/fptoui,
    // fpext/fptrunc); pointer elements are adopted as-is.
    pub fnc adapt_slice(val string, from_t string, to_t string) : string {
        if !this.is_slice_like(from_t) { return val; }
        if !this.is_slice_like(to_t) { return val; }
        from_base: string = this.slice_base_type(from_t);
        to_base: string = this.slice_base_type(to_t);
        from_lty: string = this.llvm_type(from_t);
        to_lty: string = this.llvm_type(to_t);
        if from_lty == to_lty { return val; }
        from_e: string = this.llvm_type(from_base);
        to_e: string = this.llvm_type(to_base);
        if from_e == to_e { return val; }
        // Pointer elements (strings, objects): adopt the buffer directly.
        if this.is_ptr_lty(from_e) || this.is_ptr_lty(to_e) {
            if from_e != to_e { return val; }
            len0: string = this.new_reg();
            this.emit("  " + len0 + " = extractvalue " + from_lty + " " + val + ", 0");
            ptr0: string = this.new_reg();
            this.emit("  " + ptr0 + " = extractvalue " + from_lty + " " + val + ", 1");
            ptr0c: string = this.new_reg();
            this.emit("  " + ptr0c + " = bitcast " + from_e + " " + ptr0 + " to " + to_e);
            ad0: string = this.new_reg();
            this.emit("  " + ad0 + " = insertvalue " + to_lty + " undef, i64 " + len0 + ", 0");
            ad1: string = this.new_reg();
            this.emit("  " + ad1 + " = insertvalue " + to_lty + " " + ad0 + ", " + to_e + " " + ptr0c + ", 1");
            return ad1;
        }
        len: string = this.new_reg();
        this.emit("  " + len + " = extractvalue " + from_lty + " " + val + ", 0");
        src: string = this.new_reg();
        this.emit("  " + src + " = extractvalue " + from_lty + " " + val + ", 1");
        dst_esz: int = this.vec_elem_bytes(to_base);
        total: string = this.new_reg();
        this.emit("  " + total + " = mul i64 " + len + ", " + tostring(dst_esz));
        lit_flags: int = 0;
        if !this.vec_elem_scan(to_base) { lit_flags = 2; }
        raw: string = this.new_reg();
        this.emit("  " + raw + " = call i8* @leash_gc_malloc_ex(i64 " + total + ", i32 " + tostring(lit_flags) + ")");
        dst: string = this.new_reg();
        this.emit("  " + dst + " = bitcast i8* " + raw + " to " + to_e + "*");
        l_cond: string = this.new_label("ad_cond");
        l_body: string = this.new_label("ad_body");
        l_end: string = this.new_label("ad_end");
        idx: string = this.new_reg();
        this.emit("  " + idx + " = alloca i64, align 8");
        this.emit("  store i64 0, i64* " + idx + ", align 8");
        this.emit("  br label %" + l_cond);
        this.emit(l_cond + ":");
        cur: string = this.new_reg();
        this.emit("  " + cur + " = load i64, i64* " + idx + ", align 8");
        more: string = this.new_reg();
        this.emit("  " + more + " = icmp ult i64 " + cur + ", " + len);
        this.emit("  br i1 " + more + ", label %" + l_body + ", label %" + l_end);
        this.emit(l_body + ":");
        sgep: string = this.new_reg();
        this.emit("  " + sgep + " = getelementptr inbounds " + from_e + ", " + from_e + "* " + src + ", i64 " + cur);
        ev: string = this.new_reg();
        this.emit("  " + ev + " = load " + from_e + ", " + from_e + "* " + sgep);
        cv: string = this.new_reg();
        if this.is_int_lty(from_e) && this.is_int_lty(to_e) {
            if this.lty_width(from_e) > this.lty_width(to_e) {
                this.emit("  " + cv + " = trunc " + from_e + " " + ev + " to " + to_e);
            } also this.lty_width(to_e) > this.lty_width(from_e) {
                if this.is_uint_type(from_base) {
                    this.emit("  " + cv + " = zext " + from_e + " " + ev + " to " + to_e);
                } else {
                    this.emit("  " + cv + " = sext " + from_e + " " + ev + " to " + to_e);
                }
            } else {
                this.emit("  " + cv + " = bitcast " + from_e + " " + ev + " to " + to_e);
            }
        } also this.is_int_lty(from_e) && this.is_float_lty(to_e) {
            if this.is_uint_type(from_base) {
                this.emit("  " + cv + " = uitofp " + from_e + " " + ev + " to " + to_e);
            } else {
                this.emit("  " + cv + " = sitofp " + from_e + " " + ev + " to " + to_e);
            }
        } also this.is_float_lty(from_e) && this.is_int_lty(to_e) {
            if this.is_uint_type(to_base) {
                this.emit("  " + cv + " = fptoui " + from_e + " " + ev + " to " + to_e);
            } else {
                this.emit("  " + cv + " = fptosi " + from_e + " " + ev + " to " + to_e);
            }
        } also this.is_float_lty(from_e) && this.is_float_lty(to_e) {
            if this.lty_bytes(from_e) > this.lty_bytes(to_e) {
                this.emit("  " + cv + " = fptrunc " + from_e + " " + ev + " to " + to_e);
            } else {
                this.emit("  " + cv + " = fpext " + from_e + " " + ev + " to " + to_e);
            }
        } else {
            this.emit("  " + cv + " = bitcast " + from_e + " " + ev + " to " + to_e);
        }
        dgep: string = this.new_reg();
        this.emit("  " + dgep + " = getelementptr inbounds " + to_e + ", " + to_e + "* " + dst + ", i64 " + cur);
        this.emit("  store " + to_e + " " + cv + ", " + to_e + "* " + dgep);
        nxt: string = this.new_reg();
        this.emit("  " + nxt + " = add i64 " + cur + ", 1");
        this.emit("  store i64 " + nxt + ", i64* " + idx + ", align 8");
        this.emit("  br label %" + l_cond);
        this.emit(l_end + ":");
        s0: string = this.new_reg();
        this.emit("  " + s0 + " = insertvalue " + to_lty + " undef, i64 " + len + ", 0");
        s1: string = this.new_reg();
        this.emit("  " + s1 + " = insertvalue " + to_lty + " " + s0 + ", " + to_e + "* " + dst + ", 1");
        return s1;
    }

    // Conservative byte size for GC scan-region registration (-1: scalar)
    pub fnc gc_scan_size(typ string) : int {
        lt: string = this.llvm_type(typ);
        if lt.size > 1 && lt[lt.size - 1] == '*' { return 8; }
        if typ.size > 1 && typ[typ.size - 1] == ']' { return 16; }
        if typ.size > 1 && typ[0] == '(' {
            // tuple: count top-level elements, 8 bytes each (conservative)
            depth: int = 0;
            n: int = 1;
            ti: int = 1;
            while ti < typ.size - 1 {
                ch: char = typ[ti];
                if ch == '(' || ch == '<' { depth = depth + 1; }
                if ch == ')' || ch == '>' { depth = depth - 1; }
                if ch == ',' && depth == 0 { n = n + 1; }
                ti = ti + 1;
            }
            return n * 8;
        }
        if this.tc.structs.isin(typ) {
            si: StructInfo = this.tc.structs[typ];
            total: int = 0;
            fi: int = 0;
            while fi < si.field_types.size {
                fsz: int = this.gc_scan_size(si.field_types.get(fi));
                if fsz > 0 { total = total + fsz; }
                fi = fi + 1;
            }
            if total > 0 { return total; }
            return -1;
        }
        return -1;
    }

    // Deep-copy a struct value (python value semantics): shallow byte copy
    // plus recursive copy of nested struct-typed pointer fields.
    pub fnc clone_struct_val(val string, typ string) : string {
        lty: string = this.llvm_type(typ);
        pty: string = "";
        pi: int = 0;
        while pi < lty.size - 1 {
            pty = pty + lty[pi];
            pi = pi + 1;
        }
        szg: string = this.new_reg();
        this.emit("  " + szg + " = getelementptr " + pty + ", " + lty + " null, i32 1");
        szr: string = this.new_reg();
        this.emit("  " + szr + " = ptrtoint " + lty + " " + szg + " to i64");
        cp8: string = this.new_reg();
        this.emit("  " + cp8 + " = call i8* @leash_sh_clone_obj(i8* " + val + ", i64 " + szr + ")");
        cp: string = this.new_reg();
        this.emit("  " + cp + " = bitcast i8* " + cp8 + " to " + lty);
        si: StructInfo = this.tc.structs[typ];
        foreach fi, ft in<vector> si.field_types {
            if ft.size == 0 || ft[0] == '&' { continue; }
            if this.tc.structs.isin(ft) {
                flty: string = this.llvm_type(ft);
                fg: string = this.new_reg();
                this.emit("  " + fg + " = getelementptr " + pty + ", " + lty + " " + cp + ", i32 0, i32 " + tostring(fi));
                fold: string = this.new_reg();
                this.emit("  " + fold + " = load " + flty + ", " + flty + "* " + fg);
                fnew: string = this.clone_struct_val(fold, ft);
                this.emit("  store " + flty + " " + fnew + ", " + flty + "* " + fg);
            }
        }
        return cp;
    }

    // Load/op/store compound assignment (`+=`, `>>=`, `++`, ...) through an
    // existing cell pointer of LLVM type `lty`.
    pub fnc emit_assign_compound(ptr string, lty string, op string, val string) : void {
        old_r: string = this.new_reg();
        this.emit("  " + old_r + " = load " + lty + ", " + lty + "* " + ptr);
        ir_op: string = "add";
        if lty == "double" {
            ir_op = "fadd";
            if op == "-=" || op == "--" { ir_op = "fsub"; }
            if op == "*=" { ir_op = "fmul"; }
            if op == "/=" { ir_op = "fdiv"; }
            if op == "%=" { ir_op = "frem"; }
        } else {
            if op == "-=" || op == "--" { ir_op = "sub"; }
            if op == "*=" { ir_op = "mul"; }
            if op == "/=" { ir_op = "sdiv"; }
            if op == "%=" { ir_op = "srem"; }
            if op == ">>=" { ir_op = "ashr"; }
            if op == "<<=" { ir_op = "shl"; }
            if op == "&=" { ir_op = "and"; }
            if op == "|=" { ir_op = "or"; }
            if op == "^=" { ir_op = "xor"; }
        }
        op_r: string = this.new_reg();
        if lty == "double" && (op == "++" || op == "--") {
            this.emit("  " + op_r + " = " + ir_op + " double " + old_r + ", 1.0");
        } else {
            this.emit("  " + op_r + " = " + ir_op + " " + lty + " " + old_r + ", " + val);
        }
        this.emit("  store " + lty + " " + op_r + ", " + lty + "* " + ptr);
    }

    pub fnc is_compound_op(op string) : bool {
        return op == "+=" || op == "-=" || op == "*=" || op == "/=" || op == "%=" ||
               op == ">>=" || op == "<<=" || op == "&=" || op == "|=" || op == "^=" ||
               op == "++" || op == "--";
    }

    // Atomic write to a `fusion` integer global (python parity): `x = x
    // +/- k` lowers to atomicrmw so concurrent counters never lose
    // updates; anything else is an atomic store. Caller guarantees an
    // integer global of atomic width.
    pub fnc gen_fusion_assign(s Stmt, name string, gv_lty string) : void {
        ptr: string = "@g_" + name;
        al: int = this.fusion_align(gv_lty);
        is_uint_g: bool = false;
        if this.global_vars.isin(name) { is_uint_g = this.is_uint_type(this.global_vars[name]); }
        // x = x + k / x = k + x -> rmw add; x = x - k -> rmw sub
        if s.op == "=" && s.value != null && s.value.kind == ExprKind.BINOP && (s.value.op == "+" || s.value.op == "-") {
            l_is_t: bool = s.value.left != null && s.value.left.kind == ExprKind.IDENT && s.value.left.sval == name;
            r_is_t: bool = s.value.right != null && s.value.right.kind == ExprKind.IDENT && s.value.right.sval == name;
            operand_e: Expr = null;
            rmw: string = "";
            if l_is_t && !r_is_t {
                operand_e = s.value.right;
                if s.value.op == "+" { rmw = "add"; } else { rmw = "sub"; }
            } also r_is_t && !l_is_t && s.value.op == "+" {
                operand_e = s.value.left;
                rmw = "add";
            }
            if operand_e != null {
                oval: string = this.gen_expr(operand_e);
                oval = this.fusion_cast_operand(operand_e, oval, gv_lty);
                old: string = this.new_reg();
                this.emit("  " + old + " = atomicrmw " + rmw + " " + gv_lty + "* " + ptr + ", " + gv_lty + " " + oval + " seq_cst");
                return;
            }
        }
        // Compound idioms: +=/++ -> rmw add, -=/-- -> rmw sub
        if s.op == "+=" || s.op == "++" || s.op == "-=" || s.op == "--" {
            oval2: string = this.gen_expr(s.value);
            oval2 = this.fusion_cast_operand(s.value, oval2, gv_lty);
            rmw2: string = "add";
            if s.op == "-=" || s.op == "--" { rmw2 = "sub"; }
            old2: string = this.new_reg();
            this.emit("  " + old2 + " = atomicrmw " + rmw2 + " " + gv_lty + "* " + ptr + ", " + gv_lty + " " + oval2 + " seq_cst");
            return;
        }
        // Other compounds compute from a plain load and store atomically
        // (reference shape: only +/- get the RMW form).
        if this.is_compound_op(s.op) {
            oval3: string = this.gen_expr(s.value);
            oval3 = this.fusion_cast_operand(s.value, oval3, gv_lty);
            cur: string = this.new_reg();
            this.emit("  " + cur + " = load " + gv_lty + ", " + gv_lty + "* " + ptr);
            iop: string = "add";
            if s.op == "*=" { iop = "mul"; }
            also s.op == "/=" {
                if is_uint_g { iop = "udiv"; } else { iop = "sdiv"; }
            } also s.op == "%=" {
                if is_uint_g { iop = "urem"; } else { iop = "srem"; }
            } also s.op == "<<=" { iop = "shl"; }
            also s.op == ">>=" {
                if is_uint_g { iop = "lshr"; } else { iop = "ashr"; }
            } also s.op == "&=" { iop = "and"; }
            also s.op == "|=" { iop = "or"; }
            also s.op == "^=" { iop = "xor"; }
            res3: string = this.new_reg();
            this.emit("  " + res3 + " = " + iop + " " + gv_lty + " " + cur + ", " + oval3);
            this.emit("  store atomic " + gv_lty + " " + res3 + ", " + gv_lty + "* " + ptr + " seq_cst, align " + tostring(al));
            return;
        }
        oval4: string = this.gen_expr(s.value);
        oval4 = this.coerce_store_val(s.value, oval4, gv_lty);
        this.emit("  store atomic " + gv_lty + " " + oval4 + ", " + gv_lty + "* " + ptr + " seq_cst, align " + tostring(al));
    }

    // Cast an RMW/store operand to the fusion slot width (trunc, or
    // sext/zext by the operand's own signedness). Literals embed as-is.
    pub fnc fusion_cast_operand(e Expr, val string, gv_lty string) : string {
        if e == null { return val; }
        if val.size > 0 && val[0] != '%' { return val; }
        et: string = this.get_expr_type(e);
        elty: string = this.llvm_type(et);
        if elty == gv_lty { return val; }
        if this.is_int_lty(elty) && this.is_int_lty(gv_lty) {
            r: string = this.new_reg();
            if this.lty_width(elty) > this.lty_width(gv_lty) {
                this.emit("  " + r + " = trunc " + elty + " " + val + " to " + gv_lty);
            } also this.is_uint_type(et) {
                this.emit("  " + r + " = zext " + elty + " " + val + " to " + gv_lty);
            } else {
                this.emit("  " + r + " = sext " + elty + " " + val + " to " + gv_lty);
            }
            return r;
        }
        return val;
    }

    // Lower prefix/postfix inc/dec on an lvalue: read once, store back
    // through the assign machinery, yield new (prefix) or old (postfix).
    // IDENT cells lower directly (fusion globals stay atomic); anything
    // else stores via a synthesized plain assignment.
    pub fnc gen_incr_decr(t Expr, is_prefix bool, is_inc bool) : string {
        if t.kind == ExprKind.IDENT && this.var_ptrs.isin(t.sval) {
            cell: string = this.var_ptrs[t.sval];
            vtyp: string = this.var_types[t.sval];
            // Scalar refs assign through to the referenced cell.
            while vtyp.size > 1 && vtyp[0] == '&' {
                inner: string = this.strip_ref(vtyp);
                if this.tc.structs.isin(inner) || this.tc.classes.isin(inner) { stop; }
                nplty: string = this.llvm_type(vtyp);
                nptr: string = this.new_reg();
                this.emit("  " + nptr + " = load " + nplty + ", " + nplty + "* " + cell);
                cell = nptr;
                vtyp = inner;
            }
            clty: string = this.llvm_type(vtyp);
            oldv: string = this.new_reg();
            this.emit("  " + oldv + " = load " + clty + ", " + clty + "* " + cell);
            newv: string = this.incr_value(oldv, clty, is_inc);
            this.emit("  store " + clty + " " + newv + ", " + clty + "* " + cell);
            if is_prefix { return newv; }
            return oldv;
        }
        if t.kind == ExprKind.IDENT && !this.var_ptrs.isin(t.sval) && this.global_vars.isin(t.sval) {
            gt: string = this.global_vars[t.sval];
            glty: string = this.llvm_type(gt);
            gptr: string = "@g_" + t.sval;
            if this.fusion_int_width(t.sval) > 0 {
                rmw: string = "add";
                if !is_inc { rmw = "sub"; }
                ftext_old: string = this.new_reg();
                this.emit("  " + ftext_old + " = atomicrmw " + rmw + " " + glty + "* " + gptr + ", " + glty + " 1 seq_cst");
                if is_prefix {
                    fnew: string = this.new_reg();
                    if is_inc {
                        this.emit("  " + fnew + " = add " + glty + " " + ftext_old + ", 1");
                    } else {
                        this.emit("  " + fnew + " = sub " + glty + " " + ftext_old + ", 1");
                    }
                    return fnew;
                }
                return ftext_old;
            }
            gold: string = this.new_reg();
            this.emit("  " + gold + " = load " + glty + ", " + glty + "* " + gptr);
            gnew: string = this.incr_value(gold, glty, is_inc);
            this.emit("  store " + glty + " " + gnew + ", " + glty + "* " + gptr);
            if is_prefix { return gnew; }
            return gold;
        }
        // General lvalues: read once, write back through assignment.
        told: string = this.gen_expr(t);
        tot: string = this.get_expr_type(t);
        tolty: string = this.llvm_type(tot);
        tnew: string = this.incr_value(told, tolty, is_inc);
        if is_prefix {
            pf_op: string = "+";
            if !is_inc { pf_op = "-"; }
            pf_rhs: Expr = Expr.make_int(1);
            if this.is_float_lty(tolty) { pf_rhs = Expr.make_float(1.0); }
            sta: Stmt = Stmt.make_assign(t, "=", Expr.make_binop(pf_op, t, pf_rhs));
            this.gen_statement(sta);
            return tnew;
        }
        // Postfix yields the old value; store new back.
        one_e: Expr = Expr.make_int(1);
        if this.is_float_lty(tolty) { one_e = Expr.make_float(1.0); }
        sta2_op: string = "+";
        if !is_inc { sta2_op = "-"; }
        sta2: Stmt = Stmt.make_assign(t, "=", Expr.make_binop(sta2_op, t, one_e));
        this.gen_statement(sta2);
        return told;
    }

    // old +/- 1 at the operand width (1.0 for floats).
    pub fnc incr_value(oldv string, lty string, is_inc bool) : string {
        r: string = this.new_reg();
        if this.is_float_lty(lty) {
            if is_inc {
                this.emit("  " + r + " = fadd " + lty + " " + oldv + ", 1.0");
            } else {
                this.emit("  " + r + " = fsub " + lty + " " + oldv + ", 1.0");
            }
            return r;
        }
        if is_inc {
            this.emit("  " + r + " = add " + lty + " " + oldv + ", 1");
        } else {
            this.emit("  " + r + " = sub " + lty + " " + oldv + ", 1");
        }
        return r;
    }

    // Clone struct-typed values on copy boundaries; everything else passes through.
    pub fnc maybe_clone_value(val string, typ string) : string {
        if typ.size == 0 || typ[0] == '&' { return val; }
        if !this.tc.structs.isin(typ) { return val; }
        return this.clone_struct_val(val, typ);
    }

    // Slice value stored into a raw pointer target: keep only the data pointer
    pub fnc coerce_slice_ptr(val string, rhs_t string, tgt_t string) : string {
        if tgt_t.size > 1 && (tgt_t[0] == '*' || tgt_t[0] == '&') && rhs_t.size > 2 && rhs_t[rhs_t.size - 1] == ']' {
            r: string = this.new_reg();
            this.emit("  " + r + " = extractvalue " + this.llvm_type(rhs_t) + " " + val + ", 1");
            return r;
        }
        return val;
    }

    pub fnc box_to_i8ptr(val string, typ string) : string {
        lty: string = this.llvm_type(typ);
        if lty == "i8*" { return val; }
        if lty == "i64" {
            r: string = this.new_reg();
            this.emit("  " + r + " = inttoptr i64 " + val + " to i8*");
            return r;
        }
        if lty == "i1" {
            ext: string = this.new_reg();
            this.emit("  " + ext + " = zext i1 " + val + " to i64");
            r: string = this.new_reg();
            this.emit("  " + r + " = inttoptr i64 " + ext + " to i8*");
            return r;
        }
        if lty == "i8" {
            ext: string = this.new_reg();
            this.emit("  " + ext + " = zext i8 " + val + " to i64");
            r: string = this.new_reg();
            this.emit("  " + r + " = inttoptr i64 " + ext + " to i8*");
            return r;
        }
        // Sized ints: narrow widths zero-extend into the tagged box; wide
        // (>64) values get a heap box holding the raw little-endian bytes.
        if this.is_int_lty(lty) && lty != "i64" && lty != "i1" && lty != "i8" {
            bw: int = this.lty_width(lty);
            if bw > 64 {
                bbytes: int = (bw + 7) / 8;
                bmem: string = this.new_reg();
                this.emit("  " + bmem + " = call i8* @leash_gc_malloc(i64 " + tostring(bbytes) + ")");
                bbp: string = this.new_reg();
                this.emit("  " + bbp + " = bitcast i8* " + bmem + " to " + lty + "*");
                this.emit("  store " + lty + " " + val + ", " + lty + "* " + bbp);
                return bmem;
            }
            bext: string = this.new_reg();
            this.emit("  " + bext + " = zext " + lty + " " + val + " to i64");
            br: string = this.new_reg();
            this.emit("  " + br + " = inttoptr i64 " + bext + " to i8*");
            return br;
        }
        if lty == "double" {
            bits: string = this.new_reg();
            this.emit("  " + bits + " = bitcast double " + val + " to i64");
            r: string = this.new_reg();
            this.emit("  " + r + " = inttoptr i64 " + bits + " to i8*");
            return r;
        }
        // Pointer types (struct*, class*) - bitcast to i8*
        r: string = this.new_reg();
        this.emit("  " + r + " = bitcast " + lty + " " + val + " to i8*");
        return r;
    }

    pub fnc unbox_from_i8ptr(val string, typ string) : string {
        lty: string = this.llvm_type(typ);
        if lty == "i8*" { return val; }
        if lty == "i64" {
            r: string = this.new_reg();
            this.emit("  " + r + " = ptrtoint i8* " + val + " to i64");
            return r;
        }
        if lty == "i1" {
            i64r: string = this.new_reg();
            this.emit("  " + i64r + " = ptrtoint i8* " + val + " to i64");
            r: string = this.new_reg();
            this.emit("  " + r + " = trunc i64 " + i64r + " to i1");
            return r;
        }
        if lty == "i8" {
            i64r: string = this.new_reg();
            this.emit("  " + i64r + " = ptrtoint i8* " + val + " to i64");
            r: string = this.new_reg();
            this.emit("  " + r + " = trunc i64 " + i64r + " to i8");
            return r;
        }
        // Sized ints: mirror the boxing (tagged for <=64, heap box for >64)
        if this.is_int_lty(lty) && lty != "i64" && lty != "i1" && lty != "i8" {
            uw: int = this.lty_width(lty);
            if uw > 64 {
                ubp: string = this.new_reg();
                this.emit("  " + ubp + " = bitcast i8* " + val + " to " + lty + "*");
                uld: string = this.new_reg();
                this.emit("  " + uld + " = load " + lty + ", " + lty + "* " + ubp);
                return uld;
            }
            ui64: string = this.new_reg();
            this.emit("  " + ui64 + " = ptrtoint i8* " + val + " to i64");
            ur: string = this.new_reg();
            this.emit("  " + ur + " = trunc i64 " + ui64 + " to " + lty);
            return ur;
        }
        if lty == "double" {
            i64r: string = this.new_reg();
            this.emit("  " + i64r + " = ptrtoint i8* " + val + " to i64");
            r: string = this.new_reg();
            this.emit("  " + r + " = bitcast i64 " + i64r + " to double");
            return r;
        }
        // Pointer types - bitcast from i8*
        r: string = this.new_reg();
        this.emit("  " + r + " = bitcast i8* " + val + " to " + lty);
        return r;
    }

    pub fnc strip_ref(t string) : string {
        if t.size > 1 && t[0] == '&' {
            out: string = "";
            i: int = 1;
            while i < t.size {
                out = out + t[i];
                i = i + 1;
            }
            return out;
        }
        return t;
    }

    // ---- Union helpers ----
    pub fnc lty_rank(lty string) : int {
        // any llvm int width: i1, i2, i7, i33, i128, i256, ...
        return this.lty_width(lty);
    }

    pub fnc is_int_lty(lty string) : bool {
        return this.lty_rank(lty) > 0;
    }

    pub fnc is_float_lty(lty string) : bool {
        return lty == "double" || lty == "float" || lty == "half";
    }

    pub fnc is_ptr_lty(lty string) : bool {
        return lty.size > 0 && lty[lty.size - 1] == '*';
    }

    pub fnc lty_bytes(lty string) : int {
        if lty == "i1" { return 1; }
        if lty == "i8" { return 1; }
        if lty == "i16" { return 2; }
        if lty == "i32" { return 4; }
        if lty == "i64" { return 8; }
        if lty == "i128" { return 16; }
        if lty == "double" { return 8; }
        if lty == "float" { return 4; }
        if lty == "half" { return 2; }
        return 8;
    }

    pub fnc union_payload_type(uname string) : string {
        if !this.tc.union_names.isin(uname) { return "[8 x i8]"; }
        max_size: int = 0;
        max_align: int = 8;
        names: vec<string> = this.tc.union_names[uname];
        i: int = 0;
        while i < names.size {
            vty: string = this.llvm_type(this.tc.union_variant_type(uname, i));
            b: int = this.lty_bytes(vty);
            a: int = this.lty_bytes(vty);
            if b > max_size { max_size = b; }
            if a > max_align { max_align = a; }
            i = i + 1;
        }
        if max_size < 8 { max_size = 8; }
        if max_align > 8 {
            nslots: int = (max_size + max_align - 1) / max_align;
            return "[" + tostring(nslots) + " x i" + tostring(max_align * 8) + "]";
        }
        return "[" + tostring(max_size) + " x i8]";
    }

    pub fnc cast_lty(val string, from_lty string, to_lty string) : string {
        if from_lty == to_lty { return val; }
        res: string = this.new_reg();
        if this.is_int_lty(from_lty) && this.is_int_lty(to_lty) {
            if this.lty_rank(from_lty) > this.lty_rank(to_lty) {
                this.emit("  " + res + " = trunc " + from_lty + " " + val + " to " + to_lty);
            } else {
                this.emit("  " + res + " = zext " + from_lty + " " + val + " to " + to_lty);
            }
            return res;
        }
        if this.is_int_lty(from_lty) && to_lty == "double" {
            this.emit("  " + res + " = sitofp " + from_lty + " " + val + " to double");
            return res;
        }
        if from_lty == "double" && this.is_int_lty(to_lty) {
            this.emit("  " + res + " = fptosi double " + val + " to " + to_lty);
            return res;
        }
        this.emit("  " + res + " = bitcast " + from_lty + " " + val + " to " + to_lty);
        return res;
    }

    pub fnc union_base_type(target Expr) : string {
        if target == null { return ""; }
        if target.left == null { return ""; }
        bt: string = this.strip_ref(this.get_expr_type(target.left));
        if this.tc.unions.isin(bt) { return bt; }
        return "";
    }

    pub fnc union_ptr_of(base Expr) : string {
        if base == null { return ""; }
        if base.kind == ExprKind.IDENT && this.var_ptrs.isin(base.sval) {
            return this.var_ptrs[base.sval];
        }
        if base.kind == ExprKind.MEMBER && base.sval == "cur" && base.left != null && base.left.kind == ExprKind.IDENT && this.var_ptrs.isin(base.left.sval) {
            return this.var_ptrs[base.left.sval];
        }
        return "";
    }

    pub fnc emit_union_tag_check(tag string, idx int, member string, uname string) : void {
        if this.cur_func_unsafe { return; }
        ok_l: string = this.new_label("us_ok");
        fail_l: string = this.new_label("us_fail");
        ck: string = this.new_reg();
        this.emit("  " + ck + " = icmp eq i64 " + tag + ", " + tostring(idx));
        this.emit("  br i1 " + ck + ", label %" + ok_l + ", label %" + fail_l);
        this.emit(fail_l + ":");
        emsg: string = "Runtime error: Attempted to access '." + member + "' on union '" + uname + "', but the active variant is different.\n";
        ep: string = this.const_str_of(emsg);
        this.emit("  call i32 (i8*, ...) @printf(i8* " + ep + ")");
        this.emit("  call void @exit(i64 1)");
        this.emit("  unreachable");
        this.emit(ok_l + ":");
        this.current_block_terminated = false;
    }

    pub fnc union_auto_store(ptr string, uname string, val string, src_typ string) : void {
        uty: string = "%union." + uname;
        if src_typ == uname {
            this.emit("  store " + uty + " " + val + ", " + uty + "* " + ptr);
            return;
        }
        names: vec<string> = this.tc.union_names[uname];
        idx: int = -1;
        val_lty: string = this.llvm_type(this.strip_ref(src_typ));

        foreach i, _vn in<vector> names {
            if this.tc.union_variant_type(uname, i) == src_typ { idx = i; stop; }
        }
        if idx < 0 {
            foreach i, _vn in<vector> names {
                if this.llvm_type(this.tc.union_variant_type(uname, i)) == val_lty { idx = i; stop; }
            }
        }
        if idx < 0 && this.is_int_lty(val_lty) {
            foreach i, _vn in<vector> names {
                if this.is_int_lty(this.llvm_type(this.tc.union_variant_type(uname, i))) { idx = i; stop; }
            }
        }
        if idx < 0 && this.is_float_lty(val_lty) {
            foreach i, _vn in<vector> names {
                if this.is_float_lty(this.llvm_type(this.tc.union_variant_type(uname, i))) { idx = i; stop; }
            }
        }
        if idx < 0 { return; }

        vty: string = this.llvm_type(this.tc.union_variant_type(uname, idx));
        stored: string = this.cast_lty(val, val_lty, vty);
        tagp: string = this.new_reg();
        this.emit("  " + tagp + " = getelementptr inbounds " + uty + ", " + uty + "* " + ptr + ", i32 0, i32 0");
        this.emit("  store i64 " + tostring(idx) + ", i64* " + tagp);
        datap: string = this.new_reg();
        this.emit("  " + datap + " = getelementptr inbounds " + uty + ", " + uty + "* " + ptr + ", i32 0, i32 1");
        pl: string = this.union_payload_type(uname);
        bp: string = this.new_reg();
        this.emit("  " + bp + " = bitcast " + pl + "* " + datap + " to " + vty + "*");
        this.emit("  store " + vty + " " + stored + ", " + vty + "* " + bp + ", align 1");
    }

    pub fnc convert_to_common(val string, from_lty string, common string) : string {
        if from_lty == common { return val; }
        cur: string = val;
        res: string = this.new_reg();
        if this.is_int_lty(from_lty) && common == "i8*" {
            if this.lty_rank(from_lty) < 64 {
                zr: string = this.new_reg();
                this.emit("  " + zr + " = zext " + from_lty + " " + cur + " to i64");
                cur = zr;
            }
            this.emit("  " + res + " = inttoptr i64 " + cur + " to i8*");
            return res;
        }
        if this.is_float_lty(from_lty) && common == "i8*" {
            ir1: string = this.new_reg();
            this.emit("  " + ir1 + " = fptosi " + from_lty + " " + cur + " to i64");
            this.emit("  " + res + " = inttoptr i64 " + ir1 + " to i8*");
            return res;
        }
        if this.is_ptr_lty(from_lty) && common == "i64" {
            this.emit("  " + res + " = ptrtoint " + from_lty + " " + cur + " to i64");
            return res;
        }
        if this.is_ptr_lty(from_lty) && common == "double" {
            ir2: string = this.new_reg();
            this.emit("  " + ir2 + " = ptrtoint " + from_lty + " " + cur + " to i64");
            this.emit("  " + res + " = sitofp i64 " + ir2 + " to double");
            return res;
        }
        if this.is_int_lty(from_lty) && common == "double" {
            this.emit("  " + res + " = sitofp " + from_lty + " " + cur + " to double");
            return res;
        }
        if this.is_float_lty(from_lty) && common == "i64" {
            this.emit("  " + res + " = fptosi " + from_lty + " " + cur + " to i64");
            return res;
        }
        if this.is_int_lty(from_lty) && this.is_int_lty(common) {
            if this.lty_rank(from_lty) > this.lty_rank(common) {
                this.emit("  " + res + " = trunc " + from_lty + " " + cur + " to " + common);
            } else {
                this.emit("  " + res + " = zext " + from_lty + " " + cur + " to " + common);
            }
            return res;
        }
        if this.is_ptr_lty(from_lty) && this.is_ptr_lty(common) {
            this.emit("  " + res + " = bitcast " + from_lty + " " + cur + " to " + common);
            return res;
        }
        return cur;
    }

    pub fnc union_cur_load(tag string, datap string, uname string) : string {
        if !this.tc.union_names.isin(uname) { return "0"; }
        names: vec<string> = this.tc.union_names[uname];
        n: int = names.size;
        if n == 0 { return "0"; }
        pl: string = this.union_payload_type(uname);

        if n == 1 {
            vty1: string = this.llvm_type(this.tc.union_variant_type(uname, 0));
            bp1: string = this.new_reg();
            this.emit("  " + bp1 + " = bitcast " + pl + "* " + datap + " to " + vty1 + "*");
            lv1: string = this.new_reg();
            this.emit("  " + lv1 + " = load " + vty1 + ", " + vty1 + "* " + bp1 + ", align 1");
            return lv1;
        }

        common: string = "i64";
        if this.tc.union_has_ptr_variant(uname) {
            common = "i8*";
        } also this.tc.union_has_float_variant(uname) {
            common = "double";
        }

        vlabels: vec<string>;
        ci: int = 0;
        while ci < n {
            vlabels.pushb(this.new_label("uc_v"));
            ci = ci + 1;
        }
        merge_l: string = this.new_label("uc_m");

        ch: int = 0;
        while ch < n - 1 {
            ck: string = this.new_reg();
            this.emit("  " + ck + " = icmp eq i64 " + tag + ", " + tostring(ch));
            if ch + 1 <= n - 2 {
                nxt: string = this.new_label("uc_c");
                this.emit("  br i1 " + ck + ", label %" + vlabels.get(ch) + ", label %" + nxt);
                this.emit(nxt + ":");
            } else {
                this.emit("  br i1 " + ck + ", label %" + vlabels.get(ch) + ", label %" + vlabels.get(ch + 1));
            }
            ch = ch + 1;
        }

        in_vals: vec<string>;
        in_labs: vec<string>;
        vi: int = 0;
        while vi < n {
            vty: string = this.llvm_type(this.tc.union_variant_type(uname, vi));
            this.emit(vlabels.get(vi) + ":");
            bpc: string = this.new_reg();
            this.emit("  " + bpc + " = bitcast " + pl + "* " + datap + " to " + vty + "*");
            lvc: string = this.new_reg();
            this.emit("  " + lvc + " = load " + vty + ", " + vty + "* " + bpc + ", align 1");
            cv: string = this.convert_to_common(lvc, vty, common);
            this.emit("  br label %" + merge_l);
            in_vals.pushb(cv);
            in_labs.pushb(vlabels.get(vi));
            vi = vi + 1;
        }

        this.emit(merge_l + ":");
        this.current_block_terminated = false;
        ph: string = this.new_reg();
        phi_src: string = "";
        pi2: int = 0;
        while pi2 < in_vals.size {
            if pi2 > 0 { phi_src = phi_src + ", "; }
            phi_src = phi_src + "[" + in_vals.get(pi2) + ", %" + in_labs.get(pi2) + "]";
            pi2 = pi2 + 1;
        }
        this.emit("  " + ph + " = phi " + common + " " + phi_src);
        return ph;
    }

    pub fnc emit_union_print(val string, vty string) : void {
        if vty == "i8*" {
            this.emit("  call i32 (i8*, ...) @printf(i8* getelementptr inbounds ([3 x i8], [3 x i8]* @.fmt_s, i64 0, i64 0), i8* " + val + ")");
        } also vty == "double" {
            this.emit("  call i32 (i8*, ...) @printf(i8* getelementptr inbounds ([3 x i8], [3 x i8]* @.fmt_f, i64 0, i64 0), double " + val + ")");
        } also vty == "i8" {
            this.emit("  call i32 (i8*, ...) @printf(i8* getelementptr inbounds ([3 x i8], [3 x i8]* @.fmt_c, i64 0, i64 0), i8 " + val + ")");
        } also vty == "i1" {
            bt: string = this.new_label("us_bt");
            bf: string = this.new_label("us_bf");
            bm: string = this.new_label("us_bm");
            this.emit("  br i1 " + val + ", label %" + bt + ", label %" + bf);
            this.emit(bt + ":");
            this.emit("  call i32 (i8*, ...) @printf(i8* getelementptr inbounds ([5 x i8], [5 x i8]* @.fmt_true, i64 0, i64 0))");
            this.emit("  br label %" + bm);
            this.emit(bf + ":");
            this.emit("  call i32 (i8*, ...) @printf(i8* getelementptr inbounds ([6 x i8], [6 x i8]* @.fmt_false, i64 0, i64 0))");
            this.emit("  br label %" + bm);
            this.emit(bm + ":");
        } also this.is_int_lty(vty) {
            iv: string = val;
            wide_lit: bool = (val.size >= 10 && val[0] != '%' && val[0] != '@');
            if vty != "i64" && !wide_lit {
                iv = this.new_reg();
                if this.lty_rank(vty) < 64 {
                    this.emit("  " + iv + " = sext " + vty + " " + val + " to i64");
                } else {
                    this.emit("  " + iv + " = trunc " + vty + " " + val + " to i64");
                }
            }
            this.emit("  call i32 (i8*, ...) @printf(i8* getelementptr inbounds ([5 x i8], [5 x i8]* @.fmt_d, i64 0, i64 0), i64 " + iv + ")");
        } else {
            this.emit("  call i32 (i8*, ...) @printf(i8* getelementptr inbounds ([3 x i8], [3 x i8]* @.fmt_p, i64 0, i64 0), " + vty + " " + val + ")");
        }
    }

    pub fnc gen_union_show(arg Expr, uname string) : void {
        ptr: string = this.union_ptr_of(arg);
        if ptr.size == 0 {
            this.gen_expr(arg);
            return;
        }
        if !this.tc.union_names.isin(uname) { return; }
        uty: string = "%union." + uname;
        pl: string = this.union_payload_type(uname);
        vtagp: string = this.new_reg();
        this.emit("  " + vtagp + " = getelementptr inbounds " + uty + ", " + uty + "* " + ptr + ", i32 0, i32 0");
        vtag: string = this.new_reg();
        this.emit("  " + vtag + " = load i64, i64* " + vtagp);
        vdatap: string = this.new_reg();
        this.emit("  " + vdatap + " = getelementptr inbounds " + uty + ", " + uty + "* " + ptr + ", i32 0, i32 1");

        n: int = 0;
        if this.tc.union_names.isin(uname) {
            show_names: vec<string> = this.tc.union_names[uname];
            n = show_names.size;
        }
        if n == 0 { return; }
        vlabs: vec<string>;
        vi: int = 0;
        while vi < n {
            vlabs.pushb(this.new_label("us_v"));
            vi = vi + 1;
        }
        mrg: string = this.new_label("us_m");

        ch: int = 0;
        while ch < n - 1 {
            ck: string = this.new_reg();
            this.emit("  " + ck + " = icmp eq i64 " + vtag + ", " + tostring(ch));
            if ch + 1 <= n - 2 {
                nx: string = this.new_label("us_c");
                this.emit("  br i1 " + ck + ", label %" + vlabs.get(ch) + ", label %" + nx);
                this.emit(nx + ":");
            } else {
                this.emit("  br i1 " + ck + ", label %" + vlabs.get(ch) + ", label %" + vlabs.get(ch + 1));
            }
            ch = ch + 1;
        }
        if n == 1 { this.emit("  br label %" + vlabs.get(0)); }

        vi = 0;
        while vi < n {
            this.emit(vlabs.get(vi) + ":");
            vty: string = this.llvm_type(this.tc.union_variant_type(uname, vi));
            bp: string = this.new_reg();
            this.emit("  " + bp + " = bitcast " + pl + "* " + vdatap + " to " + vty + "*");
            lv: string = this.new_reg();
            this.emit("  " + lv + " = load " + vty + ", " + vty + "* " + bp + ", align 1");
            this.emit_union_print(lv, vty);
            this.emit("  br label %" + mrg);
            vi = vi + 1;
        }
        this.emit(mrg + ":");
        this.current_block_terminated = false;
    }

    pub fnc load_union_member(e Expr, obj_t string) : string {
        ptr: string = this.union_ptr_of(e.left);
        if ptr.size == 0 { return "0"; }
        uty: string = "%union." + obj_t;
        datap: string = this.new_reg();
        this.emit("  " + datap + " = getelementptr inbounds " + uty + ", " + uty + "* " + ptr + ", i32 0, i32 1");

        if e.sval == "cur" {
            ctagp: string = this.new_reg();
            this.emit("  " + ctagp + " = getelementptr inbounds " + uty + ", " + uty + "* " + ptr + ", i32 0, i32 0");
            ctag: string = this.new_reg();
            this.emit("  " + ctag + " = load i64, i64* " + ctagp);
            return this.union_cur_load(ctag, datap, obj_t);
        }

        idx: int = this.tc.union_variant_index(obj_t, e.sval);
        if idx < 0 { return "0"; }
        vtagp: string = this.new_reg();
        this.emit("  " + vtagp + " = getelementptr inbounds " + uty + ", " + uty + "* " + ptr + ", i32 0, i32 0");
        vtag: string = this.new_reg();
        this.emit("  " + vtag + " = load i64, i64* " + vtagp);
        this.emit_union_tag_check(vtag, idx, e.sval, obj_t);
        vty: string = this.llvm_type(this.tc.union_variant_type(obj_t, idx));
        pl: string = this.union_payload_type(obj_t);
        bp: string = this.new_reg();
        this.emit("  " + bp + " = bitcast " + pl + "* " + datap + " to " + vty + "*");
        lv: string = this.new_reg();
        this.emit("  " + lv + " = load " + vty + ", " + vty + "* " + bp + ", align 1");
        return lv;
    }

    pub fnc assign_union_member(s Stmt, ub_t string, val string) : void {
        ptr: string = this.union_ptr_of(s.target);
        if ptr.size == 0 && s.target != null { ptr = this.union_ptr_of(s.target.left); }
        if ptr.size == 0 { return; }
        idx: int = this.tc.union_variant_index(ub_t, s.target.sval);
        if idx < 0 { return; }
        uty: string = "%union." + ub_t;
        vty: string = this.llvm_type(this.tc.union_variant_type(ub_t, idx));
        val_lty: string = this.llvm_type(this.strip_ref(this.get_expr_type(s.value)));
        stored: string = this.cast_lty(val, val_lty, vty);
        tagp: string = this.new_reg();
        this.emit("  " + tagp + " = getelementptr inbounds " + uty + ", " + uty + "* " + ptr + ", i32 0, i32 0");
        this.emit("  store i64 " + tostring(idx) + ", i64* " + tagp);
        datap: string = this.new_reg();
        this.emit("  " + datap + " = getelementptr inbounds " + uty + ", " + uty + "* " + ptr + ", i32 0, i32 1");
        pl: string = this.union_payload_type(ub_t);
        bp: string = this.new_reg();
        this.emit("  " + bp + " = bitcast " + pl + "* " + datap + " to " + vty + "*");
        this.emit("  store " + vty + " " + stored + ", " + vty + "* " + bp + ", align 1");
    }

    pub fnc parse_int_str(t string) : int {
        v: int = 0;
        i: int = 0;
        while i < t.size {
            c: char = t[i];
            if c < '0' || c > '9' { return 0; }
            v = v * 10 + (c - '0');
            i = i + 1;
        }
        return v;
    }

    // Digits only, with an optional leading '-' (a raw LLVM-safe constant).
    pub fnc is_plain_decimal_lit(sv string) : bool {
        si: int = 0;
        if sv.size > 0 && sv[0] == '-' { si = 1; }
        if si >= sv.size { return false; }
        while si < sv.size {
            if sv[si] < '0' || sv[si] > '9' { return false; }
            si = si + 1;
        }
        return true;
    }

    pub fnc is_uint_type(t string) : bool {
        if t == "uint" { return true; }
        return t.size > 5 && t[0] == 'u' && t[1] == 'i' && t[2] == 'n' && t[3] == 't' && t[4] == '<';
    }

    // int<N> or uint<N> (N > 0)?
    pub fnc is_sized_int_type(t string) : bool {
        if t.size < 6 { return false; }
        if t[t.size - 1] != '>' { return false; }
        if t[0] == 'i' && t[1] == 'n' && t[2] == 't' && t[3] == '<' { return true; }
        if t[0] == 'u' && t[1] == 'i' && t[2] == 'n' && t[3] == 't' && t[4] == '<' { return true; }
        return false;
    }

    pub fnc sized_int_width(t string) : int {
        if t[0] == 'u' {
            return this.parse_int_str(this.str_slice2(t, 5, t.size - 1));
        }
        return this.parse_int_str(this.str_slice2(t, 4, t.size - 1));
    }

    pub fnc sized_int_is_signed(t string) : bool {
        return t[0] == 'i';
    }

    // Bit width of an llvm integer type ("i128" -> 128); 0 if not int-like.
    pub fnc lty_width(l string) : int {
        if l.size < 2 { return 0; }
        if l[0] != 'i' { return 0; }
        wi: int = 1;
        while wi < l.size {
            if l[wi] < '0' || l[wi] > '9' { return 0; }
            wi = wi + 1;
        }
        return this.parse_int_str(this.str_slice2(l, 1, l.size));
    }

    pub fnc str_slice2(s string, a int, b int) : string {
        out: string = "";
        i: int = a;
        while i < b && i < s.size {
            out = out + s[i];
            i = i + 1;
        }
        return out;
    }

    // Format a wide-int value (width > 64) as a decimal string via the runtime.
    pub fnc wide_int_to_str(val string, typ string) : string {
        w: int = this.sized_int_width(typ);
        is_s: int = 0;
        if this.sized_int_is_signed(typ) { is_s = 1; }
        slot: string = this.new_reg();
        this.emit("  " + slot + " = alloca i" + tostring(w));
        this.emit("  store i" + tostring(w) + " " + val + ", i" + tostring(w) + "* " + slot);
        bp: string = this.new_reg();
        this.emit("  " + bp + " = bitcast i" + tostring(w) + "* " + slot + " to i8*");
        res: string = this.new_reg();
        this.emit("  " + res + " = call i8* @leash_bigint_to_str(i8* " + bp + ", i64 " + tostring(w) + ", i64 " + tostring(is_s) + ")");
        this.af_track(res);
        return res;
    }

    // String-concat operand conversion for the int family. Python
    // formats like its tostring path: sext/zext to i64 then print
    // signed/unsigned per the leash type; >64-bit widths go through
    // the bigint runtime. Returns the i8* string register.
    pub fnc concat_int_to_str(e Expr, val string, typ string) : string {
        if this.is_sized_int_type(typ) {
            w: int = this.sized_int_width(typ);
            if w > 64 { return this.wide_int_to_str(val, typ); }
            ext: string = val;
            if w != 64 {
                sl: string = "i" + tostring(w);
                ext = this.new_reg();
                if this.sized_int_is_signed(typ) {
                    this.emit("  " + ext + " = sext " + sl + " " + val + " to i64");
                } else {
                    this.emit("  " + ext + " = zext " + sl + " " + val + " to i64");
                }
            }
            res: string = this.new_reg();
            if this.sized_int_is_signed(typ) {
                this.emit("  " + res + " = call i8* @leash_int_to_str(i64 " + ext + ")");
                this.af_track(res);
            } else {
                this.emit("  " + res + " = call i8* @leash_uint_to_str(i64 " + ext + ")");
                this.af_track(res);
            }
            return res;
        }
        if typ == "int" {
            res2: string = this.new_reg();
            this.emit("  " + res2 + " = call i8* @leash_int_to_str(i64 " + this.i32_to_rt_i64(e, val) + ")");
            this.af_track(res2);
            return res2;
        }
        if typ == "uint" {
            uz: string = val;
            if !this.is_wide_int_lit(e) {
                uz = this.new_reg();
                this.emit("  " + uz + " = zext i32 " + val + " to i64");
            }
            res3: string = this.new_reg();
            this.emit("  " + res3 + " = call i8* @leash_uint_to_str(i64 " + uz + ")");
            this.af_track(res3);
            return res3;
        }
        return val;
    }

    pub fnc llvm_type(typ string) : string {
        if typ.size > 1 && typ[0] == '&' {
            inner: string = "";
            i: int = 1;
            while i < typ.size {
                inner = inner + typ[i];
                i = i + 1;
            }
            return this.llvm_type(inner) + "*";
        }
        // Plain int/uint are 32-bit — the Python reference semantics
        // (C's int): literals, arithmetic and wrapping all live at i32,
        // with sext/trunc at the i64 runtime boundaries.
        if typ == "int" { return "i32"; }
        if typ == "uint" { return "i32"; }

        // C-spelling aliases (types.lsh: def double : type float<64>;)
        if typ == "double" || typ == "float64" { return "double"; }
        if typ == "float32" { return "float"; }
        if typ == "int64" || typ == "uint64" { return "i64"; }
        if typ == "int32" || typ == "uint32" { return "i32"; }
        if typ == "int16" || typ == "uint16" { return "i16"; }
        if typ == "int8" || typ == "uint8" { return "i8"; }
        if this.tc.is_fnc_type(typ) {
            fparts: vec<string> = this.tc.fnc_parts(typ);
            fps: string = "";
            fpi: int = 1;
            while fpi < fparts.size {
                if fpi > 1 { fps = fps + ", "; }
                fps = fps + this.llvm_type(fparts.get(fpi));
                fpi = fpi + 1;
            }
            return this.llvm_type(fparts.get(0)) + " (" + fps + ")*";
        }
        if typ == "float" { return "double"; }
        if typ == "float<64>" || typ == "float<32>" || typ == "float<16>" || typ == "float<128>" { return "double"; }
        // Sized ints keep their exact width (python parity): int<8> wraps
        // at 8 bits, it is not a 64-bit value. Only int<64>/uint<64> are
        // word-sized; wider/narrower widths use the generic iN rule below.
        if typ == "int<64>" { return "i64"; }
        if typ == "uint<64>" { return "i64"; }
        // int<N> / uint<N> for any width (1..1024): llvm iN
        if this.is_sized_int_type(typ) {
            w: int = this.sized_int_width(typ);
            if w > 0 && w <= 1024 { return "i" + tostring(w); }
        }
        if typ == "bool" { return "i1"; }
        if typ == "char" { return "i8"; }
        if typ == "string" { return "i8*"; }
        if typ == "void" { return "void"; }
        if typ == "nil" { return "i8*"; }

        if typ.size > 0 && typ[0] == '*' {
            // pointer: *T -> llvm_type(T)*
            inner: string = "";
            si: int = 1;
            while si < typ.size {
                inner = inner + typ[si];
                si = si + 1;
            }
            // `pointer<void>` (opaque native handle) is i8* — LLVM IR has
            // no void* (clang rejects it inside aggregate types).
            if inner == "void" { return "i8*"; }
            return this.llvm_type(inner) + "*";
        }

        if typ.size > 2 && typ[typ.size - 1] == ']' {
            // slice: { i64, T* }
            base: string = "";
            bi: int = 0;
            while bi < typ.size && typ[bi] != '[' {
                base = base + typ[bi];
                bi = bi + 1;
            }
            return "{ i64, " + this.llvm_type(base) + "* }";
        }

        // Tuple type: (T1, T2, ...) -> { t1, t2, ... }
        if typ.size > 1 && typ[0] == '(' && typ[typ.size - 1] == ')' {
            inner: string = "";
            ii: int = 1;
            while ii < typ.size - 1 {
                inner = inner + typ[ii];
                ii = ii + 1;
            }
            parts: string = "";
            depth: int = 0;
            cur: string = "";
            pi: int = 0;
            first_part: bool = true;
            while pi < inner.size {
                pch: char = inner[pi];
                if pch == '<' || pch == '(' { depth = depth + 1; }
                if pch == '>' || pch == ')' { depth = depth - 1; }
                if pch == ',' && depth == 0 {
                    if !first_part { parts = parts + ", "; }
                    parts = parts + this.llvm_type(this.trim_type_str(cur));
                    cur = "";
                    first_part = false;
                } else {
                    cur = cur + pch;
                }
                pi = pi + 1;
            }
            if cur.size > 0 {
                if !first_part { parts = parts + ", "; }
                parts = parts + this.llvm_type(this.trim_type_str(cur));
            }
            if parts.size == 0 { parts = "i64"; }
            return "{ " + parts + " }";
        }

        // vec<T>, hash<K,V>, File -> opaque pointer (i8*)
        if typ == "File" { return "i8*"; }
        if typ.size > 8 && typ[0] == 'f' && typ[1] == 'u' && typ[2] == 't' && typ[3] == 'u'
           && typ[4] == 'r' && typ[5] == 'e' && typ[6] == '<' { return "i8*"; }
        if this.is_vec_type(typ) { return "i8*"; }
        if this.is_hash_type(typ) { return "i8*"; }

        if this.tc.unions.isin(typ) {
            return "%union." + typ;
        }

        if this.tc.structs.isin(typ) {
            return "%struct." + typ + "*";
        }

        if this.tc.classes.isin(typ) {
            return "%class." + typ + "*";
        }

        // Enum values are plain ints (Python reference semantics)
        if this.tc.enums.isin(typ) {
            return "i32";
        }

        if (typ == "__T_OPDEF__" || typ == "thisop.typ") && this.opdef_inner.size > 0 {
            return this.llvm_type(this.opdef_inner);
        }

        // Instantiated-generic placeholders: `vec<T>` inside Stack_string's
        // methods resolves T through the instantiation's parameter map.
        ti2: int = 0;
        while ti2 + 1 < this.cur_tmap_names.size {
            nm2: string = this.cur_tmap_names.get(ti2);
            if nm2 == typ {
                return this.llvm_type(this.cur_tmap_names.get(ti2 + 1));
            }
            ti2 = ti2 + 2;
        }

        return "i64";
    }

    pub fnc tuple_elem_type(tup string, idx int) : string {
        inner: string = "";
        ii: int = 1;
        while ii < tup.size - 1 {
            inner = inner + tup[ii];
            ii = ii + 1;
        }
        depth: int = 0;
        cur: string = "";
        ei: int = 0;
        pi: int = 0;
        while pi < inner.size {
            pch: char = inner[pi];
            if pch == '<' || pch == '(' { depth = depth + 1; }
            if pch == '>' || pch == ')' { depth = depth - 1; }
            if pch == ',' && depth == 0 {
                if ei == idx { return this.trim_type_str(cur); }
                cur = "";
                ei = ei + 1;
            } else {
                cur = cur + pch;
            }
            pi = pi + 1;
        }
        if ei == idx { return this.trim_type_str(cur); }
        return "int";
    }

    pub fnc trim_type_str(s string) : string {
        a: int = 0;
        b: int = s.size - 1;
        while a < s.size && s[a] == ' ' { a = a + 1; }
        while b >= a && s[b] == ' ' { b = b - 1; }
        out: string = "";
        while a <= b {
            out = out + s[a];
            a = a + 1;
        }
        return out;
    }

    pub fnc const_str_of(s string) : string {
        lbl: string = this.get_str_constant(s);
        slen: int = this.get_str_len(s);
        r: string = this.new_reg();
        this.emit("  " + r + " = getelementptr inbounds [" + tostring(slen) + " x i8], [" + tostring(slen) + " x i8]* " + lbl + ", i64 0, i64 0");
        return r;
    }

    pub fnc type_size_of(t string) : int {
        if this.tc.unions.isin(t) { return 16; }
        if t == "int" { return 4; }
        if t == "char" { return 1; }
        if t == "bool" { return 1; }
        return 8;
    }

    // Byte width of an LLVM scalar type (for inttobytes/clamp-copy).
    pub fnc llvm_val_bytes(lty string) : int {
        if lty == "i8" || lty == "i1" { return 1; }
        if lty == "i16" { return 2; }
        if lty == "i32" { return 4; }
        w: int = this.lty_width(lty);
        if w > 0 { return (w + 7) / 8; }
        return 8;
    }

    pub oracle_depth: int;

    pub fnc get_expr_type(e Expr) : string {
        if e == null { return "void"; }
        if e.kind == ExprKind.INT { return "int"; }
        if e.kind == ExprKind.FLOAT { return "float"; }
        if e.kind == ExprKind.STRING { return "string"; }
        if e.kind == ExprKind.CHAR { return "char"; }
        if e.kind == ExprKind.BOOL { return "bool"; }
        if e.kind == ExprKind.NIL { return "nil"; }

        if e.kind == ExprKind.IDENT {
            if (e.sval == "_FILEPATH" || e.sval == "_FILENAME" || e.sval == "_PLATFORM") && !this.var_ptrs.isin(e.sval) {
                return "string";
            }
            if (e.sval == "self" || e.sval == "self::Class" || e.sval == "self::Parent") && !this.var_ptrs.isin("self") {
                return "string";
            }
            if this.tc.enum_str_consts.isin(e.sval) { return "string"; }
            if this.tc.enum_member_types.isin(e.sval) { return this.tc.enum_member_types[e.sval]; }
            if this.tc.enum_consts.isin(e.sval) {
                prefix: string = "";
                pi: int = 0;
                while pi < e.sval.size {
                    if e.sval[pi] == ':' {
                        return prefix;
                    }
                    prefix = prefix + e.sval[pi];
                    pi = pi + 1;
                }
            }
            if this.var_types.isin(e.sval) {
                return this.var_types[e.sval];
            }
            if this.tc.globals.isin(e.sval) {
                return this.tc.globals[e.sval];
            }
            if this.tc.funcs.isin(e.sval) {
                return this.tc.funcs[e.sval];
            }
            if this.tc.structs.isin(e.sval) { return e.sval; }
            if this.tc.classes.isin(e.sval) { return e.sval; }
            if this.tc.enums.isin(e.sval) { return e.sval; }
            return "int";
        }

        if e.kind == ExprKind.BINOP {
            if e.op != "==" && e.op != "!=" && e.op != "<" && e.op != "<=" &&
               e.op != ">" && e.op != ">=" && e.op != "&&" && e.op != "||" &&
               e.op != "is" && e.op != "isnt" && e.op != "isT" && e.op != "isntT" &&
               e.op != "<>" {
                gt_l: string = this.get_expr_type(e.left);
                if this.is_vec_type(gt_l) && this.is_vec_type(this.get_expr_type(e.right)) { return gt_l; }
            }
            if e.op == "==" || e.op == "!=" || e.op == "<" || e.op == "<=" ||
               e.op == ">" || e.op == ">=" || e.op == "&&" || e.op == "||" ||
               e.op == "is" || e.op == "isnt" || e.op == "isT" || e.op == "isntT" ||
               e.op == "<>" {
                return "bool";
            }
            lt: string = this.get_expr_type(e.left);
            rt: string = this.get_expr_type(e.right);
            // Scalar refs evaluate to their underlying value in arithmetic
            if lt.size > 1 && lt[0] == '&' {
                lst: string = this.strip_ref(lt);
                if !this.tc.structs.isin(lst) && !this.tc.classes.isin(lst) { lt = lst; }
            }
            if rt.size > 1 && rt[0] == '&' {
                rst: string = this.strip_ref(rt);
                if !this.tc.structs.isin(rst) && !this.tc.classes.isin(rst) { rt = rst; }
            }
            if lt == "string" || rt == "string" { return "string"; }
            if lt == "float" || rt == "float" || lt == "double" || rt == "double" { return "float"; }
            // Out-of-i32-range int literals are i64 constants in python
            // (codegen._const_int widens), so an int-family binop with one
            // operand runs at int<64> — stores truncate at the boundary.
            if (this.is_wide_int_lit(e.left) && (rt == "int" || rt == "uint" || rt == "char" || rt == "int64" || rt == "int<64>")) ||
               (this.is_wide_int_lit(e.right) && (lt == "int" || lt == "uint" || lt == "char" || lt == "int64" || lt == "int<64>")) {
                return "int<64>";
            }
            // Numeric ops promote like python's _check_binary_op: float
            // wins, uint+uint stays uint, char promotes to int — and the
            // wider int spelling survives so coercions match the real width.
            if lt == "char" || rt == "char" { return "int"; }
            if lt == "uint" && rt == "uint" { return "uint"; }
            if lt == "int64" || lt == "int<64>" || rt == "int64" || rt == "int<64>" {
                return "int<64>";
            }
            // Mixed int widths run at the wider operand (the emission
            // widens there too): the expression type must match the
            // register width or downstream loads/coercions misread it.
            lt_is_int: bool = lt == "int" || lt == "uint" || this.is_sized_int_type(lt);
            rt_is_int: bool = rt == "int" || rt == "uint" || this.is_sized_int_type(rt);
            if lt_is_int && rt_is_int {
                lw: int = this.lty_width(this.llvm_type(lt));
                rw: int = this.lty_width(this.llvm_type(rt));
                if rw > lw { return rt; }
            }
            return lt;
        }

        if e.kind == ExprKind.UNARY {
            if e.op == "await" { return this.strip_future(this.get_expr_type(e.left)); }
            if e.op == "!" { return "bool"; }
            // Inc/dec yields the operand's own type (prefix: new value,
            // postfix: old value — same width either way).
            if e.op == "++p" || e.op == "--p" || e.op == "++" || e.op == "--" {
                return this.get_expr_type(e.left);
            }
            if e.op == "~" && this.is_wide_int_lit(e.left) { return "int<64>"; }
            if e.op == "&" {
                if e.left.kind == ExprKind.IDENT && !this.var_ptrs.isin(e.left.sval) && this.tc.funcs.isin(e.left.sval) {
                    return this.tc.fn_type_str(e.left.sval);
                }
                return "*" + this.get_expr_type(e.left);
            }
            if e.op == "*" {
                pt: string = this.get_expr_type(e.left);
                if pt.size > 0 && pt[0] == '*' {
                    res: string = "";
                    pi: int = 1;
                    while pi < pt.size {
                        res = res + pt[pi];
                        pi = pi + 1;
                    }
                    return res;
                }
            }
            return this.get_expr_type(e.left);
        }

        if e.kind == ExprKind.CALL {
            if e.sval == "__toint_conv" && e.args.size > 0 && e.args.get(0).kind == ExprKind.STRING {
                return e.args.get(0).sval;
            }
            if this.tc.funcs.isin(e.sval) {
                return this.tc.funcs[e.sval];
            }
            if this.var_ptrs.isin(e.sval) && this.tc.is_fnc_type(this.var_types[e.sval]) {
                ec_parts: vec<string> = this.tc.fnc_parts(this.var_types[e.sval]);
                return ec_parts.get(0);
            }
            if this.tc.classes.isin(e.sval) {
                return e.sval;
            }
            if e.sval == "cstr" { return "char[]"; }
            if e.sval == "normescape" { return "string"; }
            if e.sval == "lstr" { return "string"; }
            if e.sval == "typeof" { return "string"; }
            if e.sval == "sizeof" { return "int"; }
            if e.sval == "tounion" && e.args.size > 0 && e.args.get(0).kind == ExprKind.STRING { return e.args.get(0).sval; }
            if e.sval == "inttobytes" || e.sval == "floattobytes" { return "char[]"; }
            if e.sval == "bytestoint" { return "int"; }
            if e.sval == "bytestofloat" { return "float"; }
            if e.sval == "rand" { return "int"; }
            if e.sval == "randf" { return "float"; }
            if e.sval == "seed" { return "void"; }
            if e.sval == "choose" { return "string"; }
            if e.sval == "wait" { return "void"; }
            if e.sval == "timepass" { return "float"; }
            if e.sval == "toint" {
                // Typed form: toint(int<64>, x) yields the target type
                if e.args.size == 2 && e.args.get(0).kind == ExprKind.STRING {
                    return this.tc.resolve_type_alias(e.args.get(0).sval);
                }
                return "int";
            }
            if e.sval == "tofloat" {
                if e.args.size == 2 && e.args.get(0).kind == ExprKind.STRING {
                    return this.tc.resolve_type_alias(e.args.get(0).sval);
                }
                return "float";
            }
            if e.sval == "tochar" { return "char"; }
            return "int";
        }

        if e.kind == ExprKind.METHOD_CALL {

            // Built-in File class (statics + instance methods)
            if e.left != null && e.left.kind == ExprKind.IDENT && e.left.sval == "File" {
                if e.sval == "open" { return "File"; }
                if e.sval == "rename" || e.sval == "delete" { return "int"; }
            }
            if e.left != null && e.left.kind == ExprKind.IDENT
               && this.var_types.isin(e.left.sval) && this.var_types[e.left.sval] == "File" {
                return this.file_method_ret(e.sval);
            }

            // File.open static method
            if e.sval == "open" && e.left.kind == ExprKind.IDENT && e.left.sval == "File" {
                return "File";
            }

            obj_t: string = this.strip_ref(this.get_expr_type(e.left));

            // Class method (walk parent chain for inherited methods)
            if this.tc.classes.isin(obj_t) {
                cl: ClassInfo = this.tc.classes[obj_t];
                mret: string = cl.get_method_ret(e.sval);
                mwalk: string = obj_t;
                mg: int = 0;
                while mret.size == 0 && mg < 16 {
                    if !this.tc.classes.isin(mwalk) { stop; }
                    mp: string = this.tc.classes[mwalk].parent;
                    if mp.size == 0 || !this.tc.classes.isin(mp) { stop; }
                    mwalk = mp;
                    mret = this.tc.classes[mwalk].get_method_ret(e.sval);
                    mg = mg + 1;
                }
                if mret.size > 0 { return mret; }
            }

            // Fallback: check funcs table with mangled name
            mname: string = obj_t + "_" + e.sval;
            if this.tc.funcs.isin(mname) {
                return this.tc.funcs[mname];
            }
            // Built-in method returns for non-class receivers
            if e.sval == "replace" { return "string"; }
            if e.sval == "pushb" || e.sval == "push" || e.sval == "write" || e.sval == "close" { return "void"; }
            if e.sval == "read" { return "string"; }
            if e.sval == "size" { return "int"; }
            if e.sval == "isin" { return "bool"; }

            // vec<T>.get / vec<T>.popb -> T
            if (e.sval == "get" || e.sval == "popb") && this.is_vec_type(obj_t) {
                return this.vec_inner_type(obj_t);
            }

            // hash<K,V>.get -> V  (also hash[key])
            if e.sval == "get" && this.is_hash_type(obj_t) {
                return this.hash_val_type(obj_t);
            }

            // hash extras
            if e.sval == "getKey" { return "string"; }
            if e.sval == "keys" { return "vec<string>"; }
            if e.sval == "values" { return "vec<int>"; }
            if e.sval == "delete" { return "void"; }

            return "void";
        }

        if e.kind == ExprKind.MEMBER {
            if e.sval == "size" { return "int"; }
            name_obj_t: string = this.strip_ref(this.get_expr_type(e.left));
            if e.sval == "name" && this.tc.enums.isin(name_obj_t) { return "string"; }
            if e.left.kind == ExprKind.IDENT && e.left.sval == "this" && this.current_class_name.size > 0 && this.tc.static_fields.isin(this.current_class_name + "_" + e.sval) {
                return this.tc.static_fields[this.current_class_name + "_" + e.sval];
            }
            if e.left.kind == ExprKind.IDENT && this.tc.static_fields.isin(e.left.sval + "_" + e.sval) {
                return this.tc.static_fields[e.left.sval + "_" + e.sval];
            }
            obj_t: string = this.strip_ref(this.get_expr_type(e.left));
            if this.tc.unions.isin(obj_t) {
                if e.sval == "cur" { return obj_t; }
                return this.tc.union_variant_type(obj_t, this.tc.union_variant_index(obj_t, e.sval));
            }
            if this.tc.structs.isin(obj_t) {
                st: StructInfo = this.tc.structs[obj_t];
                return st.get_field_type(e.sval);
            }
            if this.tc.classes.isin(obj_t) {
                cl: ClassInfo = this.tc.classes[obj_t];
                return cl.get_field_type(e.sval);
            }
            return "int";
        }

        // p->field : raw pointer member (strip one pointer level)
        if e.kind == ExprKind.POINTER_MEMBER {
            base: string = this.get_expr_type(e.left);
            if base.size > 1 && (base[0] == '*' || base[0] == '&') {
                base = this.strip_ref(base);
                // strip_ref only handles '&'; also strip a leading '*'
                if base.size > 1 && base[0] == '*' {
                    b2: string = "";
                    bi: int = 1;
                    while bi < base.size { b2 = b2 + base[bi]; bi = bi + 1; }
                    base = b2;
                }
            }
            if this.tc.structs.isin(base) {
                st2: StructInfo = this.tc.structs[base];
                return st2.get_field_type(e.sval);
            }
            if this.tc.classes.isin(base) {
                cl2: ClassInfo = this.tc.classes[base];
                return cl2.get_field_type(e.sval);
            }
            return "int";
        }

        if e.kind == ExprKind.INDEX {
            arr_t: string = this.strip_ref(this.get_expr_type(e.left));
            if arr_t == "string" { return "char"; }
            // vec<T>[idx] -> T
            if this.is_vec_type(arr_t) {
                return this.vec_inner_type(arr_t);
            }
            // hash<K,V>[key] -> V
            if this.is_hash_type(arr_t) {
                return this.hash_val_type(arr_t);
            }
            if arr_t.size > 2 && arr_t[arr_t.size - 1] == ']' {
                base_t: string = "";
                bi: int = 0;
                while bi < arr_t.size && arr_t[bi] != '[' {
                    base_t = base_t + arr_t[bi];
                    bi = bi + 1;
                }
                return base_t;
            }
            return "int";
        }

        if e.kind == ExprKind.TERNARY {
            return this.get_expr_type(e.left);
        }

        if e.kind == ExprKind.CAST {
            return e.sval;
        }

        if e.kind == ExprKind.STRUCT_INIT {
            return e.sval;
        }

        if e.kind == ExprKind.ARRAY_LIT {
            // Resolve the element type via codegen-local var_types: the
            // typechecker's scopes are already popped at codegen time, so
            // tc.infer_expr would fall back to "int" for local idents and
            // mis-type the slice ({i64, i32*} vs {i64, T**}), truncating
            // class-pointer elements during slice->vec conversion.
            if e.args.size > 0 { return this.get_expr_type(e.args.get(0)) + "[]"; }
            return "int[]";
        }

        return this.tc.infer_expr(e);
    }

    pub fnc is_named_arg(a Expr) : bool {
        if a == null { return false; }
        if a.kind == ExprKind.BINOP && a.op == "=" && a.left != null && a.left.kind == ExprKind.IDENT { return true; }
        return false;
    }

    // True when a CALL's arguments must be reordered / filled with defaults.
    pub fnc needs_arg_align_k(e Expr, fkey string) : bool {
        if !this.tc.func_params.isin(fkey) { return false; }
        // Variadic C builtins (printf, ...) accept any number of extra
        // positional args: aligning them to the fixed signature would
        // truncate the call.
        if this.tc.is_variadic_builtin(fkey) { return false; }
        fp0: vec<string> = this.tc.func_params[fkey];
        if e.args.size != fp0.size { return true; }
        foreach _, a0 in<vector> e.args {
            if this.is_named_arg(a0) { return true; }
        }
        return false;
    }

    pub fnc needs_arg_align(e Expr) : bool {
        if e.kind != ExprKind.CALL { return false; }
        return this.needs_arg_align_k(e, e.sval);
    }

    // Reorder named args into positional order and fill in default values.
    pub fnc align_call_args_k(e Expr, fkey string) : vec<Expr> {
        res: vec<Expr>;
        fp: vec<string>;
        if this.tc.func_params.isin(fkey) { fp = this.tc.func_params[fkey]; }
        pnames: vec<string>;
        if this.tc.func_param_names.isin(fkey) { pnames = this.tc.func_param_names[fkey]; }

        pos_args: vec<Expr>;
        named: hash<string, Expr>;
        foreach _, a in<vector> e.args {
            if this.is_named_arg(a) { named.push(a.left.sval, a.right); }
            else { pos_args.pushb(a); }
        }

        nparams: int = fp.size;
        if nparams < pnames.size { nparams = pnames.size; }

        ai: int = 0;
        while ai < nparams {
            def_key: string = fkey + "::" + tostring(ai);
            if ai < pos_args.size {
                res.pushb(pos_args.get(ai));
            } also ai < pnames.size && named.isin(pnames.get(ai)) {
                res.pushb(named[pnames.get(ai)]);
            } also this.tc.func_defaults.isin(def_key) {
                res.pushb(this.tc.func_defaults[def_key]);
            } else {
                stop;
            }
            ai = ai + 1;
        }
        return res;
    }

    pub fnc align_call_args(e Expr) : vec<Expr> {
        return this.align_call_args_k(e, e.sval);
    }

    pub fnc tp_has_prefix(sv string, pre string) : bool {
        if sv.size < pre.size { return false; }
        pi: int = 0;
        while pi < pre.size {
            if sv[pi] != pre[pi] { return false; }
            pi = pi + 1;
        }
        return true;
    }

    // Loose type equality used by `expr is Type` (mirrors python's _types_match)
    pub fnc is_type_match(lt string, rt string) : bool {
        if lt == rt { return true; }
        if lt.size == 0 || rt.size == 0 { return false; }
        if (lt == "int" && this.tp_has_prefix(rt, "int")) || (this.tp_has_prefix(lt, "int") && rt == "int") { return true; }
        if (lt == "uint" && this.tp_has_prefix(rt, "uint")) || (this.tp_has_prefix(lt, "uint") && rt == "uint") { return true; }
        if (lt == "float" && this.tp_has_prefix(rt, "float")) || (this.tp_has_prefix(lt, "float") && rt == "float") { return true; }
        return false;
    }

    // Base element type of `T[n]` / `T[]`
    pub fnc slice_base_type(t string) : string {
        base: string = "";
        bi: int = 0;
        while bi < t.size && t[bi] != '[' {
            base = base + t[bi];
            bi = bi + 1;
        }
        return base;
    }

    // True allocation size of an LLVM struct/class type (GEP-past-the-end
    // of null): field-count*8 undercounts wide fields (i128+), inline
    // struct values, fixed-array slots, and padding, overflowing into
    // neighbouring heap memory. Same idiom as clone_struct_val.
    pub fnc type_alloc_size(tname string) : string {
        szg: string = this.new_reg();
        this.emit("  " + szg + " = getelementptr " + tname + ", " + tname + "* null, i32 1");
        szr: string = this.new_reg();
        this.emit("  " + szr + " = ptrtoint " + tname + "* " + szg + " to i64");
        return szr;
    }

    // Value comparison for `expr is expr` -> i1
    pub fnc gen_is_value(l Expr, r Expr, lt string, rt string) : string {
        if lt == "string" || rt == "string" {
            lv: string = this.gen_expr(l);
            rv: string = this.gen_expr(r);
            sc: string = this.new_reg();
            this.emit("  " + sc + " = call i32 @strcmp(i8* " + lv + ", i8* " + rv + ")");
            sr: string = this.new_reg();
            this.emit("  " + sr + " = icmp eq i32 " + sc + ", 0");
            return sr;
        }

        llty: string = this.llvm_type(lt);
        rlty: string = this.llvm_type(rt);

        // Slices / fixed arrays: { len, ptr } — compare length + bytes
        if llty.size > 1 && llty[0] == '{' && rlty.size > 1 && rlty[0] == '{' {
            lv2: string = this.gen_expr(l);
            rv2: string = this.gen_expr(r);
            la: string = this.new_reg();
            this.emit("  " + la + " = extractvalue " + llty + " " + lv2 + ", 0");
            pa: string = this.new_reg();
            this.emit("  " + pa + " = extractvalue " + llty + " " + lv2 + ", 1");
            lb: string = this.new_reg();
            this.emit("  " + lb + " = extractvalue " + rlty + " " + rv2 + ", 0");
            pb: string = this.new_reg();
            this.emit("  " + pb + " = extractvalue " + rlty + " " + rv2 + ", 1");
            ba: string = this.new_reg();
            this.emit("  " + ba + " = bitcast " + this.ptr_type_of_val(llty, 1) + " " + pa + " to i8*");
            bb: string = this.new_reg();
            this.emit("  " + bb + " = bitcast " + this.ptr_type_of_val(rlty, 1) + " " + pb + " to i8*");
            szq: string = this.new_reg();
            this.emit("  " + szq + " = icmp eq i64 " + la + ", " + lb + "");
            ptq: string = this.new_reg();
            this.emit("  " + ptq + " = icmp eq i8* " + ba + ", " + bb + "");
            eb: int = this.llvm_val_bytes(this.llvm_type(this.slice_base_type(lt)));
            byt: string = this.new_reg();
            this.emit("  " + byt + " = mul i64 " + la + ", " + tostring(eb));
            mc: string = this.new_reg();
            this.emit("  " + mc + " = call i64 @memcmp(i8* " + ba + ", i8* " + bb + ", i64 " + byt + ")");
            mceq: string = this.new_reg();
            this.emit("  " + mceq + " = icmp eq i64 " + mc + ", 0");
            cont: string = this.new_reg();
            this.emit("  " + cont + " = or i1 " + ptq + ", " + mceq + "");
            res: string = this.new_reg();
            this.emit("  " + res + " = and i1 " + szq + ", " + cont + "");
            return res;
        }

        // Boxed vec<T> deep comparison
        if this.is_vec_type(lt) && this.is_vec_type(rt) {
            lv3: string = this.gen_expr(l);
            rv3: string = this.gen_expr(r);
            vinner: string = this.vec_inner_type(lt);
            vmode: int = 0;
            if vinner == "float" { vmode = 1; }
            also vinner == "string" || !this.tc.structs.isin(vinner) && !this.tc.classes.isin(vinner) && vinner != "int" && vinner != "float" && vinner != "bool" && vinner != "char" && vinner != "uint" { vmode = 2; }
            vr: string = this.new_reg();
            this.emit("  " + vr + " = call i64 @leash_sh_vec_eq(i8* " + lv3 + ", i8* " + rv3 + ", i64 " + tostring(vmode) + ")");
            vr1: string = this.new_reg();
            this.emit("  " + vr1 + " = icmp ne i64 " + vr + ", 0");
            return vr1;
        }

        lv4: string = this.gen_expr(l);
        rv4: string = this.gen_expr(r);

        if llty == "double" || rlty == "double" {
            fr: string = this.new_reg();
            this.emit("  " + fr + " = fcmp oeq double " + lv4 + ", " + rv4 + "");
            return fr;
        }
        if llty.size > 1 && llty[0] == 'i' && rlty.size > 1 && rlty[0] == 'i' {
            ir_: string = this.new_reg();
            this.emit("  " + ir_ + " = icmp eq " + llty + " " + lv4 + ", " + rlty + " " + rv4 + "");
            return ir_;
        }
        return "0";
    }

    // LLVM type of field `idx` inside a literal struct type
    pub fnc ptr_type_of_val(st string, idx int) : string {
        depth: int = 0;
        ci: int = 0;
        field: int = 0;
        cur: string = "";
        i: int = 1;
        while i < st.size - 1 {
            c: char = st[i];
            if c == '{' || c == '(' { depth = depth + 1; }
            if c == '}' || c == ')' { depth = depth - 1; }
            if c == ',' && depth == 0 {
                if field == idx { return this.trim_type_str(cur); }
                cur = "";
                field = field + 1;
            } else {
                cur = cur + c;
            }
            i = i + 1;
        }
        if field == idx { return this.trim_type_str(cur); }
        return "i8*";
    }

    pub fnc strip_future(t string) : string {
        if t.size > 8 && t[0] == 'f' && t[1] == 'u' && t[2] == 't' && t[3] == 'u'
           && t[4] == 'r' && t[5] == 'e' && t[6] == '<' && t[t.size - 1] == '>' {
            out: string = "";
            i: int = 7;
            while i < t.size - 1 {
                out = out + t[i];
                i = i + 1;
            }
            return out;
        }
        return t;
    }

    // Python's file_method_returns map (default "int")
    pub fnc file_method_ret(m string) : string {
        if m == "read" { return "string"; }
        if m == "write" { return "int"; }
        if m == "close" { return "int"; }
        if m == "writeb" { return "int"; }
        if m == "readb" { return "char[]"; }
        if m == "readln" { return "string"; }
        if m == "readlnb" { return "char[]"; }
        if m == "replace" { return "int"; }
        if m == "replaceall" { return "int"; }
        if m == "rewind" { return "void"; }
        return "int";
    }

    pub fnc gen_expr(e Expr) : string {
        if e == null { return "0"; }

        if e.kind == ExprKind.INT {
            // Raw literal text is kept for arbitrary-width constants; LLVM
            // accepts decimal constants of any width in the .ll text.
            // Non-decimal forms (0x.., 0b..) keep the parsed i64 value.
            if e.sval.size > 0 && this.is_plain_decimal_lit(e.sval) { return e.sval; }
            return tostring(e.ival);
        }

        if e.kind == ExprKind.FLOAT {
            if e.sval.size > 0 {
                lit: string = e.sval;
                // LLVM float literals require digits on both sides of '.'
                if lit[0] == '.' { lit = "0" + lit; }
                if lit[lit.size - 1] == '.' { lit = lit + "0"; }
                // Scientific notation needs a '.' before the exponent:
                // `1e-15` parses as hex in LLVM, `1.0e-15` does not.
                has_dot: bool = false;
                sci_i: int = -1;
                li: int = 0;
                while li < lit.size {
                    if lit[li] == '.' { has_dot = true; }
                    also (lit[li] == 'e' || lit[li] == 'E') && sci_i < 0 { sci_i = li; }
                    li = li + 1;
                }
                if sci_i > 0 && !has_dot {
                    lit = this.str_slice2(lit, 0, sci_i) + ".0" + this.str_slice2(lit, sci_i, lit.size);
                }
                return lit;
            }
            return tostring(e.fval);
        }

        if e.kind == ExprKind.STRING {
            lbl: string = this.get_str_constant(e.sval);
            slen: int = this.get_str_len(e.sval);
            r: string = this.new_reg();
            this.emit("  " + r + " = getelementptr inbounds [" + tostring(slen) + " x i8], [" + tostring(slen) + " x i8]* " + lbl + ", i64 0, i64 0");
            return r;
        }

        if e.kind == ExprKind.CHAR {
            return tostring((int)e.cval);
        }

        if e.kind == ExprKind.BOOL {
            return e.bval ? "1" : "0";
        }

        if e.kind == ExprKind.NIL {
            return "null";
        }

        if e.kind == ExprKind.IDENT {
            if (e.sval == "_FILEPATH" || e.sval == "_FILENAME" || e.sval == "_PLATFORM") && !this.var_ptrs.isin(e.sval) {
                meta_str: string = this.main_file;
                if e.sval == "_PLATFORM" { meta_str = "linux64"; }
                if e.sval == "_FILENAME" {
                    base_only: string = "";
                    last_slash: int = -1;
                    mi: int = 0;
                    while mi < this.main_file.size {
                        if this.main_file[mi] == '/' { last_slash = mi; }
                        mi = mi + 1;
                    }
                    mi = last_slash + 1;
                    while mi < this.main_file.size {
                        base_only = base_only + this.main_file[mi];
                        mi = mi + 1;
                    }
                    meta_str = base_only;
                }
                meta_lbl: string = this.get_str_constant(meta_str);
                meta_len: int = this.get_str_len(meta_str);
                meta_gep: string = this.new_reg();
                this.emit("  " + meta_gep + " = getelementptr inbounds [" + tostring(meta_len) + " x i8], [" + tostring(meta_len) + " x i8]* " + meta_lbl + ", i64 0, i64 0");
                return meta_gep;
            }
            if e.sval == "self" && !this.var_ptrs.isin("self") {
                self_name: string = this.current_func_name;
                // Inside an error definition `self` is the error's own name
                if self_name.size > 7 && self_name[0] == '_' && self_name[1] == 'e' && self_name[2] == 'r'
                   && self_name[3] == 'r' && self_name[4] == 'o' && self_name[5] == 'r' && self_name[6] == '_' {
                    err_only: string = "";
                    ei: int = 7;
                    while ei < self_name.size {
                        err_only = err_only + self_name[ei];
                        ei = ei + 1;
                    }
                    self_name = err_only;
                }
                if this.current_class_name.size > 0 && self_name.size > this.current_class_name.size + 1 && self_name[this.current_class_name.size] == '_' {
                    sn_guard: int = 0;
                    sn_ok: bool = true;
                    while sn_guard < this.current_class_name.size {
                        if self_name[sn_guard] != this.current_class_name[sn_guard] { sn_ok = false; stop; }
                        sn_guard = sn_guard + 1;
                    }
                    if sn_ok {
                        stripped: string = "";
                        si2: int = this.current_class_name.size + 1;
                        while si2 < self_name.size {
                            stripped = stripped + self_name[si2];
                            si2 = si2 + 1;
                        }
                        self_name = stripped;
                    }
                }
                self_lbl: string = this.get_str_constant(self_name);
                self_len: int = this.get_str_len(self_name);
                self_gep: string = this.new_reg();
                this.emit("  " + self_gep + " = getelementptr inbounds [" + tostring(self_len) + " x i8], [" + tostring(self_len) + " x i8]* " + self_lbl + ", i64 0, i64 0");
                return self_gep;
            }
            if e.sval == "self::Class" && !this.var_ptrs.isin("self") {
                self_lbl: string = this.get_str_constant(this.current_class_name);
                self_len: int = this.get_str_len(this.current_class_name);
                self_gep: string = this.new_reg();
                this.emit("  " + self_gep + " = getelementptr inbounds [" + tostring(self_len) + " x i8], [" + tostring(self_len) + " x i8]* " + self_lbl + ", i64 0, i64 0");
                return self_gep;
            }
            if e.sval == "self::Parent" && !this.var_ptrs.isin("self") {
                self_lbl: string = this.get_str_constant(this.current_class_parent);
                self_len: int = this.get_str_len(this.current_class_parent);
                self_gep: string = this.new_reg();
                this.emit("  " + self_gep + " = getelementptr inbounds [" + tostring(self_len) + " x i8], [" + tostring(self_len) + " x i8]* " + self_lbl + ", i64 0, i64 0");
                return self_gep;
            }
            if this.tc.enum_str_consts.isin(e.sval) {
                ev_s: string = this.tc.enum_str_consts[e.sval];
                ev_lbl: string = this.get_str_constant(ev_s);
                ev_len: int = this.get_str_len(ev_s);
                ev_gep: string = this.new_reg();
                this.emit("  " + ev_gep + " = getelementptr inbounds [" + tostring(ev_len) + " x i8], [" + tostring(ev_len) + " x i8]* " + ev_lbl + ", i64 0, i64 0");
                return ev_gep;
            }
            if this.tc.enum_consts.isin(e.sval) {
                return tostring(this.tc.enum_consts[e.sval]);
            }
            if this.var_ptrs.isin(e.sval) {
                ptr: string = this.var_ptrs[e.sval];
                vtype: string = this.var_types[e.sval];
                lty: string = this.llvm_type(vtype);
                r: string = this.new_reg();
                this.emit("  " + r + " = load " + lty + ", " + lty + "* " + ptr);
                // Scalar refs unwrap to the referenced value (python parity)
                while vtype.size > 1 && vtype[0] == '&' {
                    inner: string = this.strip_ref(vtype);
                    if this.tc.structs.isin(inner) || this.tc.classes.isin(inner) { stop; }
                    ilty: string = this.llvm_type(inner);
                    r2: string = this.new_reg();
                    this.emit("  " + r2 + " = load " + ilty + ", " + ilty + "* " + r);
                    r = r2;
                    vtype = inner;
                }
                return r;
            }
            if this.global_vars.isin(e.sval) {
                gv_t: string = this.global_vars[e.sval];
                gv_lty: string = this.llvm_type(gv_t);
                r: string = this.new_reg();
                if this.fusion_int_width(e.sval) > 0 {
                    this.emit("  " + r + " = load atomic " + gv_lty + ", " + gv_lty + "* @g_" + e.sval + " seq_cst, align " + tostring(this.fusion_align(gv_lty)));
                } else {
                    this.emit("  " + r + " = load " + gv_lty + ", " + gv_lty + "* @g_" + e.sval);
                }
                return r;
            }
            // Check enum constant: Name::VARIANT
            // Fallback
            return "0";
        }

        if e.kind == ExprKind.BINOP {
            // `expr is Type` / `expr isnt Type` — folded at compile time
            if e.op == "isT" || e.op == "isntT" {
                it_l: string = this.get_expr_type(e.left);
                it_ok: bool = this.is_type_match(it_l, e.right.sval);
                if e.op == "isntT" { it_ok = !it_ok; }
                if it_ok { return "1"; }
                return "0";
            }
            // `expr is value` / `expr isnt value`
            if e.op == "is" || e.op == "isnt" {
                iv_l: string = this.get_expr_type(e.left);
                iv_r: string = this.get_expr_type(e.right);
                iv_v: string = this.gen_is_value(e.left, e.right, iv_l, iv_r);
                if e.op == "isnt" {
                    iv_n: string = this.new_reg();
                    this.emit("  " + iv_n + " = xor i1 " + iv_v + ", 1");
                    return iv_n;
                }
                return iv_v;
            }

            // Logical && / || short-circuit: the right operand is only
            // evaluated when the left one has not already decided the result.
            if e.op == "&&" || e.op == "||" {
                sc_lv: string = this.to_bool_val(this.gen_expr(e.left), this.get_expr_type(e.left));
                sc_slot: string = this.new_reg();
                this.emit("  " + sc_slot + " = alloca i1, align 1");
                sc_init: string = "0";
                if e.op == "||" { sc_init = "1"; }
                this.emit("  store i1 " + sc_init + ", i1* " + sc_slot);
                sc_right: string = this.new_label("b_sc_r");
                sc_merge: string = this.new_label("b_sc_m");
                if e.op == "&&" {
                    this.emit("  br i1 " + sc_lv + ", label %" + sc_right + ", label %" + sc_merge);
                } else {
                    this.emit("  br i1 " + sc_lv + ", label %" + sc_merge + ", label %" + sc_right);
                }
                this.current_block_terminated = true;
                this.emit(sc_right + ":");
                this.current_block_terminated = false;
                sc_rv: string = this.to_bool_val(this.gen_expr(e.right), this.get_expr_type(e.right));
                this.emit("  store i1 " + sc_rv + ", i1* " + sc_slot);
                this.emit("  br label %" + sc_merge);
                this.current_block_terminated = true;
                this.emit(sc_merge + ":");
                this.current_block_terminated = false;
                sc_res: string = this.new_reg();
                this.emit("  " + sc_res + " = load i1, i1* " + sc_slot);
                return sc_res;
            }

            lt: string = this.get_expr_type(e.left);
            rt: string = this.get_expr_type(e.right);

            // Scalar refs evaluate to their underlying value in arithmetic
            if lt.size > 1 && lt[0] == '&' {
                lst: string = this.strip_ref(lt);
                if !this.tc.structs.isin(lst) && !this.tc.classes.isin(lst) { lt = lst; }
            }
            if rt.size > 1 && rt[0] == '&' {
                rst: string = this.strip_ref(rt);
                if !this.tc.structs.isin(rst) && !this.tc.classes.isin(rst) { rt = rst; }
            }

            // Element-wise container arithmetic (vec<T> / matrix<T>)
            if this.is_vec_type(lt) && this.is_vec_type(rt) {
                cb_op: int = -1;
                if e.op == "+" { cb_op = 0; }
                also e.op == "-" { cb_op = 1; }
                also e.op == "*" { cb_op = 2; }
                also e.op == "/" { cb_op = 3; }
                if cb_op >= 0 {
                    cb_l: string = this.gen_expr(e.left);
                    cb_r: string = this.gen_expr(e.right);
                    cb_mode: int = 0;
                    cb_inner: string = this.vec_inner_type(lt);
                    if cb_inner == "float" { cb_mode = 1; }
                    cb_res: string = this.new_reg();
                    this.emit("  " + cb_res + " = call i8* @leash_sh_vec_binop(i8* " + cb_l + ", i8* " + cb_r + ", i64 " + tostring(cb_op) + ", i64 " + tostring(cb_mode) + ")");
                    this.af_track(cb_res);
                    return cb_res;
                }
            }

            // Pointer arithmetic: *T +/- int (leash '*'-typed operands)
            if e.op == "+" || e.op == "-" {
                l_is_ptr: bool = lt.size > 1 && lt[0] == '*';
                r_is_ptr: bool = rt.size > 1 && rt[0] == '*';
                l_is_int: bool = lt == "int" || (lt.size > 4 && lt[0] == 'i' && lt[1] == 'n' && lt[2] == 't' && lt[3] == '<');
                r_is_int: bool = rt == "int" || (rt.size > 4 && rt[0] == 'i' && rt[1] == 'n' && rt[2] == 't' && rt[3] == '<');
                if l_is_ptr && r_is_int {
                    l_val: string = this.gen_expr(e.left);
                    r_val: string = this.gen_expr(e.right);
                    elem: string = "";
                    ei: int = 1;
                    while ei < lt.size { elem = elem + lt[ei]; ei = ei + 1; }
                    elty: string = this.llvm_type(elem);
                    gep_r: string = this.new_reg();
                    idx_s: string = r_val;
                    if e.op == "-" {
                        neg_r: string = this.new_reg();
                        this.emit("  " + neg_r + " = sub i64 0, " + r_val);
                        idx_s = neg_r;
                    }
                    this.emit("  " + gep_r + " = getelementptr " + elty + ", " + elty + "* " + l_val + ", i64 " + idx_s);
                    return gep_r;
                }
                if e.op == "+" && r_is_ptr && l_is_int {
                    l_val2: string = this.gen_expr(e.left);
                    r_val2: string = this.gen_expr(e.right);
                    elem2: string = "";
                    ei2: int = 1;
                    while ei2 < rt.size { elem2 = elem2 + rt[ei2]; ei2 = ei2 + 1; }
                    elty2: string = this.llvm_type(elem2);
                    gep_r2: string = this.new_reg();
                    this.emit("  " + gep_r2 + " = getelementptr " + elty2 + ", " + elty2 + "* " + r_val2 + ", i64 " + l_val2);
                    return gep_r2;
                }
            }

            // String concatenation (also accepts char[] slices)
            if (lt == "string" || rt == "string" || lt == "char[]" || rt == "char[]") && e.op == "+" {
                l_val: string = this.gen_expr(e.left);
                r_val: string = this.gen_expr(e.right);
                if lt == "char[]" {
                    sl_len: string = this.new_reg();
                    this.emit("  " + sl_len + " = extractvalue { i64, i8* } " + l_val + ", 0");
                    sl_ptr: string = this.new_reg();
                    this.emit("  " + sl_ptr + " = extractvalue { i64, i8* } " + l_val + ", 1");
                    conv_l: string = this.new_reg();
                    this.emit("  " + conv_l + " = call i8* @leash_sh_slice_to_str(i64 " + sl_len + ", i8* " + sl_ptr + ")");
                    this.af_track(conv_l);
                    l_val = conv_l;
                }
                if rt == "char[]" {
                    sl_len_r: string = this.new_reg();
                    this.emit("  " + sl_len_r + " = extractvalue { i64, i8* } " + r_val + ", 0");
                    sl_ptr_r: string = this.new_reg();
                    this.emit("  " + sl_ptr_r + " = extractvalue { i64, i8* } " + r_val + ", 1");
                    conv_r: string = this.new_reg();
                    this.emit("  " + conv_r + " = call i8* @leash_sh_slice_to_str(i64 " + sl_len_r + ", i8* " + sl_ptr_r + ")");
                    this.af_track(conv_r);
                    r_val = conv_r;
                }

                // Int-family operands convert to their decimal string
                // (python formats signed/unsigned per the leash type).
                if lt == "int" || lt == "uint" || this.is_sized_int_type(lt) {
                    l_val = this.concat_int_to_str(e.left, l_val, lt);
                }
                if rt == "int" || rt == "uint" || this.is_sized_int_type(rt) {
                    r_val = this.concat_int_to_str(e.right, r_val, rt);
                }
                // char operands are materialized as single-char strings
                if lt == "char" {
                    conv_l: string = this.new_reg();
                    this.emit("  " + conv_l + " = call i8* @leash_gc_malloc(i64 2)");
                    this.emit("  store i8 " + l_val + ", i8* " + conv_l);
                    gep_l: string = this.new_reg();
                    this.emit("  " + gep_l + " = getelementptr inbounds i8, i8* " + conv_l + ", i64 1");
                    this.emit("  store i8 0, i8* " + gep_l);
                    l_val = conv_l;
                }
                if rt == "char" {
                    conv_r: string = this.new_reg();
                    this.emit("  " + conv_r + " = call i8* @leash_gc_malloc(i64 2)");
                    this.emit("  store i8 " + r_val + ", i8* " + conv_r);
                    gep_r: string = this.new_reg();
                    this.emit("  " + gep_r + " = getelementptr inbounds i8, i8* " + conv_r + ", i64 1");
                    this.emit("  store i8 0, i8* " + gep_r);
                    r_val = conv_r;
                }

                res: string = this.new_reg();
                this.emit("  " + res + " = call i8* @leash_str_concat(i8* " + l_val + ", i8* " + r_val + ")");
                this.af_track(res);
                return res;
            }

            // Containment: value <> collection
            if e.op == "<>" {
                rh_t: string = this.strip_ref(this.get_expr_type(e.right));
                l_val: string = this.gen_expr(e.left);
                rh_val: string = this.gen_expr(e.right);
                res: string = this.new_reg();
                res_is_phi: bool = false;
                if rh_t == "string" {
                    this.emit("  " + res + " = call i64 @leash_sh_str_isin(i8* " + l_val + ", i8* " + rh_val + ")");
                } also this.is_vec_type(rh_t) {
                    li_t: string = this.strip_ref(this.get_expr_type(e.left));
                    li_elt: string = this.llvm_type(li_t);
                    li_sc: string = this.new_reg();
                    this.emit("  " + li_sc + " = bitcast [64 x i8]* @__lsh_scratch to " + li_elt + "*");
                    this.emit("  store " + li_elt + " " + l_val + ", " + li_elt + "* " + li_sc);
                    li_sc8: string = this.scratch_i8p();
                    li_mode: int = 0;
                    if li_t == "string" { li_mode = 1; }
                    this.emit("  " + res + " = call i64 @leash_sh_vec_isin(i8* " + rh_val + ", i8* " + li_sc8 + ", i64 " + tostring(li_mode) + ")");
                } also rh_t.size > 2 && rh_t[rh_t.size - 1] == ']' {
                    rh_lty: string = this.llvm_type(rh_t);
                    arr_len: string = this.new_reg();
                    this.emit("  " + arr_len + " = extractvalue " + rh_lty + " " + rh_val + ", 0");
                    arr_ptr: string = this.new_reg();
                    this.emit("  " + arr_ptr + " = extractvalue " + rh_lty + " " + rh_val + ", 1");
                    base_t: string = "";
                    bi2: int = 0;
                    while bi2 < rh_t.size && rh_t[bi2] != '[' {
                        base_t = base_t + rh_t[bi2];
                        bi2 = bi2 + 1;
                    }
                    blt2: string = this.llvm_type(base_t);
                    if blt2 == "i8*" {
                        arr_bc: string = this.new_reg();
                        this.emit("  " + arr_bc + " = bitcast i8* " + arr_ptr + " to i8**");
                        this.emit("  " + res + " = call i64 @leash_sh_arr_isin_str(i8* " + l_val + ", i8** " + arr_bc + ", i64 " + arr_len + ")");
                    } also blt2 == "double" {
                        arr_bc: string = this.new_reg();
                        this.emit("  " + arr_bc + " = bitcast i8* " + arr_ptr + " to double*");
                        this.emit("  " + res + " = call i64 @leash_sh_arr_isin_f64(double " + l_val + ", double* " + arr_bc + ", i64 " + arr_len + ")");
                    } also blt2 == "i8" {
                        this.emit("  " + res + " = call i64 @leash_sh_arr_isin_i8(i8 " + l_val + ", i8* " + arr_ptr + ", i64 " + arr_len + ")");
                    } also this.is_int_lty(blt2) {
                        // Integer arrays: inline scan at the element width
                        // (python emits the same loop inline)
                        ibc: string = this.new_reg();
                        this.emit("  " + ibc + " = bitcast i8* " + arr_ptr + " to " + blt2 + "*");
                        i_slot: string = this.new_reg();
                        this.emit("  " + i_slot + " = alloca i64");
                        this.emit("  store i64 0, i64* " + i_slot);
                        l_head: string = this.new_label("isin_il");
                        l_yes: string = this.new_label("isin_yes");
                        l_no: string = this.new_label("isin_no");
                        l_done: string = this.new_label("isin_done");
                        this.emit("  br label %" + l_head);
                        this.emit(l_head + ":");
                        i_cur: string = this.new_reg();
                        this.emit("  " + i_cur + " = load i64, i64* " + i_slot);
                        i_ok: string = this.new_reg();
                        this.emit("  " + i_ok + " = icmp ult i64 " + i_cur + ", " + arr_len);
                        this.emit("  br i1 " + i_ok + ", label %" + l_yes + ", label %" + l_no);
                        this.emit(l_yes + ":");
                        i_ep: string = this.new_reg();
                        this.emit("  " + i_ep + " = getelementptr inbounds " + blt2 + ", " + blt2 + "* " + ibc + ", i64 " + i_cur);
                        i_ev: string = this.new_reg();
                        this.emit("  " + i_ev + " = load " + blt2 + ", " + blt2 + "* " + i_ep);
                        i_eq: string = this.new_reg();
                        this.emit("  " + i_eq + " = icmp eq " + blt2 + " " + i_ev + ", " + l_val);
                        i_next: string = this.new_reg();
                        this.emit("  " + i_next + " = add i64 " + i_cur + ", 1");
                        this.emit("  store i64 " + i_next + ", i64* " + i_slot);
                        this.emit("  br i1 " + i_eq + ", label %" + l_done + ", label %" + l_head);
                        this.emit(l_no + ":");
                        this.emit("  br label %" + l_done);
                        this.emit(l_done + ":");
                        this.emit("  " + res + " = phi i1 [ 1, %" + l_yes + " ], [ 0, %" + l_no + " ]");
                        res_is_phi = true;
                    } else {
                        arr_bc: string = this.new_reg();
                        this.emit("  " + arr_bc + " = bitcast i8* " + arr_ptr + " to i64*");
                        l_lty2: string = this.llvm_type(this.strip_ref(this.get_expr_type(e.left)));
                        l_pass: string = l_val;
                        if l_lty2 == "i8" || l_lty2 == "i1" {
                            l_pass = this.new_reg();
                            this.emit("  " + l_pass + " = zext " + l_lty2 + " " + l_val + " to i64");
                        } also l_lty2.size > 1 && l_lty2[l_lty2.size - 1] == '*' {
                            l_pass = this.new_reg();
                            this.emit("  " + l_pass + " = ptrtoint " + l_lty2 + " " + l_val + " to i64");
                        }
                        this.emit("  " + res + " = call i64 @leash_sh_arr_isin_i64(i64 " + l_pass + ", i64* " + arr_bc + ", i64 " + arr_len + ")");
                    }
                } else {
                    this.emit("  " + res + " = call i64 @leash_sh_str_isin(i8* " + l_val + ", i8* " + rh_val + ")");
                }
                if res_is_phi {
                    return res;
                }
                bool_r: string = this.new_reg();
                this.emit("  " + bool_r + " = trunc i64 " + res + " to i1");
                return bool_r;
            }

            // String subtraction: remove all occurrences
            if lt == "string" && rt == "string" && e.op == "-" {
                l_val: string = this.gen_expr(e.left);
                r_val: string = this.gen_expr(e.right);
                res: string = this.new_reg();
                this.emit("  " + res + " = call i8* @leash_sh_str_sub(i8* " + l_val + ", i8* " + r_val + ")");
                this.af_track(res);
                return res;
            }

            // String equality
            if lt == "string" && rt == "string" && (e.op == "==" || e.op == "!=") {
                l_val: string = this.gen_expr(e.left);
                r_val: string = this.gen_expr(e.right);
                cmp_res: string = this.new_reg();
                this.emit("  " + cmp_res + " = call i32 @strcmp(i8* " + l_val + ", i8* " + r_val + ")");
                res: string = this.new_reg();
                if e.op == "==" {
                    this.emit("  " + res + " = icmp eq i32 " + cmp_res + ", 0");
                } else {
                    this.emit("  " + res + " = icmp ne i32 " + cmp_res + ", 0");
                }
                return res;
            }

            l_val: string = this.gen_expr(e.left);
            r_val: string = this.gen_expr(e.right);
            res: string = this.new_reg();
            lty: string = this.llvm_type(lt);

            if lt == "float" || rt == "float" || lt == "double" || rt == "double" {
                if lt == "int" || lt == "uint" {
                    conv_l: string = this.new_reg();
                    // Wide literals are i64 constants (python widens them):
                    // convert from i64 so the value isn't wrapped first.
                    conv_lt: string = this.llvm_type(lt);
                    if this.is_wide_int_lit(e.left) { conv_lt = "i64"; }
                    this.emit("  " + conv_l + " = sitofp " + conv_lt + " " + l_val + " to double");
                    l_val = conv_l;
                }
                if rt == "int" || rt == "uint" {
                    conv_r: string = this.new_reg();
                    conv_rt: string = this.llvm_type(rt);
                    if this.is_wide_int_lit(e.right) { conv_rt = "i64"; }
                    this.emit("  " + conv_r + " = sitofp " + conv_rt + " " + r_val + " to double");
                    r_val = conv_r;
                }

                if e.op == "+" { this.emit("  " + res + " = fadd double " + l_val + ", " + r_val); }
                also e.op == "-" { this.emit("  " + res + " = fsub double " + l_val + ", " + r_val); }
                also e.op == "*" { this.emit("  " + res + " = fmul double " + l_val + ", " + r_val); }
                also e.op == "/" { this.emit("  " + res + " = fdiv double " + l_val + ", " + r_val); }
                also e.op == "==" { this.emit("  " + res + " = fcmp oeq double " + l_val + ", " + r_val); }
                also e.op == "!=" { this.emit("  " + res + " = fcmp one double " + l_val + ", " + r_val); }
                also e.op == "<" { this.emit("  " + res + " = fcmp olt double " + l_val + ", " + r_val); }
                also e.op == "<=" { this.emit("  " + res + " = fcmp ole double " + l_val + ", " + r_val); }
                also e.op == ">" { this.emit("  " + res + " = fcmp ogt double " + l_val + ", " + r_val); }
                also e.op == ">=" { this.emit("  " + res + " = fcmp oge double " + l_val + ", " + r_val); }
                return res;
            }

            // Char operands widen to the int width for numeric ops — a
            // char-char result is 'int' (python's promotion), so the op
            // must run at i32, not i8.
            if lt == "char" && (rt == "int" || rt == "uint" || rt == "char") {
                extc_l: string = this.new_reg();
                this.emit("  " + extc_l + " = zext i8 " + l_val + " to i32");
                l_val = extc_l;
                lt = "int";
                lty = "i32";
            }
            if rt == "char" && (lt == "int" || lt == "uint" || lt == "char") {
                extc_r: string = this.new_reg();
                this.emit("  " + extc_r + " = zext i8 " + r_val + " to i32");
                r_val = extc_r;
                rt = "int";
            }

            // `x == nil`: pointers compare against null, scalars against zero
            if (e.op == "==" || e.op == "!=") && (lt == "nil" || rt == "nil") && lt != rt {
                other_t: string = rt;
                if lt != "nil" { other_t = lt; }
                other_lty: string = this.llvm_type(other_t);
                nil_word: string = "0";
                if other_lty.size > 0 && other_lty[other_lty.size - 1] == '*' { nil_word = "null"; }
                if lt == "nil" {
                    l_val = nil_word;
                    lty = other_lty;
                }
                if rt == "nil" { r_val = nil_word; }
            }

            // Widen mismatched integer widths to the wider operand. Plain
            // decimal literals skip the conversion: they already carry the
            // full value, and `sext i32 <big> to i64` would wrap first.
            rlty: string = this.llvm_type(rt);
            // Out-of-i32-range int literals are i64 constants in python
            // (codegen._const_int widens), so an int32 op with one runs at
            // i64: extend the register operand up, the literal embeds at
            // full width (see get_expr_type's matching int<64> result).
            if (this.is_wide_int_lit(e.left) || this.is_wide_int_lit(e.right)) && lty == "i32" && rlty == "i32" {
                if l_val.size > 0 && l_val[0] == '%' {
                    wl_r: string = this.new_reg();
                    if this.is_uint_type(lt) {
                        this.emit("  " + wl_r + " = zext i32 " + l_val + " to i64");
                    } else {
                        this.emit("  " + wl_r + " = sext i32 " + l_val + " to i64");
                    }
                    l_val = wl_r;
                }
                if r_val.size > 0 && r_val[0] == '%' {
                    wl_r2: string = this.new_reg();
                    if this.is_uint_type(rt) {
                        this.emit("  " + wl_r2 + " = zext i32 " + r_val + " to i64");
                    } else {
                        this.emit("  " + wl_r2 + " = sext i32 " + r_val + " to i64");
                    }
                    r_val = wl_r2;
                }
                lty = "i64";
                rlty = "i64";
            }
            if this.is_int_lty(lty) && this.is_int_lty(rlty) && lty != rlty {
                r_is_lit: bool = r_val.size > 0 && r_val[0] != '%';
                l_is_lit: bool = l_val.size > 0 && l_val[0] != '%';
                if this.lty_width(lty) > this.lty_width(rlty) {
                    if !r_is_lit {
                        ext_r: string = this.new_reg();
                        if this.is_uint_type(rt) {
                            this.emit("  " + ext_r + " = zext " + rlty + " " + r_val + " to " + lty);
                        } else {
                            this.emit("  " + ext_r + " = sext " + rlty + " " + r_val + " to " + lty);
                        }
                        r_val = ext_r;
                    }
                } also this.lty_width(rlty) > this.lty_width(lty) {
                    if !l_is_lit {
                        ext_l: string = this.new_reg();
                        if this.is_uint_type(lt) {
                            this.emit("  " + ext_l + " = zext " + lty + " " + l_val + " to " + rlty);
                        } else {
                            this.emit("  " + ext_l + " = sext " + lty + " " + l_val + " to " + rlty);
                        }
                        l_val = ext_l;
                    }
                    // The OP runs at the wider width even when the literal
                    // operand needs no conversion instruction.
                    lty = rlty;
                }
            }

            // Integer & Boolean operations
            if e.op == "+" { this.emit("  " + res + " = add " + lty + " " + l_val + ", " + r_val); }
            also e.op == "-" { this.emit("  " + res + " = sub " + lty + " " + l_val + ", " + r_val); }
            also e.op == "*" { this.emit("  " + res + " = mul " + lty + " " + l_val + ", " + r_val); }
            also e.op == "/" {
                if this.is_uint_type(lt) {
                    this.emit("  " + res + " = udiv " + lty + " " + l_val + ", " + r_val);
                } else {
                    this.emit("  " + res + " = sdiv " + lty + " " + l_val + ", " + r_val);
                }
            }
            also e.op == "%" {
                if this.is_uint_type(lt) {
                    this.emit("  " + res + " = urem " + lty + " " + l_val + ", " + r_val);
                } else {
                    this.emit("  " + res + " = srem " + lty + " " + l_val + ", " + r_val);
                }
            }
            also e.op == "==" { this.emit("  " + res + " = icmp eq " + lty + " " + l_val + ", " + r_val); }
            also e.op == "!=" { this.emit("  " + res + " = icmp ne " + lty + " " + l_val + ", " + r_val); }
            also e.op == "<" { this.emit("  " + res + " = icmp slt " + lty + " " + l_val + ", " + r_val); }
            also e.op == "<=" { this.emit("  " + res + " = icmp sle " + lty + " " + l_val + ", " + r_val); }
            also e.op == ">" { this.emit("  " + res + " = icmp sgt " + lty + " " + l_val + ", " + r_val); }
            also e.op == ">=" { this.emit("  " + res + " = icmp sge " + lty + " " + l_val + ", " + r_val); }
            also e.op == "&" { this.emit("  " + res + " = and " + lty + " " + l_val + ", " + r_val); }
            also e.op == "|" { this.emit("  " + res + " = or " + lty + " " + l_val + ", " + r_val); }
            also e.op == "^" { this.emit("  " + res + " = xor " + lty + " " + l_val + ", " + r_val); }
            also e.op == "<<" { this.emit("  " + res + " = shl " + lty + " " + l_val + ", " + r_val); }
            also e.op == ">>" {
                // Unsigned right shift zeroes the top bits; signed fills with
                // the sign (python emits lshr for uint-family operands).
                if this.is_uint_type(lt) {
                    this.emit("  " + res + " = lshr " + lty + " " + l_val + ", " + r_val);
                } else {
                    this.emit("  " + res + " = ashr " + lty + " " + l_val + ", " + r_val);
                }
            }
            return res;
        }

        if e.kind == ExprKind.UNARY {
            // Address-of a function: `&name` yields the function symbol
            if e.op == "&" && e.left.kind == ExprKind.IDENT && !this.var_ptrs.isin(e.left.sval) && this.tc.funcs.isin(e.left.sval) {
                return "@" + e.left.sval;
            }
            u_val: string = this.gen_expr(e.left);
            res: string = this.new_reg();
            if e.op == "await" {
                aw_box: string = this.new_reg();
                this.emit("  " + aw_box + " = call i8* @leash_future_await(i8* " + u_val + ")");
                aw_t: string = this.strip_future(this.get_expr_type(e.left));
                if aw_t == "void" || aw_t.size == 0 { return ""; }
                aw_lty: string = this.llvm_type(aw_t);
                aw_p: string = this.new_reg();
                this.emit("  " + aw_p + " = bitcast i8* " + aw_box + " to " + aw_lty + "*");
                aw_r: string = this.new_reg();
                this.emit("  " + aw_r + " = load " + aw_lty + ", " + aw_lty + "* " + aw_p);
                return aw_r;
            }
            if e.op == "!" {
                this.emit("  " + res + " = xor i1 " + u_val + ", 1");
                return res;
            }
            if e.op == "-" {
                operand_t: string = this.get_expr_type(e.left);
                if operand_t == "float" || operand_t == "double" {
                    this.emit("  " + res + " = fneg double " + u_val);
                    return res;
                }
                o_lty: string = this.llvm_type(operand_t);
                if this.is_int_lty(o_lty) && o_lty != "i64" {
                    this.emit("  " + res + " = sub " + o_lty + " 0, " + u_val);
                    return res;
                }
                this.emit("  " + res + " = sub i64 0, " + u_val);
                return res;
            }
            if e.op == "~" {
                tnot: string = this.get_expr_type(e.left);
                // Out-of-range literals are i64 constants (python's
                // _const_int widens): not must run at i64 too, else the
                // decimal wraps into i32 first.
                if this.is_wide_int_lit(e.left) { tnot = "int<64>"; }
                this.emit("  " + res + " = xor " + this.llvm_type(tnot) + " " + u_val + ", -1");
                return res;
            }
            if e.op == "&" {
                if e.left.kind == ExprKind.IDENT && this.var_ptrs.isin(e.left.sval) {
                    vt: string = this.var_types[e.left.sval];
                    // Struct/class values are already pointers: address == value
                    if this.tc.structs.isin(vt) || this.tc.classes.isin(vt) {
                        return u_val;
                    }
                    return this.var_ptrs[e.left.sval];
                }
            }
            if e.op == "*" {
                inner_t: string = this.get_expr_type(e);
                lty: string = this.llvm_type(inner_t);
                this.emit("  " + res + " = load " + lty + ", " + lty + "* " + u_val);
                return res;
            }
            // Prefix/postfix inc/dec: ++x/--x return the NEW value,
            // x++/x-- return the OLD value (python parity).
            if e.op == "++p" || e.op == "--p" || e.op == "++" || e.op == "--" {
                is_prefix: bool = e.op == "++p" || e.op == "--p";
                is_inc: bool = e.op == "++p" || e.op == "++";
                return this.gen_incr_decr(e.left, is_prefix, is_inc);
            }
            return u_val;
        }


        if e.kind == ExprKind.CALL {
            // Special built-in: exec(cmd, mode)
            if e.sval == "exec" {
                cmd_val: string = this.gen_expr(e.args.get(0));
                mode_val: string = "null";
                if e.args.size > 1 {
                    if e.args.get(1).kind == ExprKind.NIL {
                        mode_val = "null";
                    } else {
                        mode_val = this.gen_expr(e.args.get(1));
                    }
                }
                res: string = this.new_reg();
                this.emit("  " + res + " = call i8* @leash_sh_exec(i8* " + cmd_val + ", i8* " + mode_val + ")");
                this.af_track(res);
                return res;
            }

            // cstr(string) -> {len, ptr} slice (char[])
            if e.sval == "cstr" {
                cstr_val: string = this.gen_expr(e.args.get(0));
                cstr_len: string = this.new_reg();
                this.emit("  " + cstr_len + " = call i64 @strlen(i8* " + cstr_val + ")");
                s0: string = this.new_reg();
                this.emit("  " + s0 + " = insertvalue { i64, i8* } undef, i64 " + cstr_len + ", 0");
                s1: string = this.new_reg();
                this.emit("  " + s1 + " = insertvalue { i64, i8* } " + s0 + ", i8* " + cstr_val + ", 1");
                return s1;
            }

            // get([prompt]) reads a line from stdin
            if e.sval == "get" {
                prompt_val: string;
                if e.args.size > 0 {
                    prompt_val = this.gen_expr(e.args.get(0));
                } else {
                    empty_str: string = this.get_str_constant("");
                    empty_gep: string = this.new_reg();
                    this.emit("  " + empty_gep + " = getelementptr inbounds [1 x i8], [1 x i8]* " + empty_str + ", i64 0, i64 0");
                    prompt_val = empty_gep;
                }
                res: string = this.new_reg();
                this.emit("  " + res + " = call i8* @leash_sh_input(i8* " + prompt_val + ")");
                this.af_track(res);
                return res;
            }

            // normescape(s): normalize literal escape sequences
            if e.sval == "normescape" {
                ne_arg: string = this.gen_expr(e.args.get(0));
                res: string = this.new_reg();
                this.emit("  " + res + " = call i8* @leash_sh_normescape(i8* " + ne_arg + ")");
                return res;
            }

            // lstr(slice): convert a {len, ptr} slice to a NUL-terminated string
            if e.sval == "lstr" {
                sl_val: string = this.gen_expr(e.args.get(0));
                sl_t: string = this.get_expr_type(e.args.get(0));
                sl_lty: string = this.llvm_type(sl_t);
                len_r: string = this.new_reg();
                this.emit("  " + len_r + " = extractvalue " + sl_lty + " " + sl_val + ", 0");
                ptr_r: string = this.new_reg();
                this.emit("  " + ptr_r + " = extractvalue " + sl_lty + " " + sl_val + ", 1");
                res: string = this.new_reg();
                this.emit("  " + res + " = call i8* @leash_sh_slice_to_str(i64 " + len_r + ", i8* " + ptr_r + ")");
                this.af_track(res);
                return res;
            }

            // seed(n) / rand(min,max) / randf(min,max)
            if e.sval == "seed" {
                sv: string = this.gen_expr(e.args.get(0));
                this.emit("  call void @leash_sh_seed(i64 " + sv + ")");
                return "0";
            }
            if e.sval == "rand" {
                rmin: string = this.i32_to_rt_i64(e.args.get(0), this.gen_expr(e.args.get(0)));
                rmax: string = this.i32_to_rt_i64(e.args.get(1), this.gen_expr(e.args.get(1)));
                res: string = this.new_reg();
                this.emit("  " + res + " = call i64 @leash_sh_rand(i64 " + rmin + ", i64 " + rmax + ")");
                return this.rt_i64_to_i32(res);
            }
            if e.sval == "randf" {
                fmin: string = this.gen_expr(e.args.get(0));
                fmin_t: string = this.get_expr_type(e.args.get(0));
                fmax: string = this.gen_expr(e.args.get(1));
                fmax_t: string = this.get_expr_type(e.args.get(1));
                if fmin_t == "int" {
                    fmin2: string = this.new_reg();
                    this.emit("  " + fmin2 + " = sitofp i64 " + fmin + " to double");
                    fmin = fmin2;
                }
                if fmax_t == "int" {
                    fmax2: string = this.new_reg();
                    this.emit("  " + fmax2 + " = sitofp i64 " + fmax + " to double");
                    fmax = fmax2;
                }
                res: string = this.new_reg();
                this.emit("  " + res + " = call double @leash_sh_randf(double " + fmin + ", double " + fmax + ")");
                return res;
            }
            if e.sval == "choose" {
                ch_args: string = "i64 " + tostring(e.args.size);
                foreach _, ch_a in<vector> e.args {
                    ch_v: string = this.gen_expr(ch_a);
                    ch_args = ch_args + ", i8* " + ch_v;
                }
                res: string = this.new_reg();
                this.emit("  " + res + " = call i8* (i64, ...) @leash_sh_choose(" + ch_args + ")");
                return res;
            }
            if e.sval == "wait" {
                wv: string = this.gen_expr(e.args.get(0));
                wt: string = this.get_expr_type(e.args.get(0));
                if wt == "int" {
                    wv2: string = this.new_reg();
                    this.emit("  " + wv2 + " = sitofp i64 " + wv + " to double");
                    wv = wv2;
                }
                this.emit("  call void @leash_sh_wait(double " + wv + ")");
                return "0";
            }
            if e.sval == "timepass" {
                res: string = this.new_reg();
                this.emit("  " + res + " = call double @leash_sh_timepass()");
                return res;
            }
            // typeof(x) -> compile-time type name string
            if e.sval == "typeof" {
                tn: string = "";
                if e.args.get(0).kind == ExprKind.STRING {
                    tn = e.args.get(0).sval;
                    if this.var_types.isin(tn) {
                        tn = this.var_types[tn];
                    } else {
                        if tn != "int" && tn != "float" && tn != "bool" && tn != "char" && tn != "string" && tn != "void" {
                            if this.tc.funcs.isin(tn) { tn = "fnc"; }
                        }
                    }
                } else {
                    tn = this.strip_ref(this.get_expr_type(e.args.get(0)));
                }
                return this.const_str_of(tn);
            }
            // sizeof(T) -> compile-time byte size
            if e.sval == "sizeof" {
                if e.args.get(0).kind == ExprKind.STRING {
                    return tostring(this.type_size_of(e.args.get(0).sval));
                }
                sz_t: string = this.strip_ref(this.get_expr_type(e.args.get(0)));
                return tostring(this.type_size_of(sz_t));
            }
            // tounion(U, value) -> box a value into a fresh union instance
            if e.sval == "tounion" && e.args.size == 2 {
                tu_name: string = "";
                if e.args.get(0).kind == ExprKind.STRING { tu_name = e.args.get(0).sval; }
                else { tu_name = this.strip_ref(this.get_expr_type(e.args.get(0))); }
                if !this.tc.unions.isin(tu_name) {
                    return this.gen_expr(e.args.get(1));
                }
                tu_val: string = this.gen_expr(e.args.get(1));
                tu_vt: string = this.get_expr_type(e.args.get(1));
                tu_uty: string = "%union." + tu_name;
                tu_ptr: string = "%" + this.new_label("utmp");
                this.emit("  " + tu_ptr + " = alloca " + tu_uty + ", align 8");
                this.union_auto_store(tu_ptr, tu_name, tu_val, tu_vt);
                tu_lv: string = this.new_reg();
                this.emit("  " + tu_lv + " = load " + tu_uty + ", " + tu_uty + "* " + tu_ptr);
                return tu_lv;
            }
            // scast(TargetType, value) -> checked-cast semantics; the fit
            // check is skipped for now, so behave like a plain cast.
            if e.sval == "scast" && e.args.size == 2 {
                sc_target: string = "";
                if e.args.get(0).kind == ExprKind.STRING { sc_target = e.args.get(0).sval; }
                also e.args.get(0).kind == ExprKind.IDENT { sc_target = e.args.get(0).sval; }
                if sc_target.size > 0 {
                    sc_ce: Expr = Expr.make_cast(sc_target, e.args.get(1));
                    return this.gen_expr(sc_ce);
                }
            }
            // 2-arg typed conversions: toint(int<64>, x) / tofloat(double, x)
            // / tochar(char, x) — the first argument names the TARGET type.
            if e.args.size == 2 && (e.sval == "toint" || e.sval == "tofloat" || e.sval == "tochar") {
                cast2_val: string = this.gen_expr(e.args.get(1));
                cast2_from: string = this.get_expr_type(e.args.get(1));
                cast2_tgt: string = this.tc.resolve_type_alias(e.args.get(0).sval);
                cast2_lty: string = this.llvm_type(cast2_tgt);
                res: string = this.new_reg();
                if e.sval == "tofloat" {
                    if this.is_int_lty(this.llvm_type(cast2_from)) {
                        this.emit("  " + res + " = sitofp " + this.llvm_type(cast2_from) + " " + cast2_val + " to double");
                        return res;
                    }
                    if cast2_from == "string" {
                        this.emit("  " + res + " = call double @atof(i8* " + cast2_val + ")");
                        return res;
                    }
                    return cast2_val;
                }
                // toint / tochar: integer targets
                if cast2_from == "float" || cast2_from == "double" {
                    this.emit("  " + res + " = fptosi double " + cast2_val + " to " + cast2_lty);
                    return res;
                }
                if cast2_from == "string" {
                    if this.lty_width(cast2_lty) > 64 {
                        // Full-precision decimal parse for wide targets.
                        wsgn: int = 0;
                        if !this.is_uint_type(cast2_tgt) { wsgn = 1; }
                        wslot: string = this.new_reg();
                        this.emit("  " + wslot + " = alloca " + cast2_lty);
                        wbp: string = this.new_reg();
                        this.emit("  " + wbp + " = bitcast " + cast2_lty + "* " + wslot + " to i8*");
                        wok: string = this.new_reg();
                        this.emit("  " + wok + " = call i64 @leash_bigint_parse(i8* " + cast2_val + ", i64 " + tostring(this.lty_width(cast2_lty)) + ", i64 " + tostring(wsgn) + ", i8* " + wbp + ")");
                        wbad: string = this.new_label("b_tc2_bad");
                        wok_l: string = this.new_label("b_tc2_ok");
                        wokb: string = this.new_reg();
                        this.emit("  " + wokb + " = icmp eq i64 " + wok + ", 0");
                        this.emit("  br i1 " + wokb + ", label %" + wbad + ", label %" + wok_l);
                        this.emit(wbad + ":");
                        wmsg: string = "Runtime error: '" + cast2_tgt + "' value out of range or invalid\n";
                        wep: string = this.const_str_of(wmsg);
                        this.emit("  call i32 (i8*, ...) @printf(i8* " + wep + ")");
                        this.emit("  call void @exit(i64 1)");
                        this.emit("  unreachable");
                        this.emit(wok_l + ":");
                        this.current_block_terminated = false;
                        wres: string = this.new_reg();
                        this.emit("  " + wres + " = load " + cast2_lty + ", " + cast2_lty + "* " + wslot);
                        return wres;
                    }
                    a64: string = this.new_reg();
                    this.emit("  " + a64 + " = call i64 @atoll(i8* " + cast2_val + ")");
                    if this.lty_width(cast2_lty) > 32 {
                        this.emit("  " + res + " = trunc i64 " + a64 + " to " + cast2_lty);
                        return res;
                    }
                    r32: string = this.new_reg();
                    this.emit("  " + r32 + " = trunc i64 " + a64 + " to i32");
                    return this.coerce_store_val(e.args.get(1), r32, cast2_lty);
                }
                from_lty2: string = this.llvm_type(cast2_from);
                if this.is_int_lty(from_lty2) && this.is_int_lty(cast2_lty) {
                    if from_lty2 == cast2_lty { return cast2_val; }
                    if this.lty_width(from_lty2) > this.lty_width(cast2_lty) {
                        this.emit("  " + res + " = trunc " + from_lty2 + " " + cast2_val + " to " + cast2_lty);
                    } else {
                        // char is an UNSIGNED byte (python: chars carry
                        // their 0-255 codepoint, never negative)
                        if this.is_uint_type(cast2_from) || cast2_from == "char" {
                            this.emit("  " + res + " = zext " + from_lty2 + " " + cast2_val + " to " + cast2_lty);
                        } else {
                            this.emit("  " + res + " = sext " + from_lty2 + " " + cast2_val + " to " + cast2_lty);
                        }
                    }
                    return res;
                }
                return cast2_val;
            }

            // __tupget(tuple, idx) - destructuring getter
            if e.sval == "__tupget" {
                tup_val: string = this.gen_expr(e.args.get(0));
                tup_t: string = this.get_expr_type(e.args.get(0));
                tup_idx: int = e.args.get(1).ival;
                elem_t: string = this.tuple_elem_type(tup_t, tup_idx);
                res: string = this.new_reg();
                this.emit("  " + res + " = extractvalue " + this.llvm_type(tup_t) + " " + tup_val + ", " + tostring(tup_idx));
                return res;
            }

            // keyget() reads one key without waiting for Enter
            if e.sval == "keyget" {
                kg: string = this.new_reg();
                this.emit("  " + kg + " = call i32 @leash_keyget()");
                res: string = this.new_reg();
                this.emit("  " + res + " = trunc i32 " + kg + " to i8");
                return res;
            }

            // __toint_conv(TargetType, value): arbitrary-width conversion
            if e.sval == "__toint_conv" {
                tc_target: string = this.tc.resolve_type_alias(e.args.get(0).sval);

                tc_val: string = this.gen_expr(e.args.get(1));
                // Integer / float values convert directly (width coercion /
                // fptosi); only STRING values go through the parse paths.
                tc_from: string = this.get_expr_type(e.args.get(1));
                if this.is_int_lty(this.llvm_type(tc_from)) {
                    tc_fl: string = this.llvm_type(tc_from);
                    tc_tl: string = this.llvm_type(tc_target);
                    if tc_fl == tc_tl { return tc_val; }
                    tc_cr: string = this.new_reg();
                    if this.lty_width(tc_fl) > this.lty_width(tc_tl) {
                        this.emit("  " + tc_cr + " = trunc " + tc_fl + " " + tc_val + " to " + tc_tl);
                    } else {
                        if this.is_uint_type(tc_from) {
                            this.emit("  " + tc_cr + " = zext " + tc_fl + " " + tc_val + " to " + tc_tl);
                        } else {
                            this.emit("  " + tc_cr + " = sext " + tc_fl + " " + tc_val + " to " + tc_tl);
                        }
                    }
                    return tc_cr;
                }
                if tc_from == "float" || tc_from == "double" {
                    tc_fr2: string = this.new_reg();
                    this.emit("  " + tc_fr2 + " = fptosi double " + tc_val + " to " + this.llvm_type(tc_target));
                    return tc_fr2;
                }
                if this.is_sized_int_type(tc_target) && this.sized_int_width(tc_target) > 64 {
                    tcw: int = this.sized_int_width(tc_target);
                    tcs: int = 0;
                    if this.sized_int_is_signed(tc_target) { tcs = 1; }
                    tc_slot: string = this.new_reg();
                    this.emit("  " + tc_slot + " = alloca i" + tostring(tcw));
                    tc_bp: string = this.new_reg();
                    this.emit("  " + tc_bp + " = bitcast i" + tostring(tcw) + "* " + tc_slot + " to i8*");
                    tc_ok: string = this.new_reg();
                    this.emit("  " + tc_ok + " = call i64 @leash_bigint_parse(i8* " + tc_val + ", i64 " + tostring(tcw) + ", i64 " + tostring(tcs) + ", i8* " + tc_bp + ")");
                    tc_bad: string = this.new_label("b_tcn_bad");
                    tc_ok_l: string = this.new_label("b_tcn_ok");
                    tc_okb: string = this.new_reg();
                    this.emit("  " + tc_okb + " = icmp eq i64 " + tc_ok + ", 0");
                    this.emit("  br i1 " + tc_okb + ", label %" + tc_bad + ", label %" + tc_ok_l);
                    this.emit(tc_bad + ":");
                    tc_msg: string = "Runtime error: '" + tc_target + "' value out of range or invalid\n";
                    tc_ep: string = this.const_str_of(tc_msg);
                    this.emit("  call i32 (i8*, ...) @printf(i8* " + tc_ep + ")");
                    this.emit("  call void @exit(i64 1)");
                    this.emit("  unreachable");
                    this.emit(tc_ok_l + ":");
                    this.current_block_terminated = false;
                    tc_res: string = this.new_reg();
                    this.emit("  " + tc_res + " = load i" + tostring(tcw) + ", i" + tostring(tcw) + "* " + tc_slot);
                    return tc_res;
                }
                // narrow target: decimal parse via atoll
                tc_r64: string = this.new_reg();
                this.emit("  " + tc_r64 + " = call i64 @atoll(i8* " + tc_val + ")");
                if this.is_sized_int_type(tc_target) {
                    tc_nw: int = this.sized_int_width(tc_target);
                    if tc_nw < 64 {
                        tc_tr: string = this.new_reg();
                        this.emit("  " + tc_tr + " = trunc i64 " + tc_r64 + " to i" + tostring(tc_nw));
                        return tc_tr;
                    }
                }
                return tc_r64;
            }

            // Special built-in: tostring(val)
            if e.sval == "tostring" {
                aval: string = this.gen_expr(e.args.get(0));
                atyp: string = this.get_expr_type(e.args.get(0));
                if atyp == "string" { return aval; }
                if atyp == "int" {
                    res: string = this.new_reg();
                    this.emit("  " + res + " = call i8* @leash_int_to_str(i64 " + this.i32_to_rt_i64(e.args.get(0), aval) + ")");
                    this.af_track(res);
                    return res;
                }
                if atyp == "char" {
                    ext: string = this.new_reg();
                    this.emit("  " + ext + " = zext i8 " + aval + " to i64");
                    res: string = this.new_reg();
                    this.emit("  " + res + " = call i8* @leash_int_to_str(i64 " + ext + ")");
                    this.af_track(res);
                    return res;
                }
                if atyp == "bool" {
                    res: string = this.new_reg();
                    this.emit("  " + res + " = select i1 " + aval + ", i8* getelementptr inbounds ([5 x i8], [5 x i8]* @.fmt_true, i64 0, i64 0), i8* getelementptr inbounds ([6 x i8], [6 x i8]* @.fmt_false, i64 0, i64 0)");
                    return res;
                }
                if atyp == "float" {
                    res: string = this.new_reg();
                    this.emit("  " + res + " = call i8* @leash_float_to_str(double " + aval + ")");
                    this.af_track(res);
                    return res;
                }
                // Wide integers format through the big-int runtime
                if this.is_sized_int_type(atyp) && this.sized_int_width(atyp) > 64 {
                    return this.wide_int_to_str(aval, atyp);
                }
                // Sized integers (int<8>..int<64>, uint<...>) extend to
                // the i64 runtime slot with the value's signedness.
                if this.is_sized_int_type(atyp) {
                    return this.concat_int_to_str(e.args.get(0), aval, atyp);
                }
                // Pointer-typed args pass through unchanged (python's
                // tostring returns non-int/float args as-is; a
                // pointer<char> already IS a C string pointer)
                al_lty: string = this.llvm_type(atyp);
                if al_lty.size > 0 && al_lty[al_lty.size - 1] == '*' {
                    return aval;
                }
                // Fallback: treat as int
                res: string = this.new_reg();
                this.emit("  " + res + " = call i8* @leash_int_to_str(i64 " + aval + ")");
                this.af_track(res);
                return res;
            }

            // `create Class(...)` allocation (python CreateExpr parity):
            // zeroed heap instance + vtable slot + `Class_Class(this, ...)`
            // when a same-named ctor exists. Declared field defaults do NOT
            // apply (the runtime zeroes) and `new(...)` never runs — only
            // `Class_Class` is called. Without a ctor the args are ignored
            // entirely (never even evaluated), as in python. Bare
            // `Class(...)` calls are rejected by the typechecker; the
            // emitter keeps accepting them for robustness.
            if this.tc.classes.isin(e.sval) {
                cname: string = e.sval;
                cty: string = "%class." + cname;
                // Exact instance size (python's gep-null + ptrtoint).
                sz_gep: string = this.new_reg();
                this.emit("  " + sz_gep + " = getelementptr " + cty + ", " + cty + "* null, i32 1");
                sz_i: string = this.new_reg();
                this.emit("  " + sz_i + " = ptrtoint " + cty + "* " + sz_gep + " to i64");
                craw2: string = this.new_reg();
                this.emit("  " + craw2 + " = call i8* @leash_gc_malloc(i64 " + sz_i + ")");
                obj_ptr2: string = this.new_reg();
                this.emit("  " + obj_ptr2 + " = bitcast i8* " + craw2 + " to " + cty + "*");
                // Vtable pointer at slot 0 when the class has methods.
                cip2: ClassInfo = this.tc.classes[cname];
                if cip2.method_order.size > 0 {
                    cvt2_ty: string = "{ ";
                    cvt2_i: int = 0;
                    while cvt2_i < cip2.method_order.size {
                        if cvt2_i > 0 { cvt2_ty = cvt2_ty + ", "; }
                        cvt2_ty = cvt2_ty + "i8*";
                        cvt2_i = cvt2_i + 1;
                    }
                    cvt2_ty = cvt2_ty + " }";
                    cvt2_sp: string = this.new_reg();
                    this.emit("  " + cvt2_sp + " = getelementptr inbounds " + cty + ", " + cty + "* " + obj_ptr2 + ", i32 0, i32 0");
                    this.emit("  store i8* bitcast(" + cvt2_ty + "* @" + cname + "_vtable to i8*), i8** " + cvt2_sp);
                }
                // Constructor call: this + user args (int-width coerced
                // like the method-call path), trailing gaps filled from
                // the ctor's declared defaults. Arity is enforced by the
                // typechecker, so the fill loop always terminates cleanly.
                ctor_name: string = cname + "_" + cname;
                if this.tc.funcs.isin(ctor_name) {
                    arg_strs2: string = this.llvm_type(cname) + " " + obj_ptr2;
                    cmps: vec<string> = cip2.get_method_params(cname);
                    ai2: int = 0;
                    foreach _, arg in<vector> e.args {
                        aval: string = this.gen_expr(arg);
                        atyp: string = this.get_expr_type(arg);
                        alty: string = this.llvm_type(atyp);
                        if ai2 < cmps.size {
                            ptw: string = cmps.get(ai2);
                            if ptw.size > 0 && ptw[0] != '&' {
                                pltyw: string = this.llvm_type(ptw);
                                if this.is_int_lty(alty) && this.is_int_lty(pltyw) && alty != pltyw {
                                    aval = this.coerce_store_val(arg, aval, pltyw);
                                    alty = pltyw;
                                }
                            }
                        }
                        arg_strs2 = arg_strs2 + ", " + alty + " " + aval;
                        ai2 = ai2 + 1;
                    }
                    if this.tc.ctor_defaults.isin(cname) {
                        cdefs2: vec<Expr> = this.tc.ctor_defaults[cname];
                        while ai2 < cdefs2.size {
                            dd: Expr = cdefs2.get(ai2);
                            if dd == null { stop; }
                            dval: string = this.gen_expr(dd);
                            dtyp: string = this.get_expr_type(dd);
                            dlty: string = this.llvm_type(dtyp);
                            if ai2 < cmps.size {
                                ptw2: string = cmps.get(ai2);
                                if ptw2.size > 0 && ptw2[0] != '&' {
                                    pltyw2: string = this.llvm_type(ptw2);
                                    if this.is_int_lty(dlty) && this.is_int_lty(pltyw2) && dlty != pltyw2 {
                                        dval = this.coerce_store_val(dd, dval, pltyw2);
                                        dlty = pltyw2;
                                    }
                                }
                            }
                            arg_strs2 = arg_strs2 + ", " + dlty + " " + dval;
                            ai2 = ai2 + 1;
                        }
                    }
                    this.emit("  call void @" + ctor_name + "(" + arg_strs2 + ")");
                }
                return obj_ptr2;
            }

            // Byte builtins: inttobytes/floattobytes -> {i64,len, i8*,ptr} slice,
            // bytestoint/bytestofloat -> scalar decoded from a slice.
            if e.sval == "inttobytes" || e.sval == "floattobytes" {
                b_size: string = this.gen_expr(e.args.get(0));
                b_val: string = this.gen_expr(e.args.get(1));
                b_vt: string = this.get_expr_type(e.args.get(1));
                b_vlty: string = this.llvm_type(b_vt);
                b_vbytes: int = this.llvm_val_bytes(b_vlty);
                b_ap: string = this.new_reg();
                this.emit("  " + b_ap + " = alloca " + b_vlty);
                this.emit("  store " + b_vlty + " " + b_val + ", " + b_vlty + "* " + b_ap);
                b_bp: string = this.new_reg();
                this.emit("  " + b_bp + " = bitcast " + b_vlty + "* " + b_ap + " to i8*");
                // copy = min(size, value_byte_size): never read past the value
                b_le: string = this.new_reg();
                this.emit("  " + b_le + " = icmp ule i64 " + b_size + ", " + tostring(b_vbytes));
                b_copy: string = this.new_reg();
                this.emit("  " + b_copy + " = select i1 " + b_le + ", i64 " + b_size + ", i64 " + tostring(b_vbytes));
                b_mem: string = this.new_reg();
                this.emit("  " + b_mem + " = call i8* @leash_gc_malloc(i64 " + b_size + ")");
                this.emit("  call i8* @memmove(i8* " + b_mem + ", i8* " + b_bp + ", i64 " + b_copy + ")");
                b_s0: string = this.new_reg();
                this.emit("  " + b_s0 + " = insertvalue { i64, i8* } undef, i64 " + b_size + ", 0");
                b_s1: string = this.new_reg();
                this.emit("  " + b_s1 + " = insertvalue { i64, i8* } " + b_s0 + ", i8* " + b_mem + ", 1");
                return b_s1;
            }
            if e.sval == "bytestoint" || e.sval == "bytestofloat" {
                c_size: string = this.gen_expr(e.args.get(0));
                c_sl: string = this.gen_expr(e.args.get(1));
                c_slt: string = this.llvm_type(this.get_expr_type(e.args.get(1)));
                c_ptr: string = this.new_reg();
                this.emit("  " + c_ptr + " = extractvalue " + c_slt + " " + c_sl + ", 1");
                if e.sval == "bytestoint" {
                    // Width must be compile-time known: parse literal byte count
                    c_w: int = 64;
                    c_lit_ok: bool = c_size.size > 0;
                    c_lit: int = 0;
                    c_li: int = 0;
                    while c_li < c_size.size {
                        c_ch: char = c_size[c_li];
                        if c_ch < '0' || c_ch > '9' { c_lit_ok = false; stop; }
                        c_lit = c_lit * 10 + (c_ch - '0');
                        c_li = c_li + 1;
                    }
                    if c_lit_ok && c_lit > 0 && c_lit <= 64 { c_w = c_lit * 8; }
                    c_wlty: string = "i" + tostring(c_w);
                    c_ap: string = this.new_reg();
                    this.emit("  " + c_ap + " = alloca " + c_wlty);
                    c_bp: string = this.new_reg();
                    this.emit("  " + c_bp + " = bitcast " + c_wlty + "* " + c_ap + " to i8*");
                    this.emit("  call i8* @memmove(i8* " + c_bp + ", i8* " + c_ptr + ", i64 " + c_size + ")");
                    c_r: string = this.new_reg();
                    this.emit("  " + c_r + " = load " + c_wlty + ", " + c_wlty + "* " + c_ap);
                    // bytestoint yields a plain (32-bit) int: narrow or
                    // widen the decoded value to the int width
                    if c_w < 32 {
                        c_x: string = this.new_reg();
                        this.emit("  " + c_x + " = zext " + c_wlty + " " + c_r + " to i32");
                        return c_x;
                    }
                    if c_w > 32 {
                        c_x: string = this.new_reg();
                        this.emit("  " + c_x + " = trunc " + c_wlty + " " + c_r + " to i32");
                        return c_x;
                    }
                    return c_r;
                }
                // bytestofloat -> always double
                c_ap2: string = this.new_reg();
                this.emit("  " + c_ap2 + " = alloca double");
                this.emit("  store double 0.0, double* " + c_ap2);
                c_bp2: string = this.new_reg();
                this.emit("  " + c_bp2 + " = bitcast double* " + c_ap2 + " to i8*");
                c_le2: string = this.new_reg();
                this.emit("  " + c_le2 + " = icmp ule i64 " + c_size + ", 8");
                c_cp2: string = this.new_reg();
                this.emit("  " + c_cp2 + " = select i1 " + c_le2 + ", i64 " + c_size + ", i64 8");
                this.emit("  call i8* @memmove(i8* " + c_bp2 + ", i8* " + c_ptr + ", i64 " + c_cp2 + ")");
                c_r2: string = this.new_reg();
                this.emit("  " + c_r2 + " = load double, double* " + c_ap2);
                return c_r2;
            }

            // Indirect call through a function-pointer variable/parameter
            if !this.tc.funcs.isin(e.sval) && this.var_ptrs.isin(e.sval) && this.tc.is_fnc_type(this.var_types[e.sval]) {
                ic_parts: vec<string> = this.tc.fnc_parts(this.var_types[e.sval]);
                ic_lty: string = this.llvm_type(this.var_types[e.sval]);
                ic_fp: string = this.new_reg();
                this.emit("  " + ic_fp + " = load " + ic_lty + ", " + ic_lty + "* " + this.var_ptrs[e.sval]);
                ic_args: string = "";
                ici: int = 0;
                while ici < e.args.size {
                    icav: string = this.gen_expr(e.args.get(ici));
                    icat: string = this.get_expr_type(e.args.get(ici));
                    if ici > 0 { ic_args = ic_args + ", "; }
                    ic_args = ic_args + this.llvm_type(icat) + " " + icav;
                    ici = ici + 1;
                }
                ic_ret: string = this.llvm_type(ic_parts.get(0));
                if ic_ret == "void" {
                    this.emit("  call void " + ic_fp + "(" + ic_args + ")");
                    return "";
                }
                ic_r: string = this.new_reg();
                this.emit("  " + ic_r + " = call " + ic_ret + " " + ic_fp + "(" + ic_args + ")");
                return ic_r;
            }

            // Generic function call
            call_args: vec<Expr> = e.args;
            if this.needs_arg_align(e) { call_args = this.align_call_args(e); }
            arg_strs: string = "";
            foreach i, arg in<vector> call_args {
                aval: string = this.gen_expr(arg);
                atyp: string = this.get_expr_type(arg);
                alty: string = this.llvm_type(atyp);
                // Slice value into a vec param: copy into a real vec
                // (same conversion the assignment path performs)
                if this.tc.func_params.isin(e.sval) {
                    fparamsS: vec<string> = this.tc.func_params[e.sval];
                    if i < fparamsS.size {
                        ptS: string = fparamsS.get(i);
                        if this.is_vec_type(ptS) && atyp.size > 1 && atyp[0] != '&' && atyp[atyp.size - 1] == ']' {
                            aval = this.slice_to_vec(aval, atyp, this.vec_inner_type(ptS), true);
                            atyp = ptS;
                            alty = this.llvm_type(ptS);
                        } else {
                            adapted: string = this.adapt_slice(aval, atyp, ptS);
                            if adapted != aval {
                                aval = adapted;
                                atyp = ptS;
                                alty = this.llvm_type(ptS);
                            }
                        }
                    }
                }
                // '&T' parameters receive by reference (python parity):
                // pointer/struct/class args pass their pointer value, scalar
                // l-values pass the address of their cell, ref vars pass the
                // ref pointer itself.
                if this.tc.func_params.isin(e.sval) {
                    fparams: vec<string> = this.tc.func_params[e.sval];
                    if i < fparams.size {
                        pt: string = fparams.get(i);
                        if pt.size > 1 && pt[0] == '&' {
                            at_st: string = this.strip_ref(atyp);
                            at_is_ptr: bool = atyp.size > 1 && atyp[0] == '*';
                            at_is_struct: bool = this.tc.structs.isin(at_st) || this.tc.classes.isin(at_st);
                            if !at_is_ptr && !at_is_struct {
                                if arg.kind == ExprKind.IDENT && this.var_ptrs.isin(arg.sval) {
                                    if atyp.size > 1 && atyp[0] == '&' {
                                        c_lty: string = this.llvm_type(atyp);
                                        cr: string = this.new_reg();
                                        this.emit("  " + cr + " = load " + c_lty + ", " + c_lty + "* " + this.var_ptrs[arg.sval]);
                                        aval = cr;
                                    } else {
                                        aval = this.var_ptrs[arg.sval];
                                    }
                                    alty = this.llvm_type(pt);
                                }
                            }
                        }
                    }
                }
                if arg.kind == ExprKind.NIL {
                    if alty.size > 0 && alty[alty.size - 1] == '*' {
                        aval = "null";
                    } else {
                        aval = "0";
                    }
                }
                // Int args embed/coerce to the declared param width:
                // literals wrap/truncate at the param width, registers
                // sext/trunc (clang zero-extends mistyped constants).
                if this.tc.func_params.isin(e.sval) {
                    fparamsW: vec<string> = this.tc.func_params[e.sval];
                    if i < fparamsW.size {
                        ptW: string = fparamsW.get(i);
                        if ptW.size > 0 && ptW[0] != '&' {
                            pltyW: string = this.llvm_type(ptW);
                            if this.is_int_lty(alty) && this.is_int_lty(pltyW) && alty != pltyW {
                                aval = this.coerce_store_val(arg, aval, pltyW);
                                alty = pltyW;
                            }
                        }
                    }
                }
                if i > 0 { arg_strs = arg_strs + ", "; }
                arg_strs = arg_strs + alty + " " + aval;
            }

            ret_t: string = "void";
            if this.tc.funcs.isin(e.sval) {
                ret_t = this.tc.funcs[e.sval];
            }
            lret: string = this.llvm_type(ret_t);
            fname: string = e.sval;
            if fname == "gc_collect" { fname = "leash_gc_collect"; }

            if lret == "void" {
                this.emit("  call void @" + fname + "(" + arg_strs + ")");
                return "";
            } else {
                res: string = this.new_reg();
                this.emit("  " + res + " = call " + lret + " @" + fname + "(" + arg_strs + ")");
                return res;
            }
        }

        if e.kind == ExprKind.METHOD_CALL {
            obj_t: string = this.strip_ref(this.get_expr_type(e.left));

            // File.open(path, mode) - static method
            if e.sval == "open" && e.left.kind == ExprKind.IDENT && e.left.sval == "File" {
                path_val: string = this.gen_expr(e.args.get(0));
                mode_val: string = this.gen_expr(e.args.get(1));
                res: string = this.new_reg();
                this.emit("  " + res + " = call i8* @leash_sh_file_open(i8* " + path_val + ", i8* " + mode_val + ")");
                return res;
            }
            // File.rename(a, b) / File.delete(p) - static methods
            if (e.sval == "rename" || e.sval == "delete") && e.left.kind == ExprKind.IDENT && e.left.sval == "File" {
                s_a: string = this.gen_expr(e.args.get(0));
                if e.sval == "rename" {
                    s_b: string = this.gen_expr(e.args.get(1));
                    s_r: string = this.new_reg();
                    this.emit("  " + s_r + " = call i64 @leash_sh_file_rename(i8* " + s_a + ", i8* " + s_b + ")");
                    s_r = this.rt_i64_to_i32(s_r);
                    return s_r;
                }
                s_d: string = this.new_reg();
                this.emit("  " + s_d + " = call i64 @leash_sh_file_delete(i8* " + s_a + ")");
                s_d = this.rt_i64_to_i32(s_d);
                return s_d;
            }

            obj_val: string = "";
            is_static_call: bool = false;
            if this.tc.classes.isin(obj_t) {
                cl: ClassInfo = this.tc.classes[obj_t];
                is_static_call = cl.is_method_static(e.sval);
            }
            if !is_static_call {
                obj_val = this.gen_expr(e.left);
            }

            // String methods
            if obj_t == "string" {
                if e.sval == "size" {
                    res: string = this.new_reg();
                    this.emit("  " + res + " = call i64 @strlen(i8* " + obj_val + ")");
                    return res;
                }
                if e.sval == "replace" {
                    from_val: string = this.gen_expr(e.args.get(0));
                    to_val: string = this.gen_expr(e.args.get(1));
                    res: string = this.new_reg();
                    this.emit("  " + res + " = call i8* @leash_sh_str_replace(i8* " + obj_val + ", i8* " + from_val + ", i8* " + to_val + ")");
                    this.af_track(res);
                    return res;
                }
            }

            // vec<T> methods — inline fast paths over the LeashVec header
            if this.is_vec_type(obj_t) {
                inner_t: string = this.vec_inner_type(obj_t);
                elt_lty: string = this.llvm_type(inner_t);

                if e.sval == "pushb" {
                    aval: string = this.gen_expr(e.args.get(0));
                    pv_size: string = this.vec_field(obj_val, 1);
                    pv_cap: string = this.vec_field(obj_val, 2);
                    pv_data: string = this.vec_field(obj_val, 0);
                    pv_full: string = this.new_reg();
                    this.emit("  " + pv_full + " = icmp sge i64 " + pv_size + ", " + pv_cap);
                    pv_grow: string = this.new_label("b_pb_grow");
                    pv_fast: string = this.new_label("b_pb_fast");
                    pv_done: string = this.new_label("b_pb_done");
                    this.emit("  br i1 " + pv_full + ", label %" + pv_grow + ", label %" + pv_fast);
                    this.emit(pv_grow + ":");
                    this.current_block_terminated = false;
                    pv_next: string = this.new_reg();
                    this.emit("  " + pv_next + " = add i64 " + pv_size + ", 1");
                    this.emit("  call void @leash_sh_vec_reserve(i8* " + obj_val + ", i64 " + pv_next + ")");
                    pv_dg: string = this.vec_field(obj_val, 0);
                    pv_epg: string = this.new_reg();
                    this.emit("  " + pv_epg + " = bitcast i8* " + pv_dg + " to " + elt_lty + "*");
                    pv_slotg: string = this.new_reg();
                    this.emit("  " + pv_slotg + " = getelementptr inbounds " + elt_lty + ", " + elt_lty + "* " + pv_epg + ", i64 " + pv_size);
                    this.emit("  store " + elt_lty + " " + aval + ", " + elt_lty + "* " + pv_slotg);
                    this.vec_store_size(obj_val, pv_next);
                    this.emit("  br label %" + pv_done);
                    this.emit(pv_fast + ":");
                    this.current_block_terminated = false;
                    pv_epf: string = this.new_reg();
                    this.emit("  " + pv_epf + " = bitcast i8* " + pv_data + " to " + elt_lty + "*");
                    pv_slotf: string = this.new_reg();
                    this.emit("  " + pv_slotf + " = getelementptr inbounds " + elt_lty + ", " + elt_lty + "* " + pv_epf + ", i64 " + pv_size);
                    this.emit("  store " + elt_lty + " " + aval + ", " + elt_lty + "* " + pv_slotf);
                    pv_nf: string = this.new_reg();
                    this.emit("  " + pv_nf + " = add i64 " + pv_size + ", 1");
                    this.vec_store_size(obj_val, pv_nf);
                    this.emit("  br label %" + pv_done);
                    this.emit(pv_done + ":");
                    this.current_block_terminated = false;
                    return "";
                }
                // pushf: insert at the FRONT — grow if needed, shift the
                // elements one slot right (memmove), store at [0].
                if e.sval == "pushf" {
                    aval: string = this.gen_expr(e.args.get(0));
                    pf_size: string = this.vec_field(obj_val, 1);
                    pf_cap: string = this.vec_field(obj_val, 2);
                    pf_data: string = this.vec_field(obj_val, 0);
                    pf_esz: int = this.vec_elem_bytes(inner_t);
                    pf_full: string = this.new_reg();
                    this.emit("  " + pf_full + " = icmp sge i64 " + pf_size + ", " + pf_cap);
                    pf_grow: string = this.new_label("b_pf_grow");
                    pf_fast: string = this.new_label("b_pf_fast");
                    pf_done: string = this.new_label("b_pf_done");
                    this.emit("  br i1 " + pf_full + ", label %" + pf_grow + ", label %" + pf_fast);
                    this.emit(pf_grow + ":");
                    this.current_block_terminated = false;
                    pf_next: string = this.new_reg();
                    this.emit("  " + pf_next + " = add i64 " + pf_size + ", 1");
                    this.emit("  call void @leash_sh_vec_reserve(i8* " + obj_val + ", i64 " + pf_next + ")");
                    pf_dg: string = this.vec_field(obj_val, 0);
                    pf_dstg: string = this.new_reg();
                    this.emit("  " + pf_dstg + " = getelementptr inbounds i8, i8* " + pf_dg + ", i64 " + tostring(pf_esz));
                    pf_bytesg: string = this.new_reg();
                    this.emit("  " + pf_bytesg + " = mul i64 " + pf_size + ", " + tostring(pf_esz));
                    this.emit("  call i8* @memmove(i8* " + pf_dstg + ", i8* " + pf_dg + ", i64 " + pf_bytesg + ")");
                    pf_epg: string = this.new_reg();
                    this.emit("  " + pf_epg + " = bitcast i8* " + pf_dg + " to " + elt_lty + "*");
                    this.emit("  store " + elt_lty + " " + aval + ", " + elt_lty + "* " + pf_epg);
                    this.vec_store_size(obj_val, pf_next);
                    this.emit("  br label %" + pf_done);
                    this.emit(pf_fast + ":");
                    this.current_block_terminated = false;
                    pf_dstf: string = this.new_reg();
                    this.emit("  " + pf_dstf + " = getelementptr inbounds i8, i8* " + pf_data + ", i64 " + tostring(pf_esz));
                    pf_bytesf: string = this.new_reg();
                    this.emit("  " + pf_bytesf + " = mul i64 " + pf_size + ", " + tostring(pf_esz));
                    this.emit("  call i8* @memmove(i8* " + pf_dstf + ", i8* " + pf_data + ", i64 " + pf_bytesf + ")");
                    pf_epf: string = this.new_reg();
                    this.emit("  " + pf_epf + " = bitcast i8* " + pf_data + " to " + elt_lty + "*");
                    this.emit("  store " + elt_lty + " " + aval + ", " + elt_lty + "* " + pf_epf);
                    pf_nf: string = this.new_reg();
                    this.emit("  " + pf_nf + " = add i64 " + pf_size + ", 1");
                    this.vec_store_size(obj_val, pf_nf);
                    this.emit("  br label %" + pf_done);
                    this.emit(pf_done + ":");
                    this.current_block_terminated = false;
                    return "";
                }
                if e.sval == "get" {
                    idx_val: string = this.i32_to_rt_i64(e.args.get(0), this.gen_expr(e.args.get(0)));
                    gv_size: string = this.vec_field(obj_val, 1);
                    gv_i: string = this.vec_check_index(idx_val, gv_size, "Runtime error: Vector index out of bounds in get().\n");
                    gv_data: string = this.vec_field(obj_val, 0);
                    gv_ep: string = this.new_reg();
                    this.emit("  " + gv_ep + " = bitcast i8* " + gv_data + " to " + elt_lty + "*");
                    gv_slot: string = this.new_reg();
                    this.emit("  " + gv_slot + " = getelementptr inbounds " + elt_lty + ", " + elt_lty + "* " + gv_ep + ", i64 " + gv_i);
                    gv_val: string = this.new_reg();
                    this.emit("  " + gv_val + " = load " + elt_lty + ", " + elt_lty + "* " + gv_slot);
                    return gv_val;
                }
                if e.sval == "popb" {
                    pp_size: string = this.vec_field(obj_val, 1);
                    pp_nonempty: string = this.new_reg();
                    this.emit("  " + pp_nonempty + " = icmp ugt i64 " + pp_size + ", 0");
                    pp_bad: string = this.new_label("b_pop_bad");
                    pp_ok: string = this.new_label("b_pop_ok");
                    this.emit("  br i1 " + pp_nonempty + ", label %" + pp_ok + ", label %" + pp_bad);
                    this.emit(pp_bad + ":");
                    pp_msg: string = this.const_str_of("Runtime error: popb called on empty vector.\n");
                    this.emit("  call i32 (i8*, ...) @printf(i8* " + pp_msg + ")");
                    this.emit("  call void @exit(i64 1)");
                    this.emit("  unreachable");
                    this.emit(pp_ok + ":");
                    this.current_block_terminated = false;
                    pp_ns: string = this.new_reg();
                    this.emit("  " + pp_ns + " = sub i64 " + pp_size + ", 1");
                    pp_data: string = this.vec_field(obj_val, 0);
                    pp_ep: string = this.new_reg();
                    this.emit("  " + pp_ep + " = bitcast i8* " + pp_data + " to " + elt_lty + "*");
                    pp_slot: string = this.new_reg();
                    this.emit("  " + pp_slot + " = getelementptr inbounds " + elt_lty + ", " + elt_lty + "* " + pp_ep + ", i64 " + pp_ns);
                    pp_val: string = this.new_reg();
                    this.emit("  " + pp_val + " = load " + elt_lty + ", " + elt_lty + "* " + pp_slot);
                    this.vec_store_size(obj_val, pp_ns);
                    return pp_val;
                }
                // popf: front element — res = data[0], shift left, size--
                if e.sval == "popf" {
                    pf2_size: string = this.vec_field(obj_val, 1);
                    pf2_nonempty: string = this.new_reg();
                    this.emit("  " + pf2_nonempty + " = icmp ugt i64 " + pf2_size + ", 0");
                    pf2_bad: string = this.new_label("b_popf_bad");
                    pf2_ok: string = this.new_label("b_popf_ok");
                    this.emit("  br i1 " + pf2_nonempty + ", label %" + pf2_ok + ", label %" + pf2_bad);
                    this.emit(pf2_bad + ":");
                    pf2_msg: string = this.const_str_of("Runtime error: popf called on empty vector.\n");
                    this.emit("  call i32 (i8*, ...) @printf(i8* " + pf2_msg + ")");
                    this.emit("  call void @exit(i64 1)");
                    this.emit("  unreachable");
                    this.emit(pf2_ok + ":");
                    this.current_block_terminated = false;
                    pf2_ns: string = this.new_reg();
                    this.emit("  " + pf2_ns + " = sub i64 " + pf2_size + ", 1");
                    pf2_data: string = this.vec_field(obj_val, 0);
                    pf2_esz: int = this.vec_elem_bytes(inner_t);
                    pf2_ep: string = this.new_reg();
                    this.emit("  " + pf2_ep + " = bitcast i8* " + pf2_data + " to " + elt_lty + "*");
                    pf2_val: string = this.new_reg();
                    this.emit("  " + pf2_val + " = load " + elt_lty + ", " + elt_lty + "* " + pf2_ep);
                    pf2_src: string = this.new_reg();
                    this.emit("  " + pf2_src + " = getelementptr inbounds i8, i8* " + pf2_data + ", i64 " + tostring(pf2_esz));
                    pf2_bytes: string = this.new_reg();
                    this.emit("  " + pf2_bytes + " = mul i64 " + pf2_ns + ", " + tostring(pf2_esz));
                    this.emit("  call i8* @memmove(i8* " + pf2_data + ", i8* " + pf2_src + ", i64 " + pf2_bytes + ")");
                    this.vec_store_size(obj_val, pf2_ns);
                    return pf2_val;
                }
                // insert(idx, v): negative idx normalizes (+size), bounds
                // 0 <= idx <= size, shift right from idx, store, size+1.
                if e.sval == "insert" {
                    iv_idx: string = this.i32_to_rt_i64(e.args.get(0), this.gen_expr(e.args.get(0)));
                    iv_size: string = this.vec_field(obj_val, 1);
                    iv_neg: string = this.new_reg();
                    this.emit("  " + iv_neg + " = icmp slt i64 " + iv_idx + ", 0");
                    iv_wrap: string = this.new_reg();
                    this.emit("  " + iv_wrap + " = add i64 " + iv_idx + ", " + iv_size);
                    iv_idx2: string = this.new_reg();
                    this.emit("  " + iv_idx2 + " = select i1 " + iv_neg + ", i64 " + iv_wrap + ", i64 " + iv_idx);
                    iv_nn: string = this.new_reg();
                    this.emit("  " + iv_nn + " = icmp sge i64 " + iv_idx2 + ", 0");
                    iv_ob: string = this.new_reg();
                    this.emit("  " + iv_ob + " = icmp ule i64 " + iv_idx2 + ", " + iv_size);
                    iv_ok: string = this.new_reg();
                    this.emit("  " + iv_ok + " = and i1 " + iv_nn + ", " + iv_ob);
                    iv_bad: string = this.new_label("b_ins_bad");
                    iv_good: string = this.new_label("b_ins_ok");
                    this.emit("  br i1 " + iv_ok + ", label %" + iv_good + ", label %" + iv_bad);
                    this.emit(iv_bad + ":");
                    iv_msg: string = this.const_str_of("Runtime error: Vector insert index out of bounds.\n");
                    this.emit("  call i32 (i8*, ...) @printf(i8* " + iv_msg + ")");
                    this.emit("  call void @exit(i64 1)");
                    this.emit("  unreachable");
                    this.emit(iv_good + ":");
                    this.current_block_terminated = false;
                    iv_val: string = this.gen_expr(e.args.get(1));
                    iv_cap: string = this.vec_field(obj_val, 2);
                    iv_full: string = this.new_reg();
                    this.emit("  " + iv_full + " = icmp sge i64 " + iv_size + ", " + iv_cap);
                    iv_grow: string = this.new_label("b_ins_grow");
                    iv_fast: string = this.new_label("b_ins_fast");
                    iv_done: string = this.new_label("b_ins_done");
                    this.emit("  br i1 " + iv_full + ", label %" + iv_grow + ", label %" + iv_fast);
                    this.emit(iv_grow + ":");
                    this.current_block_terminated = false;
                    iv_next: string = this.new_reg();
                    this.emit("  " + iv_next + " = add i64 " + iv_size + ", 1");
                    this.emit("  call void @leash_sh_vec_reserve(i8* " + obj_val + ", i64 " + iv_next + ")");
                    this.emit("  br label %" + iv_fast);
                    this.emit(iv_fast + ":");
                    this.current_block_terminated = false;
                    iv_data: string = this.vec_field(obj_val, 0);
                    iv_esz: int = this.vec_elem_bytes(inner_t);
                    iv_off: string = this.new_reg();
                    this.emit("  " + iv_off + " = mul i64 " + iv_idx2 + ", " + tostring(iv_esz));
                    iv_src: string = this.new_reg();
                    this.emit("  " + iv_src + " = getelementptr inbounds i8, i8* " + iv_data + ", i64 " + iv_off);
                    iv_dst: string = this.new_reg();
                    this.emit("  " + iv_dst + " = getelementptr inbounds i8, i8* " + iv_src + ", i64 " + tostring(iv_esz));
                    iv_cnt: string = this.new_reg();
                    this.emit("  " + iv_cnt + " = sub i64 " + iv_size + ", " + iv_idx2);
                    iv_bytes: string = this.new_reg();
                    this.emit("  " + iv_bytes + " = mul i64 " + iv_cnt + ", " + tostring(iv_esz));
                    this.emit("  call i8* @memmove(i8* " + iv_dst + ", i8* " + iv_src + ", i64 " + iv_bytes + ")");
                    iv_ep: string = this.new_reg();
                    this.emit("  " + iv_ep + " = bitcast i8* " + iv_data + " to " + elt_lty + "*");
                    iv_slot: string = this.new_reg();
                    this.emit("  " + iv_slot + " = getelementptr inbounds " + elt_lty + ", " + elt_lty + "* " + iv_ep + ", i64 " + iv_idx2);
                    this.emit("  store " + elt_lty + " " + iv_val + ", " + elt_lty + "* " + iv_slot);
                    iv_ns: string = this.new_reg();
                    this.emit("  " + iv_ns + " = add i64 " + iv_size + ", 1");
                    this.vec_store_size(obj_val, iv_ns);
                    this.emit("  br label %" + iv_done);
                    this.emit(iv_done + ":");
                    this.current_block_terminated = false;
                    return "";
                }
                if e.sval == "set" {
                    idx_val: string = this.i32_to_rt_i64(e.args.get(0), this.gen_expr(e.args.get(0)));
                    aval: string = this.gen_expr(e.args.get(1));
                    sv_size: string = this.vec_field(obj_val, 1);
                    sv_i: string = this.vec_check_index(idx_val, sv_size, "Runtime error: Vector index out of bounds in set().\n");
                    sv_data: string = this.vec_field(obj_val, 0);
                    sv_ep: string = this.new_reg();
                    this.emit("  " + sv_ep + " = bitcast i8* " + sv_data + " to " + elt_lty + "*");
                    sv_slot: string = this.new_reg();
                    this.emit("  " + sv_slot + " = getelementptr inbounds " + elt_lty + ", " + elt_lty + "* " + sv_ep + ", i64 " + sv_i);
                    this.emit("  store " + elt_lty + " " + aval + ", " + elt_lty + "* " + sv_slot);
                    return "";
                }
                if e.sval == "remove" {
                    rm_idx: string = this.i32_to_rt_i64(e.args.get(0), this.gen_expr(e.args.get(0)));
                    rm_sc: string = this.scratch_i8p();
                    this.emit("  call void @leash_sh_vec_remove(i8* " + obj_val + ", i64 " + rm_idx + ", i8* " + rm_sc + ")");
                    rm_ep: string = this.new_reg();
                    this.emit("  " + rm_ep + " = bitcast [64 x i8]* @__lsh_scratch to " + elt_lty + "*");
                    rm_val: string = this.new_reg();
                    this.emit("  " + rm_val + " = load " + elt_lty + ", " + elt_lty + "* " + rm_ep);
                    return rm_val;
                }
                if e.sval == "size" {
                    return this.rt_i64_to_i32(this.vec_field(obj_val, 1));
                }
                if e.sval == "clear" {
                    this.emit("  call void @leash_sh_vec_clear(i8* " + obj_val + ")");
                    return "";
                }
                if e.sval == "isin" {
                    qval: string = this.gen_expr(e.args.get(0));
                    qtyp: string = this.get_expr_type(e.args.get(0));
                    qsc8: string = qval;
                    if qtyp != "string" {
                        // Non-string elements: stash raw bytes in the scratch
                        // buffer; the runtime memcmp's elem_size bytes.
                        qelt: string = this.llvm_type(qtyp);
                        qsc: string = this.new_reg();
                        this.emit("  " + qsc + " = bitcast [64 x i8]* @__lsh_scratch to " + qelt + "*");
                        this.emit("  store " + qelt + " " + qval + ", " + qelt + "* " + qsc);
                        qsc8 = this.scratch_i8p();
                    }
                    qmode: int = 0;
                    if qtyp == "string" { qmode = 1; }
                    res: string = this.new_reg();
                    this.emit("  " + res + " = call i64 @leash_sh_vec_isin(i8* " + obj_val + ", i8* " + qsc8 + ", i64 " + tostring(qmode) + ")");
                    bool_r: string = this.new_reg();
                    this.emit("  " + bool_r + " = trunc i64 " + res + " to i1");
                    return bool_r;
                }
                if e.sval == "extend" {
                    slice_val: string = this.gen_expr(e.args.get(0));
                    slice_t: string = this.get_expr_type(e.args.get(0));
                    sl_lty: string = this.llvm_type(slice_t);
                    sl_len: string = this.new_reg();
                    this.emit("  " + sl_len + " = extractvalue " + sl_lty + " " + slice_val + ", 0");
                    sl_ptr: string = this.new_reg();
                    this.emit("  " + sl_ptr + " = extractvalue " + sl_lty + " " + slice_val + ", 1");
                    sbase: string = "";
                    sb: int = 0;
                    while sb < slice_t.size && slice_t[sb] != '[' {
                        sbase = sbase + slice_t[sb];
                        sb = sb + 1;
                    }
                    slt: string = this.llvm_type(sbase);
                    ebytes: int = this.llvm_val_bytes(slt);
                    if ebytes < 1 { ebytes = 8; }
                    sl_bcp: string = this.new_reg();
                    this.emit("  " + sl_bcp + " = bitcast " + slt + "* " + sl_ptr + " to i8*");
                    this.emit("  call void @leash_sh_vec_extend(i8* " + obj_val + ", i8* " + sl_bcp + ", i64 " + sl_len + ", i64 " + tostring(ebytes) + ")");
                    return "";
                }
                if e.sval == "insertv" {
                    idx_val: string = this.gen_expr(e.args.get(0));
                    other_val: string = this.gen_expr(e.args.get(1));
                    this.emit("  call void @leash_sh_vec_insertv(i8* " + obj_val + ", i64 " + idx_val + ", i8* " + other_val + ")");
                    return "";
                }
            }

            // hash<K,V> methods
            if this.is_hash_type(obj_t) {
                val_t: string = this.hash_val_type(obj_t);

                if e.sval == "push" {
                    key_val: string = this.gen_expr(e.args.get(0));
                    key_val = this.hash_key_arg(key_val, this.hash_key_type(obj_t));
                    aval: string = this.gen_expr(e.args.get(1));
                    boxed: string = this.box_to_i8ptr(aval, val_t);
                    this.emit("  call void @leash_sh_hash_push(i8* " + obj_val + ", i8* " + key_val + ", i8* " + boxed + ")");
                    return "";
                }
                if e.sval == "isin" {
                    key_val: string = this.gen_expr(e.args.get(0));
                    key_val = this.hash_key_arg(key_val, this.hash_key_type(obj_t));
                    res: string = this.new_reg();
                    this.emit("  " + res + " = call i64 @leash_sh_hash_isin(i8* " + obj_val + ", i8* " + key_val + ")");
                    bool_r: string = this.new_reg();
                    this.emit("  " + bool_r + " = trunc i64 " + res + " to i1");
                    return bool_r;
                }
                if e.sval == "get" {
                    key_val: string = this.gen_expr(e.args.get(0));
                    key_val = this.hash_key_arg(key_val, this.hash_key_type(obj_t));
                    raw: string = this.new_reg();
                    this.emit("  " + raw + " = call i8* @leash_sh_hash_get(i8* " + obj_val + ", i8* " + key_val + ")");
                    return this.unbox_from_i8ptr(raw, val_t);
                }
                if e.sval == "size" {
                    res: string = this.new_reg();
                    this.emit("  " + res + " = call i64 @leash_sh_hash_size(i8* " + obj_val + ")");
                    return res;
                }
                if e.sval == "getKey" {
                    qval: string = this.gen_expr(e.args.get(0));
                    qtyp: string = this.get_expr_type(e.args.get(0));
                    qboxed: string = this.box_to_i8ptr(qval, qtyp);
                    res: string = this.new_reg();
                    this.emit("  " + res + " = call i8* @leash_sh_hash_getkey(i8* " + obj_val + ", i8* " + qboxed + ")");
                    return res;
                }
                if e.sval == "delete" {
                    key_val: string = this.gen_expr(e.args.get(0));
                    key_val = this.hash_key_arg(key_val, this.hash_key_type(obj_t));
                    this.emit("  call void @leash_sh_hash_delete(i8* " + obj_val + ", i8* " + key_val + ")");
                    return "";
                }
                if e.sval == "keys" {
                    res: string = this.new_reg();
                    this.emit("  " + res + " = call i8* @leash_sh_hash_keys(i8* " + obj_val + ")");
                    this.af_track(res);
                    return res;
                }
                if e.sval == "values" {
                    res: string = this.new_reg();
                    this.emit("  " + res + " = call i8* @leash_sh_hash_values(i8* " + obj_val + ")");
                    this.af_track(res);
                    return res;
                }
            }

            // File instance methods
            if obj_t == "File" {
                if e.sval == "read" {
                    res: string = this.new_reg();
                    this.emit("  " + res + " = call i8* @leash_sh_file_read(i8* " + obj_val + ")");
                    this.af_track(res);
                    return res;
                }
                if e.sval == "write" {
                    str_val: string = this.gen_expr(e.args.get(0));
                    wr: string = this.new_reg();
                    this.emit("  " + wr + " = call i64 @leash_sh_file_write(i8* " + obj_val + ", i8* " + str_val + ")");
                    wr = this.rt_i64_to_i32(wr);
                    return wr;
                }
                if e.sval == "close" {
                    // NOTE: named `close_r`, not `cl` — `cl: ClassInfo` is
                    // declared in another branch of this function, and
                    // re-declaring the same name with a different type
                    // makes the Python and self-hosted codegens pick
                    // different alloca types (breaking the self-host
                    // fixed point).
                    close_r: string = this.new_reg();
                    this.emit("  " + close_r + " = call i64 @leash_sh_file_close(i8* " + obj_val + ")");
                    close_r = this.rt_i64_to_i32(close_r);
                    return close_r;
                }
                if e.sval == "readln" {
                    rl: string = this.new_reg();
                    this.emit("  " + rl + " = call i8* @leash_sh_file_readln(i8* " + obj_val + ")");
                    this.af_track(rl);
                    return rl;
                }
                if e.sval == "readb" {
                    rb: string = this.new_reg();
                    this.emit("  " + rb + " = call { i64, i8* } @leash_sh_file_readb(i8* " + obj_val + ")");
                    return rb;
                }
                if e.sval == "readlnb" {
                    rlb: string = this.new_reg();
                    this.emit("  " + rlb + " = call { i64, i8* } @leash_sh_file_readlnb(i8* " + obj_val + ")");
                    return rlb;
                }
                if e.sval == "writeb" {
                    wb_src: string = this.gen_expr(e.args.get(0));
                    wb_t: string = this.get_expr_type(e.args.get(0));
                    wb_lty: string = this.llvm_type(wb_t);
                    wb_len: string = this.new_reg();
                    this.emit("  " + wb_len + " = extractvalue " + wb_lty + " " + wb_src + ", 0");
                    wb_ptr: string = this.new_reg();
                    this.emit("  " + wb_ptr + " = extractvalue " + wb_lty + " " + wb_src + ", 1");
                    wb_r: string = this.new_reg();
                    this.emit("  " + wb_r + " = call i64 @leash_sh_file_writeb(i8* " + obj_val + ", i8* " + wb_ptr + ", i64 " + wb_len + ")");
                    wb_r = this.rt_i64_to_i32(wb_r);
                    return wb_r;
                }
                // writebytes(vec<int>) -> int: exact binary output for
                // compiler backends (JVM .class files); strings cannot
                // hold NUL bytes so byte vectors are the carrier.
                if e.sval == "writebytes" {
                    wv_vec: string = this.gen_expr(e.args.get(0));
                    wv_t: string = this.get_expr_type(e.args.get(0));
                    wv_data: string = this.vec_field(wv_vec, 0);
                    wv_size: string = this.vec_field(wv_vec, 1);
                    wv_esz: int = this.vec_elem_bytes(this.vec_inner_type(wv_t));
                    wv_r: string = this.new_reg();
                    this.emit("  " + wv_r + " = call i64 @leash_sh_file_writevec(i8* " + obj_val + ", i8* " + wv_data + ", i64 " + wv_size + ", i64 " + tostring(wv_esz) + ")");
                    wv_r = this.rt_i64_to_i32(wv_r);
                    return wv_r;
                }
                if e.sval == "replace" || e.sval == "replaceall" {
                    rp_old: string = this.gen_expr(e.args.get(0));
                    rp_new: string = this.gen_expr(e.args.get(1));
                    rp_all: int = 0;
                    if e.sval == "replaceall" { rp_all = 1; }
                    rp_r: string = this.new_reg();
                    this.emit("  " + rp_r + " = call i64 @leash_sh_file_replace(i8* " + obj_val + ", i8* " + rp_old + ", i8* " + rp_new + ", i64 " + tostring(rp_all) + ")");
                    return this.rt_i64_to_i32(rp_r);
                }
                if e.sval == "rewind" {
                    this.emit("  call void @leash_sh_file_rewind(i8* " + obj_val + ")");
                    return "";
                }
            }

            // Class instance/static method: Class_method (inherited methods
            // resolve to the defining class; `this` is bitcast to it)
            m_owner: string = obj_t;
            m_g: int = 0;
            while this.tc.classes.isin(m_owner) && m_g < 16 {
                if this.tc.classes[m_owner].has_method(e.sval) { stop; }
                mp: string = this.tc.classes[m_owner].parent;
                if mp.size == 0 || !this.tc.classes.isin(mp) { stop; }
                m_owner = mp;
                m_g = m_g + 1;
            }
            mname: string = m_owner + "_" + e.sval;
            arg_strs: string = "";
            if !is_static_call {
                if m_owner == obj_t {
                    arg_strs = this.llvm_type(obj_t) + " " + obj_val;
                } else {
                    tbc: string = this.new_reg();
                    this.emit("  " + tbc + " = bitcast " + this.llvm_type(obj_t) + " " + obj_val + " to " + this.llvm_type(m_owner));
                    arg_strs = this.llvm_type(m_owner) + " " + tbc;
                }
            }
            ai: int = 0;
            foreach _, arg in<vector> e.args {
                aval: string = this.gen_expr(arg);
                atyp: string = this.get_expr_type(arg);
                alty: string = this.llvm_type(atyp);
                // Slice value into a vec param: copy into a real vec
                // (same conversion the assignment path performs)
                if this.tc.classes.isin(m_owner) {
                    mciS: ClassInfo = this.tc.classes[m_owner];
                    if mciS.method_params.isin(e.sval) {
                        mpsS: vec<string> = mciS.method_params[e.sval];
                        if ai < mpsS.size {
                            ptS2: string = mpsS.get(ai);
                            if this.is_vec_type(ptS2) && atyp.size > 1 && atyp[0] != '&' && atyp[atyp.size - 1] == ']' {
                                aval = this.slice_to_vec(aval, atyp, this.vec_inner_type(ptS2), true);
                                atyp = ptS2;
                                alty = this.llvm_type(ptS2);
                            } else {
                                adapted2: string = this.adapt_slice(aval, atyp, ptS2);
                                if adapted2 != aval {
                                    aval = adapted2;
                                    atyp = ptS2;
                                    alty = this.llvm_type(ptS2);
                                }
                            }
                        }
                    }
                }
                // Int args embed/coerce to the declared param width:
                // literals wrap/truncate at the param width, registers
                // sext/trunc (clang zero-extends mistyped constants).
                if this.tc.func_params.isin(mname) {
                    fparamsW: vec<string> = this.tc.func_params[mname];
                    if ai < fparamsW.size {
                        ptW: string = fparamsW.get(ai);
                        if ptW.size > 0 && ptW[0] != '&' {
                            pltyW: string = this.llvm_type(ptW);
                            if this.is_int_lty(alty) && this.is_int_lty(pltyW) && alty != pltyW {
                                aval = this.coerce_store_val(arg, aval, pltyW);
                                alty = pltyW;
                            }
                        }
                    }
                }
                if this.tc.classes.isin(m_owner) {
                    mciW: ClassInfo = this.tc.classes[m_owner];
                    if mciW.method_params.isin(e.sval) {
                        mpsW: vec<string> = mciW.method_params[e.sval];
                        if ai < mpsW.size {
                            ptW2: string = mpsW.get(ai);
                            if ptW2.size > 0 && ptW2[0] != '&' {
                                pltyW2: string = this.llvm_type(ptW2);
                                if this.is_int_lty(alty) && this.is_int_lty(pltyW2) && alty != pltyW2 {
                                    aval = this.coerce_store_val(arg, aval, pltyW2);
                                    alty = pltyW2;
                                }
                            }
                        }
                    }
                }
                if arg_strs.size > 0 { arg_strs = arg_strs + ", "; }
                arg_strs = arg_strs + alty + " " + aval;
                ai = ai + 1;
            }

            ret_t: string = "void";
            if this.tc.funcs.isin(mname) { ret_t = this.tc.funcs[mname]; }
            lret: string = this.llvm_type(ret_t);

            // Virtual dispatch: receiver instance method with vtable slots
            do_dispatch: bool = false;
            d_ord: vec<string>;
            if !is_static_call && this.tc.classes.isin(obj_t) {
                d_ord = this.tc.classes[obj_t].method_order;
                if d_ord.size > 0 {
                    foreach _, dmo in<vector> d_ord {
                        if dmo == e.sval { do_dispatch = true; }
                    }
                }
            }
            if do_dispatch && this.method_sigs.isin(mname) {
                d_slot: int = 0;
                foreach dsi, dmo in<vector> d_ord {
                    if dmo == e.sval { d_slot = dsi; stop; }
                }
                d_vt_ty: string = "{ ";
                d_vi: int = 0;
                while d_vi < d_ord.size {
                    if d_vi > 0 { d_vt_ty = d_vt_ty + ", "; }
                    d_vt_ty = d_vt_ty + "i8*";
                    d_vi = d_vi + 1;
                }
                d_vt_ty = d_vt_ty + " }";
                d_sp: string = this.new_reg();
                this.emit("  " + d_sp + " = getelementptr inbounds %class." + obj_t + ", %class." + obj_t + "* " + obj_val + ", i32 0, i32 0");
                d_vt0: string = this.new_reg();
                this.emit("  " + d_vt0 + " = load i8*, i8** " + d_sp);
                d_vtc: string = this.new_reg();
                this.emit("  " + d_vtc + " = bitcast i8* " + d_vt0 + " to " + d_vt_ty + "*");
                d_fp_p: string = this.new_reg();
                this.emit("  " + d_fp_p + " = getelementptr inbounds " + d_vt_ty + ", " + d_vt_ty + "* " + d_vtc + ", i32 0, i32 " + tostring(d_slot));
                d_fp: string = this.new_reg();
                this.emit("  " + d_fp + " = load i8*, i8** " + d_fp_p);
                d_sig: string = this.method_sigs[mname];
                d_fn: string = this.new_reg();
                this.emit("  " + d_fn + " = bitcast i8* " + d_fp + " to " + d_sig);
                if lret == "void" {
                    this.emit("  call void " + d_fn + "(" + arg_strs + ")");
                    return "";
                } else {
                    res: string = this.new_reg();
                    this.emit("  " + res + " = call " + lret + " " + d_fn + "(" + arg_strs + ")");
                    return res;
                }
            }

            if lret == "void" {
                this.emit("  call void @" + mname + "(" + arg_strs + ")");
                return "";
            } else {
                res: string = this.new_reg();
                this.emit("  " + res + " = call " + lret + " @" + mname + "(" + arg_strs + ")");
                return res;
            }
        }

        if e.kind == ExprKind.MEMBER {
            // Enum .name lookup via per-enum names array
            en_t: string = this.get_expr_type(e.left);
            if e.sval == "name" && this.tc.enums.isin(en_t) {
                idx_val: string = this.i32_to_rt_i64(e.left, this.gen_expr(e.left));
                en_count: int = this.tc.enum_counts[en_t];
                names_gep: string = this.new_reg();
                this.emit("  " + names_gep + " = getelementptr inbounds [" + tostring(en_count) + " x i8*], [" + tostring(en_count) + " x i8*]* @enum_" + en_t + "_names, i64 0, i64 " + idx_val);
                res: string = this.new_reg();
                this.emit("  " + res + " = load i8*, i8** " + names_gep);
                return res;
            }

            // this.static_field (static fields accessed via `this`)
            if e.left.kind == ExprKind.IDENT && e.left.sval == "this" && this.current_class_name.size > 0 && this.tc.static_fields.isin(this.current_class_name + "_" + e.sval) {
                sf_t: string = this.tc.static_fields[this.current_class_name + "_" + e.sval];
                sf_val: string = this.new_reg();
                this.emit("  " + sf_val + " = load " + this.llvm_type(sf_t) + ", " + this.llvm_type(sf_t) + "* @" + this.current_class_name + "_static_" + e.sval);
                return sf_val;
            }

            // Static class/struct field access: Tok.FOREACH
            if e.left.kind == ExprKind.IDENT && this.tc.static_fields.isin(e.left.sval + "_" + e.sval) {
                sf_t: string = this.tc.static_fields[e.left.sval + "_" + e.sval];
                sf_val: string = this.new_reg();
                this.emit("  " + sf_val + " = load " + this.llvm_type(sf_t) + ", " + this.llvm_type(sf_t) + "* @" + e.left.sval + "_static_" + e.sval);
                return sf_val;
            }

            // obj.field
            obj_t: string = this.strip_ref(this.get_expr_type(e.left));

            if this.tc.unions.isin(obj_t) {
                return this.load_union_member(e, obj_t);
            }

            obj_val: string = this.gen_expr(e.left);

            if e.sval == "size" && obj_t == "string" {
                res: string = this.new_reg();
                this.emit("  " + res + " = call i64 @strlen(i8* " + obj_val + ")");
                return this.rt_i64_to_i32(res);
            }

            if e.sval == "size" && this.is_vec_type(obj_t) {
                return this.rt_i64_to_i32(this.vec_field(obj_val, 1));
            }

            if e.sval == "size" && this.is_hash_type(obj_t) {
                res: string = this.new_reg();
                this.emit("  " + res + " = call i64 @leash_sh_hash_size(i8* " + obj_val + ")");
                return this.rt_i64_to_i32(res);
            }

            if e.sval == "size" && obj_t.size > 2 && obj_t[obj_t.size - 1] == ']' {
                res: string = this.new_reg();
                lty: string = this.llvm_type(obj_t);
                this.emit("  " + res + " = extractvalue " + lty + " " + obj_val + ", 0");
                return this.rt_i64_to_i32(res);
            }

            if this.tc.structs.isin(obj_t) {
                si: StructInfo = this.tc.structs[obj_t];
                f_idx: int = -1;
                foreach idx, fname in<vector> si.field_names {
                    if fname == e.sval { f_idx = idx; stop; }
                }
                if f_idx >= 0 {
                    gep_r: string = this.new_reg();
                    this.emit("  " + gep_r + " = getelementptr inbounds %struct." + obj_t + ", %struct." + obj_t + "* " + obj_val + ", i32 0, i32 " + tostring(f_idx));
                    load_r: string = this.new_reg();
                    ftyp: string = si.field_types.get(f_idx);
                    lftyp: string = this.llvm_type(ftyp);
                    this.emit("  " + load_r + " = load " + lftyp + ", " + lftyp + "* " + gep_r);
                    return load_r;
                }
            }

            if this.tc.classes.isin(obj_t) {
                ci: ClassInfo = this.tc.classes[obj_t];
                f_idx: int = -1;
                foreach idx, fname in<vector> ci.field_names {
                    if fname == e.sval { f_idx = idx; stop; }
                }
                if f_idx >= 0 {
                    gep_r: string = this.new_reg();
                    this.emit("  " + gep_r + " = getelementptr inbounds %class." + obj_t + ", %class." + obj_t + "* " + obj_val + ", i32 0, i32 " + tostring(f_idx + 1));
                    load_r: string = this.new_reg();
                    ftyp: string = ci.field_types.get(f_idx);
                    lftyp: string = this.llvm_type(ftyp);
                    this.emit("  " + load_r + " = load " + lftyp + ", " + lftyp + "* " + gep_r);
                    return load_r;
                }
            }
            return "0";
        }

        // p->field : gep through a raw pointer, then load
        if e.kind == ExprKind.POINTER_MEMBER {
            ptr_val: string = this.gen_expr(e.left);
            base: string = this.get_expr_type(e.left);
            if base.size > 1 && base[0] == '&' {
                base = this.strip_ref(base);
            }
            if base.size > 1 && base[0] == '*' {
                b2: string = "";
                bi2: int = 1;
                while bi2 < base.size { b2 = b2 + base[bi2]; bi2 = bi2 + 1; }
                base = b2;
            }
            if this.tc.structs.isin(base) {
                si_p: StructInfo = this.tc.structs[base];
                p_idx: int = -1;
                foreach p_i, p_name in<vector> si_p.field_names {
                    if p_name == e.sval { p_idx = p_i; stop; }
                }
                if p_idx >= 0 {
                    p_gep: string = this.new_reg();
                    this.emit("  " + p_gep + " = getelementptr inbounds %struct." + base + ", %struct." + base + "* " + ptr_val + ", i32 0, i32 " + tostring(p_idx));
                    p_ftyp: string = si_p.field_types.get(p_idx);
                    p_lty: string = this.llvm_type(p_ftyp);
                    p_load: string = this.new_reg();
                    this.emit("  " + p_load + " = load " + p_lty + ", " + p_lty + "* " + p_gep);
                    return p_load;
                }
            }
            if this.tc.classes.isin(base) {
                ci_p: ClassInfo = this.tc.classes[base];
                pc_idx: int = -1;
                foreach pc_i, pc_name in<vector> ci_p.field_names {
                    if pc_name == e.sval { pc_idx = pc_i; stop; }
                }
                if pc_idx >= 0 {
                    pc_gep: string = this.new_reg();
                    this.emit("  " + pc_gep + " = getelementptr inbounds %class." + base + ", %class." + base + "* " + ptr_val + ", i32 0, i32 " + tostring(pc_idx + 1));
                    pc_ftyp: string = ci_p.field_types.get(pc_idx);
                    pc_lty: string = this.llvm_type(pc_ftyp);
                    pc_load: string = this.new_reg();
                    this.emit("  " + pc_load + " = load " + pc_lty + ", " + pc_lty + "* " + pc_gep);
                    return pc_load;
                }
            }
            return "0";
        }

        if e.kind == ExprKind.INDEX {
            arr_val: string = this.gen_expr(e.left);
            idx_val: string = this.gen_expr(e.right);
            arr_t: string = this.strip_ref(this.get_expr_type(e.left));

            if arr_t == "string" {
                idx_val = this.i32_to_rt_i64(e.right, idx_val);
                gep_r: string = this.new_reg();
                this.emit("  " + gep_r + " = getelementptr inbounds i8, i8* " + arr_val + ", i64 " + idx_val);
                load_r: string = this.new_reg();
                this.emit("  " + load_r + " = load i8, i8* " + gep_r);
                return load_r;
            }

            // vec<T>[idx] — inline bounds-checked element load
            if this.is_vec_type(arr_t) {
                idx_val = this.i32_to_rt_i64(e.right, idx_val);
                inner_t: string = this.vec_inner_type(arr_t);
                iv_elt: string = this.llvm_type(inner_t);
                iv_size: string = this.vec_field(arr_val, 1);
                iv_i: string = this.vec_check_index(idx_val, iv_size, "Runtime error: Vector index out of bounds.\n");
                iv_data: string = this.vec_field(arr_val, 0);
                iv_ep: string = this.new_reg();
                this.emit("  " + iv_ep + " = bitcast i8* " + iv_data + " to " + iv_elt + "*");
                iv_slot: string = this.new_reg();
                this.emit("  " + iv_slot + " = getelementptr inbounds " + iv_elt + ", " + iv_elt + "* " + iv_ep + ", i64 " + iv_i);
                iv_val: string = this.new_reg();
                this.emit("  " + iv_val + " = load " + iv_elt + ", " + iv_elt + "* " + iv_slot);
                return iv_val;
            }

            // hash<K,V>[key]
            if this.is_hash_type(arr_t) {
                val_t: string = this.hash_val_type(arr_t);
                idx_val = this.hash_key_arg(idx_val, this.hash_key_type(arr_t));
                raw: string = this.new_reg();
                this.emit("  " + raw + " = call i8* @leash_sh_hash_get(i8* " + arr_val + ", i8* " + idx_val + ")");
                return this.unbox_from_i8ptr(raw, val_t);
            }

            if arr_t.size > 2 && arr_t[arr_t.size - 1] == ']' {
                base_t: string = "";
                bi: int = 0;
                while bi < arr_t.size && arr_t[bi] != '[' {
                    base_t = base_t + arr_t[bi];
                    bi = bi + 1;
                }
                lty: string = this.llvm_type(arr_t);
                elem_lty: string = this.llvm_type(base_t);
                ptr_r: string = this.new_reg();
                this.emit("  " + ptr_r + " = extractvalue " + lty + " " + arr_val + ", 1");
                idx_val = this.i32_to_rt_i64(e.right, idx_val);
                gep_r: string = this.new_reg();
                this.emit("  " + gep_r + " = getelementptr inbounds " + elem_lty + ", " + elem_lty + "* " + ptr_r + ", i64 " + idx_val);
                load_r: string = this.new_reg();
                this.emit("  " + load_r + " = load " + elem_lty + ", " + elem_lty + "* " + gep_r);
                return load_r;
            }
            return "0";
        }

        if e.kind == ExprKind.CAST {
            cast_ident_from: string = this.get_expr_type(e.left);
            if cast_ident_from == e.sval {
                return this.gen_expr(e.left);
            }
            val: string = this.gen_expr(e.left);
            from_t: string = this.get_expr_type(e.left);
            to_t: string = e.sval;

            if from_t == to_t { return val; }

            from_llvm: string = this.llvm_type(from_t);
            to_llvm: string = this.llvm_type(to_t);
            if from_llvm == to_llvm { return val; }

            if this.is_int_lty(from_llvm) && this.is_int_lty(to_llvm) {
                r_iw: string = this.new_reg();
                if this.lty_rank(from_llvm) > this.lty_rank(to_llvm) {
                    this.emit("  " + r_iw + " = trunc " + from_llvm + " " + val + " to " + to_llvm);
                } else {
                    this.emit("  " + r_iw + " = zext " + from_llvm + " " + val + " to " + to_llvm);
                }
                return r_iw;
            }
            if this.is_int_lty(from_llvm) && to_llvm == "double" {
                r_itf: string = this.new_reg();
                this.emit("  " + r_itf + " = sitofp " + from_llvm + " " + val + " to double");
                return r_itf;
            }
            if from_llvm == "double" && this.is_int_lty(to_llvm) {
                r_fti: string = this.new_reg();
                this.emit("  " + r_fti + " = fptosi double " + val + " to " + to_llvm);
                return r_fti;
            }

            res: string = this.new_reg();

            if (from_t == "int" || from_t == "char" || from_t == "bool") && to_t == "float" {
                this.emit("  " + res + " = sitofp " + from_llvm + " " + val + " to double");
                return res;
            }
            if from_t == "float" && (to_t == "int" || to_t == "char") {
                this.emit("  " + res + " = fptosi double " + val + " to " + to_llvm);
                return res;
            }
            if from_t == "char" && to_t == "int" {
                this.emit("  " + res + " = zext i8 " + val + " to i32");
                return res;
            }
            if from_t == "int" && to_t == "char" {
                this.emit("  " + res + " = trunc i32 " + val + " to i8");
                return res;
            }

            if this.is_vec_type(to_t) && from_t.size > 1 && from_t[from_t.size - 1] == ']' {
                return this.slice_to_vec(val, from_t, this.vec_inner_type(to_t), true);
            }

            this.emit("  " + res + " = bitcast " + from_llvm + " " + val + " to " + to_llvm);
            return res;
        }

        if e.kind == ExprKind.STRUCT_INIT {
            sname: string = e.sval;
            // Inside an instantiated generic class, `Tpl { ... }` refers to
            // the concrete instantiation (e.g. `Hash {}` in `Hash_string_int`).
            if this.tc.generic_classes.isin(sname) && this.current_class_name.size > sname.size
               && this.current_class_name[sname.size] == '_' {
                cc_ok: bool = true;
                cc_i: int = 0;
                while cc_i < sname.size {
                    if this.current_class_name[cc_i] != sname[cc_i] { cc_ok = false; stop; }
                    cc_i = cc_i + 1;
                }
                if cc_ok { sname = this.current_class_name; }
            }
            is_class: bool = this.tc.classes.isin(sname);
            is_struct: bool = this.tc.structs.isin(sname);

            // Get field names and types
            all_field_names: vec<string>;
            all_field_types: vec<string>;
            type_prefix: string = "%struct.";
            if is_class {
                ci: ClassInfo = this.tc.classes[sname];
                all_field_names = ci.field_names;
                all_field_types = ci.field_types;
                type_prefix = "%class.";
            } also is_struct {
                si: StructInfo = this.tc.structs[sname];
                all_field_names = si.field_names;
                all_field_types = si.field_types;
            }

            f_count: int = all_field_names.size;
            f_off: int = 0;
            if is_class { f_off = 1; }   // slot 0 is the vtable pointer
            alloc_sz: string = this.type_alloc_size(type_prefix + sname);

            raw_mem: string = this.new_reg();
            this.emit("  " + raw_mem + " = call i8* @leash_gc_malloc(i64 " + alloc_sz + ")");
            s_ptr: string = this.new_reg();
            this.emit("  " + s_ptr + " = bitcast i8* " + raw_mem + " to " + type_prefix + sname + "*");

            // Store vtable pointer at field 0 for classes with instance methods
            if is_class {
                vcip: ClassInfo = this.tc.classes[sname];
                cord: vec<string> = vcip.method_order;
                if cord.size > 0 {
                    vt_ty: string = "{ ";
                    vt_i: int = 0;
                    while vt_i < cord.size {
                        if vt_i > 0 { vt_ty = vt_ty + ", "; }
                        vt_ty = vt_ty + "i8*";
                        vt_i = vt_i + 1;
                    }
                    vt_ty = vt_ty + " }";
                    vt_sp: string = this.new_reg();
                    this.emit("  " + vt_sp + " = getelementptr inbounds %class." + sname + ", %class." + sname + "* " + s_ptr + ", i32 0, i32 0");
                    this.emit("  store i8* bitcast(" + vt_ty + "* @" + sname + "_vtable to i8*), i8** " + vt_sp);
                }
            }

            // Default-initialize all fields (declared defaults win over zeroing)
            field_inits: vec<Expr>;
            if this.struct_field_inits.isin(sname) { field_inits = this.struct_field_inits[sname]; }
            if this.class_field_inits.isin(sname) { field_inits = this.class_field_inits[sname]; }
            foreach fi, afname in<vector> all_field_names {
                ftyp: string = all_field_types.get(fi);
                lftyp: string = this.llvm_type(ftyp);
                gep_r: string = this.new_reg();
                this.emit("  " + gep_r + " = getelementptr inbounds " + type_prefix + sname + ", " + type_prefix + sname + "* " + s_ptr + ", i32 0, i32 " + tostring(f_off + fi));

                // Default init for vec/hash fields
                if this.is_vec_type(ftyp) {
                    fin_t: string = this.vec_inner_type(ftyp);
                    fin_esz: int = this.vec_elem_bytes(fin_t);
                    fin_sc: int = 0;
                    if this.vec_elem_scan(fin_t) { fin_sc = 1; }
                    def_val: string = this.new_reg();
                    this.emit("  " + def_val + " = call i8* @leash_sh_vec_new(i64 " + tostring(fin_esz) + ", i64 " + tostring(fin_sc) + ")");
                    this.emit("  store i8* " + def_val + ", i8* * " + gep_r);
                } also this.is_hash_type(ftyp) {
                    def_val: string = this.new_reg();
                    this.emit("  " + def_val + " = call i8* @leash_sh_hash_new()");
                    this.emit("  store i8* " + def_val + ", i8* * " + gep_r);
                } also fi < field_inits.size && field_inits.get(fi) != null {
                    // Declared field default: name: Type = expr;
                    dflt_val: string = this.gen_expr(field_inits.get(fi));
                    dflt_val = this.adapt_slice(dflt_val, this.get_expr_type(field_inits.get(fi)), ftyp);
                    dflt_val = this.maybe_clone_value(dflt_val, ftyp);
                    this.emit("  store " + lftyp + " " + dflt_val + ", " + lftyp + "* " + gep_r);
                } else {
                    // Zero-init
                    if lftyp == "i64" { this.emit("  store i64 0, i64* " + gep_r); }
                    also lftyp == "double" { this.emit("  store double 0.0, double* " + gep_r); }
                    also lftyp == "i1" { this.emit("  store i1 0, i1* " + gep_r); }
                    also lftyp == "i8" { this.emit("  store i8 0, i8* " + gep_r); }
                    also lftyp[0] == '{' { this.emit("  store " + lftyp + " zeroinitializer, " + lftyp + "* " + gep_r); }
                    also this.is_int_lty(lftyp) { this.emit("  store " + lftyp + " 0, " + lftyp + "* " + gep_r); }
                    else { this.emit("  store " + lftyp + " null, " + lftyp + "* " + gep_r); }
                }
            }

            // Store explicitly provided fields
            foreach i, fname in<vector> e.field_names {
                fval_expr: Expr = e.args.get(i);
                fval: string = this.gen_expr(fval_expr);
                fval_rhst: string = this.get_expr_type(fval_expr);
                f_idx: int = -1;
                foreach s_idx, s_fname in<vector> all_field_names {
                    if s_fname == fname { f_idx = s_idx; stop; }
                }
                if f_idx >= 0 {
                    gep_r: string = this.new_reg();
                    this.emit("  " + gep_r + " = getelementptr inbounds " + type_prefix + sname + ", " + type_prefix + sname + "* " + s_ptr + ", i32 0, i32 " + tostring(f_off + f_idx));
                    ftyp: string = all_field_types.get(f_idx);
                    if this.is_vec_type(ftyp) && fval_rhst.size > 1 && fval_rhst[fval_rhst.size - 1] == ']' {
                        fval = this.slice_to_vec(fval, fval_rhst, this.vec_inner_type(ftyp), false);
                    } else {
                        fval = this.adapt_slice(fval, fval_rhst, ftyp);
                    }
                    fval = this.maybe_clone_value(fval, ftyp);
                    lftyp: string = this.llvm_type(ftyp);
                    this.emit("  store " + lftyp + " " + fval + ", " + lftyp + "* " + gep_r);
                }
            }
            return s_ptr;
        }

        if e.kind == ExprKind.ARRAY_LIT {
            // Hash literal: { "key": val, ... } stored in field_names
            if e.field_names.size > 0 {
                hv: string = this.new_reg();
                this.emit("  " + hv + " = call i8* @leash_sh_hash_new()");
                this.af_track(hv);
                hi: int = 0;
                while hi < e.args.size {
                    hkey: string = e.field_names.get(hi);
                    hval_expr: Expr = e.args.get(hi);
                    hval: string = this.gen_expr(hval_expr);
                    hvtyp: string = this.get_expr_type(hval_expr);
                    hboxed: string = this.box_to_i8ptr(hval, hvtyp);
                    hkey_lbl: string = this.get_str_constant(hkey);
                    hkey_len: int = this.get_str_len(hkey);
                    hkey_gep: string = this.new_reg();
                    this.emit("  " + hkey_gep + " = getelementptr inbounds [" + tostring(hkey_len) + " x i8], [" + tostring(hkey_len) + " x i8]* " + hkey_lbl + ", i64 0, i64 0");
                    this.emit("  call void @leash_sh_hash_push(i8* " + hv + ", i8* " + hkey_gep + ", i8* " + hboxed + ")");
                    hi = hi + 1;
                }
                return hv;
            }

            count: int = e.args.size;
            base_t: string = "int";
            if count > 0 {
                base_t = this.get_expr_type(e.args.get(0));
            }
            blt: string = this.llvm_type(base_t);
            // Element-width-aware backing store; pointer-free element arrays
            // are ATOMIC so the collector never scans them.
            total: int = count * this.vec_elem_bytes(base_t);
            raw: string = this.new_reg();
            lit_flags: int = 0;
            if !this.vec_elem_scan(base_t) { lit_flags = 2; }
            this.emit("  " + raw + " = call i8* @leash_gc_malloc_ex(i64 " + tostring(total) + ", i32 " + tostring(lit_flags) + ")");
            arr_data: string = this.new_reg();
            this.emit("  " + arr_data + " = bitcast i8* " + raw + " to " + blt + "*");
            ii: int = 0;
            while ii < count {
                fval: string = this.gen_expr(e.args.get(ii));
                gep_r: string = this.new_reg();
                this.emit("  " + gep_r + " = getelementptr inbounds " + blt + ", " + blt + "* " + arr_data + ", i64 " + tostring(ii));
                this.emit("  store " + blt + " " + fval + ", " + blt + "* " + gep_r);
                ii = ii + 1;
            }
            arr_t: string = this.get_expr_type(e);
            lty: string = this.llvm_type(arr_t);
            s0: string = this.new_reg();
            this.emit("  " + s0 + " = insertvalue " + lty + " undef, i64 " + tostring(count) + ", 0");
            s1: string = this.new_reg();
            this.emit("  " + s1 + " = insertvalue " + lty + " " + s0 + ", " + blt + "* " + arr_data + ", 1");
            return s1;
        }

        if e.kind == ExprKind.TERNARY {
            res_t: string = this.get_expr_type(e);
            rty: string = this.llvm_type(res_t);
            slot: string = this.new_reg();
            this.emit("  " + slot + " = alloca " + rty + ", align 8");
            l_true: string = this.new_label("b_tern_t");
            l_false: string = this.new_label("b_tern_f");
            l_end: string = this.new_label("b_tern_m");
            c: string = this.gen_expr(e.cond);
            this.emit("  br i1 " + c + ", label %" + l_true + ", label %" + l_false);
            this.emit(l_true + ":");
            v1: string = this.gen_expr(e.left);
            this.emit("  store " + rty + " " + v1 + ", " + rty + "* " + slot);
            this.emit("  br label %" + l_end);
            this.emit(l_false + ":");
            v2: string = this.gen_expr(e.right);
            this.emit("  store " + rty + " " + v2 + ", " + rty + "* " + slot);
            this.emit("  br label %" + l_end);
            this.emit(l_end + ":");
            r: string = this.new_reg();
            this.emit("  " + r + " = load " + rty + ", " + rty + "* " + slot);
            return r;
        }

        return "0";
    }

    // Append one showb argument to the runtime output buffer.
    pub fnc gen_showb_arg(arg Expr) : void {
        batyp: string = this.get_expr_type(arg);
        if batyp.size > 1 && batyp[0] == '&' {
            bau: string = this.strip_ref(batyp);
            if !this.tc.structs.isin(bau) && !this.tc.classes.isin(bau) { batyp = bau; }
        }
        bval: string = this.gen_expr(arg);

        if batyp == "string" {
            this.emit("  call void @leash_sh_showb_append(i8* " + bval + ")");
            return;
        }
        if this.is_vec_type(batyp) {
            bin_t: string = this.vec_inner_type(batyp);
            if this.is_sized_int_type(bin_t) && this.sized_int_width(bin_t) > 64 {
                bbw: int = this.sized_int_width(bin_t);
                bbs: int = 0;
                if this.sized_int_is_signed(bin_t) { bbs = 1; }
                this.emit("  call void @leash_sh_vec_append_buf_wide(i8* " + bval + ", i64 " + tostring(bbw) + ", i64 " + tostring(bbs) + ")");
            } else {
                bbmode: int = 0;
                if bin_t == "string" { bbmode = 1; }
                also bin_t == "float" { bbmode = 2; }
                also bin_t == "char" { bbmode = 3; }
                also bin_t == "bool" { bbmode = 4; }
                this.emit("  call void @leash_sh_vec_append_buf(i8* " + bval + ", i64 " + tostring(bbmode) + ")");
            }
            return;
        }
        if this.is_sized_int_type(batyp) && this.sized_int_width(batyp) > 64 {
            bstr: string = this.wide_int_to_str(bval, batyp);
            this.emit("  call void @leash_sh_showb_append(i8* " + bstr + ")");
            return;
        }
        if batyp == "float" {
            bs: string = this.new_reg();
            this.emit("  " + bs + " = call i8* @leash_float_to_str(double " + bval + ")");
            this.af_track(bs);
            this.emit("  call void @leash_sh_showb_append(i8* " + bs + ")");
            return;
        }
        // int / char / bool / sized <=64 / fallback: format as int
        if this.is_sized_int_type(batyp) && this.sized_int_width(batyp) < 64 {
            bsl: string = "i" + tostring(this.sized_int_width(batyp));
            bext: string = bval;
            if bsl != "i64" {
                bext = this.new_reg();
                if this.sized_int_is_signed(batyp) {
                    this.emit("  " + bext + " = sext " + bsl + " " + bval + " to i64");
                } else {
                    this.emit("  " + bext + " = zext " + bsl + " " + bval + " to i64");
                }
            }
            bval = bext;
        }
        bis: string = this.new_reg();
        this.emit("  " + bis + " = call i8* @leash_int_to_str(i64 " + bval + ")");
        this.af_track(bis);
        this.emit("  call void @leash_sh_showb_append(i8* " + bis + ")");
    }

    pub fnc gen_statement(s Stmt) : void {
        if s == null || this.current_block_terminated { return; }

        // Debugger instrumentation: report (func, line) before every real
        // statement. Synthetic statements (line 0) are skipped.
        if this.debug_instrument && s.line > 0 {
            dbg_ptr: string = this.const_str_of(this.current_func_name);
            this.emit("  call void @__leash_dbg_stmt(i8* " + dbg_ptr + ", i32 " + tostring(s.line) + ")");
        }

        if s.kind == StmtKind.VAR_DECL {
            vtyp: string = s.var_type;
            if vtyp.size == 0 && s.value != null {
                // Bodies shared from generic templates are never type-checked
                // (checking would bake template types into the shared AST);
                // infer the concrete type here instead.
                vtyp = this.get_expr_type(s.value);
            }
            lty: string = this.llvm_type(vtyp);
            ptr: string = "%" + s.name + ".ptr";
            this.var_ptrs.push(s.name, ptr);
            this.var_types.push(s.name, vtyp);

            if s.value != null {
                val: string = this.gen_expr(s.value);
                rhs_t: string = this.get_expr_type(s.value);
                if this.tc.unions.isin(vtyp) {
                    this.union_auto_store(ptr, vtyp, val, rhs_t);
                    return;
                }
                if this.is_vec_type(vtyp) && rhs_t.size > 1 && rhs_t[rhs_t.size - 1] == ']' {
                    val = this.slice_to_vec(val, rhs_t, this.vec_inner_type(vtyp), true);
                }
                val = this.adapt_slice(val, rhs_t, vtyp);
                val = this.coerce_slice_ptr(val, rhs_t, vtyp);
                val = this.maybe_clone_value(val, vtyp);
                val = this.coerce_store_val(s.value, val, lty);
                this.emit("  store " + lty + " " + val + ", " + lty + "* " + ptr);
            } else {
                // Default-initialize union, vec and hash types
                if this.tc.unions.isin(vtyp) {
                    this.emit("  store " + lty + " zeroinitializer, " + lty + "* " + ptr);
                } also this.is_vec_type(vtyp) {
                    din_t: string = this.vec_inner_type(vtyp);
                    din_esz: int = this.vec_elem_bytes(din_t);
                    din_sc: int = 0;
                    if this.vec_elem_scan(din_t) { din_sc = 1; }
                    def_val: string = this.new_reg();
                    this.emit("  " + def_val + " = call i8* @leash_sh_vec_new(i64 " + tostring(din_esz) + ", i64 " + tostring(din_sc) + ")");
                    this.af_track(def_val);
                    this.emit("  store i8* " + def_val + ", i8** " + ptr);
                } also this.is_hash_type(vtyp) {
                    def_val: string = this.new_reg();
                    this.emit("  " + def_val + " = call i8* @leash_sh_hash_new()");
                    this.af_track(def_val);
                    this.emit("  store i8* " + def_val + ", i8** " + ptr);
                } also vtyp == "string" {
                    empty_lbl: string = this.get_str_constant("");
                    empty_gep: string = this.new_reg();
                    this.emit("  " + empty_gep + " = getelementptr inbounds [1 x i8], [1 x i8]* " + empty_lbl + ", i64 0, i64 0");
                    this.emit("  store i8* " + empty_gep + ", i8** " + ptr);
                } also this.tc.structs.isin(vtyp) {
                    // Default struct value: a zeroed, gc-allocated instance
                    // (escapes into vecs), with empty containers for its
                    // vec/hash fields — python parity.
                    sdflt: StructInfo = this.tc.structs[vtyp];
                    sd_sz: string = this.type_alloc_size("%struct." + vtyp);
                    sraw: string = this.new_reg();
                    this.emit("  " + sraw + " = call i8* @leash_gc_malloc(i64 " + sd_sz + ")");
                    sp2: string = this.new_reg();
                    this.emit("  " + sp2 + " = bitcast i8* " + sraw + " to %struct." + vtyp + "*");
                    this.emit("  store %struct." + vtyp + " zeroinitializer, %struct." + vtyp + "* " + sp2);
                    foreach sfi2, sfn2 in<vector> sdflt.field_names {
                        sft2: string = sdflt.field_types.get(sfi2);
                        if this.is_vec_type(sft2) {
                            sve2_t: string = this.vec_inner_type(sft2);
                            sve2_esz: int = this.vec_elem_bytes(sve2_t);
                            sve2_sc: int = 0;
                            if this.vec_elem_scan(sve2_t) { sve2_sc = 1; }
                            sve2_val: string = this.new_reg();
                            this.emit("  " + sve2_val + " = call i8* @leash_sh_vec_new(i64 " + tostring(sve2_esz) + ", i64 " + tostring(sve2_sc) + ")");
                            sve2_gep: string = this.new_reg();
                            this.emit("  " + sve2_gep + " = getelementptr inbounds %struct." + vtyp + ", %struct." + vtyp + "* " + sp2 + ", i32 0, i32 " + tostring(sfi2));
                            this.emit("  store i8* " + sve2_val + ", i8** " + sve2_gep);
                        } also this.is_hash_type(sft2) {
                            shh2_val: string = this.new_reg();
                            this.emit("  " + shh2_val + " = call i8* @leash_sh_hash_new()");
                            shh2_gep: string = this.new_reg();
                            this.emit("  " + shh2_gep + " = getelementptr inbounds %struct." + vtyp + ", %struct." + vtyp + "* " + sp2 + ", i32 0, i32 " + tostring(sfi2));
                            this.emit("  store i8* " + shh2_val + ", i8** " + shh2_gep);
                        }
                    }
                    this.emit("  store %struct." + vtyp + "* " + sp2 + ", %struct." + vtyp + "** " + ptr);
                } also this.tc.classes.isin(vtyp) && !this.tc.ctor_defaults.isin(vtyp) {
                    // Class default (no all-defaults ctor): empty instance
                    // with vtable + zeroed/default fields (Name{}-literal
                    // initialization, minus the explicit fields).
                    cdflt: ClassInfo = this.tc.classes[vtyp];
                    cd_sz: string = this.type_alloc_size("%class." + vtyp);
                    craw: string = this.new_reg();
                    this.emit("  " + craw + " = call i8* @leash_gc_malloc(i64 " + cd_sz + ")");
                    cp2: string = this.new_reg();
                    this.emit("  " + cp2 + " = bitcast i8* " + craw + " to %class." + vtyp + "*");
                    this.emit("  store %class." + vtyp + " zeroinitializer, %class." + vtyp + "* " + cp2);
                    if cdflt.method_order.size > 0 {
                        cvt_ty: string = "{ ";
                        cvt_i: int = 0;
                        while cvt_i < cdflt.method_order.size {
                            if cvt_i > 0 { cvt_ty = cvt_ty + ", "; }
                            cvt_ty = cvt_ty + "i8*";
                            cvt_i = cvt_i + 1;
                        }
                        cvt_ty = cvt_ty + " }";
                        cvt_sp: string = this.new_reg();
                        this.emit("  " + cvt_sp + " = getelementptr inbounds %class." + vtyp + ", %class." + vtyp + "* " + cp2 + ", i32 0, i32 0");
                        this.emit("  store i8* bitcast(" + cvt_ty + "* @" + vtyp + "_vtable to i8*), i8** " + cvt_sp);
                    }
                    foreach cfi2, cfn2 in<vector> cdflt.field_names {
                        cft2: string = cdflt.field_types.get(cfi2);
                        cgep2: string = this.new_reg();
                        this.emit("  " + cgep2 + " = getelementptr inbounds %class." + vtyp + ", %class." + vtyp + "* " + cp2 + ", i32 0, i32 " + tostring(cfi2 + 1));
                        chas_dflt: bool = false;
                        cdflt_expr: Expr = null;
                        if this.class_field_inits.isin(vtyp) {
                            cinits2: vec<Expr> = this.class_field_inits[vtyp];
                            if cfi2 < cinits2.size {
                                cd_e2: Expr = cinits2.get(cfi2);
                                if cd_e2 != null {
                                    cdflt_expr = cd_e2;
                                    chas_dflt = true;
                                }
                            }
                        }
                        if this.is_vec_type(cft2) {
                            cve2_t: string = this.vec_inner_type(cft2);
                            cve2_esz: int = this.vec_elem_bytes(cve2_t);
                            cve2_sc: int = 0;
                            if this.vec_elem_scan(cve2_t) { cve2_sc = 1; }
                            cve2_val: string = this.new_reg();
                            this.emit("  " + cve2_val + " = call i8* @leash_sh_vec_new(i64 " + tostring(cve2_esz) + ", i64 " + tostring(cve2_sc) + ")");
                            this.emit("  store i8* " + cve2_val + ", i8** " + cgep2);
                        } also this.is_hash_type(cft2) {
                            chh2_val: string = this.new_reg();
                            this.emit("  " + chh2_val + " = call i8* @leash_sh_hash_new()");
                            this.emit("  store i8* " + chh2_val + ", i8** " + cgep2);
                        } also chas_dflt {
                            // Declared field default: name: Type = expr;
                            cdflt_val: string = this.gen_expr(cdflt_expr);
                            cdflt_val = this.maybe_clone_value(cdflt_val, cft2);
                            clft3: string = this.llvm_type(cft2);
                            this.emit("  store " + clft3 + " " + cdflt_val + ", " + clft3 + "* " + cgep2);
                        } else {
                            clft2: string = this.llvm_type(cft2);
                            if clft2 == "i64" { this.emit("  store i64 0, i64* " + cgep2); }
                            also clft2 == "double" { this.emit("  store double 0.0, double* " + cgep2); }
                            also clft2 == "i1" { this.emit("  store i1 0, i1* " + cgep2); }
                            also clft2 == "i8" { this.emit("  store i8 0, i8* " + cgep2); }
                            also clft2.size > 0 && clft2[0] == '{' { this.emit("  store " + clft2 + " zeroinitializer, " + clft2 + "* " + cgep2); }
                            also this.is_int_lty(clft2) { this.emit("  store " + clft2 + " 0, " + clft2 + "* " + cgep2); }
                            else { this.emit("  store " + clft2 + " null, " + clft2 + "* " + cgep2); }
                        }
                    }
                    this.emit("  store %class." + vtyp + "* " + cp2 + ", %class." + vtyp + "** " + ptr);
                } also this.tc.classes.isin(vtyp) && this.tc.ctor_defaults.isin(vtyp) {
                    // Auto-init: call the all-defaults constructor
                    cdefs: vec<Expr> = this.tc.ctor_defaults[vtyp];
                    all_defaulted: bool = true;
                    foreach _, cdf in<vector> cdefs {
                        if cdf == null { all_defaulted = false; }
                    }
                    if all_defaulted && cdefs.size > 0 {
                        fnames_e: vec<string>;
                        args_e: vec<Expr>;
                        init_e: Expr = Expr.make_struct_init(vtyp, fnames_e, args_e);
                        obj_p: string = this.gen_expr(init_e);
                        ctor_args: string = this.llvm_type(vtyp) + " " + obj_p;
                        foreach _, cdf in<vector> cdefs {
                            darg: string = this.gen_expr(cdf);
                            darg_t: string = this.get_expr_type(cdf);
                            ctor_args = ctor_args + ", " + this.llvm_type(darg_t) + " " + darg;
                        }
                        this.emit("  call void @" + vtyp + "_" + vtyp + "(" + ctor_args + ")");
                        this.emit("  store " + lty + " " + obj_p + ", " + lty + "* " + ptr);
                    } else {
                        this.emit("  store " + lty + " null, " + lty + "* " + ptr);
                    }
                } also lty.size > 0 && lty[lty.size - 1] == '*' {
                    this.emit("  store " + lty + " null, " + lty + "* " + ptr);
                } also lty.size > 0 && lty[0] == '{' {
                    this.emit("  store " + lty + " zeroinitializer, " + lty + "* " + ptr);
                    // Python parity: a default struct value gets empty
                    // containers for its vec/hash fields (python's inline
                    // zeroed headers are valid empty vecs; our runtime
                    // needs real LeashVec/LeashHash objects).
                    if this.tc.structs.isin(vtyp) {
                        sinfo: StructInfo = this.tc.structs[vtyp];
                        foreach sfi, sfn in<vector> sinfo.field_names {
                            sft: string = sinfo.field_types.get(sfi);
                            if this.is_vec_type(sft) {
                                sve_t: string = this.vec_inner_type(sft);
                                sve_esz: int = this.vec_elem_bytes(sve_t);
                                sve_sc: int = 0;
                                if this.vec_elem_scan(sve_t) { sve_sc = 1; }
                                sve_val: string = this.new_reg();
                                this.emit("  " + sve_val + " = call i8* @leash_sh_vec_new(i64 " + tostring(sve_esz) + ", i64 " + tostring(sve_sc) + ")");
                                sve_gep: string = this.new_reg();
                                this.emit("  " + sve_gep + " = getelementptr inbounds " + lty + ", " + lty + "* " + ptr + ", i32 0, i32 " + tostring(sfi));
                                this.emit("  store i8* " + sve_val + ", i8** " + sve_gep);
                            } also this.is_hash_type(sft) {
                                shh_val: string = this.new_reg();
                                this.emit("  " + shh_val + " = call i8* @leash_sh_hash_new()");
                                shh_gep: string = this.new_reg();
                                this.emit("  " + shh_gep + " = getelementptr inbounds " + lty + ", " + lty + "* " + ptr + ", i32 0, i32 " + tostring(sfi));
                                this.emit("  store i8* " + shh_val + ", i8** " + shh_gep);
                            }
                        }
                    }
                }
            }
            return;
        }

        if s.kind == StmtKind.ASSIGN {
            // Fusion integer globals take the atomic path (plain loads
            // hoist out of spin-waits; atomicrmw keeps counters exact).
            // Shadowed locals and non-integer widths use the plain path.
            if s.target.kind == ExprKind.IDENT && !this.var_ptrs.isin(s.target.sval) && this.fusion_int_width(s.target.sval) > 0 {
                fw_lty: string = this.llvm_type(this.global_vars[s.target.sval]);
                this.gen_fusion_assign(s, s.target.sval, fw_lty);
                return;
            }
            val: string = this.gen_expr(s.value);
            if s.op == "=" && s.target.kind == ExprKind.IDENT {
                tn: string = s.target.sval;
                tt: string = "";
                if this.var_types.isin(tn) {
                    tt = this.var_types[tn];
                } also this.global_vars.isin(tn) {
                    tt = this.global_vars[tn];
                }
                if this.is_vec_type(tt) {
                    avt: string = this.get_expr_type(s.value);
                    if avt.size > 1 && avt[avt.size - 1] == ']' {
                        val = this.slice_to_vec(val, avt, this.vec_inner_type(tt), true);
                    }
                } else {
                    val = this.adapt_slice(val, this.get_expr_type(s.value), tt);
                }
                val = this.coerce_slice_ptr(val, this.get_expr_type(s.value), tt);
                val = this.maybe_clone_value(val, tt);
            }
            if s.target.kind == ExprKind.IDENT {
                name: string = s.target.sval;
                if !this.var_ptrs.isin(name) && this.global_vars.isin(name) {
                    gv_t: string = this.global_vars[name];
                    gv_lty: string = this.llvm_type(gv_t);
                    if s.op == "=" {
                        this.emit("  store " + gv_lty + " " + val + ", " + gv_lty + "* @g_" + name);
                        return;
                    }
                    if this.is_compound_op(s.op) {
                        cval: string = this.coerce_store_val(s.value, val, gv_lty);
                        this.emit_assign_compound("@g_" + name, gv_lty, s.op, cval);
                        return;
                    }
                    this.emit("  store " + gv_lty + " " + val + ", " + gv_lty + "* @g_" + name);
                    return;
                }
                if this.var_ptrs.isin(name) {
                    ptr: string = this.var_ptrs[name];
                    vtyp: string = this.var_types[name];
                    if this.tc.unions.isin(vtyp) && s.op == "=" {
                        this.union_auto_store(ptr, vtyp, val, this.get_expr_type(s.value));
                        return;
                    }
                    // Scalar refs assign through to the referenced cell
                    while vtyp.size > 1 && vtyp[0] == '&' {
                        inner: string = this.strip_ref(vtyp);
                        if this.tc.structs.isin(inner) || this.tc.classes.isin(inner) { stop; }
                        nplty: string = this.llvm_type(vtyp);
                        nptr: string = this.new_reg();
                        this.emit("  " + nptr + " = load " + nplty + ", " + nplty + "* " + ptr);
                        ptr = nptr;
                        vtyp = inner;
                    }
                    lty: string = this.llvm_type(vtyp);

                    if this.is_compound_op(s.op) {
                        this.emit_assign_compound(ptr, lty, s.op, val);
                        return;
                    }

                    val = this.coerce_store_val(s.value, val, lty);
                    this.emit("  store " + lty + " " + val + ", " + lty + "* " + ptr);
                }
            }
            also s.target.kind == ExprKind.UNARY && s.target.op == "*" {
                // Deref store: *p = v
                d_ptr: string = this.gen_expr(s.target.left);
                d_typ: string = this.get_expr_type(s.target.left);
                if d_typ.size > 1 && d_typ[0] == '*' {
                    d_in: string = "";
                    d_i: int = 1;
                    while d_i < d_typ.size { d_in = d_in + d_typ[d_i]; d_i = d_i + 1; }
                    d_typ = d_in;
                }
                d_lty: string = this.llvm_type(d_typ);
                if s.op == "=" {
                    val = this.maybe_clone_value(val, d_typ);
                    this.emit("  store " + d_lty + " " + val + ", " + d_lty + "* " + d_ptr);
                } also this.is_compound_op(s.op) {
                    this.emit_assign_compound(d_ptr, d_lty, s.op, val);
                }
            }
            also s.target.kind == ExprKind.POINTER_MEMBER {
                // p->field = v : gep through the raw pointer, then store
                pp_ptr: string = this.gen_expr(s.target.left);
                pp_base: string = this.get_expr_type(s.target.left);
                if pp_base.size > 1 && pp_base[0] == '&' {
                    pp_base = this.strip_ref(pp_base);
                }
                if pp_base.size > 1 && pp_base[0] == '*' {
                    pp_b2: string = "";
                    pp_i: int = 1;
                    while pp_i < pp_base.size { pp_b2 = pp_b2 + pp_base[pp_i]; pp_i = pp_i + 1; }
                    pp_base = pp_b2;
                }
                pp_fidx: int = -1;
                pp_ftyp: string = "";
                if this.tc.structs.isin(pp_base) {
                    pp_si: StructInfo = this.tc.structs[pp_base];
                    foreach pp_j, pp_n in<vector> pp_si.field_names {
                        if pp_n == s.target.sval { pp_fidx = pp_j; pp_ftyp = pp_si.field_types.get(pp_j); stop; }
                    }
                    if pp_fidx >= 0 {
                        pp_gep: string = this.new_reg();
                        this.emit("  " + pp_gep + " = getelementptr inbounds %struct." + pp_base + ", %struct." + pp_base + "* " + pp_ptr + ", i32 0, i32 " + tostring(pp_fidx));
                        pp_lty: string = this.llvm_type(pp_ftyp);
                        if s.op == "=" {
                            val = this.maybe_clone_value(val, pp_ftyp);
                            this.emit("  store " + pp_lty + " " + val + ", " + pp_lty + "* " + pp_gep);
                        } also this.is_compound_op(s.op) {
                            this.emit_assign_compound(pp_gep, pp_lty, s.op, val);
                        }
                    }
                } also this.tc.classes.isin(pp_base) {
                    pp_ci: ClassInfo = this.tc.classes[pp_base];
                    foreach pp_k, pp_m in<vector> pp_ci.field_names {
                        if pp_m == s.target.sval { pp_fidx = pp_k; pp_ftyp = pp_ci.field_types.get(pp_k); stop; }
                    }
                    if pp_fidx >= 0 {
                        pp_gep2: string = this.new_reg();
                        this.emit("  " + pp_gep2 + " = getelementptr inbounds %class." + pp_base + ", %class." + pp_base + "* " + pp_ptr + ", i32 0, i32 " + tostring(pp_fidx + 1));
                        pp_lty2: string = this.llvm_type(pp_ftyp);
                        if s.op == "=" {
                            val = this.maybe_clone_value(val, pp_ftyp);
                            this.emit("  store " + pp_lty2 + " " + val + ", " + pp_lty2 + "* " + pp_gep2);
                        } also this.is_compound_op(s.op) {
                            this.emit_assign_compound(pp_gep2, pp_lty2, s.op, val);
                        }
                    }
                }
            }
            also s.target.kind == ExprKind.MEMBER && this.tc.unions.isin(this.union_base_type(s.target)) {
                this.assign_union_member(s, this.union_base_type(s.target), val);
            }
            also s.target.kind == ExprKind.MEMBER {
                obj_t: string = this.strip_ref(this.get_expr_type(s.target.left));
                obj_val: string = this.gen_expr(s.target.left);
                // Value-copy struct-typed fields on plain assignment
                if s.op == "=" {
                    val = this.maybe_clone_value(val, this.strip_ref(this.get_expr_type(s.target)));
                }
                // Static field assignment: Class.field / this.field
                sf_key: string = "";
                sf_global: string = "";
                if s.target.left.kind == ExprKind.IDENT {
                    if s.target.left.sval != "this" && this.tc.static_fields.isin(s.target.left.sval + "_" + s.target.sval) {
                        sf_key = s.target.left.sval + "_" + s.target.sval;
                        sf_global = s.target.left.sval + "_static_" + s.target.sval;
                    } also s.target.left.sval == "this" && this.current_class_name.size > 0 && this.tc.static_fields.isin(this.current_class_name + "_" + s.target.sval) {
                        sf_key = this.current_class_name + "_" + s.target.sval;
                        sf_global = this.current_class_name + "_static_" + s.target.sval;
                    }
                }
                if sf_key.size > 0 {
                    sf_t: string = this.tc.static_fields[sf_key];
                    sf_lty: string = this.llvm_type(sf_t);
                    sf_ptr: string = "@" + sf_global;
                    if s.op == "=" {
                        this.emit("  store " + sf_lty + " " + val + ", " + sf_lty + "* " + sf_ptr);
                    } else {
                        this.emit_assign_compound(sf_ptr, sf_lty, s.op, val);
                    }
                }
                if this.tc.structs.isin(obj_t) {
                    si: StructInfo = this.tc.structs[obj_t];
                    f_idx: int = -1;
                    foreach idx, fname in<vector> si.field_names {
                        if fname == s.target.sval { f_idx = idx; stop; }
                    }
                    if f_idx >= 0 {
                        gep_r: string = this.new_reg();
                        this.emit("  " + gep_r + " = getelementptr inbounds %struct." + obj_t + ", %struct." + obj_t + "* " + obj_val + ", i32 0, i32 " + tostring(f_idx));
                        ftyp: string = si.field_types.get(f_idx);
                        lftyp: string = this.llvm_type(ftyp);
                        if s.op == "=" {
                            this.emit("  store " + lftyp + " " + val + ", " + lftyp + "* " + gep_r);
                        } else {
                            this.emit_assign_compound(gep_r, lftyp, s.op, val);
                        }
                    }
                }
                also this.tc.classes.isin(obj_t) {
                    ci: ClassInfo = this.tc.classes[obj_t];
                    f_idx: int = -1;
                    foreach idx, fname in<vector> ci.field_names {
                        if fname == s.target.sval { f_idx = idx; stop; }
                    }
                    if f_idx >= 0 {
                        gep_r: string = this.new_reg();
                        this.emit("  " + gep_r + " = getelementptr inbounds %class." + obj_t + ", %class." + obj_t + "* " + obj_val + ", i32 0, i32 " + tostring(f_idx + 1));
                        ftyp: string = ci.field_types.get(f_idx);
                        lftyp: string = this.llvm_type(ftyp);
                        if s.op == "=" {
                            this.emit("  store " + lftyp + " " + val + ", " + lftyp + "* " + gep_r);
                        } else {
                            this.emit_assign_compound(gep_r, lftyp, s.op, val);
                        }
                    }
                }
            }
            also s.target.kind == ExprKind.INDEX {
                // Index stores (absent before 1.2.2: silently dropped).
                // String elements reject at typecheck; hashing, vector,
                // and fixed/slice stores mirror the read paths.
                ix_base: string = this.strip_ref(this.get_expr_type(s.target.left));
                if this.is_hash_type(ix_base) {
                    ix_vt: string = this.hash_val_type(ix_base);
                    ix_obj: string = this.gen_expr(s.target.left);
                    ix_key: string = this.gen_expr(s.target.right);
                    ix_key = this.hash_key_arg(ix_key, this.hash_key_type(ix_base));
                    if s.op == "=" {
                        ix_boxed: string = this.box_to_i8ptr(val, this.get_expr_type(s.value));
                        this.emit("  call void @leash_sh_hash_push(i8* " + ix_obj + ", i8* " + ix_key + ", i8* " + ix_boxed + ")");
                    } else {
                        ix_raw: string = this.new_reg();
                        this.emit("  " + ix_raw + " = call i8* @leash_sh_hash_get(i8* " + ix_obj + ", i8* " + ix_key + ")");
                        ix_old: string = this.unbox_from_i8ptr(ix_raw, ix_vt);
                        ix_vlty: string = this.llvm_type(ix_vt);
                        ix_res: string = this.new_reg();
                        if (s.op == "+=" || s.op == "-=" || s.op == "*=") && this.is_int_lty(ix_vlty) {
                            ix_ir: string = "add";
                            if s.op == "-=" { ix_ir = "sub"; }
                            if s.op == "*=" { ix_ir = "mul"; }
                            ix_rhs: string = this.fusion_cast_operand(s.value, val, ix_vlty);
                            this.emit("  " + ix_res + " = " + ix_ir + " " + ix_vlty + " " + ix_old + ", " + ix_rhs);
                        } also s.op == "+=" && ix_vt == "string" {
                            this.emit("  " + ix_res + " = call i8* @leash_str_concat(i8* " + ix_old + ", i8* " + val + ")");
                        } else {
                            ix_res = val;
                        }
                        ix_boxed2: string = this.box_to_i8ptr(ix_res, ix_vt);
                        this.emit("  call void @leash_sh_hash_push(i8* " + ix_obj + ", i8* " + ix_key + ", i8* " + ix_boxed2 + ")");
                    }
                } also this.is_vec_type(ix_base) {
                    ix_inner: string = this.vec_inner_type(ix_base);
                    ix_elty: string = this.llvm_type(ix_inner);
                    ix_vobj: string = this.gen_expr(s.target.left);
                    ix_vidx: string = this.i32_to_rt_i64(s.target.right, this.gen_expr(s.target.right));
                    ix_vsize: string = this.vec_field(ix_vobj, 1);
                    ix_vi: string = this.vec_check_index(ix_vidx, ix_vsize, "Runtime error: Vector index out of bounds.\n");
                    ix_vdata: string = this.vec_field(ix_vobj, 0);
                    ix_vep: string = this.new_reg();
                    this.emit("  " + ix_vep + " = bitcast i8* " + ix_vdata + " to " + ix_elty + "*");
                    ix_vslot: string = this.new_reg();
                    this.emit("  " + ix_vslot + " = getelementptr inbounds " + ix_elty + ", " + ix_elty + "* " + ix_vep + ", i64 " + ix_vi);
                    if s.op == "=" {
                        ix_cval: string = this.coerce_store_val(s.value, val, ix_elty);
                        this.emit("  store " + ix_elty + " " + ix_cval + ", " + ix_elty + "* " + ix_vslot);
                    } else {
                        ix_cval2: string = this.coerce_store_val(s.value, val, ix_elty);
                        this.emit_assign_compound(ix_vslot, ix_elty, s.op, ix_cval2);
                    }
                } also this.is_slice_like(ix_base) {
                    ix_b: string = this.slice_base_type(ix_base);
                    ix_el: string = this.llvm_type(ix_b);
                    ix_aval: string = this.gen_expr(s.target.left);
                    ix_alty: string = this.llvm_type(ix_base);
                    ix_aptr: string = this.new_reg();
                    this.emit("  " + ix_aptr + " = extractvalue " + ix_alty + " " + ix_aval + ", 1");
                    ix_aidx: string = this.i32_to_rt_i64(s.target.right, this.gen_expr(s.target.right));
                    ix_aslot: string = this.new_reg();
                    this.emit("  " + ix_aslot + " = getelementptr inbounds " + ix_el + ", " + ix_el + "* " + ix_aptr + ", i64 " + ix_aidx);
                    if s.op == "=" {
                        ix_cval3: string = this.coerce_store_val(s.value, val, ix_el);
                        this.emit("  store " + ix_el + " " + ix_cval3 + ", " + ix_el + "* " + ix_aslot);
                    } else {
                        ix_cval4: string = this.coerce_store_val(s.value, val, ix_el);
                        this.emit_assign_compound(ix_aslot, ix_el, s.op, ix_cval4);
                    }
                }
            }
            return;
        }

        if s.kind == StmtKind.SWITCH {
            sw_val: string = this.gen_expr(s.value);
            sw_t: string = this.strip_ref(this.get_expr_type(s.value));
            sw_end: string = this.new_label("b_sw_end");
            sw_ci: int = 0;
            while sw_ci < s.switch_cases.size {
                sw_cst: Stmt = s.switch_cases.get(sw_ci);
                if sw_cst.value != null {
                    sw_cval: string = this.gen_expr(sw_cst.value);
                    sw_body_lbl: string = this.new_label("b_case");
                    sw_next_lbl: string = this.new_label("b_case_next");
                    sw_cmp: string = this.new_reg();
                    if sw_t == "string" {
                        sw_cmp32: string = this.new_reg();
                        this.emit("  " + sw_cmp32 + " = call i32 @strcmp(i8* " + sw_val + ", i8* " + sw_cval + ")");
                        this.emit("  " + sw_cmp + " = icmp eq i32 " + sw_cmp32 + ", 0");
                    } else {
                        sw_lty: string = this.llvm_type(sw_t);
                        this.emit("  " + sw_cmp + " = icmp eq " + sw_lty + " " + sw_val + ", " + sw_cval);
                    }
                    this.emit("  br i1 " + sw_cmp + ", label %" + sw_body_lbl + ", label %" + sw_next_lbl);
                    this.emit(sw_body_lbl + ":");
                    this.current_block_terminated = false;
                    foreach _, sw_bst in<vector> sw_cst.body { this.gen_statement(sw_bst); }
                    if !this.current_block_terminated {
                        this.emit("  br label %" + sw_end);
                        this.current_block_terminated = true;
                    }
                    this.emit(sw_next_lbl + ":");
                    this.current_block_terminated = false;
                }
                sw_ci = sw_ci + 1;
            }
            foreach _, sw_dst in<vector> s.default_block { this.gen_statement(sw_dst); }
            if !this.current_block_terminated {
                this.emit("  br label %" + sw_end);
            }
            this.emit(sw_end + ":");
            this.current_block_terminated = false;
            return;
        }

        if s.kind == StmtKind.RETURN {
            if s.value != null {
                // Multi-value return: build the tuple aggregate inline
                if s.value.kind == ExprKind.ARRAY_LIT && s.value.sval == "__tuple__" && this.current_func_ret.size > 1 && this.current_func_ret[0] == '(' {
                    lret: string = this.llvm_type(this.current_func_ret);
                    agg: string = lret + " undef";
                    ti: int = 0;
                    while ti < s.value.args.size {
                        tval: string = this.gen_expr(s.value.args.get(ti));
                        treg: string = this.new_reg();
                        this.emit("  " + treg + " = insertvalue " + agg + ", " + this.llvm_type(this.tuple_elem_type(this.current_func_ret, ti)) + " " + tval + ", " + tostring(ti));
                        agg = lret + " " + treg;
                        ti = ti + 1;
                    }
                    dmi: int = this.defer_stack.size - 1;
                    while dmi >= 0 {
                        this.gen_statement(this.defer_stack.get(dmi));
                        dmi = dmi - 1;
                    }
                    this.af_cleanup("");
                    this.emit("  ret " + agg);
                } else {
                    val: string = this.gen_expr(s.value);
                    ret_rhst: string = this.get_expr_type(s.value);
                    if this.is_vec_type(this.current_func_ret) && ret_rhst.size > 1 && ret_rhst[ret_rhst.size - 1] == ']' {
                        val = this.slice_to_vec(val, ret_rhst, this.vec_inner_type(this.current_func_ret), true);
                    } else {
                        val = this.adapt_slice(val, ret_rhst, this.current_func_ret);
                    }
                    val = this.maybe_clone_value(val, this.current_func_ret);
                    lret: string = this.llvm_type(this.current_func_ret);
                    // Widen/narrow the returned register to the function's
                    // declared width (int -> int<64> returns, char -> int, ...).
                    if s.value.kind != ExprKind.NIL {
                        val = this.coerce_store_val(s.value, val, lret);
                    }
                    // `return nil;` must become a typed zero for non-pointer returns
                    if s.value.kind == ExprKind.NIL {
                        if lret == "void" {
                            // void function: `ignore;` / `return nil;` ->
                            // plain ret void (no operand)
                            dvi2: int = this.defer_stack.size - 1;
                            while dvi2 >= 0 {
                                this.gen_statement(this.defer_stack.get(dvi2));
                                dvi2 = dvi2 - 1;
                            }
                            this.af_cleanup("");
                            this.emit("  ret void");
                            this.current_block_terminated = true;
                            return;
                        }
                        if lret == "double" { val = "0.0"; }
                        also lret == "i1" { val = "false"; }
                        also lret.size > 1 && lret[lret.size - 1] == '*' { val = "null"; }
                        also lret.size > 1 && lret[0] == '{' { val = "zeroinitializer"; }
                        also lret != "void" && lret.size > 0 { val = "0"; }
                    }
                    di: int = this.defer_stack.size - 1;
                    while di >= 0 {
                        this.gen_statement(this.defer_stack.get(di));
                        di = di - 1;
                    }
                    this.af_cleanup(this.af_skip_reg(val, lret));
                    this.emit("  ret " + lret + " " + val);
                }
            } else {
                dvi: int = this.defer_stack.size - 1;
                while dvi >= 0 {
                    this.gen_statement(this.defer_stack.get(dvi));
                    dvi = dvi - 1;
                }
                this.af_cleanup("");
                this.emit("  ret void");
            }
            this.current_block_terminated = true;
            return;
        }

        if s.kind == StmtKind.SPAWN {
            // Pack the arguments into a GC block (declaration order) and
            // hand them to the runtime, which pthread_creates the worker.
            // Type-checking already validated the target and arg types.
            if s.args.size > 0 {
                spn_struct: string = "{ ";
                spn_i: int = 0;
                while spn_i < s.args.size {
                    if spn_i > 0 { spn_struct = spn_struct + ", "; }
                    spn_at: string = this.get_expr_type(s.args.get(spn_i));
                    spn_lty: string = this.llvm_type(spn_at);
                    spn_struct = spn_struct + spn_lty;
                    spn_i = spn_i + 1;
                }
                spn_struct = spn_struct + " }";
                // Exact block size (padding included): a byte sum
                // undercounts wide/padded layouts and overflows.
                spn_szg: string = this.new_reg();
                this.emit("  " + spn_szg + " = getelementptr " + spn_struct + ", " + spn_struct + "* null, i32 1");
                spn_szr: string = this.new_reg();
                this.emit("  " + spn_szr + " = ptrtoint " + spn_struct + "* " + spn_szg + " to i64");
                spn_mem: string = this.new_reg();
                this.emit("  " + spn_mem + " = call i8* @leash_gc_malloc(i64 " + spn_szr + ")");
                spn_bc: string = this.new_reg();
                this.emit("  " + spn_bc + " = bitcast i8* " + spn_mem + " to " + spn_struct + "*");
                spn_j: int = 0;
                while spn_j < s.args.size {
                    spn_av: string = this.gen_expr(s.args.get(spn_j));
                    spn_at2: string = this.get_expr_type(s.args.get(spn_j));
                    spn_lty2: string = this.llvm_type(spn_at2);
                    spn_gep: string = this.new_reg();
                    this.emit("  " + spn_gep + " = getelementptr inbounds " + spn_struct + ", " + spn_struct + "* " + spn_bc + ", i32 0, i32 " + tostring(spn_j));
                    this.emit("  store " + spn_lty2 + " " + spn_av + ", " + spn_lty2 + "* " + spn_gep);
                    spn_j = spn_j + 1;
                }
                this.emit("  call i32 @leash_spawn_worker(i8* (i8*)* @" + s.name + ", i8* " + spn_mem + ")");
            } else {
                this.emit("  call i32 @leash_spawn_worker(i8* (i8*)* @" + s.name + ", i8* null)");
            }
            return;
        }

        if s.kind == StmtKind.THROW {
            throw_args_str: string = "";
            foreach ti2, ta in<vector> s.args {
                tval: string = this.gen_expr(ta);
                taty: string = this.get_expr_type(ta);
                if ti2 > 0 { throw_args_str = throw_args_str + ", "; }
                throw_args_str = throw_args_str + this.llvm_type(taty) + " " + tval;
            }
            tmsg: string = this.new_reg();
            this.emit("  " + tmsg + " = call i8* @_error_" + s.name + "(" + throw_args_str + ")");
            // The error's name rides in the message as its code: runtime
            // failures are prefixed `[Name] ` the same way static
            // diagnostics carry LEASH-Exxx codes.
            tcode: string = this.get_str_constant("[" + s.name + "] ");
            tmsg2: string = this.new_reg();
            this.emit("  " + tmsg2 + " = call i8* @leash_str_concat(i8* " + tcode + ", i8* " + tmsg + ")");
            this.af_track(tmsg2);
            tmsg = tmsg2;
            tfile_str: string = this.get_str_constant(this.main_file);
            tflen: int = this.get_str_len(tfile_str) + 1;
            tgep: string = this.new_reg();
            this.emit("  " + tgep + " = getelementptr inbounds [" + tostring(tflen) + " x i8], [" + tostring(tflen) + " x i8]* " + tfile_str + ", i64 0, i64 0");
            this.emit("  call i32 (i8*, ...) @printf(i8* getelementptr inbounds ([35 x i8], [35 x i8]* @.fmt_throw, i64 0, i64 0), i8* " + tmsg + ", i8* " + tgep + ", i32 " + tostring(s.line) + ", i32 " + tostring(s.col - 1) + ")");
            this.emit("  call void @exit(i64 1)");
            this.emit("  unreachable");
            this.current_block_terminated = true;
            return;
        }

        if s.kind == StmtKind.IF {
            c_val: string = this.gen_expr(s.cond);
            l_then: string = this.new_label("b_then");
            l_else: string = this.new_label("b_else");
            l_merge: string = this.new_label("b_merge");

            has_else: bool = s.else_block.size > 0;
            target_false: string = has_else ? l_else : l_merge;

            this.emit("  br i1 " + c_val + ", label %" + l_then + ", label %" + target_false);

            // Then block
            this.emit(l_then + ":");
            this.current_block_terminated = false;
            foreach _, st in<vector> s.then_block { this.gen_statement(st); }
            if !this.current_block_terminated {
                this.emit("  br label %" + l_merge);
            }

            // Else block
            if has_else {
                this.emit(l_else + ":");
                this.current_block_terminated = false;
                foreach _, se in<vector> s.else_block { this.gen_statement(se); }
                if !this.current_block_terminated {
                    this.emit("  br label %" + l_merge);
                }
            }

            this.emit(l_merge + ":");
            this.current_block_terminated = false;
            return;
        }

        if s.kind == StmtKind.WHILE {
            l_head: string = this.new_label("b_while_head");
            l_body: string = this.new_label("b_while_body");
            l_exit: string = this.new_label("b_while_exit");

            this.emit("  br label %" + l_head);
            this.emit(l_head + ":");
            this.current_block_terminated = false;
            c_val: string = this.gen_expr(s.cond);
            this.emit("  br i1 " + c_val + ", label %" + l_body + ", label %" + l_exit);

            this.loop_head_stack.pushb(l_head);
            this.loop_exit_stack.pushb(l_exit);

            this.emit(l_body + ":");
            this.current_block_terminated = false;
            foreach _, sb in<vector> s.body { this.gen_statement(sb); }
            if !this.current_block_terminated {
                this.emit("  br label %" + l_head);
            }

            this.loop_head_stack.popb();
            this.loop_exit_stack.popb();

            this.emit(l_exit + ":");
            this.current_block_terminated = false;
            return;
        }

        if s.kind == StmtKind.FOR {
            if s.for_init != null { this.gen_statement(s.for_init); }
            l_head: string = this.new_label("b_for_head");
            l_body: string = this.new_label("b_for_body");
            l_exit: string = this.new_label("b_for_exit");

            this.emit("  br label %" + l_head);
            this.emit(l_head + ":");
            this.current_block_terminated = false;

            c_val: string = "1";
            if s.cond != null { c_val = this.gen_expr(s.cond); }
            this.emit("  br i1 " + c_val + ", label %" + l_body + ", label %" + l_exit);

            this.loop_head_stack.pushb(l_head);
            this.loop_exit_stack.pushb(l_exit);

            this.emit(l_body + ":");
            this.current_block_terminated = false;
            foreach _, sb in<vector> s.body { this.gen_statement(sb); }
            if s.for_step != null { this.gen_statement(s.for_step); }
            if !this.current_block_terminated {
                this.emit("  br label %" + l_head);
            }

            this.loop_head_stack.popb();
            this.loop_exit_stack.popb();

            this.emit(l_exit + ":");
            this.current_block_terminated = false;
            return;
        }

        if s.kind == StmtKind.LOOP {
            l_head: string = this.new_label("b_loop_head");
            l_exit: string = this.new_label("b_loop_exit");

            this.emit("  br label %" + l_head);
            this.emit(l_head + ":");
            this.current_block_terminated = false;

            this.loop_head_stack.pushb(l_head);
            this.loop_exit_stack.pushb(l_exit);

            foreach _, sb in<vector> s.body { this.gen_statement(sb); }
            if !this.current_block_terminated {
                this.emit("  br label %" + l_head);
            }

            this.loop_head_stack.popb();
            this.loop_exit_stack.popb();

            this.emit(l_exit + ":");
            this.current_block_terminated = false;
            return;
        }

        if s.kind == StmtKind.STOP {
            if this.loop_exit_stack.size > 0 {
                exit_lbl: string = this.loop_exit_stack.get(this.loop_exit_stack.size - 1);
                this.emit("  br label %" + exit_lbl);
                this.current_block_terminated = true;
            }
            return;
        }

        if s.kind == StmtKind.SKIP {
            if this.loop_head_stack.size > 0 {
                head_lbl: string = this.loop_head_stack.get(this.loop_head_stack.size - 1);
                this.emit("  br label %" + head_lbl);
                this.current_block_terminated = true;
            }
            return;
        }

        if s.kind == StmtKind.SHOW {
            // showb: everything accumulates in the runtime buffer and is
            // flushed once at program exit; vec elements print bare (no
            // separators), matching the Python compiler.
            if s.is_showb {
                foreach _, barg in<vector> s.args {
                    this.gen_showb_arg(barg);
                }
                return;
            }
            // Translate show(arg1, arg2, ...) into calls to printf
            foreach _, arg in<vector> s.args {
                atyp: string = this.get_expr_type(arg);
                // Scalar refs print as their underlying value (python parity)
                if atyp.size > 1 && atyp[0] == '&' {
                    at_u: string = this.strip_ref(atyp);
                    if !this.tc.structs.isin(at_u) && !this.tc.classes.isin(at_u) { atyp = at_u; }
                }
                // Sized aliases print as their base kind (float<64> -> float)
                if atyp.size > 6 && atyp[0] == 'f' && atyp[1] == 'l' && atyp[2] == 'o' && atyp[3] == 'a' && atyp[4] == 't' && atyp[5] == '<' {
                    atyp = "float";
                }
                if this.tc.unions.isin(atyp) {
                    this.gen_union_show(arg, atyp);
                } else {
                aval: string = this.gen_expr(arg);

                if atyp == "string" {
                    this.emit("  call i32 (i8*, ...) @printf(i8* getelementptr inbounds ([3 x i8], [3 x i8]* @.fmt_s, i64 0, i64 0), i8* " + aval + ")");
                } also atyp == "int" {
                    this.emit("  call i32 (i8*, ...) @printf(i8* getelementptr inbounds ([5 x i8], [5 x i8]* @.fmt_d, i64 0, i64 0), i64 " + this.i32_to_rt_i64(arg, aval) + ")");
                } also atyp == "uint" {
                    uz2: string = aval;
                    if !this.is_wide_int_lit(arg) {
                        uz2 = this.new_reg();
                        this.emit("  " + uz2 + " = zext i32 " + aval + " to i64");
                    }
                    this.emit("  call i32 (i8*, ...) @printf(i8* getelementptr inbounds ([5 x i8], [5 x i8]* @.fmt_u, i64 0, i64 0), i64 " + uz2 + ")");
                } also atyp == "float" {
                    this.emit("  call i32 (i8*, ...) @printf(i8* getelementptr inbounds ([3 x i8], [3 x i8]* @.fmt_f, i64 0, i64 0), double " + aval + ")");
                } also atyp.size > 1 && (atyp[0] == '*' || atyp[0] == '&') {
                    // Pointers: *char prints as a C string; everything else %p
                    p_inner: string = "";
                    if atyp[0] == '&' {
                        p_inner = this.strip_ref(atyp);
                    } else {
                        pi3: int = 1;
                        while pi3 < atyp.size { p_inner = p_inner + atyp[pi3]; pi3 = pi3 + 1; }
                    }
                    if p_inner == "char" && atyp[0] == '*' {
                        this.emit("  call i32 (i8*, ...) @printf(i8* getelementptr inbounds ([3 x i8], [3 x i8]* @.fmt_s, i64 0, i64 0), i8* " + aval + ")");
                    } else {
                        p_lty: string = this.llvm_type(atyp);
                        this.emit("  call i32 (i8*, ...) @printf(i8* getelementptr inbounds ([3 x i8], [3 x i8]* @.fmt_p, i64 0, i64 0), " + p_lty + " " + aval + ")");
                    }
                } also atyp.size > 1 && atyp[atyp.size - 1] == ']' {
                    sl_lty: string = this.llvm_type(atyp);
                    sl_len: string = this.new_reg();
                    this.emit("  " + sl_len + " = extractvalue " + sl_lty + " " + aval + ", 0");
                    sl_len32: string = this.new_reg();
                    this.emit("  " + sl_len32 + " = trunc i64 " + sl_len + " to i32");
                    sl_ptr: string = this.new_reg();
                    this.emit("  " + sl_ptr + " = extractvalue " + sl_lty + " " + aval + ", 1");
                    this.emit("  call i32 (i8*, ...) @printf(i8* getelementptr inbounds ([5 x i8], [5 x i8]* @.fmt_prec_s, i64 0, i64 0), i32 " + sl_len32 + ", i8* " + sl_ptr + ")");
                } also this.is_sized_int_type(atyp) && this.sized_int_width(atyp) <= 64 {
                    sw: int = this.sized_int_width(atyp);
                    sslty: string = "i" + tostring(sw);
                    s_signed: bool = this.sized_int_is_signed(atyp);
                    sext64: string = aval;
                    if sslty != "i64" {
                        sext64 = this.new_reg();
                        if s_signed {
                            this.emit("  " + sext64 + " = sext " + sslty + " " + aval + " to i64");
                        } else {
                            this.emit("  " + sext64 + " = zext " + sslty + " " + aval + " to i64");
                        }
                    }
                    if s_signed {
                        this.emit("  call i32 (i8*, ...) @printf(i8* getelementptr inbounds ([5 x i8], [5 x i8]* @.fmt_d, i64 0, i64 0), i64 " + sext64 + ")");
                    } else {
                        this.emit("  call i32 (i8*, ...) @printf(i8* getelementptr inbounds ([5 x i8], [5 x i8]* @.fmt_u, i64 0, i64 0), i64 " + sext64 + ")");
                    }
                } also this.is_sized_int_type(atyp) {
                    wstr: string = this.wide_int_to_str(aval, atyp);
                    this.emit("  call i32 (i8*, ...) @printf(i8* getelementptr inbounds ([3 x i8], [3 x i8]* @.fmt_s, i64 0, i64 0), i8* " + wstr + ")");
                } also this.is_vec_type(atyp) {
                    vin: string = this.vec_inner_type(atyp);
                    if this.is_sized_int_type(vin) && this.sized_int_width(vin) > 64 {
                        vw: int = this.sized_int_width(vin);
                        vsg: int = 0;
                        if this.sized_int_is_signed(vin) { vsg = 1; }
                        this.emit("  call void @leash_sh_vec_print_wide(i8* " + aval + ", i64 " + tostring(vw) + ", i64 " + tostring(vsg) + ")");
                    } else {
                        vmode: int = 0;
                        if vin == "string" { vmode = 1; }
                        also vin == "float" { vmode = 2; }
                        also vin == "char" { vmode = 3; }
                        also vin == "bool" { vmode = 4; }
                        this.emit("  call void @leash_sh_vec_print(i8* " + aval + ", i64 " + tostring(vmode) + ")");
                    }
                } also atyp == "char" {
                    this.emit("  call i32 (i8*, ...) @printf(i8* getelementptr inbounds ([3 x i8], [3 x i8]* @.fmt_c, i64 0, i64 0), i8 " + aval + ")");
                } also atyp == "bool" {
                    l_btrue: string = this.new_label("b_bool_t");
                    l_bfalse: string = this.new_label("b_bool_f");
                    l_bmerge: string = this.new_label("b_bool_m");
                    this.emit("  br i1 " + aval + ", label %" + l_btrue + ", label %" + l_bfalse);
                    this.emit(l_btrue + ":");
                    this.emit("  call i32 (i8*, ...) @printf(i8* getelementptr inbounds ([5 x i8], [5 x i8]* @.fmt_true, i64 0, i64 0))");
                    this.emit("  br label %" + l_bmerge);
                    this.emit(l_bfalse + ":");
                    this.emit("  call i32 (i8*, ...) @printf(i8* getelementptr inbounds ([6 x i8], [6 x i8]* @.fmt_false, i64 0, i64 0))");
                    this.emit("  br label %" + l_bmerge);
                    this.emit(l_bmerge + ":");
                } also atyp == "uint" {
                    uz: string = aval;
                    if !this.is_wide_int_lit(arg) {
                        uz = this.new_reg();
                        this.emit("  " + uz + " = zext i32 " + aval + " to i64");
                    }
                    this.emit("  call i32 (i8*, ...) @printf(i8* getelementptr inbounds ([5 x i8], [5 x i8]* @.fmt_u, i64 0, i64 0), i64 " + uz + ")");
                } also this.tc.classes.isin(atyp) {
                    // Class instance: VAL_<Base> method renders it (python
                    // parity); without one, print a stable <ClassName> tag.
                    clshow: ClassInfo = this.tc.classes[atyp];
                    clbase: string = "";
                    cb_i: int = 0;
                    while cb_i < atyp.size {
                        if atyp[cb_i] == '<' { stop; }
                        clbase = clbase + atyp[cb_i];
                        cb_i = cb_i + 1;
                    }
                    clm: string = "VAL_" + clbase;
                    if clshow.has_method(clm) {
                        clmr: string = "";
                        cm_i: int = 0;
                        while cm_i < clshow.method_names.size {
                            if clshow.method_names.get(cm_i) == clm { clmr = clshow.method_rets.get(cm_i); stop; }
                            cm_i = cm_i + 1;
                        }
                        clstr: string = this.new_reg();
                        if clshow.is_method_static(clm) {
                            this.emit("  " + clstr + " = call " + this.llvm_type(clmr) + " @" + atyp + "_" + clm + "()");
                        } else {
                            this.emit("  " + clstr + " = call " + this.llvm_type(clmr) + " @" + atyp + "_" + clm + "(" + this.llvm_type(atyp) + "* " + aval + ")");
                        }
                        this.emit("  call i32 (i8*, ...) @printf(i8* getelementptr inbounds ([3 x i8], [3 x i8]* @.fmt_s, i64 0, i64 0), i8* " + clstr + ")");
                    } else {
                        clph_s: string = "<" + clbase + ">";
                        clph: string = this.get_str_constant(clph_s);
                        clphlen: int = this.get_str_len(clph_s);
                        clphp: string = this.new_reg();
                        this.emit("  " + clphp + " = getelementptr inbounds [" + tostring(clphlen) + " x i8], [" + tostring(clphlen) + " x i8]* " + clph + ", i64 0, i64 0");
                        this.emit("  call i32 (i8*, ...) @printf(i8* getelementptr inbounds ([3 x i8], [3 x i8]* @.fmt_s, i64 0, i64 0), i8* " + clphp + ")");
                    }
                } else {
                    this.emit("  call i32 (i8*, ...) @printf(i8* getelementptr inbounds ([5 x i8], [5 x i8]* @.fmt_d, i64 0, i64 0), i64 " + this.i32_to_rt_i64(arg, aval) + ")");
                }
                }
            }

            if !s.is_showb {
                // Emit newline
                this.emit("  call i32 (i8*, ...) @printf(i8* getelementptr inbounds ([2 x i8], [2 x i8]* @.fmt_nl, i64 0, i64 0))");
            }
            return;
        }

        if s.kind == StmtKind.FOREACH_STRUCT {
            struct_for_expr: Expr = s.target;
            coll_t: string = this.strip_ref(this.get_expr_type(struct_for_expr));
            // evaluate the struct value once through a fresh temp decl
            this.emit("  %__sfcollexpr.ptr = alloca " + this.llvm_type(coll_t) + ", align 8");
            sfs_d: Stmt = Stmt.make_var_decl("__sfcollexpr", coll_t, false, false, struct_for_expr);
            this.gen_statement(sfs_d);
            coll_var: Expr = Expr.make_ident("__sfcollexpr");
            fnames: vec<string>;
            ftypes: vec<string>;
            have_meta: bool = false;
            if this.tc.structs.isin(coll_t) {
                s_i: StructInfo = this.tc.structs[coll_t];
                fnames = s_i.field_names;
                ftypes = s_i.field_types;
                have_meta = true;
            } else {
                if this.tc.classes.isin(coll_t) {
                    cl_i: ClassInfo = this.tc.classes[coll_t];
                    fnames = cl_i.field_names;
                    ftypes = cl_i.field_types;
                    have_meta = true;
                }
            }
            if !have_meta {
                show("error: in<struct> foreach on non-struct type at codegen");
                return;
            }
            fio: int = 0;
            this.emit("  %" + s.name + ".ptr = alloca i8*, align 8");
            this.emit("  %" + s.var_type + ".ptr = alloca " + this.llvm_type(ftypes.get(0)) + ", align 8");
            while fio < fnames.size {
                name_decl: Stmt = Stmt.make_var_decl(s.name, "string", false, false, Expr.make_string(fnames.get(fio)));
                this.gen_statement(name_decl);
                val_decl: Stmt = Stmt.make_var_decl(s.var_type, ftypes.get(fio), false, false, Expr.make_member(coll_var, fnames.get(fio)));
                this.gen_statement(val_decl);
                foreach _, bst in<vector> s.body { this.gen_statement(bst); }
                fio = fio + 1;
            }
            return;
        }

        if s.kind == StmtKind.DEFER {
            if s.body.size > 0 {
                this.defer_stack.pushb(s.body.get(0));
            }
            return;
        }

        if s.kind == StmtKind.WORKS {
            if this.tc.works_error.size > 0 {
                // run the otherwise handler with the captured message
                this.emit("  %" + s.name + ".ptr = alloca i8*, align 8");
                err_decl: Stmt = Stmt.make_var_decl(s.name, "string", false, false, Expr.make_string(this.tc.works_error));
                this.gen_statement(err_decl);
                this.tc.works_error = "";
                foreach _, whb in<vector> s.else_block { this.gen_statement(whb); }
            } else {
                foreach _, wsb in<vector> s.body { this.gen_statement(wsb); }
            }
            return;
        }

        if s.kind == StmtKind.EXPR {
            if s.name == "__del__" && s.value != null {
                del_t: string = this.strip_ref(this.get_expr_type(s.value));
                if this.tc.classes.isin(del_t) {
                    del_mname: string = "DEL_" + del_t;
                    ci_del: ClassInfo = this.tc.classes[del_t];
                    has_del: bool = false;
                    foreach _, mn in<vector> ci_del.method_names {
                        if mn == del_mname { has_del = true; }
                    }
                    del_obj: string = this.gen_expr(s.value);
                    if has_del {
                        this.emit("  call void @" + del_t + "_" + del_mname + "(" + this.llvm_type(del_t) + " " + del_obj + ")");
                    }
                }
                return;
            }
            this.gen_expr(s.value);
            return;
        }

        if s.kind == StmtKind.BLOCK {
            foreach _, st in<vector> s.body { this.gen_statement(st); }
            return;
        }
    }

    pub fnc collect_local_vars(stmts vec<Stmt>, param_names vec<string>) : vec<Stmt> {
        res: vec<Stmt>;
        foreach _, s in<vector> stmts {
            if s.kind == StmtKind.VAR_DECL {
                res.pushb(s);
            } also s.kind == StmtKind.IF {
                sub1: vec<Stmt> = this.collect_local_vars(s.then_block, param_names);
                foreach _, s1 in<vector> sub1 { res.pushb(s1); }
                sub2: vec<Stmt> = this.collect_local_vars(s.else_block, param_names);
                foreach _, s2 in<vector> sub2 { res.pushb(s2); }
            } also s.kind == StmtKind.WHILE || s.kind == StmtKind.LOOP || s.kind == StmtKind.BLOCK {
                sub: vec<Stmt> = this.collect_local_vars(s.body, param_names);
                foreach _, sb in<vector> sub { res.pushb(sb); }
            } also s.kind == StmtKind.WORKS {
                subw: vec<Stmt> = this.collect_local_vars(s.body, param_names);
                foreach _, sb in<vector> subw { res.pushb(sb); }
                subh: vec<Stmt> = this.collect_local_vars(s.else_block, param_names);
                foreach _, sb in<vector> subh { res.pushb(sb); }
            } also s.kind == StmtKind.FOREACH_STRUCT {
                // loop vars are emitted inline at codegen; nothing to collect
            } also s.kind == StmtKind.FOR {
                if s.for_init != null && s.for_init.kind == StmtKind.VAR_DECL {
                    res.pushb(s.for_init);
                }
                sub: vec<Stmt> = this.collect_local_vars(s.body, param_names);
                foreach _, sb in<vector> sub { res.pushb(sb); }
            }
        }
        // Deduplicate by variable name (same-scope shadowed decls reuse slot)
        deduped: vec<Stmt>;
        seen: hash<string, bool>;
        is_param: bool;
        foreach _, s in<vector> res {
            is_param = false;
            foreach _, pn in<vector> param_names {
                if pn == s.name { is_param = true; }
            }
            if !is_param && !seen.isin(s.name) {
                seen.push(s.name, true);
                deduped.pushb(s);
            }
        }
        return deduped;
    }

    pub fnc is_lambda_name(n string) : bool {
        if n.size < 8 { return false; }
        if n[0] != 'l' { return false; }
        if n[1] != 'a' { return false; }
        if n[2] != 'm' { return false; }
        if n[3] != 'b' { return false; }
        if n[4] != 'd' { return false; }
        if n[5] != 'a' { return false; }
        if n[6] != '_' { return false; }
        return true;
    }

    // `async fnc` -> wrapper returning future<T>.  The worker body runs
    // under <name>__async_body; the wrapper creates the future, runs the
    // body (inline when the runtime refuses a spawn) and completes it.
    pub fnc gen_async_wrapper(f FuncDecl) : void {
        fn_name: string = f.name;
        if f.owner.size > 0 { fn_name = f.owner + "_" + f.name; }
        param_sigs: string = "";
        arg_strs: string = "";
        foreach _, p in<vector> f.params {
            if param_sigs.size > 0 { param_sigs = param_sigs + ", "; }
            param_sigs = param_sigs + this.llvm_type(p.typ) + " %p_" + p.name;
            if arg_strs.size > 0 { arg_strs = arg_strs + ", "; }
            arg_strs = arg_strs + this.llvm_type(p.typ) + " %p_" + p.name;
        }
        body: string = fn_name + "__async_body";
        this.emit("define i8* @" + fn_name + "(" + param_sigs + ") {");
        this.emit("entry:");
        aw_fut: string = this.new_reg();
        this.emit("  " + aw_fut + " = call i8* @leash_future_new()");
        aw_lret: string = this.llvm_type(f.ret_type);
        if aw_lret == "void" {
            this.emit("  call void @" + body + "(" + arg_strs + ")");
            this.emit("  call void @leash_future_complete(i8* " + aw_fut + ", i8* null)");
        } else {
            aw_call: string = this.new_reg();
            this.emit("  " + aw_call + " = call " + aw_lret + " @" + body + "(" + arg_strs + ")");
            aw_sz: int = this.llvm_val_bytes(aw_lret);
            if aw_sz <= 0 { aw_sz = 8; }
            aw_box: string = this.new_reg();
            this.emit("  " + aw_box + " = call i8* @leash_gc_malloc(i64 " + tostring(aw_sz) + ")");
            aw_bp: string = this.new_reg();
            this.emit("  " + aw_bp + " = bitcast i8* " + aw_box + " to " + aw_lret + "*");
            this.emit("  store " + aw_lret + " " + aw_call + ", " + aw_lret + "* " + aw_bp);
            this.emit("  call void @leash_future_complete(i8* " + aw_fut + ", i8* " + aw_box + ")");
        }
        this.emit("  ret i8* " + aw_fut);
        this.emit("}\n");
    }

    pub fnc gen_function(f FuncDecl) : void {
        old_fn_var_ptrs: hash<string, string> = this.var_ptrs;
        old_fn_var_types: hash<string, string> = this.var_types;
        old_fn_unsafe: bool = this.cur_func_unsafe;
        fresh_fn_ptrs: hash<string, string>;
        fresh_fn_types: hash<string, string>;
        this.var_ptrs = fresh_fn_ptrs;
        this.var_types = fresh_fn_types;
        is_worker_fn: bool = f.is_worker;
        this.current_func_ret = f.ret_type;
        if is_worker_fn { this.current_func_ret = "*char"; }
        this.cur_func_unsafe = f.is_unsafe;
        empty_defers: vec<Stmt>;
        this.defer_stack = empty_defers;
        fn_name: string = f.name;
        has_this: bool = f.owner.size > 0;
        if has_this { fn_name = f.owner + "_" + f.name; }
        this.current_func_name = fn_name;
        if this.is_lambda_name(fn_name) { this.current_func_name = "<lambda>"; }
        this.current_class_name = f.owner;
        this.current_class_parent = "";
        // Opdef instantiations: the body's local declarations keep the
        // container placeholder (`vec<__T_OPDEF__>`); derive the concrete
        // inner type from the substituted parameter types.
        this.opdef_inner = "";
        empty_tn: vec<string>;
        this.cur_tmap_names = empty_tn;
        if f.owner.size > 0 && this.tc.inst_tmaps.isin(f.owner) {
            this.cur_tmap_names = this.tc.inst_tmaps[f.owner];
        }
        if fn_name.size > 7 && fn_name[0] == '_' && fn_name[1] == 'o' && fn_name[2] == 'p'
           && fn_name[3] == 'd' && fn_name[4] == 'e' && fn_name[5] == 'f' && fn_name[6] == '_' {
            foreach _, op in<vector> f.params {
                opt: string = op.typ;
                if opt.size > 5 && opt[0] == 'v' && opt[1] == 'e' && opt[2] == 'c' && opt[3] == '<' {
                    this.opdef_inner = this.vec_inner_type(opt);
                }
                if opt.size > 8 && opt[0] == 'm' && opt[1] == 'a' && opt[2] == 't' && opt[3] == 'r' && opt[4] == 'i' && opt[5] == 'x' && opt[6] == '<' {
                    this.opdef_inner = this.vec_inner_type(opt);
                }
                if opt.size > 6 && opt[0] == 'h' && opt[1] == 'a' && opt[2] == 's' && opt[3] == 'h' && opt[4] == '<' {
                    this.opdef_inner = this.hash_val_type(opt);
                }
            }
        }
        is_user_main: bool = (f.name == "main" && !has_this);

        // If user defined main, we generate it as @__leash_user_main
        llvm_fn_name: string = is_user_main ? "__leash_user_main" : fn_name;
        lret: string = this.llvm_type(f.ret_type);

        // `worker fnc` bodies are thread entries: void*(void*). The args
        // arrive packed in a heap struct built by the spawn site.
        if is_worker_fn {
            lret = "i8*";
        }

        param_sigs: string = "";
        if is_worker_fn {
            param_sigs = "i8* %p_args";
        } else {
            if has_this { param_sigs = this.llvm_type(f.owner) + "* %p_this"; }
            foreach i, p in<vector> f.params {
                if param_sigs.size > 0 { param_sigs = param_sigs + ", "; }
                param_sigs = param_sigs + this.llvm_type(p.typ) + " %p_" + p.name;
            }
        }

        // @from externals are declared, never defined (the library provides them)
        if f.is_external {
            this.emit("declare " + lret + " @" + llvm_fn_name + "(" + param_sigs + ");");
            return;
        }
        this.emit("define " + lret + " @" + llvm_fn_name + "(" + param_sigs + ") {");
        this.emit("entry:");
        this.current_block_terminated = false;
        this.af_init();

        // `this` for functions bound to a struct/class via `-> Type`
        if has_this {
            this_lty: string = this.llvm_type(f.owner) + "*";
            this.emit("  %this.ptr = alloca " + this_lty + ", align 8");
            this.emit("  store " + this_lty + " %p_this, " + this_lty + "* %this.ptr, align 8");
            this.var_ptrs.push("this", "%this.ptr");
            this.var_types.push("this", f.owner);
        }

        // Allocas for parameters in entry block
        if is_worker_fn {
            // Unpack the spawn argument struct: bitcast, then load each
            // declared parameter from its field slot. The block was
            // registered as a GC root by leash_spawn_worker; drop it once
            // every field has been copied out.
            if f.params.size > 0 {
                w_struct: string = "{ ";
                wi: int = 0;
                while wi < f.params.size {
                    if wi > 0 { w_struct = w_struct + ", "; }
                    w_struct = w_struct + this.llvm_type(f.params.get(wi).typ);
                    wi = wi + 1;
                }
                w_struct = w_struct + " }";
                w_bc: string = this.new_reg();
                this.emit("  " + w_bc + " = bitcast i8* %p_args to " + w_struct + "*");
                wj: int = 0;
                while wj < f.params.size {
                    wp: FuncParam = f.params.get(wj);
                    wlty: string = this.llvm_type(wp.typ);
                    wptr: string = "%" + wp.name + ".ptr";
                    this.emit("  " + wptr + " = alloca " + wlty + ", align 8");
                    wgep: string = this.new_reg();
                    this.emit("  " + wgep + " = getelementptr inbounds " + w_struct + ", " + w_struct + "* " + w_bc + ", i32 0, i32 " + tostring(wj));
                    wld: string = this.new_reg();
                    this.emit("  " + wld + " = load " + wlty + ", " + wlty + "* " + wgep);
                    this.emit("  store " + wlty + " " + wld + ", " + wlty + "* " + wptr + ", align 8");
                    this.var_ptrs.push(wp.name, wptr);
                    this.var_types.push(wp.name, wp.typ);
                    wj = wj + 1;
                }
                this.emit("  call void @leash_gc_unregister_root(i8* %p_args)");
            }
        } else {
            foreach _, p in<vector> f.params {
                lty: string = this.llvm_type(p.typ);
                ptr: string = "%" + p.name + ".ptr";
                this.emit("  " + ptr + " = alloca " + lty + ", align 8");
                pval: string = this.maybe_clone_value("%p_" + p.name, p.typ);
                this.emit("  store " + lty + " " + pval + ", " + lty + "* " + ptr + ", align 8");
                this.var_ptrs.push(p.name, ptr);
                this.var_types.push(p.name, p.typ);
            }
        }

        // Pre-allocate all local variables in entry block (mem2reg requirement)
        local_param_names: vec<string>;
        if has_this { local_param_names.pushb("this"); }
        foreach _, p in<vector> f.params {
            local_param_names.pushb(p.name);
        }
        locals: vec<Stmt> = this.collect_local_vars(f.body, local_param_names);
        foreach _, loc in<vector> locals {
            loc_t: string = loc.var_type;
            if loc_t.size == 0 && loc.value != null {
                loc_t = this.get_expr_type(loc.value);
            }
            lty: string = this.llvm_type(loc_t);
            ptr: string = "%" + loc.name + ".ptr";
            this.emit("  " + ptr + " = alloca " + lty + ", align 8");
            this.var_ptrs.push(loc.name, ptr);
            this.var_types.push(loc.name, loc_t);
        }

        // Generate statements
        foreach _, s in<vector> f.body {
            this.gen_statement(s);
        }

        // If block is not terminated, emit default return
        if !this.current_block_terminated {
            dti: int = this.defer_stack.size - 1;
            while dti >= 0 {
                this.gen_statement(this.defer_stack.get(dti));
                dti = dti - 1;
            }
            this.af_cleanup("");
            if lret == "void" {
                this.emit("  ret void");
            } also lret == "i64" || lret == "i32" || lret == "i1" || lret == "i8" {
                this.emit("  ret " + lret + " 0");
            } else {
                this.emit("  ret " + lret + " null");
            }
        }

        this.emit("}\n");
        this.af_reset();
        this.var_ptrs = old_fn_var_ptrs;
        this.var_types = old_fn_var_types;
        this.cur_func_unsafe = old_fn_unsafe;
    }

    pub fnc generate_module(prog Program) : vec<string> {
        // Register module-level global variables first (functions reference them)
        foreach _, g in<vector> prog.globals {
            this.global_vars.push(g.name, g.typ);
            if g.is_fusion { this.fusion_globals.push(g.name, true); }
        }

        // Record struct/class field default initializers (for Name {} literals)
        foreach _, sd in<vector> prog.structs {
            sinits: vec<Expr>;
            foreach _, sfd in<vector> sd.fields {
                if !sfd.is_static {
                    sinits.pushb(sfd.init);
                }
            }
            this.struct_field_inits.push(sd.name, sinits);
        }
        foreach _, cd in<vector> prog.classes {
            cinits: vec<Expr>;
            foreach _, cfd in<vector> cd.fields {
                if !cfd.is_static {
                    cinits.pushb(cfd.init);
                }
            }
            this.class_field_inits.push(cd.name, cinits);
        }

        // Build method signatures for vtable dispatch (needed before bodies)
        foreach _, c in<vector> prog.classes {
            // Generic-class TEMPLATES are never codegen'd: only their
            // instantiated clones (Queue_int, ...) have concrete types.
            if this.tc.generic_classes.isin(c.name) { continue; }
            foreach _, m in<vector> c.methods {
                if this.tc.generic_funcs.isin(c.name + "_" + m.name) { continue; }
                mkey: string = c.name + "_" + m.name;
                mret: string = m.ret_type;
                if this.tc.funcs.isin(mkey) { mret = this.tc.funcs[mkey]; }
                msig: string = this.llvm_type(mret) + " (";
                if !m.is_static {
                    msig = msig + "%class." + c.name + "*";
                }
                foreach _, p in<vector> m.params {
                    if msig[msig.size - 1] != '(' { msig = msig + ", "; }
                    msig = msig + this.llvm_type(p.typ);
                }
                msig = msig + ")*";
                this.method_sigs.push(mkey, msig);
            }
        }

        // Collect all struct and class type definitions
        struct_defs: vec<string>;
        foreach _, s in<vector> prog.structs {
            fields_str: string = "";
            nfi: int = 0;
            foreach fi, fd in<vector> s.fields {
                if fd.is_static { continue; }
                if nfi > 0 { fields_str = fields_str + ", "; }
                fields_str = fields_str + this.llvm_type(fd.typ);
                nfi = nfi + 1;
            }
            struct_defs.pushb("%struct." + s.name + " = type { " + fields_str + " }");
        }

        // Class type definitions (from tc: includes inherited fields)
        foreach _, c in<vector> prog.classes {
            if this.tc.generic_classes.isin(c.name) { continue; }
            fields_str: string = "";
            nfi: int = 0;
            if this.tc.classes.isin(c.name) {
                cci: ClassInfo = this.tc.classes[c.name];
                fields_str = "i8*";   // vtable pointer slot (field 0)
                nfi = 1;
                foreach fi, _fn in<vector> cci.field_names {
                    fields_str = fields_str + ", ";
                    fields_str = fields_str + this.llvm_type(cci.field_types.get(fi));
                    nfi = nfi + 1;
                }
            }
            struct_defs.pushb("%class." + c.name + " = type { " + fields_str + " }");
        }

        // Union type definitions: { i64 tag, payload }
        foreach _, u in<vector> prog.unions {
            struct_defs.pushb("%union." + u.name + " = type { i64, " + this.union_payload_type(u.name) + " }");
        }

        // Generate class methods
        foreach _, c in<vector> prog.classes {
            if this.tc.generic_classes.isin(c.name) { continue; }
            foreach _, m in<vector> c.methods {
                if this.tc.generic_funcs.isin(c.name + "_" + m.name) { continue; }
                // Save/restore codegen state for each method
                old_var_ptrs: hash<string, string> = this.var_ptrs;
                old_var_types: hash<string, string> = this.var_types;
                fresh_ptrs: hash<string, string>;
                fresh_types: hash<string, string>;
                this.var_ptrs = fresh_ptrs;
                this.var_types = fresh_types;

                this.current_func_ret = m.ret_type;
                empty_mdefers: vec<Stmt>;
                this.defer_stack = empty_mdefers;
                fn_name: string = c.name + "_" + m.name;
                this.current_func_name = fn_name;
                // Instantiated-generic class methods: resolve the body's
                // type-param placeholders through the instantiation map.
                empty_tn_m: vec<string>;
                this.cur_tmap_names = empty_tn_m;
                if this.tc.inst_tmaps.isin(c.name) {
                    this.cur_tmap_names = this.tc.inst_tmaps[c.name];
                }
                this.current_class_name = c.name;
                this.current_class_parent = c.parent;
                this.cur_func_unsafe = m.is_unsafe;
                lret: string = this.llvm_type(m.ret_type);

                param_sigs: string = "";
                if !m.is_static {
                    param_sigs = "%class." + c.name + "* %p_this";
                }
                foreach i, p in<vector> m.params {
                    if param_sigs.size > 0 { param_sigs = param_sigs + ", "; }
                    param_sigs = param_sigs + this.llvm_type(p.typ) + " %p_" + p.name;
                }

                this.emit("define " + lret + " @" + fn_name + "(" + param_sigs + ") {");
                this.emit("entry:");
                this.current_block_terminated = false;
                this.af_init();

                // Alloca for 'this' if instance method
                if !m.is_static {
                    this_lty: string = "%class." + c.name + "*";
                    this.emit("  %this.ptr = alloca " + this_lty + ", align 8");
                    this.emit("  store " + this_lty + " %p_this, " + this_lty + "* %this.ptr, align 8");
                    this.var_ptrs.push("this", "%this.ptr");
                    this.var_types.push("this", c.name);
                }

                // Alloca for parameters
                foreach _, p in<vector> m.params {
                    lty: string = this.llvm_type(p.typ);
                    ptr: string = "%" + p.name + ".ptr";
                    this.emit("  " + ptr + " = alloca " + lty + ", align 8");
                    pval: string = this.maybe_clone_value("%p_" + p.name, p.typ);
                    this.emit("  store " + lty + " " + pval + ", " + lty + "* " + ptr + ", align 8");
                    this.var_ptrs.push(p.name, ptr);
                    this.var_types.push(p.name, p.typ);
                }

                // Pre-allocate locals
                method_param_names: vec<string>;
                if !m.is_static {
                    method_param_names.pushb("this");
                }
                foreach _, p in<vector> m.params {
                    method_param_names.pushb(p.name);
                }
                locals: vec<Stmt> = this.collect_local_vars(m.body, method_param_names);
                foreach _, loc in<vector> locals {
                    mloc_t: string = loc.var_type;
                    if mloc_t.size == 0 && loc.value != null {
                        mloc_t = this.get_expr_type(loc.value);
                    }
                    lty: string = this.llvm_type(mloc_t);
                    ptr: string = "%" + loc.name + ".ptr";
                    this.emit("  " + ptr + " = alloca " + lty + ", align 8");
                    this.var_ptrs.push(loc.name, ptr);
                    this.var_types.push(loc.name, mloc_t);
                }

                // Generate body
                foreach _, st in<vector> m.body {
                    this.gen_statement(st);
                }

                if !this.current_block_terminated {
                    mdti: int = this.defer_stack.size - 1;
                    while mdti >= 0 {
                        this.gen_statement(this.defer_stack.get(mdti));
                        mdti = mdti - 1;
                    }
                    this.af_cleanup("");
                    if lret == "void" {
                        this.emit("  ret void");
                    } also lret == "i64" || lret == "i32" || lret == "i1" || lret == "i8" {
                        this.emit("  ret " + lret + " 0");
                    } else {
                        this.emit("  ret " + lret + " null");
                    }
                }
                this.emit("}\n");
                this.af_reset();

                this.var_ptrs = old_var_ptrs;
                this.var_types = old_var_types;
            }
        }

        // Generate function bodies
        has_main: bool = false;
        main_has_args: bool = false;
        main_ret_int: bool = false;
        foreach _, f in<vector> prog.funcs {
            if f.name == "main" && f.owner.size == 0 {
                has_main = true;
                if f.params.size == 1 {
                    p0: FuncParam = f.params.get(0);
                    if p0.typ == "string[]" {
                        main_has_args = true;
                    }
                }
                if f.ret_type == "int" {
                    main_ret_int = true;
                }
            }
            if f.is_async {
                async_orig: string = f.name;
                f.name = async_orig + "__async_body";
                this.gen_function(f);
                f.name = async_orig;
                this.gen_async_wrapper(f);
            } else {
                this.gen_function(f);
            }
        }

        // Generate standard @main if user provided main
        // Emit enum variant-name tables
        foreach _, en in<vector> prog.enums {
            en_n: int = en.variants.size;
            elems_str: string = "";
            ei: int = 0;
            while ei < en_n {
                vname: string = en.variants.get(ei).name;
                vlbl: string = this.get_str_constant(vname);
                vlen: int = this.get_str_len(vname);
                if ei > 0 { elems_str = elems_str + ", "; }
                elems_str = elems_str + "i8* getelementptr inbounds ([" + tostring(vlen) + " x i8], [" + tostring(vlen) + " x i8]* " + vlbl + ", i64 0, i64 0)";
                ei = ei + 1;
            }
            if en_n == 0 {
                this.emit("@enum_" + en.name + "_names = global [1 x i8*] zeroinitializer");
            } else {
                this.emit("@enum_" + en.name + "_names = global [" + tostring(en_n) + " x i8*] [" + elems_str + "]");
            }
        }

        // Emit module-level global variables
        foreach _, g in<vector> prog.globals {
            this.global_vars.push(g.name, g.typ);
            this.emit("@g_" + g.name + " = global " + this.llvm_type(g.typ) + " zeroinitializer");
        }

        // Emit static class field globals
        foreach _, c in<vector> prog.classes {
            if this.tc.generic_classes.isin(c.name) { continue; }
            foreach _, fd in<vector> c.fields {
                if fd.is_static {
                    this.emit("@" + c.name + "_static_" + fd.name + " = global " + this.llvm_type(fd.typ) + " zeroinitializer");
                }
            }
        }
        foreach _, s in<vector> prog.structs {
            foreach _, fd in<vector> s.fields {
                if fd.is_static {
                    this.emit("@" + s.name + "_static_" + fd.name + " = global " + this.llvm_type(fd.typ) + " zeroinitializer");
                }
            }
        }

        // Emit vtable globals (classes with instance methods)
        foreach _, c in<vector> prog.classes {
            if this.tc.generic_classes.isin(c.name) { continue; }
            if this.tc.classes.isin(c.name) {
                vcinfo: ClassInfo = this.tc.classes[c.name];
                vord: vec<string> = vcinfo.method_order;
                if vord.size > 0 {
                    vt_fields: string = "";
                    vt_vals: string = "";
                    foreach vsi, vmname in<vector> vord {
                        vowner: string = c.name;
                        vog: int = 0;
                        while this.tc.classes.isin(vowner) && vog < 16 {
                            if this.tc.classes[vowner].has_method(vmname) { stop; }
                            vop: string = this.tc.classes[vowner].parent;
                            if vop.size == 0 || !this.tc.classes.isin(vop) { stop; }
                            vowner = vop;
                            vog = vog + 1;
                        }
                        vsig: string = "";
                        if this.method_sigs.isin(vowner + "_" + vmname) {
                            vsig = this.method_sigs[vowner + "_" + vmname];
                        } else {
                            vsig = "void (%class." + vowner + "*)*";
                        }
                        if vsi > 0 {
                            vt_fields = vt_fields + ", ";
                            vt_vals = vt_vals + ", ";
                        }
                        vt_fields = vt_fields + "i8*";
                        vt_vals = vt_vals + "i8* bitcast(" + vsig + " @" + vowner + "_" + vmname + " to i8*)";
                    }
                    this.emit("@" + c.name + "_vtable = internal constant { " + vt_fields + " } { " + vt_vals + " }");
                }
            }
        }

        has_class_main: bool = false;
        class_main_name: string = "";
        if !has_main {
            foreach _, c in<vector> prog.classes {
                if this.tc.generic_classes.isin(c.name) { continue; }
                foreach _, m in<vector> c.methods {
                if this.tc.generic_funcs.isin(c.name + "_" + m.name) { continue; }
                    if m.name == "main" && m.is_static {
                        has_class_main = true;
                        class_main_name = c.name + "_" + m.name;
                    }
                }
            }
        }

        this.has_entry = has_main || has_class_main;
        if (has_main || has_class_main) && !this.is_lib {
            this.emit("define i32 @main(i32 %argc, i8** %argv) {");
            this.emit("entry:");
            this.emit("  call void @leash_gc_init()");
            // Register pointer-bearing globals/statics as GC scan regions
            foreach _, g in<vector> prog.globals {
                gsz: int = this.gc_scan_size(g.typ);
                if gsz > 0 {
                    this.emit("  call void @leash_gc_register_scan_region(i8* bitcast (" + this.llvm_type(g.typ) + "* @g_" + g.name + " to i8*), i64 " + tostring(gsz) + ")");
                }
            }
            foreach _, c in<vector> prog.classes {
                if this.tc.generic_classes.isin(c.name) { continue; }
                foreach _, fd in<vector> c.fields {
                    if fd.is_static {
                        ssz: int = this.gc_scan_size(fd.typ);
                        if ssz > 0 {
                            this.emit("  call void @leash_gc_register_scan_region(i8* bitcast (" + this.llvm_type(fd.typ) + "* @" + c.name + "_static_" + fd.name + " to i8*), i64 " + tostring(ssz) + ")");
                        }
                    }
                }
            }
            foreach _, s in<vector> prog.structs {
                foreach _, fd in<vector> s.fields {
                    if fd.is_static {
                        ssz: int = this.gc_scan_size(fd.typ);
                        if ssz > 0 {
                            this.emit("  call void @leash_gc_register_scan_region(i8* bitcast (" + this.llvm_type(fd.typ) + "* @" + s.name + "_static_" + fd.name + " to i8*), i64 " + tostring(ssz) + ")");
                        }
                    }
                }
            }
            this.emit("  call void @leash_sh_timepass_init()");
            this.emit("  %t0 = call i64 @time(i8* null)");
            this.emit("  %t1 = trunc i64 %t0 to i32");
            this.emit("  call void @srand(i32 %t1)");
            // Initialize global variables
            foreach _, g in<vector> prog.globals {
                if g.init_val != null {
                    ginit: string = this.gen_expr(g.init_val);
                    g_rhst: string = this.get_expr_type(g.init_val);
                    if this.is_vec_type(g.typ) && g_rhst.size > 1 && g_rhst[g_rhst.size - 1] == ']' {
                        ginit = this.slice_to_vec(ginit, g_rhst, this.vec_inner_type(g.typ), true);
                    } else {
                        ginit = this.adapt_slice(ginit, g_rhst, g.typ);
                    }
                    g_lty: string = this.llvm_type(g.typ);
                    if this.is_vec_type(g.typ) {
                        this.emit("  store " + g_lty + " " + ginit + ", " + g_lty + "* @g_" + g.name);
                    } also this.is_hash_type(g.typ) {
                        this.emit("  store " + g_lty + " " + ginit + ", " + g_lty + "* @g_" + g.name);
                    } else {
                        this.emit("  store " + g_lty + " " + ginit + ", " + g_lty + "* @g_" + g.name);
                    }
                }
            }

            // Initialize static fields
            foreach _, c in<vector> prog.classes {
                if this.tc.generic_classes.isin(c.name) { continue; }
                foreach _, fd in<vector> c.fields {
                    if fd.is_static && fd.init != null {
                        init_val: string = this.gen_expr(fd.init);
                        fd_rhst: string = this.get_expr_type(fd.init);
                        if this.is_vec_type(fd.typ) && fd_rhst.size > 1 && fd_rhst[fd_rhst.size - 1] == ']' {
                            init_val = this.slice_to_vec(init_val, fd_rhst, this.vec_inner_type(fd.typ), true);
                        } else {
                            init_val = this.adapt_slice(init_val, fd_rhst, fd.typ);
                        }
                        this.emit("  store " + this.llvm_type(fd.typ) + " " + init_val + ", " + this.llvm_type(fd.typ) + "* @" + c.name + "_static_" + fd.name);
                    }
                }
            }
            foreach _, s in<vector> prog.structs {
                foreach _, fd in<vector> s.fields {
                    if fd.is_static && fd.init != null {
                        init_val: string = this.gen_expr(fd.init);
                        fd_rhst: string = this.get_expr_type(fd.init);
                        if this.is_vec_type(fd.typ) && fd_rhst.size > 1 && fd_rhst[fd_rhst.size - 1] == ']' {
                            init_val = this.slice_to_vec(init_val, fd_rhst, this.vec_inner_type(fd.typ), true);
                        } else {
                            init_val = this.adapt_slice(init_val, fd_rhst, fd.typ);
                        }
                        this.emit("  store " + this.llvm_type(fd.typ) + " " + init_val + ", " + this.llvm_type(fd.typ) + "* @" + s.name + "_static_" + fd.name);
                    }
                }
            }

            if has_class_main {
                this.emit("  call void @" + class_main_name + "()");
            } also main_has_args {
                this.emit("  %argc64 = zext i32 %argc to i64");
                this.emit("  %s0 = insertvalue { i64, i8** } undef, i64 %argc64, 0");
                this.emit("  %s1 = insertvalue { i64, i8** } %s0, i8** %argv, 1");
                if main_ret_int {
                    this.emit("  %ret64 = call i64 @__leash_user_main({ i64, i8** } %s1)");
                    this.emit("  %ret32 = trunc i64 %ret64 to i32");
                } else {
                    this.emit("  call void @__leash_user_main({ i64, i8** } %s1)");
                }
            } else {
                if main_ret_int {
                    this.emit("  %ret64 = call i64 @__leash_user_main()");
                    this.emit("  %ret32 = trunc i64 %ret64 to i32");
                } else {
                    this.emit("  call void @__leash_user_main()");
                }
            }
            // Join any spawned workers before flushing buffered output
            // (a worker may still append to the showb buffer).
            this.emit("  call void @leash_wait_for_workers()");
            this.emit("  call void @leash_sh_showb_flush()");
            this.emit("  call void @leash_gc_shutdown()");
            if main_ret_int {
                this.emit("  ret i32 %ret32");
            } else {
                this.emit("  ret i32 0");
            }
            this.emit("}\n");
        }

        // Library entry point: C consumers call leash_init() once before
        // any other Leash function. It runs the @main prologue (runtime
        // init, scan regions, global/static initializers) without argv
        // handling, the user entry, or the exit sequence. Never auto-runs:
        // a library must not hijack the consumer (no signal handlers).
        if this.is_lib {
            this.emit("@leash_init_guard = internal global i1 false");
            this.emit("define void @leash_init() {");
            this.emit("entry:");
            this.emit("  %done = load i1, i1* @leash_init_guard");
            this.emit("  br i1 %done, label %out, label %run");
            this.emit("run:");
            this.emit("  store i1 true, i1* @leash_init_guard");
            this.emit("  call void @leash_gc_init()");
            foreach _, g in<vector> prog.globals {
                gsz: int = this.gc_scan_size(g.typ);
                if gsz > 0 {
                    this.emit("  call void @leash_gc_register_scan_region(i8* bitcast (" + this.llvm_type(g.typ) + "* @g_" + g.name + " to i8*), i64 " + tostring(gsz) + ")");
                }
            }
            foreach _, c in<vector> prog.classes {
                if this.tc.generic_classes.isin(c.name) { continue; }
                foreach _, fd in<vector> c.fields {
                    if fd.is_static {
                        ssz: int = this.gc_scan_size(fd.typ);
                        if ssz > 0 {
                            this.emit("  call void @leash_gc_register_scan_region(i8* bitcast (" + this.llvm_type(fd.typ) + "* @" + c.name + "_static_" + fd.name + " to i8*), i64 " + tostring(ssz) + ")");
                        }
                    }
                }
            }
            foreach _, s in<vector> prog.structs {
                foreach _, fd in<vector> s.fields {
                    if fd.is_static {
                        ssz: int = this.gc_scan_size(fd.typ);
                        if ssz > 0 {
                            this.emit("  call void @leash_gc_register_scan_region(i8* bitcast (" + this.llvm_type(fd.typ) + "* @" + s.name + "_static_" + fd.name + " to i8*), i64 " + tostring(ssz) + ")");
                        }
                    }
                }
            }
            this.emit("  call void @leash_sh_timepass_init()");
            this.emit("  %t0 = call i64 @time(i8* null)");
            this.emit("  %t1 = trunc i64 %t0 to i32");
            this.emit("  call void @srand(i32 %t1)");
            foreach _, g in<vector> prog.globals {
                if g.init_val != null {
                    ginit: string = this.gen_expr(g.init_val);
                    g_rhst: string = this.get_expr_type(g.init_val);
                    if this.is_vec_type(g.typ) && g_rhst.size > 1 && g_rhst[g_rhst.size - 1] == ']' {
                        ginit = this.slice_to_vec(ginit, g_rhst, this.vec_inner_type(g.typ), true);
                    } else {
                        ginit = this.adapt_slice(ginit, g_rhst, g.typ);
                    }
                    g_lty: string = this.llvm_type(g.typ);
                    this.emit("  store " + g_lty + " " + ginit + ", " + g_lty + "* @g_" + g.name);
                }
            }
            foreach _, c in<vector> prog.classes {
                if this.tc.generic_classes.isin(c.name) { continue; }
                foreach _, fd in<vector> c.fields {
                    if fd.is_static && fd.init != null {
                        init_val: string = this.gen_expr(fd.init);
                        fd_rhst: string = this.get_expr_type(fd.init);
                        if this.is_vec_type(fd.typ) && fd_rhst.size > 1 && fd_rhst[fd_rhst.size - 1] == ']' {
                            init_val = this.slice_to_vec(init_val, fd_rhst, this.vec_inner_type(fd.typ), true);
                        } else {
                            init_val = this.adapt_slice(init_val, fd_rhst, fd.typ);
                        }
                        this.emit("  store " + this.llvm_type(fd.typ) + " " + init_val + ", " + this.llvm_type(fd.typ) + "* @" + c.name + "_static_" + fd.name);
                    }
                }
            }
            foreach _, s in<vector> prog.structs {
                foreach _, fd in<vector> s.fields {
                    if fd.is_static && fd.init != null {
                        init_val: string = this.gen_expr(fd.init);
                        fd_rhst: string = this.get_expr_type(fd.init);
                        if this.is_vec_type(fd.typ) && fd_rhst.size > 1 && fd_rhst[fd_rhst.size - 1] == ']' {
                            init_val = this.slice_to_vec(init_val, fd_rhst, this.vec_inner_type(fd.typ), true);
                        } else {
                            init_val = this.adapt_slice(init_val, fd_rhst, fd.typ);
                        }
                        this.emit("  store " + this.llvm_type(fd.typ) + " " + init_val + ", " + this.llvm_type(fd.typ) + "* @" + s.name + "_static_" + fd.name);
                    }
                }
            }
            this.emit("  br label %out");
            this.emit("out:");
            this.emit("  ret void");
            this.emit("}\n");
        }

        // Build complete LLVM IR text as a line list. Named types must
        // precede their uses, so the header is collected separately and
        // prepended to the body lines (pointer copies only - no O(n^2) joins).
        header_lines: vec<string>;
        header_lines.pushb("; ModuleID = 'leash_module'\n" +
                      "source_filename = \"leash_module\"\n" +
                      "target datalayout = \"e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128\"\n" +
                      "target triple = \"x86_64-pc-linux-gnu\"\n\n");

        // Format strings
        header_lines.pushb("@.fmt_s = private unnamed_addr constant [3 x i8] c\"%s\\00\", align 1\n" +
                    "@.fmt_d = private unnamed_addr constant [5 x i8] c\"%lld\\00\", align 1\n" +
                    "@.fmt_f = private unnamed_addr constant [3 x i8] c\"%f\\00\", align 1\n" +
                    "@.fmt_c = private unnamed_addr constant [3 x i8] c\"%c\\00\", align 1\n" +
                    "@.fmt_nl = private unnamed_addr constant [2 x i8] c\"\\0A\\00\", align 1\n" +
                    "@.fmt_true = private unnamed_addr constant [5 x i8] c\"true\\00\", align 1\n" +
                    "@.fmt_float = private unnamed_addr constant [3 x i8] c\"%f\\00\", align 1\n" +
                    "@.fmt_prec_s = private unnamed_addr constant [5 x i8] c\"%.*s\\00\", align 1\n" +
                    "@.fmt_p = private unnamed_addr constant [3 x i8] c\"%p\\00\", align 1\n" +
                    "@.fmt_false = private unnamed_addr constant [6 x i8] c\"false\\00\", align 1\n" +
                    "@.fmt_throw = private unnamed_addr constant [35 x i8] c\"\\0ARuntime error: %s\\0A  --> %s:%d:%d\\0A\\00\", align 1\n" +
                    "@.fmt_u = private unnamed_addr constant [5 x i8] c\"%llu\\00\", align 1\n\n");

        // String constants
        foreach _, sc in<vector> this.str_constants {
            header_lines.pushb(sc);
        }

        // Struct and class type definitions
        foreach _, sd_line in<vector> struct_defs {
            header_lines.pushb(sd_line);
        }

        // External declarations
        header_lines.pushb("declare i32 @printf(i8*, ...)\n" +
                    "declare i32 @puts(i8*)\n" +
                    "declare i32 @snprintf(i8*, i64, i8*, ...)\n" +
                    "declare i64 @strtoll(i8*, i8**, i64)\n" +
                    "declare double @strtod(i8*, i8**)\n" +
                    "declare i32 @leash_keyget()\n" +
                    "declare i8* @malloc(i64)\n" +
                    "declare i8* @memmove(i8*, i8*, i64)\n" +
                    "declare void @free(i8*)\n" +
                    "declare i64 @strlen(i8*)\n" +
                    "declare i64 @atoll(i8*)\n" +
                    "declare double @atof(i8*)\n" +
                    "declare i8* @strcpy(i8*, i8*)\n" +
                    "declare i8* @strcat(i8*, i8*)\n" +
                    "declare i32 @strcmp(i8*, i8*)\n" +
                    "declare i64 @memcmp(i8*, i8*, i64)\n" +
                    "declare void @leash_gc_init()\n" +
                    "declare void @leash_gc_register_scan_region(i8*, i64)\n" +
                    "declare void @leash_gc_shutdown()\n" +
                    "declare i8* @leash_gc_malloc(i64)\n" +
                    "declare void @leash_gc_collect()\n" +
                    "; Self-hosted runtime helpers\n" +
                    "declare i8* @leash_sh_vec_new(i64, i64)\n" +
                    "declare void @leash_sh_vec_pushb(i8*, i8*)\n" +
                    "declare void @leash_sh_vec_get(i8*, i64, i8*)\n" +
                    "declare void @leash_sh_vec_set(i8*, i64, i8*)\n" +
                    "declare void @leash_sh_vec_reserve(i8*, i64)\n" +
                    "declare void @leash_sh_vec_remove(i8*, i64, i8*)\n" +
                    "declare i8* @leash_bigint_to_str(i8*, i64, i64)\n" +
                    "declare i64 @leash_bigint_parse(i8*, i64, i64, i8*)\n" +
                    "declare void @leash_sh_vec_print(i8*, i64)\n" +
                    "declare void @leash_sh_vec_print_wide(i8*, i64, i64)\n" +
                    "declare void @leash_sh_showb_append(i8*)\n" +
                    "declare void @leash_sh_showb_flush()\n" +
                    "declare void @leash_sh_vec_append_buf(i8*, i64)\n" +
                    "declare void @leash_sh_vec_append_buf_wide(i8*, i64, i64)\n" +
                    "declare void @leash_sh_vec_popb(i8*, i8*)\n" +
                    "declare i64 @leash_sh_vec_size(i8*)\n" +
                    "declare i8* @leash_sh_vec_from_parts(i8*, i64, i64, i64)\n" +
                    "declare void @leash_sh_vec_extend(i8*, i8*, i64, i64)\n" +
                    "declare i64 @leash_sh_vec_isin(i8*, i8*, i64)\n" +
                    "declare i8* @leash_gc_malloc_ex(i64, i32)\n" +
                    "@__lsh_scratch = global [64 x i8] zeroinitializer, align 16\n" +
                    "declare i8* @leash_sh_clone_obj(i8*, i64)\n" +
                    "declare void @leash_sh_vec_insertv(i8*, i64, i8*)\n" +
                    "declare i64 @leash_sh_vec_eq(i8*, i8*, i64)\n" +
                    "declare void @leash_sh_vec_clear(i8*)\n" +
                    "declare void @__leash_dbg_stmt(i8*, i32)\n" +
                    "declare i8* @leash_sh_vec_binop(i8*, i8*, i64, i64)\n" +
                    "declare i8* @leash_sh_hash_new()\n" +
                    "declare i8* @leash_sh_int_key(i64)\n" +
                    "declare i8* @leash_sh_uint_key(i64)\n" +
                    "declare i8* @leash_sh_float_key(double)\n" +
                    "declare void @leash_sh_hash_push(i8*, i8*, i8*)\n" +
                    "declare i8* @leash_sh_hash_get(i8*, i8*)\n" +
                    "declare i64 @leash_sh_hash_isin(i8*, i8*)\n" +
                    "declare i64 @leash_sh_hash_size(i8*)\n" +
                    "declare i8* @leash_sh_hash_getkey(i8*, i8*)\n" +
                    "declare void @leash_sh_hash_delete(i8*, i8*)\n" +
                    "declare i8* @leash_sh_hash_keys(i8*)\n" +
                    "declare i8* @leash_sh_str_sub(i8*, i8*)\n" +
                    "declare i8* @leash_sh_str_replace(i8*, i8*, i8*)\n" +
                    "declare i8* @leash_sh_normescape(i8*)\n" +
                    "declare i8* @leash_sh_slice_to_str(i64, i8*)\n" +

                    "declare i64 @leash_sh_arr_isin_i64(i64, i64*, i64)\n" +
                    "declare i64 @leash_sh_arr_isin_i8(i8, i8*, i64)\n" +
                    "declare i64 @leash_sh_arr_isin_f64(double, double*, i64)\n" +
                    "declare i64 @leash_sh_arr_isin_str(i8*, i8**, i64)\n" +
                    "declare i64 @leash_sh_str_isin(i8*, i8*)\n" +
                    "declare void @leash_sh_timepass_init()\n" +
                    "declare double @leash_sh_timepass()\n" +
                    "declare void @leash_sh_wait(double)\n" +
                    "declare void @leash_sh_seed(i64)\n" +
                    "declare i64 @leash_sh_rand(i64, i64)\n" +
                    "declare i32 @leash_spawn_worker(i8*, i8*)\n" +
                    "declare void @leash_gc_unregister_root(i8*)\n" +
                    "declare void @leash_wait_for_workers()\n" +
                    "declare double @leash_sh_randf(double, double)\n" +
                    "declare i8* @leash_sh_choose(i64, ...)\n" +
                    "declare i64 @time(i8*)\n" +
                    "declare void @srand(i32)\n" +
                    "declare i8* @leash_sh_hash_values(i8*)\n" +
                    "declare i8* @leash_sh_file_open(i8*, i8*)\n" +
                    "declare i8* @leash_sh_file_read(i8*)\n" +
                    "declare i64 @leash_sh_file_write(i8*, i8*)\n" +
                    "declare i64 @leash_sh_file_close(i8*)\n" +
                    "declare i64 @leash_sh_file_writeb(i8*, i8*, i64)\n" +
                    "declare i64 @leash_sh_file_writevec(i8*, i8*, i64, i64)\n" +
                    "declare { i64, i8* } @leash_sh_file_readb(i8*)\n" +
                    "declare { i64, i8* } @leash_sh_file_readlnb(i8*)\n" +
                    "declare i8* @leash_sh_file_readln(i8*)\n" +
                    "declare i64 @leash_sh_file_replace(i8*, i8*, i8*, i64)\n" +
                    "declare void @leash_sh_file_rewind(i8*)\n" +
                    "declare i64 @leash_sh_file_rename(i8*, i8*)\n" +
                    "declare i64 @leash_sh_file_delete(i8*)\n" +
                    "declare i8* @leash_future_new()\n" +
                    "declare void @leash_future_complete(i8*, i8*)\n" +
                    "declare i8* @leash_future_await(i8*)\n" +
                    "declare i32 @leash_future_is_done(i8*)\n" +
                    "declare i8* @leash_sh_exec(i8*, i8*)\n" +
                    "declare i8* @fgets(i8*, i32, i8*)\n" +
                    "declare void @exit(i64)\n" +
                    "declare i8* @leash_sh_stdin()\n\n");

        // C library stubs (mirrors python's func_symtab registrations:
        // functions the typechecker seeds but that are never defined in
        // the module — the system libc provides them at link time)
        header_lines.pushb("declare i8* @calloc(i64, i64)\n");
        header_lines.pushb("declare i8* @realloc(i8*, i64)\n");
        header_lines.pushb("declare i32 @system(i8*)\n");
        header_lines.pushb("declare i64 @atoi(i8*)\n");
        header_lines.pushb("declare i64 @atol(i8*)\n");
        header_lines.pushb("declare double @strtof(i8*, i8**)\n");
        header_lines.pushb("declare double @strtold(i8*, i8**)\n");
        header_lines.pushb("declare i64 @strtol(i8*, i8**, i32)\n");
        header_lines.pushb("declare i64 @strtoul(i8*, i8**, i32)\n");
        header_lines.pushb("declare i64 @strtoull(i8*, i8**, i32)\n");
        header_lines.pushb("declare i32 @abs(i32)\n");
        header_lines.pushb("declare i64 @labs(i64)\n");
        header_lines.pushb("declare i64 @llabs(i64)\n");
        header_lines.pushb("declare void @abort()\n");
        header_lines.pushb("declare i32 @atexit(i32 ()*)\n");
        header_lines.pushb("declare i8* @getenv(i8*)\n");
        header_lines.pushb("declare void @qsort(i8*, i64, i64, i32 (i8*, i8*)*)\n");
        header_lines.pushb("declare i8* @bsearch(i8*, i8*, i64, i64, i32 (i8*, i8*)*)\n");
        header_lines.pushb("declare i64 @strncpy(i8*, i8*, i64)\n");
        header_lines.pushb("declare i8* @strstr(i8*, i8*)\n");
        header_lines.pushb("declare i8* @memset(i8*, i32, i64)\n");
        header_lines.pushb("declare i8* @memcpy(i8*, i8*, i64)\n");
        header_lines.pushb("declare i8* @memchr(i8*, i32, i64)\n");
        header_lines.pushb("declare i8* @strncat(i8*, i8*, i64)\n");
        header_lines.pushb("declare i32 @strncmp(i8*, i8*, i64)\n");
        header_lines.pushb("declare i32 @strcasecmp(i8*, i8*, i64)\n");
        header_lines.pushb("declare i32 @strncasecmp(i8*, i8*, i64)\n");
        header_lines.pushb("declare i8* @strchr(i8*, i32)\n");
        header_lines.pushb("declare i8* @strrchr(i8*, i32)\n");
        header_lines.pushb("declare i8* @strtok(i8*, i8*)\n");
        header_lines.pushb("declare i8* @strdup(i8*)\n");
        header_lines.pushb("declare i8* @strndup(i8*, i64)\n");
        header_lines.pushb("declare i8* @strpbrk(i8*, i8*)\n");
        header_lines.pushb("declare i64 @strspn(i8*, i8*)\n");
        header_lines.pushb("declare i64 @strcspn(i8*, i8*)\n");
        header_lines.pushb("declare i8* @fopen(i8*, i8*)\n");
        header_lines.pushb("declare i32 @fclose(i8*)\n");
        header_lines.pushb("declare i64 @fread(i8*, i64, i64, i8*)\n");
        header_lines.pushb("declare i64 @fwrite(i8*, i64, i64, i8*)\n");
        header_lines.pushb("declare i32 @fseek(i8*, i64, i32)\n");
        header_lines.pushb("declare i64 @ftell(i8*)\n");
        header_lines.pushb("declare void @rewind(i8*)\n");
        header_lines.pushb("declare i32 @rename(i8*, i8*)\n");
        header_lines.pushb("declare i32 @remove(i8*)\n");
        header_lines.pushb("declare i32 @fflush(i8*)\n");
        header_lines.pushb("declare i32 @feof(i8*)\n");
        header_lines.pushb("declare i32 @getchar()\n");
        header_lines.pushb("declare i32 @putchar(i32)\n");
        header_lines.pushb("declare i8* @popen(i8*, i8*)\n");
        header_lines.pushb("declare i32 @pclose(i8*)\n");
        header_lines.pushb("declare void @setbuf(i8*, i8*)\n");
        header_lines.pushb("declare i32 @scanf(i8*)\n");
        header_lines.pushb("declare i32 @fscanf(i8*, i8*)\n");
        header_lines.pushb("declare i32 @sscanf(i8*, i8*)\n");
        header_lines.pushb("declare i32 @fgetc(i8*)\n");
        header_lines.pushb("declare i32 @fputc(i32, i8*)\n");
        header_lines.pushb("declare i32 @ungetc(i32, i8*)\n");
        header_lines.pushb("declare i32 @fputs(i8*, i8*)\n");
        header_lines.pushb("declare void @perror(i8*)\n");
        header_lines.pushb("declare i8* @tmpfile()\n");
        header_lines.pushb("declare i32 @setvbuf(i8*, i8*, i32, i64)\n");
        header_lines.pushb("declare i32 @fileno(i8*)\n");
        header_lines.pushb("declare i32 @vprintf(i8*, i8*)\n");
        header_lines.pushb("declare i32 @vsprintf(i8*, i8*, i8*)\n");
        header_lines.pushb("declare i32 @vfprintf(i8*, i8*, i8*)\n");
        header_lines.pushb("declare i32 @isalnum(i32)\n");
        header_lines.pushb("declare i32 @isalpha(i32)\n");
        header_lines.pushb("declare i32 @iscntrl(i32)\n");
        header_lines.pushb("declare i32 @isdigit(i32)\n");
        header_lines.pushb("declare i32 @isgraph(i32)\n");
        header_lines.pushb("declare i32 @islower(i32)\n");
        header_lines.pushb("declare i32 @isprint(i32)\n");
        header_lines.pushb("declare i32 @ispunct(i32)\n");
        header_lines.pushb("declare i32 @isspace(i32)\n");
        header_lines.pushb("declare i32 @isupper(i32)\n");
        header_lines.pushb("declare i32 @isxdigit(i32)\n");
        header_lines.pushb("declare i32 @tolower(i32)\n");
        header_lines.pushb("declare i32 @toupper(i32)\n");
        header_lines.pushb("declare double @sin(double)\n");
        header_lines.pushb("declare double @cos(double)\n");
        header_lines.pushb("declare double @tan(double)\n");
        header_lines.pushb("declare double @asin(double)\n");
        header_lines.pushb("declare double @acos(double)\n");
        header_lines.pushb("declare double @atan(double)\n");
        header_lines.pushb("declare double @sinh(double)\n");
        header_lines.pushb("declare double @cosh(double)\n");
        header_lines.pushb("declare double @tanh(double)\n");
        header_lines.pushb("declare double @exp(double)\n");
        header_lines.pushb("declare double @log(double)\n");
        header_lines.pushb("declare double @log10(double)\n");
        header_lines.pushb("declare double @sqrt(double)\n");
        header_lines.pushb("declare double @ceil(double)\n");
        header_lines.pushb("declare double @floor(double)\n");
        header_lines.pushb("declare double @fabs(double)\n");
        header_lines.pushb("declare double @round(double)\n");
        header_lines.pushb("declare double @trunc(double)\n");
        header_lines.pushb("declare double @atan2(double, double)\n");
        header_lines.pushb("declare double @pow(double, double)\n");
        header_lines.pushb("declare double @fmod(double, double)\n");
        header_lines.pushb("declare double @fmin(double, double)\n");
        header_lines.pushb("declare double @fmax(double, double)\n");
        header_lines.pushb("declare i64 @clock()\n");
        header_lines.pushb("declare double @difftime(i64, i64)\n");
        header_lines.pushb("declare i64 @mktime(i8*)\n");
        header_lines.pushb("declare i8* @localtime(i8*)\n");
        header_lines.pushb("declare i8* @gmtime(i8*)\n");
        header_lines.pushb("declare i8* @asctime(i8*)\n");
        header_lines.pushb("declare i8* @ctime(i8*)\n");
        header_lines.pushb("declare i64 @strftime(i8*, i64, i8*, i8*)\n");
        header_lines.pushb("declare i32 @usleep(i64)\n");
        header_lines.pushb("declare i32 @rand()\n");

        // C-stub declares must not collide with program-defined functions
        // (python parity: user func_symtab entries overwrite the stubs —
        // e.g. an unsafe fnc fabs would otherwise redeclare libc's fabs).
        defined_syms: hash<string, bool>;
        foreach _, pf in<vector> prog.funcs {
            defined_syms.push(pf.name, true);
        }
        foreach _, pc in<vector> prog.classes {
            if this.tc.generic_classes.isin(pc.name) { continue; }
            foreach _, pm in<vector> pc.methods {
                defined_syms.push(pc.name + "_" + pm.name, true);
            }
        }
        filtered_hdr: vec<string>;
        foreach _, hl in<vector> header_lines {
            skip_hl: bool = false;
            if hl.size > 9 && hl[0] == 'd' && hl[1] == 'e' && hl[2] == 'c' && hl[3] == 'l' && hl[4] == 'a' && hl[5] == 'r' && hl[6] == 'e' && hl[7] == ' ' && hl[hl.size - 1] == '\n' {
                nl_cnt: int = 0;
                fh_i: int = 0;
                while fh_i < hl.size {
                    if hl[fh_i] == '\n' { nl_cnt = nl_cnt + 1; }
                    fh_i = fh_i + 1;
                }
                if nl_cnt == 1 {
                    at_i: int = -1;
                    hi2: int = 0;
                    while hi2 < hl.size {
                        if hl[hi2] == '@' { at_i = hi2; stop; }
                        hi2 = hi2 + 1;
                    }
                    if at_i >= 0 {
                        nm: string = "";
                        ni: int = at_i + 1;
                        while ni < hl.size {
                            ch2: char = hl[ni];
                            if ch2 == '(' || ch2 == ' ' || ch2 == '\n' { stop; }
                            nm = nm + ch2;
                            ni = ni + 1;
                        }
                        if defined_syms.isin(nm) { skip_hl = true; }
                    }
                }
            }
            if !skip_hl { filtered_hdr.pushb(hl); }
        }
        header_lines = filtered_hdr;

        // Runtime helper: leash_sh_input (the `get()` builtin)
        header_lines.pushb("; Runtime helper: leash_sh_input\n" +
                    "define i8* @leash_sh_input(i8* %prompt) {\n" +
                    "entry:\n" +
                    "  %fmt_s = getelementptr inbounds [3 x i8], [3 x i8]* @.fmt_s, i64 0, i64 0\n" +
                    "  call i32 (i8*, ...) @printf(i8* %fmt_s, i8* %prompt)\n" +
                    "  %buf = call i8* @leash_gc_malloc(i64 4096)\n" +
                    "  store i8 0, i8* %buf\n" +
                    "  %stdin_ptr = call i8* @leash_sh_stdin()\n" +
                    "  call i8* @fgets(i8* %buf, i32 4096, i8* %stdin_ptr)\n" +
                    "  %len = call i64 @strlen(i8* %buf)\n" +
                    "  %has_chars = icmp sgt i64 %len, 0\n" +
                    "  br i1 %has_chars, label %strip, label %done\n" +
                    "strip:\n" +
                    "  %last_idx = sub i64 %len, 1\n" +
                    "  %last_gep = getelementptr inbounds i8, i8* %buf, i64 %last_idx\n" +
                    "  %last = load i8, i8* %last_gep\n" +
                    "  %is_nl = icmp eq i8 %last, 10\n" +
                    "  br i1 %is_nl, label %strip_nl, label %done\n" +
                    "strip_nl:\n" +
                    "  store i8 0, i8* %last_gep\n" +
                    "  br label %done\n" +
                    "done:\n" +
                    "  ret i8* %buf\n" +
                    "}\n\n");

        // Runtime helper functions
        header_lines.pushb("; Runtime helper: leash_str_concat\n" +
                    "define i8* @leash_str_concat(i8* %s1, i8* %s2) {\n" +
                    "entry:\n" +
                    "  %len1 = call i64 @strlen(i8* %s1)\n" +
                    "  %len2 = call i64 @strlen(i8* %s2)\n" +
                    "  %tot = add i64 %len1, %len2\n" +
                    "  %tot1 = add i64 %tot, 1\n" +
                    "  %mem = call i8* @leash_gc_malloc(i64 %tot1)\n" +
                    "  call i8* @strcpy(i8* %mem, i8* %s1)\n" +
                    "  call i8* @strcat(i8* %mem, i8* %s2)\n" +
                    "  ret i8* %mem\n" +
                    "}\n\n");

        header_lines.pushb("; Runtime helper: leash_float_to_str\n" +
                    "define i8* @leash_float_to_str(double %n) {\n" +
                    "entry:\n" +
                    "  %buf = call i8* @leash_gc_malloc(i64 64)\n" +
                    "  %fmt = getelementptr inbounds [3 x i8], [3 x i8]* @.fmt_float, i64 0, i64 0\n" +
                    "  call i32 (i8*, i64, i8*, ...) @snprintf(i8* %buf, i64 64, i8* %fmt, double %n)\n" +
                    "  ret i8* %buf\n" +
                    "}\n\n");

        header_lines.pushb("; Runtime helper: leash_int_to_str\n" +
                    "define i8* @leash_int_to_str(i64 %n) {\n" +
                    "entry:\n" +
                    "  %buf = call i8* @leash_gc_malloc(i64 32)\n" +
                    "  %fmt = getelementptr inbounds [5 x i8], [5 x i8]* @.fmt_d, i64 0, i64 0\n" +
                    "  call i32 (i8*, i64, i8*, ...) @snprintf(i8* %buf, i64 32, i8* %fmt, i64 %n)\n" +
                    "  ret i8* %buf\n" +
                    "}\n\n");

        header_lines.pushb("; Runtime helper: leash_uint_to_str\n" +
                    "define i8* @leash_uint_to_str(i64 %n) {\n" +
                    "entry:\n" +
                    "  %buf = call i8* @leash_gc_malloc(i64 32)\n" +
                    "  %fmt = getelementptr inbounds [5 x i8], [5 x i8]* @.fmt_u, i64 0, i64 0\n" +
                    "  call i32 (i8*, i64, i8*, ...) @snprintf(i8* %buf, i64 32, i8* %fmt, i64 %n)\n" +
                    "  ret i8* %buf\n" +
                    "}\n\n");

        foreach _, body_ln in<vector> this.lines {
            header_lines.pushb(body_ln);
        }

        return header_lines;
    }
}
