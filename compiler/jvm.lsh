        is_class_ref: bool = e.left != null && e.left.kind == ExprKind.IDENT && (this.tc.classes.isin(e.left.sval) || this.tc.structs.isin(e.left.sval));
        if is_static {
            ai: int = 0;
            while ai < e.args.size {
                at: string = this.expr_type(e.args.get(ai));
                this.gen_expr(e.args.get(ai));
                pt: string = this.method_param_at(def_owner, m, ai);
                if !this.coerce_val(at, pt) {
                    this.jvm_coerce(at, pt);
                    this.narrow_to(pt);
