        if m == "replace" || m == "replaceall" {
            this.gen_expr(e.left);
            fs: int = this.cur_method.alloc_local(1);
            this.cur_method.store_local("X", fs);
            a0: string = this.expr_type(e.args.get(0));
            this.gen_expr(e.args.get(0));
            this.jvm_coerce(a0, "string");
            s0: int = this.cur_method.alloc_local(1);
            this.cur_method.store_local("Ljava/lang/String;", s0);
            a1: string = this.expr_type(e.args.get(1));
            this.gen_expr(e.args.get(1));
            this.jvm_coerce(a1, "string");
            s1: int = this.cur_method.alloc_local(1);
            this.cur_method.store_local("Ljava/lang/String;", s1);
            this.cur_method.load_local("X", fs);
            this.cur_method.load_local("Ljava/lang/String;", s0);
            this.cur_method.load_local("Ljava/lang/String;", s1);
            if m == "replaceall" {
                this.iconst(1);
            } else {
                this.iconst(0);
            }
            this.emit_invoke(JOp.INVOKESTATIC, this.main_class, "__file_replace", "(Ljava/io/RandomAccessFile;Ljava/lang/String;Ljava/lang/String;I)I");
            return;
        }
                this.jvm_unsupported("File method '" + m + "' (not supported on jvm)");
    }

    // Entry: [raf] on the stack. Exit: [string] with the full contents
    // (ISO-8859-1, byte-faithful), or "" for a null handle.
    pub fnc file_read_all() : void {
        fs: int = this.cur_method.alloc_local(1);
        this.cur_method.store_local("X", fs);
        nl: string = this.new_label("fra_n");
        el: string = this.new_label("fra_e");
        this.cur_method.load_local("X", fs);
        this.cur_method.branch(JOp.IFNULL, nl, 1);
        // len = (int) f.length()
        this.cur_method.load_local("X", fs);
        this.emit_invoke(JOp.INVOKEVIRTUAL, "java/io/RandomAccessFile", "length", "()J");
        this.cur_method.op(JOp.L2I, -1);
        ls: int = this.cur_method.alloc_local(1);
        this.cur_method.store_local("I", ls);
        // arr = new byte[len]
        this.cur_method.load_local("I", ls);
        this.cur_method.op_1(JOp.NEWARRAY, JArray.T_BYTE, 0);
        as_slot: int = this.cur_method.alloc_local(1);
        this.cur_method.store_local("X", as_slot);
        // f.readFully(arr)
        this.cur_method.load_local("X", fs);
        this.cur_method.load_local("X", as_slot);
        this.emit_invoke(JOp.INVOKEVIRTUAL, "java/io/RandomAccessFile", "readFully", "([B)V");
        // new String(arr, "ISO-8859-1")
        this.cur_method.op(JOp.NEW, 1);
        si: int = this.cur_cp.class_entry("java/lang/String");
        this.cur_method.emit_u8((si >> 8) & 255);
        this.cur_method.emit_u8(si & 255);
        this.cur_method.op(JOp.DUP, 1);
        this.cur_method.load_local("X", as_slot);
        this.ldc_string("ISO-8859-1");
        this.emit_invoke(JOp.INVOKESPECIAL, "java/lang/String", "<init>", "([BLjava/lang/String;)V");
        this.cur_method.branch(JOp.GOTO, el, 0);
        this.cur_method.mark(nl);
        this.ldc_string("");
        this.cur_method.mark(el);
    }

    pub fnc gen_builtin(e Expr) : void {
        f: string = e.sval;
        if f == "typeof" {
            tn: string = "";
            if e.args.size > 0 {
                a0: Expr = e.args.get(0);
                if a0.kind == ExprKind.STRING {
                    tn = a0.sval;
                    if this.var_types.isin(tn) { tn = this.var_types[tn]; }
                } else {
                    tn = this.expr_type(a0);
                }
            }
            this.ldc_string(tn);
            return;
        }
        if f == "sizeof" {
            sz: int = 8;
            if e.args.size > 0 {
                a0: Expr = e.args.get(0);
                st: string = "";
                if a0.kind == ExprKind.STRING { st = a0.sval; }
                else { st = this.expr_type(a0); }
                sz = this.type_size_of(st);
            }
            this.iconst(sz);
            return;
        }
        if f == "cstr" {
            at: string = this.expr_type(e.args.get(0));
            this.gen_expr(e.args.get(0));
            this.jvm_coerce(at, "string");
            this.emit_invoke(JOp.INVOKEVIRTUAL, "java/lang/String", "toCharArray", "()[C");
            return;
        }
        if f == "toint" || f == "tofloat" || f == "tochar" {
            tgt: string = "";
            vidx: int = 0;
            if e.args.size == 2 {
                tgt = this.tc.resolve_type_alias(e.args.get(0).sval);
                vidx = 1;
            } else {
                if f == "toint" { tgt = "int"; }
                also f == "tofloat" { tgt = "float"; }
                else { tgt = "char"; }
            }
            at: string = this.expr_type(e.args.get(vidx));
            this.gen_expr(e.args.get(vidx));
            if at == "string" && this.is_bigint(tgt) {
                this.bigint_parse_checked(tgt);
                return;
            }
            if at == "string" && (f == "toint" || tgt == "int" || tgt == "uint" || this.is_sized_int(tgt)) {
                this.emit_invoke(JOp.INVOKESTATIC, this.main_class, "__parse_long", "(Ljava/lang/String;)J");
                this.jvm_coerce("int<64>", tgt);
                this.narrow_to(tgt);
                return;
            }
            if at == "string" {
                this.emit_invoke(JOp.INVOKESTATIC, this.main_class, "__parse_double", "(Ljava/lang/String;)D");
                this.jvm_coerce("float", tgt);
                this.narrow_to(tgt);
                return;
            }
            this.jvm_coerce(at, tgt);
            this.narrow_to(tgt);
            return;
        }
        if f == "scast" {
            tgt: string = this.tc.resolve_type_alias(e.args.get(0).sval);
            at: string = this.expr_type(e.args.get(1));
            this.gen_expr(e.args.get(1));
            if this.gen_cast_ref(at, tgt) { return; }
            this.jvm_coerce(at, tgt);
            this.narrow_to(tgt);
            return;
        }
        if f == "get" {
            if e.args.size > 0 {
                at: string = this.expr_type(e.args.get(0));
                this.gen_expr(e.args.get(0));
                this.jvm_coerce(at, "string");
            } else {
                this.ldc_string("");
            }
            this.emit_invoke(JOp.INVOKESTATIC, this.main_class, "__stdin_line", "(Ljava/lang/String;)Ljava/lang/String;");
            return;
        }
        if f == "seed" {
            at: string = this.expr_type(e.args.get(0));
            this.gen_expr(e.args.get(0));
            this.jvm_coerce(at, "int<64>");
            this.emit_invoke(JOp.INVOKESTATIC, this.main_class, "__rand_seed", "(J)V");
            return;
        }
        if f == "rand" {
            a0: string = this.expr_type(e.args.get(0));
            this.gen_expr(e.args.get(0));
            this.jvm_coerce(a0, "int<64>");
            a1: string = this.expr_type(e.args.get(1));
            this.gen_expr(e.args.get(1));
            this.jvm_coerce(a1, "int<64>");
            this.emit_invoke(JOp.INVOKESTATIC, this.main_class, "__rand_range", "(JJ)J");
            this.cur_method.op(JOp.L2I, -1);
            return;
        }
        if f == "randf" {
            a0: string = this.expr_type(e.args.get(0));
            this.gen_expr(e.args.get(0));
            this.jvm_coerce(a0, "float");
            a1: string = this.expr_type(e.args.get(1));
            this.gen_expr(e.args.get(1));
            this.jvm_coerce(a1, "float");
            this.emit_invoke(JOp.INVOKESTATIC, this.main_class, "__randf_range", "(DD)D");
            return;
        }
        if f == "choose" {
            this.iconst(e.args.size);
            this.emit_anewarray_object(1);
            arr_slot: int = this.cur_method.alloc_local(1);
            this.cur_method.store_local("X", arr_slot);
            ai: int = 0;
            while ai < e.args.size {
                this.cur_method.load_local("X", arr_slot);
                this.iconst(ai);
                at: string = this.expr_type(e.args.get(ai));
                this.gen_expr(e.args.get(ai));
                this.jvm_coerce(at, "string");
                this.cur_method.op(JOp.AASTORE, -3);
                ai = ai + 1;
            }
            this.cur_method.load_local("X", arr_slot);
            this.emit_invoke(JOp.INVOKESTATIC, this.main_class, "__choose", "([Ljava/lang/Object;)Ljava/lang/String;");
            return;
        }
        if f == "wait" {
            at: string = this.expr_type(e.args.get(0));
            this.gen_expr(e.args.get(0));
            this.jvm_coerce(at, "float");
            this.emit_invoke(JOp.INVOKESTATIC, this.main_class, "__wait_secs", "(D)V");
            return;
        }
        if f == "timepass" {
            this.emit_invoke(JOp.INVOKESTATIC, this.main_class, "__timepass", "()D");
            return;
        }
        if f == "exit" {
            if e.args.size == 1 {
                at: string = this.expr_type(e.args.get(0));
                this.gen_expr(e.args.get(0));
                this.jvm_coerce(at, "int");
            } else {
                this.iconst(0);
            }
            this.emit_showb_flush_call();
            this.emit_invoke(JOp.INVOKESTATIC, "java/lang/System", "exit", "(I)V");
            this.iconst(0);
            return;
        }
        if f == "getenv" {
            if e.args.size != 1 {
                this.jvm_unsupported("getenv() needs 1 argument");
                return;
            }
            at: string = this.expr_type(e.args.get(0));
            this.gen_expr(e.args.get(0));
            this.jvm_coerce(at, "string");
            this.emit_invoke(JOp.INVOKESTATIC, "java/lang/System", "getenv", "(Ljava/lang/String;)Ljava/lang/String;");
            return;
        }
    }

    pub fnc is_sized_int(t string) : bool {
        if t == "int" || t == "uint" || t == "char" || t == "bool" { return true; }
        if t.size > 4 && t[0] == 'i' && t[1] == 'n' && t[2] == 't' && t[3] == '<' { return true; }
        if t.size > 5 && t[0] == 'u' && t[1] == 'i' && t[2] == 'n' && t[3] == 't' && t[4] == '<' { return true; }
        if t == "int64" || t == "uint64" { return true; }
        return false;
    }

    pub fnc type_size_of(t string) : int {
        if this.tc.unions.isin(t) { return 16; }
        if t == "int" { return 4; }
        if t == "char" { return 1; }
        if t == "bool" { return 1; }
        return 8;
    }

    // create Class(): zeroed instance (field defaults do NOT apply,
    // matching the native backend; container fields auto-construct).
    // Call the user constructor with call-site args + declared defaults.
    // Entry: [obj]. Exit: [] (ctor returns void; obj consumed).
    pub fnc gen_ctor_call(cname string, args vec<Expr>) : void {
        // Instance-method params live on ClassInfo (func_params only
        // covers top-level and static registrations).
        ptypes: vec<string> = this.tc.classes[cname].get_method_params(cname);
        ndef: vec<Expr>;
        if this.tc.ctor_defaults.isin(cname) {
            ndef = this.tc.ctor_defaults[cname];
        }
        obj_slot: int = this.cur_method.alloc_local(1);
        this.cur_method.store_local("X", obj_slot);
        // receiver first
        this.cur_method.load_local("X", obj_slot);
        ai: int = 0;
        while ai < ptypes.size {
            if ai < args.size {
                at: string = this.expr_type(args.get(ai));
                this.gen_expr(args.get(ai));
                if !this.coerce_val(at, ptypes.get(ai)) {
                    this.jvm_coerce(at, ptypes.get(ai));
                    this.narrow_to(ptypes.get(ai));
                }
            } also ai < ndef.size && ndef.get(ai) != null {
                dt: string = this.expr_type(ndef.get(ai));
                this.gen_expr(ndef.get(ai));
                if !this.coerce_val(dt, ptypes.get(ai)) {
                    this.jvm_coerce(dt, ptypes.get(ai));
                    this.narrow_to(ptypes.get(ai));
                }
            } else {
                this.jvm_default_for(ptypes.get(ai));
            }
            ai = ai + 1;
        }
        desc: string = "(";
        di: int = 0;
        while di < ptypes.size {
            pd: string = this.jdesc(ptypes.get(di));
            if pd.size == 0 {
                this.jvm_unsupported("ctor parameter type '" + ptypes.get(di) + "'");
                return;
            }
            desc = desc + pd;
            di = di + 1;
        }
        desc = desc + ")V";
        this.emit_invoke(JOp.INVOKEVIRTUAL, cname, cname, desc);
    }

    pub fnc gen_create(e Expr) : void {
        cname: string = this.resolve_class_ref(e.sval);
        if !this.klass_idx.isin(cname) {
            this.jvm_unsupported("create of unknown '" + cname + "'");
            return;
        }
        this.cur_method.op(JOp.NEW, 1);
        ni: int = this.cur_cp.class_entry(cname);
        this.cur_method.emit_u8((ni >> 8) & 255);
        this.cur_method.emit_u8(ni & 255);
        this.cur_method.op(JOp.DUP, 1);
        this.emit_invoke(JOp.INVOKESPECIAL, cname, "<init>", "()V");
        // User-declared constructor (method named == class): run it with
        // the call-site args + declared defaults. DUP first: the ctor call
        // consumes one reference, the other stays for the assignment (the
        // create contract leaves exactly one [obj], as before).
        if this.tc.funcs.isin(cname + "_" + cname) {
            this.cur_method.op(JOp.DUP, 1);
            this.gen_ctor_call(cname, e.args);
        } also e.args.size > 0 {
            this.jvm_unsupported("create with arguments (no declared constructor)");
            return;
        }
    }

    // Struct/class literal: NEW + per-field PUTFIELD (the typechecker
    // rejects missing fields, so every field is assigned).
    pub fnc gen_struct_init(e Expr) : void {
        cname: string = this.resolve_class_ref(e.sval);
        if !this.klass_idx.isin(cname) {
            this.jvm_unsupported("construction of unknown '" + cname + "'");
            return;
        }
        this.cur_method.op(JOp.NEW, 1);
        ni: int = this.cur_cp.class_entry(cname);
        this.cur_method.emit_u8((ni >> 8) & 255);
        this.cur_method.emit_u8(ni & 255);
        this.cur_method.op(JOp.DUP, 1);
        this.emit_invoke(JOp.INVOKESPECIAL, cname, "<init>", "()V");
        ai: int = 0;
        while ai < e.args.size {
            fn: string = "";
            if ai < e.field_names.size { fn = e.field_names.get(ai); }
            ft: string = this.struct_field_type(cname, fn);
            if ft.size == 0 {
                this.jvm_unsupported("field '" + fn + "' of '" + cname + "'");
                return;
            }
            fd: string = this.jdesc(ft);
            this.cur_method.op(JOp.DUP, 1);
            at: string = this.expr_type(e.args.get(ai));
            this.gen_expr(e.args.get(ai));
            if !this.coerce_val(at, ft) {
                this.jvm_coerce(at, ft);
                this.narrow_to(ft);
            }
            fi: int = this.cur_cp.fieldref(cname, fn, fd);
            if fd == "J" || fd == "D" {
                this.cur_method.op_field(JOp.PUTFIELD, fi, -3);
            } else {
                this.cur_method.op_field(JOp.PUTFIELD, fi, -2);
            }
            ai = ai + 1;
        }
    }

    // Field type from the struct/class tables (walks parents).
    // Shallow struct copy (native value semantics: stores, args and
    // returns duplicate the value; nested refs stay shared, as bitwise
    // copy shares them too). Entry: [obj]. Exit: [copy].
    pub fnc gen_struct_copy(cname string) : void {
        cn: string = this.resolve_class_ref(cname);
        src: int = this.cur_method.alloc_local(1);
        this.cur_method.store_local("X", src);
        this.cur_method.op(JOp.NEW, 1);
        ni: int = this.cur_cp.class_entry(cn);
        this.cur_method.emit_u8((ni >> 8) & 255);
        this.cur_method.emit_u8(ni & 255);
        this.cur_method.op(JOp.DUP, 1);
        this.emit_invoke(JOp.INVOKESPECIAL, cn, "<init>", "()V");
        dst: int = this.cur_method.alloc_local(1);
        this.cur_method.store_local("X", dst);
        if this.tc.structs.isin(cn) {
            st: int = 0;
            fns: vec<string> = this.tc.structs[cn].field_names;
            fts: vec<string> = this.tc.structs[cn].field_types;
            while st < fns.size {
                if this.tc.static_fields.isin(cn + "_" + fns.get(st)) {
                    st = st + 1;
                    continue;
                }
                ft: string = fts.get(st);
                fd: string = this.jdesc(ft);
                if fd.size == 0 {
                    this.jvm_unsupported("struct copy field type '" + ft + "'");
                    return;
                }
                this.cur_method.load_local("X", dst);
                this.cur_method.load_local("X", src);
                fi: int = this.cur_cp.fieldref(cn, fns.get(st), fd);
                this.cur_method.op_field(JOp.GETFIELD, fi, this.slots_of(fd) - 1);
                this.cur_method.op_field(JOp.PUTFIELD, fi, 0 - 1 - this.slots_of(fd));
                st = st + 1;
            }
        }
        this.cur_method.load_local("X", dst);
    }

    // Safe borrows (&T) ride as plain references on the JVM, as do
    // pointers to structs/classes (*Node): only true unsafe scalars
    // (*int address arithmetic, *char strings keep their own mapping).
    pub fnc deref_t(t string) : string {
        if t.size > 1 && t[0] == '&' {
            inner: string = "";
            di: int = 1;
            while di < t.size {
                inner = inner + t[di];
                di = di + 1;
            }
            return inner;
        }
        if t.size > 1 && t[0] == '*' {
            pointee: string = "";
            pi: int = 1;
            while pi < t.size {
                pointee = pointee + t[pi];
                pi = pi + 1;
            }
            if this.tc.structs.isin(pointee) || this.tc.classes.isin(pointee) {
                return pointee;
            }
        }
        return t;
    }

    pub fnc struct_field_type(cname string, fn string) : string {
        cname = this.resolve_class_ref(cname);
        // Safe borrows (&T) ride as plain references on the JVM.
        if cname.size > 1 && cname[0] == '&' {
            inner: string = "";
            di: int = 1;
            while di < cname.size {
                inner = inner + cname[di];
                di = di + 1;
            }
            cname = inner;
        }
        if this.tc.structs.isin(cname) {
            return this.tc.structs[cname].get_field_type(fn);
        }
        owner: string = cname;
        g: int = 0;
        while this.tc.classes.isin(owner) && g < 16 {
            ft: string = this.tc.classes[owner].get_field_type(fn);
            if ft.size > 0 { return ft; }
            // Static fields live in a side table.
            if this.tc.static_fields.isin(owner + "_" + fn) {
                return this.tc.static_fields[owner + "_" + fn];
            }
            p: string = this.tc.classes[owner].parent;
            if p.size == 0 { stop; }
            owner = p;
            g = g + 1;
        }
        return "";
    }

    // --- Containers (vec -> ArrayList, hash -> HashMap) ------------------
    // The runtime hash is string-keyed like the native backend: every key
    // normalizes to its native stringification (int %lld, uint %llu,
    // float %.17g, bool "1"/"0", char code point, strings as-is).

    pub fnc hash_val_type(t string) : string {
        if t.size <= 7 { return "int"; }
        depth: int = 0;
        i: int = 5;
        while i < t.size {
            c: char = t[i];
            if c == '<' { depth = depth + 1; }
            also c == '>' { depth = depth - 1; }
            also c == ',' && depth == 0 {
                i = i + 1;
                while i < t.size && t[i] == ' ' { i = i + 1; }
                val_t: string = "";
                while i < t.size - 1 {
                    val_t = val_t + t[i];
                    i = i + 1;
                }
                return val_t;
            }
            i = i + 1;
        }
        return "int";
    }

    pub fnc hash_key_type(t string) : string {
        if t.size <= 7 { return "int"; }
        depth: int = 1;
        i: int = 5;
        key_t: string = "";
        while i < t.size {
            c: char = t[i];
            if c == '<' { depth = depth + 1; }
            also c == '>' { depth = depth - 1; }
            also c == ',' && depth == 1 {
                return key_t;
            }
            key_t = key_t + c;
            i = i + 1;
        }
        return "int";
    }

    // JVM-side method result types (fills the shared oracle's gaps).
    pub fnc mcall_type(obj_t string, m string) : string {
        if obj_t == "string" {
            if m == "replace" { return "string"; }
            if m == "size" { return "int"; }
            return "";
        }
        if this.is_vec_leash(obj_t) {
            inner: string = this.vec_inner_type(obj_t);
            if m == "get" || m == "popb" || m == "popf" { return inner; }
            if m == "size" { return "int"; }
            if m == "isin" { return "bool"; }
            if m == "pushb" || m == "pushf" || m == "set" || m == "remove" || m == "clear" || m == "extend" || m == "insert" { return "void"; }
            return "";
        }
        if this.is_hash_leash(obj_t) {
            vt: string = this.hash_val_type(obj_t);
            if m == "get" { return vt; }
            if m == "keys" { return "vec<string>"; }
            if m == "values" { return "vec<" + vt + ">"; }
            if m == "getKey" { return "string"; }
            if m == "size" { return "int"; }
            if m == "isin" { return "bool"; }
            if m == "push" || m == "delete" { return "void"; }
            return "";
        }
        return "";
    }

    // Box the stack top for container storage. Unsigned 32-bit widens to
    // Long (zero-extended) so display and equality stay unsigned.
    pub fnc box_for(t string) : void {
        d: string = this.jdesc(t);
        if d == "I" {
            if t == "uint" || t == "uint<32>" {
                this.cur_method.op(JOp.I2L, 1);
                this.long_const(0, 0 - 1);
                this.cur_method.op(JOp.LAND, -2);
                this.emit_invoke(JOp.INVOKESTATIC, "java/lang/Long", "valueOf", "(J)Ljava/lang/Long;");
            } also t == "char" {
                this.cur_method.op(JOp.I2C, 0);
                this.emit_invoke(JOp.INVOKESTATIC, "java/lang/Character", "valueOf", "(C)Ljava/lang/Character;");
            } else {
                this.emit_invoke(JOp.INVOKESTATIC, "java/lang/Integer", "valueOf", "(I)Ljava/lang/Integer;");
            }
            return;
        }
        if d == "J" {
            this.emit_invoke(JOp.INVOKESTATIC, "java/lang/Long", "valueOf", "(J)Ljava/lang/Long;");
            return;
        }
        if d == "D" {
            this.emit_invoke(JOp.INVOKESTATIC, "java/lang/Double", "valueOf", "(D)Ljava/lang/Double;");
            return;
        }
        if d == "Z" {
            this.emit_invoke(JOp.INVOKESTATIC, "java/lang/Boolean", "valueOf", "(Z)Ljava/lang/Boolean;");
            return;
        }
        // Strings, lists, maps, arrays, struct refs: already references.
    }

    // Checkcast + unbox the stack top (an Object) to a leash value.
    pub fnc unbox_to(t string) : void {
        d: string = this.jdesc(t);
        if d == "I" {
            if t == "uint" || t == "uint<32>" {
                this.emit_checkcast("java/lang/Long");
                this.emit_invoke(JOp.INVOKEVIRTUAL, "java/lang/Long", "longValue", "()J");
                this.cur_method.op(JOp.L2I, -1);
            } also t == "char" {
                this.emit_checkcast("java/lang/Character");
                this.emit_invoke(JOp.INVOKEVIRTUAL, "java/lang/Character", "charValue", "()C");
            } else {
                this.emit_checkcast("java/lang/Integer");
                this.emit_invoke(JOp.INVOKEVIRTUAL, "java/lang/Integer", "intValue", "()I");
            }
            this.narrow_to(t);
            return;
        }
        if d == "J" {
            this.emit_checkcast("java/lang/Long");
            this.emit_invoke(JOp.INVOKEVIRTUAL, "java/lang/Long", "longValue", "()J");
            return;
        }
        if d == "D" {
            this.emit_checkcast("java/lang/Double");
            this.emit_invoke(JOp.INVOKEVIRTUAL, "java/lang/Double", "doubleValue", "()D");
            return;
        }
        if d == "Z" {
            this.emit_checkcast("java/lang/Boolean");
            this.emit_invoke(JOp.INVOKEVIRTUAL, "java/lang/Boolean", "booleanValue", "()Z");
            return;
        }
        if d == "Ljava/lang/String;" {
            this.emit_checkcast("java/lang/String");
            return;
        }
        if d == "Ljava/util/ArrayList;" {
            this.emit_checkcast("java/util/ArrayList");
            return;
        }
        if d == "Ljava/util/HashMap;" {
            this.emit_checkcast("java/util/HashMap");
            return;
        }
        if d.size > 0 && d[0] == '[' {
            this.emit_checkcast_ref(d);
            return;
        }
        if d.size > 0 && d[0] == 'L' {
            cls: string = "";
            i: int = 1;
            while i < d.size - 1 {
                cls = cls + d[i];
                i = i + 1;
            }
            this.emit_checkcast(cls);
            return;
        }
    }

    pub fnc emit_checkcast(cls string) : void {
        idx: int = this.cur_cp.class_entry(cls);
        this.cur_method.emit_u8(JOp.CHECKCAST);
        this.cur_method.emit_u8((idx >> 8) & 255);
        this.cur_method.emit_u8(idx & 255);
    }

    pub fnc emit_checkcast_ref(desc string) : void {
        inner: string = "";
        i: int = 1;
        while i < desc.size {
            inner = inner + desc[i];
            i = i + 1;
        }
        idx: int = this.cur_cp.class_entry("[" + inner);
        this.cur_method.emit_u8(JOp.CHECKCAST);
        this.cur_method.emit_u8((idx >> 8) & 255);
        this.cur_method.emit_u8(idx & 255);
    }

    // Normalize the stack top to a hash-key String (native parity:
    // float %.17g with Locale.ROOT, bool "1"/"0", char code point).
    pub fnc gen_hashkey(kt string) : void {
        kd: string = this.jdesc(kt);
        if kd == "Ljava/lang/String;" { return; }
        if kd == "I" {
            if this.is_uint_leash(kt) {
                this.emit_invoke(JOp.INVOKESTATIC, "java/lang/Integer", "toUnsignedString", "(I)Ljava/lang/String;");
            } else {
                this.emit_invoke(JOp.INVOKESTATIC, "java/lang/Integer", "toString", "(I)Ljava/lang/String;");
            }
            return;
        }
        if kd == "J" {
            if this.is_uint_leash(kt) {
                this.emit_invoke(JOp.INVOKESTATIC, "java/lang/Long", "toUnsignedString", "(J)Ljava/lang/String;");
            } else {
                this.emit_invoke(JOp.INVOKESTATIC, "java/lang/Long", "toString", "(J)Ljava/lang/String;");
            }
            return;
        }
        if kd == "D" {
            this.box_top("D");
            tslot: int = this.cur_method.temp_slot("Ljava/lang/Object;");
            this.cur_method.store_local("Ljava/lang/Object;", tslot);
            this.emit_locale_root();
            this.ldc_string("%.17g");
            this.iconst(1);
            this.emit_anewarray_object(1);
            this.cur_method.op(JOp.DUP, 1);
            this.iconst(0);
            this.cur_method.load_local("Ljava/lang/Object;", tslot);
            this.cur_method.op(JOp.AASTORE, -3);
            this.emit_invoke(JOp.INVOKESTATIC, "java/lang/String", "format", "(Ljava/util/Locale;Ljava/lang/String;[Ljava/lang/Object;)Ljava/lang/String;");
            return;
        }
        if kd == "Z" {
            f_lbl: string = this.new_label("hk_f");
            e_lbl: string = this.new_label("hk_e");
            this.cur_method.branch(JOp.IFEQ, f_lbl, 1);
            this.ldc_string("1");
            this.cur_method.branch(JOp.GOTO, e_lbl, 0);
            this.cur_method.mark(f_lbl);
            this.ldc_string("0");
            this.cur_method.mark(e_lbl);
            return;
        }
        this.jvm_unsupported("hash key of type '" + kt + "'");
    }

    // Abort with a message on stdout + exit(1) (reference parity).
    // The stack must be empty on entry.
    pub fnc emit_abort(msg string) : void {
        this.emit_showb_flush_call();
        this.emit_getstatic_out();
        this.ldc_string(msg);
        this.emit_invoke(JOp.INVOKEVIRTUAL, "java/io/PrintStream", "print", "(Ljava/lang/String;)V");
        this.iconst(1);
        this.emit_invoke(JOp.INVOKESTATIC, "java/lang/System", "exit", "(I)V");
    }

    // --- Member / index / method calls --------------------------------

    pub fnc gen_member(e Expr) : void {
        // ClassName.field: static field access.
        if e.left != null && e.left.kind == ExprKind.IDENT {
            ln: string = e.left.sval;
            if (this.tc.classes.isin(ln) || this.tc.structs.isin(ln)) && this.tc.static_fields.isin(ln + "_" + e.sval) {
                ft: string = this.tc.static_fields[ln + "_" + e.sval];
                fd: string = this.jdesc(ft);
                if fd.size == 0 {
                    this.jvm_unsupported("static field type '" + ft + "'");
                    return;
                }
                idx: int = this.cur_cp.fieldref(ln, e.sval, fd);
                this.cur_method.op_field(JOp.GETSTATIC, idx, this.slots_of(fd));
                return;
            }
        }
        // this.static_member: `this` in a STATIC method resolves to the
        // class for static access (native parity) — obj_t would be "int".
        if e.left != null && e.left.kind == ExprKind.IDENT && e.left.sval == "this"
           && this.current_class.size > 0 && this.tc.static_fields.isin(this.current_class + "_" + e.sval) {
            ft0: string = this.tc.static_fields[this.current_class + "_" + e.sval];
            fd0: string = this.jdesc(ft0);
            if fd0.size == 0 {
                this.jvm_unsupported("static field type '" + ft0 + "'");
                return;
            }
            idx0: int = this.cur_cp.fieldref(this.current_class, e.sval, fd0);
            this.cur_method.op_field(JOp.GETSTATIC, idx0, this.slots_of(fd0));
            return;
        }
        obj_t: string = this.deref_t(this.expr_type(e.left));
        if e.sval == "size" {
            if obj_t == "string" {
                this.gen_expr(e.left);
                this.emit_invoke(JOp.INVOKEVIRTUAL, "java/lang/String", "length", "()I");
                return;
            }
            if this.is_vec_leash(obj_t) {
                this.gen_expr(e.left);
                this.emit_invoke(JOp.INVOKEVIRTUAL, "java/util/ArrayList", "size", "()I");
                return;
            }
            if this.is_hash_leash(obj_t) {
                this.gen_expr(e.left);
                this.emit_invoke(JOp.INVOKEVIRTUAL, "java/util/HashMap", "size", "()I");
                return;
            }
            if obj_t == "File" && e.sval == "size" {
                this.gen_expr(e.left);
                fs: int = this.cur_method.alloc_local(1);
                this.cur_method.store_local("X", fs);
                nl: string = this.new_label("fm_n");
                el: string = this.new_label("fm_e");
                this.cur_method.load_local("X", fs);
                this.cur_method.branch(JOp.IFNULL, nl, 1);
                this.cur_method.load_local("X", fs);
                this.emit_invoke(JOp.INVOKEVIRTUAL, "java/io/RandomAccessFile", "length", "()J");
                this.cur_method.op(JOp.L2I, -1);
                this.cur_method.branch(JOp.GOTO, el, 0);
                this.cur_method.mark(nl);
                this.iconst(0);
                this.cur_method.mark(el);
                return;
            }
            od: string = this.jdesc(obj_t);
            if od.size > 0 && od[0] == '[' {
                this.gen_expr(e.left);
                this.cur_method.op(JOp.ARRAYLENGTH, 0);
                return;
            }
        }
        if this.tc.unions.isin(obj_t) {
            if e.sval == "cur" {
                this.gen_expr(e.left);
                this.gen_union_tostring(obj_t);
                return;
            }
            if this.union_variant_idx(obj_t, e.sval) < 0 {
                this.jvm_unsupported("member '." + e.sval + "' of '" + obj_t + "'");
                return;
            }
            this.gen_expr(e.left);
            this.gen_union_read_checked(obj_t, e.sval);
            return;
        }
        if this.tc.structs.isin(obj_t) || this.tc.classes.isin(obj_t) {
            // this.x where x is a static: static access (native parity).
            if e.left != null && e.left.kind == ExprKind.IDENT && e.left.sval == "this" && this.current_class.size > 0 && this.tc.static_fields.isin(this.current_class + "_" + e.sval) {
                ft: string = this.tc.static_fields[this.current_class + "_" + e.sval];
                fd: string = this.jdesc(ft);
                if fd.size == 0 {
                    this.jvm_unsupported("static field type '" + ft + "'");
                    return;
                }
                idx: int = this.cur_cp.fieldref(this.current_class, e.sval, fd);
                this.cur_method.op_field(JOp.GETSTATIC, idx, this.slots_of(fd));
                return;
            }
            ft: string = this.struct_field_type(obj_t, e.sval);
            if ft.size == 0 {
                this.jvm_unsupported("field '" + e.sval + "' of '" + obj_t + "'");
                return;
            }
            fd: string = this.jdesc(ft);
            if fd.size == 0 {
                this.jvm_unsupported("field type '" + ft + "'");
                return;
            }
            this.gen_expr(e.left);
            idx: int = this.cur_cp.fieldref(obj_t, e.sval, fd);
            this.cur_method.op_field(JOp.GETFIELD, idx, this.slots_of(fd) - 1);
            return;
        }
        if this.tc.enums.isin(obj_t) {
            if e.sval == "name" {
                // Variant name lookup (native indexes a names array).
                this.gen_expr(e.left);
                val_slot: int = this.cur_method.alloc_local(1);
                this.cur_method.store_local("I", val_slot);
                idx: int = this.cur_cp.fieldref(this.main_class, "enum_" + obj_t + "_names", "[Ljava/lang/String;");
                this.cur_method.op_field(JOp.GETSTATIC, idx, 1);
                this.cur_method.load_local("I", val_slot);
                this.cur_method.op(JOp.AALOAD, -1);
                return;
            }
            this.jvm_unsupported("enum member '." + e.sval + "'");
            return;
        }
        this.jvm_unsupported("member '." + e.sval + "' of '" + obj_t + "'");
    }

    // Checked vec index in idx_slot (int) against the list in list_slot:
    // negative wraps, out-of-range aborts with msg. Stack is empty.
    pub fnc gen_vec_bounds(list_slot int, idx_slot int, msg string) : void {
        wrap_lbl: string = this.new_label("vx_wrap");
        ok_lbl: string = this.new_label("vx_ok");
        fail_lbl: string = this.new_label("vx_fail");
        this.cur_method.load_local("I", idx_slot);
        this.cur_method.branch(JOp.IFGE, wrap_lbl, 1);
        this.cur_method.load_local("I", idx_slot);
        this.cur_method.load_local("Ljava/util/ArrayList;", list_slot);
        this.emit_invoke(JOp.INVOKEVIRTUAL, "java/util/ArrayList", "size", "()I");
        this.cur_method.op(JOp.IADD, -1);
        this.cur_method.store_local("I", idx_slot);
        this.cur_method.mark(wrap_lbl);
        this.cur_method.load_local("I", idx_slot);
        this.cur_method.branch(JOp.IFLT, fail_lbl, 1);
        this.cur_method.load_local("I", idx_slot);
        this.cur_method.load_local("Ljava/util/ArrayList;", list_slot);
        this.emit_invoke(JOp.INVOKEVIRTUAL, "java/util/ArrayList", "size", "()I");
        this.cur_method.branch(JOp.IF_ICMPGE, fail_lbl, 2);
        this.cur_method.branch(JOp.GOTO, ok_lbl, 0);
        this.cur_method.mark(fail_lbl);
        this.emit_abort(msg);
        this.cur_method.branch(JOp.GOTO, ok_lbl, 0);
        this.cur_method.mark(ok_lbl);
    }

    pub fnc array_load_op(base string) : int {
        // char arrays are [C: CALOAD (jdesc collapses char -> I, but
        // String.toCharArray and NEWARRAY T_CHAR both produce [C).
        if base == "char" { return JOp.CALOAD; }
        bd: string = this.jdesc(base);
        if bd == "J" { return JOp.LALOAD; }
        if bd == "D" { return JOp.DALOAD; }
        if bd == "Z" { return JOp.BALOAD; }
        if bd == "S" { return JOp.SALOAD; }
        if bd == "B" { return JOp.BALOAD; }
        if bd == "I" { return JOp.IALOAD; }
        return JOp.AALOAD;
    }

    pub fnc array_store_op(base string) : int {
        if base == "char" { return JOp.CASTORE; }
        bd: string = this.jdesc(base);
        if bd == "J" { return JOp.LASTORE; }
        if bd == "D" { return JOp.DASTORE; }
        if bd == "Z" { return JOp.BASTORE; }
        if bd == "S" { return JOp.SASTORE; }
        if bd == "B" { return JOp.BASTORE; }
        if bd == "I" { return JOp.IASTORE; }
        return JOp.AASTORE;
    }

    pub fnc gen_index(e Expr) : void {
        coll_t: string = this.expr_type(e.left);
        if coll_t == "string" {
            this.gen_expr(e.left);
            it: string = this.expr_type(e.right);
            this.gen_expr(e.right);
            this.jvm_coerce(it, "int");
            this.emit_invoke(JOp.INVOKEVIRTUAL, "java/lang/String", "charAt", "(I)C");
            return;
        }
        if this.is_vec_leash(coll_t) {
            inner: string = this.vec_inner_type(coll_t);
            this.gen_expr(e.left);
            list_slot: int = this.cur_method.alloc_local(1);
            this.cur_method.store_local("Ljava/util/ArrayList;", list_slot);
            it: string = this.expr_type(e.right);
            this.gen_expr(e.right);
            this.jvm_coerce(it, "int");
            idx_slot: int = this.cur_method.alloc_local(1);
            this.cur_method.store_local("I", idx_slot);
            this.gen_vec_bounds(list_slot, idx_slot, "Runtime error: Vector index out of bounds.\n");
            this.cur_method.load_local("Ljava/util/ArrayList;", list_slot);
            this.cur_method.load_local("I", idx_slot);
            this.emit_invoke(JOp.INVOKEVIRTUAL, "java/util/ArrayList", "get", "(I)Ljava/lang/Object;");
            this.unbox_to(inner);
            return;
        }
        if this.is_hash_leash(coll_t) {
            vt: string = this.hash_val_type(coll_t);
            kt: string = this.hash_key_type(coll_t);
            this.gen_expr(e.left);
            map_slot: int = this.cur_method.alloc_local(1);
            this.cur_method.store_local("Ljava/util/HashMap;", map_slot);
            it: string = this.expr_type(e.right);
            this.gen_expr(e.right);
            this.jvm_coerce(it, kt);
            this.gen_hashkey(kt);
            // Stack is [key]; spill it, then push [map, key] for get.
            key_slot: int = this.cur_method.alloc_local(1);
            this.cur_method.store_local("Ljava/lang/String;", key_slot);
            this.cur_method.load_local("Ljava/util/HashMap;", map_slot);
            this.cur_method.load_local("Ljava/lang/String;", key_slot);
            this.emit_invoke(JOp.INVOKEVIRTUAL, "java/util/HashMap", "get", "(Ljava/lang/Object;)Ljava/lang/Object;");
            this.gen_unbox_or_default(vt);
            return;
        }
        od: string = this.jdesc(coll_t);
        if od.size > 0 && od[0] == '[' {
            base: string = "";
            bi: int = 0;
            while bi < coll_t.size && coll_t[bi] != '[' {
                base = base + coll_t[bi];
                bi = bi + 1;
            }
            this.gen_expr(e.left);
            it: string = this.expr_type(e.right);
            this.gen_expr(e.right);
            this.jvm_coerce(it, "int");
            lop: int = this.array_load_op(base);
            if this.jdesc(base) == "J" || this.jdesc(base) == "D" {
                this.cur_method.op(lop, 0);
            } else {
                this.cur_method.op(lop, -1);
            }
            this.narrow_to(base);
            return;
        }
        this.jvm_unsupported("indexing '" + coll_t + "'");
    }

    pub fnc gen_method_call(e Expr) : void {
        // Static File builtins: File.open/rename/delete (the receiver is
        // the bare type name, which does not resolve as an expression).
        if e.left != null && e.left.kind == ExprKind.IDENT && e.left.sval == "File" {
            this.gen_file_static(e);
            return;
        }
        obj_t: string = this.deref_t(this.expr_type(e.left));
        if obj_t == "string" {
            if e.sval == "size" {
                if e.args.size != 0 {
                    this.jvm_unsupported("string.size() takes no arguments");
                    return;
                }
                this.gen_expr(e.left);
                this.emit_invoke(JOp.INVOKEVIRTUAL, "java/lang/String", "length", "()I");
                return;
            }
            if e.sval == "replace" {
                if e.args.size != 2 {
                    this.jvm_unsupported("string.replace() needs 2 arguments");
                    return;
                }
                this.gen_expr(e.left);
                at0: string = this.expr_type(e.args.get(0));
                this.gen_expr(e.args.get(0));
                this.jvm_coerce(at0, "string");
                at1: string = this.expr_type(e.args.get(1));
                this.gen_expr(e.args.get(1));
                this.jvm_coerce(at1, "string");
                // Literal first-and-all? Native replaces ALL occurrences.
                this.emit_invoke(JOp.INVOKEVIRTUAL, "java/lang/String", "replace", "(Ljava/lang/CharSequence;Ljava/lang/CharSequence;)Ljava/lang/String;");
                return;
            }
            this.jvm_unsupported("string method '" + e.sval + "'");
            return;
        }
        if this.is_vec_leash(obj_t) {
            this.gen_vec_method(e, obj_t);
            return;
        }
        if this.is_hash_leash(obj_t) {
            this.gen_hash_method(e, obj_t);
            return;
        }
        if this.tc.classes.isin(obj_t) {
            this.gen_class_method(e, obj_t);
            return;
        }
        if this.tc.structs.isin(obj_t) {
            this.jvm_unsupported("struct methods (structs are data-only)");
            return;
        }
        if obj_t == "File" {
            this.gen_file_method(e);
            return;
        }
        this.jvm_unsupported("method '" + e.sval + "' of '" + obj_t + "'");
    }

    pub fnc gen_vec_method(e Expr, obj_t string) : void {
        inner: string = this.vec_inner_type(obj_t);
        m: string = e.sval;
        if m == "pushb" {
            if e.args.size != 1 {
                this.jvm_unsupported("pushb() needs 1 argument");
                return;
            }
            this.gen_expr(e.left);
            at: string = this.expr_type(e.args.get(0));
            this.gen_expr(e.args.get(0));
            this.jvm_coerce(at, inner);
            this.narrow_to(inner);
            this.box_for(inner);
            this.emit_invoke(JOp.INVOKEVIRTUAL, "java/util/ArrayList", "add", "(Ljava/lang/Object;)Z");
            this.cur_method.op(JOp.POP, -1);
            return;
        }
        if m == "pushf" {
            if e.args.size != 1 {
                this.jvm_unsupported("pushf() needs 1 argument");
                return;
            }
            this.gen_expr(e.left);
            this.iconst(0);
            at: string = this.expr_type(e.args.get(0));
            this.gen_expr(e.args.get(0));
            this.jvm_coerce(at, inner);
            this.narrow_to(inner);
            this.box_for(inner);
            this.emit_invoke(JOp.INVOKEVIRTUAL, "java/util/ArrayList", "add", "(ILjava/lang/Object;)V");
            return;
        }
        if m == "popb" {
            this.gen_vec_pop(e, obj_t, inner, false, "Runtime error: popb called on empty vector.\n");
            return;
        }
        if m == "popf" {
            this.gen_vec_pop(e, obj_t, inner, true, "Runtime error: popf called on empty vector.\n");
            return;
        }
        if m == "get" {
            if e.args.size != 1 {
                this.jvm_unsupported("get() needs 1 argument");
                return;
            }
            this.gen_expr(e.left);
            list_slot: int = this.cur_method.alloc_local(1);
            this.cur_method.store_local("Ljava/util/ArrayList;", list_slot);
            it: string = this.expr_type(e.args.get(0));
            this.gen_expr(e.args.get(0));
            this.jvm_coerce(it, "int");
            idx_slot: int = this.cur_method.alloc_local(1);
            this.cur_method.store_local("I", idx_slot);
            this.gen_vec_bounds(list_slot, idx_slot, "Runtime error: Vector index out of bounds in get().\n");
            this.cur_method.load_local("Ljava/util/ArrayList;", list_slot);
            this.cur_method.load_local("I", idx_slot);
            this.emit_invoke(JOp.INVOKEVIRTUAL, "java/util/ArrayList", "get", "(I)Ljava/lang/Object;");
            this.unbox_to(inner);
            return;
        }
        if m == "set" {
            if e.args.size != 2 {
                this.jvm_unsupported("set() needs 2 arguments");
                return;
            }
            this.gen_vec_set(e, obj_t, inner, "Runtime error: Vector index out of bounds in set().\n");
            return;
