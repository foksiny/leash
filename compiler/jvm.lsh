            base: string = "";
            bi: int = 0;
            while bi < st.size && st[bi] != '[' {
                base = base + st[bi];
                bi = bi + 1;
            }
            lop: int = this.array_load_op(base);
            if base == "J" || base == "D" {
                this.cur_method.op(lop, 0);
