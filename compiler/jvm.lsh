// ---------------------------------------------------------------------------
// JVM bytecode backend ( --target jvm ).
//
// Emits Java 6 (major version 50) class files directly: the pre-split-
// verifier type inference needs no StackMapTable frames, so branches
// assemble with plain labels. Only `java` is required at run time.
//
// Layout per program: one top-level class per Leash struct/class plus a
// main class holding functions (static methods), globals (static
// fields), and the `main(String[])` entry.
// ---------------------------------------------------------------------------

use ast::*;
use typechecker::*;
use codegen::*;

// JVM opcode numbers (only the subset the backend emits).
pub def JOp : class {
    static pub ACONST_NULL: int = 1;
    static pub ICONST_M1: int = 2;
    static pub ICONST_0: int = 3;
    static pub ICONST_1: int = 4;
    static pub ICONST_2: int = 5;
    static pub ICONST_3: int = 6;
    static pub ICONST_4: int = 7;
    static pub ICONST_5: int = 8;
    static pub LCONST_0: int = 9;
    static pub LCONST_1: int = 10;
    static pub DCONST_0: int = 14;
    static pub DCONST_1: int = 15;
    static pub BIPUSH: int = 16;
    static pub SIPUSH: int = 17;
    static pub LDC: int = 18;
    static pub LDC_W: int = 19;
    static pub LDC2_W: int = 20;
    static pub ILOAD: int = 21;
    static pub LLOAD: int = 22;
    static pub DLOAD: int = 24;
    static pub ALOAD: int = 25;
    static pub ILOAD_0: int = 26;
    static pub ILOAD_1: int = 27;
    static pub ILOAD_2: int = 28;
    static pub ILOAD_3: int = 29;
    static pub LLOAD_0: int = 30;
    static pub LLOAD_1: int = 31;
    static pub LLOAD_2: int = 32;
    static pub LLOAD_3: int = 33;
    static pub DLOAD_0: int = 38;
    static pub DLOAD_1: int = 39;
    static pub DLOAD_2: int = 40;
    static pub DLOAD_3: int = 41;
    static pub ALOAD_0: int = 42;
    static pub ALOAD_1: int = 43;
    static pub ALOAD_2: int = 44;
    static pub ALOAD_3: int = 45;
    static pub IALOAD: int = 46;
    static pub LALOAD: int = 47;
    static pub DALOAD: int = 49;
    static pub AALOAD: int = 50;
    static pub BALOAD: int = 51;
    static pub CALOAD: int = 52;
    static pub SALOAD: int = 53;
    static pub ISTORE: int = 54;
    static pub LSTORE: int = 55;
    static pub DSTORE: int = 57;
    static pub ASTORE: int = 58;
    static pub ISTORE_0: int = 59;
    static pub ISTORE_1: int = 60;
    static pub ISTORE_2: int = 61;
    static pub ISTORE_3: int = 62;
    static pub LSTORE_0: int = 63;
    static pub LSTORE_1: int = 64;
    static pub LSTORE_2: int = 65;
    static pub LSTORE_3: int = 66;
    static pub DSTORE_0: int = 71;
    static pub DSTORE_1: int = 72;
    static pub DSTORE_2: int = 73;
    static pub DSTORE_3: int = 74;
    static pub ASTORE_0: int = 75;
    static pub ASTORE_1: int = 76;
    static pub ASTORE_2: int = 77;
    static pub ASTORE_3: int = 78;
    static pub IASTORE: int = 79;
    static pub LASTORE: int = 80;
    static pub DASTORE: int = 82;
    static pub AASTORE: int = 83;
    static pub BASTORE: int = 84;
    static pub CASTORE: int = 85;
    static pub SASTORE: int = 86;
    static pub POP: int = 87;
    static pub POP2: int = 88;
    static pub DUP: int = 89;
    static pub DUP_X1: int = 90;
    static pub DUP2: int = 92;
    static pub SWAP: int = 95;
    static pub IADD: int = 96;
    static pub LADD: int = 97;
    static pub DADD: int = 99;
    static pub ISUB: int = 100;
    static pub LSUB: int = 101;
    static pub DSUB: int = 103;
    static pub IMUL: int = 104;
    static pub LMUL: int = 105;
    static pub DMUL: int = 107;
    static pub IDIV: int = 108;
    static pub LDIV: int = 109;
    static pub DDIV: int = 111;
    static pub IREM: int = 112;
    static pub LREM: int = 113;
    static pub DREM: int = 115;
    static pub INEG: int = 116;
    static pub LNEG: int = 117;
