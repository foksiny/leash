                return;
            }
            this.jvm_unsupported("enum member '." + e.sval + "'");
            return;
        }
        this.jvm_unsupported("member '." + e.sval + "' of '" + obj_t + "'");
    }

    // Checked vec index in idx_slot (int) against the list in list_slot:
    // negative wraps, out-of-range aborts with msg. Stack is empty.
    pub fnc gen_vec_bounds(list_slot int, idx_slot int, msg string) : void {
        wrap_lbl: string = this.new_label("vx_wrap");
        ok_lbl: string = this.new_label("vx_ok");
        fail_lbl: string = this.new_label("vx_fail");
        this.cur_method.load_local("I", idx_slot);
        this.cur_method.branch(JOp.IFGE, wrap_lbl, 1);
        this.cur_method.load_local("I", idx_slot);
        this.cur_method.load_local("Ljava/util/ArrayList;", list_slot);
        this.emit_invoke(JOp.INVOKEVIRTUAL, "java/util/ArrayList", "size", "()I");
        this.cur_method.op(JOp.IADD, -1);
        this.cur_method.store_local("I", idx_slot);
        this.cur_method.mark(wrap_lbl);
        this.cur_method.load_local("I", idx_slot);
        this.cur_method.branch(JOp.IFLT, fail_lbl, 1);
        this.cur_method.load_local("I", idx_slot);
        this.cur_method.load_local("Ljava/util/ArrayList;", list_slot);
        this.emit_invoke(JOp.INVOKEVIRTUAL, "java/util/ArrayList", "size", "()I");
        this.cur_method.branch(JOp.IF_ICMPGE, fail_lbl, 2);
        this.cur_method.branch(JOp.GOTO, ok_lbl, 0);
        this.cur_method.mark(fail_lbl);
        this.emit_abort(msg);
        this.cur_method.branch(JOp.GOTO, ok_lbl, 0);
        this.cur_method.mark(ok_lbl);
    }

    pub fnc array_load_op(base string) : int {
        // char arrays are [C: CALOAD (jdesc collapses char -> I, but
        // String.toCharArray and NEWARRAY T_CHAR both produce [C).
        if base == "char" { return JOp.CALOAD; }
        bd: string = this.jdesc(base);
        if bd == "J" { return JOp.LALOAD; }
        if bd == "D" { return JOp.DALOAD; }
        if bd == "Z" { return JOp.BALOAD; }
        if bd == "S" { return JOp.SALOAD; }
        if bd == "B" { return JOp.BALOAD; }
        if bd == "I" { return JOp.IALOAD; }
        return JOp.AALOAD;
    }

    pub fnc array_store_op(base string) : int {
        if base == "char" { return JOp.CASTORE; }
        bd: string = this.jdesc(base);
        if bd == "J" { return JOp.LASTORE; }
        if bd == "D" { return JOp.DASTORE; }
        if bd == "Z" { return JOp.BASTORE; }
        if bd == "S" { return JOp.SASTORE; }
        if bd == "B" { return JOp.BASTORE; }
        if bd == "I" { return JOp.IASTORE; }
        return JOp.AASTORE;
    }

    pub fnc gen_index(e Expr) : void {
        coll_t: string = this.expr_type(e.left);
        if coll_t == "string" {
            this.gen_expr(e.left);
            it: string = this.expr_type(e.right);
            this.gen_expr(e.right);
            this.jvm_coerce(it, "int");
            this.emit_invoke(JOp.INVOKEVIRTUAL, "java/lang/String", "charAt", "(I)C");
            return;
        }
        if this.is_vec_leash(coll_t) {
            inner: string = this.vec_inner_type(coll_t);
            this.gen_expr(e.left);
            list_slot: int = this.cur_method.alloc_local(1);
            this.cur_method.store_local("Ljava/util/ArrayList;", list_slot);
            it: string = this.expr_type(e.right);
            this.gen_expr(e.right);
            this.jvm_coerce(it, "int");
            idx_slot: int = this.cur_method.alloc_local(1);
            this.cur_method.store_local("I", idx_slot);
            this.gen_vec_bounds(list_slot, idx_slot, "Runtime error: Vector index out of bounds.\n");
            this.cur_method.load_local("Ljava/util/ArrayList;", list_slot);
            this.cur_method.load_local("I", idx_slot);
            this.emit_invoke(JOp.INVOKEVIRTUAL, "java/util/ArrayList", "get", "(I)Ljava/lang/Object;");
            this.unbox_to(inner);
            return;
        }
        if this.is_hash_leash(coll_t) {
            vt: string = this.hash_val_type(coll_t);
            kt: string = this.hash_key_type(coll_t);
            this.gen_expr(e.left);
            map_slot: int = this.cur_method.alloc_local(1);
            this.cur_method.store_local("Ljava/util/HashMap;", map_slot);
            it: string = this.expr_type(e.right);
            this.gen_expr(e.right);
            this.jvm_coerce(it, kt);
            this.gen_hashkey(kt);
            // Stack is [key]; spill it, then push [map, key] for get.
            key_slot: int = this.cur_method.alloc_local(1);
            this.cur_method.store_local("Ljava/lang/String;", key_slot);
            this.cur_method.load_local("Ljava/util/HashMap;", map_slot);
            this.cur_method.load_local("Ljava/lang/String;", key_slot);
            this.emit_invoke(JOp.INVOKEVIRTUAL, "java/util/HashMap", "get", "(Ljava/lang/Object;)Ljava/lang/Object;");
            this.gen_unbox_or_default(vt);
            return;
        }
        od: string = this.jdesc(coll_t);
        if od.size > 0 && od[0] == '[' {
            base: string = "";
            bi: int = 0;
            while bi < coll_t.size && coll_t[bi] != '[' {
                base = base + coll_t[bi];
                bi = bi + 1;
            }
            this.gen_expr(e.left);
            it: string = this.expr_type(e.right);
            this.gen_expr(e.right);
            this.jvm_coerce(it, "int");
            lop: int = this.array_load_op(base);
            if base == "J" || base == "D" {
                this.cur_method.op(lop, 0);
            } else {
                this.cur_method.op(lop, -1);
            }
            this.narrow_to(base);
            return;
        }
        this.jvm_unsupported("indexing '" + coll_t + "'");
    }

    pub fnc gen_method_call(e Expr) : void {
        // Static File builtins: File.open/rename/delete (the receiver is
        // the bare type name, which does not resolve as an expression).
        obj_t: string = this.expr_type(e.left);
        if obj_t == "string" {
            if e.sval == "size" {
                if e.args.size != 0 {
                    this.jvm_unsupported("string.size() takes no arguments");
                    return;
                }
                this.gen_expr(e.left);
                this.emit_invoke(JOp.INVOKEVIRTUAL, "java/lang/String", "length", "()I");
                return;
            }
            if e.sval == "replace" {
                if e.args.size != 2 {
                    this.jvm_unsupported("string.replace() needs 2 arguments");
                    return;
                }
                this.gen_expr(e.left);
                at0: string = this.expr_type(e.args.get(0));
                this.gen_expr(e.args.get(0));
                this.jvm_coerce(at0, "string");
                at1: string = this.expr_type(e.args.get(1));
                this.gen_expr(e.args.get(1));
                this.jvm_coerce(at1, "string");
                // Literal first-and-all? Native replaces ALL occurrences.
                this.emit_invoke(JOp.INVOKEVIRTUAL, "java/lang/String", "replace", "(Ljava/lang/CharSequence;Ljava/lang/CharSequence;)Ljava/lang/String;");
                return;
            }
            this.jvm_unsupported("string method '" + e.sval + "'");
            return;
        }
        if this.is_vec_leash(obj_t) {
            this.gen_vec_method(e, obj_t);
            return;
        }
        if this.is_hash_leash(obj_t) {
            this.gen_hash_method(e, obj_t);
            return;
        }
        if this.tc.classes.isin(obj_t) {
            this.gen_class_method(e, obj_t);
            return;
        }
        if this.tc.structs.isin(obj_t) {
            this.jvm_unsupported("struct methods (structs are data-only)");
            return;
        }
        if obj_t == "File" {
            this.jvm_unsupported("File I/O (wiring in progress)");
            return;
        }
        this.jvm_unsupported("method '" + e.sval + "' of '" + obj_t + "'");
    }

