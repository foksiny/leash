}

// newarray element codes.
pub def JArray : class {
    static pub T_BOOLEAN: int = 4;
    static pub T_CHAR: int = 5;
    static pub T_BYTE: int = 8;
    static pub T_SHORT: int = 9;
    static pub T_INT: int = 10;
    static pub T_LONG: int = 11;
    static pub T_DOUBLE: int = 7;
}

// Access flags.
pub def JAcc : class {
    static pub PUBLIC: int = 1;
    static pub PRIVATE: int = 2;
    static pub STATIC: int = 8;
    static pub FINAL: int = 16;
    static pub SUPER: int = 32;
}

// Constant-pool tags.
pub def JCp : class {
    static pub UTF8: int = 1;
    static pub INT: int = 3;
    static pub FLOAT: int = 4;
    static pub LONG: int = 5;
    static pub DOUBLE: int = 6;
    static pub CLASS: int = 7;
    static pub STRING: int = 8;
    static pub FIELDREF: int = 9;
    static pub METHODREF: int = 10;
    static pub NAMEANDTYPE: int = 12;
}

// A constant pool under construction: deduplicated entries, 1-based
// indices (long/double occupy two slots, like real class files).
pub def JvmCp : class {
    pub keys: hash<string, int>;
    pub tags: vec<int>;
    pub payloads: vec<vec<int>>;
    pub next_idx: int;

    static pub fnc make() : JvmCp {
        empty_keys: hash<string, int>;
        empty_tags: vec<int>;
        empty_payloads: vec<vec<int>>;
        return JvmCp { keys: empty_keys, tags: empty_tags, payloads: empty_payloads, next_idx: 1 };
    }

    pub fnc alloc(tag int, key string, payload vec<int>, slots int) : int {
        if this.keys.isin(key) { return this.keys[key]; }
        idx: int = this.next_idx;
        this.keys.push(key, idx);
        this.tags.pushb(tag);
        this.payloads.pushb(payload);
        this.next_idx = this.next_idx + slots;
        return idx;
    }

    // Modified UTF-8 bytes of a Leash string (NUL -> C0 80, bytes
    // above 127 -> two-byte form; Leash chars iterate as unsigned).
    pub fnc mutf8(s string) : vec<int> {
        out: vec<int>;
        foreach _, c in<string> s {
            b: int = c + 0;
            if b == 0 {
                out.pushb(192);
                out.pushb(128);
            } also b < 128 {
                out.pushb(b);
            } else {
                out.pushb(192 + (b >> 6));
                out.pushb(128 + (b & 63));
            }
        }
        return out;
    }

    pub fnc utf8(s string) : int {
        return this.alloc(JCp.UTF8, "U:" + s, this.mutf8(s), 1);
    }

    pub fnc class_entry(name string) : int {
        ni: int = this.utf8(name);
        key: string = "C:" + tostring(ni);
        if this.keys.isin(key) { return this.keys[key]; }
        pl: vec<int>;
        pl.pushb((ni >> 8) & 255);
        pl.pushb(ni & 255);
        return this.alloc(JCp.CLASS, key, pl, 1);
    }

    pub fnc nat(name_i int, desc_i int) : int {
        key: string = "N:" + tostring(name_i) + ":" + tostring(desc_i);
        if this.keys.isin(key) { return this.keys[key]; }
        pl: vec<int>;
        pl.pushb((name_i >> 8) & 255);
        pl.pushb(name_i & 255);
        pl.pushb((desc_i >> 8) & 255);
        pl.pushb(desc_i & 255);
        return this.alloc(JCp.NAMEANDTYPE, key, pl, 1);
    }

    pub fnc fieldref(cls string, name string, desc string) : int {
        ci: int = this.class_entry(cls);
        ni: int = this.nat(this.utf8(name), this.utf8(desc));
        key: string = "F:" + tostring(ci) + ":" + tostring(ni);
        if this.keys.isin(key) { return this.keys[key]; }
        pl: vec<int>;
        pl.pushb((ci >> 8) & 255);
        pl.pushb(ci & 255);
        pl.pushb((ni >> 8) & 255);
        pl.pushb(ni & 255);
        return this.alloc(JCp.FIELDREF, key, pl, 1);
    }

    pub fnc methodref(cls string, name string, desc string) : int {
        ci: int = this.class_entry(cls);
        ni: int = this.nat(this.utf8(name), this.utf8(desc));
        key: string = "M:" + tostring(ci) + ":" + tostring(ni);
        if this.keys.isin(key) { return this.keys[key]; }
        pl: vec<int>;
        pl.pushb((ci >> 8) & 255);
        pl.pushb(ci & 255);
        pl.pushb((ni >> 8) & 255);
        pl.pushb(ni & 255);
        return this.alloc(JCp.METHODREF, key, pl, 1);
    }

    pub fnc string_const(s string) : int {
        ui: int = this.utf8(s);
        key: string = "S:" + tostring(ui);
        if this.keys.isin(key) { return this.keys[key]; }
        pl: vec<int>;
        pl.pushb((ui >> 8) & 255);
        pl.pushb(ui & 255);
        return this.alloc(JCp.STRING, key, pl, 1);
    }

    pub fnc int_const(v int) : int {
        key: string = "I:" + tostring(v);
        if this.keys.isin(key) { return this.keys[key]; }
        // Two's-complement bytes: >> is arithmetic on negatives, so the
        // low 8 bits are already correct after masking.
        pl: vec<int>;
        pl.pushb((v >> 24) & 255);
        pl.pushb((v >> 16) & 255);
        pl.pushb((v >> 8) & 255);
        pl.pushb(v & 255);
        return this.alloc(JCp.INT, key, pl, 1);
    }

    pub fnc long_const(hi int, lo int) : int {
        key: string = "J:" + tostring(hi) + ":" + tostring(lo);
        if this.keys.isin(key) { return this.keys[key]; }
        pl: vec<int>;
        pl.pushb((hi >> 24) & 255);
        pl.pushb((hi >> 16) & 255);
        pl.pushb((hi >> 8) & 255);
        pl.pushb(hi & 255);
        pl.pushb((lo >> 24) & 255);
        pl.pushb((lo >> 16) & 255);
        pl.pushb((lo >> 8) & 255);
        pl.pushb(lo & 255);
        return this.alloc(JCp.LONG, key, pl, 2);
    }

    pub fnc double_const(hi int, lo int) : int {
        key: string = "D:" + tostring(hi) + ":" + tostring(lo);
        if this.keys.isin(key) { return this.keys[key]; }
        pl: vec<int>;
        pl.pushb((hi >> 24) & 255);
        pl.pushb((hi >> 16) & 255);
        pl.pushb((hi >> 8) & 255);
        pl.pushb(hi & 255);
        pl.pushb((lo >> 24) & 255);
        pl.pushb((lo >> 16) & 255);
        pl.pushb((lo >> 8) & 255);
        pl.pushb(lo & 255);
        return this.alloc(JCp.DOUBLE, key, pl, 2);
    }

    pub fnc count() : int {
        return this.next_idx;
    }

    pub fnc write_to() : vec<int> {
        out: vec<int>;
        n: int = this.next_idx;
        out.pushb((n >> 8) & 255);
        out.pushb(n & 255);
        i: int = 0;
        while i < this.tags.size {
            tag: int = this.tags.get(i);
            out.pushb(tag);
            if tag == JCp.UTF8 {
                payload: vec<int> = this.payloads.get(i);
                out.pushb((payload.size >> 8) & 255);
                out.pushb(payload.size & 255);
                foreach _, b in<vector> payload {
                    out.pushb(b);
                }
            } else {
                foreach _, b in<vector> this.payloads.get(i) {
                    out.pushb(b);
                }
            }
            i = i + 1;
        }
        return out;
    }
}

// One method's bytecode under construction: labels resolve at finalize,
// max_stack is tracked from per-opcode depth deltas (long/double = 2).
pub def JvmMethod : class {
    pub name_i: int;
    pub desc_i: int;
    pub access: int;
    pub code: vec<int>;
    pub labels: hash<string, int>;
    pub patch_pos: vec<int>;
    pub patch_lbl: vec<string>;
    pub depth: int;
    pub max_depth: int;
    pub locals_used: int;
    pub errors: vec<string>;
    pub tmps: hash<string, int>;

    static pub fnc make(name_i int, desc_i int, access int) : JvmMethod {
        empty_code: vec<int>;
        empty_labels: hash<string, int>;
        empty_pos: vec<int>;
        empty_lbl: vec<string>;
        empty_err: vec<string>;
        empty_tmps: hash<string, int>;
        return JvmMethod { name_i: name_i, desc_i: desc_i, access: access, code: empty_code, labels: empty_labels, patch_pos: empty_pos, patch_lbl: empty_lbl, depth: 0, max_depth: 0, locals_used: 0, errors: empty_err, tmps: empty_tmps };
    }

    // A reusable scratch slot per descriptor (for stack juggling).
    pub fnc temp_slot(desc string) : int {
        if this.tmps.isin(desc) { return this.tmps[desc]; }
        slots: int = 1;
        if desc == "J" || desc == "D" { slots = 2; }
        s: int = this.alloc_local(slots);
        this.tmps.push(desc, s);
        return s;
    }
    pub fnc fail(msg string) : void {
        this.errors.pushb(msg);
    }

    pub fnc adjust(d int) : void {
        this.depth = this.depth + d;
        if this.depth > this.max_depth { this.max_depth = this.depth; }
        if this.depth < 0 { this.fail("stack underflow"); }
    }

    pub fnc emit_u8(v int) : void {
        this.code.pushb(v & 255);
    }

    pub fnc emit_u16(v int) : void {
        this.code.pushb((v >> 8) & 255);
        this.code.pushb(v & 255);
    }

    // Raw opcode with an explicit stack delta (slots; long/double = 2).
    pub fnc op(op int, delta int) : void {
        this.emit_u8(op);
        this.adjust(delta);
    }

    // Helpers for the common shapes.
    pub fnc op_none(op int) : void {
        this.emit_u8(op);
    }

    pub fnc op_1(op int, a int, delta int) : void {
        this.emit_u8(op);
        this.emit_u8(a);
        this.adjust(delta);
    }

    pub fnc op_11(op int, a int, b int, delta int) : void {
        this.emit_u8(op);
        this.emit_u8(a);
        this.emit_u8(b);
        this.adjust(delta);
    }

    pub fnc mark(lbl string) : void {
        this.labels.push(lbl, this.code.size);
    }

    // Two-byte branch (goto/if_*): patched at finalize.
    pub fnc branch(op int, lbl string, pop_slots int) : void {
        this.emit_u8(op);
        this.patch_pos.pushb(this.code.size);
        this.patch_lbl.pushb(lbl);
        this.emit_u16(0);
        this.adjust(0 - pop_slots);
    }

    pub fnc alloc_local(slots int) : int {
        if this.locals_used + slots > 255 {
            this.fail("too many locals (wide prefix unsupported)");
            return 0;
        }
        base: int = this.locals_used;
        this.locals_used = this.locals_used + slots;
        return base;
    }

    pub fnc load_local(desc string, slot int) : void {
        // Longs and doubles BOTH occupy two slots but use distinct
        // opcode families — mixing them fails verification (the old
        // V49 verifier reports it precisely; the split verifier masks
        // it behind misleading stackmap errors).
        if desc == "J" {
            if slot < 4 {
                this.op(JOp.LLOAD_0 + slot, 2);
            } else {
                this.op_1(JOp.LLOAD, slot, 2);
            }
            return;
        }
        if desc == "D" {
            if slot < 4 {
                this.op(JOp.DLOAD_0 + slot, 2);
            } else {
                this.op_1(JOp.DLOAD, slot, 2);
            }
            return;
        }
        if desc == "I" || desc == "Z" || desc == "B" || desc == "S" || desc == "C" {
            if slot < 4 {
                this.op(JOp.ILOAD_0 + slot, 1);
            } else {
                this.op_1(JOp.ILOAD, slot, 1);
            }
            return;
        }
        if slot < 4 {
            this.op(JOp.ALOAD_0 + slot, 1);
        } else {
            this.op_1(JOp.ALOAD, slot, 1);
        }
    }

    pub fnc store_local(desc string, slot int) : void {
        if desc == "J" {
            if slot < 4 {
                this.op(JOp.LSTORE_0 + slot, -2);
            } else {
                this.op_1(JOp.LSTORE, slot, -2);
            }
            return;
        }
        if desc == "D" {
            if slot < 4 {
                this.op(JOp.DSTORE_0 + slot, -2);
            } else {
                this.op_1(JOp.DSTORE, slot, -2);
            }
            return;
        }
        if desc == "I" || desc == "Z" || desc == "B" || desc == "S" || desc == "C" {
            if slot < 4 {
                this.op(JOp.ISTORE_0 + slot, -1);
            } else {
                this.op_1(JOp.ISTORE, slot, -1);
            }
            return;
        }
        if slot < 4 {
            this.op(JOp.ASTORE_0 + slot, -1);
        } else {
            this.op_1(JOp.ASTORE, slot, -1);
        }
    }

    pub fnc finalize(cp JvmCp) : bool {
        // Resolve branch patches (s16 offsets from the opcode start).
        i: int = 0;
        while i < this.patch_pos.size {
            pos: int = this.patch_pos.get(i);
            lbl: string = this.patch_lbl.get(i);
            if !this.labels.isin(lbl) {
                this.fail("undefined label: " + lbl);
                return false;
            }
            target: int = this.labels[lbl];
            op_at: int = pos - 1;
            off: int = target - op_at;
            if off < -32768 || off > 32767 {
                this.fail("branch out of range (goto_w unsupported)");
                return false;
            }
            u: int = off;
            if u < 0 { u = u + 65536; }
            this.code.set(pos, (u >> 8) & 255);
            this.code.set(pos + 1, u & 255);
            i = i + 1;
        }
        return this.errors.size == 0;
    }

    pub fnc write_to(code_idx int) : vec<int> {
        out: vec<int>;
        // access_flags, name_index, descriptor_index, attributes_count
        out.pushb((this.access >> 8) & 255);
        out.pushb(this.access & 255);
        out.pushb((this.name_i >> 8) & 255);
        out.pushb(this.name_i & 255);
        out.pushb((this.desc_i >> 8) & 255);
        out.pushb(this.desc_i & 255);
        out.pushb(0);
        out.pushb(1);
        out.pushb((code_idx >> 8) & 255);
        out.pushb(code_idx & 255);
        attr_len: int = 12 + this.code.size;
        out.pushb((attr_len >> 24) & 255);
        out.pushb((attr_len >> 16) & 255);
        out.pushb((attr_len >> 8) & 255);
        out.pushb(attr_len & 255);
        // HotSpot's pre-StackMapTable verifier rejects max_stack < 2 in
        // methods containing branches (verified empirically: identical
        // bytecode passes with max_stack=2, fails with 1).
        ms: int = this.max_depth;
        if ms < 2 { ms = 2; }
        out.pushb((ms >> 8) & 255);
        out.pushb(ms & 255);
        out.pushb((this.locals_used >> 8) & 255);
        out.pushb(this.locals_used & 255);
        out.pushb((this.code.size >> 24) & 255);
        out.pushb((this.code.size >> 16) & 255);
        out.pushb((this.code.size >> 8) & 255);
        out.pushb(this.code.size & 255);
        foreach _, b in<vector> this.code {
            out.pushb(b);
        }
        // exception_table_length = 0, attributes_count = 0
        out.pushb(0);
        out.pushb(0);
        out.pushb(0);
        out.pushb(0);
        return out;
    }
}

// A whole class file: fields + methods over one constant pool.
pub def JvmClass : class {
    pub name: string;
    pub super_name: string;
    pub cp: JvmCp;
    pub f_access: vec<int>;
    pub f_name: vec<int>;
    pub f_desc: vec<int>;
    pub methods: vec<JvmMethod>;

    static pub fnc make(name string, super_name string) : JvmClass {
        empty_a: vec<int>;
        empty_n: vec<int>;
        empty_d: vec<int>;
        empty_m: vec<JvmMethod>;
        return JvmClass { name: name, super_name: super_name, cp: JvmCp.make(), f_access: empty_a, f_name: empty_n, f_desc: empty_d, methods: empty_m };
    }

    pub fnc add_field(access int, name string, desc string) : void {
        this.f_access.pushb(access);
        this.f_name.pushb(this.cp.utf8(name));
        this.f_desc.pushb(this.cp.utf8(desc));
    }

    pub fnc add_method(m JvmMethod) : void {
        this.methods.pushb(m);
    }

    pub fnc write_to() : vec<int> {
        out: vec<int>;
        out.pushb(202);
        out.pushb(254);
        out.pushb(186);
        out.pushb(190);
        out.pushb(0);
        out.pushb(0);
        // Major version 49 (Java 5): verified by the old inferencing
        // verifier, which needs no StackMapTable and reports type
        // errors precisely. The split verifier (v50+) instead chokes
        // on hand-emitted control-flow shapes with misleading
        // "Expecting a stackmap frame" errors.
        out.pushb(0);
        out.pushb(49);
        // Intern every entry BEFORE the pool hits the wire: later
        // interning would mint indices past the written count.
        this_i: int = this.cp.class_entry(this.name);
        super_i: int = this.cp.class_entry(this.super_name);
        code_idx: int = this.cp.utf8("Code");
        cpp: vec<int> = this.cp.write_to();
        ci: int = 0;
        while ci < cpp.size {
            out.pushb(cpp.get(ci));
            ci = ci + 1;
        }
        out.pushb(0);
        out.pushb(33);
        out.pushb((this_i >> 8) & 255);
        out.pushb(this_i & 255);
        out.pushb((super_i >> 8) & 255);
        out.pushb(super_i & 255);
        out.pushb(0);
        out.pushb(0);
        out.pushb((this.f_access.size >> 8) & 255);
        out.pushb(this.f_access.size & 255);
        i: int = 0;
        while i < this.f_access.size {
            out.pushb((this.f_access.get(i) >> 8) & 255);
            out.pushb(this.f_access.get(i) & 255);
            ni: int = this.f_name.get(i);
            out.pushb((ni >> 8) & 255);
            out.pushb(ni & 255);
            di: int = this.f_desc.get(i);
            out.pushb((di >> 8) & 255);
            out.pushb(di & 255);
            out.pushb(0);
            out.pushb(0);
            i = i + 1;
        }
        out.pushb((this.methods.size >> 8) & 255);
        out.pushb(this.methods.size & 255);
        foreach _, m in<vector> this.methods {
            mp: vec<int> = m.write_to(code_idx);
            mi2: int = 0;
            while mi2 < mp.size {
                out.pushb(mp.get(mi2));
                mi2 = mi2 + 1;
            }
        }
        out.pushb(0);
        out.pushb(0);
        return out;
    }
}

// The Leash -> JVM emitter: one JvmGen per program. Functions become
// static methods of the main class; expression code leaves its value
// on the operand stack (long/double occupy two slots).
pub def JvmGen : class {
    pub tc: TypeChecker;
    pub cg: CodeGen;
    pub main_class: string;
    pub errors: vec<string>;
    pub var_types: hash<string, string>;
    pub var_slots: hash<string, int>;
    pub label_counter: int;
    pub defer_stack: vec<Stmt>;
    pub fusion_names: hash<string, bool>;
    pub loop_heads: vec<string>;
    pub loop_exits: vec<string>;
    pub current_func_ret: string;
    pub cur_cp: JvmCp;
    pub cur_method: JvmMethod;
    pub has_entry: bool;
    pub src_file: string;
    pub klasses: vec<JvmClass>;
    pub array_base_override: string;
    pub klass_idx: hash<string, int>;
    pub current_class: string;

    static pub fnc make(tc TypeChecker, main_class string) : JvmGen {
        empty_err: vec<string>;
        empty_vt: hash<string, string>;
        empty_vs: hash<string, int>;
        empty_defers: vec<Stmt>;
        empty_fn: hash<string, bool>;
        empty_hh: vec<string>;
        empty_he: vec<string>;
        empty_kl: vec<JvmClass>;
        empty_ki: hash<string, int>;
        return JvmGen { tc: tc, cg: CodeGen.make(tc), main_class: main_class, errors: empty_err, var_types: empty_vt, var_slots: empty_vs, label_counter: 0, defer_stack: empty_defers, fusion_names: empty_fn, loop_heads: empty_hh, loop_exits: empty_he, current_func_ret: "void", cur_cp: JvmCp.make(), cur_method: JvmMethod.make(0, 0, 0), has_entry: false, src_file: "", klasses: empty_kl, klass_idx: empty_ki, current_class: "", array_base_override: "" };
    }

    // Keep the oracle's view of locals identical to ours.
    pub fnc define_var(name string, typ string, slot int) : void {
        this.var_types.push(name, typ);
        this.var_slots.push(name, slot);
        this.cg.var_types.push(name, typ);
        this.cg.var_ptrs.push(name, "@jvm_dummy");
    }

    pub fnc expr_type(e Expr) : string {
        // Method-result overrides where the shared oracle is imprecise
        // (popf/remove/clear/extend/set/delete/push all fall to "void"
        // there; values() is hard-coded to vec<int>).
        if e != null && e.kind == ExprKind.METHOD_CALL && e.left != null {
            lt: string = this.cg.get_expr_type(e.left);
            mt: string = this.mcall_type(lt, e.sval);
            if mt.size > 0 { return mt; }
        }
        if e != null && e.kind == ExprKind.ARRAY_LIT && e.sval == "__tuple__" {
            ts: string = "(";
            ti: int = 0;
            while ti < e.args.size {
                if ti > 0 { ts = ts + ", "; }
                ts = ts + this.expr_type(e.args.get(ti));
                ti = ti + 1;
            }
            ts = ts + ")";
            return ts;
        }
        if e != null && e.kind == ExprKind.CALL && e.sval == "__tupget" && e.args.size == 2 {
            tt: string = this.expr_type(e.args.get(0));
            tidx: int = e.args.get(1).ival;
            return this.tuple_elem(tt, tidx);
        }
        if e != null && e.kind == ExprKind.CALL {
            bt: string = this.builtin_type(e);
            if bt.size > 0 { return bt; }
        }
        if e != null && e.kind == ExprKind.METHOD_CALL && e.left != null
           && e.left.kind == ExprKind.IDENT && e.left.sval == "File" {
            if e.sval == "open" { return "File"; }
            if e.sval == "rename" || e.sval == "delete" { return "int"; }
            return "";
        }
        if e != null && e.kind == ExprKind.METHOD_CALL && e.left != null {
            lt2: string = this.cg.get_expr_type(e.left);
            if lt2 == "File" {
                if e.sval == "read" || e.sval == "readln" { return "string"; }
                if e.sval == "readb" || e.sval == "readlnb" { return "char[]"; }
                if e.sval == "size" || e.sval == "isin" { return "int"; }
                if e.sval == "rewind" { return "void"; }
                return "int";
            }
        }
        if e != null && e.kind == ExprKind.INT
           && (e.ival > 2147483647 || e.ival < 0 - 2147483648) {
            return "int<64>";
        }
        return this.cg.get_expr_type(e);
    }

    // JVM-side result types for builtin calls.
    pub fnc builtin_type(e Expr) : string {
        f: string = e.sval;
        if f == "cstr" { return "char[]"; }
        if f == "typeof" { return "string"; }
        if f == "sizeof" { return "int"; }
        if f == "get" { return "string"; }
        if f == "seed" || f == "wait" { return "void"; }
        if f == "rand" { return "int"; }
        if f == "randf" || f == "timepass" { return "float"; }
        if f == "choose" { return "string"; }
        if f == "tounion" || f == "normescape" || f == "lstr" { return "string"; }
        if f == "inttobytes" || f == "floattobytes" { return "char[]"; }
        if f == "bytestoint" { return "int"; }
        if f == "bytestofloat" { return "float"; }
        if f == "toint" {
            if e.args.size == 2 { return this.tc.resolve_type_alias(e.args.get(0).sval); }
            return "int";
        }
        if f == "tofloat" {
            if e.args.size == 2 { return this.tc.resolve_type_alias(e.args.get(0).sval); }
            return "float";
        }
        if f == "tochar" {
            if e.args.size == 2 { return this.tc.resolve_type_alias(e.args.get(0).sval); }
            return "char";
        }
        if f == "scast" && e.args.size == 2 {
            return this.tc.resolve_type_alias(e.args.get(0).sval);
        }
        return "";
    }

    pub fnc fail(msg string) : void {
        this.errors.pushb(msg);
    }

    pub fnc jvm_unsupported(what string) : string {
        this.fail("jvm target: unsupported construct: " + what);
        return "";
    }

    pub fnc new_label(prefix string) : string {
        l: string = prefix + "_" + tostring(this.label_counter);
        this.label_counter = this.label_counter + 1;
        return l;
    }

    // --- Type mapping -------------------------------------------------
    // int/uint/char/bool -> I (narrow widths narrow after production),
    // int<64>/uint<64> -> J, floats -> D, string -> String,
    // vec -> ArrayList, hash -> HashMap. "" = unsupported.
    pub fnc jdesc(t string) : string {
        if t.size > 1 && t[0] == '&' {
            inner: string = "";
            i: int = 1;
            while i < t.size {
                inner = inner + t[i];
                i = i + 1;
            }
            return this.jdesc(inner);
        }
        if t == "int" || t == "uint" || t == "char" { return "I"; }
        if t == "bool" { return "Z"; }
        if t == "int<8>" || t == "int<16>" || t == "int<32>" { return "I"; }
        if t == "uint<8>" || t == "uint<16>" || t == "uint<32>" { return "I"; }
        if t == "int<64>" || t == "uint<64>" || t == "int64" || t == "uint64" { return "J"; }
        if t == "float" || t == "double" || t == "float64" { return "D"; }
        if t == "float<16>" || t == "float<32>" || t == "float<64>" || t == "float<128>" { return "D"; }
        if t == "string" { return "Ljava/lang/String;"; }
        if t == "void" { return "V"; }
        if t.size > 4 && t[0] == 'v' && t[1] == 'e' && t[2] == 'c' && t[3] == '<' { return "Ljava/util/ArrayList;"; }
        if t.size > 5 && t[0] == 'h' && t[1] == 'a' && t[2] == 's' && t[3] == 'h' && t[4] == '<' { return "Ljava/util/HashMap;"; }
        if t.size > 0 && t[0] == '*' { return "Ljava/lang/Object;"; }
        if t.size > 2 && t[t.size - 1] == ']' {
            base: string = "";
            bi: int = 0;
            while bi < t.size && t[bi] != '[' {
                base = base + t[bi];
                bi = bi + 1;
            }
            return "[" + this.jdesc(base);
        }
        if t.size > 1 && t[0] == '(' { return "[Ljava/lang/Object;"; }
        if t == "File" { return "Ljava/io/RandomAccessFile;"; }
        if this.tc.enums.isin(t) { return "I"; }
        if this.tc.structs.isin(t) { return "L" + t + ";"; }
        if this.tc.classes.isin(t) { return "L" + t + ";"; }
        if t == "nil" { return "Ljava/lang/Object;"; }
        return "";
    }

    pub fnc slots_of(d string) : int {
        if d == "J" || d == "D" { return 2; }
        return 1;
    }

    pub fnc is_uint_leash(t string) : bool {
        if t == "uint" { return true; }
        return t.size > 5 && t[0] == 'u' && t[1] == 'i' && t[2] == 'n' && t[3] == 't' && t[4] == '<';
    }

    pub fnc both_refs(ld string, rd string) : bool {
        lok: bool = ld.size > 0 && (ld[0] == 'L' || ld[0] == '[');
        rok: bool = rd.size > 0 && (rd[0] == 'L' || rd[0] == '[');
        return lok && rok;
    }

    pub fnc is_vec_leash(t string) : bool {
        if t.size > 4 && t[0] == 'v' && t[1] == 'e' && t[2] == 'c' && t[3] == '<' { return true; }
        return false;
    }

    pub fnc is_hash_leash(t string) : bool {
        if t.size > 5 && t[0] == 'h' && t[1] == 'a' && t[2] == 's' && t[3] == 'h' && t[4] == '<' { return true; }
        return false;
    }

    // Element type of vec<T> (handles nesting via depth counting).
    pub fnc vec_inner_type(t string) : string {
        start: int = 4;
        if t.size > 7 && t[0] == 'm' && t[1] == 'a' && t[2] == 't' && t[3] == 'r' && t[4] == 'i' && t[5] == 'x' && t[6] == '<' { start = 7; }
        depth: int = 0;
        i: int = start;
        while i < t.size {
            c: char = t[i];
            if c == '<' { depth = depth + 1; }
            also c == '>' {
                if depth == 0 {
                    inner: string = "";
                    k: int = start;
                    while k < i {
                        inner = inner + t[k];
                        k = k + 1;
                    }
                    return inner;
                }
                depth = depth - 1;
            }
            i = i + 1;
        }
        return "";
    }

    pub fnc trim_type_str(s string) : string {
        a: int = 0;
        b: int = s.size - 1;
        while a < s.size && s[a] == ' ' { a = a + 1; }
        while b >= a && s[b] == ' ' { b = b - 1; }
        out: string = "";
        while a <= b {
            out = out + s[a];
            a = a + 1;
        }
        return out;
    }

    pub fnc tuple_elem(tup string, idx int) : string {
        inner: string = "";
        ii: int = 1;
        while ii < tup.size - 1 {
            inner = inner + tup[ii];
            ii = ii + 1;
        }
        depth: int = 0;
        cur: string = "";
        ei: int = 0;
        pi: int = 0;
        while pi < inner.size {
            pch: char = inner[pi];
            if pch == '<' || pch == '(' { depth = depth + 1; }
            if pch == '>' || pch == ')' { depth = depth - 1; }
            if pch == ',' && depth == 0 {
                if ei == idx { return this.trim_type_str(cur); }
                cur = "";
                ei = ei + 1;
            } else {
                cur = cur + pch;
            }
            pi = pi + 1;
        }
        if ei == idx { return this.trim_type_str(cur); }
        return "int";
    }

    pub fnc is_float_leash(t string) : bool {
        if t == "float" || t == "double" || t == "float64" { return true; }
        if t.size > 6 && t[0] == 'f' && t[1] == 'l' && t[2] == 'o' && t[3] == 'a' && t[4] == 't' && t[5] == '<' { return true; }
        return false;
    }

    // Narrow the stack top to a narrow int type (no-op otherwise).
    pub fnc narrow_to(t string) : void {
        if t == "int<8>" {
            this.cur_method.op(JOp.I2B, 0);
        } also t == "uint<8>" {
            this.iconst(255);
            this.cur_method.op(JOp.IAND, -1);
        } also t == "int<16>" {
            this.cur_method.op(JOp.I2S, 0);
        } also t == "uint<16>" {
            this.ldc_int(65535);
            this.cur_method.op(JOp.IAND, -1);
        } also t == "char" {
            this.cur_method.op(JOp.I2C, 0);
        }
    }

    pub fnc iconst(v int) : void {
        if v == -1 {
            this.cur_method.op(JOp.ICONST_M1, 1);
        } also v >= 0 && v <= 5 {
            this.cur_method.op(JOp.ICONST_0 + v, 1);
        } also v >= -128 && v <= 127 {
            this.cur_method.op_1(JOp.BIPUSH, v & 255, 1);
        } also v >= -32768 && v <= 32767 {
            u: int = v;
            if u < 0 { u = u + 65536; }
            this.cur_method.emit_u8(JOp.SIPUSH);
            this.cur_method.emit_u8((u >> 8) & 255);
            this.cur_method.emit_u8(u & 255);
            this.cur_method.adjust(1);
        } else {
            this.ldc_int(v);
        }
    }

    pub fnc ldc_int(v int) : void {
        idx: int = this.cur_cp.int_const(v);
        if idx < 256 {
            this.cur_method.op_1(JOp.LDC, idx, 1);
        } else {
            this.cur_method.emit_u8(JOp.LDC_W);
            this.cur_method.emit_u8((idx >> 8) & 255);
            this.cur_method.emit_u8(idx & 255);
            this.cur_method.adjust(1);
        }
    }

    pub fnc ldc_string(s string) : void {
        idx: int = this.cur_cp.string_const(s);
        if idx < 256 {
            this.cur_method.op_1(JOp.LDC, idx, 1);
        } else {
            this.cur_method.emit_u8(JOp.LDC_W);
            this.cur_method.emit_u8((idx >> 8) & 255);
            this.cur_method.emit_u8(idx & 255);
            this.cur_method.adjust(1);
        }
    }

    // --- Output -------------------------------------------------------
    // show(a, b, ...) concatenates with no separator and ends the line.
    pub fnc gen_show_arg(arg Expr) : void {
        t: string = this.expr_type(arg);
        d: string = this.jdesc(t);
        if d.size == 0 {
            this.jvm_unsupported("show() of '" + t + "'");
            return;
        }
        // Native show(struct) fails in clang; surface a clean error.
        // Native show(tuple) is unsupported; surface a clean error.
        if t.size > 0 && t[0] == '(' {
            this.jvm_unsupported("show() of tuple '" + t + "'");
            return;
        }
        if this.tc.structs.isin(t) || this.tc.classes.isin(t) {
            this.jvm_unsupported("show() of struct/class '" + t + "'");
            return;
        }
        this.emit_getstatic_out();
        if t == "string" {
            this.gen_expr(arg);
            this.emit_invoke_print("Ljava/lang/String;");
        } also t == "nil" {
            // Native codegen crashes on show(nil); the JVM defines "nil".
            this.ldc_string("nil");
            this.emit_invoke_print("Ljava/lang/String;");
        } also d == "I" {
            this.gen_expr(arg);
            if t == "char" {
                this.cur_method.op(JOp.I2C, 0);
                this.emit_invoke_print("C");
            } also this.is_uint_leash(t) {
                // Unsigned 32-bit: native prints the full range.
                this.emit_invoke(JOp.INVOKESTATIC, "java/lang/Integer", "toUnsignedString", "(I)Ljava/lang/String;");
                this.emit_invoke_print("Ljava/lang/String;");
            } else {
                this.emit_invoke_print("I");
            }
        } also d == "J" {
            this.gen_expr(arg);
            if this.is_uint_leash(t) {
                this.emit_invoke(JOp.INVOKESTATIC, "java/lang/Long", "toUnsignedString", "(J)Ljava/lang/String;");
                this.emit_invoke_print("Ljava/lang/String;");
            } else {
                this.emit_invoke_print("J");
            }
        } also d == "D" {
            // %.6f like the native %f formatting (Double.toString differs):
            // String.format(ROOT, "%.6f", new Object[]{ box(d) }).
            this.emit_locale_root();
            this.ldc_string("%.6f");
            this.iconst(1);
            this.emit_anewarray_object(1);
            this.cur_method.op(JOp.DUP, 1);
            this.iconst(0);
            this.gen_expr(arg);
            this.box_top("D");
            this.cur_method.op(JOp.AASTORE, -3);
            this.emit_invoke(JOp.INVOKESTATIC, "java/lang/String", "format", "(Ljava/util/Locale;Ljava/lang/String;[Ljava/lang/Object;)Ljava/lang/String;");
            this.emit_invoke_print("Ljava/lang/String;");
        } also d == "Z" {
            this.gen_expr(arg);
            this.emit_invoke_print("Z");
        } also d == "Ljava/util/ArrayList;" {
            if this.is_vec_leash(t) && this.is_float_leash(this.vec_inner_type(t)) {
                this.gen_show_float_vec(arg);
            } else {
                // Integer/Long/Boolean/Character/String elements render
                // like the native backend via ArrayList.toString.
                this.gen_expr(arg);
                this.emit_invoke_print("Ljava/lang/Object;");
            }
        } also d == "Ljava/util/HashMap;" {
            // Native show(hash) fails in clang; the JVM prints {k=v}.
            this.gen_expr(arg);
            this.emit_invoke_print("Ljava/lang/Object;");
        } else {
            this.gen_expr(arg);
            this.emit_invoke_print("Ljava/lang/Object;");
        }
    }

    pub fnc base_name(p string) : string {
        i: int = 0;
        last: int = -1;
        while i < p.size {
            if p[i] == '/' { last = i; }
            i = i + 1;
        }
        out: string = "";
        i = last + 1;
        while i < p.size {
            out = out + p[i];
            i = i + 1;
        }
        return out;
    }

    // Push Locale.ROOT (locale-independent number formatting).
    pub fnc emit_locale_root() : void {
        idx: int = this.cur_cp.fieldref("java/util/Locale", "ROOT", "Ljava/util/Locale;");
        this.cur_method.emit_u8(JOp.GETSTATIC);
        this.cur_method.emit_u8((idx >> 8) & 255);
        this.cur_method.emit_u8(idx & 255);
        this.cur_method.adjust(1);
    }

    pub fnc emit_getstatic_out() : void {
        idx: int = this.cur_cp.fieldref("java/lang/System", "out", "Ljava/io/PrintStream;");
        this.cur_method.emit_u8(JOp.GETSTATIC);
        this.cur_method.emit_u8((idx >> 8) & 255);
        this.cur_method.emit_u8(idx & 255);
        this.cur_method.adjust(1);
    }

    pub fnc emit_invoke_print(arg_desc string) : void {
        idx: int = this.cur_cp.methodref("java/io/PrintStream", "print", "(" + arg_desc + ")V");
        this.cur_method.emit_u8(JOp.INVOKEVIRTUAL);
        this.cur_method.emit_u8((idx >> 8) & 255);
        this.cur_method.emit_u8(idx & 255);
        if arg_desc == "J" || arg_desc == "D" {
            this.cur_method.adjust(-3);
        } else {
            this.cur_method.adjust(-2);
        }
    }

    pub fnc emit_println() : void {
        this.emit_getstatic_out();
        idx: int = this.cur_cp.methodref("java/io/PrintStream", "println", "()V");
        this.cur_method.emit_u8(JOp.INVOKEVIRTUAL);
        this.cur_method.emit_u8((idx >> 8) & 255);
        this.cur_method.emit_u8(idx & 255);
        this.cur_method.adjust(-1);
    }

    // show(vec<float>) as [2.500000, 0.100000] (ArrayList.toString would
    // give [2.5, 0.1]). Elements are already boxed Doubles.
    pub fnc gen_show_float_vec(arg Expr) : void {
        this.gen_expr(arg);
        list_slot: int = this.cur_method.alloc_local(1);
        this.cur_method.store_local("Ljava/util/ArrayList;", list_slot);
        // StringBuilder sb = new StringBuilder("[");
        this.cur_method.op(JOp.NEW, 1);
        sbi: int = this.cur_cp.class_entry("java/lang/StringBuilder");
        this.cur_method.emit_u8((sbi >> 8) & 255);
        this.cur_method.emit_u8(sbi & 255);
        this.cur_method.op(JOp.DUP, 1);
        this.ldc_string("[");
        this.emit_invoke(JOp.INVOKESPECIAL, "java/lang/StringBuilder", "<init>", "(Ljava/lang/String;)V");
        sb_slot: int = this.cur_method.alloc_local(1);
        this.cur_method.store_local("Ljava/lang/StringBuilder;", sb_slot);
        idx_slot: int = this.cur_method.alloc_local(1);
        this.cur_method.op(JOp.ICONST_0, 1);
        this.cur_method.store_local("I", idx_slot);
        head_lbl: string = this.new_label("sbv_h");
        body_lbl: string = this.new_label("sbv_b");
        end_lbl: string = this.new_label("sbv_e");
        this.loop_heads.pushb(head_lbl);
        this.loop_exits.pushb(end_lbl);
        this.cur_method.mark(head_lbl);
        this.cur_method.load_local("I", idx_slot);
        this.cur_method.load_local("Ljava/util/ArrayList;", list_slot);
        this.emit_invoke(JOp.INVOKEVIRTUAL, "java/util/ArrayList", "size", "()I");
        this.cur_method.branch(JOp.IF_ICMPGE, end_lbl, 2);
        this.cur_method.mark(body_lbl);
        // if idx > 0: sb.append(", ")
        sep_lbl: string = this.new_label("sbv_sep");
        this.cur_method.load_local("I", idx_slot);
        this.cur_method.branch(JOp.IFEQ, sep_lbl, 1);
        this.cur_method.load_local("Ljava/lang/StringBuilder;", sb_slot);
        this.ldc_string(", ");
        this.emit_invoke(JOp.INVOKEVIRTUAL, "java/lang/StringBuilder", "append", "(Ljava/lang/String;)Ljava/lang/StringBuilder;");
        this.cur_method.op(JOp.POP, -1);
        this.cur_method.mark(sep_lbl);
        // sb.append(String.format(ROOT, "%.6f", new Object[]{ list.get(idx) }));
        this.cur_method.load_local("Ljava/lang/StringBuilder;", sb_slot);
        this.emit_locale_root();
        this.ldc_string("%.6f");
        this.iconst(1);
        this.emit_anewarray_object(1);
        this.cur_method.op(JOp.DUP, 1);
        this.iconst(0);
        this.cur_method.load_local("Ljava/util/ArrayList;", list_slot);
        this.cur_method.load_local("I", idx_slot);
        this.emit_invoke(JOp.INVOKEVIRTUAL, "java/util/ArrayList", "get", "(I)Ljava/lang/Object;");
        this.cur_method.op(JOp.AASTORE, -3);
        this.emit_invoke(JOp.INVOKESTATIC, "java/lang/String", "format", "(Ljava/util/Locale;Ljava/lang/String;[Ljava/lang/Object;)Ljava/lang/String;");
        this.emit_invoke(JOp.INVOKEVIRTUAL, "java/lang/StringBuilder", "append", "(Ljava/lang/String;)Ljava/lang/StringBuilder;");
        this.cur_method.op(JOp.POP, -1);
        // idx += 1
        this.cur_method.load_local("I", idx_slot);
        this.iconst(1);
        this.cur_method.op(JOp.IADD, -1);
        this.cur_method.store_local("I", idx_slot);
        this.cur_method.branch(JOp.GOTO, head_lbl, 0);
        this.cur_method.mark(end_lbl);
        this.loop_heads.popb();
        this.loop_exits.popb();
        this.cur_method.load_local("Ljava/lang/StringBuilder;", sb_slot);
        this.ldc_string("]");
        this.emit_invoke(JOp.INVOKEVIRTUAL, "java/lang/StringBuilder", "append", "(Ljava/lang/String;)Ljava/lang/StringBuilder;");
        this.emit_invoke(JOp.INVOKEVIRTUAL, "java/lang/StringBuilder", "toString", "()Ljava/lang/String;");
        this.emit_invoke_print("Ljava/lang/String;");
    }

    // Box the stack top into its wrapper (for Object contexts).
    pub fnc box_top(d string) : void {
        if d == "I" {
            this.emit_invoke(JOp.INVOKESTATIC, "java/lang/Integer", "valueOf", "(I)Ljava/lang/Integer;");
        } also d == "J" {
            this.emit_invoke(JOp.INVOKESTATIC, "java/lang/Long", "valueOf", "(J)Ljava/lang/Long;");
        } also d == "D" {
            this.emit_invoke(JOp.INVOKESTATIC, "java/lang/Double", "valueOf", "(D)Ljava/lang/Double;");
        } also d == "Z" {
            this.emit_invoke(JOp.INVOKESTATIC, "java/lang/Boolean", "valueOf", "(Z)Ljava/lang/Boolean;");
        } also d == "C" {
            this.emit_invoke(JOp.INVOKESTATIC, "java/lang/Character", "valueOf", "(C)Ljava/lang/Character;");
        }
    }

    pub fnc emit_anewarray_object(n int) : void {
        ci: int = this.cur_cp.class_entry("java/lang/Object");
        this.cur_method.emit_u8(JOp.ANEWARRAY);
        this.cur_method.emit_u8((ci >> 8) & 255);
        this.cur_method.emit_u8(ci & 255);
        this.cur_method.adjust(0);
    }

    // --- Coercions ----------------------------------------------------
    // Convert the stack top from one leash type to another (table
    // mirrors the scalar coercions: trunc/sext/zext, sitofp/uitofp,
    // fptosi/fptoui, float widening; then narrow when the target is
    // a narrow int). Unknown pairs are left alone.
    pub fnc jvm_coerce(from_t string, to_t string) : void {
        if from_t == to_t { return; }
        fd: string = this.jdesc(from_t);
        td: string = this.jdesc(to_t);
        if fd.size == 0 || td.size == 0 { return; }
        if fd == td { return; }
        if fd == "I" && td == "I" {
            return;
        }
        if fd == "I" && td == "J" {
            if this.is_uint_leash(from_t) {
                this.cur_method.op(JOp.I2L, 1);
                this.long_const(0, 0 - 1);
                this.cur_method.op(JOp.LAND, -2);
            } else {
                this.cur_method.op(JOp.I2L, 1);
            }
            return;
        }
        if fd == "J" && td == "I" {
            this.cur_method.op(JOp.L2I, -1);
            this.narrow_to(to_t);
            return;
        }
        if fd == "I" && td == "D" {
            if this.is_uint_leash(from_t) {
                this.cur_method.op(JOp.I2L, 1);
                this.long_const(0, 0 - 1);
                this.cur_method.op(JOp.LAND, -2);
                this.cur_method.op(JOp.L2D, 0);
            } else {
                this.cur_method.op(JOp.I2D, 1);
            }
            return;
        }
        if fd == "J" && td == "D" {
            this.cur_method.op(JOp.L2D, 0);
            return;
        }
        if fd == "D" && td == "I" {
            if this.is_uint_leash(to_t) {
                // double (2 slots) -> long (2 slots)
                this.cur_method.op(JOp.D2L, 0);
            } else {
                this.cur_method.op(JOp.D2I, -1);
            }
            this.narrow_to(to_t);
            return;
        }
        if fd == "D" && td == "J" {
            this.cur_method.op(JOp.D2L, 0);
            return;
        }
        if fd == "D" && td == "D" { return; }
    }

    pub fnc long_const(hi int, lo int) : void {
        idx: int = this.cur_cp.long_const(hi, lo);
        this.cur_method.emit_u8(JOp.LDC2_W);
        this.cur_method.emit_u8((idx >> 8) & 255);
        this.cur_method.emit_u8(idx & 255);
        this.cur_method.adjust(2);
    }

    // --- Expressions --------------------------------------------------
    // Every branch leaves exactly one value (slots per descriptor).
    pub fnc gen_expr(e Expr) : void {
        if e == null {
            this.jvm_unsupported("null expression");
            return;
        }
        if e.kind == ExprKind.INT {
            // Literals beyond int32 carry their full value as a long
            // (native parity: the reference keeps the literal text and
            // truncates only at narrow stores). expr_type reports them
            // as int<64> so downstream coercions see the right width.
            if e.ival > 2147483647 || e.ival < 0 - 2147483648 {
                hi64: int<64> = e.ival >> 32;
                hi: int = hi64;
                lo64: int<64> = e.ival - (hi64 << 32);
                lo: int = lo64;
                this.long_const(hi, lo);
                return;
            }
            res_t: string = this.expr_type(e);
            rd: string = this.jdesc(res_t);
            if rd == "J" {
                hi64: int<64> = e.ival >> 32;
                hi: int = hi64;
                lo64: int<64> = e.ival - (hi64 << 32);
                lo: int = lo64;
                this.long_const(hi, lo);
            } else {
                this.iconst(e.ival);
                this.narrow_to(res_t);
            }
            return;
        }
        if e.kind == ExprKind.FLOAT {
            // Exact decimal parsing happens on the JVM itself. Folded
            // constants carry no text (like the LLVM backend, which
            // embeds tostring(fval) there); C-printf spellings of
            // non-finite values differ from parseDouble's.
            lit: string = e.sval;
            if lit.size == 0 { lit = tostring(e.fval); }
            if lit == "inf" || lit == "Inf" || lit == "INF" { lit = "Infinity"; }
            also lit == "-inf" || lit == "-Inf" || lit == "-INF" { lit = "-Infinity"; }
            also lit == "nan" || lit == "NaN" || lit == "NAN" { lit = "NaN"; }
            this.ldc_string(lit);
            this.emit_invoke(JOp.INVOKESTATIC, "java/lang/Double", "parseDouble", "(Ljava/lang/String;)D");
            return;
        }
        if e.kind == ExprKind.STRING {
            this.ldc_string(e.sval);
            return;
        }
        if e.kind == ExprKind.CHAR {
            this.iconst(e.cval + 0);
            return;
        }
        if e.kind == ExprKind.BOOL {
            if e.bval {
                this.cur_method.op(JOp.ICONST_1, 1);
            } else {
                this.cur_method.op(JOp.ICONST_0, 1);
            }
            return;
        }
        if e.kind == ExprKind.NIL {
            this.cur_method.op(JOp.ACONST_NULL, 1);
            return;
        }
        if e.kind == ExprKind.IDENT {
            this.gen_ident(e.sval);
            return;
        }
        if e.kind == ExprKind.BINOP {
            this.gen_binop(e);
            return;
        }
        if e.kind == ExprKind.UNARY {
            this.gen_unary(e);
            return;
        }
        if e.kind == ExprKind.CALL {
            this.gen_call(e);
            return;
        }
        if e.kind == ExprKind.TERNARY {
            this.gen_ternary(e);
            return;
        }
        if e.kind == ExprKind.METHOD_CALL {
            this.gen_method_call(e);
            return;
        }
        if e.kind == ExprKind.MEMBER {
            this.gen_member(e);
            return;
        }
        if e.kind == ExprKind.INDEX {
            this.gen_index(e);
            return;
        }
        if e.kind == ExprKind.CAST {
            this.gen_cast(e);
            return;
        }
        if e.kind == ExprKind.STRUCT_INIT {
            this.gen_struct_init(e);
            return;
        }
        if e.kind == ExprKind.ARRAY_LIT {
            this.gen_array_lit(e);
            return;
        }
        if e.kind == ExprKind.POINTER_MEMBER {
            this.jvm_unsupported("pointer member access '->' (unsafe interop is not supported on jvm)");
            return;
        }
        this.jvm_unsupported("expression kind " + tostring(e.kind));
    }

    pub fnc enum_const_val(name string) : int {
        if this.tc.enum_consts.isin(name) { return this.tc.enum_consts[name]; }
        return 0;
    }

    pub fnc gen_ident(name string) : void {
        if name == "_PLATFORM" {
            this.ldc_string("jvm");
            return;
        }
        if name == "_FILEPATH" {
            this.ldc_string(this.src_file);
            return;
        }
        if name == "_FILENAME" {
            this.ldc_string(this.base_name(this.src_file));
            return;
        }
        if this.tc.enum_str_consts.isin(name) {
            this.ldc_string(this.tc.enum_str_consts[name]);
            return;
        }
        if this.tc.enum_consts.isin(name) {
            this.iconst(this.tc.enum_consts[name]);
            return;
        }
        if this.var_slots.isin(name) {
            t: string = "";
            if this.var_types.isin(name) { t = this.var_types[name]; }
            this.cur_method.load_local(this.jdesc(t), this.var_slots[name]);
            return;
        }
        if this.cg.global_vars.isin(name) {
            gt: string = this.cg.global_vars[name];
            gd: string = this.jdesc(gt);
            if gd.size == 0 {
                this.jvm_unsupported("global '" + name + "' of type '" + gt + "'");
                return;
            }
            if this.is_fusion_int(name, gt) {
                this.fusion_get(name, gt, gd);
                return;
            }
            idx: int = this.cur_cp.fieldref(this.main_class, "g_" + name, gd);
            this.cur_method.emit_u8(JOp.GETSTATIC);
            this.cur_method.emit_u8((idx >> 8) & 255);
            this.cur_method.emit_u8(idx & 255);
            this.cur_method.adjust(this.slots_of(gd));
            return;
        }
        this.jvm_unsupported("unknown identifier '" + name + "'");
    }

    // Widen the narrower int operand to the wider (literals embed as-is).
    // Returns the common descriptor ("I", "J" or "D").
    pub fnc unify_int(lv string, lt string, rv string, rt string) : string {
        ld: string = this.jdesc(lt);
        rd: string = this.jdesc(rt);
        if ld == rd { return ld; }
        if (ld == "I" || ld == "J") && (rd == "I" || rd == "J") {
            if ld == "J" {
                if rv.size > 0 && rv[0] != '%' {
                    return "J";
                }
                this.cur_method.op(JOp.I2L, 1);
                return "J";
            }
            if lv.size > 0 && lv[0] != '%' {
                return "I";
            }
            this.cur_method.op(JOp.I2L, 1);
            return "J";
        }
        return "";
    }

    // Generate an operand coerced to the common descriptor.
    pub fnc gen_common(e Expr, common string, common_leash string) : void {
        t: string = this.expr_type(e);
        this.gen_expr(e);
        if common == "J" && this.jdesc(t) == "I" {
            if this.is_uint_leash(t) {
                this.cur_method.op(JOp.I2L, 1);
                this.long_const(0, 0 - 1);
                this.cur_method.op(JOp.LAND, -2);
            } else {
                this.cur_method.op(JOp.I2L, 1);
            }
        } also common == "D" {
            this.jvm_coerce(t, common_leash);
        } also common == "I" && this.jdesc(t) == "J" {
            this.cur_method.op(JOp.L2I, -1);
        }
    }

    pub fnc gen_binop(e Expr) : void {
        lt: string = this.expr_type(e.left);
        rt: string = this.expr_type(e.right);
        res_t: string = this.expr_type(e);
        // String concatenation and removal.
        if (lt == "string" || rt == "string") && e.op == "+" {
            this.gen_expr(e.left);
            if lt != "string" {
                this.jvm_tostring(lt);
            }
            this.gen_expr(e.right);
            if rt != "string" {
                this.jvm_tostring(rt);
            }
            this.emit_invoke(JOp.INVOKEVIRTUAL, "java/lang/String", "concat", "(Ljava/lang/String;)Ljava/lang/String;");
            return;
        }
        if e.op == "&&" || e.op == "||" {
            this.gen_logic(e);
            return;
        }
        if e.op == "==" || e.op == "!=" || e.op == "<" || e.op == "<=" || e.op == ">" || e.op == ">=" || e.op == "is" || e.op == "isnt" {
            this.gen_compare(e, lt, rt);
            return;
        }
        if e.op == "<>" {
            this.jvm_unsupported("membership test '<>' (use .isin() for now)");
            return;
        }
        // Numeric ops: common descriptor, coerce both sides, operate,
        // narrow the result back to the expression type.
        ld: string = this.jdesc(lt);
        rd: string = this.jdesc(rt);
        common: string = "I";
        common_leash: string = "int";
        if ld == "D" || rd == "D" {
            common = "D";
            common_leash = "float";
        } also ld == "J" || rd == "J" {
            common = "J";
            common_leash = "int<64>";
        }
        if common != "I" && common != "J" && common != "D" {
            this.jvm_unsupported("binary '" + e.op + "' on '" + lt + "' and '" + rt + "'");
            return;
        }
        this.gen_common(e.left, common, common_leash);
        this.gen_common(e.right, common, common_leash);
        is_uint_op: bool = this.is_uint_leash(lt);
        if e.op == "+" { this.int_op(common, JOp.IADD, JOp.LADD, JOp.DADD); }
        also e.op == "-" { this.int_op(common, JOp.ISUB, JOp.LSUB, JOp.DSUB); }
        also e.op == "*" { this.int_op(common, JOp.IMUL, JOp.LMUL, JOp.DMUL); }
        also e.op == "/" {
            if common == "D" { this.cur_method.op(JOp.DDIV, -2); }
            also common == "J" {
                this.check_nonzero("J");
                if is_uint_op {
                    this.emit_invoke(JOp.INVOKESTATIC, "java/lang/Long", "divideUnsigned", "(JJ)J");
                } else {
                    this.cur_method.op(JOp.LDIV, -2);
                }
            } else {
                this.check_nonzero("I");
                if is_uint_op {
                    this.emit_invoke(JOp.INVOKESTATIC, "java/lang/Integer", "divideUnsigned", "(II)I");
                } else {
                    this.cur_method.op(JOp.IDIV, -1);
                }
            }
        } also e.op == "%" {
            if common == "D" { this.cur_method.op(JOp.DREM, -2); }
            also common == "J" {
                this.check_nonzero("J");
                if is_uint_op {
                    this.emit_invoke(JOp.INVOKESTATIC, "java/lang/Long", "remainderUnsigned", "(JJ)J");
                } else {
                    this.cur_method.op(JOp.LREM, -2);
                }
            } else {
                this.check_nonzero("I");
                if is_uint_op {
                    this.emit_invoke(JOp.INVOKESTATIC, "java/lang/Integer", "remainderUnsigned", "(II)I");
                } else {
                    this.cur_method.op(JOp.IREM, -1);
                }
            }
        } also e.op == "&" || e.op == "|" || e.op == "^" {
            if common == "D" {
                this.jvm_unsupported("bitwise '" + e.op + "' on floats");
                return;
            }
            if e.op == "&" { this.int_op(common, JOp.IAND, JOp.LAND, JOp.DADD); }
            also e.op == "|" { this.int_op(common, JOp.IOR, JOp.LOR, JOp.DADD); }
            else { this.int_op(common, JOp.IXOR, JOp.LXOR, JOp.DADD); }
        } also e.op == "<<" || e.op == ">>" {
            // JVM shifts take an int distance: narrow a long rhs back.
            if common == "J" { this.cur_method.op(JOp.L2I, -1); }
            if e.op == "<<" {
                if common == "J" { this.cur_method.op(JOp.LSHL, -1); }
                else { this.cur_method.op(JOp.ISHL, -1); }
            } else {
                if common == "J" {
                    if is_uint_op { this.cur_method.op(JOp.LUSHR, -1); } else { this.cur_method.op(JOp.LSHR, -1); }
                } else {
                    if is_uint_op { this.cur_method.op(JOp.IUSHR, -1); } else { this.cur_method.op(JOp.ISHR, -1); }
                }
            }
        } else {
            this.jvm_unsupported("binary operator '" + e.op + "'");
            return;
        }
        this.narrow_to(res_t);
    }

    pub fnc int_op(common string, iop int, lop int, dop int) : void {
        if common == "D" { this.cur_method.op(dop, -2); }
        also common == "J" { this.cur_method.op(lop, -2); }
        else { this.cur_method.op(iop, -1); }
    }

    // Abort with a message when the divisor on the stack top is zero
    // (reference parity: message to stdout, exit 1). Consumes nothing.
    pub fnc check_nonzero(idesc string) : void {
        // Spill/restore through a temp: dup_x1/swap/dup2 break
        // old-verifier joins (verified empirically on the target JVM),
        // while plain dup/pop and locals are safe.
        ok_lbl: string = this.new_label("nz_ok");
        tslot: int = this.cur_method.temp_slot(idesc);
        this.cur_method.store_local(idesc, tslot);
        this.cur_method.load_local(idesc, tslot);
        if idesc == "J" {
            this.cur_method.op(JOp.LCONST_0, 2);
            this.cur_method.op(JOp.LCMP, -3);
        }
        this.cur_method.branch(JOp.IFNE, ok_lbl, 1);
        // Fail block: fresh [out, msg] pair (the spilled divisor stays in
        // its temp; the dividend below is dead after exit, so no juggling).
        this.emit_getstatic_out();
        this.ldc_string("Runtime error: Division by zero.\n");
        this.emit_invoke(JOp.INVOKEVIRTUAL, "java/io/PrintStream", "print", "(Ljava/lang/String;)V");
        this.iconst(1);
        this.emit_invoke(JOp.INVOKESTATIC, "java/lang/System", "exit", "(I)V");
        this.cur_method.branch(JOp.GOTO, ok_lbl, 0);
        this.cur_method.mark(ok_lbl);
        this.cur_method.load_local(idesc, tslot);
    }

    // Comparisons yield 0/1 ints. Strings compare by content
    // (null-safe Objects.equals); doubles use ordered compares so NaN
    // behaves like the native backend; refs compare by identity.
    pub fnc gen_compare(e Expr, lt string, rt string) : void {
        ld: string = this.jdesc(lt);
        rd: string = this.jdesc(rt);
        // Booleans compare as ints.
        if ld == "Z" { ld = "I"; }
        if rd == "Z" { rd = "I"; }
        // `is`/`isnt` share the ==/!= paths for scalars and strings;
        // containers compare deep via equals; anything else is false.
        op2: string = e.op;
        if op2 == "is" { op2 = "=="; }
        also op2 == "isnt" { op2 = "!="; }
        t_lbl: string = this.new_label("cmp_t");
        e_lbl: string = this.new_label("cmp_e");
        if (lt == "string" || rt == "string") && (op2 == "==" || op2 == "!=") {
            this.gen_expr(e.left);
            if ld != "Ljava/lang/String;" {
                this.jvm_tostring(lt);
            }
            this.gen_expr(e.right);
            if rd != "Ljava/lang/String;" {
                this.jvm_tostring(rt);
            }
            this.emit_invoke(JOp.INVOKESTATIC, "java/util/Objects", "equals", "(Ljava/lang/Object;Ljava/lang/Object;)Z");
            if op2 == "!=" {
                this.cur_method.op(JOp.ICONST_1, 1);
                this.cur_method.op(JOp.IXOR, -1);
            }
            return;
        }
        if op2 == "==" || op2 == "!=" {
            // `is`/`isnt` on structs/classes is constantly false/true
            // (native parity); `==`/`!=` use identity below.
            if (e.op == "is" || e.op == "isnt") && this.both_refs(ld, rd) && !this.is_vec_leash(lt) && !this.is_hash_leash(lt) && !this.is_vec_leash(rt) && !this.is_hash_leash(rt) && ld[0] != '[' {
                if e.op == "is" {
                    this.cur_method.op(JOp.ICONST_0, 1);
                } else {
                    this.cur_method.op(JOp.ICONST_1, 1);
                }
                return;
            }
            // Reference identity for ==/!= on objects (`is` keeps its
            // own constant-false semantics in the fallback below).
            // Containers and arrays compare deep in later branches.
            if (e.op == "==" || e.op == "!=") && this.both_refs(ld, rd) && !this.is_vec_leash(lt) && !this.is_hash_leash(lt) && !this.is_vec_leash(rt) && !this.is_hash_leash(rt) && ld[0] != '[' {
                this.gen_expr(e.left);
                this.gen_expr(e.right);
                if op2 == "==" {
                    this.cur_method.branch(JOp.IF_ACMPEQ, t_lbl, 2);
                } else {
                    this.cur_method.branch(JOp.IF_ACMPNE, t_lbl, 2);
                }
                this.cur_method.op(JOp.ICONST_0, 1);
                this.cur_method.branch(JOp.GOTO, e_lbl, 0);
                this.cur_method.mark(t_lbl);
                this.cur_method.op(JOp.ICONST_1, 1);
                this.cur_method.mark(e_lbl);
                return;
            }
            if ld == "D" || rd == "D" {
                this.gen_expr(e.left);
                if ld != "D" { this.jvm_coerce(lt, "float"); }
                this.gen_expr(e.right);
                if rd != "D" { this.jvm_coerce(rt, "float"); }
                this.cur_method.op(JOp.DCMPL, -3);
                if op2 == "==" {
                    this.cur_method.branch(JOp.IFEQ, t_lbl, 1);
                } else {
                    this.cur_method.branch(JOp.IFNE, t_lbl, 1);
                }
            } also ld == "J" || rd == "J" {
                this.gen_expr(e.left);
                if ld != "J" { this.jvm_coerce(lt, "int<64>"); }
                this.gen_expr(e.right);
                if rd != "J" { this.jvm_coerce(rt, "int<64>"); }
                this.cur_method.op(JOp.LCMP, -3);
                if op2 == "==" {
                    this.cur_method.branch(JOp.IFEQ, t_lbl, 1);
                } else {
                    this.cur_method.branch(JOp.IFNE, t_lbl, 1);
                }
            } else {
                if ld != "I" && ld != "Z" && rd != "I" && rd != "Z" {
                    this.jvm_unsupported("comparison '" + e.op + "' on '" + lt + "' and '" + rt + "'");
                    return;
                }
                this.gen_expr(e.left);
                this.gen_expr(e.right);
                if op2 == "==" {
                    this.cur_method.branch(JOp.IF_ICMPEQ, t_lbl, 2);
                } else {
                    this.cur_method.branch(JOp.IF_ICMPNE, t_lbl, 2);
                }
            }
            this.cur_method.op(JOp.ICONST_0, 1);
            this.cur_method.branch(JOp.GOTO, e_lbl, 0);
            this.cur_method.mark(t_lbl);
            this.cur_method.op(JOp.ICONST_1, 1);
            this.cur_method.mark(e_lbl);
            return;
        }
        // Ordered comparisons.
        if ld == "D" || rd == "D" {
            this.gen_expr(e.left);
            if ld != "D" { this.jvm_coerce(lt, "float"); }
            this.gen_expr(e.right);
            if rd != "D" { this.jvm_coerce(rt, "float"); }
            this.cur_method.op(JOp.DCMPG, -3);
            this.ordered_branch(e.op, t_lbl, e_lbl);
            return;
        }
        if ld == "J" || rd == "J" {
            if this.is_uint_leash(lt) || this.is_uint_leash(rt) {
                this.gen_expr(e.left);
                if ld != "J" { this.jvm_coerce(lt, "int<64>"); }
                this.gen_expr(e.right);
                if rd != "J" { this.jvm_coerce(rt, "int<64>"); }
                this.emit_invoke(JOp.INVOKESTATIC, "java/lang/Long", "compareUnsigned", "(JJ)I");
                this.ordered_branch(e.op, t_lbl, e_lbl);
            } else {
                this.gen_expr(e.left);
                if ld != "J" { this.jvm_coerce(lt, "int<64>"); }
                this.gen_expr(e.right);
                if rd != "J" { this.jvm_coerce(rt, "int<64>"); }
                this.cur_method.op(JOp.LCMP, -3);
                this.ordered_branch(e.op, t_lbl, e_lbl);
            }
            return;
        }
        if ld == "I" && rd == "I" {
            if this.is_uint_leash(lt) || this.is_uint_leash(rt) {
                this.gen_expr(e.left);
                this.gen_expr(e.right);
                this.emit_invoke(JOp.INVOKESTATIC, "java/lang/Integer", "compareUnsigned", "(II)I");
                this.ordered_branch(e.op, t_lbl, e_lbl);
            } else {
                this.gen_expr(e.left);
                this.gen_expr(e.right);
                this.int_ordered_branch(e.op, t_lbl, e_lbl);
            }
            return;
        }
        if (ld == "Ljava/lang/String;" || rd == "Ljava/lang/String;") && (e.op == "<" || e.op == "<=" || e.op == ">" || e.op == ">=") {
            this.jvm_unsupported("ordered comparison on strings");
            return;
        }
        // Containers compare deep via equals (native parity).
        if (ld.size > 0 && ld[0] == '[') || ld == "Ljava/util/ArrayList;" || ld == "Ljava/util/HashMap;" {
            this.gen_expr(e.left);
            this.gen_expr(e.right);
            eq_desc: string = "(Ljava/lang/Object;Ljava/lang/Object;)Z";
            eq_owner: string = "java/util/Objects";
            eq_name: string = "equals";
            if ld.size > 0 && ld[0] == '[' {
                eq_owner = "java/util/Arrays";
                eq_name = "equals";
                eq_desc = "(" + ld + rd + ")Z";
            }
            this.emit_invoke(JOp.INVOKESTATIC, eq_owner, eq_name, eq_desc);
            if op2 == "!=" {
                this.cur_method.op(JOp.ICONST_1, 1);
                this.cur_method.op(JOp.IXOR, -1);
            }
            return;
        }
        // Nil and raw pointers compare by identity; scalars against
        // nil compare against zero (native parity).
        if lt == "nil" && rt == "nil" {
            if op2 == "==" {
                this.cur_method.op(JOp.ICONST_1, 1);
            } else {
                this.cur_method.op(JOp.ICONST_0, 1);
            }
            return;
        }
        if lt == "nil" || rt == "nil" {
            other_t: string = rt;
            if lt != "nil" { other_t = lt; }
            od: string = this.jdesc(other_t);
            if other_t == lt {
                this.gen_expr(e.left);
            } else {
                this.gen_expr(e.right);
            }
            if od == "I" || od == "Z" {
                this.cur_method.op(JOp.ICONST_0, 1);
                if op2 == "==" {
                    this.cur_method.branch(JOp.IF_ICMPEQ, t_lbl, 2);
                } else {
                    this.cur_method.branch(JOp.IF_ICMPNE, t_lbl, 2);
                }
            } also od == "J" {
                this.cur_method.op(JOp.LCONST_0, 2);
                this.cur_method.op(JOp.LCMP, -3);
                if op2 == "==" {
                    this.cur_method.branch(JOp.IFEQ, t_lbl, 1);
                } else {
                    this.cur_method.branch(JOp.IFNE, t_lbl, 1);
                }
            } also od == "D" {
                this.cur_method.op(JOp.DCONST_0, 2);
                this.cur_method.op(JOp.DCMPL, -3);
                if op2 == "==" {
                    this.cur_method.branch(JOp.IFEQ, t_lbl, 1);
                } else {
                    this.cur_method.branch(JOp.IFNE, t_lbl, 1);
                }
            } else {
                if op2 == "==" {
                    this.cur_method.branch(JOp.IFNULL, t_lbl, 1);
                } else {
                    this.cur_method.branch(JOp.IFNONNULL, t_lbl, 1);
                }
            }
            this.cur_method.op(JOp.ICONST_0, 1);
            this.cur_method.branch(JOp.GOTO, e_lbl, 0);
            this.cur_method.mark(t_lbl);
            this.cur_method.op(JOp.ICONST_1, 1);
            this.cur_method.mark(e_lbl);
            return;
        }
        if (lt.size > 0 && lt[0] == '*') || (rt.size > 0 && rt[0] == '*') {
            this.gen_expr(e.left);
            this.gen_expr(e.right);
            if op2 == "==" {
                this.cur_method.branch(JOp.IF_ACMPEQ, t_lbl, 2);
            } else {
                this.cur_method.branch(JOp.IF_ACMPNE, t_lbl, 2);
            }
            this.cur_method.op(JOp.ICONST_0, 1);
            this.cur_method.branch(JOp.GOTO, e_lbl, 0);
            this.cur_method.mark(t_lbl);
            this.cur_method.op(JOp.ICONST_1, 1);
            this.cur_method.mark(e_lbl);
            return;
        }
        // Anything else (structs, classes, exotic refs): `is` is always
        // false (native parity); `==` compares reference identity.
        if e.op == "is" {
            this.cur_method.op(JOp.ICONST_0, 1);
        } also e.op == "isnt" {
            this.cur_method.op(JOp.ICONST_1, 1);
        } else {
            this.gen_expr(e.left);
            this.gen_expr(e.right);
            if op2 == "==" {
                this.cur_method.branch(JOp.IF_ACMPEQ, t_lbl, 2);
            } else {
                this.cur_method.branch(JOp.IF_ACMPNE, t_lbl, 2);
            }
            this.cur_method.op(JOp.ICONST_0, 1);
            this.cur_method.branch(JOp.GOTO, e_lbl, 0);
            this.cur_method.mark(t_lbl);
            this.cur_method.op(JOp.ICONST_1, 1);
            this.cur_method.mark(e_lbl);
        }
    }

    // ifXX on an int comparison result already on the stack.
    pub fnc ordered_branch(op string, t_lbl string, e_lbl string) : void {
        if op == "<" { this.cur_method.branch(JOp.IFLT, t_lbl, 1); }
        also op == "<=" { this.cur_method.branch(JOp.IFLE, t_lbl, 1); }
        also op == ">" { this.cur_method.branch(JOp.IFGT, t_lbl, 1); }
        also op == ">=" { this.cur_method.branch(JOp.IFGE, t_lbl, 1); }
        else {
            this.jvm_unsupported("ordered comparison '" + op + "'");
            return;
        }
        this.cur_method.op(JOp.ICONST_0, 1);
        this.cur_method.branch(JOp.GOTO, e_lbl, 0);
        this.cur_method.mark(t_lbl);
        this.cur_method.op(JOp.ICONST_1, 1);
        this.cur_method.mark(e_lbl);
    }

    // Direct integer-pair branches (no compare instruction needed).
    pub fnc int_ordered_branch(op string, t_lbl string, e_lbl string) : void {
        if op == "<" { this.cur_method.branch(JOp.IF_ICMPLT, t_lbl, 2); }
        also op == "<=" { this.cur_method.branch(JOp.IF_ICMPLE, t_lbl, 2); }
        also op == ">" { this.cur_method.branch(JOp.IF_ICMPGT, t_lbl, 2); }
        also op == ">=" { this.cur_method.branch(JOp.IF_ICMPGE, t_lbl, 2); }
        else {
            this.jvm_unsupported("ordered comparison '" + op + "'");
            return;
        }
        this.cur_method.op(JOp.ICONST_0, 1);
        this.cur_method.branch(JOp.GOTO, e_lbl, 0);
        this.cur_method.mark(t_lbl);
        this.cur_method.op(JOp.ICONST_1, 1);
        this.cur_method.mark(e_lbl);
    }

    // Short-circuit && / || over truthy values.
    pub fnc gen_logic(e Expr) : void {
        t_lbl: string = this.new_label("logic_t");
        e_lbl: string = this.new_label("logic_e");
        if e.op == "&&" {
            this.gen_truthy(e.left, e_lbl);
            this.gen_truthy(e.right, e_lbl);
            this.cur_method.op(JOp.ICONST_1, 1);
            this.cur_method.branch(JOp.GOTO, t_lbl, 0);
            this.cur_method.mark(e_lbl);
            this.cur_method.op(JOp.ICONST_0, 1);
            this.cur_method.mark(t_lbl);
        } else {
            this.gen_truthy(e.left, t_lbl);
            this.gen_truthy(e.right, t_lbl);
            this.cur_method.op(JOp.ICONST_0, 1);
            this.cur_method.branch(JOp.GOTO, e_lbl, 0);
            this.cur_method.mark(t_lbl);
            this.cur_method.op(JOp.ICONST_1, 1);
            this.cur_method.mark(e_lbl);
        }
    }

    // Branch to yes_lbl when the value is truthy (falls through else).
    pub fnc gen_truthy(arg Expr, yes_lbl string) : void {
        t: string = this.expr_type(arg);
        d: string = this.jdesc(t);
        this.gen_expr(arg);
        if d == "Z" || d == "I" {
            this.cur_method.branch(JOp.IFNE, yes_lbl, 1);
        } also d == "J" {
            this.cur_method.op(JOp.LCONST_0, 2);
            this.cur_method.op(JOp.LCMP, -3);
            this.cur_method.branch(JOp.IFNE, yes_lbl, 1);
        } also d == "D" {
            this.cur_method.op(JOp.DCONST_0, 2);
            this.cur_method.op(JOp.DCMPL, -3);
            this.cur_method.branch(JOp.IFNE, yes_lbl, 1);
        } else {
            this.cur_method.branch(JOp.IFNONNULL, yes_lbl, 1);
        }
    }

    pub fnc gen_unary(e Expr) : void {
        if e.op == "!" {
            t: string = this.expr_type(e.left);
            d: string = this.jdesc(t);
            this.gen_expr(e.left);
            if d == "J" {
                this.cur_method.op(JOp.LCONST_0, 2);
                this.cur_method.op(JOp.LCMP, -3);
            } also d == "D" {
                this.cur_method.op(JOp.DCONST_0, 2);
                this.cur_method.op(JOp.DCMPL, -3);
            }
            this.cur_method.op(JOp.ICONST_1, 1);
            this.cur_method.op(JOp.IXOR, -1);
            return;
        }
        if e.op == "++p" || e.op == "--p" || e.op == "++" || e.op == "--" {
            is_prefix: bool = e.op == "++p" || e.op == "--p";
            is_inc: bool = e.op == "++p" || e.op == "++";
            this.gen_incr_expr(e.left, is_prefix, is_inc);
            return;
        }
        if e.op == "-" {
            t: string = this.expr_type(e.left);
            d: string = this.jdesc(t);
            this.gen_expr(e.left);
            if d == "J" {
                this.cur_method.op(JOp.LNEG, 0);
            } also d == "D" {
                this.cur_method.op(JOp.DNEG, 0);
            } else {
                this.cur_method.op(JOp.INEG, 0);
                this.narrow_to(t);
            }
            return;
        }
        if e.op == "~" {
            t: string = this.expr_type(e.left);
            d: string = this.jdesc(t);
            if d != "I" && d != "J" {
                this.jvm_unsupported("unary '~' on '" + t + "'");
                return;
            }
            this.gen_expr(e.left);
            if d == "J" {
                this.long_const(-1, -1);
                this.cur_method.op(JOp.LXOR, -2);
            } else {
                this.iconst(-1);
                this.cur_method.op(JOp.IXOR, -1);
            }
            this.narrow_to(t);
            return;
        }
        if e.op == "++p" || e.op == "--p" || e.op == "++" || e.op == "--" {
            this.jvm_unsupported("inc/dec '" + e.op + "' (wiring in progress)");
            return;
        }
        this.jvm_unsupported("unary operator '" + e.op + "'");
    }

    // Inc/dec in expression position: prefix yields new, postfix old.
    // IDENT cells lower directly (fusion stays atomic); anything else
    // reads once and stores back through a synthesized assignment.
    pub fnc gen_incr_expr(t Expr, is_prefix bool, is_inc bool) : void {
        if t.kind == ExprKind.IDENT && this.var_slots.isin(t.sval) {
            vt: string = "";
            if this.var_types.isin(t.sval) { vt = this.var_types[t.sval]; }
            vd: string = this.jdesc(vt);
            slot: int = this.var_slots[t.sval];
            this.cur_method.load_local(vd, slot);
            if vd == "J" || vd == "D" {
                this.cur_method.op(JOp.DUP2, 2);
            } else {
                this.cur_method.op(JOp.DUP, 1);
            }
            if is_prefix {
                // [old] -> incr -> [new] -> dup -> store one -> yield new
                this.incr_top(vt, vd, is_inc);
                if vd == "J" || vd == "D" {
                    this.cur_method.op(JOp.DUP2, 2);
                } else {
                    this.cur_method.op(JOp.DUP, 1);
                }
                this.cur_method.store_local(vd, slot);
            } else {
                // [old] -> dup already above -> incr top -> store -> yield old
                this.incr_top(vt, vd, is_inc);
                this.cur_method.store_local(vd, slot);
            }
            return;
        }
        if t.kind == ExprKind.IDENT && !this.var_slots.isin(t.sval) && this.cg.global_vars.isin(t.sval) {
            gt: string = this.cg.global_vars[t.sval];
            gd: string = this.jdesc(gt);
            if this.is_fusion_int(t.sval, gt) {
                this.fusion_ref(t.sval, gd);
                if gd == "J" {
                    if is_inc {
                        this.long_const(0, 1);
                    } else {
                        this.long_const(0, 1);
                        this.cur_method.op(JOp.LNEG, 0);
                    }
                    this.emit_invoke(JOp.INVOKEVIRTUAL, "java/util/concurrent/atomic/AtomicLong", "getAndAdd", "(J)J");
                } else {
                    this.iconst(1);
                    if !is_inc {
                        this.cur_method.op(JOp.INEG, 0);
                    }
                    this.emit_invoke(JOp.INVOKEVIRTUAL, "java/util/concurrent/atomic/AtomicInteger", "getAndAdd", "(I)I");
                }
                if is_prefix {
                    // old -> new = old +/- 1
                    if gd == "J" {
                        if is_inc {
                            this.long_const(0, 1);
                            this.cur_method.op(JOp.LADD, -2);
                        } else {
                            this.long_const(0, 1);
                            this.cur_method.op(JOp.LSUB, -2);
                        }
                    } else {
                        this.iconst(1);
                        if is_inc {
                            this.cur_method.op(JOp.IADD, -1);
                        } else {
                            this.cur_method.op(JOp.ISUB, -1);
                        }
                        this.narrow_to(gt);
                    }
                }
                return;
            }
            // Plain global: load, dup, incr, store.
            idx: int = this.cur_cp.fieldref(this.main_class, "g_" + t.sval, gd);
            this.cur_method.emit_u8(JOp.GETSTATIC);
            this.cur_method.emit_u8((idx >> 8) & 255);
            this.cur_method.emit_u8(idx & 255);
            this.cur_method.adjust(this.slots_of(gd));
            if gd == "J" || gd == "D" {
                this.cur_method.op(JOp.DUP2, 2);
            } else {
                this.cur_method.op(JOp.DUP, 1);
            }
            if is_prefix {
                this.incr_top(gt, gd, is_inc);
                if gd == "J" || gd == "D" {
                    this.cur_method.op(JOp.DUP2, 2);
                } else {
                    this.cur_method.op(JOp.DUP, 1);
                }
                this.emit_putstatic(t.sval, gd);
            } else {
                this.incr_top(gt, gd, is_inc);
                this.emit_putstatic(t.sval, gd);
            }
            return;
        }
        // General lvalues: read once, write back through assignment.
        told: string = this.expr_type(t);
        this.gen_expr(t);
        if is_prefix {
            pf_op: string = "+";
            if !is_inc { pf_op = "-"; }
            pf_rhs: Expr = Expr.make_int(1);
            if this.is_float_desc(this.jdesc(told)) { pf_rhs = Expr.make_float(1.0); }
            sta: Stmt = Stmt.make_assign(t, "=", Expr.make_binop(pf_op, t, pf_rhs));
            this.gen_statement(sta);
            // The old value is still on top: advance it to new.
            this.incr_top(told, this.jdesc(told), is_inc);
            return;
        }
        one_e: Expr = Expr.make_int(1);
        if this.is_float_desc(this.jdesc(told)) { one_e = Expr.make_float(1.0); }
        sta2_op: string = "+";
        if !is_inc { sta2_op = "-"; }
        sta2: Stmt = Stmt.make_assign(t, "=", Expr.make_binop(sta2_op, t, one_e));
        this.gen_statement(sta2);
    }

    // old +/- 1 on the stack top (int widths narrow; 1.0 for floats).
    pub fnc incr_top(t string, d string, is_inc bool) : void {
        if d == "J" {
            if is_inc {
                this.long_const(0, 1);
                this.cur_method.op(JOp.LADD, -2);
            } else {
                this.long_const(0, 1);
                this.cur_method.op(JOp.LSUB, -2);
            }
            return;
        }
        if d == "D" {
            this.ldc_double_one();
            if is_inc {
                this.cur_method.op(JOp.DADD, -2);
            } else {
                this.cur_method.op(JOp.DSUB, -2);
            }
            return;
        }
        this.iconst(1);
        if is_inc {
            this.cur_method.op(JOp.IADD, -1);
        } else {
            this.cur_method.op(JOp.ISUB, -1);
        }
        this.narrow_to(t);
    }

    pub fnc is_float_desc(d string) : bool {
        return d == "D";
    }

    // --- Functions ----------------------------------------------------
    pub fnc method_desc(f FuncDecl) : string {
        desc: string = "(";
        foreach _, p in<vector> f.params {
            pd: string = this.jdesc(p.typ);
            if pd.size == 0 { return ""; }
            desc = desc + pd;
        }
        desc = desc + ")";
        rd: string = this.jdesc(f.ret_type);
        if rd.size == 0 { return ""; }
        desc = desc + rd;
        return desc;
    }

    pub fnc gen_function(f FuncDecl, cls JvmClass, rename string) : void {
        if f.is_worker || f.is_async {
            this.jvm_unsupported("worker/async function '" + f.name + "'");
            return;
        }
        if f.is_external {
            this.jvm_unsupported("native (@from) function '" + f.name + "'");
            return;
        }
        // Owner-bound methods: instance (this in slot 0) unless the
        // class table marks them static.
        is_method: bool = f.owner.size > 0;
        is_static: bool = true;
        if is_method {
            is_static = false;
            if this.tc.classes.isin(f.owner) {
                is_static = this.tc.classes[f.owner].is_method_static(f.name);
            }
        }
        desc: string = this.method_desc(f);
        if desc.size == 0 {
            this.jvm_unsupported("signature of '" + f.name + "'");
            return;
        }
        mname: string = f.name;
        if rename.size > 0 { mname = rename; }
        acc: int = JAcc.PUBLIC;
        if is_static { acc = acc + JAcc.STATIC; }
        m: JvmMethod = JvmMethod.make(cls.cp.utf8(mname), cls.cp.utf8(desc), acc);
        this.cur_cp = cls.cp;
        this.cur_method = m;
        this.current_class = f.owner;
        // Fresh locals per function.
        empty_vt: hash<string, string>;
        empty_vs: hash<string, int>;
        empty_cp: hash<string, string>;
        this.var_types = empty_vt;
        this.var_slots = empty_vs;
        this.cg.var_types = empty_vt;
        this.cg.var_ptrs = empty_cp;
        empty_defers: vec<Stmt>;
        this.defer_stack = empty_defers;
        empty_hh: vec<string>;
        empty_he: vec<string>;
        this.loop_heads = empty_hh;
        this.loop_exits = empty_he;
        this.current_func_ret = f.ret_type;
        this.array_base_override = "";
        if is_method && !is_static {
            tslot: int = m.alloc_local(1);
            this.define_var("this", f.owner, tslot);
        }
        foreach _, p in<vector> f.params {
            pd: string = this.jdesc(p.typ);
            slot: int = m.alloc_local(this.slots_of(pd));
            // Callers narrow arguments to parameter types (see gen_call),
            // so slots start with in-range values.
            this.define_var(p.name, p.typ, slot);
        }
        this.gen_block(f.body);
        // Fallthrough return (drains defers like the reference).
        this.drain_defers();
        rd: string = this.jdesc(f.ret_type);
        if rd == "V" {
            m.op(JOp.RETURN, 0);
        } also rd == "J" || rd == "D" {
            this.jvm_default(rd);
            if rd == "J" {
                m.op(JOp.LRETURN, -2);
            } else {
                m.op(JOp.DRETURN, -2);
            }
        } also rd == "I" || rd == "Z" || rd == "B" || rd == "S" || rd == "C" {
            m.op(JOp.ICONST_0, 1);
            m.op(JOp.IRETURN, -1);
        } else {
            m.op(JOp.ACONST_NULL, 1);
            m.op(JOp.ARETURN, -1);
        }
        if !m.finalize(cls.cp) {
            foreach _, e in<vector> m.errors {
                this.fail(e);
            }
            return;
        }
        cls.add_method(m);
    }

    pub fnc gen_program(prog Program, cls JvmClass) : void {
        this.cur_cp = cls.cp;
        // Globals become static fields (fusion integers become atomics).
        foreach _, g in<vector> prog.globals {
            this.cg.global_vars.push(g.name, g.typ);
            if g.is_fusion { this.fusion_names.push(g.name, true); }
            gd: string = this.jdesc(g.typ);
            if gd.size == 0 {
                this.jvm_unsupported("global '" + g.name + "' of type '" + g.typ + "'");
                continue;
            }
            if g.is_fusion && (gd == "I" || gd == "J") {
                acls: string = "java/util/concurrent/atomic/AtomicInteger";
                if gd == "J" { acls = "java/util/concurrent/atomic/AtomicLong"; }
                cls.add_field(JAcc.PRIVATE + JAcc.STATIC, "g_" + g.name, "L" + acls + ";");
            } else {
                if g.is_fusion {
                    this.jvm_unsupported("fusion global '" + g.name + "' of non-integer type '" + g.typ + "'");
                    continue;
                }
                cls.add_field(JAcc.PRIVATE + JAcc.STATIC, "g_" + g.name, gd);
            }
        }
        // Enum variant-name tables (for .name lookups).
        foreach _, e in<vector> prog.enums {
            cls.add_field(JAcc.PRIVATE + JAcc.STATIC, "enum_" + e.name + "_names", "[Ljava/lang/String;");
        }
        // Runtime-helper state: shared Random + program-start nanos.
        cls.add_field(JAcc.PRIVATE + JAcc.STATIC, "__rng", "Ljava/util/Random;");
        cls.add_field(JAcc.PRIVATE + JAcc.STATIC, "__t0", "J");
        this.emit_helpers(cls);
        // Structs and classes become emitted classes (fields only here;
        // methods are routed to their class below).
        foreach _, s in<vector> prog.structs {
            this.emit_struct_shell(s.name, s.fields, "java/lang/Object");
        }
        foreach _, c in<vector> prog.classes {
            if this.tc.generic_classes.isin(c.name) {
                this.jvm_unsupported("generic class '" + c.name + "' (not supported on jvm)");
                continue;
            }
            sup: string = "java/lang/Object";
            if c.parent.size > 0 { sup = c.parent; }
            this.emit_struct_shell(c.name, c.fields, sup);
        }
        // Owner-bound methods declared outside decls (fnc C.m style).
        foreach _, f in<vector> prog.funcs {
            if this.tc.generic_funcs.isin(f.name) { continue; }
            if f.name == "main" && f.owner.size == 0 { continue; }
            if f.owner.size > 0 {
                if !this.klass_idx.isin(f.owner) {
                    this.jvm_unsupported("method '" + f.name + "' of unknown '" + f.owner + "'");
                    continue;
                }
                ki: int = this.klass_idx[f.owner];
                this.gen_function(f, this.klasses.get(ki), "");
            } else {
                this.gen_function(f, cls, "");
            }
        }
        // Methods declared inside class/struct bodies.
        foreach _, c in<vector> prog.classes {
            if this.tc.generic_classes.isin(c.name) { continue; }
            if !this.klass_idx.isin(c.name) { continue; }
            ki: int = this.klass_idx[c.name];
            foreach _, m in<vector> c.methods {
                if this.tc.generic_funcs.isin(c.name + "_" + m.name) { continue; }
                m2: FuncDecl = m;
                m2.owner = c.name;
                this.gen_function(m2, this.klasses.get(ki), "");
            }
        }
        foreach _, s in<vector> prog.structs {
            if !this.klass_idx.isin(s.name) { continue; }
            ki: int = this.klass_idx[s.name];
            foreach _, m in<vector> s.methods {
                m2: FuncDecl = m;
                m2.owner = s.name;
                this.gen_function(m2, this.klasses.get(ki), "");
            }
        }
        // Entry point + global initializers.
        this.gen_entry(prog, cls);
    }

    // Emit a struct/class shell: fields + default constructor (which
    // auto-constructs container fields, mirroring local defaults).
    pub fnc emit_struct_shell(name string, fields vec<FieldDecl>, sup string) : void {
        kc: JvmClass = JvmClass.make(name, sup);
        foreach _, fd in<vector> fields {
            dd: string = this.jdesc(fd.typ);
            if dd.size == 0 {
                this.jvm_unsupported("field '" + fd.name + "' of type '" + fd.typ + "'");
                continue;
            }
            if fd.is_static {
                kc.add_field(JAcc.PUBLIC + JAcc.STATIC, fd.name, dd);
            } else {
                kc.add_field(JAcc.PUBLIC, fd.name, dd);
            }
        }
        this.klass_idx.push(name, this.klasses.size);
        this.klasses.pushb(kc);
        // Default constructor: super() + container field construction.
        this.cur_cp = kc.cp;
        init: JvmMethod = JvmMethod.make(kc.cp.utf8("<init>"), kc.cp.utf8("()V"), JAcc.PUBLIC);
        this.cur_cp = kc.cp;
        this.cur_method = init;
        init.alloc_local(1);
        this.cur_method.op(JOp.ALOAD_0, 1);
        this.emit_invoke(JOp.INVOKESPECIAL, sup, "<init>", "()V");
        foreach _, fd in<vector> fields {
            if fd.is_static { continue; }
            dd: string = this.jdesc(fd.typ);
            if dd == "Ljava/util/ArrayList;" || dd == "Ljava/util/HashMap;" {
                this.cur_method.op(JOp.ALOAD_0, 1);
                if dd == "Ljava/util/ArrayList;" {
                    this.emit_new_list();
                } else {
                    this.emit_new_map();
                }
                fi: int = kc.cp.fieldref(name, fd.name, dd);
                this.cur_method.emit_u8(JOp.PUTFIELD);
                this.cur_method.emit_u8((fi >> 8) & 255);
                this.cur_method.emit_u8(fi & 255);
                this.cur_method.adjust(-2);
            } also dd.size > 0 && dd[0] == '[' {
                n: int = this.array_size_of(fd.typ);
                if n >= 0 {
                    this.cur_method.op(JOp.ALOAD_0, 1);
                    this.emit_new_array(fd.typ, n);
                    fi: int = kc.cp.fieldref(name, fd.name, dd);
                    this.cur_method.emit_u8(JOp.PUTFIELD);
                    this.cur_method.emit_u8((fi >> 8) & 255);
                    this.cur_method.emit_u8(fi & 255);
                    this.cur_method.adjust(-2);
                }
            }
        }
        this.cur_method.op(JOp.RETURN, 0);
        if !init.finalize(kc.cp) {
            foreach _, e in<vector> init.errors {
                this.fail(e);
            }
            return;
        }
        kc.add_method(init);
    }

    // Entry `main(String[])`: runs global initializers, then the user
    // main. The user main itself is emitted as __leash_user_main (any
    // signature) so it can never clash with the entry descriptor.
    pub fnc gen_entry(prog Program, cls JvmClass) : void {
        has_main: bool = false;
        main_ret: string = "void";
        main_params: vec<string>;
        foreach _, f in<vector> prog.funcs {
            if f.name == "main" && f.owner.size == 0 {
                has_main = true;
                main_ret = f.ret_type;
                foreach _, p in<vector> f.params {
                    main_params.pushb(p.typ);
                }
            }
        }
        if !has_main {
            this.jvm_unsupported("program has no 'main' function");
            return;
        }
        this.has_entry = true;
        // Re-emit the user main under a fixed name (descriptor freedom).
        foreach _, f in<vector> prog.funcs {
            if f.name == "main" && f.owner.size == 0 {
                this.gen_function(f, cls, "__leash_user_main");
            }
        }
        m: JvmMethod = JvmMethod.make(cls.cp.utf8("main"), cls.cp.utf8("([Ljava/lang/String;)V"), JAcc.PUBLIC + JAcc.STATIC);
        this.cur_cp = cls.cp;
        this.cur_method = m;
        // Incoming argv lives in slot 0.
        m.alloc_local(1);
        // Runtime-helper state: Random + start time.
        this.cur_method.op(JOp.NEW, 1);
        rni: int = this.cur_cp.class_entry("java/util/Random");
        this.cur_method.emit_u8((rni >> 8) & 255);
        this.cur_method.emit_u8(rni & 255);
        this.cur_method.op(JOp.DUP, 1);
        this.emit_invoke(JOp.INVOKESPECIAL, "java/util/Random", "<init>", "()V");
        rfi: int = this.cur_cp.fieldref(this.main_class, "__rng", "Ljava/util/Random;");
        this.cur_method.emit_u8(JOp.PUTSTATIC);
        this.cur_method.emit_u8((rfi >> 8) & 255);
        this.cur_method.emit_u8(rfi & 255);
        this.cur_method.adjust(-1);
        this.emit_invoke(JOp.INVOKESTATIC, "java/lang/System", "nanoTime", "()J");
        tfi: int = this.cur_cp.fieldref(this.main_class, "__t0", "J");
        this.cur_method.emit_u8(JOp.PUTSTATIC);
        this.cur_method.emit_u8((tfi >> 8) & 255);
        this.cur_method.emit_u8(tfi & 255);
        this.cur_method.adjust(-2);
        // Global initializers.
        foreach _, g in<vector> prog.globals {
            gd: string = this.jdesc(g.typ);
            if gd.size == 0 { continue; }
            if g.is_fusion && (gd == "I" || gd == "J") {
                acls: string = "java/util/concurrent/atomic/AtomicInteger";
                adesc: string = "(I)V";
                if gd == "J" {
                    acls = "java/util/concurrent/atomic/AtomicLong";
                    adesc = "(J)V";
                }
                this.cur_method.op(JOp.NEW, 1);
                ni: int = this.cur_cp.class_entry(acls);
                this.cur_method.emit_u8((ni >> 8) & 255);
                this.cur_method.emit_u8(ni & 255);
                this.cur_method.op(JOp.DUP, 1);
                if g.init_val != null {
                    it: string = this.expr_type(g.init_val);
                    this.gen_expr(g.init_val);
                    this.jvm_coerce(it, g.typ);
                    this.narrow_to(g.typ);
                } else {
                    this.cur_method.op(JOp.ICONST_0, 1);
                    if gd == "J" {
                        this.cur_method.op(JOp.I2L, 1);
                    }
                }
                this.emit_invoke(JOp.INVOKESPECIAL, acls, "<init>", adesc);
                fi: int = this.cur_cp.fieldref(this.main_class, "g_" + g.name, "L" + acls + ";");
                this.cur_method.emit_u8(JOp.PUTSTATIC);
                this.cur_method.emit_u8((fi >> 8) & 255);
                this.cur_method.emit_u8(fi & 255);
                this.cur_method.adjust(-1);
                continue;
            }
            if g.init_val != null {
                it2: string = this.expr_type(g.init_val);
                this.gen_expr(g.init_val);
                if !this.coerce_val(it2, g.typ) {
                    this.jvm_coerce(it2, g.typ);
                    this.narrow_to(g.typ);
                }
            } else {
                this.jvm_default_for(g.typ);
            }
            fi2: int = this.cur_cp.fieldref(this.main_class, "g_" + g.name, gd);
            this.cur_method.emit_u8(JOp.PUTSTATIC);
            this.cur_method.emit_u8((fi2 >> 8) & 255);
            this.cur_method.emit_u8(fi2 & 255);
            this.cur_method.adjust(0 - this.slots_of(gd));
        }
        // Static field initializers (class/struct statics; same phase).
        foreach _, c in<vector> prog.classes {
            if this.tc.generic_classes.isin(c.name) { continue; }
            foreach _, fd in<vector> c.fields {
                if !fd.is_static || fd.init == null { continue; }
                sfd: string = this.jdesc(fd.typ);
                if sfd.size == 0 { continue; }
                it: string = this.expr_type(fd.init);
                this.gen_expr(fd.init);
                if !this.coerce_val(it, fd.typ) {
                    this.jvm_coerce(it, fd.typ);
                    this.narrow_to(fd.typ);
                }
                fi: int = this.cur_cp.fieldref(c.name, fd.name, sfd);
                this.cur_method.emit_u8(JOp.PUTSTATIC);
                this.cur_method.emit_u8((fi >> 8) & 255);
                this.cur_method.emit_u8(fi & 255);
                this.cur_method.adjust(0 - this.slots_of(sfd));
            }
        }
        foreach _, st in<vector> prog.structs {
            foreach _, fd in<vector> st.fields {
                if !fd.is_static || fd.init == null { continue; }
                sfd: string = this.jdesc(fd.typ);
                if sfd.size == 0 { continue; }
                it: string = this.expr_type(fd.init);
                this.gen_expr(fd.init);
                if !this.coerce_val(it, fd.typ) {
                    this.jvm_coerce(it, fd.typ);
                    this.narrow_to(fd.typ);
                }
                fi: int = this.cur_cp.fieldref(st.name, fd.name, sfd);
                this.cur_method.emit_u8(JOp.PUTSTATIC);
                this.cur_method.emit_u8((fi >> 8) & 255);
                this.cur_method.emit_u8(fi & 255);
                this.cur_method.adjust(0 - this.slots_of(sfd));
            }
        }
        // Enum variant-name tables.
        foreach _, e in<vector> prog.enums {
            names: vec<string>;
            if this.tc.enum_names.isin(e.name) {
                names = this.tc.enum_names[e.name];
            }
            this.iconst(names.size);
            stri: int = this.cur_cp.class_entry("java/lang/String");
            this.cur_method.emit_u8(JOp.ANEWARRAY);
            this.cur_method.emit_u8((stri >> 8) & 255);
            this.cur_method.emit_u8(stri & 255);
            this.cur_method.adjust(0);
            arr_slot: int = this.cur_method.alloc_local(1);
            this.cur_method.store_local("X", arr_slot);
            ni: int = 0;
            while ni < names.size {
                this.cur_method.load_local("X", arr_slot);
                this.iconst(ni);
                this.ldc_string(names.get(ni));
                this.cur_method.op(JOp.AASTORE, -3);
                ni = ni + 1;
            }
            this.cur_method.load_local("X", arr_slot);
            fi: int = this.cur_cp.fieldref(this.main_class, "enum_" + e.name + "_names", "[Ljava/lang/String;");
            this.cur_method.emit_u8(JOp.PUTSTATIC);
            this.cur_method.emit_u8((fi >> 8) & 255);
            this.cur_method.emit_u8(fi & 255);
            this.cur_method.adjust(-1);
        }
        // Dispatch to the user main.
        wants_args: bool = main_params.size == 1;
        if wants_args && main_params.get(0) != "string[]" {
            this.jvm_unsupported("main() parameters other than 'string[]'");
            return;
        }
        udesc: string = "(";
        if wants_args { udesc = udesc + "[Ljava/lang/String;"; }
        udesc = udesc + ")";
        urd: string = this.jdesc(main_ret);
        if urd.size == 0 {
            this.jvm_unsupported("main() return type '" + main_ret + "'");
            return;
        }
        udesc = udesc + urd;
        // Native argv[0] is the program name; the entry prepends the
        // class name so indices and size match (value differs by
        // invocation path even natively).
        if wants_args {
            this.cur_method.op(JOp.ALOAD_0, 1);
            this.cur_method.op(JOp.ARRAYLENGTH, 0);
            len_slot: int = this.cur_method.alloc_local(1);
            this.cur_method.store_local("I", len_slot);
            this.cur_method.load_local("I", len_slot);
            this.iconst(1);
            this.cur_method.op(JOp.IADD, -1);
            stri: int = this.cur_cp.class_entry("java/lang/String");
            this.cur_method.emit_u8(JOp.ANEWARRAY);
            this.cur_method.emit_u8((stri >> 8) & 255);
            this.cur_method.emit_u8(stri & 255);
            this.cur_method.adjust(0);
            arr_slot: int = this.cur_method.alloc_local(1);
            this.cur_method.store_local("X", arr_slot);
            this.cur_method.load_local("X", arr_slot);
            this.iconst(0);
            this.ldc_string(this.main_class);
            this.cur_method.op(JOp.AASTORE, -3);
            this.cur_method.op(JOp.ALOAD_0, 1);
            this.iconst(0);
            this.cur_method.load_local("X", arr_slot);
            this.iconst(1);
            this.cur_method.load_local("I", len_slot);
            this.emit_invoke(JOp.INVOKESTATIC, "java/lang/System", "arraycopy", "(Ljava/lang/Object;ILjava/lang/Object;II)V");
            this.cur_method.load_local("X", arr_slot);
        }
        this.emit_invoke(JOp.INVOKESTATIC, this.main_class, "__leash_user_main", udesc);
        if urd == "I" {
            this.emit_invoke(JOp.INVOKESTATIC, "java/lang/System", "exit", "(I)V");
        } else {
            if urd == "J" {
                this.cur_method.op(JOp.L2I, -1);
                this.emit_invoke(JOp.INVOKESTATIC, "java/lang/System", "exit", "(I)V");
            } else {
                if urd == "D" {
                    this.cur_method.op(JOp.POP2, -2);
                } also urd != "V" {
                    this.cur_method.op(JOp.POP, -1);
                }
            }
        }
        // Always terminate the entry: System.exit never returns but the
        // verifier still requires a reachable RETURN ("falling off the
        // end" is a VerifyError).
        this.cur_method.op(JOp.RETURN, 0);
        if !m.finalize(cls.cp) {
            foreach _, e in<vector> m.errors {
                this.fail(e);
            }
            return;
        }
        cls.add_method(m);
    }

    // Static call to a same-class function (recursion and forward
    // references resolve at JVM link time).
    pub fnc gen_call(e Expr) : void {
        fname: string = e.sval;
        if fname == "tostring" {
            this.gen_tostring_call(e);
            return;
        }
        if fname == "cstr" || fname == "toint" || fname == "tofloat" || fname == "tochar" || fname == "typeof" || fname == "sizeof" || fname == "scast" || fname == "get" || fname == "seed" || fname == "rand" || fname == "randf" || fname == "choose" || fname == "wait" || fname == "timepass" {
            this.gen_builtin(e);
            return;
        }
        if fname == "exec" || fname == "tounion" || fname == "normescape" || fname == "lstr" || fname == "inttobytes" || fname == "floattobytes" || fname == "bytestoint" || fname == "bytestofloat" {
            this.jvm_unsupported("builtin '" + fname + "' (not supported on jvm)");
            return;
        }
        if fname == "__tupget" {
            if e.args.size != 2 {
                this.jvm_unsupported("__tupget() needs 2 arguments");
                return;
            }
            this.gen_expr(e.args.get(0));
            it: string = this.expr_type(e.args.get(1));
            this.gen_expr(e.args.get(1));
            this.jvm_coerce(it, "int");
            this.cur_method.op(JOp.AALOAD, -1);
            tt: string = this.expr_type(e.args.get(0));
            tidx: int = e.args.get(1).ival;
            this.unbox_to(this.tuple_elem(tt, tidx));
            return;
        }
        if e.is_create {
            this.gen_create(e);
            return;
        }
        if !this.tc.funcs.isin(fname) {
            this.jvm_unsupported("call to unknown function '" + fname + "'");
            return;
        }
        ptypes: vec<string>;
        if this.tc.func_params.isin(fname) {
            ptypes = this.tc.func_params[fname];
        }
        desc: string = "(";
        ai: int = 0;
        while ai < e.args.size {
            pt: string = "int";
            if ai < ptypes.size { pt = ptypes.get(ai); }
            pd: string = this.jdesc(pt);
            if pd.size == 0 {
                this.jvm_unsupported("parameter type '" + pt + "'");
                return;
            }
            desc = desc + pd;
            ai = ai + 1;
        }
        desc = desc + ")";
        ret_t: string = this.tc.funcs[fname];
        rd: string = this.jdesc(ret_t);
        if rd.size == 0 {
            this.jvm_unsupported("return type '" + ret_t + "'");
            return;
        }
        desc = desc + rd;
        ai = 0;
        while ai < e.args.size {
            pt: string = "int";
            if ai < ptypes.size { pt = ptypes.get(ai); }
            at: string = this.expr_type(e.args.get(ai));
            this.gen_expr(e.args.get(ai));
            if !this.coerce_val(at, pt) {
                this.jvm_coerce(at, pt);
                this.narrow_to(pt);
            }
            ai = ai + 1;
        }
        this.emit_invoke(JOp.INVOKESTATIC, this.main_class, fname, desc);
        this.narrow_to(ret_t);
    }

    pub fnc gen_tostring_call(e Expr) : void {
        if e.args.size < 1 {
            this.jvm_unsupported("tostring() without arguments");
            return;
        }
        at: string = this.expr_type(e.args.get(0));
        this.gen_expr(e.args.get(0));
        if at == "string" { return; }
        this.jvm_tostring(at);
    }

    // Builtin calls: conversions, types, random, stdin, time.
    pub fnc gen_builtin(e Expr) : void {
        f: string = e.sval;
        if f == "typeof" {
            tn: string = "";
            if e.args.size > 0 {
                a0: Expr = e.args.get(0);
                if a0.kind == ExprKind.STRING {
                    tn = a0.sval;
                    if this.var_types.isin(tn) { tn = this.var_types[tn]; }
                } else {
                    tn = this.expr_type(a0);
                }
            }
            this.ldc_string(tn);
            return;
        }
        if f == "sizeof" {
            sz: int = 8;
            if e.args.size > 0 {
                a0: Expr = e.args.get(0);
                st: string = "";
                if a0.kind == ExprKind.STRING { st = a0.sval; }
                else { st = this.expr_type(a0); }
                sz = this.type_size_of(st);
            }
            this.iconst(sz);
            return;
        }
        if f == "cstr" {
            at: string = this.expr_type(e.args.get(0));
            this.gen_expr(e.args.get(0));
            this.jvm_coerce(at, "string");
            this.emit_invoke(JOp.INVOKEVIRTUAL, "java/lang/String", "toCharArray", "()[C");
            return;
        }
        if f == "toint" || f == "tofloat" || f == "tochar" {
            tgt: string = "";
            vidx: int = 0;
            if e.args.size == 2 {
                tgt = this.tc.resolve_type_alias(e.args.get(0).sval);
                vidx = 1;
            } else {
                if f == "toint" { tgt = "int"; }
                also f == "tofloat" { tgt = "float"; }
                else { tgt = "char"; }
            }
            at: string = this.expr_type(e.args.get(vidx));
            this.gen_expr(e.args.get(vidx));
            if at == "string" && (f == "toint" || tgt == "int" || tgt == "uint" || this.is_sized_int(tgt)) {
                this.emit_invoke(JOp.INVOKESTATIC, this.main_class, "__parse_long", "(Ljava/lang/String;)J");
                this.jvm_coerce("int<64>", tgt);
                this.narrow_to(tgt);
                return;
            }
            if at == "string" {
                this.emit_invoke(JOp.INVOKESTATIC, this.main_class, "__parse_double", "(Ljava/lang/String;)D");
                this.jvm_coerce("float", tgt);
                this.narrow_to(tgt);
                return;
            }
            this.jvm_coerce(at, tgt);
            this.narrow_to(tgt);
            return;
        }
        if f == "scast" {
            tgt: string = this.tc.resolve_type_alias(e.args.get(0).sval);
            at: string = this.expr_type(e.args.get(1));
            this.gen_expr(e.args.get(1));
            if this.gen_cast_ref(at, tgt) { return; }
            this.jvm_coerce(at, tgt);
            this.narrow_to(tgt);
            return;
        }
        if f == "get" {
            if e.args.size > 0 {
                at: string = this.expr_type(e.args.get(0));
                this.gen_expr(e.args.get(0));
                this.jvm_coerce(at, "string");
            } else {
                this.ldc_string("");
            }
            this.emit_invoke(JOp.INVOKESTATIC, this.main_class, "__stdin_line", "(Ljava/lang/String;)Ljava/lang/String;");
            return;
        }
        if f == "seed" {
            at: string = this.expr_type(e.args.get(0));
            this.gen_expr(e.args.get(0));
            this.jvm_coerce(at, "int<64>");
            this.emit_invoke(JOp.INVOKESTATIC, this.main_class, "__rand_seed", "(J)V");
            return;
        }
        if f == "rand" {
            a0: string = this.expr_type(e.args.get(0));
            this.gen_expr(e.args.get(0));
            this.jvm_coerce(a0, "int<64>");
            a1: string = this.expr_type(e.args.get(1));
            this.gen_expr(e.args.get(1));
            this.jvm_coerce(a1, "int<64>");
            this.emit_invoke(JOp.INVOKESTATIC, this.main_class, "__rand_range", "(JJ)J");
            this.cur_method.op(JOp.L2I, -1);
            return;
        }
        if f == "randf" {
            a0: string = this.expr_type(e.args.get(0));
            this.gen_expr(e.args.get(0));
            this.jvm_coerce(a0, "float");
            a1: string = this.expr_type(e.args.get(1));
            this.gen_expr(e.args.get(1));
            this.jvm_coerce(a1, "float");
            this.emit_invoke(JOp.INVOKESTATIC, this.main_class, "__randf_range", "(DD)D");
            return;
        }
        if f == "choose" {
            this.iconst(e.args.size);
            this.emit_anewarray_object(1);
            arr_slot: int = this.cur_method.alloc_local(1);
            this.cur_method.store_local("X", arr_slot);
            ai: int = 0;
            while ai < e.args.size {
                this.cur_method.load_local("X", arr_slot);
                this.iconst(ai);
                at: string = this.expr_type(e.args.get(ai));
                this.gen_expr(e.args.get(ai));
                this.jvm_coerce(at, "string");
                this.cur_method.op(JOp.AASTORE, -3);
                ai = ai + 1;
            }
            this.cur_method.load_local("X", arr_slot);
            this.emit_invoke(JOp.INVOKESTATIC, this.main_class, "__choose", "([Ljava/lang/String;)Ljava/lang/String;");
            return;
        }
        if f == "wait" {
            at: string = this.expr_type(e.args.get(0));
            this.gen_expr(e.args.get(0));
            this.jvm_coerce(at, "float");
            this.emit_invoke(JOp.INVOKESTATIC, this.main_class, "__wait_secs", "(D)V");
            return;
        }
        if f == "timepass" {
            this.emit_invoke(JOp.INVOKESTATIC, this.main_class, "__timepass", "()D");
            return;
        }
    }

    pub fnc is_sized_int(t string) : bool {
        if t == "int" || t == "uint" || t == "char" || t == "bool" { return true; }
        if t.size > 4 && t[0] == 'i' && t[1] == 'n' && t[2] == 't' && t[3] == '<' { return true; }
        if t.size > 5 && t[0] == 'u' && t[1] == 'i' && t[2] == 'n' && t[3] == 't' && t[4] == '<' { return true; }
        if t == "int64" || t == "uint64" { return true; }
        return false;
    }

    pub fnc type_size_of(t string) : int {
        if this.tc.unions.isin(t) { return 16; }
        if t == "int" { return 4; }
        if t == "char" { return 1; }
        if t == "bool" { return 1; }
        return 8;
    }

    // create Class(): zeroed instance (field defaults do NOT apply,
    // matching the native backend; container fields auto-construct).
    pub fnc gen_create(e Expr) : void {
        cname: string = e.sval;
        if !this.klass_idx.isin(cname) {
            this.jvm_unsupported("create of unknown '" + cname + "'");
            return;
        }
        if e.args.size > 0 {
            this.jvm_unsupported("create with arguments (native classes have no constructors)");
            return;
        }
        this.cur_method.op(JOp.NEW, 1);
        ni: int = this.cur_cp.class_entry(cname);
        this.cur_method.emit_u8((ni >> 8) & 255);
        this.cur_method.emit_u8(ni & 255);
        this.cur_method.op(JOp.DUP, 1);
        this.emit_invoke(JOp.INVOKESPECIAL, cname, "<init>", "()V");
    }

    // Struct/class literal: NEW + per-field PUTFIELD (the typechecker
    // rejects missing fields, so every field is assigned).
    pub fnc gen_struct_init(e Expr) : void {
        cname: string = e.sval;
        if !this.klass_idx.isin(cname) {
            this.jvm_unsupported("construction of unknown '" + cname + "'");
            return;
        }
        this.cur_method.op(JOp.NEW, 1);
        ni: int = this.cur_cp.class_entry(cname);
        this.cur_method.emit_u8((ni >> 8) & 255);
        this.cur_method.emit_u8(ni & 255);
        this.cur_method.op(JOp.DUP, 1);
        this.emit_invoke(JOp.INVOKESPECIAL, cname, "<init>", "()V");
        ai: int = 0;
        while ai < e.args.size {
            fn: string = "";
            if ai < e.field_names.size { fn = e.field_names.get(ai); }
            ft: string = this.struct_field_type(cname, fn);
            if ft.size == 0 {
                this.jvm_unsupported("field '" + fn + "' of '" + cname + "'");
                return;
            }
            fd: string = this.jdesc(ft);
            this.cur_method.op(JOp.DUP, 1);
            at: string = this.expr_type(e.args.get(ai));
            this.gen_expr(e.args.get(ai));
            if !this.coerce_val(at, ft) {
                this.jvm_coerce(at, ft);
                this.narrow_to(ft);
            }
            fi: int = this.cur_cp.fieldref(cname, fn, fd);
            this.cur_method.emit_u8(JOp.PUTFIELD);
            this.cur_method.emit_u8((fi >> 8) & 255);
            this.cur_method.emit_u8(fi & 255);
            if fd == "J" || fd == "D" {
                this.cur_method.adjust(-3);
            } else {
                this.cur_method.adjust(-2);
            }
            ai = ai + 1;
        }
    }

    // Field type from the struct/class tables (walks parents).
    pub fnc struct_field_type(cname string, fn string) : string {
        if this.tc.structs.isin(cname) {
            return this.tc.structs[cname].get_field_type(fn);
        }
        owner: string = cname;
        g: int = 0;
        while this.tc.classes.isin(owner) && g < 16 {
            ft: string = this.tc.classes[owner].get_field_type(fn);
            if ft.size > 0 { return ft; }
            // Static fields live in a side table.
            if this.tc.static_fields.isin(owner + "_" + fn) {
                return this.tc.static_fields[owner + "_" + fn];
            }
            p: string = this.tc.classes[owner].parent;
            if p.size == 0 { stop; }
            owner = p;
            g = g + 1;
        }
        return "";
    }

    // --- Containers (vec -> ArrayList, hash -> HashMap) ------------------
    // The runtime hash is string-keyed like the native backend: every key
    // normalizes to its native stringification (int %lld, uint %llu,
    // float %.17g, bool "1"/"0", char code point, strings as-is).

    pub fnc hash_val_type(t string) : string {
        if t.size <= 7 { return "int"; }
        depth: int = 0;
        i: int = 5;
        while i < t.size {
            c: char = t[i];
            if c == '<' { depth = depth + 1; }
            also c == '>' { depth = depth - 1; }
            also c == ',' && depth == 0 {
                i = i + 1;
                while i < t.size && t[i] == ' ' { i = i + 1; }
                val_t: string = "";
                while i < t.size - 1 {
                    val_t = val_t + t[i];
                    i = i + 1;
                }
                return val_t;
            }
            i = i + 1;
        }
        return "int";
    }

    pub fnc hash_key_type(t string) : string {
        if t.size <= 7 { return "int"; }
        depth: int = 1;
        i: int = 5;
        key_t: string = "";
        while i < t.size {
            c: char = t[i];
            if c == '<' { depth = depth + 1; }
            also c == '>' { depth = depth - 1; }
            also c == ',' && depth == 1 {
                return key_t;
            }
            key_t = key_t + c;
            i = i + 1;
        }
        return "int";
    }

    // JVM-side method result types (fills the shared oracle's gaps).
    pub fnc mcall_type(obj_t string, m string) : string {
        if obj_t == "string" {
            if m == "replace" { return "string"; }
            if m == "size" { return "int"; }
            return "";
        }
        if this.is_vec_leash(obj_t) {
            inner: string = this.vec_inner_type(obj_t);
            if m == "get" || m == "popb" || m == "popf" { return inner; }
            if m == "size" { return "int"; }
            if m == "isin" { return "bool"; }
            if m == "pushb" || m == "pushf" || m == "set" || m == "remove" || m == "clear" || m == "extend" || m == "insert" { return "void"; }
            return "";
        }
        if this.is_hash_leash(obj_t) {
            vt: string = this.hash_val_type(obj_t);
            if m == "get" { return vt; }
            if m == "keys" { return "vec<string>"; }
            if m == "values" { return "vec<" + vt + ">"; }
            if m == "getKey" { return "string"; }
            if m == "size" { return "int"; }
            if m == "isin" { return "bool"; }
            if m == "push" || m == "delete" { return "void"; }
            return "";
        }
        return "";
    }

    // Box the stack top for container storage. Unsigned 32-bit widens to
    // Long (zero-extended) so display and equality stay unsigned.
    pub fnc box_for(t string) : void {
        d: string = this.jdesc(t);
        if d == "I" {
            if t == "uint" || t == "uint<32>" {
                this.cur_method.op(JOp.I2L, 1);
                this.long_const(0, 0 - 1);
                this.cur_method.op(JOp.LAND, -2);
                this.emit_invoke(JOp.INVOKESTATIC, "java/lang/Long", "valueOf", "(J)Ljava/lang/Long;");
            } also t == "char" {
                this.cur_method.op(JOp.I2C, 0);
                this.emit_invoke(JOp.INVOKESTATIC, "java/lang/Character", "valueOf", "(C)Ljava/lang/Character;");
            } else {
                this.emit_invoke(JOp.INVOKESTATIC, "java/lang/Integer", "valueOf", "(I)Ljava/lang/Integer;");
            }
            return;
        }
        if d == "J" {
            this.emit_invoke(JOp.INVOKESTATIC, "java/lang/Long", "valueOf", "(J)Ljava/lang/Long;");
            return;
        }
        if d == "D" {
            this.emit_invoke(JOp.INVOKESTATIC, "java/lang/Double", "valueOf", "(D)Ljava/lang/Double;");
            return;
        }
        if d == "Z" {
            this.emit_invoke(JOp.INVOKESTATIC, "java/lang/Boolean", "valueOf", "(Z)Ljava/lang/Boolean;");
            return;
        }
        // Strings, lists, maps, arrays, struct refs: already references.
    }

    // Checkcast + unbox the stack top (an Object) to a leash value.
    pub fnc unbox_to(t string) : void {
        d: string = this.jdesc(t);
        if d == "I" {
            if t == "uint" || t == "uint<32>" {
                this.emit_checkcast("java/lang/Long");
                this.emit_invoke(JOp.INVOKEVIRTUAL, "java/lang/Long", "longValue", "()J");
                this.cur_method.op(JOp.L2I, -1);
            } also t == "char" {
                this.emit_checkcast("java/lang/Character");
                this.emit_invoke(JOp.INVOKEVIRTUAL, "java/lang/Character", "charValue", "()C");
            } else {
                this.emit_checkcast("java/lang/Integer");
                this.emit_invoke(JOp.INVOKEVIRTUAL, "java/lang/Integer", "intValue", "()I");
            }
            this.narrow_to(t);
            return;
        }
        if d == "J" {
            this.emit_checkcast("java/lang/Long");
            this.emit_invoke(JOp.INVOKEVIRTUAL, "java/lang/Long", "longValue", "()J");
            return;
        }
        if d == "D" {
            this.emit_checkcast("java/lang/Double");
            this.emit_invoke(JOp.INVOKEVIRTUAL, "java/lang/Double", "doubleValue", "()D");
            return;
        }
        if d == "Z" {
            this.emit_checkcast("java/lang/Boolean");
            this.emit_invoke(JOp.INVOKEVIRTUAL, "java/lang/Boolean", "booleanValue", "()Z");
            return;
        }
        if d == "Ljava/lang/String;" {
            this.emit_checkcast("java/lang/String");
            return;
        }
        if d == "Ljava/util/ArrayList;" {
            this.emit_checkcast("java/util/ArrayList");
            return;
        }
        if d == "Ljava/util/HashMap;" {
            this.emit_checkcast("java/util/HashMap");
            return;
        }
        if d.size > 0 && d[0] == '[' {
            this.emit_checkcast_ref(d);
            return;
        }
        if d.size > 0 && d[0] == 'L' {
            cls: string = "";
            i: int = 1;
            while i < d.size - 1 {
                cls = cls + d[i];
                i = i + 1;
            }
            this.emit_checkcast(cls);
            return;
        }
    }

    pub fnc emit_checkcast(cls string) : void {
        idx: int = this.cur_cp.class_entry(cls);
        this.cur_method.emit_u8(JOp.CHECKCAST);
        this.cur_method.emit_u8((idx >> 8) & 255);
        this.cur_method.emit_u8(idx & 255);
    }

    pub fnc emit_checkcast_ref(desc string) : void {
        inner: string = "";
        i: int = 1;
        while i < desc.size {
            inner = inner + desc[i];
            i = i + 1;
        }
        idx: int = this.cur_cp.class_entry("[" + inner);
        this.cur_method.emit_u8(JOp.CHECKCAST);
        this.cur_method.emit_u8((idx >> 8) & 255);
        this.cur_method.emit_u8(idx & 255);
    }

    // Normalize the stack top to a hash-key String (native parity:
    // float %.17g with Locale.ROOT, bool "1"/"0", char code point).
    pub fnc gen_hashkey(kt string) : void {
        kd: string = this.jdesc(kt);
        if kd == "Ljava/lang/String;" { return; }
        if kd == "I" {
            if this.is_uint_leash(kt) {
                this.emit_invoke(JOp.INVOKESTATIC, "java/lang/Integer", "toUnsignedString", "(I)Ljava/lang/String;");
            } else {
                this.emit_invoke(JOp.INVOKESTATIC, "java/lang/Integer", "toString", "(I)Ljava/lang/String;");
            }
            return;
        }
        if kd == "J" {
            if this.is_uint_leash(kt) {
                this.emit_invoke(JOp.INVOKESTATIC, "java/lang/Long", "toUnsignedString", "(J)Ljava/lang/String;");
            } else {
                this.emit_invoke(JOp.INVOKESTATIC, "java/lang/Long", "toString", "(J)Ljava/lang/String;");
            }
            return;
        }
        if kd == "D" {
            this.box_top("D");
            tslot: int = this.cur_method.temp_slot("Ljava/lang/Object;");
            this.cur_method.store_local("Ljava/lang/Object;", tslot);
            this.emit_locale_root();
            this.ldc_string("%.17g");
            this.iconst(1);
            this.emit_anewarray_object(1);
            this.cur_method.op(JOp.DUP, 1);
            this.iconst(0);
            this.cur_method.load_local("Ljava/lang/Object;", tslot);
            this.cur_method.op(JOp.AASTORE, -3);
            this.emit_invoke(JOp.INVOKESTATIC, "java/lang/String", "format", "(Ljava/util/Locale;Ljava/lang/String;[Ljava/lang/Object;)Ljava/lang/String;");
            return;
        }
        if kd == "Z" {
            f_lbl: string = this.new_label("hk_f");
            e_lbl: string = this.new_label("hk_e");
            this.cur_method.branch(JOp.IFEQ, f_lbl, 1);
            this.ldc_string("1");
            this.cur_method.branch(JOp.GOTO, e_lbl, 0);
            this.cur_method.mark(f_lbl);
            this.ldc_string("0");
            this.cur_method.mark(e_lbl);
            return;
        }
        this.jvm_unsupported("hash key of type '" + kt + "'");
    }

    // Abort with a message on stdout + exit(1) (reference parity).
    // The stack must be empty on entry.
    pub fnc emit_abort(msg string) : void {
        this.emit_getstatic_out();
        this.ldc_string(msg);
        this.emit_invoke(JOp.INVOKEVIRTUAL, "java/io/PrintStream", "print", "(Ljava/lang/String;)V");
        this.iconst(1);
        this.emit_invoke(JOp.INVOKESTATIC, "java/lang/System", "exit", "(I)V");
    }

    // --- Member / index / method calls --------------------------------

    pub fnc gen_member(e Expr) : void {
        // ClassName.field: static field access.
        if e.left != null && e.left.kind == ExprKind.IDENT {
            ln: string = e.left.sval;
            if (this.tc.classes.isin(ln) || this.tc.structs.isin(ln)) && this.tc.static_fields.isin(ln + "_" + e.sval) {
                ft: string = this.tc.static_fields[ln + "_" + e.sval];
                fd: string = this.jdesc(ft);
                if fd.size == 0 {
                    this.jvm_unsupported("static field type '" + ft + "'");
                    return;
                }
                idx: int = this.cur_cp.fieldref(ln, e.sval, fd);
                this.cur_method.emit_u8(JOp.GETSTATIC);
                this.cur_method.emit_u8((idx >> 8) & 255);
                this.cur_method.emit_u8(idx & 255);
                this.cur_method.adjust(this.slots_of(fd));
                return;
            }
        }
        obj_t: string = this.expr_type(e.left);
        if e.sval == "size" {
            if obj_t == "string" {
                this.gen_expr(e.left);
                this.emit_invoke(JOp.INVOKEVIRTUAL, "java/lang/String", "length", "()I");
                return;
            }
            if this.is_vec_leash(obj_t) {
                this.gen_expr(e.left);
                this.emit_invoke(JOp.INVOKEVIRTUAL, "java/util/ArrayList", "size", "()I");
                return;
            }
            if this.is_hash_leash(obj_t) {
                this.gen_expr(e.left);
                this.emit_invoke(JOp.INVOKEVIRTUAL, "java/util/HashMap", "size", "()I");
                return;
            }
            od: string = this.jdesc(obj_t);
            if od.size > 0 && od[0] == '[' {
                this.gen_expr(e.left);
                this.cur_method.op(JOp.ARRAYLENGTH, 0);
                return;
            }
        }
        if this.tc.structs.isin(obj_t) || this.tc.classes.isin(obj_t) {
            // this.x where x is a static: static access (native parity).
            if e.left != null && e.left.kind == ExprKind.IDENT && e.left.sval == "this" && this.current_class.size > 0 && this.tc.static_fields.isin(this.current_class + "_" + e.sval) {
                ft: string = this.tc.static_fields[this.current_class + "_" + e.sval];
                fd: string = this.jdesc(ft);
                if fd.size == 0 {
                    this.jvm_unsupported("static field type '" + ft + "'");
                    return;
                }
                idx: int = this.cur_cp.fieldref(this.current_class, e.sval, fd);
                this.cur_method.emit_u8(JOp.GETSTATIC);
                this.cur_method.emit_u8((idx >> 8) & 255);
                this.cur_method.emit_u8(idx & 255);
                this.cur_method.adjust(this.slots_of(fd));
                return;
            }
            ft: string = this.struct_field_type(obj_t, e.sval);
            if ft.size == 0 {
                this.jvm_unsupported("field '" + e.sval + "' of '" + obj_t + "'");
                return;
            }
            fd: string = this.jdesc(ft);
            if fd.size == 0 {
                this.jvm_unsupported("field type '" + ft + "'");
                return;
            }
            this.gen_expr(e.left);
            idx: int = this.cur_cp.fieldref(obj_t, e.sval, fd);
            this.cur_method.emit_u8(JOp.GETFIELD);
            this.cur_method.emit_u8((idx >> 8) & 255);
            this.cur_method.emit_u8(idx & 255);
            this.cur_method.adjust(this.slots_of(fd) - 1);
            return;
        }
        if this.tc.enums.isin(obj_t) {
            if e.sval == "name" {
                // Variant name lookup (native indexes a names array).
                this.gen_expr(e.left);
                val_slot: int = this.cur_method.alloc_local(1);
                this.cur_method.store_local("I", val_slot);
                idx: int = this.cur_cp.fieldref(this.main_class, "enum_" + obj_t + "_names", "[Ljava/lang/String;");
                this.cur_method.emit_u8(JOp.GETSTATIC);
                this.cur_method.emit_u8((idx >> 8) & 255);
                this.cur_method.emit_u8(idx & 255);
                this.cur_method.adjust(1);
                this.cur_method.load_local("I", val_slot);
