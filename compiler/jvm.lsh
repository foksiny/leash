    // Bounds for insert: negative wraps, 0 <= idx <= size.
    pub fnc gen_vec_bounds_insert(list_slot int, idx_slot int) : void {
        wrap_lbl: string = this.new_label("ins_wrap");
        ok_lbl: string = this.new_label("ins_ok");
        fail_lbl: string = this.new_label("ins_fail");
        this.cur_method.load_local("I", idx_slot);
