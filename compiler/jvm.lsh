            dn: string = this.new_label("gk_done");
            this.cur_method.mark(lp);
            this.cur_method.load_local("X", it);
            this.emit_invoke(JOp.INVOKEINTERFACE, "java/util/Iterator", "hasNext", "()Z");
            this.cur_method.branch(JOp.IFEQ, dn, 1);
            this.cur_method.load_local("X", it);
            this.emit_invoke(JOp.INVOKEINTERFACE, "java/util/Iterator", "next", "()Ljava/lang/Object;");
            this.emit_checkcast("java/util/Map$Entry");
            en: int = this.cur_method.alloc_local(1);
            this.cur_method.store_local("X", en);
            this.cur_method.load_local("X", en);
            this.emit_invoke(JOp.INVOKEINTERFACE, "java/util/Map$Entry", "getValue", "()Ljava/lang/Object;");
            this.cur_method.load_local("X", bv);
            this.emit_invoke(JOp.INVOKESTATIC, "java/util/Objects", "equals", "(Ljava/lang/Object;Ljava/lang/Object;)Z");
            this.cur_method.branch(JOp.IFEQ, lp, 1);
            this.cur_method.load_local("X", en);
            this.emit_invoke(JOp.INVOKEINTERFACE, "java/util/Map$Entry", "getKey", "()Ljava/lang/Object;");
            this.emit_checkcast("java/lang/String");
            this.cur_method.store_local("Ljava/lang/String;", res);
            this.iconst(1);
            this.cur_method.store_local("I", fd2);
            this.cur_method.branch(JOp.GOTO, dn, 0);
            this.cur_method.mark(dn);
            have: string = this.new_label("gk_have");
            fin: string = this.new_label("gk_fin");
            this.cur_method.load_local("I", fd2);
            this.cur_method.branch(JOp.IFNE, have, 1);
            this.ldc_string("");
            this.cur_method.branch(JOp.GOTO, fin, 0);
            this.cur_method.mark(have);
            this.cur_method.load_local("Ljava/lang/String;", res);
            this.cur_method.mark(fin);
            return;
        }
        this.jvm_unsupported("hash method '" + m + "'");
    }

    // Null-safe unbox of a possibly-null reference on the stack top:
    // DUP + IFNULL keeps checkcast on the fallthrough path (checkcast
    // as a branch target breaks HotSpot's old-verifier inference).
    pub fnc gen_unbox_or_default(vt string) : void {
        null_lbl: string = this.new_label("hx_null");
        end_lbl: string = this.new_label("hx_end");
        this.cur_method.op(JOp.DUP, 1);
        this.cur_method.branch(JOp.IFNULL, null_lbl, 1);
        this.unbox_to(vt);
        this.cur_method.branch(JOp.GOTO, end_lbl, 0);
        this.cur_method.mark(null_lbl);
        this.cur_method.op(JOp.POP, -1);
        vd: string = this.jdesc(vt);
        if vd == "I" || vd == "Z" || vd == "J" || vd == "D" {
            this.jvm_default(vd);
        } else {
            this.cur_method.op(JOp.ACONST_NULL, 1);
        }
        this.cur_method.mark(end_lbl);
    }

    // throw Name(args): print "\nRuntime error: [Name] msg\n  --> file:line:col\n"
    // then exit(1). No unwinding: defers are skipped (native parity).
    pub fnc gen_throw(s Stmt) : void {
        call: Expr = Expr.make_call("_error_" + s.name, s.args);
        this.gen_expr(call);
        msg_slot: int = this.cur_method.alloc_local(1);
        this.cur_method.store_local("X", msg_slot);
        this.ldc_string("[" + s.name + "] ");
        this.cur_method.load_local("X", msg_slot);
        this.emit_invoke(JOp.INVOKEVIRTUAL, "java/lang/String", "concat", "(Ljava/lang/String;)Ljava/lang/String;");
        full_slot: int = this.cur_method.alloc_local(1);
        this.cur_method.store_local("X", full_slot);
        this.print_lit("\nRuntime error: ");
        this.emit_getstatic_out();
        this.cur_method.load_local("X", full_slot);
        this.emit_invoke_print("Ljava/lang/String;");
        this.print_lit("\n  --> ");
        this.emit_getstatic_out();
        this.ldc_string(this.src_file);
        this.emit_invoke_print("Ljava/lang/String;");
        this.print_lit(":");
        this.emit_getstatic_out();
        this.iconst(s.line);
        this.emit_invoke_print("I");
        this.print_lit(":");
        this.emit_getstatic_out();
        this.iconst(s.col - 1);
        this.emit_invoke_print("I");
        this.print_lit("\n");
        this.iconst(1);
        this.emit_invoke(JOp.INVOKESTATIC, "java/lang/System", "exit", "(I)V");
    }

    // print a literal line piece (complete statement, empty stack).
    pub fnc print_lit(msg string) : void {
        this.emit_getstatic_out();
        this.ldc_string(msg);
        this.emit_invoke_print("Ljava/lang/String;");
    }

    // switch: sequential equality dispatch (no fallthrough; each live
    // case jumps to end). Strings compare by content.
    pub fnc gen_switch(s Stmt) : void {
        sw_t: string = this.expr_type(s.value);
        sw_d: string = this.jdesc(sw_t);
        if sw_d != "I" && sw_d != "Z" && sw_d != "J" && sw_d != "D" && sw_d != "Ljava/lang/String;" {
            this.jvm_unsupported("switch on '" + sw_t + "'");
            return;
        }
        this.gen_expr(s.value);
        sw_slot: int = this.cur_method.alloc_local(2);
        this.cur_method.store_local(sw_d, sw_slot);
        end_lbl: string = this.new_label("sw_end");
        ci: int = 0;
        while ci < s.switch_cases.size {
            cst: Stmt = s.switch_cases.get(ci);
            if cst.value != null {
                next_lbl: string = this.new_label("sw_next");
                body_lbl: string = this.new_label("sw_body");
                ct: string = this.expr_type(cst.value);
                this.gen_expr(cst.value);
                this.jvm_coerce(ct, sw_t);
                // Spill case first, then push [sw, case] for the compare.
                c_slot: int = this.cur_method.alloc_local(2);
                this.cur_method.store_local(sw_d, c_slot);
                this.cur_method.load_local(sw_d, sw_slot);
                this.cur_method.load_local(sw_d, c_slot);
                if sw_d == "Ljava/lang/String;" {
                    this.emit_invoke(JOp.INVOKESTATIC, "java/util/Objects", "equals", "(Ljava/lang/Object;Ljava/lang/Object;)Z");
                    this.cur_method.branch(JOp.IFEQ, next_lbl, 1);
                } also sw_d == "J" {
                    this.cur_method.op(JOp.LCMP, -3);
                    this.cur_method.branch(JOp.IFNE, next_lbl, 1);
                } also sw_d == "D" {
                    this.cur_method.op(JOp.DCMPL, -3);
                    this.cur_method.branch(JOp.IFNE, next_lbl, 1);
                } else {
                    this.cur_method.branch(JOp.IF_ICMPNE, next_lbl, 2);
                }
                this.cur_method.mark(body_lbl);
                this.gen_block(cst.body);
                this.cur_method.branch(JOp.GOTO, end_lbl, 0);
                this.cur_method.mark(next_lbl);
            }
            ci = ci + 1;
        }
        this.gen_block(s.default_block);
        this.cur_method.mark(end_lbl);
    }

    pub fnc gen_cast(e Expr) : void {
        from_t: string = this.expr_type(e.left);
        to_t: string = e.sval;
        if from_t == to_t {
            this.gen_expr(e.left);
            return;
        }
        if e.left != null && e.left.kind == ExprKind.ARRAY_LIT && e.left.args.size == 0 && this.is_vec_leash(to_t) {
            // Empty literal: emit the empty list directly (before the
            // array is ever created).
            this.emit_new_list();
            return;
        }
        this.gen_expr(e.left);
        if to_t == "string" {
            if from_t == "string" { return; }
            this.jvm_tostring(from_t);
            return;
        }
        if to_t == "bool" {
            // Zero (incl. 0.0 and null) is false, everything else true.
            fd: string = this.jdesc(from_t);
            t_lbl: string = this.new_label("cast_t");
            e_lbl: string = this.new_label("cast_e");
            if fd == "J" {
                this.cur_method.op(JOp.LCONST_0, 2);
                this.cur_method.op(JOp.LCMP, -3);
                this.cur_method.branch(JOp.IFNE, t_lbl, 1);
            } also fd == "D" {
                this.cur_method.op(JOp.DCONST_0, 2);
                this.cur_method.op(JOp.DCMPL, -3);
                this.cur_method.branch(JOp.IFNE, t_lbl, 1);
            } also fd == "I" || fd == "Z" {
                this.cur_method.branch(JOp.IFNE, t_lbl, 1);
            } else {
                this.cur_method.branch(JOp.IFNONNULL, t_lbl, 1);
            }
            this.cur_method.op(JOp.ICONST_0, 1);
            this.cur_method.branch(JOp.GOTO, e_lbl, 0);
            this.cur_method.mark(t_lbl);
            this.cur_method.op(JOp.ICONST_1, 1);
            this.cur_method.mark(e_lbl);
            return;
        }
        fd0: string = this.jdesc(from_t);
        if fd0.size > 0 && fd0[0] == '[' && this.is_vec_leash(to_t) {
            this.gen_cast_array_to_vec(fd0, to_t);
            return;
        }
        if this.gen_cast_ref(from_t, to_t) { return; }
        this.jvm_coerce(from_t, to_t);
        this.narrow_to(to_t);
    }

    // Box a loaded array element for the target container inner type.
    // Every emitted shape must verify (mismatched element types cannot
    // occur; empty arrays never execute the body).
    // Entry: [elem] loaded per fe's kind. Exit: [Object].
    // char[] -> String. Entry: [C]. Exit: [String].
    pub fnc emit_string_from_chars() : void {
        cs: int = this.cur_method.alloc_local(1);
        this.cur_method.store_local("X", cs);
        this.cur_method.op(JOp.NEW, 1);
        si: int = this.cur_cp.class_entry("java/lang/String");
        this.cur_method.emit_u8((si >> 8) & 255);
        this.cur_method.emit_u8(si & 255);
        this.cur_method.op(JOp.DUP, 1);
        this.cur_method.load_local("X", cs);
        this.emit_invoke(JOp.INVOKESPECIAL, "java/lang/String", "<init>", "([C)V");
    }

    pub fnc emit_box_array_elem(from_d string, inner string) : void {
        if from_d != "[I" && from_d != "[J" && from_d != "[D" && from_d != "[Z" && from_d != "[B" && from_d != "[S" && from_d != "[C" {
            // Reference array: elements are already Objects.
            return;
        }
        fe: string = "int";
        if from_d == "[J" { fe = "int<64>"; }
        also from_d == "[D" { fe = "float"; }
        also from_d == "[Z" { fe = "bool"; }
        also from_d == "[C" { fe = "char"; }
        fd_e: string = this.jdesc(fe);
        id_in: string = this.jdesc(inner);
        if (fd_e == "I" || fd_e == "J" || fd_e == "D") && (id_in == "I" || id_in == "J" || id_in == "D") {
            this.jvm_coerce(fe, inner);
            this.narrow_to(inner);
            this.box_for(inner);
        } also fe == "bool" && inner == "bool" {
            this.box_for(inner);
        } also fe == "char" && inner == "char" {
            this.narrow_to(inner);
            this.box_for(inner);
        } else {
            this.box_for(fe);
        }
    }

    // Java array -> vec<T>: element-wise copy into a new ArrayList
    // (a CHECKCAST would throw: [I is not an ArrayList).
    // Entry: [arr] on the stack. Exit: [list].
    pub fnc gen_cast_array_to_vec(from_d string, to_t string) : void {
        inner: string = this.vec_inner_type(to_t);
        arr_slot: int = this.cur_method.alloc_local(1);
        this.cur_method.store_local("X", arr_slot);
        this.emit_new_list();
        list_slot: int = this.cur_method.alloc_local(1);
        this.cur_method.store_local("X", list_slot);
        this.cur_method.load_local("X", arr_slot);
        this.cur_method.op(JOp.ARRAYLENGTH, 0);
        n_slot: int = this.cur_method.alloc_local(1);
        this.cur_method.store_local("I", n_slot);
        this.iconst(0);
        i_slot: int = this.cur_method.alloc_local(1);
        this.cur_method.store_local("I", i_slot);
        loop_lbl: string = this.new_label("cav_loop");
        end_lbl: string = this.new_label("cav_end");
        this.cur_method.mark(loop_lbl);
        this.cur_method.load_local("I", i_slot);
        this.cur_method.load_local("I", n_slot);
        this.cur_method.branch(JOp.IF_ICMPGE, end_lbl, 2);
        this.cur_method.load_local("X", list_slot);
        this.cur_method.load_local("X", arr_slot);
        this.cur_method.load_local("I", i_slot);
        if from_d == "[I" {
            this.cur_method.op(JOp.IALOAD, -1);
        } also from_d == "[J" {
            this.cur_method.op(JOp.LALOAD, 0);
        } also from_d == "[D" {
            this.cur_method.op(JOp.DALOAD, 0);
        } also from_d == "[Z" || from_d == "[B" {
            this.cur_method.op(JOp.BALOAD, -1);
        } also from_d == "[S" {
            this.cur_method.op(JOp.SALOAD, -1);
        } also from_d == "[C" {
            this.cur_method.op(JOp.CALOAD, -1);
        } else {
            this.cur_method.op(JOp.AALOAD, -1);
        }
        // Verifier-safe conversion: every emitted shape must typecheck
        // even though mismatched element types cannot occur (the
        // typechecker rejects them; empty arrays never execute the body).
        this.emit_box_array_elem(from_d, inner);
        this.emit_invoke(JOp.INVOKEVIRTUAL, "java/util/ArrayList", "add", "(Ljava/lang/Object;)Z");
        this.cur_method.op(JOp.POP, -1);
        this.cur_method.load_local("I", i_slot);
        this.iconst(1);
        this.cur_method.op(JOp.IADD, -1);
        this.cur_method.store_local("I", i_slot);
        this.cur_method.branch(JOp.GOTO, loop_lbl, 0);
        this.cur_method.mark(end_lbl);
        this.cur_method.load_local("X", list_slot);
    }

    // ===================== Unions on the JVM =====================
    // Representation: Object[]{ Integer tag, Object payload }.
    // Numeric payloads are always Long (ints widened, doubles stored as
    // raw long bits so int64<->double reinterpretation works exactly
    // like the native shared-bytes payload); all other variants store
    // references as-is. The tag check aborts exactly like native
    // (message on stdout, exit 1).

    pub fnc union_is_numeric(vt string) : bool {
        d: string = this.jdesc(vt);
        if d == "I" || d == "J" || d == "D" || d == "Z" { return true; }
        if this.is_sized_int(vt) { return true; }
        return false;
    }

    pub fnc union_variant_idx(uname string, vname string) : int {
        return this.tc.union_variant_index(uname, vname);
    }

    pub fnc union_variant_type(uname string, idx int) : string {
        return this.tc.union_variant_type(uname, idx);
    }

    pub fnc union_count(uname string) : int {
        if !this.tc.union_names.isin(uname) { return 0; }
        names: vec<string> = this.tc.union_names[uname];
        return names.size;
    }

    // Variant selection mirroring native union_auto_store: exact
    // type-name match, descriptor match, int family first, float first.
    pub fnc union_select(uname string, src_t string) : int {
        if !this.tc.union_names.isin(uname) { return 0 - 1; }
        names: vec<string> = this.tc.union_names[uname];
        ii: int = 0;
        while ii < names.size {
            if this.tc.union_variant_type(uname, ii) == src_t { return ii; }
            ii = ii + 1;
        }
        sd: string = this.jdesc(src_t);
        if sd.size > 0 {
            ii = 0;
            while ii < names.size {
                vd: string = this.jdesc(this.tc.union_variant_type(uname, ii));
                if vd.size > 0 && vd == sd { return ii; }
                ii = ii + 1;
            }
        }
        if sd == "I" || sd == "J" || this.is_sized_int(src_t) {
            ii = 0;
            while ii < names.size {
                vd: string = this.jdesc(this.tc.union_variant_type(uname, ii));
                if vd == "I" || vd == "J" { return ii; }
                ii = ii + 1;
            }
        }
        if sd == "D" {
            ii = 0;
            while ii < names.size {
                if this.jdesc(this.tc.union_variant_type(uname, ii)) == "D" { return ii; }
                ii = ii + 1;
            }
        }
        return 0 - 1;
    }

    // Box a coerced variant value as a payload object.
    // Entry: [val:vt]. Exit: [payload-Object].
    pub fnc union_box_payload(vt string) : void {
        vd: string = this.jdesc(vt);
        if vd == "D" {
            this.emit_invoke(JOp.INVOKESTATIC, "java/lang/Double", "doubleToRawLongBits", "(D)J");
            this.emit_invoke(JOp.INVOKESTATIC, "java/lang/Long", "valueOf", "(J)Ljava/lang/Long;");
            return;
        }
        if vd == "I" || vd == "Z" {
            this.cur_method.op(JOp.I2L, 1);
            if this.is_uint_leash(vt) {
                this.long_const(0, 0 - 1);
                this.cur_method.op(JOp.LAND, -2);
            }
            this.emit_invoke(JOp.INVOKESTATIC, "java/lang/Long", "valueOf", "(J)Ljava/lang/Long;");
            return;
        }
        if vd == "J" {
            this.emit_invoke(JOp.INVOKESTATIC, "java/lang/Long", "valueOf", "(J)Ljava/lang/Long;");
            return;
        }
        // References (string, arrays, struct/class/union refs): as-is.
    }

    // Build the union array. Entry: [payload-Object]. Exit: [union].
    pub fnc union_build(idx int) : void {
        ps: int = this.cur_method.alloc_local(1);
        this.cur_method.store_local("X", ps);
        this.iconst(2);
        this.emit_anewarray_object(1);
        us: int = this.cur_method.alloc_local(1);
        this.cur_method.store_local("X", us);
        this.cur_method.load_local("X", us);
        this.iconst(0);
        this.iconst(idx);
        this.emit_invoke(JOp.INVOKESTATIC, "java/lang/Integer", "valueOf", "(I)Ljava/lang/Integer;");
        this.cur_method.op(JOp.AASTORE, -3);
        this.cur_method.load_local("X", us);
        this.iconst(1);
        this.cur_method.load_local("X", ps);
        this.cur_method.op(JOp.AASTORE, -3);
        this.cur_method.load_local("X", us);
    }

    // Zero value: tag 0 with a zero payload of variant 0 (native parity).
    pub fnc gen_union_default(uname string) : void {
        n: int = this.union_count(uname);
        if n == 0 {
            this.cur_method.op(JOp.ACONST_NULL, 1);
            return;
        }
        vt0: string = this.union_variant_type(uname, 0);
        vd0: string = this.jdesc(vt0);
        if vd0 == "J" {
            this.cur_method.op(JOp.LCONST_0, 2);
        } also vd0 == "D" {
            this.cur_method.op(JOp.DCONST_0, 2);
        } also vd0 == "I" || vd0 == "Z" {
            this.iconst(0);
        } else {
            this.cur_method.op(JOp.ACONST_NULL, 1);
        }
        this.union_box_payload(vt0);
        this.union_build(0);
    }

    // Store a value into a union (auto variant selection).
    // Entry: [val:src_t]. Exit: [union]. Balanced even on failure
    // (drops the value, pushes null, records the error).
    pub fnc union_auto_store(uname string, src_t string) : void {
        if src_t == uname { return; }
        idx: int = this.union_select(uname, src_t);
        if idx < 0 {
            // Keep the tracker balanced: drop the value, push null.
            sd: string = this.jdesc(src_t);
            if sd == "J" || sd == "D" {
                this.cur_method.op(JOp.POP2, -2);
            } also sd.size > 0 {
                this.cur_method.op(JOp.POP, -1);
            }
            this.cur_method.op(JOp.ACONST_NULL, 1);
            this.jvm_unsupported("cannot store '" + src_t + "' in union '" + uname + "'");
            return;
        }
        vt: string = this.union_variant_type(uname, idx);
        this.jvm_coerce(src_t, vt);
        this.narrow_to(vt);
        this.union_box_payload(vt);
        this.union_build(idx);
    }

    // Entry: [arr]. Exit: [int tag].
    pub fnc union_load_tag() : void {
        this.iconst(0);
        this.cur_method.op(JOp.AALOAD, -1);
        this.emit_checkcast("java/lang/Integer");
        this.emit_invoke(JOp.INVOKEVIRTUAL, "java/lang/Integer", "intValue", "()I");
    }

    // Entry: [arr]. Exit: [Object payload].
    pub fnc union_load_payload() : void {
        this.iconst(1);
        this.cur_method.op(JOp.AALOAD, -1);
    }

    // Entry: [payload-Object]. Exit: [value:vt].
    pub fnc union_unbox_payload(vt string) : void {
        vd: string = this.jdesc(vt);
        if vd == "D" {
            this.emit_checkcast("java/lang/Long");
            this.emit_invoke(JOp.INVOKEVIRTUAL, "java/lang/Long", "longValue", "()J");
            this.emit_invoke(JOp.INVOKESTATIC, "java/lang/Double", "longBitsToDouble", "(J)D");
            return;
        }
        if vd == "I" || vd == "Z" {
            this.emit_checkcast("java/lang/Long");
            this.emit_invoke(JOp.INVOKEVIRTUAL, "java/lang/Long", "longValue", "()J");
            this.cur_method.op(JOp.L2I, -1);
            this.narrow_to(vt);
            return;
        }
        if vd == "J" {
            this.emit_checkcast("java/lang/Long");
            this.emit_invoke(JOp.INVOKEVIRTUAL, "java/lang/Long", "longValue", "()J");
            return;
        }
        if vd == "Ljava/lang/String;" {
            this.emit_checkcast("java/lang/String");
            return;
        }
        // Other references (arrays, struct/class/union): already the value.
    }

    // Tag-checked variant read. Entry: [arr]. Exit: [value:vt].
    pub fnc gen_union_read_checked(uname string, vname string) : void {
        idx: int = this.union_variant_idx(uname, vname);
        vt: string = this.union_variant_type(uname, idx);
        us: int = this.cur_method.alloc_local(1);
        this.cur_method.store_local("X", us);
        ok_lbl: string = this.new_label("ur_ok");
        if !this.current_func_unsafe {
            this.cur_method.load_local("X", us);
            this.union_load_tag();
            this.iconst(idx);
            this.cur_method.branch(JOp.IF_ICMPEQ, ok_lbl, 2);
            this.emit_abort("Runtime error: Attempted to access '." + vname + "' on union '" + uname + "', but the active variant is different.\n");
            this.cur_method.branch(JOp.GOTO, ok_lbl, 0);
        }
        this.cur_method.mark(ok_lbl);
        this.cur_method.load_local("X", us);
        this.union_load_payload();
        this.union_unbox_payload(vt);
    }

    // Payload as display string. Entry: [arr]. Exit: [String].
    pub fnc gen_union_tostring(uname string) : void {
        n: int = this.union_count(uname);
        us: int = this.cur_method.alloc_local(1);
        this.cur_method.store_local("X", us);
        this.cur_method.load_local("X", us);
        this.union_load_tag();
        ts: int = this.cur_method.alloc_local(1);
        this.cur_method.store_local("I", ts);
        end_lbl: string = this.new_label("uts_end");
        ii: int = 0;
        while ii < n {
            if ii < n - 1 {
                next_lbl: string = this.new_label("uts_nx");
                this.cur_method.load_local("I", ts);
                this.iconst(ii);
                this.cur_method.branch(JOp.IF_ICMPNE, next_lbl, 2);
                this.union_tostring_variant(us, uname, ii);
                this.cur_method.branch(JOp.GOTO, end_lbl, 0);
                this.cur_method.mark(next_lbl);
            } else {
                this.union_tostring_variant(us, uname, ii);
            }
            ii = ii + 1;
        }
        this.cur_method.mark(end_lbl);
    }

    // One variant arm for gen_union_tostring (fallthrough into end_lbl).
    pub fnc union_tostring_variant(us int, uname string, idx int) : void {
        vt: string = this.union_variant_type(uname, idx);
        this.cur_method.load_local("X", us);
        this.union_load_payload();
        if this.tc.unions.isin(vt) {
            this.gen_union_tostring(vt);
            return;
        }
        vd: string = this.jdesc(vt);
        if vd == "[C" {
            ps: int = this.cur_method.alloc_local(1);
            this.cur_method.store_local("X", ps);
            this.cur_method.op(JOp.NEW, 1);
            sci: int = this.cur_cp.class_entry("java/lang/String");
            this.cur_method.emit_u8((sci >> 8) & 255);
            this.cur_method.emit_u8(sci & 255);
            this.cur_method.op(JOp.DUP, 1);
            this.cur_method.load_local("X", ps);
            this.emit_invoke(JOp.INVOKESPECIAL, "java/lang/String", "<init>", "([C)V");
            return;
        }
        this.union_unbox_payload(vt);
        if vd == "Ljava/lang/String;" { return; }
        if vd.size > 0 && vd[0] == 'L' {
            // Arbitrary references: String.valueOf (native fails these
            // in clang anyway, so there is no text to match).
            this.emit_invoke(JOp.INVOKESTATIC, "java/lang/String", "valueOf", "(Ljava/lang/Object;)Ljava/lang/String;");
            return;
        }
        this.jvm_tostring(vt);
    }

    // Variant store through a local or global union (s.op must be "=").
    pub fnc gen_union_store(s Stmt) : void {
        tgt: Expr = s.target;
        uname: string = this.expr_type(tgt.left);
        idx: int = this.union_variant_idx(uname, tgt.sval);
        if idx < 0 {
            this.jvm_unsupported("member '." + tgt.sval + "' of '" + uname + "'");
            return;
        }
        if s.op != "=" {
            this.jvm_unsupported("compound assignment on union member '." + tgt.sval + "'");
            return;
        }
        vt: string = this.union_variant_type(uname, idx);
        this.gen_expr(tgt.left);
        base_slot: int = this.cur_method.alloc_local(1);
        this.cur_method.store_local("X", base_slot);
        at: string = this.expr_type(s.value);
        this.gen_expr(s.value);
        this.jvm_coerce(at, vt);
        this.narrow_to(vt);
        this.union_box_payload(vt);
        pay_slot: int = this.cur_method.alloc_local(1);
        this.cur_method.store_local("X", pay_slot);
        this.cur_method.load_local("X", pay_slot);
        this.union_build(idx);
        if tgt.left != null && tgt.left.kind == ExprKind.IDENT {
            bn: string = tgt.left.sval;
            if this.var_slots.isin(bn) {
                this.cur_method.store_local("[Ljava/lang/Object;", this.var_slots[bn]);
                return;
            }
            if this.cg.global_vars.isin(bn) {
                gidx: int = this.cur_cp.fieldref(this.main_class, "g_" + bn, "[Ljava/lang/Object;");
                this.cur_method.op_field(JOp.PUTSTATIC, gidx, -1);
                return;
            }
        }
        this.jvm_unsupported("union member store on non-variable base");
    }

    // Reference casts (class up/down-casts): CHECKCAST when both sides
    // are object references with different descriptors.
    pub fnc gen_cast_ref(from_t string, to_t string) : bool {
        fd: string = this.jdesc(from_t);
        td: string = this.jdesc(to_t);
        if fd.size == 0 || td.size == 0 { return false; }
        if fd == td { return true; }
        fref: bool = (fd[0] == 'L' || fd[0] == '[');
        tref: bool = (td[0] == 'L' || td[0] == '[');
        if fref && tref {
            // Native casts are unchecked bitcasts (down-casts succeed at
            // runtime and only misbehave if used); CHECKCAST would throw
            // where native continues. Array casts still narrow statically
            // via their descriptors.
            return true;
        }
        return false;
    }

    // Array/slice literal {a, b, ...}: Java array of the literal's base.
    // Tuples (__tuple__) become Object[] with boxed elements.
    pub fnc gen_array_lit(e Expr) : void {
        // Hash literal {"key": val, ...}: keys ride field_names.
        if e.field_names.size > 0 && e.field_names.size == e.args.size {
            this.emit_new_map();
            hm: int = this.cur_method.alloc_local(1);
            this.cur_method.store_local("X", hm);
            hi: int = 0;
            while hi < e.args.size {
                this.cur_method.load_local("X", hm);
                this.ldc_string(e.field_names.get(hi));
                vt: string = this.expr_type(e.args.get(hi));
                this.gen_expr(e.args.get(hi));
                this.jvm_coerce(vt, "int");
                this.box_for("int");
                this.emit_invoke(JOp.INVOKEVIRTUAL, "java/util/HashMap", "put", "(Ljava/lang/Object;Ljava/lang/Object;)Ljava/lang/Object;");
                this.cur_method.op(JOp.POP, -1);
                hi = hi + 1;
            }
            this.cur_method.load_local("X", hm);
            return;
        }
        if e.sval == "__tuple__" {
            this.iconst(e.args.size);
            this.emit_anewarray_object(1);
            arr_slot: int = this.cur_method.alloc_local(1);
            this.cur_method.store_local("X", arr_slot);
            ai: int = 0;
            while ai < e.args.size {
                this.cur_method.load_local("X", arr_slot);
                this.iconst(ai);
                et: string = this.expr_type(e.args.get(ai));
                this.gen_expr(e.args.get(ai));
                this.narrow_to(et);
                this.box_for(et);
                this.cur_method.op(JOp.AASTORE, -3);
                ai = ai + 1;
            }
            this.cur_method.load_local("X", arr_slot);
            return;
        }
        lt: string = this.expr_type(e);
        base: string = "";
        if this.array_base_override.size > 0 {
            base = this.array_base_override;
        } else {
            base = this.array_base_of(lt);
        }
        if base.size == 0 { base = "int"; }
        n: int = e.args.size;
        this.emit_new_array(base + "[0]", n);
        arr_slot: int = this.cur_method.alloc_local(1);
        this.cur_method.store_local("X", arr_slot);
        ai: int = 0;
        while ai < n {
            this.cur_method.load_local("X", arr_slot);
            this.iconst(ai);
            et: string = this.expr_type(e.args.get(ai));
            this.gen_expr(e.args.get(ai));
            this.jvm_coerce(et, base);
            this.narrow_to(base);
            sop: int = this.array_store_op(base);
            if base == "J" || base == "D" || this.jdesc(base) == "J" || this.jdesc(base) == "D" {
                this.cur_method.op(sop, -4);
            } else {
                this.cur_method.op(sop, -3);
            }
            ai = ai + 1;
        }
        this.cur_method.load_local("X", arr_slot);
    }

    // Value coercion with array->vec conversion (native slice_to_vec).
    // Returns true when fully handled (caller must skip jvm_coerce).
    pub fnc coerce_val(from_t string, to_t string) : bool {
        if this.tc.unions.isin(to_t) {
            this.union_auto_store(to_t, from_t);
            return true;
        }
        fd: string = this.jdesc(from_t);
        if fd.size > 0 && fd[0] == '[' && this.is_vec_leash(to_t) {
            inner: string = this.vec_inner_type(to_t);
            base: string = this.array_base_of(from_t);
            // Stack: [array]. Build the list around it.
            arr_slot: int = this.cur_method.alloc_local(1);
            this.cur_method.store_local("X", arr_slot);
            this.emit_new_list();
            list_slot: int = this.cur_method.alloc_local(1);
            this.cur_method.store_local("X", list_slot);
            this.append_array_to_list(list_slot, arr_slot, from_t, base, inner);
            this.cur_method.load_local("X", list_slot);
            return true;
        }
        return false;
    }

    // Append every element of the Java array in arr_slot to the list in
    // list_slot (element base -> container inner coercion). Empty stack.
    pub fnc append_array_to_list(list_slot int, arr_slot int, arr_leash string, base string, inner string) : void {
        sd: string = this.jdesc(arr_leash);
        idx_slot: int = this.cur_method.alloc_local(1);
        this.cur_method.op(JOp.ICONST_0, 1);
        this.cur_method.store_local("I", idx_slot);
        head_lbl: string = this.new_label("apx_h");
        end_lbl: string = this.new_label("apx_e");
        this.cur_method.mark(head_lbl);
        this.cur_method.load_local("I", idx_slot);
        this.cur_method.load_local("X", arr_slot);
        this.cur_method.op(JOp.ARRAYLENGTH, 0);
        this.cur_method.branch(JOp.IF_ICMPGE, end_lbl, 2);
        this.cur_method.load_local("X", list_slot);
        this.cur_method.load_local("X", arr_slot);
        this.cur_method.load_local("I", idx_slot);
        lop: int = this.array_load_op(base);
        if this.jdesc(base) == "J" || this.jdesc(base) == "D" {
            this.cur_method.op(lop, 0);
        } else {
            this.cur_method.op(lop, -1);
        }
        this.emit_box_array_elem(sd, inner);
        this.emit_invoke(JOp.INVOKEVIRTUAL, "java/util/ArrayList", "add", "(Ljava/lang/Object;)Z");
        this.cur_method.op(JOp.POP, -1);
        this.cur_method.load_local("I", idx_slot);
        this.iconst(1);
        this.cur_method.op(JOp.IADD, -1);
        this.cur_method.store_local("I", idx_slot);
        this.cur_method.branch(JOp.GOTO, head_lbl, 0);
        this.cur_method.mark(end_lbl);
    }

    // Runtime helpers (private statics of the main class).
    pub fnc emit_helpers(cls JvmClass) : void {
        this.emit_parse_long(cls);
        this.emit_parse_double(cls);
        this.emit_stdin_line(cls);
        this.emit_rand_helpers(cls);
        this.emit_time_helpers(cls);
        this.emit_bigint_wrap_helper(cls);
        this.emit_showb_helpers(cls);
        this.emit_bytes_helpers(cls);
        this.emit_normescape(cls);
        this.emit_file_replace_helper(cls);
    }

    // __file_replace(RAF f, String old, String new, int all): read the
    // whole file, replace first/all literal occurrences, rewrite, return
    // the replacement count (native leash_sh_file_replace parity).
    pub fnc emit_file_replace_helper(cls JvmClass) : void {
        this.helper_start(cls, "__file_replace", "(Ljava/io/RandomAccessFile;Ljava/lang/String;Ljava/lang/String;I)I");
        m: JvmMethod = this.cur_method;
        nullf: string = this.new_label("fr_null");
        done0: string = this.new_label("fr_done0");
        // if (f == null) return 0
        m.op(JOp.ALOAD_0, 1);
        m.branch(JOp.IFNULL, nullf, 1);
        // long len = f.length(); f.seek(0); byte[] b = new byte[(int)len]; f.readFully(b)
        m.op(JOp.ALOAD_0, 1);
        this.emit_invoke(JOp.INVOKEVIRTUAL, "java/io/RandomAccessFile", "length", "()J");
        m.op(JOp.L2I, -1);
        len: int = m.alloc_local(1);
        m.store_local("I", len);
        m.op(JOp.ALOAD_0, 1);
        m.op(JOp.LCONST_0, 2);
        this.emit_invoke(JOp.INVOKEVIRTUAL, "java/io/RandomAccessFile", "seek", "(J)V");
        m.load_local("I", len);
        m.op_1(JOp.NEWARRAY, JArray.T_BYTE, 0);
        barr: int = m.alloc_local(1);
        m.store_local("X", barr);
        m.op(JOp.ALOAD_0, 1);
        m.load_local("X", barr);
        this.emit_invoke(JOp.INVOKEVIRTUAL, "java/io/RandomAccessFile", "readFully", "([B)V");
        // String s = new String(b, ISO)
        m.op(JOp.NEW, 1);
        sci: int = this.cur_cp.class_entry("java/lang/String");
        m.emit_u8((sci >> 8) & 255);
        m.emit_u8(sci & 255);
        m.op(JOp.DUP, 1);
        m.load_local("X", barr);
        this.ldc_string("ISO-8859-1");
        this.emit_invoke(JOp.INVOKESPECIAL, "java/lang/String", "<init>", "([BLjava/lang/String;)V");
        str: int = m.alloc_local(1);
        m.store_local("Ljava/lang/String;", str);
        // int count; String s2;
        this.iconst(0);
        cnt: int = m.alloc_local(1);
        m.store_local("I", cnt);
        // if (all != 0) { count-all + replace } else { first }
        allb: string = this.new_label("fr_all");
        have1: string = this.new_label("fr_have1");
        fin: string = this.new_label("fr_fin");
        m.load_local("I", 3);
        m.branch(JOp.IFNE, allb, 1);
        // ---- first-only: idx = s.indexOf(old)
        m.load_local("Ljava/lang/String;", str);
        m.op(JOp.ALOAD_1, 1);
        this.emit_invoke(JOp.INVOKEVIRTUAL, "java/lang/String", "indexOf", "(Ljava/lang/String;)I");
        idx: int = m.alloc_local(1);
        m.store_local("I", idx);
        m.load_local("I", idx);
        m.branch(JOp.IFGE, have1, 1);
        m.branch(JOp.GOTO, fin, 0);
        m.mark(have1);
        this.iconst(1);
        m.store_local("I", cnt);
        // s = s.substring(0, idx) + new + s.substring(idx + old.size)
        m.load_local("Ljava/lang/String;", str);
        this.iconst(0);
        m.load_local("I", idx);
        this.emit_invoke(JOp.INVOKEVIRTUAL, "java/lang/String", "substring", "(II)Ljava/lang/String;");
        m.op(JOp.ALOAD_2, 1);
        this.emit_invoke(JOp.INVOKEVIRTUAL, "java/lang/String", "concat", "(Ljava/lang/String;)Ljava/lang/String;");
        m.load_local("Ljava/lang/String;", str);
        m.load_local("I", idx);
        m.op(JOp.ALOAD_1, 1);
        this.emit_invoke(JOp.INVOKEVIRTUAL, "java/lang/String", "length", "()I");
        m.op(JOp.IADD, -1);
        this.emit_invoke(JOp.INVOKEVIRTUAL, "java/lang/String", "substring", "(I)Ljava/lang/String;");
        this.emit_invoke(JOp.INVOKEVIRTUAL, "java/lang/String", "concat", "(Ljava/lang/String;)Ljava/lang/String;");
        m.store_local("Ljava/lang/String;", str);
        m.branch(JOp.GOTO, fin, 0);
        // ---- all: count loop
        m.mark(allb);
        m.load_local("Ljava/lang/String;", str);
        m.op(JOp.ALOAD_1, 1);
        this.emit_invoke(JOp.INVOKEVIRTUAL, "java/lang/String", "indexOf", "(Ljava/lang/String;)I");
        m.store_local("I", idx);
        cloop: string = this.new_label("fr_cloop");
        cend: string = this.new_label("fr_cend");
        m.mark(cloop);
        m.load_local("I", idx);
        m.branch(JOp.IFLT, cend, 1);
        m.load_local("I", cnt);
        this.iconst(1);
        m.op(JOp.IADD, -1);
        m.store_local("I", cnt);
        m.load_local("I", idx);
        m.op(JOp.ALOAD_1, 1);
        this.emit_invoke(JOp.INVOKEVIRTUAL, "java/lang/String", "length", "()I");
        m.op(JOp.IADD, -1);
        m.store_local("I", idx);
        m.load_local("Ljava/lang/String;", str);
        m.op(JOp.ALOAD_1, 1);
        m.load_local("I", idx);
        this.emit_invoke(JOp.INVOKEVIRTUAL, "java/lang/String", "indexOf", "(Ljava/lang/String;I)I");
        m.store_local("I", idx);
        m.branch(JOp.GOTO, cloop, 0);
        m.mark(cend);
        // s = s.replace(old, new) (literal)
        m.load_local("Ljava/lang/String;", str);
        m.op(JOp.ALOAD_1, 1);
        m.op(JOp.ALOAD_2, 1);
        this.emit_invoke(JOp.INVOKEVIRTUAL, "java/lang/String", "replace", "(Ljava/lang/CharSequence;Ljava/lang/CharSequence;)Ljava/lang/String;");
        m.store_local("Ljava/lang/String;", str);
        // ---- fin: write back + return count
        m.mark(fin);
        m.op(JOp.ALOAD_0, 1);
        m.op(JOp.LCONST_0, 2);
        this.emit_invoke(JOp.INVOKEVIRTUAL, "java/io/RandomAccessFile", "seek", "(J)V");
        m.op(JOp.ALOAD_0, 1);
        m.op(JOp.LCONST_0, 2);
        this.emit_invoke(JOp.INVOKEVIRTUAL, "java/io/RandomAccessFile", "setLength", "(J)V");
        m.op(JOp.ALOAD_0, 1);
        m.load_local("Ljava/lang/String;", str);
        this.ldc_string("ISO-8859-1");
        this.emit_invoke(JOp.INVOKEVIRTUAL, "java/lang/String", "getBytes", "(Ljava/lang/String;)[B");
        this.emit_invoke(JOp.INVOKEVIRTUAL, "java/io/RandomAccessFile", "write", "([B)V");
        m.load_local("I", cnt);
        m.op(JOp.IRETURN, -1);
        m.mark(nullf);
        this.iconst(0);
        m.op(JOp.IRETURN, -1);
        m.mark(done0);
        this.helper_end(cls);
    }

    // __bytes_from_long(long val, int nbytes, int size): char[size] with
    // the low min(nbytes, size) LE bytes of val; rest zero (gc-malloc
    // parity recorded in the golden output).
    pub fnc emit_bytes_helpers(cls JvmClass) : void {
        this.helper_start(cls, "__bytes_from_long", "(JII)[C");
        m: JvmMethod = this.cur_method;
        arr: int = m.alloc_local(1);
        i: int = m.alloc_local(1);
        loop_lbl: string = this.new_label("bfl_loop");
        end_lbl: string = this.new_label("bfl_end");
        // args: val=slots 0-1, nbytes=slot 2, size=slot 3
        m.load_local("I", 3);
        m.op_1(JOp.NEWARRAY, JArray.T_CHAR, 0);
        m.store_local("X", arr);
        this.iconst(0);
        m.store_local("I", i);
        m.mark(loop_lbl);
        m.load_local("I", i);
        m.load_local("I", 2);
        m.branch(JOp.IF_ICMPGE, end_lbl, 2);
        m.load_local("I", i);
        m.load_local("I", 3);
        m.branch(JOp.IF_ICMPGE, end_lbl, 2);
        m.load_local("X", arr);
        m.load_local("I", i);
        m.load_local("J", 0);
        m.load_local("I", i);
        this.iconst(8);
        m.op(JOp.IMUL, -1);
        m.op(JOp.LUSHR, -1);
        this.long_const(0, 255);
        m.op(JOp.LAND, -2);
        m.op(JOp.L2I, -1);
        m.op(JOp.I2C, 0);
        m.op(JOp.CASTORE, -3);
        m.load_local("I", i);
        this.iconst(1);
        m.op(JOp.IADD, -1);
        m.store_local("I", i);
        m.branch(JOp.GOTO, loop_lbl, 0);
        m.mark(end_lbl);
        m.load_local("X", arr);
        m.op(JOp.ARETURN, -1);
        this.helper_end(cls);

        // __bytes_to_long(char[] b, int size): LE accumulation of the
        // first size bytes (never shifts past 63).
        this.helper_start(cls, "__bytes_to_long", "([CI)J");
        m = this.cur_method;
        acc: int = m.alloc_local(2);
        i2: int = m.alloc_local(1);
        loop2: string = this.new_label("btl_loop");
        end2: string = this.new_label("btl_end");
        this.long_const(0, 0);
        m.store_local("J", acc);
        this.iconst(0);
        m.store_local("I", i2);
        m.mark(loop2);
        m.load_local("I", i2);
        m.load_local("I", 1);
        m.branch(JOp.IF_ICMPGE, end2, 2);
        m.load_local("J", acc);
        m.load_local("X", 0);
        m.load_local("I", i2);
        m.op(JOp.CALOAD, -1);
        this.iconst(255);
        m.op(JOp.IAND, -1);
        m.op(JOp.I2L, 1);
        m.load_local("I", i2);
        this.iconst(8);
        m.op(JOp.IMUL, -1);
        m.op(JOp.LSHL, -1);
        m.op(JOp.LOR, -2);
        m.store_local("J", acc);
        m.load_local("I", i2);
        this.iconst(1);
        m.op(JOp.IADD, -1);
        m.store_local("I", i2);
        m.branch(JOp.GOTO, loop2, 0);
        m.mark(end2);
        m.load_local("J", acc);
        m.op(JOp.LRETURN, -2);
        this.helper_end(cls);
    }

    // __normescape(String): interpret the single-char escapes
    // (n t r 0 \\"'); unknown escapes keep the backslash.
    pub fnc emit_normescape(cls JvmClass) : void {
        this.helper_start(cls, "__normescape", "(Ljava/lang/String;)Ljava/lang/String;");
        m: JvmMethod = this.cur_method;
        buf: int = m.alloc_local(1);
        o: int = m.alloc_local(1);
        i: int = m.alloc_local(1);
        n: int = m.alloc_local(1);
        c: int = m.alloc_local(1);
        dt: int = m.alloc_local(1);
        loop_lbl: string = this.new_label("ne_loop");
        esc_lbl: string = this.new_label("ne_esc");
        plain_lbl: string = this.new_label("ne_plain");
        have_lbl: string = this.new_label("ne_have");
        adv_lbl: string = this.new_label("ne_adv");
        end_lbl: string = this.new_label("ne_end");
        // buf = new char[n]; n = s.length()
        m.op(JOp.ALOAD_0, 1);
        this.emit_invoke(JOp.INVOKEVIRTUAL, "java/lang/String", "length", "()I");
        m.store_local("I", n);
        m.load_local("I", n);
        m.op_1(JOp.NEWARRAY, JArray.T_CHAR, 0);
        m.store_local("X", buf);
        this.iconst(0);
        m.store_local("I", o);
        this.iconst(0);
        m.store_local("I", i);
        m.mark(loop_lbl);
        m.load_local("I", i);
        m.load_local("I", n);
        m.branch(JOp.IF_ICMPGE, end_lbl, 2);
        // c = s.charAt(i)
        m.op(JOp.ALOAD_0, 1);
        m.load_local("I", i);
        this.emit_invoke(JOp.INVOKEVIRTUAL, "java/lang/String", "charAt", "(I)C");
        m.store_local("I", c);
        // if c == '\\' && i+1 < n -> esc_lbl
        m.load_local("I", c);
        this.iconst(92);
        m.branch(JOp.IF_ICMPNE, plain_lbl, 2);
        m.load_local("I", i);
        m.load_local("I", n);
        this.iconst(1);
        m.op(JOp.ISUB, -1);
        m.branch(JOp.IF_ICMPGE, plain_lbl, 2);
        // escape path: i++; d = s.charAt(i); switch on d
        m.branch(JOp.GOTO, esc_lbl, 0);
        m.mark(plain_lbl);
        // buf[o++] = c
        m.load_local("X", buf);
        m.load_local("I", o);
        m.load_local("I", c);
        m.op(JOp.CASTORE, -3);
        m.load_local("I", o);
        this.iconst(1);
        m.op(JOp.IADD, -1);
        m.store_local("I", o);
        m.load_local("I", i);
        this.iconst(1);
        m.op(JOp.IADD, -1);
        m.store_local("I", i);
        m.branch(JOp.GOTO, loop_lbl, 0);
        m.mark(esc_lbl);
        // i++; dt = s.charAt(i)
        m.load_local("I", i);
        this.iconst(1);
        m.op(JOp.IADD, -1);
        m.store_local("I", i);
        m.op(JOp.ALOAD_0, 1);
        m.load_local("I", i);
        this.emit_invoke(JOp.INVOKEVIRTUAL, "java/lang/String", "charAt", "(I)C");
        m.store_local("I", dt);
        nt_lbl: string = this.new_label("ne_t");
        nr_lbl: string = this.new_label("ne_r");
        nz_lbl: string = this.new_label("ne_0");
        nq_lbl: string = this.new_label("ne_q");
        ndq_lbl: string = this.new_label("ne_dq");
        nsq_lbl: string = this.new_label("ne_sq");
        nbs_lbl: string = this.new_label("ne_bs");
        // dt == 'n' -> 10
        m.load_local("I", dt);
        this.iconst(110);
        m.branch(JOp.IF_ICMPNE, nt_lbl, 2);
        this.iconst(10);
        m.store_local("I", c);
        m.branch(JOp.GOTO, have_lbl, 0);
        m.mark(nt_lbl);
        m.load_local("I", dt);
        this.iconst(116);
        m.branch(JOp.IF_ICMPNE, nr_lbl, 2);
        this.iconst(9);
        m.store_local("I", c);
        m.branch(JOp.GOTO, have_lbl, 0);
        m.mark(nr_lbl);
        m.load_local("I", dt);
        this.iconst(114);
        m.branch(JOp.IF_ICMPNE, nz_lbl, 2);
        this.iconst(13);
        m.store_local("I", c);
        m.branch(JOp.GOTO, have_lbl, 0);
        m.mark(nz_lbl);
        m.load_local("I", dt);
        this.iconst(48);
        m.branch(JOp.IF_ICMPNE, nq_lbl, 2);
        this.iconst(0);
        m.store_local("I", c);
        m.branch(JOp.GOTO, have_lbl, 0);
        m.mark(nq_lbl);
        // '\\', '"', '\'' escape to themselves
        m.load_local("I", dt);
        this.iconst(92);
        m.branch(JOp.IF_ICMPNE, ndq_lbl, 2);
        this.iconst(92);
        m.store_local("I", c);
        m.branch(JOp.GOTO, have_lbl, 0);
        m.mark(ndq_lbl);
        m.load_local("I", dt);
        this.iconst(34);
        m.branch(JOp.IF_ICMPNE, nsq_lbl, 2);
        this.iconst(34);
        m.store_local("I", c);
        m.branch(JOp.GOTO, have_lbl, 0);
        m.mark(nsq_lbl);
        m.load_local("I", dt);
        this.iconst(39);
        m.branch(JOp.IF_ICMPNE, nbs_lbl, 2);
        this.iconst(39);
        m.store_local("I", c);
        m.branch(JOp.GOTO, have_lbl, 0);
        m.mark(nbs_lbl);
        // Unknown escape: buf[o++] = '\\'; buf[o++] = dt
        m.load_local("X", buf);
        m.load_local("I", o);
        this.iconst(92);
        m.op(JOp.CASTORE, -3);
        m.load_local("I", o);
        this.iconst(1);
        m.op(JOp.IADD, -1);
        m.store_local("I", o);
        m.load_local("X", buf);
        m.load_local("I", o);
        m.load_local("I", dt);
        m.op(JOp.CASTORE, -3);
        m.load_local("I", o);
        this.iconst(1);
        m.op(JOp.IADD, -1);
        m.store_local("I", o);
        m.branch(JOp.GOTO, adv_lbl, 0);
        m.mark(have_lbl);
        // buf[o++] = c
        m.load_local("X", buf);
        m.load_local("I", o);
        m.load_local("I", c);
        m.op(JOp.CASTORE, -3);
        m.load_local("I", o);
        this.iconst(1);
        m.op(JOp.IADD, -1);
        m.store_local("I", o);
        m.mark(adv_lbl);
        m.load_local("I", i);
        this.iconst(1);
        m.op(JOp.IADD, -1);
        m.store_local("I", i);
        m.branch(JOp.GOTO, loop_lbl, 0);
        m.mark(end_lbl);
        // new String(buf, 0, o)
        m.op(JOp.NEW, 1);
        sci: int = this.cur_cp.class_entry("java/lang/String");
        m.emit_u8((sci >> 8) & 255);
        m.emit_u8(sci & 255);
        m.op(JOp.DUP, 1);
        m.load_local("X", buf);
        this.iconst(0);
        m.load_local("I", o);
        this.emit_invoke(JOp.INVOKESPECIAL, "java/lang/String", "<init>", "([CII)V");
        m.op(JOp.ARETURN, -1);
        this.helper_end(cls);
    }

    // Buffered showb: appends to a static StringBuffer drained at exit
    // (native parity: show() does not flush it; it lands last).
    pub fnc emit_showb_helpers(cls JvmClass) : void {
        this.helper_start(cls, "__showb_append", "(Ljava/lang/String;)V");
        m: JvmMethod = this.cur_method;
        have_lbl: string = this.new_label("sa_have");
        this.rng_get("__showb", "Ljava/lang/StringBuffer;");
        m.branch(JOp.IFNONNULL, have_lbl, 1);
        m.op(JOp.NEW, 1);
        sbi: int = this.cur_cp.class_entry("java/lang/StringBuffer");
        m.emit_u8((sbi >> 8) & 255);
        m.emit_u8(sbi & 255);
        m.op(JOp.DUP, 1);
        this.emit_invoke(JOp.INVOKESPECIAL, "java/lang/StringBuffer", "<init>", "()V");
        this.rng_put("__showb", "Ljava/lang/StringBuffer;");
        m.mark(have_lbl);
        this.rng_get("__showb", "Ljava/lang/StringBuffer;");
        m.op(JOp.ALOAD_0, 1);
        this.emit_invoke(JOp.INVOKEVIRTUAL, "java/lang/StringBuffer", "append", "(Ljava/lang/String;)Ljava/lang/StringBuffer;");
        m.op(JOp.POP, -1);
        m.op(JOp.RETURN, 0);
        this.helper_end(cls);
        this.helper_start(cls, "__showb_flush", "()V");
        m = this.cur_method;
        done_lbl: string = this.new_label("sf_done");
        this.rng_get("__showb", "Ljava/lang/StringBuffer;");
        m.branch(JOp.IFNULL, done_lbl, 1);
        this.emit_getstatic_out();
        this.rng_get("__showb", "Ljava/lang/StringBuffer;");
        this.emit_invoke(JOp.INVOKEVIRTUAL, "java/lang/StringBuffer", "toString", "()Ljava/lang/String;");
        this.emit_invoke(JOp.INVOKEVIRTUAL, "java/io/PrintStream", "print", "(Ljava/lang/String;)V");
        m.op(JOp.ACONST_NULL, 1);
        this.rng_put("__showb", "Ljava/lang/StringBuffer;");
        m.mark(done_lbl);
        m.op(JOp.RETURN, 0);
        this.helper_end(cls);
    }

    pub fnc emit_showb_flush_call() : void {
        this.emit_invoke(JOp.INVOKESTATIC, this.main_class, "__showb_flush", "()V");
    }

    // __bigint_wrap(BigInteger v, int width, int isSigned): mask to width
    // bits, re-signing for signed types (native truncation parity).
    pub fnc emit_bigint_wrap_helper(cls JvmClass) : void {
        this.helper_start(cls, "__bigint_wrap", "(Ljava/math/BigInteger;II)Ljava/math/BigInteger;");
        m: JvmMethod = this.cur_method;
        m.access = m.access + JAcc.SYNCHRONIZED;
        mask_slot: int = m.alloc_local(1);
        r_slot: int = m.alloc_local(1);
        end_lbl: string = this.new_label("bw_end");
        end2_lbl: string = this.new_label("bw_end2");
        // mask = ONE.shiftLeft(width).subtract(ONE)
        one0: int = this.cur_cp.fieldref("java/math/BigInteger", "ONE", "Ljava/math/BigInteger;");
        this.cur_method.op_field(JOp.GETSTATIC, one0, 1);
        m.load_local("I", 1);
        this.emit_invoke(JOp.INVOKEVIRTUAL, "java/math/BigInteger", "shiftLeft", "(I)Ljava/math/BigInteger;");
        one1: int = this.cur_cp.fieldref("java/math/BigInteger", "ONE", "Ljava/math/BigInteger;");
        this.cur_method.op_field(JOp.GETSTATIC, one1, 1);
        this.emit_invoke(JOp.INVOKEVIRTUAL, "java/math/BigInteger", "subtract", "(Ljava/math/BigInteger;)Ljava/math/BigInteger;");
        m.store_local("X", mask_slot);
        // r = v.and(mask)
        m.load_local("X", 0);
        m.load_local("X", mask_slot);
        this.emit_invoke(JOp.INVOKEVIRTUAL, "java/math/BigInteger", "and", "(Ljava/math/BigInteger;)Ljava/math/BigInteger;");
        m.store_local("X", r_slot);
        // if signed && r.testBit(width - 1): r -= 2^width
        m.load_local("I", 2);
        m.branch(JOp.IFEQ, end_lbl, 1);
        m.load_local("X", r_slot);
        m.load_local("I", 1);
        this.iconst(1);
        m.op(JOp.ISUB, -1);
        this.emit_invoke(JOp.INVOKEVIRTUAL, "java/math/BigInteger", "testBit", "(I)Z");
        m.branch(JOp.IFEQ, end2_lbl, 1);
        m.load_local("X", r_slot);
        one2: int = this.cur_cp.fieldref("java/math/BigInteger", "ONE", "Ljava/math/BigInteger;");
        this.cur_method.op_field(JOp.GETSTATIC, one2, 1);
        m.load_local("I", 1);
        this.emit_invoke(JOp.INVOKEVIRTUAL, "java/math/BigInteger", "shiftLeft", "(I)Ljava/math/BigInteger;");
        this.emit_invoke(JOp.INVOKEVIRTUAL, "java/math/BigInteger", "subtract", "(Ljava/math/BigInteger;)Ljava/math/BigInteger;");
        m.store_local("X", r_slot);
        m.mark(end2_lbl);
        m.mark(end_lbl);
        m.load_local("X", r_slot);
        m.op(JOp.ARETURN, -1);
        this.helper_end(cls);
    }

    pub fnc helper_start(cls JvmClass, name string, desc string) : void {
        this.current_helper_name = name;
        this.opdef_inner = "";
        this.tmap_owner = "";
        // PUBLIC: stdlib classes (separate .class files) call main-class
        // helpers (e.g. Rand.range -> __rand_range); private would throw
        // IllegalAccessError across classes.
        m: JvmMethod = JvmMethod.make(cls.cp.utf8(name), cls.cp.utf8(desc), JAcc.PUBLIC + JAcc.STATIC);
        this.cur_cp = cls.cp;
        this.cur_method = m;
        // Reserve the argument slots: locals_used doubles as max_locals,
        // and the verifier requires max_locals >= argument slots even
        // when the body never touches them.
        i: int = 1;
        while i < desc.size && desc[i] != ')' {
            c: char = desc[i];
            if c == 'J' || c == 'D' {
                m.alloc_local(2);
                i = i + 1;
            } also c == 'L' {
                m.alloc_local(1);
                while i < desc.size && desc[i] != ';' { i = i + 1; }
                i = i + 1;
            } also c == '[' {
                m.alloc_local(1);
                while i < desc.size && desc[i] == '[' { i = i + 1; }
                if i < desc.size && desc[i] == 'L' {
                    while i < desc.size && desc[i] != ';' { i = i + 1; }
                }
                i = i + 1;
            } else {
                m.alloc_local(1);
                i = i + 1;
            }
        }
    }

    pub fnc helper_end(cls JvmClass) : void {
        if !this.cur_method.finalize(cls.cp) {
            foreach _, e in<vector> this.cur_method.errors {
                this.errors.pushb("[" + this.current_helper_name + "] " + e);
            }
            return;
        }
        cls.add_method(this.cur_method);
    }

    // if s[i_slot] == code: i_slot++ and goto incr_lbl (empty stack
    // either way; reloads the char itself).
    pub fnc ws_check(i_slot int, code int, incr_lbl string) : void {
        no_lbl: string = this.new_label("pl_wsn");
        this.cur_method.op(JOp.ALOAD_0, 1);
        this.cur_method.load_local("I", i_slot);
        this.emit_invoke(JOp.INVOKEVIRTUAL, "java/lang/String", "charAt", "(I)C");
        this.iconst(code);
        this.cur_method.branch(JOp.IF_ICMPNE, no_lbl, 2);
        this.cur_method.load_local("I", i_slot);
        this.iconst(1);
        this.cur_method.op(JOp.IADD, -1);
        this.cur_method.store_local("I", i_slot);
        this.cur_method.branch(JOp.GOTO, incr_lbl, 0);
        this.cur_method.mark(no_lbl);
    }

    // __parse_long(String)J with atoll semantics (skips whitespace,
    // optional sign, leading digits; empty/invalid yields 0).
    // Join discipline: the pre-StackMapTable inference verifier breaks on
    // labels with >2 conditional-branch predecessors or 2 branch preds
    // plus a fallthrough (goto predecessors are fine), so every multi-
    // exit section routes through private labels and closing gotos.
    pub fnc emit_parse_long(cls JvmClass) : void {
        this.helper_start(cls, "__parse_long", "(Ljava/lang/String;)J");
        m: JvmMethod = this.cur_method;
        i_slot: int = m.alloc_local(1);
        n_slot: int = m.alloc_local(1);
        neg_slot: int = m.alloc_local(1);
        acc_slot: int = m.alloc_local(2);
        c_slot: int = m.alloc_local(1);
        m.op(JOp.ALOAD_0, 1);
        this.emit_invoke(JOp.INVOKEVIRTUAL, "java/lang/String", "length", "()I");
        m.store_local("I", n_slot);
        m.op(JOp.ICONST_0, 1);
        m.store_local("I", i_slot);
        // ---- whitespace loop -------------------------------------------
        ws_h: string = this.new_label("pl_ws");
        ws_e: string = this.new_label("pl_wse");
        m.mark(ws_h);
        m.load_local("I", i_slot);
        m.load_local("I", n_slot);
        m.branch(JOp.IF_ICMPGE, ws_e, 2);
        this.ws_check(i_slot, 32, ws_h);
        this.ws_check(i_slot, 9, ws_h);
        this.ws_check(i_slot, 10, ws_h);
        this.ws_check(i_slot, 11, ws_h);
        this.ws_check(i_slot, 12, ws_h);
        this.ws_check(i_slot, 13, ws_h);
        m.branch(JOp.GOTO, ws_e, 0);
        m.mark(ws_e);
        // ---- optional sign ---------------------------------------------
        m.op(JOp.ICONST_0, 1);
        m.store_local("I", neg_slot);
        sg_end: string = this.new_label("pl_sge");
        not_plus: string = this.new_label("pl_np");
        not_minus: string = this.new_label("pl_nm");
        m.load_local("I", i_slot);
        m.load_local("I", n_slot);
        m.branch(JOp.IF_ICMPGE, sg_end, 2);
        m.op(JOp.ALOAD_0, 1);
        m.load_local("I", i_slot);
        this.emit_invoke(JOp.INVOKEVIRTUAL, "java/lang/String", "charAt", "(I)C");
        m.store_local("I", c_slot);
        m.load_local("I", c_slot);
        this.iconst(43);
        m.branch(JOp.IF_ICMPNE, not_plus, 2);
        m.load_local("I", i_slot);
        this.iconst(1);
        m.op(JOp.IADD, -1);
        m.store_local("I", i_slot);
        m.branch(JOp.GOTO, sg_end, 0);
        m.mark(not_plus);
        m.load_local("I", c_slot);
        this.iconst(45);
        m.branch(JOp.IF_ICMPNE, not_minus, 2);
        m.op(JOp.ICONST_1, 1);
        m.store_local("I", neg_slot);
        m.load_local("I", i_slot);
        this.iconst(1);
        m.op(JOp.IADD, -1);
        m.store_local("I", i_slot);
        m.mark(not_minus);
        m.branch(JOp.GOTO, sg_end, 0);
        m.mark(sg_end);
        // ---- digits loop -----------------------------------------------
        this.long_const(0, 0);
        m.store_local("J", acc_slot);
        dg_h: string = this.new_label("pl_dg");
        dg_low: string = this.new_label("pl_dglow");
        dg_e: string = this.new_label("pl_dge");
        m.mark(dg_h);
        m.load_local("I", i_slot);
        m.load_local("I", n_slot);
        m.branch(JOp.IF_ICMPGE, dg_e, 2);
        m.op(JOp.ALOAD_0, 1);
        m.load_local("I", i_slot);
        this.emit_invoke(JOp.INVOKEVIRTUAL, "java/lang/String", "charAt", "(I)C");
        m.store_local("I", c_slot);
        m.load_local("I", c_slot);
        this.iconst(48);
        m.branch(JOp.IF_ICMPLT, dg_low, 2);
        m.load_local("I", c_slot);
        this.iconst(57);
        m.branch(JOp.IF_ICMPGT, dg_e, 2);
        m.load_local("J", acc_slot);
        this.long_const(0, 10);
        m.op(JOp.LMUL, -2);
        m.load_local("I", c_slot);
        this.iconst(48);
        m.op(JOp.ISUB, -1);
        m.op(JOp.I2L, 1);
        m.op(JOp.LADD, -2);
        m.store_local("J", acc_slot);
        m.load_local("I", i_slot);
        this.iconst(1);
        m.op(JOp.IADD, -1);
        m.store_local("I", i_slot);
        m.branch(JOp.GOTO, dg_h, 0);
        m.mark(dg_low);
        m.branch(JOp.GOTO, dg_e, 0);
        m.mark(dg_e);
        // ---- apply sign -------------------------------------------------
        pos_e: string = this.new_label("pl_pose");
        m.load_local("I", neg_slot);
        m.branch(JOp.IFEQ, pos_e, 1);
        m.load_local("J", acc_slot);
        m.op(JOp.LNEG, 0);
        m.op(JOp.LRETURN, -2);
        m.mark(pos_e);
        m.load_local("J", acc_slot);
        m.op(JOp.LRETURN, -2);
        this.helper_end(cls);
    }

    // __parse_double(String)D: longest valid-double prefix (atof
    // semantics for common cases; empty/invalid yields 0.0). Same
    // join discipline as __parse_long (private labels + closing gotos).
    pub fnc emit_parse_double(cls JvmClass) : void {
        this.helper_start(cls, "__parse_double", "(Ljava/lang/String;)D");
        m: JvmMethod = this.cur_method;
        i_slot: int = m.alloc_local(1);
        n_slot: int = m.alloc_local(1);
        start_slot: int = m.alloc_local(1);
        dig_slot: int = m.alloc_local(1);
        c_slot: int = m.alloc_local(1);
        j_slot: int = m.alloc_local(1);
        m.op(JOp.ALOAD_0, 1);
        this.emit_invoke(JOp.INVOKEVIRTUAL, "java/lang/String", "length", "()I");
        m.store_local("I", n_slot);
        m.op(JOp.ICONST_0, 1);
        m.store_local("I", i_slot);
        m.op(JOp.ICONST_0, 1);
        m.store_local("I", dig_slot);
        // ---- whitespace loop -------------------------------------------
        ws_h: string = this.new_label("pd_ws");
        ws_e: string = this.new_label("pd_wse");
        m.mark(ws_h);
        m.load_local("I", i_slot);
        m.load_local("I", n_slot);
        m.branch(JOp.IF_ICMPGE, ws_e, 2);
        this.ws_check(i_slot, 32, ws_h);
        this.ws_check(i_slot, 9, ws_h);
        this.ws_check(i_slot, 10, ws_h);
        this.ws_check(i_slot, 13, ws_h);
        m.branch(JOp.GOTO, ws_e, 0);
        m.mark(ws_e);
        m.load_local("I", i_slot);
        m.store_local("I", start_slot);
        // ---- optional sign ---------------------------------------------
        sg_end: string = this.new_label("pd_sge");
        not_plus: string = this.new_label("pd_np");
        not_minus: string = this.new_label("pd_nm");
        m.load_local("I", i_slot);
        m.load_local("I", n_slot);
        m.branch(JOp.IF_ICMPGE, sg_end, 2);
        m.op(JOp.ALOAD_0, 1);
        m.load_local("I", i_slot);
        this.emit_invoke(JOp.INVOKEVIRTUAL, "java/lang/String", "charAt", "(I)C");
        m.store_local("I", c_slot);
        m.load_local("I", c_slot);
        this.iconst(43);
        m.branch(JOp.IF_ICMPNE, not_plus, 2);
        m.load_local("I", i_slot);
        this.iconst(1);
        m.op(JOp.IADD, -1);
        m.store_local("I", i_slot);
        m.branch(JOp.GOTO, sg_end, 0);
        m.mark(not_plus);
        m.load_local("I", c_slot);
        this.iconst(45);
        m.branch(JOp.IF_ICMPNE, not_minus, 2);
        m.load_local("I", i_slot);
        this.iconst(1);
        m.op(JOp.IADD, -1);
        m.store_local("I", i_slot);
        m.mark(not_minus);
        m.branch(JOp.GOTO, sg_end, 0);
        m.mark(sg_end);
        // ---- integer digits --------------------------------------------
        dg_h: string = this.new_label("pd_dg");
        dg_low: string = this.new_label("pd_dglow");
        dg_e: string = this.new_label("pd_dge");
        m.mark(dg_h);
        m.load_local("I", i_slot);
        m.load_local("I", n_slot);
        m.branch(JOp.IF_ICMPGE, dg_e, 2);
        m.op(JOp.ALOAD_0, 1);
        m.load_local("I", i_slot);
        this.emit_invoke(JOp.INVOKEVIRTUAL, "java/lang/String", "charAt", "(I)C");
        m.store_local("I", c_slot);
        m.load_local("I", c_slot);
        this.iconst(48);
        m.branch(JOp.IF_ICMPLT, dg_low, 2);
        m.load_local("I", c_slot);
        this.iconst(57);
        m.branch(JOp.IF_ICMPGT, dg_e, 2);
        m.op(JOp.ICONST_1, 1);
        m.store_local("I", dig_slot);
        m.load_local("I", i_slot);
        this.iconst(1);
        m.op(JOp.IADD, -1);
        m.store_local("I", i_slot);
        m.branch(JOp.GOTO, dg_h, 0);
        m.mark(dg_low);
        m.branch(JOp.GOTO, dg_e, 0);
        m.mark(dg_e);
        // ---- fraction ---------------------------------------------------
        // if s[i] == '.': consume it and the digit run. no_frac has 2
        // branch preds + a goto (from the run's exit funnel).
        no_frac: string = this.new_label("pd_nofr");
        m.load_local("I", i_slot);
        m.load_local("I", n_slot);
        m.branch(JOp.IF_ICMPGE, no_frac, 2);
        m.op(JOp.ALOAD_0, 1);
        m.load_local("I", i_slot);
        this.emit_invoke(JOp.INVOKEVIRTUAL, "java/lang/String", "charAt", "(I)C");
        this.iconst(46);
        m.branch(JOp.IF_ICMPNE, no_frac, 2);
        m.load_local("I", i_slot);
        this.iconst(1);
        m.op(JOp.IADD, -1);
        m.store_local("I", i_slot);
        fr_h: string = this.new_label("pd_frh");
        fr_low: string = this.new_label("pd_frlow");
        fr_x: string = this.new_label("pd_frx");
        m.mark(fr_h);
        m.load_local("I", i_slot);
        m.load_local("I", n_slot);
        m.branch(JOp.IF_ICMPGE, fr_x, 2);
        m.op(JOp.ALOAD_0, 1);
        m.load_local("I", i_slot);
        this.emit_invoke(JOp.INVOKEVIRTUAL, "java/lang/String", "charAt", "(I)C");
        m.store_local("I", c_slot);
        m.load_local("I", c_slot);
        this.iconst(48);
        m.branch(JOp.IF_ICMPLT, fr_low, 2);
        m.load_local("I", c_slot);
        this.iconst(57);
        m.branch(JOp.IF_ICMPGT, fr_x, 2);
        m.op(JOp.ICONST_1, 1);
        m.store_local("I", dig_slot);
        m.load_local("I", i_slot);
        this.iconst(1);
        m.op(JOp.IADD, -1);
        m.store_local("I", i_slot);
        m.branch(JOp.GOTO, fr_h, 0);
        m.mark(fr_low);
        m.branch(JOp.GOTO, fr_x, 0);
        m.mark(fr_x);
        m.branch(JOp.GOTO, no_frac, 0);
        m.mark(no_frac);
        // ---- no digits at all -> 0.0 -----------------------------------
        no_e: string = this.new_label("pd_noe");
        m.load_local("I", dig_slot);
        m.branch(JOp.IFNE, no_e, 1);
        m.op(JOp.DCONST_0, 2);
        m.op(JOp.DRETURN, -2);
        m.mark(no_e);
        // ---- optional exponent -----------------------------------------
        // ex_e: {branch(bounds), goto(not-e), goto(no-digits), goto(done)}
        ex_e: string = this.new_label("pd_exe");
        is_e: string = this.new_label("pd_ise");
        nd: string = this.new_label("pd_nd");
        nd_low: string = this.new_label("pd_ndlow");
        not_ps: string = this.new_label("pd_nps");
        nd_chk: string = this.new_label("pd_ndc");
        exp_scan: string = this.new_label("pd_esc");
        m.load_local("I", i_slot);
        m.load_local("I", n_slot);
        m.branch(JOp.IF_ICMPGE, ex_e, 2);
        m.op(JOp.ALOAD_0, 1);
        m.load_local("I", i_slot);
        this.emit_invoke(JOp.INVOKEVIRTUAL, "java/lang/String", "charAt", "(I)C");
        m.store_local("I", c_slot);
        m.load_local("I", c_slot);
        this.iconst(101);
        m.branch(JOp.IF_ICMPEQ, is_e, 2);
        m.load_local("I", c_slot);
        this.iconst(69);
        m.branch(JOp.IF_ICMPNE, ex_e, 2);
        m.mark(is_e);
        // j = i + 1; optional exp sign; require >= 1 digit else ignore.
        m.load_local("I", i_slot);
        this.iconst(1);
        m.op(JOp.IADD, -1);
        m.store_local("I", j_slot);
        m.load_local("I", j_slot);
        m.load_local("I", n_slot);
        m.branch(JOp.IF_ICMPGE, nd, 2);
        m.op(JOp.ALOAD_0, 1);
        m.load_local("I", j_slot);
        this.emit_invoke(JOp.INVOKEVIRTUAL, "java/lang/String", "charAt", "(I)C");
        m.store_local("I", c_slot);
        m.load_local("I", c_slot);
        this.iconst(43);
        m.branch(JOp.IF_ICMPNE, not_ps, 2);
        m.load_local("I", j_slot);
        this.iconst(1);
        m.op(JOp.IADD, -1);
        m.store_local("I", j_slot);
        m.branch(JOp.GOTO, nd, 0);
        m.mark(not_ps);
        m.load_local("I", c_slot);
        this.iconst(45);
        m.branch(JOp.IF_ICMPNE, nd_chk, 2);
        m.load_local("I", j_slot);
        this.iconst(1);
        m.op(JOp.IADD, -1);
        m.store_local("I", j_slot);
        m.mark(nd_chk);
        // digit check: funnel c2<'0' through nd_low so nd keeps <=2 branches
        m.load_local("I", j_slot);
        m.load_local("I", n_slot);
        m.branch(JOp.IF_ICMPGE, nd, 2);
        m.op(JOp.ALOAD_0, 1);
        m.load_local("I", j_slot);
        this.emit_invoke(JOp.INVOKEVIRTUAL, "java/lang/String", "charAt", "(I)C");
        m.store_local("I", c_slot);
        m.load_local("I", c_slot);
        this.iconst(48);
        m.branch(JOp.IF_ICMPLT, nd_low, 2);
        m.load_local("I", c_slot);
        this.iconst(57);
        m.branch(JOp.IF_ICMPGT, nd, 2);
        m.branch(JOp.GOTO, exp_scan, 0);
        m.mark(nd_low);
        m.branch(JOp.GOTO, nd, 0);
        m.mark(nd);
        // invalid exponent: ignore the 'e' (i unchanged) and finish.
        m.branch(JOp.GOTO, ex_e, 0);
        m.mark(exp_scan);
        // consume the remaining exp digits; i = j at the end.
        m.load_local("I", j_slot);
        this.iconst(1);
        m.op(JOp.IADD, -1);
        m.store_local("I", j_slot);
        es_h: string = this.new_label("pd_esh");
        es_low: string = this.new_label("pd_eslow");
        es_x: string = this.new_label("pd_esx");
        m.mark(es_h);
        m.load_local("I", j_slot);
        m.load_local("I", n_slot);
        m.branch(JOp.IF_ICMPGE, es_x, 2);
        m.op(JOp.ALOAD_0, 1);
        m.load_local("I", j_slot);
        this.emit_invoke(JOp.INVOKEVIRTUAL, "java/lang/String", "charAt", "(I)C");
        m.store_local("I", c_slot);
        m.load_local("I", c_slot);
        this.iconst(48);
        m.branch(JOp.IF_ICMPLT, es_low, 2);
        m.load_local("I", c_slot);
        this.iconst(57);
        m.branch(JOp.IF_ICMPGT, es_x, 2);
        m.load_local("I", j_slot);
        this.iconst(1);
        m.op(JOp.IADD, -1);
        m.store_local("I", j_slot);
        m.branch(JOp.GOTO, es_h, 0);
        m.mark(es_low);
        m.branch(JOp.GOTO, es_x, 0);
        m.mark(es_x);
        m.load_local("I", j_slot);
        m.store_local("I", i_slot);
        m.branch(JOp.GOTO, ex_e, 0);
        m.mark(ex_e);
        // ---- substring + parseDouble ------------------------------------
        m.op(JOp.ALOAD_0, 1);
        m.load_local("I", start_slot);
        m.load_local("I", i_slot);
        this.emit_invoke(JOp.INVOKEVIRTUAL, "java/lang/String", "substring", "(II)Ljava/lang/String;");
        this.emit_invoke(JOp.INVOKESTATIC, "java/lang/Double", "parseDouble", "(Ljava/lang/String;)D");
        m.op(JOp.DRETURN, -2);
        this.helper_end(cls);
    }

    // __stdin_line(prompt)String: print prompt, read one stdin line
    // ("" at EOF).
    pub fnc emit_stdin_line(cls JvmClass) : void {
        this.helper_start(cls, "__stdin_line", "(Ljava/lang/String;)Ljava/lang/String;");
        m: JvmMethod = this.cur_method;
        this.emit_getstatic_out();
        m.op(JOp.ALOAD_0, 1);
        this.emit_invoke(JOp.INVOKEVIRTUAL, "java/io/PrintStream", "print", "(Ljava/lang/String;)V");
        m.op(JOp.NEW, 1);
        bri: int = this.cur_cp.class_entry("java/io/BufferedReader");
        m.emit_u8((bri >> 8) & 255);
        m.emit_u8(bri & 255);
        m.op(JOp.DUP, 1);
        m.op(JOp.NEW, 1);
        isri: int = this.cur_cp.class_entry("java/io/InputStreamReader");
        m.emit_u8((isri >> 8) & 255);
        m.emit_u8(isri & 255);
        m.op(JOp.DUP, 1);
        this.emit_getstatic_sysin();
        this.emit_invoke(JOp.INVOKESPECIAL, "java/io/InputStreamReader", "<init>", "(Ljava/io/InputStream;)V");
        this.emit_invoke(JOp.INVOKESPECIAL, "java/io/BufferedReader", "<init>", "(Ljava/io/Reader;)V");
        this.emit_invoke(JOp.INVOKEVIRTUAL, "java/io/BufferedReader", "readLine", "()Ljava/lang/String;");
        null_lbl: string = this.new_label("sl_null");
        end_lbl: string = this.new_label("sl_end");
        m.op(JOp.DUP, 1);
        m.branch(JOp.IFNULL, null_lbl, 1);
        m.branch(JOp.GOTO, end_lbl, 0);
        m.mark(null_lbl);
        m.op(JOp.POP, -1);
        this.ldc_string("");
        m.mark(end_lbl);
        m.op(JOp.ARETURN, -1);
        this.helper_end(cls);
    }

    pub fnc emit_getstatic_sysin() : void {
        idx: int = this.cur_cp.fieldref("java/lang/System", "in", "Ljava/io/InputStream;");
        this.cur_method.op_field(JOp.GETSTATIC, idx, 1);
    }

    // ---- ChaCha20 CSPRNG helpers (RFC 8439, 64-bit ctr, zero nonce) ----
    // State: __rng_key [I (8 words), __rng_ctr J, __rng_buf [I (16 words),
    // __rng_pos I. seed(s) selects a deterministic stream identical to the
    // C runtime's stream for the same seed; unseeded draws pull key+ctr
    // from SecureRandom. All state-touching helpers are synchronized.

    pub fnc rng_get(name string, desc string) : void {
        idx: int = this.cur_cp.fieldref(this.main_class, name, desc);
        this.cur_method.op_field(JOp.GETSTATIC, idx, this.slots_of(desc));
    }

    pub fnc rng_put(name string, desc string) : void {
        idx: int = this.cur_cp.fieldref(this.main_class, name, desc);
        this.cur_method.op_field(JOp.PUTSTATIC, idx, 0 - this.slots_of(desc));
    }

    pub fnc rng_ldc_2p53() : void {
        idx: int = this.cur_cp.double_const(1128267776, 0);
        this.cur_method.emit_u8(JOp.LDC2_W);
        this.cur_method.emit_u8((idx >> 8) & 255);
        this.cur_method.emit_u8(idx & 255);
        this.cur_method.adjust(2);
    }

    pub fnc rng_qr_call(st int, i0 int, i1 int, i2 int, i3 int) : void {
        m: JvmMethod = this.cur_method;
        m.load_local("X", st);
        this.iconst(i0);
        this.iconst(i1);
        this.iconst(i2);
        this.iconst(i3);
        this.emit_invoke(JOp.INVOKESTATIC, this.main_class, "__rng_qr", "([IIIII)V");
    }

    // __rng_qr([I i0 i1 i2 i3)V — quarter round in place.
    pub fnc emit_rng_qr(cls JvmClass) : void {
        this.helper_start(cls, "__rng_qr", "([IIIII)V");
        m: JvmMethod = this.cur_method;
        m.access = m.access + JAcc.SYNCHRONIZED;
        a: int = m.alloc_local(1);
        b: int = m.alloc_local(1);
        c: int = m.alloc_local(1);
        d: int = m.alloc_local(1);
        t: int = m.alloc_local(1);
        li: int = 0;
        while li < 4 {
            m.op(JOp.ALOAD_0, 1);
            m.load_local("I", 1 + li);
            m.op(JOp.IALOAD, -1);
            m.store_local("I", a + li);
            li = li + 1;
        }
        // a += b; d ^= a; d = rotl(d, 16)
        m.load_local("I", a);
        m.load_local("I", b);
        m.op(JOp.IADD, -1);
        m.store_local("I", a);
        m.load_local("I", d);
        m.load_local("I", a);
        m.op(JOp.IXOR, -1);
        m.store_local("I", d);
        m.load_local("I", d);
        this.iconst(16);
        m.op(JOp.ISHL, -1);
        m.store_local("I", t);
        m.load_local("I", d);
        this.iconst(16);
        m.op(JOp.IUSHR, -1);
        m.load_local("I", t);
        m.op(JOp.IOR, -1);
        m.store_local("I", d);
        // c += d; b ^= c; b = rotl(b, 12)
        m.load_local("I", c);
        m.load_local("I", d);
        m.op(JOp.IADD, -1);
        m.store_local("I", c);
        m.load_local("I", b);
        m.load_local("I", c);
        m.op(JOp.IXOR, -1);
        m.store_local("I", b);
        m.load_local("I", b);
        this.iconst(12);
        m.op(JOp.ISHL, -1);
        m.store_local("I", t);
        m.load_local("I", b);
        this.iconst(20);
        m.op(JOp.IUSHR, -1);
        m.load_local("I", t);
        m.op(JOp.IOR, -1);
        m.store_local("I", b);
        // a += b; d ^= a; d = rotl(d, 8)
        m.load_local("I", a);
        m.load_local("I", b);
        m.op(JOp.IADD, -1);
        m.store_local("I", a);
        m.load_local("I", d);
        m.load_local("I", a);
        m.op(JOp.IXOR, -1);
        m.store_local("I", d);
        m.load_local("I", d);
        this.iconst(8);
        m.op(JOp.ISHL, -1);
        m.store_local("I", t);
        m.load_local("I", d);
        this.iconst(24);
        m.op(JOp.IUSHR, -1);
        m.load_local("I", t);
        m.op(JOp.IOR, -1);
        m.store_local("I", d);
        // c += d; b ^= c; b = rotl(b, 7)
        m.load_local("I", c);
        m.load_local("I", d);
        m.op(JOp.IADD, -1);
        m.store_local("I", c);
        m.load_local("I", b);
        m.load_local("I", c);
        m.op(JOp.IXOR, -1);
        m.store_local("I", b);
        m.load_local("I", b);
        this.iconst(7);
        m.op(JOp.ISHL, -1);
        m.store_local("I", t);
        m.load_local("I", b);
        this.iconst(25);
        m.op(JOp.IUSHR, -1);
        m.load_local("I", t);
        m.op(JOp.IOR, -1);
        m.store_local("I", b);
        li = 0;
        while li < 4 {
            m.op(JOp.ALOAD_0, 1);
            m.load_local("I", 1 + li);
            m.load_local("I", a + li);
            m.op(JOp.IASTORE, -3);
            li = li + 1;
        }
        m.op(JOp.RETURN, 0);
        this.helper_end(cls);
    }

    // __rng_block()V — one block into __rng_buf (buf doubles as the
    // seed-derivation scratch), ctr++, pos = 0.
    pub fnc emit_rng_block(cls JvmClass) : void {
        this.helper_start(cls, "__rng_block", "()V");
        m: JvmMethod = this.cur_method;
        m.access = m.access + JAcc.SYNCHRONIZED;
        st: int = m.alloc_local(1);
        this.iconst(16);
        m.op_1(JOp.NEWARRAY, JArray.T_INT, 0);
        m.store_local("X", st);
        m.load_local("X", st);
        this.iconst(0);
        this.iconst(1634760805);
        m.op(JOp.IASTORE, -3);
        m.load_local("X", st);
        this.iconst(1);
        this.iconst(857760878);
        m.op(JOp.IASTORE, -3);
        m.load_local("X", st);
        this.iconst(2);
        this.iconst(2036477234);
        m.op(JOp.IASTORE, -3);
        m.load_local("X", st);
        this.iconst(3);
        this.iconst(1797285236);
        m.op(JOp.IASTORE, -3);
        kj: int = 0;
        while kj < 8 {
            m.load_local("X", st);
            this.iconst(4 + kj);
            this.rng_get("__rng_key", "[I");
            this.iconst(kj);
            m.op(JOp.IALOAD, -1);
            m.op(JOp.IASTORE, -3);
            kj = kj + 1;
        }
        m.load_local("X", st);
        this.iconst(12);
        this.rng_get("__rng_ctr", "J");
        m.op(JOp.L2I, -1);
        m.op(JOp.IASTORE, -3);
        m.load_local("X", st);
        this.iconst(13);
        this.rng_get("__rng_ctr", "J");
        this.iconst(32);
        m.op(JOp.LUSHR, -1);
        m.op(JOp.L2I, -1);
        m.op(JOp.IASTORE, -3);
        m.load_local("X", st);
        this.iconst(14);
        this.iconst(0);
        m.op(JOp.IASTORE, -3);
        m.load_local("X", st);
        this.iconst(15);
        this.iconst(0);
        m.op(JOp.IASTORE, -3);
        // buf = working copy of the initial state (rounds mutate buf).
        cj: int = 0;
        while cj < 16 {
            this.rng_get("__rng_buf", "[I");
            this.iconst(cj);
            m.load_local("X", st);
            this.iconst(cj);
            m.op(JOp.IALOAD, -1);
            m.op(JOp.IASTORE, -3);
            cj = cj + 1;
        }
        r: int = 0;
        while r < 10 {
            this.rng_qr_call(st, 0, 4, 8, 12);
            this.rng_qr_call(st, 1, 5, 9, 13);
            this.rng_qr_call(st, 2, 6, 10, 14);
            this.rng_qr_call(st, 3, 7, 11, 15);
            this.rng_qr_call(st, 0, 5, 10, 15);
            this.rng_qr_call(st, 1, 6, 11, 12);
            this.rng_qr_call(st, 2, 7, 8, 13);
            this.rng_qr_call(st, 3, 4, 9, 14);
            r = r + 1;
        }
        this.rng_get("__rng_ctr", "J");
        this.long_const(0, 1);
        m.op(JOp.LADD, -2);
        this.rng_put("__rng_ctr", "J");
        this.iconst(0);
        this.rng_put("__rng_pos", "I");
        fj: int = 0;
        while fj < 16 {
            this.rng_get("__rng_buf", "[I");
            this.iconst(fj);
            this.rng_get("__rng_buf", "[I");
            this.iconst(fj);
            m.op(JOp.IALOAD, -1);
            m.load_local("X", st);
            this.iconst(fj);
            m.op(JOp.IALOAD, -1);
            m.op(JOp.IADD, -1);
            m.op(JOp.IASTORE, -3);
            fj = fj + 1;
        }
        m.op(JOp.RETURN, 0);
        this.helper_end(cls);
    }

    // __rng_entropy()V — allocate state, key from SecureRandom.
    pub fnc emit_rng_entropy(cls JvmClass) : void {
        this.helper_start(cls, "__rng_entropy", "()V");
        m: JvmMethod = this.cur_method;
        m.access = m.access + JAcc.SYNCHRONIZED;
        sr: int = m.alloc_local(1);
        this.iconst(16);
        m.op_1(JOp.NEWARRAY, JArray.T_INT, 0);
        this.rng_put("__rng_buf", "[I");
        this.iconst(8);
        m.op_1(JOp.NEWARRAY, JArray.T_INT, 0);
        this.rng_put("__rng_key", "[I");
        m.op(JOp.NEW, 1);
        si: int = this.cur_cp.class_entry("java/security/SecureRandom");
        m.emit_u8((si >> 8) & 255);
        m.emit_u8(si & 255);
        m.op(JOp.DUP, 1);
        this.emit_invoke(JOp.INVOKESPECIAL, "java/security/SecureRandom", "<init>", "()V");
        m.store_local("X", sr);
        kj: int = 0;
        while kj < 8 {
            this.rng_get("__rng_key", "[I");
            this.iconst(kj);
            m.load_local("X", sr);
            this.emit_invoke(JOp.INVOKEVIRTUAL, "java/security/SecureRandom", "nextInt", "()I");
            m.op(JOp.IASTORE, -3);
            kj = kj + 1;
        }
        m.load_local("X", sr);
        this.emit_invoke(JOp.INVOKEVIRTUAL, "java/security/SecureRandom", "nextLong", "()J");
        this.rng_put("__rng_ctr", "J");
        this.iconst(16);
        this.rng_put("__rng_pos", "I");
        m.op(JOp.RETURN, 0);
        this.helper_end(cls);
    }

    // __rng_next()J — one uniform 64-bit draw (two LE keystream words).
    pub fnc emit_rng_next(cls JvmClass) : void {
        this.helper_start(cls, "__rng_next", "()J");
        m: JvmMethod = this.cur_method;
        m.access = m.access + JAcc.SYNCHRONIZED;
        w_lo: int = m.alloc_local(1);
        w_hi: int = m.alloc_local(1);
        ent_lbl: string = this.new_label("rn_ent");
        have_lbl: string = this.new_label("rn_have");
        ref_lbl: string = this.new_label("rn_ref");
        draw_lbl: string = this.new_label("rn_draw");
        this.rng_get("__rng_buf", "[I");
        m.branch(JOp.IFNULL, ent_lbl, 1);
        m.branch(JOp.GOTO, have_lbl, 0);
        m.mark(ent_lbl);
        this.emit_invoke(JOp.INVOKESTATIC, this.main_class, "__rng_entropy", "()V");
        m.mark(have_lbl);
        this.rng_get("__rng_pos", "I");
        this.iconst(16);
        m.branch(JOp.IF_ICMPGE, ref_lbl, 2);
        m.branch(JOp.GOTO, draw_lbl, 0);
        m.mark(ref_lbl);
        this.emit_invoke(JOp.INVOKESTATIC, this.main_class, "__rng_block", "()V");
        m.mark(draw_lbl);
        this.rng_get("__rng_buf", "[I");
        this.rng_get("__rng_pos", "I");
        m.op(JOp.IALOAD, -1);
        m.store_local("I", w_lo);
        this.rng_get("__rng_pos", "I");
        this.iconst(1);
        m.op(JOp.IADD, -1);
        this.rng_put("__rng_pos", "I");
        this.rng_get("__rng_buf", "[I");
        this.rng_get("__rng_pos", "I");
        m.op(JOp.IALOAD, -1);
        m.store_local("I", w_hi);
        this.rng_get("__rng_pos", "I");
        this.iconst(1);
        m.op(JOp.IADD, -1);
        this.rng_put("__rng_pos", "I");
        m.load_local("I", w_hi);
        m.op(JOp.I2L, 1);
        this.long_const(0, 0 - 1);
        m.op(JOp.LAND, -2);
        this.iconst(32);
        m.op(JOp.LSHL, -1);
        m.load_local("I", w_lo);
        m.op(JOp.I2L, 1);
        this.long_const(0, 0 - 1);
        m.op(JOp.LAND, -2);
        m.op(JOp.LOR, -2);
        m.op(JOp.LRETURN, -2);
        this.helper_end(cls);
    }

    // Random + choose helpers over the ChaCha20 stream.
    pub fnc emit_rand_helpers(cls JvmClass) : void {
        this.emit_rng_qr(cls);
        this.emit_rng_block(cls);
        this.emit_rng_entropy(cls);
        this.emit_rng_next(cls);
        // __rand_seed(J)V — deterministic stream (C-runtime parity).
        this.helper_start(cls, "__rand_seed", "(J)V");
        m: JvmMethod = this.cur_method;
        m.access = m.access + JAcc.SYNCHRONIZED;
        nul_lbl: string = this.new_label("rs_nul");
        have_lbl: string = this.new_label("rs_have");
        this.rng_get("__rng_buf", "[I");
        m.branch(JOp.IFNULL, nul_lbl, 1);
        m.branch(JOp.GOTO, have_lbl, 0);
        m.mark(nul_lbl);
        this.iconst(16);
        m.op_1(JOp.NEWARRAY, JArray.T_INT, 0);
        this.rng_put("__rng_buf", "[I");
        this.iconst(8);
        m.op_1(JOp.NEWARRAY, JArray.T_INT, 0);
        this.rng_put("__rng_key", "[I");
        m.mark(have_lbl);
        kj: int = 0;
        while kj < 8 {
            this.rng_get("__rng_key", "[I");
            this.iconst(kj);
            this.iconst(0);
            m.op(JOp.IASTORE, -3);
            kj = kj + 1;
        }
        m.op(JOp.LLOAD_0, 2);
        this.rng_put("__rng_ctr", "J");
        this.emit_invoke(JOp.INVOKESTATIC, this.main_class, "__rng_block", "()V");
        kj = 0;
        while kj < 8 {
            this.rng_get("__rng_key", "[I");
            this.iconst(kj);
            this.rng_get("__rng_buf", "[I");
            this.iconst(kj);
            m.op(JOp.IALOAD, -1);
            m.op(JOp.IASTORE, -3);
            kj = kj + 1;
        }
        this.long_const(0, 1);
        this.rng_put("__rng_ctr", "J");
        this.iconst(16);
        this.rng_put("__rng_pos", "I");
        m.op(JOp.RETURN, 0);
        this.helper_end(cls);
        // __rand_range(JJ)J: inclusive; max<min yields min.
        this.helper_start(cls, "__rand_range", "(JJ)J");
        m = this.cur_method;
        m.access = m.access + JAcc.SYNCHRONIZED;
        lo: int = m.alloc_local(2);
        hi: int = m.alloc_local(2);
        range: int = m.alloc_local(2);
        rv: int = m.alloc_local(2);
        lim: int = m.alloc_local(2);
        m.op(JOp.LLOAD_0, 2);
        m.store_local("J", lo);
        m.op(JOp.LLOAD_2, 2);
        m.store_local("J", hi);
        ge_lbl: string = this.new_label("rr_ge");
        pos_lbl: string = this.new_label("rr_pos");
        small_lbl: string = this.new_label("rr_small");
        retry_lbl: string = this.new_label("rr_retry");
        m.load_local("J", hi);
        m.load_local("J", lo);
        m.op(JOp.LCMP, -3);
        m.branch(JOp.IFGE, ge_lbl, 1);
        m.load_local("J", lo);
        m.op(JOp.LRETURN, -2);
        m.mark(ge_lbl);
        m.load_local("J", hi);
        m.load_local("J", lo);
        m.op(JOp.LSUB, -2);
        this.long_const(0, 1);
        m.op(JOp.LADD, -2);
        m.store_local("J", range);
        // Wrapped span (range <= 0): fall back to modulus 2^63-1.
        m.load_local("J", range);
        this.long_const(0, 0);
        m.op(JOp.LCMP, -3);
        m.branch(JOp.IFGT, pos_lbl, 1);
        this.long_const(2147483647, 0 - 1);
        m.store_local("J", range);
        m.mark(pos_lbl);
        // range > 2^62: 63-bit draw (rejection would starve).
        m.load_local("J", range);
        this.long_const(1073741824, 0);
        m.op(JOp.LCMP, -3);
        m.branch(JOp.IFLE, small_lbl, 1);
        this.emit_invoke(JOp.INVOKESTATIC, this.main_class, "__rng_next", "()J");
        this.long_const(2147483647, 0 - 1);
        m.op(JOp.LAND, -2);
        m.store_local("J", rv);
        m.load_local("J", rv);
        m.load_local("J", range);
        m.op(JOp.LREM, -2);
        m.load_local("J", lo);
        m.op(JOp.LADD, -2);
        m.op(JOp.LRETURN, -2);
        m.mark(small_lbl);
        // 62-bit rejection sampling (Lemire-style, unbiased).
        this.long_const(1073741824, 0);
        this.long_const(1073741824, 0);
        m.load_local("J", range);
        m.op(JOp.LREM, -2);
        m.op(JOp.LSUB, -2);
        m.store_local("J", lim);
        m.branch(JOp.GOTO, retry_lbl, 0);
        m.mark(retry_lbl);
        this.emit_invoke(JOp.INVOKESTATIC, this.main_class, "__rng_next", "()J");
        this.long_const(1073741823, 0 - 1);
        m.op(JOp.LAND, -2);
        m.store_local("J", rv);
        m.load_local("J", rv);
        m.load_local("J", lim);
        m.op(JOp.LCMP, -3);
        m.branch(JOp.IFGE, retry_lbl, 1);
        m.load_local("J", lo);
        m.load_local("J", rv);
        m.load_local("J", range);
        m.op(JOp.LREM, -2);
        m.op(JOp.LADD, -2);
        m.op(JOp.LRETURN, -2);
        this.helper_end(cls);
        // __randf_range(DD)D
        this.helper_start(cls, "__randf_range", "(DD)D");
        m = this.cur_method;
        m.access = m.access + JAcc.SYNCHRONIZED;
        fmin: int = m.alloc_local(2);
        fmax: int = m.alloc_local(2);
        m.op(JOp.DLOAD_0, 2);
        m.store_local("D", fmin);
        m.op(JOp.DLOAD_2, 2);
        m.store_local("D", fmax);
        this.emit_invoke(JOp.INVOKESTATIC, this.main_class, "__rng_next", "()J");
        this.iconst(11);
        m.op(JOp.LUSHR, -1);
        m.op(JOp.L2D, 0);
        this.rng_ldc_2p53();
        m.op(JOp.DDIV, -2);
        m.load_local("D", fmax);
        m.load_local("D", fmin);
        m.op(JOp.DSUB, -2);
        m.op(JOp.DMUL, -2);
        m.load_local("D", fmin);
        m.op(JOp.DADD, -2);
        m.op(JOp.DRETURN, -2);
        this.helper_end(cls);
        // __choose([String])String: random element (null when empty).
        this.helper_start(cls, "__choose", "([Ljava/lang/Object;)Ljava/lang/String;");
        m = this.cur_method;
        m.access = m.access + JAcc.SYNCHRONIZED;
        m.op(JOp.ALOAD_0, 1);
        m.op(JOp.ARRAYLENGTH, 0);
        ne_lbl: string = this.new_label("ch_ne");
        m.branch(JOp.IFNE, ne_lbl, 1);
        m.op(JOp.ACONST_NULL, 1);
        m.op(JOp.ARETURN, -1);
        m.mark(ne_lbl);
        m.op(JOp.LCONST_0, 2);
        m.op(JOp.ALOAD_0, 1);
        m.op(JOp.ARRAYLENGTH, 0);
        m.op(JOp.I2L, 1);
        this.long_const(0, 1);
        m.op(JOp.LSUB, -2);
        this.emit_invoke(JOp.INVOKESTATIC, this.main_class, "__rand_range", "(JJ)J");
        m.op(JOp.L2I, -1);
        ix: int = m.alloc_local(1);
        m.store_local("I", ix);
        m.op(JOp.ALOAD_0, 1);
        m.load_local("I", ix);
        m.op(JOp.AALOAD, -1);
        this.emit_checkcast("java/lang/String");
        m.op(JOp.ARETURN, -1);
        this.helper_end(cls);
    }

    // __wait_secs(D)V and __timepass()D over field __t0 (entry-set).
    pub fnc emit_time_helpers(cls JvmClass) : void {
        this.helper_start(cls, "__wait_secs", "(D)V");
        m: JvmMethod = this.cur_method;
        ret_lbl: string = this.new_label("wt_ret");
        m.op(JOp.DLOAD_0, 2);
        m.op(JOp.DCONST_0, 2);
        m.op(JOp.DCMPL, -3);
        m.branch(JOp.IFLE, ret_lbl, 1);
        m.op(JOp.DLOAD_0, 2);
        this.ldc_double(1000.0);
        m.op(JOp.DMUL, -2);
        m.op(JOp.D2L, 0);
        this.emit_invoke(JOp.INVOKESTATIC, "java/lang/Thread", "sleep", "(J)V");
        m.mark(ret_lbl);
        m.op(JOp.RETURN, 0);
        this.helper_end(cls);
        this.helper_start(cls, "__timepass", "()D");
        m = this.cur_method;
        this.emit_invoke(JOp.INVOKESTATIC, "java/lang/System", "nanoTime", "()J");
        idx: int = this.cur_cp.fieldref(this.main_class, "__t0", "J");
        m.op_field(JOp.GETSTATIC, idx, 2);
        m.op(JOp.LSUB, -2);
        m.op(JOp.L2D, 0);
        this.ldc_double(1000000000.0);
        m.op(JOp.DDIV, -2);
        m.op(JOp.DRETURN, -2);
        this.helper_end(cls);
    }

    pub fnc ldc_double(v float) : void {
        this.ldc_string(tostring(v));
        this.emit_invoke(JOp.INVOKESTATIC, "java/lang/Double", "parseDouble", "(Ljava/lang/String;)D");
    }

    // ---- Coercions / statement / entry helpers (restored) --------------

    pub fnc gen_ternary(e Expr) : void {
        t_lbl: string = this.new_label("tern_t");
        e_lbl: string = this.new_label("tern_e");
        lt: string = this.expr_type(e.left);
        rt: string = this.expr_type(e.right);
        res_t: string = this.expr_type(e);
        this.gen_truthy(e.cond, t_lbl);
        this.gen_expr(e.right);
        this.jvm_coerce(rt, res_t);
        this.narrow_to(res_t);
        this.cur_method.branch(JOp.GOTO, e_lbl, 0);
        this.cur_method.mark(t_lbl);
        this.gen_expr(e.left);
        this.jvm_coerce(lt, res_t);
        this.narrow_to(res_t);
        this.cur_method.mark(e_lbl);
    }

    // --- Statements ---------------------------------------------------
    pub fnc gen_block(stmts vec<Stmt>) : void {
        foreach _, s in<vector> stmts {
            this.gen_statement(s);
        }
    }

    pub fnc drain_defers() : void {
        di: int = this.defer_stack.size - 1;
        while di >= 0 {
            this.gen_statement(this.defer_stack.get(di));
            di = di - 1;
        }
    }

    pub fnc jvm_tostring(t string) : void {
        if t == "pointer<char>" || t == "*char" { return; }
        if t == "char[]" {
            this.emit_string_from_chars();
            return;
        }
        if this.is_bigint(t) {
            this.emit_invoke(JOp.INVOKEVIRTUAL, "java/math/BigInteger", "toString", "()Ljava/lang/String;");
            return;
        }
        if this.tc.unions.isin(t) {
            us: int = this.cur_method.alloc_local(1);
            this.cur_method.store_local("X", us);
            this.cur_method.load_local("X", us);
            this.gen_union_tostring(t);
            return;
        }
        d: string = this.jdesc(t);
        if d == "Ljava/lang/String;" { return; }
        if d == "I" {
            // tostring(char) is the code point (81 for 'Q'), not "Q".
            // Unsigned ints render the full range (native parity).
            if this.is_uint_leash(t) {
                this.emit_invoke(JOp.INVOKESTATIC, "java/lang/Integer", "toUnsignedString", "(I)Ljava/lang/String;");
            } else {
                this.emit_invoke(JOp.INVOKESTATIC, "java/lang/Integer", "toString", "(I)Ljava/lang/String;");
            }
            return;
        }
        if d == "J" {
            if this.is_uint_leash(t) {
                this.emit_invoke(JOp.INVOKESTATIC, "java/lang/Long", "toUnsignedString", "(J)Ljava/lang/String;");
            } else {
                this.emit_invoke(JOp.INVOKESTATIC, "java/lang/Long", "toString", "(J)Ljava/lang/String;");
            }
            return;
        }
        if d == "D" {
            // String.format(ROOT, "%.6f", new Object[]{ box(d) }).
            this.box_top("D");
            tslot: int = this.cur_method.temp_slot("Ljava/lang/Object;");
            this.cur_method.store_local("Ljava/lang/Object;", tslot);
            this.emit_locale_root();
            this.ldc_string("%.6f");
            this.iconst(1);
            this.emit_anewarray_object(1);
            this.cur_method.op(JOp.DUP, 1);
            this.iconst(0);
            this.cur_method.load_local("Ljava/lang/Object;", tslot);
            this.cur_method.op(JOp.AASTORE, -3);
            this.emit_invoke(JOp.INVOKESTATIC, "java/lang/String", "format", "(Ljava/util/Locale;Ljava/lang/String;[Ljava/lang/Object;)Ljava/lang/String;");
            return;
        }
        if d == "Z" {
            this.emit_invoke(JOp.INVOKESTATIC, "java/lang/Boolean", "toString", "(Z)Ljava/lang/String;");
            return;
        }
        this.jvm_unsupported("tostring() of '" + t + "'");
    }

    // Emit an invoke with stack-depth accounting parsed from the
    // descriptor: (params)ret. Long/double count two slots.
    pub fnc emit_invoke(op int, cls string, name string, desc string) : void {
        idx: int = 0;
        if op == JOp.INVOKEINTERFACE {
            idx = this.cur_cp.imethodref(cls, name, desc);
        } else {
            idx = this.cur_cp.methodref(cls, name, desc);
        }
        pop: int = 0;
        i: int = 1;
        while i < desc.size && desc[i] != ')' {
            c: char = desc[i];
            if c == 'J' || c == 'D' {
                pop = pop + 2;
                i = i + 1;
            } also c == 'L' {
                pop = pop + 1;
                while i < desc.size && desc[i] != ';' { i = i + 1; }
                i = i + 1;
            } also c == '[' {
                pop = pop + 1;
                while i < desc.size && (desc[i] == '[') { i = i + 1; }
                if i < desc.size && desc[i] == 'L' {
                    while i < desc.size && desc[i] != ';' { i = i + 1; }
                }
                i = i + 1;
            } else {
                pop = pop + 1;
                i = i + 1;
            }
        }
        push: int = 0;
        ri: int = 0;
        while ri < desc.size && desc[ri] != ')' { ri = ri + 1; }
        ri = ri + 1;
        if ri < desc.size {
            rc: char = desc[ri];
            if rc == 'J' || rc == 'D' { push = 2; }
            also rc != 'V' { push = 1; }
        }
        if op != JOp.INVOKESTATIC { pop = pop + 1; }
        this.cur_method.emit_u8(op);
        this.cur_method.emit_u8((idx >> 8) & 255);
        this.cur_method.emit_u8(idx & 255);
        if op == JOp.INVOKEINTERFACE {
            // 5-byte form: count (incl. receiver) + zero pad.
            this.cur_method.emit_u8(pop);
            this.cur_method.emit_u8(0);
            this.cur_method.site_delta.push(this.cur_method.code.size - 5, push - pop);
        } else {
            this.cur_method.site_delta.push(this.cur_method.code.size - 3, push - pop);
        }
        this.cur_method.adjust(push - pop);
    }

    pub fnc emit_putstatic(name string, gd string) : void {
        idx: int = this.cur_cp.fieldref(this.main_class, "g_" + name, gd);
        this.cur_method.op_field(JOp.PUTSTATIC, idx, 0 - this.slots_of(gd));
    }

    pub fnc is_fusion_int(name string, gt string) : bool {
        if !this.fusion_names.isin(name) { return false; }
        gd: string = this.jdesc(gt);
        if gd != "I" && gd != "J" { return false; }
        w: int = 32;
        if gd == "J" { w = 64; }
        else {
            if gt == "int<8>" || gt == "uint<8>" { w = 8; }
            also gt == "int<16>" || gt == "uint<16>" { w = 16; }
        }
        if w < 8 { return false; }
        if w % 8 != 0 { return false; }
        return true;
    }

    pub fnc jvm_default(d string) : void {
        if d == "J" {
            this.cur_method.op(JOp.LCONST_0, 2);
        } also d == "D" {
            this.cur_method.op(JOp.DCONST_0, 2);
        } also d == "Z" || d == "I" || d == "B" || d == "S" || d == "C" {
            this.cur_method.op(JOp.ICONST_0, 1);
        } else {
            this.cur_method.op(JOp.ACONST_NULL, 1);
        }
    }

    // Constructed zero value for a leash type: containers and sized
    // arrays allocate; everything else is the plain default.
    pub fnc jvm_default_for(t string) : void {
        if this.tc.unions.isin(t) {
            this.gen_union_default(t);
            return;
        }
        if t == "string" {
            // Native parity: uninitialized strings behave as "" (and are
            // != null); the GC zeroes the slot the same way.
            this.ldc_string("");
            return;
        }
        rt: string = this.resolve_class_ref(t);
        if this.tc.structs.isin(rt) || this.tc.classes.isin(rt) {
            // Native parity: uninitialized struct/class locals are default
            // constructed (never null); the emitted <init> builds the
            // container fields.
            this.cur_method.op(JOp.NEW, 1);
            ci: int = this.cur_cp.class_entry(rt);
            this.cur_method.emit_u8((ci >> 8) & 255);
            this.cur_method.emit_u8(ci & 255);
            this.cur_method.op(JOp.DUP, 1);
            this.emit_invoke(JOp.INVOKESPECIAL, rt, "<init>", "()V");
            if this.tc.classes.isin(rt) {
                // Auto-init (native parity): `p: C;` runs the all-defaults
                // constructor when every parameter has a default.
                if this.tc.ctor_defaults.isin(rt) {
                    ndef: vec<Expr> = this.tc.ctor_defaults[rt];
                    all_dflt: bool = ndef.size > 0;
                    di: int = 0;
                    while di < ndef.size {
                        if ndef.get(di) == null { all_dflt = false; }
                        di = di + 1;
                    }
                    if all_dflt {
                        this.cur_method.op(JOp.DUP, 1);
                        no_args: vec<Expr>;
                        this.gen_ctor_call(rt, no_args);
                    }
                }
            }
            return;
        }
        d: string = this.jdesc(t);
        if d == "Ljava/util/ArrayList;" {
            this.emit_new_list();
            return;
        }
        if d == "Ljava/util/HashMap;" {
            this.emit_new_map();
            return;
        }
        if d.size > 0 && d[0] == '[' {
            n: int = this.array_size_of(t);
            if n >= 0 {
                this.emit_new_array(t, n);
                return;
            }
        }
        this.jvm_default(d);
    }

    pub fnc emit_new_list() : void {
        this.cur_method.op(JOp.NEW, 1);
        ali: int = this.cur_cp.class_entry("java/util/ArrayList");
        this.cur_method.emit_u8((ali >> 8) & 255);
        this.cur_method.emit_u8(ali & 255);
        this.cur_method.op(JOp.DUP, 1);
        this.emit_invoke(JOp.INVOKESPECIAL, "java/util/ArrayList", "<init>", "()V");
    }

    pub fnc emit_new_map() : void {
        // LinkedHashMap: insertion order (native runtime parity).
        this.cur_method.op(JOp.NEW, 1);
        ali: int = this.cur_cp.class_entry("java/util/LinkedHashMap");
        this.cur_method.emit_u8((ali >> 8) & 255);
        this.cur_method.emit_u8(ali & 255);
        this.cur_method.op(JOp.DUP, 1);
        this.emit_invoke(JOp.INVOKESPECIAL, "java/util/LinkedHashMap", "<init>", "()V");
    }

    // Fixed-size array size from "T[N]" (-1 for slices/unknown).
    pub fnc array_size_of(t string) : int {
        i: int = 0;
        while i < t.size && t[i] != '[' { i = i + 1; }
        if i >= t.size - 1 { return -1; }
        i = i + 1;
        if i < t.size && t[i] == ']' { return -1; }
        n: int = 0;
        while i < t.size && t[i] != ']' {
            c: char = t[i];
            if c < '0' || c > '9' { return -1; }
            n = n * 10 + (c - '0');
            i = i + 1;
        }
        return n;
    }

    pub fnc array_base_of(t string) : string {
        base: string = "";
        i: int = 0;
        while i < t.size && t[i] != '[' {
            base = base + t[i];
            i = i + 1;
        }
        return base;
    }

    pub fnc emit_new_array(t string, n int) : void {
        base: string = this.array_base_of(t);
        bd: string = this.jdesc(base);
        this.iconst(n);
        if bd == "J" {
            this.cur_method.op_1(JOp.NEWARRAY, JArray.T_LONG, 0);
            this.cur_method.adjust(0);
        } also bd == "D" {
            this.cur_method.op_1(JOp.NEWARRAY, JArray.T_DOUBLE, 0);
            this.cur_method.adjust(0);
        } also bd == "Z" {
            this.cur_method.op_1(JOp.NEWARRAY, JArray.T_BOOLEAN, 0);
            this.cur_method.adjust(0);
        } also base == "char" || bd == "C" {
            this.cur_method.op_1(JOp.NEWARRAY, JArray.T_CHAR, 0);
            this.cur_method.adjust(0);
        } also bd == "I" {
            this.cur_method.op_1(JOp.NEWARRAY, JArray.T_INT, 0);
            this.cur_method.adjust(0);
        } else {
            elem: string = bd;
            if bd == "Ljava/lang/String;" { elem = "java/lang/String"; }
            also bd == "Ljava/util/ArrayList;" { elem = "java/util/ArrayList"; }
            also bd == "Ljava/util/HashMap;" { elem = "java/util/HashMap"; }
            also bd.size > 0 && bd[0] == '[' {
                inner: string = "";
                k: int = 1;
                while k < bd.size {
                    inner = inner + bd[k];
                    k = k + 1;
                }
                elem = "[" + inner;
            } also bd.size > 0 && bd[0] == 'L' {
                inner: string = "";
                k: int = 1;
                while k < bd.size - 1 {
                    inner = inner + bd[k];
                    k = k + 1;
                }
                elem = inner;
            }
            ci: int = this.cur_cp.class_entry(elem);
            this.cur_method.emit_u8(JOp.ANEWARRAY);
            this.cur_method.emit_u8((ci >> 8) & 255);
            this.cur_method.emit_u8(ci & 255);
            this.cur_method.adjust(0);
        }
    }


    // Push the AtomicInteger/AtomicLong backing a fusion global.
    pub fnc fusion_ref(name string, gd string) : void {
        cls: string = "java/util/concurrent/atomic/AtomicInteger";
        if gd == "J" { cls = "java/util/concurrent/atomic/AtomicLong"; }
        idx: int = this.cur_cp.fieldref(this.main_class, "g_" + name, "L" + cls + ";");
        this.cur_method.op_field(JOp.GETSTATIC, idx, 1);
    }

    pub fnc fusion_get(name string, gt string, gd string) : void {
        this.fusion_ref(name, gd);
        if gd == "J" {
            this.emit_invoke(JOp.INVOKEVIRTUAL, "java/util/concurrent/atomic/AtomicLong", "get", "()J");
        } else {
            this.emit_invoke(JOp.INVOKEVIRTUAL, "java/util/concurrent/atomic/AtomicInteger", "get", "()I");
        }
        this.narrow_to(gt);
    }


    // --- Statements ---------------------------------------------------
    pub fnc gen_statement(s Stmt) : void {
        if s == null { return; }
        if s.kind == StmtKind.VAR_DECL {
            vtyp: string = s.var_type;
            if vtyp.size == 0 && s.value != null {
                // Inferred locals (multi-assign temps): use the init type.
                vtyp = this.expr_type(s.value);
            }
            vd: string = this.jdesc(vtyp);
            if vd.size == 0 {
                this.jvm_unsupported("variable of type '" + vtyp + "'");
                return;
            }
            slot: int = this.cur_method.alloc_local(this.slots_of(vd));
            this.define_var(s.name, vtyp, slot);
            if s.value != null {
                is_arrlit: bool = s.value.kind == ExprKind.ARRAY_LIT && vtyp.size >= 2 && vtyp[vtyp.size - 1] == ']';
                if is_arrlit {
                    this.array_base_override = this.array_base_of(vtyp);
                }
                it: string = this.expr_type(s.value);
                this.gen_expr(s.value);
                this.array_base_override = "";
                if !this.coerce_val(it, vtyp) {
                    this.jvm_coerce(it, vtyp);
                    this.narrow_to(vtyp);
                }
                // Struct value init copies (native value semantics).
                if this.tc.structs.isin(vtyp) && this.tc.structs.isin(this.deref_t(it)) {
                    this.gen_struct_copy(vtyp);
                }
                this.cur_method.store_local(vd, slot);
            } else {
                this.jvm_default_for(vtyp);
                this.cur_method.store_local(vd, slot);
            }
            return;
        }
        if s.kind == StmtKind.ASSIGN {
            this.gen_assign(s);
            return;
        }
        if s.kind == StmtKind.SHOW {
            ai: int = 0;
            while ai < s.args.size {
                this.gen_show_arg_buf(s.args.get(ai), s.is_showb);
                ai = ai + 1;
            }
            if !s.is_showb {
                if s.show_end == "\n" {
                    this.emit_println();
                } also s.show_end.size > 0 {
                    this.emit_getstatic_out();
                    this.ldc_string(s.show_end);
                    this.emit_invoke(JOp.INVOKEVIRTUAL, "java/io/PrintStream", "print", "(Ljava/lang/String;)V");
                }
            }
            return;
        }
        if s.kind == StmtKind.RETURN {
            if s.value != null {
                vt: string = this.expr_type(s.value);
                this.gen_expr(s.value);
                if !this.coerce_val(vt, this.current_func_ret) {
                    this.jvm_coerce(vt, this.current_func_ret);
                    this.narrow_to(this.current_func_ret);
                }
            }
            this.drain_defers();
            rd: string = this.jdesc(this.current_func_ret);
            if rd == "V" {
                this.cur_method.op(JOp.RETURN, 0);
            } also rd == "J" || rd == "D" {
                if rd == "J" {
                    this.cur_method.op(JOp.LRETURN, -2);
                } else {
                    this.cur_method.op(JOp.DRETURN, -2);
                }
            } also rd == "I" || rd == "Z" || rd == "B" || rd == "S" || rd == "C" {
                this.cur_method.op(JOp.IRETURN, -1);
            } else {
                this.cur_method.op(JOp.ARETURN, -1);
            }
            return;
        }
        if s.kind == StmtKind.IF {
            t_lbl: string = this.new_label("if_t");
            e_lbl: string = this.new_label("if_e");
            m_lbl: string = this.new_label("if_m");
            this.gen_truthy(s.cond, t_lbl);
            this.cur_method.branch(JOp.GOTO, e_lbl, 0);
            this.cur_method.mark(t_lbl);
            this.gen_block(s.then_block);
            this.cur_method.branch(JOp.GOTO, m_lbl, 0);
            this.cur_method.mark(e_lbl);
            this.gen_block(s.else_block);
            this.cur_method.mark(m_lbl);
            return;
        }
        if s.kind == StmtKind.WHILE {
            h_lbl: string = this.new_label("w_head");
            b_lbl: string = this.new_label("w_body");
            e_lbl: string = this.new_label("w_end");
            this.loop_heads.pushb(h_lbl);
            this.loop_exits.pushb(e_lbl);
            this.cur_method.mark(h_lbl);
            this.gen_truthy(s.cond, b_lbl);
            this.cur_method.branch(JOp.GOTO, e_lbl, 0);
            this.cur_method.mark(b_lbl);
            this.gen_block(s.body);
            this.cur_method.branch(JOp.GOTO, h_lbl, 0);
            this.cur_method.mark(e_lbl);
            this.loop_heads.popb();
            this.loop_exits.popb();
            return;
        }
        if s.kind == StmtKind.STOP {
            if this.loop_exits.size == 0 {
                this.jvm_unsupported("'stop' outside a loop");
                return;
            }
            this.cur_method.branch(JOp.GOTO, this.loop_exits.get(this.loop_exits.size - 1), 0);
            return;
        }
        if s.kind == StmtKind.FOR {
            if s.for_init != null { this.gen_statement(s.for_init); }
            h_lbl: string = this.new_label("f_head");
            b_lbl: string = this.new_label("f_body");
            e_lbl: string = this.new_label("f_end");
            this.loop_heads.pushb(h_lbl);
            this.loop_exits.pushb(e_lbl);
            this.cur_method.mark(h_lbl);
            if s.cond != null {
                this.gen_truthy(s.cond, b_lbl);
                this.cur_method.branch(JOp.GOTO, e_lbl, 0);
            } else {
                this.cur_method.branch(JOp.GOTO, b_lbl, 0);
            }
            this.cur_method.mark(b_lbl);
            this.gen_block(s.body);
            if s.for_step != null { this.gen_statement(s.for_step); }
            this.cur_method.branch(JOp.GOTO, h_lbl, 0);
            this.cur_method.mark(e_lbl);
            this.loop_heads.popb();
            this.loop_exits.popb();
            return;
        }
        if s.kind == StmtKind.LOOP {
            h_lbl: string = this.new_label("l_head");
            e_lbl: string = this.new_label("l_end");
            this.loop_heads.pushb(h_lbl);
            this.loop_exits.pushb(e_lbl);
            this.cur_method.mark(h_lbl);
            this.gen_block(s.body);
            this.cur_method.branch(JOp.GOTO, h_lbl, 0);
            this.cur_method.mark(e_lbl);
            this.loop_heads.popb();
            this.loop_exits.popb();
            return;
        }
        if s.kind == StmtKind.SKIP {
            if this.loop_heads.size == 0 {
                this.jvm_unsupported("'skip' outside a loop");
                return;
            }
            this.cur_method.branch(JOp.GOTO, this.loop_heads.get(this.loop_heads.size - 1), 0);
            return;
        }
        if s.kind == StmtKind.EXPR {
            // `del obj`: run the DEL_<Class> destructor when declared
            // (native parity; memory itself is GC-managed).
            if s.name == "__del__" && s.value != null {
                del_t: string = this.expr_type(s.value);
                if del_t.size > 0 && del_t[0] == '&' {
                    inner: string = "";
                    di: int = 1;
                    while di < del_t.size {
                        inner = inner + del_t[di];
                        di = di + 1;
                    }
                    del_t = inner;
                }
                if this.tc.classes.isin(del_t) {
                    del_mname: string = "DEL_" + del_t;
                    has_del: bool = false;
                    foreach _, mn in<vector> this.tc.classes[del_t].method_names {
                        if mn == del_mname { has_del = true; }
                    }
                    if has_del {
                        this.gen_expr(s.value);
                        this.emit_invoke(JOp.INVOKEVIRTUAL, del_t, del_mname, "()V");
                    }
                }
                return;
            }
            this.gen_expr(s.value);
            // Discard a produced value (void calls leave nothing).
            if this.expr_type(s.value) != "void" {
                vd: string = this.jdesc(this.expr_type(s.value));
                if vd == "J" || vd == "D" {
                    this.cur_method.op(JOp.POP2, -2);
                } else {
                    this.cur_method.op(JOp.POP, -1);
                }
            }
            return;
        }
        if s.kind == StmtKind.BLOCK {
            this.gen_block(s.body);
            return;
        }
        if s.kind == StmtKind.DEFER {
            if s.body.size > 0 {
                this.defer_stack.pushb(s.body.get(0));
            }
            return;
        }
        if s.kind == StmtKind.THROW {
            this.gen_throw(s);
            return;
        }
        if s.kind == StmtKind.WORKS {
            if this.tc.works_error.size > 0 {
                err_decl: Stmt = Stmt.make_var_decl(s.name, "string", false, false, Expr.make_string(this.tc.works_error));
                this.gen_statement(err_decl);
                this.tc.works_error = "";
                this.gen_block(s.else_block);
            } else {
                this.gen_block(s.body);
            }
            return;
        }
        if s.kind == StmtKind.SWITCH {
            this.gen_switch(s);
            return;
        }
        if s.kind == StmtKind.FOREACH_STRUCT {
            this.jvm_unsupported("in<struct> foreach (struct support is wiring in progress)");
            return;
        }
        if s.kind == StmtKind.SPAWN {
            this.gen_spawn(s);
            return;
        }
        this.jvm_unsupported("statement kind " + tostring(s.kind));
    }

    // spawn f(args): run a worker fn on the shared pool (fire-and-
    // forget; the pool is drained by System.exit at entry teardown).
    pub fnc gen_spawn(s Stmt) : void {
        fname: string = s.name;
        if !this.tc.funcs.isin(fname) {
            this.jvm_unsupported("spawn of unknown function '" + fname + "'");
            return;
        }
        ptypes: vec<string>;
        if this.tc.func_params.isin(fname) {
            ptypes = this.tc.func_params[fname];
        }
        if s.args.size != ptypes.size {
            this.jvm_unsupported("spawn '" + fname + "' argument count");
            return;
        }
        ret: string = this.tc.funcs[fname];
        bdesc: string = "(";
        pi: int = 0;
        while pi < ptypes.size {
            pd: string = this.jdesc(ptypes.get(pi));
            if pd.size == 0 {
                this.jvm_unsupported("spawn parameter type '" + ptypes.get(pi) + "'");
                return;
            }
            bdesc = bdesc + pd;
            pi = pi + 1;
        }
        rd: string = this.jdesc(ret);
        if rd.size == 0 {
            this.jvm_unsupported("spawn return type '" + ret + "'");
            return;
        }
        bdesc = bdesc + ")" + rd;
        taskn: string = fname + "__spawn_task";
        if !this.klass_idx.isin(taskn) {
            this.gen_supplier_task(taskn, ptypes, this.main_class, fname, bdesc, ret);
        }
        this.cur_method.op(JOp.NEW, 1);
        ti: int = this.cur_cp.class_entry(taskn);
        this.cur_method.emit_u8((ti >> 8) & 255);
        this.cur_method.emit_u8(ti & 255);
        this.cur_method.op(JOp.DUP, 1);
        si: int = 0;
        while si < s.args.size {
            at: string = this.expr_type(s.args.get(si));
            this.gen_expr(s.args.get(si));
            pt: string = ptypes.get(si);
            if !this.coerce_val(at, pt) {
                this.jvm_coerce(at, pt);
                this.narrow_to(pt);
            }
            this.box_for(pt);
            si = si + 1;
        }
        cdesc: string = "(";
        ci: int = 0;
        while ci < ptypes.size {
            cdesc = cdesc + this.boxed_desc(ptypes.get(ci));
            ci = ci + 1;
        }
        cdesc = cdesc + ")V";
        this.emit_invoke(JOp.INVOKESPECIAL, taskn, "<init>", cdesc);
        pf: int = this.cur_cp.fieldref(this.main_class, "__pool", "Ljava/util/concurrent/ExecutorService;");
        this.cur_method.op_field(JOp.GETSTATIC, pf, 1);
        this.emit_invoke(JOp.INVOKESTATIC, "java/util/concurrent/CompletableFuture", "supplyAsync", "(Ljava/util/function/Supplier;Ljava/util/concurrent/Executor;)Ljava/util/concurrent/CompletableFuture;");
        this.cur_method.op(JOp.POP, -1);
    }

    // Index stores: v[i] (checked set), h[k] (put), arr[i] (xASTORE).
    // Compound ops read-modify-write (hash quirk mirrored: only
    // +=,-=,*= on ints and += on strings compute, the rest store RHS).
    pub fnc gen_index_store(s Stmt) : void {
        base: string = this.expr_type(s.target.left);
        if this.is_vec_leash(base) {
            inner: string = this.vec_inner_type(base);
            this.gen_expr(s.target.left);
            list_slot: int = this.cur_method.alloc_local(1);
            this.cur_method.store_local("X", list_slot);
            it: string = this.expr_type(s.target.right);
            this.gen_expr(s.target.right);
            this.jvm_coerce(it, "int");
            idx_slot: int = this.cur_method.alloc_local(1);
            this.cur_method.store_local("I", idx_slot);
            if s.op == "=" {
                at: string = this.expr_type(s.value);
                this.gen_expr(s.value);
                this.jvm_coerce(at, inner);
                this.narrow_to(inner);
                this.box_for(inner);
            } else {
                this.gen_vec_bounds(list_slot, idx_slot, "Runtime error: Vector index out of bounds.\n");
                this.cur_method.load_local("X", list_slot);
                this.cur_method.load_local("I", idx_slot);
                this.emit_invoke(JOp.INVOKEVIRTUAL, "java/util/ArrayList", "get", "(I)Ljava/lang/Object;");
                this.unbox_to(inner);
                at: string = this.expr_type(s.value);
                this.gen_expr(s.value);
                if inner == "string" {
                    if s.op != "+=" {
                        this.jvm_unsupported("compound '" + s.op + "' on string elements");
                        return;
                    }
                    this.jvm_coerce(at, "string");
                    this.emit_invoke(JOp.INVOKEVIRTUAL, "java/lang/String", "concat", "(Ljava/lang/String;)Ljava/lang/String;");
                } else {
                    this.jvm_coerce(at, inner);
                    this.apply_compound(this.jdesc(inner), this.is_uint_leash(inner), s.op);
                    this.narrow_to(inner);
                }
                this.box_for(inner);
            }
            val_slot: int = this.cur_method.alloc_local(1);
            this.cur_method.store_local("X", val_slot);
            this.gen_vec_bounds(list_slot, idx_slot, "Runtime error: Vector index out of bounds.\n");
            this.cur_method.load_local("X", list_slot);
            this.cur_method.load_local("I", idx_slot);
            this.cur_method.load_local("X", val_slot);
            this.emit_invoke(JOp.INVOKEVIRTUAL, "java/util/ArrayList", "set", "(ILjava/lang/Object;)Ljava/lang/Object;");
            this.cur_method.op(JOp.POP, -1);
            return;
        }
        if this.is_hash_leash(base) {
            vt: string = this.hash_val_type(base);
            kt: string = this.hash_key_type(base);
            at: string = this.expr_type(s.value);
            this.gen_expr(s.value);
            this.jvm_coerce(at, vt);
            if s.op != "=" {
                this.narrow_to(vt);
            }
            this.box_for(vt);
            rhs_slot: int = this.cur_method.alloc_local(1);
            this.cur_method.store_local("X", rhs_slot);
            this.gen_expr(s.target.left);
            map_slot: int = this.cur_method.alloc_local(1);
            this.cur_method.store_local("X", map_slot);
            it: string = this.expr_type(s.target.right);
            this.gen_expr(s.target.right);
            this.jvm_coerce(it, kt);
            this.gen_hashkey(kt);
            key_slot: int = this.cur_method.alloc_local(1);
            this.cur_method.store_local("X", key_slot);
            if s.op == "=" {
                this.cur_method.load_local("X", map_slot);
                this.cur_method.load_local("X", key_slot);
                this.cur_method.load_local("X", rhs_slot);
                this.emit_invoke(JOp.INVOKEVIRTUAL, "java/util/HashMap", "put", "(Ljava/lang/Object;Ljava/lang/Object;)Ljava/lang/Object;");
                this.cur_method.op(JOp.POP, -1);
                return;
            }
            this.cur_method.load_local("X", map_slot);
            this.cur_method.load_local("X", key_slot);
            this.emit_invoke(JOp.INVOKEVIRTUAL, "java/util/HashMap", "get", "(Ljava/lang/Object;)Ljava/lang/Object;");
            this.gen_unbox_or_default(vt);
            if vt == "string" {
                if s.op == "+=" {
                    this.cur_method.load_local("X", rhs_slot);
                    this.emit_invoke(JOp.INVOKEVIRTUAL, "java/lang/String", "concat", "(Ljava/lang/String;)Ljava/lang/String;");
                } else {
                    this.cur_method.op(JOp.POP, -1);
                    this.cur_method.load_local("X", rhs_slot);
                }
            } also (this.jdesc(vt) == "I" || this.jdesc(vt) == "J") && (s.op == "+=" || s.op == "-=" || s.op == "*=") {
                this.cur_method.load_local("X", rhs_slot);
                this.unbox_to(vt);
                this.apply_compound(this.jdesc(vt), this.is_uint_leash(vt), s.op);
                this.narrow_to(vt);
                this.box_for(vt);
            } else {
                // Native quirk: other hash compound ops store the RHS.
                this.cur_method.op(JOp.POP, -1);
                this.cur_method.load_local("X", rhs_slot);
            }
            val_slot: int = this.cur_method.alloc_local(1);
            this.cur_method.store_local("X", val_slot);
            this.cur_method.load_local("X", map_slot);
            this.cur_method.load_local("X", key_slot);
            this.cur_method.load_local("X", val_slot);
            this.emit_invoke(JOp.INVOKEVIRTUAL, "java/util/HashMap", "put", "(Ljava/lang/Object;Ljava/lang/Object;)Ljava/lang/Object;");
            this.cur_method.op(JOp.POP, -1);
            return;
        }
        od: string = this.jdesc(base);
        if od.size > 0 && od[0] == '[' {
            elem: string = this.array_base_of(base);
            if s.op != "=" {
                this.jvm_unsupported("compound assignment on array elements");
                return;
            }
            at: string = this.expr_type(s.value);
            this.gen_expr(s.value);
            this.jvm_coerce(at, elem);
            this.narrow_to(elem);
            // Stack: [val]. Spill, then push [arr, idx, val] (typed
            // access — an astore/aload of an int slot fails verification
            // and the error surfaces at an unrelated branch target).
            vd_elem: string = this.jdesc(elem);
            val_slot: int = this.cur_method.alloc_local(2);
            if vd_elem == "J" || vd_elem == "D" {
                this.cur_method.store_local(vd_elem, val_slot);
            } also vd_elem == "I" || vd_elem == "Z" || vd_elem == "C" || vd_elem == "B" || vd_elem == "S" {
                this.cur_method.store_local("I", val_slot);
            } else {
                this.cur_method.store_local("X", val_slot);
            }
            this.gen_expr(s.target.left);
            it: string = this.expr_type(s.target.right);
            this.gen_expr(s.target.right);
            this.jvm_coerce(it, "int");
            if vd_elem == "J" || vd_elem == "D" {
                this.cur_method.load_local(vd_elem, val_slot);
            } also vd_elem == "I" || vd_elem == "Z" || vd_elem == "C" || vd_elem == "B" || vd_elem == "S" {
                this.cur_method.load_local("I", val_slot);
            } else {
                this.cur_method.load_local("X", val_slot);
            }
            sop: int = this.array_store_op(elem);
            if vd_elem == "J" || vd_elem == "D" {
                this.cur_method.op(sop, -4);
            } else {
                this.cur_method.op(sop, -3);
            }
            return;
        }
        this.jvm_unsupported("index assignment on '" + base + "'");
    }

    // Field stores: obj.field (PUTFIELD) and Class.field (PUTSTATIC).
    pub fnc gen_field_store(s Stmt) : void {
        tgt: Expr = s.target;
        static_owner: string = "";
        if tgt.left != null && tgt.left.kind == ExprKind.IDENT {
            ln: string = tgt.left.sval;
            if (this.tc.classes.isin(ln) || this.tc.structs.isin(ln)) && this.tc.static_fields.isin(ln + "_" + tgt.sval) {
                static_owner = ln;
            }
        }
        if static_owner.size == 0 && tgt.left != null && tgt.left.kind == ExprKind.IDENT && tgt.left.sval == "this" && this.current_class.size > 0 && this.tc.static_fields.isin(this.current_class + "_" + tgt.sval) {
            static_owner = this.current_class;
        }
        if static_owner.size > 0 {
            ft: string = this.tc.static_fields[static_owner + "_" + tgt.sval];
            fd: string = this.jdesc(ft);
            if fd.size == 0 {
                this.jvm_unsupported("static field type '" + ft + "'");
                return;
            }
            if s.op == "=" {
                at: string = this.expr_type(s.value);
                this.gen_expr(s.value);
                if !this.coerce_val(at, ft) {
                    this.jvm_coerce(at, ft);
                    this.narrow_to(ft);
                }
            } else {
                this.gen_static_field_rmw(static_owner, tgt.sval, ft, fd, s);
                return;
            }
            idx: int = this.cur_cp.fieldref(static_owner, tgt.sval, fd);
            this.cur_method.op_field(JOp.PUTSTATIC, idx, 0 - this.slots_of(fd));
            return;
        }
        obj_t: string = this.deref_t(this.expr_type(tgt.left));
        if this.tc.unions.isin(obj_t) {
            this.gen_union_store(s);
            return;
        }
        ft: string = this.struct_field_type(obj_t, tgt.sval);
        if ft.size == 0 {
            this.jvm_unsupported("field '" + tgt.sval + "' of '" + obj_t + "'");
            return;
        }
        fd: string = this.jdesc(ft);
        if fd.size == 0 {
            this.jvm_unsupported("field type '" + ft + "'");
            return;
        }
        this.gen_expr(tgt.left);
        if tgt.kind == ExprKind.POINTER_MEMBER {
            this.emit_checkcast(obj_t);
        }
        obj_slot: int = this.cur_method.alloc_local(1);
        this.cur_method.store_local("X", obj_slot);
        if s.op == "=" {
            at: string = this.expr_type(s.value);
            this.gen_expr(s.value);
            if !this.coerce_val(at, ft) {
                this.jvm_coerce(at, ft);
                this.narrow_to(ft);
            }
            val_slot: int = this.cur_method.alloc_local(2);
            this.store_by_desc(fd, val_slot);
            this.cur_method.load_local("X", obj_slot);
            this.load_by_desc(fd, val_slot);
        } else {
            this.cur_method.load_local("X", obj_slot);
            idx: int = this.cur_cp.fieldref(obj_t, tgt.sval, fd);
            this.cur_method.op_field(JOp.GETFIELD, idx, this.slots_of(fd) - 1);
            at: string = this.expr_type(s.value);
            this.gen_expr(s.value);
            if ft == "string" {
                if s.op != "+=" {
                    this.jvm_unsupported("compound '" + s.op + "' on string fields");
                    return;
                }
                this.jvm_coerce(at, "string");
                this.emit_invoke(JOp.INVOKEVIRTUAL, "java/lang/String", "concat", "(Ljava/lang/String;)Ljava/lang/String;");
            } else {
                this.jvm_coerce(at, ft);
                this.apply_compound(fd, this.is_uint_leash(ft), s.op);
                this.narrow_to(ft);
            }
            val_slot: int = this.cur_method.alloc_local(2);
            this.store_by_desc(fd, val_slot);
            this.cur_method.load_local("X", obj_slot);
            this.load_by_desc(fd, val_slot);
        }
        idx: int = this.cur_cp.fieldref(obj_t, tgt.sval, fd);
        if fd == "J" || fd == "D" {
            this.cur_method.op_field(JOp.PUTFIELD, idx, -3);
        } else {
            this.cur_method.op_field(JOp.PUTFIELD, idx, -2);
        }
    }

    // Typed spill/reload by descriptor (refs via ALOAD/ASTORE).
    pub fnc store_by_desc(fd string, slot int) : void {
        if fd == "J" || fd == "D" {
            this.cur_method.store_local(fd, slot);
        } also fd == "I" || fd == "Z" || fd == "C" || fd == "B" || fd == "S" {
            this.cur_method.store_local("I", slot);
        } else {
            this.cur_method.store_local("X", slot);
        }
    }

    pub fnc load_by_desc(fd string, slot int) : void {
        if fd == "J" || fd == "D" {
            this.cur_method.load_local(fd, slot);
        } also fd == "I" || fd == "Z" || fd == "C" || fd == "B" || fd == "S" {
            this.cur_method.load_local("I", slot);
        } else {
            this.cur_method.load_local("X", slot);
        }
    }

    // Static compound store: GET + apply + PUTSTATIC.
    pub fnc gen_static_field_rmw(owner string, fn string, ft string, fd string, s Stmt) : void {
        idx: int = this.cur_cp.fieldref(owner, fn, fd);
        this.cur_method.op_field(JOp.GETSTATIC, idx, this.slots_of(fd));
        at: string = this.expr_type(s.value);
        this.gen_expr(s.value);
        if ft == "string" {
            if s.op != "+=" {
                this.jvm_unsupported("compound '" + s.op + "' on string fields");
                return;
            }
            this.jvm_coerce(at, "string");
            this.emit_invoke(JOp.INVOKEVIRTUAL, "java/lang/String", "concat", "(Ljava/lang/String;)Ljava/lang/String;");
        } else {
            this.jvm_coerce(at, ft);
            this.apply_compound(fd, this.is_uint_leash(ft), s.op);
            this.narrow_to(ft);
        }
        this.cur_method.op_field(JOp.PUTSTATIC, idx, 0 - this.slots_of(fd));
    }

    // Assignment to locals and globals (fusion atomics included).
    pub fnc gen_assign(s Stmt) : void {
        if s.target.kind == ExprKind.INDEX {
            this.gen_index_store(s);
            return;
        }
        if s.target.kind == ExprKind.MEMBER {
            this.gen_field_store(s);
            return;
        }
        if s.target.kind == ExprKind.POINTER_MEMBER {
            pt: string = this.deref_t(this.expr_type(s.target.left));
            if this.tc.structs.isin(pt) || this.tc.classes.isin(pt) {
                this.gen_field_store(s);
                return;
            }
        }
        if s.target.kind != ExprKind.IDENT {
            this.jvm_unsupported("assignment to non-variable target");
            return;
        }
        name: string = s.target.sval;
        if this.var_slots.isin(name) {
            t: string = "";
            if this.var_types.isin(name) { t = this.var_types[name]; }
            d: string = this.jdesc(t);
            if d.size == 0 {
                this.jvm_unsupported("variable '" + name + "' of type '" + t + "'");
                return;
            }
            if s.op == "=" {
                it: string = this.expr_type(s.value);
                this.gen_expr(s.value);
                if !this.coerce_val(it, t) {
                    this.jvm_coerce(it, t);
                    this.narrow_to(t);
                }
                if this.tc.structs.isin(t) && this.tc.structs.isin(this.deref_t(it)) {
                    this.gen_struct_copy(t);
                }
                this.cur_method.store_local(d, this.var_slots[name]);
                return;
            }
            if s.op == "++" || s.op == "--" {
                this.gen_local_incr(name, t, d, s.op == "++");
                return;
            }
            if this.is_compound(s.op) {
                this.gen_local_compound(name, t, d, s);
                return;
            }
            this.jvm_unsupported("assignment operator '" + s.op + "'");
            return;
        }
        if this.cg.global_vars.isin(name) {
            gt: string = this.cg.global_vars[name];
            gd: string = this.jdesc(gt);
            if gd.size == 0 {
                this.jvm_unsupported("global '" + name + "' of type '" + gt + "'");
                return;
            }
            if this.is_fusion_int(name, gt) {
                this.gen_fusion_assign(s, name, gt, gd);
                return;
            }
            if s.op == "=" {
                it: string = this.expr_type(s.value);
                this.gen_expr(s.value);
                if !this.coerce_val(it, gt) {
                    this.jvm_coerce(it, gt);
                    this.narrow_to(gt);
                }
                this.emit_putstatic(name, gd);
                return;
            }
            if s.op == "++" || s.op == "--" {
                this.gen_global_incr(name, gt, gd, s.op == "++");
                return;
            }
            if this.is_compound(s.op) {
                this.gen_global_compound(name, gt, gd, s);
                return;
            }
            this.jvm_unsupported("assignment operator '" + s.op + "'");
            return;
        }
        if name == "_" {
            // Discard sink (native parity): evaluate, then drop.
            it: string = this.expr_type(s.value);
            this.gen_expr(s.value);
            id: string = this.jdesc(it);
            if id == "J" || id == "D" {
                this.cur_method.op(JOp.POP2, -2);
            } also id.size > 0 {
                this.cur_method.op(JOp.POP, -1);
            }
            return;
        }
        this.jvm_unsupported("assignment to unknown '" + name + "'");
    }

    pub fnc is_compound(op string) : bool {
        return op == "+=" || op == "-=" || op == "*=" || op == "/=" || op == "%=" ||
               op == ">>=" || op == "<<=" || op == "&=" || op == "|=" || op == "^=";
    }

    // Apply a compound op to [cur, rhs] already on the stack.
    pub fnc apply_compound(d string, is_uint bool, op string) : void {
        if d == "Ljava/math/BigInteger;" {
            // Stack: [a, b] (b already coerced to BigInteger, except
            // shifts which take an int rhs).
            if op == "<<=" || op == ">>=" {
                this.emit_invoke(JOp.INVOKEVIRTUAL, "java/math/BigInteger", "intValue", "()I");
                if op == "<<=" {
                    this.emit_invoke(JOp.INVOKEVIRTUAL, "java/math/BigInteger", "shiftLeft", "(I)Ljava/math/BigInteger;");
                } else {
                    this.emit_invoke(JOp.INVOKEVIRTUAL, "java/math/BigInteger", "shiftRight", "(I)Ljava/math/BigInteger;");
                }
                return;
            }
            if op == "+=" || op == "-=" || op == "*=" || op == "/=" || op == "%=" || op == "&=" || op == "|=" || op == "^=" {
                short_op: string = op;
                if op == "+=" { short_op = "+"; }
                also op == "-=" { short_op = "-"; }
                also op == "*=" { short_op = "*"; }
                also op == "/=" { short_op = "/"; }
                also op == "%=" { short_op = "%"; }
                also op == "&=" { short_op = "&"; }
                also op == "|=" { short_op = "|"; }
                else { short_op = "^"; }
                this.bigint_binop(short_op);
                return;
            }
            this.jvm_unsupported("compound '" + op + "' on 128-bit");
            return;
        }
        if d == "D" {
            if op == "+=" { this.cur_method.op(JOp.DADD, -2); }
            also op == "-=" { this.cur_method.op(JOp.DSUB, -2); }
            also op == "*=" { this.cur_method.op(JOp.DMUL, -2); }
            also op == "/=" { this.cur_method.op(JOp.DDIV, -2); }
            also op == "%=" { this.cur_method.op(JOp.DREM, -2); }
            else { this.jvm_unsupported("compound '" + op + "' on float"); }
            return;
        }
        if d == "J" {
            if op == "+=" { this.cur_method.op(JOp.LADD, -2); }
            also op == "-=" { this.cur_method.op(JOp.LSUB, -2); }
            also op == "*=" { this.cur_method.op(JOp.LMUL, -2); }
            also op == "/=" {
                if is_uint {
                    this.emit_invoke(JOp.INVOKESTATIC, "java/lang/Long", "divideUnsigned", "(JJ)J");
                } else {
                    this.cur_method.op(JOp.LDIV, -2);
                }
            } also op == "%=" {
                if is_uint {
                    this.emit_invoke(JOp.INVOKESTATIC, "java/lang/Long", "remainderUnsigned", "(JJ)J");
                } else {
                    this.cur_method.op(JOp.LREM, -2);
                }
            } also op == "<<=" || op == ">>=" {
                // JVM shift distances are ints: narrow a long rhs back.
                this.cur_method.op(JOp.L2I, -1);
                if op == "<<=" { this.cur_method.op(JOp.LSHL, -1); }
                else {
                    if is_uint { this.cur_method.op(JOp.LUSHR, -1); } else { this.cur_method.op(JOp.LSHR, -1); }
                }
            } also op == "&=" { this.cur_method.op(JOp.LAND, -2); }
            also op == "|=" { this.cur_method.op(JOp.LOR, -2); }
            also op == "^=" { this.cur_method.op(JOp.LXOR, -2); }
            else { this.jvm_unsupported("compound '" + op + "'"); }
            return;
        }
        if op == "+=" { this.cur_method.op(JOp.IADD, -1); }
        also op == "-=" { this.cur_method.op(JOp.ISUB, -1); }
        also op == "*=" { this.cur_method.op(JOp.IMUL, -1); }
        also op == "/=" {
            if is_uint {
                this.emit_invoke(JOp.INVOKESTATIC, "java/lang/Integer", "divideUnsigned", "(II)I");
            } else {
                this.cur_method.op(JOp.IDIV, -1);
            }
        } also op == "%=" {
            if is_uint {
                this.emit_invoke(JOp.INVOKESTATIC, "java/lang/Integer", "remainderUnsigned", "(II)I");
            } else {
                this.cur_method.op(JOp.IREM, -1);
            }
        } also op == "<<=" { this.cur_method.op(JOp.ISHL, -1); }
        also op == ">>=" {
            if is_uint { this.cur_method.op(JOp.IUSHR, -1); } else { this.cur_method.op(JOp.ISHR, -1); }
        } also op == "&=" { this.cur_method.op(JOp.IAND, -1); }
        also op == "|=" { this.cur_method.op(JOp.IOR, -1); }
        also op == "^=" { this.cur_method.op(JOp.IXOR, -1); }
        else { this.jvm_unsupported("compound '" + op + "'"); }
    }

    pub fnc gen_local_incr(name string, t string, d string, inc bool) : void {
        slot: int = this.var_slots[name];
        this.cur_method.load_local(d, slot);
        if d == "J" {
            this.long_const(0, 1);
            if inc {
                this.cur_method.op(JOp.LADD, -2);
            } else {
                this.cur_method.op(JOp.LSUB, -2);
            }
        } also d == "D" {
            this.ldc_double_one();
            if inc {
                this.cur_method.op(JOp.DADD, -2);
            } else {
                this.cur_method.op(JOp.DSUB, -2);
            }
        } else {
            this.iconst(1);
            if inc {
                this.cur_method.op(JOp.IADD, -1);
            } else {
                this.cur_method.op(JOp.ISUB, -1);
            }
            this.narrow_to(t);
        }
        this.cur_method.store_local(d, slot);
    }

    pub fnc gen_local_compound(name string, t string, d string, s Stmt) : void {
        slot: int = this.var_slots[name];
        this.cur_method.load_local(d, slot);
        it: string = this.expr_type(s.value);
        this.gen_expr(s.value);
        this.jvm_coerce(it, t);
        this.apply_compound(d, this.is_uint_leash(t), s.op);
        this.narrow_to(t);
        this.cur_method.store_local(d, slot);
    }

    pub fnc gen_global_incr(name string, gt string, gd string, inc bool) : void {
        if this.is_fusion_int(name, gt) {
            this.fusion_ref(name, gd);
            if gd == "J" {
                this.long_const(0, 1);
                if !inc {
                    this.cur_method.op(JOp.LNEG, 0);
                }
                this.emit_invoke(JOp.INVOKEVIRTUAL, "java/util/concurrent/atomic/AtomicLong", "getAndAdd", "(J)J");
            } else {
                this.iconst(1);
                if !inc {
                    this.cur_method.op(JOp.INEG, 0);
                }
                this.emit_invoke(JOp.INVOKEVIRTUAL, "java/util/concurrent/atomic/AtomicInteger", "getAndAdd", "(I)I");
            }
            this.cur_method.op(JOp.POP, -1);
            return;
        }
        idx: int = this.cur_cp.fieldref(this.main_class, "g_" + name, gd);
        this.cur_method.op_field(JOp.GETSTATIC, idx, this.slots_of(gd));
        if gd == "J" {
            this.long_const(0, 1);
            if inc {
                this.cur_method.op(JOp.LADD, -2);
            } else {
                this.cur_method.op(JOp.LSUB, -2);
            }
        } also gd == "D" {
            this.ldc_double_one();
            if inc {
                this.cur_method.op(JOp.DADD, -2);
            } else {
                this.cur_method.op(JOp.DSUB, -2);
            }
        } else {
            this.iconst(1);
            if inc {
                this.cur_method.op(JOp.IADD, -1);
            } else {
                this.cur_method.op(JOp.ISUB, -1);
            }
            this.narrow_to(gt);
        }
        this.emit_putstatic(name, gd);
    }

    pub fnc gen_global_compound(name string, gt string, gd string, s Stmt) : void {
        if this.is_fusion_int(name, gt) {
            this.gen_fusion_assign(s, name, gt, gd);
            return;
        }
        idx: int = this.cur_cp.fieldref(this.main_class, "g_" + name, gd);
        this.cur_method.op_field(JOp.GETSTATIC, idx, this.slots_of(gd));
        it: string = this.expr_type(s.value);
        this.gen_expr(s.value);
        this.jvm_coerce(it, gt);
        this.apply_compound(gd, this.is_uint_leash(gt), s.op);
        this.narrow_to(gt);
        this.emit_putstatic(name, gd);
    }

    // Atomic write paths mirroring the reference: x = x +/- k lowers
    // to getAndAdd (negating for sub); anything else is set().
    pub fnc gen_fusion_assign(s Stmt, name string, gt string, gd string) : void {
        cls: string = "java/util/concurrent/atomic/AtomicInteger";
        gdesc: string = "I";
        if gd == "J" {
            cls = "java/util/concurrent/atomic/AtomicLong";
            gdesc = "J";
        }
        if s.op == "=" && s.value != null && s.value.kind == ExprKind.BINOP && (s.value.op == "+" || s.value.op == "-") {
            l_is_t: bool = s.value.left != null && s.value.left.kind == ExprKind.IDENT && s.value.left.sval == name;
            r_is_t: bool = s.value.right != null && s.value.right.kind == ExprKind.IDENT && s.value.right.sval == name;
            operand_e: Expr = null;
            is_add: bool = true;
            if l_is_t && !r_is_t {
                operand_e = s.value.right;
                is_add = s.value.op == "+";
            } also r_is_t && !l_is_t && s.value.op == "+" {
                operand_e = s.value.left;
                is_add = true;
            }
            if operand_e != null {
                this.fusion_ref(name, gd);
                ot: string = this.expr_type(operand_e);
                this.gen_expr(operand_e);
                this.jvm_coerce(ot, gt);
                if !is_add {
                    if gd == "J" {
                        this.cur_method.op(JOp.LNEG, 0);
                    } else {
                        this.cur_method.op(JOp.INEG, 0);
                    }
                }
                this.emit_invoke(JOp.INVOKEVIRTUAL, cls, "getAndAdd", "(" + gdesc + ")" + gdesc);
                this.cur_method.op(JOp.POP, -1);
                return;
            }
        }
        if s.op == "+=" || s.op == "++" || s.op == "-=" || s.op == "--" {
            this.fusion_ref(name, gd);
            ot2: string = this.expr_type(s.value);
            this.gen_expr(s.value);
            this.jvm_coerce(ot2, gt);
            is_add2: bool = s.op == "+=" || s.op == "++";
            if !is_add2 {
                if gd == "J" {
                    this.cur_method.op(JOp.LNEG, 0);
                } else {
                    this.cur_method.op(JOp.INEG, 0);
                }
            }
            this.emit_invoke(JOp.INVOKEVIRTUAL, cls, "getAndAdd", "(" + gdesc + ")" + gdesc);
            this.cur_method.op(JOp.POP, -1);
            return;
        }
        this.fusion_ref(name, gd);
        ot3: string = this.expr_type(s.value);
        this.gen_expr(s.value);
        this.jvm_coerce(ot3, gt);
        this.narrow_to(gt);
        this.emit_invoke(JOp.INVOKEVIRTUAL, cls, "set", "(" + gdesc + ")V");
    }

    pub fnc ldc_double_one() : void {
        idx: int = this.cur_cp.double_const(1072693248, 0);
        this.cur_method.emit_u8(JOp.LDC2_W);
        this.cur_method.emit_u8((idx >> 8) & 255);
        this.cur_method.emit_u8(idx & 255);
        this.cur_method.adjust(2);
    }

}
