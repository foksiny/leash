        m.op(JOp.ARETURN, -1);
        m.mark(ne_lbl);
        m.op(JOp.ALOAD_0, 1);
        idx = this.cur_cp.fieldref(this.main_class, "__rng", "Ljava/util/Random;");
        m.emit_u8(JOp.GETSTATIC);
