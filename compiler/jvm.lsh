// ---------------------------------------------------------------------------
// JVM bytecode backend ( --target jvm ).
//
// Emits Java 6 (major version 50) class files directly: the pre-split-
// verifier type inference needs no StackMapTable frames, so branches
// assemble with plain labels. Only `java` is required at run time.
//
// Layout per program: one top-level class per Leash struct/class plus a
// main class holding functions (static methods), globals (static
// fields), and the `main(String[])` entry.
// ---------------------------------------------------------------------------

use ast::*;
use typechecker::*;
use codegen::*;

// JVM opcode numbers (only the subset the backend emits).
pub def JOp : class {
    static pub ACONST_NULL: int = 1;
    static pub WIDE: int = 196;  // 0xC4
    static pub ICONST_M1: int = 2;
    static pub ICONST_0: int = 3;
    static pub ICONST_1: int = 4;
    static pub ICONST_2: int = 5;
    static pub ICONST_3: int = 6;
    static pub ICONST_4: int = 7;
    static pub ICONST_5: int = 8;
    static pub LCONST_0: int = 9;
    static pub LCONST_1: int = 10;
    static pub DCONST_0: int = 14;
    static pub DCONST_1: int = 15;
    static pub BIPUSH: int = 16;
    static pub SIPUSH: int = 17;
    static pub LDC: int = 18;
    static pub LDC_W: int = 19;
    static pub LDC2_W: int = 20;
    static pub ILOAD: int = 21;
    static pub LLOAD: int = 22;
    static pub DLOAD: int = 24;
    static pub ALOAD: int = 25;
    static pub ILOAD_0: int = 26;
    static pub ILOAD_1: int = 27;
    static pub ILOAD_2: int = 28;
    static pub ILOAD_3: int = 29;
    static pub LLOAD_0: int = 30;
    static pub LLOAD_1: int = 31;
    static pub LLOAD_2: int = 32;
    static pub LLOAD_3: int = 33;
    static pub DLOAD_0: int = 38;
    static pub DLOAD_1: int = 39;
    static pub DLOAD_2: int = 40;
    static pub DLOAD_3: int = 41;
    static pub ALOAD_0: int = 42;
    static pub ALOAD_1: int = 43;
    static pub ALOAD_2: int = 44;
    static pub ALOAD_3: int = 45;
    static pub IALOAD: int = 46;
    static pub LALOAD: int = 47;
    static pub DALOAD: int = 49;
    static pub AALOAD: int = 50;
    static pub BALOAD: int = 51;
    static pub CALOAD: int = 52;
    static pub SALOAD: int = 53;
    static pub ISTORE: int = 54;
    static pub LSTORE: int = 55;
    static pub DSTORE: int = 57;
    static pub ASTORE: int = 58;
    static pub ISTORE_0: int = 59;
    static pub ISTORE_1: int = 60;
    static pub ISTORE_2: int = 61;
    static pub ISTORE_3: int = 62;
    static pub LSTORE_0: int = 63;
    static pub LSTORE_1: int = 64;
    static pub LSTORE_2: int = 65;
    static pub LSTORE_3: int = 66;
    static pub DSTORE_0: int = 71;
    static pub DSTORE_1: int = 72;
    static pub DSTORE_2: int = 73;
    static pub DSTORE_3: int = 74;
    static pub ASTORE_0: int = 75;
    static pub ASTORE_1: int = 76;
    static pub ASTORE_2: int = 77;
    static pub ASTORE_3: int = 78;
    static pub IASTORE: int = 79;
    static pub LASTORE: int = 80;
    static pub DASTORE: int = 82;
    static pub AASTORE: int = 83;
    static pub BASTORE: int = 84;
    static pub CASTORE: int = 85;
    static pub SASTORE: int = 86;
    static pub POP: int = 87;
    static pub POP2: int = 88;
    static pub DUP: int = 89;
    static pub DUP_X1: int = 90;
    static pub DUP2: int = 92;
    static pub SWAP: int = 95;
    static pub IADD: int = 96;
    static pub LADD: int = 97;
    static pub DADD: int = 99;
    static pub ISUB: int = 100;
    static pub LSUB: int = 101;
    static pub DSUB: int = 103;
    static pub IMUL: int = 104;
    static pub LMUL: int = 105;
    static pub DMUL: int = 107;
    static pub IDIV: int = 108;
    static pub LDIV: int = 109;
    static pub DDIV: int = 111;
    static pub IREM: int = 112;
    static pub LREM: int = 113;
    static pub DREM: int = 115;
    static pub INEG: int = 116;
    static pub LNEG: int = 117;
    static pub DNEG: int = 119;
    static pub ISHL: int = 120;
    static pub LSHL: int = 121;
    static pub ISHR: int = 122;
    static pub LSHR: int = 123;
    static pub IUSHR: int = 124;
    static pub LUSHR: int = 125;
    static pub IAND: int = 126;
    static pub LAND: int = 127;
    static pub IOR: int = 128;
    static pub LOR: int = 129;
    static pub IXOR: int = 130;
    static pub LXOR: int = 131;
    static pub IINC: int = 132;
    static pub I2L: int = 133;
    static pub I2D: int = 135;
    static pub L2I: int = 136;
    static pub L2D: int = 138;
    static pub D2I: int = 142;
    static pub D2L: int = 143;
    static pub I2B: int = 145;
    static pub I2C: int = 146;
    static pub I2S: int = 147;
    static pub LCMP: int = 148;
    static pub DCMPL: int = 151;
    static pub DCMPG: int = 152;
    static pub IFEQ: int = 153;
    static pub IFNE: int = 154;
    static pub IFLT: int = 155;
    static pub IFGE: int = 156;
    static pub IFGT: int = 157;
    static pub IFLE: int = 158;
    static pub IF_ICMPEQ: int = 159;
    static pub IF_ICMPNE: int = 160;
    static pub IF_ICMPLT: int = 161;
    static pub IF_ICMPGE: int = 162;
    static pub IF_ICMPGT: int = 163;
    static pub IF_ICMPLE: int = 164;
    static pub IF_ACMPEQ: int = 165;
    static pub IF_ACMPNE: int = 166;
    static pub GOTO: int = 167;
    static pub IRETURN: int = 172;
    static pub LRETURN: int = 173;
    static pub DRETURN: int = 175;
    static pub ARETURN: int = 176;
    static pub RETURN: int = 177;
    static pub GETSTATIC: int = 178;
    static pub PUTSTATIC: int = 179;
    static pub GETFIELD: int = 180;
    static pub PUTFIELD: int = 181;
    static pub INVOKEVIRTUAL: int = 182;
    static pub INVOKESPECIAL: int = 183;
    static pub INVOKEINTERFACE: int = 185;
    static pub INVOKESTATIC: int = 184;
    static pub NEW: int = 187;
    static pub NEWARRAY: int = 188;
    static pub ANEWARRAY: int = 189;
    static pub ARRAYLENGTH: int = 190;
    static pub IFNULL: int = 198;
    static pub IFNONNULL: int = 199;
    static pub GOTO_W: int = 200;
    static pub CHECKCAST: int = 192;
    static pub INSTANCEOF: int = 193;
}

// newarray element codes.
pub def JArray : class {
    static pub T_BOOLEAN: int = 4;
    static pub T_CHAR: int = 5;
    static pub T_BYTE: int = 8;
    static pub T_OBJECT: int = 5;
    static pub T_SHORT: int = 9;
    static pub T_INT: int = 10;
    static pub T_LONG: int = 11;
    static pub T_DOUBLE: int = 7;
}

// Access flags.
pub def JAcc : class {
    static pub PUBLIC: int = 1;
    static pub PRIVATE: int = 2;
    static pub STATIC: int = 8;
    static pub SYNCHRONIZED: int = 32;
    static pub FINAL: int = 16;
    static pub SUPER: int = 32;
}

// Constant-pool tags.
pub def JCp : class {
    static pub UTF8: int = 1;
    static pub INT: int = 3;
    static pub FLOAT: int = 4;
    static pub LONG: int = 5;
    static pub DOUBLE: int = 6;
    static pub CLASS: int = 7;
    static pub STRING: int = 8;
    static pub FIELDREF: int = 9;
    static pub METHODREF: int = 10;
    static pub NAMEANDTYPE: int = 12;
}

// A constant pool under construction: deduplicated entries, 1-based
// indices (long/double occupy two slots, like real class files).
pub def JvmCp : class {
    pub keys: hash<string, int>;
    pub tags: vec<int>;
    pub payloads: vec<vec<int>>;
    pub next_idx: int;

    static pub fnc make() : JvmCp {
        empty_keys: hash<string, int>;
        empty_tags: vec<int>;
        empty_payloads: vec<vec<int>>;
        return JvmCp { keys: empty_keys, tags: empty_tags, payloads: empty_payloads, next_idx: 1 };
    }

    pub fnc alloc(tag int, key string, payload vec<int>, slots int) : int {
        if this.keys.isin(key) { return this.keys[key]; }
        idx: int = this.next_idx;
        this.keys.push(key, idx);
        this.tags.pushb(tag);
        this.payloads.pushb(payload);
        this.next_idx = this.next_idx + slots;
        return idx;
    }

    // Modified UTF-8 bytes of a Leash string (NUL -> C0 80, bytes
    // above 127 -> two-byte form; Leash chars iterate as unsigned).
    pub fnc mutf8(s string) : vec<int> {
        out: vec<int>;
        foreach _, c in<string> s {
            b: int = c + 0;
            if b == 0 {
                out.pushb(192);
                out.pushb(128);
            } also b < 128 {
                out.pushb(b);
            } else {
                out.pushb(192 + (b >> 6));
                out.pushb(128 + (b & 63));
            }
        }
        return out;
    }

    pub fnc utf8(s string) : int {
        return this.alloc(JCp.UTF8, "U:" + s, this.mutf8(s), 1);
    }

    pub fnc class_entry(name string) : int {
        ni: int = this.utf8(name);
        key: string = "C:" + tostring(ni);
        if this.keys.isin(key) { return this.keys[key]; }
        pl: vec<int>;
        pl.pushb((ni >> 8) & 255);
        pl.pushb(ni & 255);
        return this.alloc(JCp.CLASS, key, pl, 1);
    }

    pub fnc nat(name_i int, desc_i int) : int {
        key: string = "N:" + tostring(name_i) + ":" + tostring(desc_i);
        if this.keys.isin(key) { return this.keys[key]; }
        pl: vec<int>;
        pl.pushb((name_i >> 8) & 255);
        pl.pushb(name_i & 255);
        pl.pushb((desc_i >> 8) & 255);
        pl.pushb(desc_i & 255);
        return this.alloc(JCp.NAMEANDTYPE, key, pl, 1);
    }

    pub fnc fieldref(cls string, name string, desc string) : int {
        ci: int = this.class_entry(cls);
        ni: int = this.nat(this.utf8(name), this.utf8(desc));
        key: string = "F:" + tostring(ci) + ":" + tostring(ni);
        if this.keys.isin(key) { return this.keys[key]; }
        pl: vec<int>;
        pl.pushb((ci >> 8) & 255);
        pl.pushb(ci & 255);
        pl.pushb((ni >> 8) & 255);
        pl.pushb(ni & 255);
        return this.alloc(JCp.FIELDREF, key, pl, 1);
    }

    pub fnc imethodref(cls string, name string, desc string) : int {
        ci: int = this.class_entry(cls);
        ni: int = this.nat(this.utf8(name), this.utf8(desc));
        key: string = "IM:" + tostring(ci) + ":" + tostring(ni);
        if this.keys.isin(key) { return this.keys[key]; }
        pl: vec<int>;
        pl.pushb((ci >> 8) & 255);
        pl.pushb(ci & 255);
        pl.pushb((ni >> 8) & 255);
        pl.pushb(ni & 255);
        return this.alloc(11, key, pl, 1);
    }

    pub fnc methodref(cls string, name string, desc string) : int {
        ci: int = this.class_entry(cls);
        ni: int = this.nat(this.utf8(name), this.utf8(desc));
        key: string = "M:" + tostring(ci) + ":" + tostring(ni);
        if this.keys.isin(key) { return this.keys[key]; }
        pl: vec<int>;
        pl.pushb((ci >> 8) & 255);
        pl.pushb(ci & 255);
        pl.pushb((ni >> 8) & 255);
        pl.pushb(ni & 255);
        return this.alloc(JCp.METHODREF, key, pl, 1);
    }

    pub fnc string_const(s string) : int {
        ui: int = this.utf8(s);
        key: string = "S:" + tostring(ui);
        if this.keys.isin(key) { return this.keys[key]; }
        pl: vec<int>;
        pl.pushb((ui >> 8) & 255);
        pl.pushb(ui & 255);
        return this.alloc(JCp.STRING, key, pl, 1);
    }

    pub fnc int_const(v int) : int {
        key: string = "I:" + tostring(v);
        if this.keys.isin(key) { return this.keys[key]; }
        // Two's-complement bytes: >> is arithmetic on negatives, so the
        // low 8 bits are already correct after masking.
        pl: vec<int>;
        pl.pushb((v >> 24) & 255);
        pl.pushb((v >> 16) & 255);
        pl.pushb((v >> 8) & 255);
        pl.pushb(v & 255);
        return this.alloc(JCp.INT, key, pl, 1);
    }

    pub fnc long_const(hi int, lo int) : int {
        key: string = "J:" + tostring(hi) + ":" + tostring(lo);
        if this.keys.isin(key) { return this.keys[key]; }
        pl: vec<int>;
        pl.pushb((hi >> 24) & 255);
        pl.pushb((hi >> 16) & 255);
        pl.pushb((hi >> 8) & 255);
        pl.pushb(hi & 255);
        pl.pushb((lo >> 24) & 255);
        pl.pushb((lo >> 16) & 255);
        pl.pushb((lo >> 8) & 255);
        pl.pushb(lo & 255);
        return this.alloc(JCp.LONG, key, pl, 2);
    }

    pub fnc double_const(hi int, lo int) : int {
        key: string = "D:" + tostring(hi) + ":" + tostring(lo);
        if this.keys.isin(key) { return this.keys[key]; }
        pl: vec<int>;
        pl.pushb((hi >> 24) & 255);
        pl.pushb((hi >> 16) & 255);
        pl.pushb((hi >> 8) & 255);
        pl.pushb(hi & 255);
        pl.pushb((lo >> 24) & 255);
        pl.pushb((lo >> 16) & 255);
        pl.pushb((lo >> 8) & 255);
        pl.pushb(lo & 255);
        return this.alloc(JCp.DOUBLE, key, pl, 2);
    }

    pub fnc count() : int {
        return this.next_idx;
    }

    pub fnc write_to() : vec<int> {
        out: vec<int>;
        n: int = this.next_idx;
        out.pushb((n >> 8) & 255);
        out.pushb(n & 255);
        i: int = 0;
        while i < this.tags.size {
            tag: int = this.tags.get(i);
            out.pushb(tag);
            if tag == JCp.UTF8 {
                payload: vec<int> = this.payloads.get(i);
                out.pushb((payload.size >> 8) & 255);
                out.pushb(payload.size & 255);
                foreach _, b in<vector> payload {
                    out.pushb(b);
                }
            } else {
                foreach _, b in<vector> this.payloads.get(i) {
                    out.pushb(b);
                }
            }
            i = i + 1;
        }
        return out;
    }
}

// One method's bytecode under construction: labels resolve at finalize,
// max_stack is tracked from per-opcode depth deltas (long/double = 2).
pub def JvmMethod : class {
    pub name_i: int;
    pub desc_i: int;
    pub access: int;
    pub code: vec<int>;
    pub labels: hash<string, int>;
    pub patch_pos: vec<int>;
    pub patch_lbl: vec<string>;
    pub depth: int;
    pub max_depth: int;
    pub site_delta: hash<int, int>;
    pub last_op: int;
    pub locals_used: int;
    pub errors: vec<string>;
    pub tmps: hash<string, int>;

    static pub fnc make(name_i int, desc_i int, access int) : JvmMethod {
        empty_code: vec<int>;
        empty_labels: hash<string, int>;
        empty_pos: vec<int>;
        empty_lbl: vec<string>;
        empty_err: vec<string>;
        empty_tmps: hash<string, int>;
        empty_sd: hash<int, int>;
        return JvmMethod { name_i: name_i, desc_i: desc_i, access: access, code: empty_code, labels: empty_labels, patch_pos: empty_pos, patch_lbl: empty_lbl, depth: 0, max_depth: 0, site_delta: empty_sd, last_op: 0, locals_used: 0, errors: empty_err, tmps: empty_tmps };
    }

    // A reusable scratch slot per descriptor (for stack juggling).
    pub fnc temp_slot(desc string) : int {
        if this.tmps.isin(desc) { return this.tmps[desc]; }
        slots: int = 1;
        if desc == "J" || desc == "D" { slots = 2; }
        s: int = this.alloc_local(slots);
        this.tmps.push(desc, s);
        return s;
    }
    pub fnc fail(msg string) : void {
        this.errors.pushb(msg);
    }

    pub fnc adjust(d int) : void {
        this.depth = this.depth + d;
        if this.depth > this.max_depth { this.max_depth = this.depth; }
        if this.depth < 0 { this.fail("stack underflow"); }
    }

    pub fnc emit_u8(v int) : void {
        this.code.pushb(v & 255);
    }

    pub fnc emit_u16(v int) : void {
        this.code.pushb((v >> 8) & 255);
        this.code.pushb(v & 255);
    }

    // Raw opcode with an explicit stack delta (slots; long/double = 2).
    pub fnc op(op int, delta int) : void {
        this.last_op = op;
        this.emit_u8(op);
        this.adjust(delta);
    }

    // Helpers for the common shapes.
    pub fnc op_none(op int) : void {
        this.emit_u8(op);
    }

    pub fnc op_1(op int, a int, delta int) : void {
        this.emit_u8(op);
        this.emit_u8(a);
        this.adjust(delta);
    }

    pub fnc op_11(op int, a int, b int, delta int) : void {
        this.emit_u8(op);
        this.emit_u8(a);
        this.emit_u8(b);
        this.adjust(delta);
    }

    // Field access with an explicit net delta; the delta is also
    // recorded for the post-pass bytecode verifier.
    pub fnc op_field(op int, idx int, net int) : void {
        this.site_delta.push(this.code.size, net);
        this.emit_u8(op);
        this.emit_u8((idx >> 8) & 255);
        this.emit_u8(idx & 255);
        this.adjust(net);
    }

    pub fnc mark(lbl string) : void {
        this.labels.push(lbl, this.code.size);
    }

    // Two-byte branch (goto/if_*): patched at finalize.
    pub fnc branch(op int, lbl string, pop_slots int) : void {
        this.emit_u8(op);
        this.patch_pos.pushb(this.code.size);
        this.patch_lbl.pushb(lbl);
        this.emit_u16(0);
        this.adjust(0 - pop_slots);
    }

    pub fnc alloc_local(slots int) : int {
        if this.locals_used + slots > 65535 {
            this.fail("too many locals (exceeds JVM limits)");
            return 0;
        }
        base: int = this.locals_used;
        this.locals_used = this.locals_used + slots;
        return base;
    }

    pub fnc load_local(desc string, slot int) : void {
        // Longs and doubles BOTH occupy two slots but use distinct
        // opcode families — mixing them fails verification (the old
        // V49 verifier reports it precisely; the split verifier masks
        // it behind misleading stackmap errors).
        if desc == "J" {
            if slot < 4 {
                this.op(JOp.LLOAD_0 + slot, 2);
            } else {
                this.emit_u8(JOp.WIDE);
                this.emit_u8(JOp.LLOAD);
                this.emit_u16(slot);
                this.adjust(2);
            }
            return;
        }
        if desc == "D" {
            if slot < 4 {
                this.op(JOp.DLOAD_0 + slot, 2);
            } else {
                this.emit_u8(JOp.WIDE);
                this.emit_u8(JOp.DLOAD);
                this.emit_u16(slot);
                this.adjust(2);
            }
            return;
        }
        if desc == "I" || desc == "Z" || desc == "B" || desc == "S" || desc == "C" {
            if slot < 4 {
                this.op(JOp.ILOAD_0 + slot, 1);
            } else {
                this.emit_u8(JOp.WIDE);
                this.emit_u8(JOp.ILOAD);
                this.emit_u16(slot);
                this.adjust(1);
            }
            return;
        }
        if slot < 4 {
            this.op(JOp.ALOAD_0 + slot, 1);
        } else {
            this.emit_u8(JOp.WIDE);
            this.emit_u8(JOp.ALOAD);
            this.emit_u16(slot);
            this.adjust(1);
        }
    }

    pub fnc store_local(desc string, slot int) : void {
        if desc == "J" {
            if slot < 4 {
                this.op(JOp.LSTORE_0 + slot, -2);
            } else {
                this.emit_u8(JOp.WIDE);
                this.emit_u8(JOp.LSTORE);
                this.emit_u16(slot);
                this.adjust(-2);
            }
            return;
        }
        if desc == "D" {
            if slot < 4 {
                this.op(JOp.DSTORE_0 + slot, -2);
            } else {
                this.emit_u8(JOp.WIDE);
                this.emit_u8(JOp.DSTORE);
                this.emit_u16(slot);
                this.adjust(-2);
            }
            return;
        }
        if desc == "I" || desc == "Z" || desc == "B" || desc == "S" || desc == "C" {
            if slot < 4 {
                this.op(JOp.ISTORE_0 + slot, -1);
            } else {
                this.emit_u8(JOp.WIDE);
                this.emit_u8(JOp.ISTORE);
                this.emit_u16(slot);
                this.adjust(-1);
            }
            return;
        }
        if slot < 4 {
            this.op(JOp.ASTORE_0 + slot, -1);
        } else {
            this.emit_u8(JOp.WIDE);
            this.emit_u8(JOp.ASTORE);
            this.emit_u16(slot);
            this.adjust(-1);
        }
    }

    pub fnc finalize(cp JvmCp) : bool {
        // Resolve branch patches (s16 offsets from the opcode start).
        i: int = 0;
        while i < this.patch_pos.size {
            pos: int = this.patch_pos.get(i);
            lbl: string = this.patch_lbl.get(i);
            if !this.labels.isin(lbl) {
                this.fail("undefined label: " + lbl);
                return false;
            }
            target: int = this.labels[lbl];
            op_at: int = pos - 1;
            off: int = target - op_at;
            if off < -32768 || off > 32767 {
                this.fail("branch out of range (goto_w unsupported)");
                return false;
            }
            u: int = off;
            if u < 0 { u = u + 65536; }
            this.code.set(pos, (u >> 8) & 255);
            this.code.set(pos + 1, u & 255);
            i = i + 1;
        }
        if !this.verify_code() {
            return false;
        }
        return this.errors.size == 0;
    }

    // Post-pass bytecode verification: simulate stack depth over the
    // patched code and require every join to agree. Catches the JVM's
    // "Inconsistent stack height" class at emission time with an exact
    // offset, instead of surfacing at class-load time.

    pub fnc vrfy_len(op int) : int {
        if op == JOp.BIPUSH || op == JOp.LDC || op == JOp.NEWARRAY { return 2; }
        if op == JOp.ILOAD || op == JOp.LLOAD || op == JOp.DLOAD || op == JOp.ALOAD { return 2; }
        if op == JOp.ISTORE || op == JOp.LSTORE || op == JOp.DSTORE || op == JOp.ASTORE { return 2; }
        if op == JOp.SIPUSH || op == JOp.LDC_W || op == JOp.LDC2_W { return 3; }
        if op >= 153 && op <= 167 { return 3; }
        if op == 198 || op == 199 { return 3; }
        if op == JOp.NEW || op == JOp.ANEWARRAY || op == JOp.CHECKCAST { return 3; }
        if op == JOp.GETSTATIC || op == JOp.PUTSTATIC || op == JOp.GETFIELD || op == JOp.PUTFIELD { return 3; }
        if op == JOp.INVOKEVIRTUAL || op == JOp.INVOKESPECIAL || op == JOp.INVOKESTATIC { return 3; }
        if op == JOp.INVOKEINTERFACE { return 5; }
        if op == JOp.WIDE { return 4; }
        return 1;
    }

    pub fnc vrfy_off(pc int) : int {
        off: int = this.code.get(pc + 1) * 256 + this.code.get(pc + 2);
        if off >= 32768 { off = off - 32768 - 32768; }
        return off;
    }

    // Net stack delta for opcodes with pc-independent effects.
    // Branches, site-table ops (invoke/field), WIDE and returns are
    // handled inline by verify_code; unknown opcodes fail here.
    pub fnc vrfy_delta(op int) : int {
        if op == JOp.ACONST_NULL { return 1; }
        if op >= 2 && op <= 8 { return 1; }
        if op == JOp.LCONST_0 { return 2; }
        if op == JOp.DCONST_0 { return 2; }
        if op == JOp.BIPUSH || op == JOp.SIPUSH { return 1; }
        if op == JOp.LDC || op == JOp.LDC_W { return 1; }
        if op == JOp.LDC2_W { return 2; }
        if op >= 26 && op <= 29 { return 1; }
        if op >= 30 && op <= 33 { return 2; }
        if op >= 34 && op <= 37 { return 1; }
        if op >= 38 && op <= 41 { return 2; }
        if op >= 42 && op <= 45 { return 1; }
        if op == JOp.ILOAD || op == JOp.ALOAD { return 1; }
        if op == JOp.LLOAD || op == JOp.DLOAD { return 2; }
        if op >= 59 && op <= 62 { return 0 - 1; }
        if op >= 63 && op <= 66 { return 0 - 2; }
        if op >= 67 && op <= 70 { return 0 - 1; }
        if op >= 71 && op <= 74 { return 0 - 2; }
        if op >= 75 && op <= 78 { return 0 - 1; }
        if op == JOp.ISTORE || op == JOp.ASTORE { return 0 - 1; }
        if op == JOp.LSTORE || op == JOp.DSTORE { return 0 - 2; }
        if op == JOp.IALOAD || op == JOp.AALOAD || op == JOp.BALOAD || op == JOp.CALOAD || op == JOp.SALOAD { return 0 - 1; }
        if op == JOp.LALOAD || op == JOp.DALOAD { return 0; }
        if op == JOp.IASTORE || op == JOp.AASTORE || op == JOp.BASTORE || op == JOp.CASTORE || op == JOp.SASTORE { return 0 - 3; }
        if op == JOp.LASTORE || op == JOp.DASTORE { return 0 - 4; }
        if op == JOp.ARRAYLENGTH { return 0; }
        if op == JOp.NEWARRAY || op == JOp.ANEWARRAY { return 0; }
        if op == JOp.POP { return 0 - 1; }
        if op == JOp.POP2 { return 0 - 2; }
        if op == JOp.DUP { return 1; }
        if op == JOp.DUP2 { return 2; }
        if op == JOp.SWAP { return 0; }
        if op == JOp.NEW { return 1; }
        if op == JOp.CHECKCAST { return 0; }
        if op >= 96 && op <= 131 {
            if op >= 116 && op <= 119 { return 0; }
            if op >= 120 && op <= 125 { return 0 - 1; }
            lane: int = op - 96;
            while lane >= 4 { lane = lane - 4; }
            if lane == 1 || lane == 3 { return 0 - 2; }
            return 0 - 1;
        }
        if op >= 148 && op <= 152 { return 0 - 3; }
        if op == JOp.I2L || op == JOp.I2D { return 1; }
        if op == JOp.L2I { return 0 - 1; }
        if op == JOp.L2D { return 0; }
        if op == JOp.D2I { return 0 - 1; }
        if op == JOp.D2L { return 0; }
        if op == JOp.I2B || op == JOp.I2C || op == JOp.I2S { return 0; }
        this.fail("verify: unknown opcode " + tostring(op));
        return 0 - 1000000;
    }

    pub fnc verify_code() : bool {
        n: int = this.code.size;
        if n == 0 { return true; }
        depth_at: vec<int>;
        di: int = 0;
        while di < n {
            depth_at.pushb(0 - 1);
            di = di + 1;
        }
        wl: vec<int>;
        wl.pushb(0);
        wl.pushb(0);
        max_d: int = 0;
        while wl.size > 0 {
            d: int = wl.get(wl.size - 1);
            wl.popb();
            pc: int = wl.get(wl.size - 1);
            wl.popb();
            if pc < 0 || pc >= n {
                this.fail("verify: branch target out of range");
                return false;
            }
            if depth_at.get(pc) >= 0 {
                if depth_at.get(pc) != d {
                    this.fail("verify: inconsistent stack height " + tostring(d) + " != " + tostring(depth_at.get(pc)) + " at offset " + tostring(pc));
                    return false;
                }
            } else {
                depth_at.set(pc, d);
                if d > max_d { max_d = d; }
                op: int = this.code.get(pc);
                ln: int = this.vrfy_len(op);
                delta: int = 0;
                t1: int = 0 - 1;
                fall: bool = true;
                ends: bool = false;
                if op == JOp.WIDE {
                    rop: int = this.code.get(pc + 1);
                    if rop == JOp.LLOAD || rop == JOp.DLOAD { delta = 2; }
                    also rop == JOp.ILOAD || rop == JOp.ALOAD { delta = 1; }
                    also rop == JOp.LSTORE || rop == JOp.DSTORE { delta = 0 - 2; }
                    also rop == JOp.ISTORE || rop == JOp.ASTORE { delta = 0 - 1; }
                    else {
                        this.fail("verify: wide of unexpected opcode");
                        return false;
                    }
                } also op == JOp.GOTO {
                    t1 = pc + this.vrfy_off(pc);
                    fall = false;
                } also (op >= 153 && op <= 158) || op == 198 || op == 199 {
                    t1 = pc + this.vrfy_off(pc);
                    delta = 0 - 1;
                } also op >= 159 && op <= 166 {
                    t1 = pc + this.vrfy_off(pc);
                    delta = 0 - 2;
                } also op == JOp.GETSTATIC || op == JOp.PUTSTATIC || op == JOp.GETFIELD || op == JOp.PUTFIELD || op == JOp.INVOKEVIRTUAL || op == JOp.INVOKESPECIAL || op == JOp.INVOKESTATIC || op == JOp.INVOKEINTERFACE {
                    if !this.site_delta.isin(pc) {
                        this.fail("verify: missing site delta at offset " + tostring(pc));
                        return false;
                    }
                    delta = this.site_delta[pc];
                } also op == JOp.IRETURN || op == JOp.LRETURN || op == JOp.DRETURN || op == JOp.ARETURN || op == JOp.RETURN {
                    ends = true;
                } else {
                    delta = this.vrfy_delta(op);
                    if delta == 0 - 1000000 {
                        return false;
                    }
                }
                nd: int = d + delta;
                if nd < 0 {
                    this.fail("verify: stack underflow at offset " + tostring(pc));
                    return false;
                }
                if !ends {
                    if t1 >= 0 {
                        wl.pushb(t1);
                        wl.pushb(nd);
                    }
                    if fall {
                        wl.pushb(pc + ln);
                        wl.pushb(nd);
                    }
                }
            }
        }
        if max_d > this.max_depth { this.max_depth = max_d; }
        return true;
    }



    pub fnc write_to(code_idx int) : vec<int> {
        out: vec<int>;
        // access_flags, name_index, descriptor_index, attributes_count
        out.pushb((this.access >> 8) & 255);
        out.pushb(this.access & 255);
        out.pushb((this.name_i >> 8) & 255);
        out.pushb(this.name_i & 255);
        out.pushb((this.desc_i >> 8) & 255);
        out.pushb(this.desc_i & 255);
        out.pushb(0);
        out.pushb(1);
        out.pushb((code_idx >> 8) & 255);
        out.pushb(code_idx & 255);
        attr_len: int = 12 + this.code.size;
        out.pushb((attr_len >> 24) & 255);
        out.pushb((attr_len >> 16) & 255);
        out.pushb((attr_len >> 8) & 255);
        out.pushb(attr_len & 255);
        // HotSpot's pre-StackMapTable verifier rejects max_stack < 2 in
        // methods containing branches (verified empirically: identical
        // bytecode passes with max_stack=2, fails with 1).
        ms: int = this.max_depth;
        if ms < 2 { ms = 2; }
        out.pushb((ms >> 8) & 255);
        out.pushb(ms & 255);
        out.pushb((this.locals_used >> 8) & 255);
        out.pushb(this.locals_used & 255);
        out.pushb((this.code.size >> 24) & 255);
        out.pushb((this.code.size >> 16) & 255);
        out.pushb((this.code.size >> 8) & 255);
        out.pushb(this.code.size & 255);
        foreach _, b in<vector> this.code {
            out.pushb(b);
        }
        // exception_table_length = 0, attributes_count = 0
        out.pushb(0);
        out.pushb(0);
        out.pushb(0);
        out.pushb(0);
        return out;
    }
}

// A whole class file: fields + methods over one constant pool.
pub def JvmClass : class {
    pub name: string;
    pub super_name: string;
    pub ifaces: vec<string>;
    pub cp: JvmCp;
    pub f_access: vec<int>;
    pub f_name: vec<int>;
    pub f_desc: vec<int>;
    pub methods: vec<JvmMethod>;

    static pub fnc make(name string, super_name string) : JvmClass {
        empty_a: vec<int>;
        empty_n: vec<int>;
        empty_d: vec<int>;
        empty_m: vec<JvmMethod>;
        empty_if: vec<string>;
        return JvmClass { name: name, super_name: super_name, ifaces: empty_if, cp: JvmCp.make(), f_access: empty_a, f_name: empty_n, f_desc: empty_d, methods: empty_m };
    }

    pub fnc add_field(access int, name string, desc string) : void {
        this.f_access.pushb(access);
        this.f_name.pushb(this.cp.utf8(name));
        this.f_desc.pushb(this.cp.utf8(desc));
    }

    pub fnc add_method(m JvmMethod) : void {
        this.methods.pushb(m);
    }

    pub fnc write_to() : vec<int> {
        out: vec<int>;
        out.pushb(202);
        out.pushb(254);
        out.pushb(186);
        out.pushb(190);
        out.pushb(0);
        out.pushb(0);
        // Major version 49 (Java 5): verified by the old inferencing
        // verifier, which needs no StackMapTable and reports type
        // errors precisely. The split verifier (v50+) instead chokes
        // on hand-emitted control-flow shapes with misleading
        // "Expecting a stackmap frame" errors.
        out.pushb(0);
        out.pushb(49);
        // Intern every entry BEFORE the pool hits the wire: later
        // interning would mint indices past the written count.
        this_i: int = this.cp.class_entry(this.name);
        super_i: int = this.cp.class_entry(this.super_name);
        code_idx: int = this.cp.utf8("Code");
        iface_idx: vec<int>;
        ii: int = 0;
        while ii < this.ifaces.size {
            iface_idx.pushb(this.cp.class_entry(this.ifaces.get(ii)));
            ii = ii + 1;
        }
        cpp: vec<int> = this.cp.write_to();
        ci: int = 0;
        while ci < cpp.size {
            out.pushb(cpp.get(ci));
            ci = ci + 1;
        }
        out.pushb(0);
        out.pushb(33);
        out.pushb((this_i >> 8) & 255);
        out.pushb(this_i & 255);
        out.pushb((super_i >> 8) & 255);
        out.pushb(super_i & 255);
        out.pushb((iface_idx.size >> 8) & 255);
        out.pushb(iface_idx.size & 255);
        ii = 0;
        while ii < iface_idx.size {
            if_i: int = iface_idx.get(ii);
            out.pushb((if_i >> 8) & 255);
            out.pushb(if_i & 255);
            ii = ii + 1;
        }
        out.pushb((this.f_access.size >> 8) & 255);
        out.pushb(this.f_access.size & 255);
        i: int = 0;
        while i < this.f_access.size {
            out.pushb((this.f_access.get(i) >> 8) & 255);
            out.pushb(this.f_access.get(i) & 255);
            ni: int = this.f_name.get(i);
            out.pushb((ni >> 8) & 255);
            out.pushb(ni & 255);
            di: int = this.f_desc.get(i);
            out.pushb((di >> 8) & 255);
            out.pushb(di & 255);
            out.pushb(0);
            out.pushb(0);
            i = i + 1;
        }
        out.pushb((this.methods.size >> 8) & 255);
        out.pushb(this.methods.size & 255);
        foreach _, m in<vector> this.methods {
            mp: vec<int> = m.write_to(code_idx);
            mi2: int = 0;
            while mi2 < mp.size {
                out.pushb(mp.get(mi2));
                mi2 = mi2 + 1;
            }
        }
        out.pushb(0);
        out.pushb(0);
        return out;
    }
}

// The Leash -> JVM emitter: one JvmGen per program. Functions become
// static methods of the main class; expression code leaves its value
// on the operand stack (long/double occupy two slots).
pub def JvmGen : class {
    pub tc: TypeChecker;
    pub cg: CodeGen;
    pub main_class: string;
    pub errors: vec<string>;
    pub var_types: hash<string, string>;
    pub var_slots: hash<string, int>;
    pub label_counter: int;
    pub defer_stack: vec<Stmt>;
    pub fusion_names: hash<string, bool>;
    pub loop_heads: vec<string>;
    pub loop_exits: vec<string>;
    pub current_func_ret: string;
    pub current_func_name: string;
    pub current_func_unsafe: bool;
    pub opdef_inner: string;
    pub current_helper_name: string;
    pub tmap_owner: string;
    pub cur_cp: JvmCp;
    pub cur_method: JvmMethod;
    pub has_entry: bool;
    pub src_file: string;
    pub klasses: vec<JvmClass>;
    pub array_base_override: string;
    pub klass_idx: hash<string, int>;
    pub extern_names: hash<string, bool>;
    pub current_class: string;

    static pub fnc make(tc TypeChecker, main_class string) : JvmGen {
        empty_err: vec<string>;
        empty_vt: hash<string, string>;
        empty_vs: hash<string, int>;
        empty_defers: vec<Stmt>;
        empty_fn: hash<string, bool>;
        empty_hh: vec<string>;
        empty_he: vec<string>;
        empty_kl: vec<JvmClass>;
        empty_ki: hash<string, int>;
        return JvmGen { tc: tc, cg: CodeGen.make(tc), main_class: main_class, errors: empty_err, var_types: empty_vt, var_slots: empty_vs, label_counter: 0, defer_stack: empty_defers, fusion_names: empty_fn, loop_heads: empty_hh, loop_exits: empty_he, current_func_ret: "void", current_func_name: "", current_func_unsafe: false, current_helper_name: "", opdef_inner: "", tmap_owner: "", cur_cp: JvmCp.make(), cur_method: JvmMethod.make(0, 0, 0), has_entry: false, src_file: "", klasses: empty_kl, klass_idx: empty_ki, current_class: "", array_base_override: "" };
    }

    // Keep the oracle's view of locals identical to ours.
    pub fnc define_var(name string, typ string, slot int) : void {
        this.var_types.push(name, typ);
        this.var_slots.push(name, slot);
        this.cg.var_types.push(name, typ);
        this.cg.var_ptrs.push(name, "@jvm_dummy");
    }

    pub fnc expr_type(e Expr) : string {
        if e != null && e.kind == ExprKind.IDENT && e.sval == "_" { return "int"; }
        if e != null && e.kind == ExprKind.MEMBER && e.left != null
           && e.left.kind == ExprKind.IDENT && e.left.sval == "this"
           && this.current_class.size > 0 && this.tc.static_fields.isin(this.current_class + "_" + e.sval) {
            return this.tc.static_fields[this.current_class + "_" + e.sval];
        }
        if e != null && e.kind == ExprKind.MEMBER && e.sval == "cur" && e.left != null {
            lt: string = this.cg.get_expr_type(e.left);
            if this.tc.unions.isin(lt) { return "string"; }
        }
        // Method-result overrides where the shared oracle is imprecise
        // (popf/remove/clear/extend/set/delete/push all fall to "void"
        // there; values() is hard-coded to vec<int>).
        if e != null && e.kind == ExprKind.METHOD_CALL && e.left != null {
            lt: string = this.cg.get_expr_type(e.left);
            mt: string = this.mcall_type(lt, e.sval);
            if mt.size > 0 { return mt; }
        }
        if e != null && e.kind == ExprKind.ARRAY_LIT && e.sval == "__tuple__" {
            ts: string = "(";
            ti: int = 0;
            while ti < e.args.size {
                if ti > 0 { ts = ts + ", "; }
                ts = ts + this.expr_type(e.args.get(ti));
                ti = ti + 1;
            }
            ts = ts + ")";
            return ts;
        }
        if e != null && e.kind == ExprKind.CALL && e.sval == "__tupget" && e.args.size == 2 {
            tt: string = this.expr_type(e.args.get(0));
            tidx: int = e.args.get(1).ival;
            return this.tuple_elem(tt, tidx);
        }
        if e != null && e.kind == ExprKind.CALL {
            bt: string = this.builtin_type(e);
            if bt.size > 0 { return bt; }
        }
        if e != null && e.kind == ExprKind.METHOD_CALL && e.left != null
           && e.left.kind == ExprKind.IDENT && e.left.sval == "File" {
            if e.sval == "open" { return "File"; }
            if e.sval == "rename" || e.sval == "delete" { return "int"; }
            return "";
        }
        if e != null && e.kind == ExprKind.METHOD_CALL && e.left != null {
            lt2: string = this.cg.get_expr_type(e.left);
            if lt2 == "File" {
                if e.sval == "read" || e.sval == "readln" { return "string"; }
                if e.sval == "readb" || e.sval == "readlnb" { return "char[]"; }
                if e.sval == "size" || e.sval == "isin" { return "int"; }
                if e.sval == "rewind" { return "void"; }
                return "int";
            }
        }
        if e != null && e.kind == ExprKind.INT
           && e.sval.size > 0 && this.is_plain_decimal(e.sval) && !this.lit_fits_i64(e.sval) {
            // Out-of-int64 decimal text rides as BigInteger (full
            // precision); downstream coercions narrow as needed.
            return "int<512>";
        }
        if e != null && e.kind == ExprKind.INT
           && (e.ival > 2147483647 || e.ival < 0 - 2147483648) {
            return "int<64>";
        }
        return this.cg.get_expr_type(e);
    }

    // JVM-side result types for builtin calls.
    pub fnc builtin_type(e Expr) : string {
        f: string = e.sval;
        if f == "cstr" { return "char[]"; }
        if f == "typeof" { return "string"; }
        if f == "sizeof" { return "int"; }
        if f == "get" { return "string"; }
        if f == "seed" || f == "wait" { return "void"; }
        if f == "rand" { return "int"; }
        if f == "randf" || f == "timepass" { return "float"; }
        if f == "choose" { return "string"; }
        if f == "getenv" { return "*char"; }
        if f == "exit" { return "void"; }
        if f == "tounion" && e.args.size > 0 { return e.args.get(0).sval; }
        if f == "normescape" || f == "lstr" { return "string"; }
        if f == "inttobytes" || f == "floattobytes" { return "char[]"; }
        if f == "bytestoint" { return "int"; }
        if f == "bytestofloat" { return "float"; }
        if f == "toint" {
            if e.args.size == 2 { return this.tc.resolve_type_alias(e.args.get(0).sval); }
            return "int";
        }
        if f == "tofloat" {
            if e.args.size == 2 { return this.tc.resolve_type_alias(e.args.get(0).sval); }
            return "float";
        }
        if f == "tochar" {
            if e.args.size == 2 { return this.tc.resolve_type_alias(e.args.get(0).sval); }
            return "char";
        }
        if f == "scast" && e.args.size == 2 {
            return this.tc.resolve_type_alias(e.args.get(0).sval);
        }
        return "";
    }

    pub fnc fail(msg string) : void {
        if msg.size >= 8 && msg[0] == 'v' && msg[1] == 'e' && msg[2] == 'r' && msg[3] == 'i' && msg[4] == 'f' && msg[5] == 'y' && msg[6] == ':' {
            ctx: string = this.current_func_name;
            if ctx.size == 0 { ctx = this.current_helper_name; }
            this.errors.pushb("[" + ctx + "] " + msg);
            return;
        }
        this.errors.pushb(msg);
    }

    pub fnc jvm_unsupported(what string) : string {
        this.fail("jvm target: unsupported construct: " + what);
        return "";
    }

    pub fnc new_label(prefix string) : string {
        l: string = prefix + "_" + tostring(this.label_counter);
        this.label_counter = this.label_counter + 1;
        return l;
    }

    // --- Type mapping -------------------------------------------------
    // int/uint/char/bool -> I (narrow widths narrow after production),
    // Inside an instantiated generic class, a bare template base name
    // refers to the current instantiation (native parity).
    pub fnc resolve_class_ref(name string) : string {
        if this.tmap_owner.size == 0 { return name; }
        if !this.tc.generic_classes.isin(name) { return name; }
        pre: string = name + "_";
        if this.tmap_owner.size > pre.size {
            ok: bool = true;
            pi: int = 0;
            while pi < pre.size {
                if this.tmap_owner[pi] != pre[pi] { ok = false; }
                pi = pi + 1;
            }
            if ok { return this.tmap_owner; }
        }
        return name;
    }

    // Substitute the current instantiation's type parameters (exact names
    // and one level of vec<> nesting).
    pub fnc resolve_tparam(typ string) : string {
        if this.tmap_owner.size == 0 { return typ; }
        if !this.tc.inst_tmaps.isin(this.tmap_owner) { return typ; }
        tmap_flat: vec<string> = this.tc.inst_tmaps[this.tmap_owner];
        flat: vec<string> = tmap_flat;
        fi: int = 0;
        while fi + 1 < flat.size {
            if flat.get(fi) == typ { return flat.get(fi + 1); }
            fi = fi + 2;
        }
        if typ.size > 5 && typ[typ.size - 1] == '>' && typ[0] == 'v' && typ[1] == 'e' && typ[2] == 'c' && typ[3] == '<' {
            inner: string = this.vec_inner_type(typ);
            ri: string = this.resolve_tparam(inner);
            if ri != inner { return "vec<" + ri + ">"; }
        }
        return typ;
    }

    // int<64>/uint<64> -> J, floats -> D, string -> String,
    // vec -> ArrayList, hash -> HashMap. "" = unsupported.
    pub fnc jdesc(t string) : string {
        if (t == "thisop.typ" || t == "__T_OPDEF__") && this.opdef_inner.size > 0 {
            return this.jdesc(this.opdef_inner);
        }
        t = this.resolve_tparam(this.resolve_class_ref(t));
        if t.size > 1 && t[0] == '&' {
            inner: string = "";
            i: int = 1;
            while i < t.size {
                inner = inner + t[i];
                i = i + 1;
            }
            return this.jdesc(inner);
        }
        if t == "int" || t == "uint" || t == "char" { return "I"; }
        if t == "bool" { return "Z"; }
        if t == "int<8>" || t == "int<16>" || t == "int<32>" { return "I"; }
        if t == "uint<8>" || t == "uint<16>" || t == "uint<32>" { return "I"; }
        if t == "int<64>" || t == "uint<64>" || t == "int64" || t == "uint64" { return "J"; }
        // Odd widths: <= 32 ride the int lane (C promotion in flight,
        // narrowed on store); > 64 ride BigInteger. 64 stays put.
        wj: int = this.int_width(t);
        if wj > 0 && wj <= 32 { return "I"; }
        // 64 rides the long lane (natural wrap); every other wide width
        // rides BigInteger with explicit wrapping.
        if wj > 32 { return "Ljava/math/BigInteger;"; }
        if t == "float" || t == "double" || t == "float64" { return "D"; }
        if t == "float<16>" || t == "float<32>" || t == "float<64>" || t == "float<128>" { return "D"; }
        if t == "string" { return "Ljava/lang/String;"; }
        // C strings ride as Java strings (or null); arithmetic on other
        // pointer types stays unsupported.
        if t == "pointer<char>" || t == "*char" { return "Ljava/lang/String;"; }
        if t.size > 8 && t[0] == 'f' && t[1] == 'u' && t[2] == 't' && t[3] == 'u' && t[4] == 'r' && t[5] == 'e' && t[6] == '<' { return "Ljava/util/concurrent/CompletableFuture;"; }
        if t == "void" { return "V"; }
        if t.size > 4 && t[0] == 'v' && t[1] == 'e' && t[2] == 'c' && t[3] == '<' { return "Ljava/util/ArrayList;"; }
        if t.size > 5 && t[0] == 'h' && t[1] == 'a' && t[2] == 's' && t[3] == 'h' && t[4] == '<' { return "Ljava/util/HashMap;"; }
        if t.size > 0 && t[0] == '*' { return "Ljava/lang/Object;"; }
        if t.size > 2 && t[t.size - 1] == ']' {
            base: string = "";
            bi: int = 0;
            while bi < t.size && t[bi] != '[' {
                base = base + t[bi];
                bi = bi + 1;
            }
            // char arrays are real [C (cstr/toCharArray produce them);
            // scalar chars still ride the int lane.
            if base == "char" { return "[C"; }
            return "[" + this.jdesc(base);
        }
        if t.size > 1 && t[0] == '(' { return "[Ljava/lang/Object;"; }
        if t == "File" { return "Ljava/io/RandomAccessFile;"; }
        if this.tc.enums.isin(t) { return "I"; }
        if this.tc.structs.isin(t) { return "L" + t + ";"; }
        if this.tc.classes.isin(t) { return "L" + t + ";"; }
        if this.tc.unions.isin(t) { return "[Ljava/lang/Object;"; }
        if t == "nil" { return "Ljava/lang/Object;"; }
        return "";
    }

    pub fnc slots_of(d string) : int {
        if d == "J" || d == "D" { return 2; }
        return 1;
    }

    pub fnc is_uint_leash(t string) : bool {
        if t == "uint" { return true; }
        return t.size > 5 && t[0] == 'u' && t[1] == 'i' && t[2] == 'n' && t[3] == 't' && t[4] == '<';
    }

    pub fnc both_refs(ld string, rd string) : bool {
        lok: bool = ld.size > 0 && (ld[0] == 'L' || ld[0] == '[');
        rok: bool = rd.size > 0 && (rd[0] == 'L' || rd[0] == '[');
        return lok && rok;
    }

    pub fnc is_vec_leash(t string) : bool {
        if t.size > 4 && t[0] == 'v' && t[1] == 'e' && t[2] == 'c' && t[3] == '<' { return true; }
        return false;
    }

    pub fnc is_hash_leash(t string) : bool {
        if t.size > 5 && t[0] == 'h' && t[1] == 'a' && t[2] == 's' && t[3] == 'h' && t[4] == '<' { return true; }
        return false;
    }

    // Element type of vec<T> (handles nesting via depth counting).
    pub fnc vec_inner_type(t string) : string {
        start: int = 4;
        if t.size > 7 && t[0] == 'm' && t[1] == 'a' && t[2] == 't' && t[3] == 'r' && t[4] == 'i' && t[5] == 'x' && t[6] == '<' { start = 7; }
        depth: int = 0;
        i: int = start;
        while i < t.size {
            c: char = t[i];
            if c == '<' { depth = depth + 1; }
            also c == '>' {
                if depth == 0 {
                    inner: string = "";
                    k: int = start;
                    while k < i {
                        inner = inner + t[k];
                        k = k + 1;
                    }
                    return inner;
                }
                depth = depth - 1;
            }
            i = i + 1;
        }
        return "";
    }

    pub fnc trim_type_str(s string) : string {
        a: int = 0;
        b: int = s.size - 1;
        while a < s.size && s[a] == ' ' { a = a + 1; }
        while b >= a && s[b] == ' ' { b = b - 1; }
        out: string = "";
        while a <= b {
            out = out + s[a];
            a = a + 1;
        }
        return out;
    }

    pub fnc tuple_elem(tup string, idx int) : string {
        inner: string = "";
        ii: int = 1;
        while ii < tup.size - 1 {
            inner = inner + tup[ii];
            ii = ii + 1;
        }
        depth: int = 0;
        cur: string = "";
        ei: int = 0;
        pi: int = 0;
        while pi < inner.size {
            pch: char = inner[pi];
            if pch == '<' || pch == '(' { depth = depth + 1; }
            if pch == '>' || pch == ')' { depth = depth - 1; }
            if pch == ',' && depth == 0 {
                if ei == idx { return this.trim_type_str(cur); }
                cur = "";
                ei = ei + 1;
            } else {
                cur = cur + pch;
            }
            pi = pi + 1;
        }
        if ei == idx { return this.trim_type_str(cur); }
        return "int";
    }

    pub fnc is_float_leash(t string) : bool {
        if t == "float" || t == "double" || t == "float64" { return true; }
        if t.size > 6 && t[0] == 'f' && t[1] == 'l' && t[2] == 'o' && t[3] == 'a' && t[4] == 't' && t[5] == '<' { return true; }
        return false;
    }

    // Narrow the stack top to a narrow int type (no-op otherwise).
    pub fnc narrow_to(t string) : void {
        if t == "int<8>" {
            this.cur_method.op(JOp.I2B, 0);
            return;
        }
        if t == "uint<8>" {
            this.iconst(255);
            this.cur_method.op(JOp.IAND, -1);
            return;
        }
        if t == "int<16>" {
            this.cur_method.op(JOp.I2S, 0);
            return;
        }
        if t == "uint<16>" {
            this.ldc_int(65535);
            this.cur_method.op(JOp.IAND, -1);
            return;
        }
        if t == "char" {
            this.cur_method.op(JOp.I2C, 0);
            return;
        }
        if t == "bool" {
            return;
        }
        // Odd sub-32 widths narrow in flight (C promotion keeps full int
        // precision between stores; native truncates on store the same).
        w: int = this.int_width(t);
        if w > 0 && w < 32 {
            if this.is_bigint_signed(t) {
                this.iconst(32 - w);
                this.cur_method.op(JOp.ISHL, -1);
                this.iconst(32 - w);
                this.cur_method.op(JOp.ISHR, -1);
            } else {
                mask: int = 1;
                mi: int = 1;
                while mi < w {
                    mask = mask * 2 + 1;
                    mi = mi + 1;
                }
                this.ldc_int(mask);
                this.cur_method.op(JOp.IAND, -1);
            }
            return;
        }
        // Wide integers wrap to width (native LLVM truncation parity).
        if w > 64 {
            sgn: int = 1;
            if !this.is_bigint_signed(t) { sgn = 0; }
            this.emit_bigint_wrap(w, sgn);
            return;
        }
    }

    // Wrap the BigInteger on the stack top to a leash int type.
    pub fnc bigint_wrap_to(t string) : void {
        w: int = this.int_width(t);
        if w <= 64 { return; }
        sgn: int = 1;
        if !this.is_bigint_signed(t) { sgn = 0; }
        this.emit_bigint_wrap(w, sgn);
    }

    // Wrap the BigInteger on the stack top to width bits (signedness by
    // flag): mask the low bits, then re-sign for signed types.
    pub fnc emit_bigint_wrap(w int, sgn int) : void {
        this.iconst(w);
        this.iconst(sgn);
        this.emit_invoke(JOp.INVOKESTATIC, this.main_class, "__bigint_wrap", "(Ljava/math/BigInteger;II)Ljava/math/BigInteger;");
    }

    pub fnc iconst(v int) : void {
        if v == -1 {
            this.cur_method.op(JOp.ICONST_M1, 1);
        } also v >= 0 && v <= 5 {
            this.cur_method.op(JOp.ICONST_0 + v, 1);
        } also v >= -128 && v <= 127 {
            this.cur_method.op_1(JOp.BIPUSH, v & 255, 1);
        } also v >= -32768 && v <= 32767 {
            u: int = v;
            if u < 0 { u = u + 65536; }
            this.cur_method.emit_u8(JOp.SIPUSH);
            this.cur_method.emit_u8((u >> 8) & 255);
            this.cur_method.emit_u8(u & 255);
            this.cur_method.adjust(1);
        } else {
            this.ldc_int(v);
        }
    }

    pub fnc ldc_int(v int) : void {
        idx: int = this.cur_cp.int_const(v);
        if idx < 256 {
            this.cur_method.op_1(JOp.LDC, idx, 1);
        } else {
            this.cur_method.emit_u8(JOp.LDC_W);
            this.cur_method.emit_u8((idx >> 8) & 255);
            this.cur_method.emit_u8(idx & 255);
            this.cur_method.adjust(1);
        }
    }

    pub fnc ldc_string(s string) : void {
        idx: int = this.cur_cp.string_const(s);
        if idx < 256 {
            this.cur_method.op_1(JOp.LDC, idx, 1);
        } else {
            this.cur_method.emit_u8(JOp.LDC_W);
            this.cur_method.emit_u8((idx >> 8) & 255);
            this.cur_method.emit_u8(idx & 255);
            this.cur_method.adjust(1);
        }
    }

    // --- Output -------------------------------------------------------
    // show(a, b, ...) concatenates with no separator and ends the line.
    pub fnc gen_show_arg(arg Expr) : void {
        this.gen_show_arg_buf(arg, false);
    }

    // Print one already-unboxed scalar of leash type t (stack top).
    pub fnc gen_print_unboxed(t string) : void {
        d: string = this.jdesc(t);
        if d == "I" {
            if t == "char" {
                this.cur_method.op(JOp.I2C, 0);
                this.emit_invoke_print("C");
            } also this.is_uint_leash(t) {
                this.emit_invoke(JOp.INVOKESTATIC, "java/lang/Integer", "toUnsignedString", "(I)Ljava/lang/String;");
                this.emit_invoke_print("Ljava/lang/String;");
            } else {
                this.emit_invoke_print("I");
            }
            return;
        }
        if d == "J" {
            if this.is_uint_leash(t) {
                this.emit_invoke(JOp.INVOKESTATIC, "java/lang/Long", "toUnsignedString", "(J)Ljava/lang/String;");
                this.emit_invoke_print("Ljava/lang/String;");
            } else {
                this.emit_invoke_print("J");
            }
            return;
        }
        if d == "D" {
            this.emit_locale_root();
            this.ldc_string("%.6f");
            this.iconst(1);
            this.emit_anewarray_object(1);
            this.cur_method.op(JOp.DUP, 1);
            this.iconst(0);
            this.box_top("D");
            this.cur_method.op(JOp.AASTORE, -3);
            this.emit_invoke(JOp.INVOKESTATIC, "java/lang/String", "format", "(Ljava/util/Locale;Ljava/lang/String;[Ljava/lang/Object;)Ljava/lang/String;");
            this.emit_invoke_print("Ljava/lang/String;");
            return;
        }
        if d == "Z" {
            this.emit_invoke_print("Z");
            return;
        }
        if d == "Ljava/lang/String;" {
            this.emit_invoke_print("Ljava/lang/String;");
            return;
        }
        if d == "Ljava/math/BigInteger;" {
            this.emit_invoke(JOp.INVOKEVIRTUAL, "java/math/BigInteger", "toString", "()Ljava/lang/String;");
            this.emit_invoke_print("Ljava/lang/String;");
            return;
        }
        this.emit_invoke_print("Ljava/lang/Object;");
    }

    // Buffered showb of one argument: build its string and append it
    // (drained at exit; native parity).
    pub fnc gen_showb_arg(arg Expr) : void {
        t: string = this.expr_type(arg);
        d: string = this.jdesc(t);
        if d.size == 0 {
            this.jvm_unsupported("showb() of '" + t + "'");
            return;
        }
        if t.size > 0 && t[0] == '(' {
            this.jvm_unsupported("showb() of tuple '" + t + "'");
            return;
        }
        if this.tc.structs.isin(t) || this.tc.classes.isin(t) {
            this.jvm_unsupported("showb() of struct/class '" + t + "'");
            return;
        }
        if t == "nil" {
            this.ldc_string("nil");
            this.emit_invoke(JOp.INVOKESTATIC, this.main_class, "__showb_append", "(Ljava/lang/String;)V");
            return;
        }
        if t == "char" {
            this.gen_expr(arg);
            this.cur_method.op(JOp.I2C, 0);
            this.emit_invoke(JOp.INVOKESTATIC, "java/lang/String", "valueOf", "(C)Ljava/lang/String;");
            this.emit_invoke(JOp.INVOKESTATIC, this.main_class, "__showb_append", "(Ljava/lang/String;)V");
            return;
        }
        if d == "Ljava/util/ArrayList;" && this.is_vec_leash(t) {
            this.gen_showb_vec(arg, this.vec_inner_type(t));
            return;
        }
        if d == "Ljava/util/ArrayList;" || d == "Ljava/util/HashMap;" {
            this.gen_expr(arg);
            this.emit_invoke(JOp.INVOKESTATIC, "java/lang/String", "valueOf", "(Ljava/lang/Object;)Ljava/lang/String;");
            this.emit_invoke(JOp.INVOKESTATIC, this.main_class, "__showb_append", "(Ljava/lang/String;)V");
            return;
        }
        this.gen_expr(arg);
        this.jvm_tostring(t);
        this.emit_invoke(JOp.INVOKESTATIC, this.main_class, "__showb_append", "(Ljava/lang/String;)V");
    }

    // Buffered showb of a vec: elements unpacked with no separators.
    pub fnc gen_showb_vec(arg Expr, inner string) : void {
        this.gen_expr(arg);
        list_slot: int = this.cur_method.alloc_local(1);
        this.cur_method.store_local("X", list_slot);
        this.cur_method.load_local("X", list_slot);
        this.emit_invoke(JOp.INVOKEVIRTUAL, "java/util/ArrayList", "size", "()I");
        n_slot: int = this.cur_method.alloc_local(1);
        this.cur_method.store_local("I", n_slot);
        this.iconst(0);
        i_slot: int = this.cur_method.alloc_local(1);
        this.cur_method.store_local("I", i_slot);
        loop_lbl: string = this.new_label("sbv_loop");
        end_lbl: string = this.new_label("sbv_end");
        this.cur_method.mark(loop_lbl);
        this.cur_method.load_local("I", i_slot);
        this.cur_method.load_local("I", n_slot);
        this.cur_method.branch(JOp.IF_ICMPGE, end_lbl, 2);
        this.cur_method.load_local("X", list_slot);
        this.cur_method.load_local("I", i_slot);
        this.emit_invoke(JOp.INVOKEVIRTUAL, "java/util/ArrayList", "get", "(I)Ljava/lang/Object;");
        if inner == "char" {
            this.emit_checkcast("java/lang/Character");
            this.emit_invoke(JOp.INVOKEVIRTUAL, "java/lang/Character", "charValue", "()C");
            this.emit_invoke(JOp.INVOKESTATIC, "java/lang/String", "valueOf", "(C)Ljava/lang/String;");
        } else {
            this.unbox_to(inner);
            id_in: string = this.jdesc(inner);
            if id_in == "I" || id_in == "J" {
                this.narrow_to(inner);
            }
            this.jvm_tostring(inner);
        }
        this.emit_invoke(JOp.INVOKESTATIC, this.main_class, "__showb_append", "(Ljava/lang/String;)V");
        this.cur_method.load_local("I", i_slot);
        this.iconst(1);
        this.cur_method.op(JOp.IADD, -1);
        this.cur_method.store_local("I", i_slot);
        this.cur_method.branch(JOp.GOTO, loop_lbl, 0);
        this.cur_method.mark(end_lbl);
    }

    pub fnc gen_show_arg_buf(arg Expr, buffered bool) : void {
        t: string = this.expr_type(arg);
        d: string = this.jdesc(t);
        if d.size == 0 {
            this.jvm_unsupported("show() of '" + t + "'");
            return;
        }
        // Native show(struct) fails in clang; surface a clean error.
        // Native show(tuple) is unsupported; surface a clean error.
        if t.size > 0 && t[0] == '(' {
            this.jvm_unsupported("show() of tuple '" + t + "'");
            return;
        }
        if this.tc.structs.isin(t) || this.tc.classes.isin(t) {
            this.jvm_unsupported("show() of struct/class '" + t + "'");
            return;
        }
        if buffered {
            this.gen_showb_arg(arg);
            return;
        }
        this.emit_getstatic_out();
        if t == "string" {
            this.gen_expr(arg);
            this.emit_invoke_print("Ljava/lang/String;");
        } also t == "char[]" {
            this.gen_expr(arg);
            this.emit_string_from_chars();
            this.emit_invoke_print("Ljava/lang/String;");
        } also t == "nil" {
            // Native codegen crashes on show(nil); the JVM defines "nil".
            this.ldc_string("nil");
            this.emit_invoke_print("Ljava/lang/String;");
        } also d == "I" {
            this.gen_expr(arg);
            if t == "char" {
                this.cur_method.op(JOp.I2C, 0);
                this.emit_invoke_print("C");
            } also this.is_uint_leash(t) {
                // Unsigned 32-bit: native prints the full range.
                this.emit_invoke(JOp.INVOKESTATIC, "java/lang/Integer", "toUnsignedString", "(I)Ljava/lang/String;");
                this.emit_invoke_print("Ljava/lang/String;");
            } else {
                this.emit_invoke_print("I");
            }
        } also d == "J" {
            this.gen_expr(arg);
            if this.is_uint_leash(t) {
                this.emit_invoke(JOp.INVOKESTATIC, "java/lang/Long", "toUnsignedString", "(J)Ljava/lang/String;");
                this.emit_invoke_print("Ljava/lang/String;");
            } else {
                this.emit_invoke_print("J");
            }
        } also d == "D" {
            // %.6f like the native %f formatting (Double.toString differs):
            // String.format(ROOT, "%.6f", new Object[]{ box(d) }).
            this.emit_locale_root();
            this.ldc_string("%.6f");
            this.iconst(1);
            this.emit_anewarray_object(1);
            this.cur_method.op(JOp.DUP, 1);
            this.iconst(0);
            this.gen_expr(arg);
            this.box_top("D");
            this.cur_method.op(JOp.AASTORE, -3);
            this.emit_invoke(JOp.INVOKESTATIC, "java/lang/String", "format", "(Ljava/util/Locale;Ljava/lang/String;[Ljava/lang/Object;)Ljava/lang/String;");
            this.emit_invoke_print("Ljava/lang/String;");
        } also d == "Z" {
            this.gen_expr(arg);
            this.emit_invoke_print("Z");
        } also d == "Ljava/util/ArrayList;" {
            if this.is_vec_leash(t) && this.is_float_leash(this.vec_inner_type(t)) {
                this.gen_show_float_vec(arg);
            } else {
                // Integer/Long/Boolean/Character/String elements render
                // like the native backend via ArrayList.toString.
                this.gen_expr(arg);
                this.emit_invoke_print("Ljava/lang/Object;");
            }
        } also d == "Ljava/util/HashMap;" {
            // Native show(hash) fails in clang; the JVM prints {k=v}.
            this.gen_expr(arg);
            this.emit_invoke_print("Ljava/lang/Object;");
        } also this.tc.unions.isin(t) {
            this.gen_expr(arg);
            this.gen_union_tostring(t);
            this.emit_invoke_print("Ljava/lang/String;");
        } also d == "Ljava/math/BigInteger;" {
            this.gen_expr(arg);
            this.emit_invoke(JOp.INVOKEVIRTUAL, "java/math/BigInteger", "toString", "()Ljava/lang/String;");
            this.emit_invoke_print("Ljava/lang/String;");
        } else {
            this.gen_expr(arg);
            this.emit_invoke_print("Ljava/lang/Object;");
        }
    }

    pub fnc base_name(p string) : string {
        i: int = 0;
        last: int = -1;
        while i < p.size {
            if p[i] == '/' { last = i; }
            i = i + 1;
        }
        out: string = "";
        i = last + 1;
        while i < p.size {
            out = out + p[i];
            i = i + 1;
        }
        return out;
    }

    // Push Locale.ROOT (locale-independent number formatting).
    pub fnc emit_locale_root() : void {
        idx: int = this.cur_cp.fieldref("java/util/Locale", "ROOT", "Ljava/util/Locale;");
        this.cur_method.op_field(JOp.GETSTATIC, idx, 1);
    }

    pub fnc emit_getstatic_out() : void {
        idx: int = this.cur_cp.fieldref("java/lang/System", "out", "Ljava/io/PrintStream;");
        this.cur_method.op_field(JOp.GETSTATIC, idx, 1);
    }

    pub fnc emit_invoke_print(arg_desc string) : void {
        this.emit_invoke(JOp.INVOKEVIRTUAL, "java/io/PrintStream", "print", "(" + arg_desc + ")V");
    }

    pub fnc emit_println() : void {
        this.emit_getstatic_out();
        this.emit_invoke(JOp.INVOKEVIRTUAL, "java/io/PrintStream", "println", "()V");
    }

    // show(vec<float>) as [2.500000, 0.100000] (ArrayList.toString would
    // give [2.5, 0.1]). Elements are already boxed Doubles.
    pub fnc gen_show_float_vec(arg Expr) : void {
        this.gen_expr(arg);
        list_slot: int = this.cur_method.alloc_local(1);
        this.cur_method.store_local("Ljava/util/ArrayList;", list_slot);
        // StringBuilder sb = new StringBuilder("[");
        this.cur_method.op(JOp.NEW, 1);
        sbi: int = this.cur_cp.class_entry("java/lang/StringBuilder");
        this.cur_method.emit_u8((sbi >> 8) & 255);
        this.cur_method.emit_u8(sbi & 255);
        this.cur_method.op(JOp.DUP, 1);
        this.ldc_string("[");
        this.emit_invoke(JOp.INVOKESPECIAL, "java/lang/StringBuilder", "<init>", "(Ljava/lang/String;)V");
        sb_slot: int = this.cur_method.alloc_local(1);
        this.cur_method.store_local("Ljava/lang/StringBuilder;", sb_slot);
        idx_slot: int = this.cur_method.alloc_local(1);
        this.cur_method.op(JOp.ICONST_0, 1);
        this.cur_method.store_local("I", idx_slot);
        head_lbl: string = this.new_label("sbv_h");
        body_lbl: string = this.new_label("sbv_b");
        end_lbl: string = this.new_label("sbv_e");
        this.loop_heads.pushb(head_lbl);
        this.loop_exits.pushb(end_lbl);
        this.cur_method.mark(head_lbl);
        this.cur_method.load_local("I", idx_slot);
        this.cur_method.load_local("Ljava/util/ArrayList;", list_slot);
        this.emit_invoke(JOp.INVOKEVIRTUAL, "java/util/ArrayList", "size", "()I");
        this.cur_method.branch(JOp.IF_ICMPGE, end_lbl, 2);
        this.cur_method.mark(body_lbl);
        // if idx > 0: sb.append(", ")
        sep_lbl: string = this.new_label("sbv_sep");
        this.cur_method.load_local("I", idx_slot);
        this.cur_method.branch(JOp.IFEQ, sep_lbl, 1);
        this.cur_method.load_local("Ljava/lang/StringBuilder;", sb_slot);
        this.ldc_string(", ");
        this.emit_invoke(JOp.INVOKEVIRTUAL, "java/lang/StringBuilder", "append", "(Ljava/lang/String;)Ljava/lang/StringBuilder;");
        this.cur_method.op(JOp.POP, -1);
        this.cur_method.mark(sep_lbl);
        // sb.append(String.format(ROOT, "%.6f", new Object[]{ list.get(idx) }));
        this.cur_method.load_local("Ljava/lang/StringBuilder;", sb_slot);
        this.emit_locale_root();
        this.ldc_string("%.6f");
        this.iconst(1);
        this.emit_anewarray_object(1);
        this.cur_method.op(JOp.DUP, 1);
        this.iconst(0);
        this.cur_method.load_local("Ljava/util/ArrayList;", list_slot);
        this.cur_method.load_local("I", idx_slot);
        this.emit_invoke(JOp.INVOKEVIRTUAL, "java/util/ArrayList", "get", "(I)Ljava/lang/Object;");
        this.cur_method.op(JOp.AASTORE, -3);
        this.emit_invoke(JOp.INVOKESTATIC, "java/lang/String", "format", "(Ljava/util/Locale;Ljava/lang/String;[Ljava/lang/Object;)Ljava/lang/String;");
        this.emit_invoke(JOp.INVOKEVIRTUAL, "java/lang/StringBuilder", "append", "(Ljava/lang/String;)Ljava/lang/StringBuilder;");
        this.cur_method.op(JOp.POP, -1);
        // idx += 1
        this.cur_method.load_local("I", idx_slot);
        this.iconst(1);
        this.cur_method.op(JOp.IADD, -1);
        this.cur_method.store_local("I", idx_slot);
        this.cur_method.branch(JOp.GOTO, head_lbl, 0);
        this.cur_method.mark(end_lbl);
        this.loop_heads.popb();
        this.loop_exits.popb();
        this.cur_method.load_local("Ljava/lang/StringBuilder;", sb_slot);
        this.ldc_string("]");
        this.emit_invoke(JOp.INVOKEVIRTUAL, "java/lang/StringBuilder", "append", "(Ljava/lang/String;)Ljava/lang/StringBuilder;");
        this.emit_invoke(JOp.INVOKEVIRTUAL, "java/lang/StringBuilder", "toString", "()Ljava/lang/String;");
        this.emit_invoke_print("Ljava/lang/String;");
    }

    // Box the stack top into its wrapper (for Object contexts).
    pub fnc box_top(d string) : void {
        if d == "I" {
            this.emit_invoke(JOp.INVOKESTATIC, "java/lang/Integer", "valueOf", "(I)Ljava/lang/Integer;");
        } also d == "J" {
            this.emit_invoke(JOp.INVOKESTATIC, "java/lang/Long", "valueOf", "(J)Ljava/lang/Long;");
        } also d == "D" {
            this.emit_invoke(JOp.INVOKESTATIC, "java/lang/Double", "valueOf", "(D)Ljava/lang/Double;");
        } also d == "Z" {
            this.emit_invoke(JOp.INVOKESTATIC, "java/lang/Boolean", "valueOf", "(Z)Ljava/lang/Boolean;");
        } also d == "C" {
            this.emit_invoke(JOp.INVOKESTATIC, "java/lang/Character", "valueOf", "(C)Ljava/lang/Character;");
        }
    }

    pub fnc emit_anewarray_object(n int) : void {
        ci: int = this.cur_cp.class_entry("java/lang/Object");
        this.cur_method.emit_u8(JOp.ANEWARRAY);
        this.cur_method.emit_u8((ci >> 8) & 255);
        this.cur_method.emit_u8(ci & 255);
        this.cur_method.adjust(0);
    }

    // --- Coercions ----------------------------------------------------
    // Convert the stack top from one leash type to another (table
    // mirrors the scalar coercions: trunc/sext/zext, sitofp/uitofp,
    // fptosi/fptoui, float widening; then narrow when the target is
    // a narrow int). Unknown pairs are left alone.
    // ===================== 128-bit integers (BigInteger) =====================
    // int<128>/uint<128> ride as java.math.BigInteger. Values widen into it
    // (unsigned sources via their decimal magnitude, so uint64 max stays
    // positive); narrowing uses intValue/longValue/doubleValue.

    pub fnc is_bigint(t string) : bool {
        // Every integer width without a natural JVM lane (all except
        // <= 32 and exactly 64) rides BigInteger — consistent with jdesc.
        w: int = this.int_width(t);
        return w > 32 && w != 64;
    }

    // Bit width of an integer type (aliases resolved); 32 for plain
    // int/uint/char, 1 for bool, 0 for non-integers.
    pub fnc int_width(t string) : int {
        rt: string = this.tc.resolve_type_alias(t);
        if rt == "int" || rt == "uint" || rt == "char" { return 32; }
        if rt == "bool" { return 1; }
        if rt == "int64" || rt == "uint64" { return 64; }
        if rt.size >= 6 && rt[rt.size - 1] == '>' {
            is_int: bool = rt.size >= 6 && rt[0] == 'i' && rt[1] == 'n' && rt[2] == 't' && rt[3] == '<';
            is_uint: bool = rt.size >= 7 && rt[0] == 'u' && rt[1] == 'i' && rt[2] == 'n' && rt[3] == 't' && rt[4] == '<';
            if is_int || is_uint {
                start: int = 4;
                if is_uint { start = 5; }
                if start >= rt.size - 1 { return 0; }
                w: int = 0;
                ki: int = start;
                while ki < rt.size - 1 {
                    c: char = rt[ki];
                    if c < '0' || c > '9' { return 0; }
                    w = w * 10 + (c - '0');
                    ki = ki + 1;
                }
                return w;
            }
        }
        return 0;
    }

    pub fnc is_plain_decimal(sv string) : bool {
        si: int = 0;
        if sv.size > 0 && sv[0] == '-' { si = 1; }
        if si >= sv.size { return false; }
        while si < sv.size {
            if sv[si] < '0' || sv[si] > '9' { return false; }
            si = si + 1;
        }
        return true;
    }

    // Does decimal literal text fit in a signed 64-bit int?
    pub fnc lit_fits_i64(sv string) : bool {
        si: int = 0;
        neg: bool = false;
        if sv.size > 0 && sv[0] == '-' {
            neg = true;
            si = 1;
        }
        while si < sv.size && sv[si] == '0' { si = si + 1; }
        digits: int = sv.size - si;
        if digits < 19 { return true; }
        if digits > 19 { return false; }
        lim: string = "9223372036854775807";
        if neg { lim = "9223372036854775808"; }
        di: int = 0;
        while di < 19 {
            if sv[si + di] < lim[di] { return true; }
            if sv[si + di] > lim[di] { return false; }
            di = di + 1;
        }
        return true;
    }

    // Wider of two integer types (by width; ties prefer the left).
    pub fnc bigint_wider(a string, b string) : string {
        if this.int_width(b) > this.int_width(a) { return b; }
        return a;
    }

    pub fnc is_bigint_signed(t string) : bool {
        rt: string = this.tc.resolve_type_alias(t);
        if rt.size == 0 { return true; }
        return rt[0] != 'u';
    }

    // Entry: [val:from_t]. Exit: [BigInteger].
    pub fnc coerce_to_bigint(from_t string) : void {
        fd: string = this.jdesc(from_t);
        if fd == "Ljava/math/BigInteger;" { return; }
        if fd == "I" {
            if this.is_uint_leash(from_t) {
                this.emit_invoke(JOp.INVOKESTATIC, "java/lang/Integer", "toUnsignedString", "(I)Ljava/lang/String;");
                this.bigint_from_string();
            } else {
                this.cur_method.op(JOp.I2L, 1);
                this.emit_invoke(JOp.INVOKESTATIC, "java/math/BigInteger", "valueOf", "(J)Ljava/math/BigInteger;");
            }
            return;
        }
        if fd == "J" {
            if this.is_uint_leash(from_t) {
                this.emit_invoke(JOp.INVOKESTATIC, "java/lang/Long", "toUnsignedString", "(J)Ljava/lang/String;");
                this.bigint_from_string();
            } else {
                this.emit_invoke(JOp.INVOKESTATIC, "java/math/BigInteger", "valueOf", "(J)Ljava/math/BigInteger;");
            }
            return;
        }
        if fd == "D" {
            // Exact conversion (a saturating D2L would lose huge magnitudes).
            tslot: int = this.cur_method.temp_slot("D");
            this.cur_method.store_local("D", tslot);
            this.cur_method.op(JOp.NEW, 1);
            bdi: int = this.cur_cp.class_entry("java/math/BigDecimal");
            this.cur_method.emit_u8((bdi >> 8) & 255);
            this.cur_method.emit_u8(bdi & 255);
            this.cur_method.op(JOp.DUP, 1);
            this.cur_method.load_local("D", tslot);
            this.emit_invoke(JOp.INVOKESPECIAL, "java/math/BigDecimal", "<init>", "(D)V");
            this.emit_invoke(JOp.INVOKEVIRTUAL, "java/math/BigDecimal", "toBigInteger", "()Ljava/math/BigInteger;");
            return;
        }
        if fd == "Z" {
            this.cur_method.op(JOp.I2L, 1);
            this.emit_invoke(JOp.INVOKESTATIC, "java/math/BigInteger", "valueOf", "(J)Ljava/math/BigInteger;");
            return;
        }
        if fd == "Ljava/lang/String;" {
            this.bigint_from_string();
            return;
        }
        this.jvm_unsupported("cannot convert '" + from_t + "' to 128-bit");
    }

    // Range-checked decimal parse (native bigint_parse parity):
    // entry [String], exit validated [BigInteger]; aborts like native
    // ("Runtime error: '<type>' value out of range or invalid") otherwise.
    // (Malformed text still throws NumberFormatException: no landing-pad
    // support in the v49 emitter.)
    pub fnc bigint_parse_checked(tgt string) : void {
        rt: string = this.tc.resolve_type_alias(tgt);
        w: int = this.int_width(rt);
        sgn: int = 1;
        if !this.is_bigint_signed(rt) { sgn = 0; }
        this.bigint_from_string();
        vs: int = this.cur_method.alloc_local(1);
        this.cur_method.store_local("X", vs);
        ok_lbl: string = this.new_label("bpc_ok");
        fail_lbl: string = this.new_label("bpc_fail");
        // hi = exclusive upper bound: 2^W (unsigned) or 2^(W-1) (signed)
        one0: int = this.cur_cp.fieldref("java/math/BigInteger", "ONE", "Ljava/math/BigInteger;");
        this.cur_method.op_field(JOp.GETSTATIC, one0, 1);
        if sgn == 1 {
            this.iconst(w - 1);
        } else {
            this.iconst(w);
        }
        this.emit_invoke(JOp.INVOKEVIRTUAL, "java/math/BigInteger", "shiftLeft", "(I)Ljava/math/BigInteger;");
        hi_slot: int = this.cur_method.alloc_local(1);
        this.cur_method.store_local("X", hi_slot);
        // v >= hi -> fail
        this.cur_method.load_local("X", vs);
        this.cur_method.load_local("X", hi_slot);
        this.emit_invoke(JOp.INVOKEVIRTUAL, "java/math/BigInteger", "compareTo", "(Ljava/math/BigInteger;)I");
        pass_hi: string = this.new_label("bpc_ph");
        this.cur_method.branch(JOp.IFLT, pass_hi, 1);
        this.cur_method.branch(JOp.GOTO, fail_lbl, 0);
        this.cur_method.mark(pass_hi);
        if sgn == 1 {
            // lo = -hi; v < lo -> fail
            this.cur_method.load_local("X", hi_slot);
            this.emit_invoke(JOp.INVOKEVIRTUAL, "java/math/BigInteger", "negate", "()Ljava/math/BigInteger;");
            lo_slot: int = this.cur_method.alloc_local(1);
            this.cur_method.store_local("X", lo_slot);
            this.cur_method.load_local("X", vs);
            this.cur_method.load_local("X", lo_slot);
            this.emit_invoke(JOp.INVOKEVIRTUAL, "java/math/BigInteger", "compareTo", "(Ljava/math/BigInteger;)I");
            pass_lo: string = this.new_label("bpc_pl");
            this.cur_method.branch(JOp.IFGE, pass_lo, 1);
            this.cur_method.branch(JOp.GOTO, fail_lbl, 0);
            this.cur_method.mark(pass_lo);
        } else {
            // v < 0 -> fail
            this.cur_method.load_local("X", vs);
            this.emit_invoke(JOp.INVOKEVIRTUAL, "java/math/BigInteger", "signum", "()I");
            pass_lo: string = this.new_label("bpc_pl");
            this.cur_method.branch(JOp.IFGE, pass_lo, 1);
            this.cur_method.branch(JOp.GOTO, fail_lbl, 0);
            this.cur_method.mark(pass_lo);
        }
        this.cur_method.branch(JOp.GOTO, ok_lbl, 0);
        this.cur_method.mark(fail_lbl);
        this.emit_abort("Runtime error: '" + rt + "' value out of range or invalid\n");
        this.cur_method.branch(JOp.GOTO, ok_lbl, 0);
        this.cur_method.mark(ok_lbl);
        this.cur_method.load_local("X", vs);
    }

    // Entry: [val:from_t]. Exit: [val:to_t] (one side is 128-bit).
    pub fnc jvm_coerce_bigint(from_t string, to_t string) : void {
        if this.is_bigint(to_t) {
            if from_t == "string" {
                this.bigint_parse_checked(to_t);
                return;
            }
            this.coerce_to_bigint(from_t);
            this.bigint_wrap_to(to_t);
            return;
        }
        // Narrowing out of 128-bit.
        td: string = this.jdesc(to_t);
        if td == "I" {
            this.emit_invoke(JOp.INVOKEVIRTUAL, "java/math/BigInteger", "intValue", "()I");
            this.narrow_to(to_t);
            return;
        }
        if td == "J" {
            this.emit_invoke(JOp.INVOKEVIRTUAL, "java/math/BigInteger", "longValue", "()J");
            return;
        }
        if td == "D" {
            this.emit_invoke(JOp.INVOKEVIRTUAL, "java/math/BigInteger", "doubleValue", "()D");
            return;
        }
        if td == "Ljava/lang/String;" {
            this.emit_invoke(JOp.INVOKEVIRTUAL, "java/math/BigInteger", "toString", "()Ljava/lang/String;");
            return;
        }
        if td == "Z" {
            this.emit_invoke(JOp.INVOKEVIRTUAL, "java/math/BigInteger", "intValue", "()I");
            return;
        }
        this.jvm_unsupported("cannot convert 128-bit to '" + to_t + "'");
    }

    // Entry: [String]. Exit: [BigInteger].
    pub fnc bigint_from_string() : void {
        ss: int = this.cur_method.alloc_local(1);
        this.cur_method.store_local("X", ss);
        this.cur_method.op(JOp.NEW, 1);
        bi: int = this.cur_cp.class_entry("java/math/BigInteger");
        this.cur_method.emit_u8((bi >> 8) & 255);
        this.cur_method.emit_u8(bi & 255);
        this.cur_method.op(JOp.DUP, 1);
        this.cur_method.load_local("X", ss);
        this.emit_invoke(JOp.INVOKESPECIAL, "java/math/BigInteger", "<init>", "(Ljava/lang/String;)V");
    }

    // Abort on a zero BigInteger divisor (reference parity: message to
    // stdout, exit 1). Entry: [divisor]. Exit: [divisor].
    pub fnc check_nonzero_bigint() : void {
        ok_lbl: string = this.new_label("bnz_ok");
        tslot: int = this.cur_method.alloc_local(1);
        this.cur_method.store_local("X", tslot);
        this.cur_method.load_local("X", tslot);
        zidx: int = this.cur_cp.fieldref("java/math/BigInteger", "ZERO", "Ljava/math/BigInteger;");
        this.cur_method.op_field(JOp.GETSTATIC, zidx, 1);
        this.emit_invoke(JOp.INVOKEVIRTUAL, "java/math/BigInteger", "compareTo", "(Ljava/math/BigInteger;)I");
        this.cur_method.branch(JOp.IFNE, ok_lbl, 1);
        this.emit_abort("Runtime error: Division by zero.\n");
        this.cur_method.branch(JOp.GOTO, ok_lbl, 0);
        this.cur_method.mark(ok_lbl);
        this.cur_method.load_local("X", tslot);
    }

    // BigInteger binary op. Entry: [a, b] (both BigInteger, except shifts
    // take an int rhs). Exit: [result].
    pub fnc bigint_binop(op string) : void {
        if op == "<<" || op == ">>" {
            // rhs BigInteger -> int shift distance.
            this.emit_invoke(JOp.INVOKEVIRTUAL, "java/math/BigInteger", "intValue", "()I");
            if op == "<<" {
                this.emit_invoke(JOp.INVOKEVIRTUAL, "java/math/BigInteger", "shiftLeft", "(I)Ljava/math/BigInteger;");
            } else {
                this.emit_invoke(JOp.INVOKEVIRTUAL, "java/math/BigInteger", "shiftRight", "(I)Ljava/math/BigInteger;");
            }
            return;
        }
        if op == "/" || op == "%" {
            // Divisor check needs a temp (spill, check, reload).
            ds: int = this.cur_method.alloc_local(1);
            this.cur_method.store_local("X", ds);
            this.cur_method.load_local("X", ds);
            this.check_nonzero_bigint();
            this.cur_method.store_local("X", ds);
            this.cur_method.load_local("X", ds);
        }
        if op == "+" {
            this.emit_invoke(JOp.INVOKEVIRTUAL, "java/math/BigInteger", "add", "(Ljava/math/BigInteger;)Ljava/math/BigInteger;");
        } also op == "-" {
            this.emit_invoke(JOp.INVOKEVIRTUAL, "java/math/BigInteger", "subtract", "(Ljava/math/BigInteger;)Ljava/math/BigInteger;");
        } also op == "*" {
            this.emit_invoke(JOp.INVOKEVIRTUAL, "java/math/BigInteger", "multiply", "(Ljava/math/BigInteger;)Ljava/math/BigInteger;");
        } also op == "/" {
            this.emit_invoke(JOp.INVOKEVIRTUAL, "java/math/BigInteger", "divide", "(Ljava/math/BigInteger;)Ljava/math/BigInteger;");
        } also op == "%" {
            this.emit_invoke(JOp.INVOKEVIRTUAL, "java/math/BigInteger", "remainder", "(Ljava/math/BigInteger;)Ljava/math/BigInteger;");
        } also op == "&" {
            this.emit_invoke(JOp.INVOKEVIRTUAL, "java/math/BigInteger", "and", "(Ljava/math/BigInteger;)Ljava/math/BigInteger;");
        } also op == "|" {
            this.emit_invoke(JOp.INVOKEVIRTUAL, "java/math/BigInteger", "or", "(Ljava/math/BigInteger;)Ljava/math/BigInteger;");
        } also op == "^" {
            this.emit_invoke(JOp.INVOKEVIRTUAL, "java/math/BigInteger", "xor", "(Ljava/math/BigInteger;)Ljava/math/BigInteger;");
        } else {
            this.jvm_unsupported("binary '" + op + "' on 128-bit");
        }
    }

    pub fnc jvm_coerce(from_t string, to_t string) : void {
        if from_t == to_t { return; }
        if this.is_bigint(from_t) || this.is_bigint(to_t) {
            this.jvm_coerce_bigint(from_t, to_t);
            return;
        }
        if from_t == "nil" {
            td0: string = this.jdesc(to_t);
            if td0 == "I" || td0 == "Z" || td0 == "B" || td0 == "S" || td0 == "C" || td0 == "J" || td0 == "D" {
                // `return nil` in a numeric function yields zero (LLVM
                // `ret <ty> null` parity).
                this.cur_method.op(JOp.POP, -1);
                this.jvm_default(td0);
            }
            return;
        }
        fd: string = this.jdesc(from_t);
        td: string = this.jdesc(to_t);
        if fd.size == 0 || td.size == 0 { return; }
        if fd == td { return; }
        if fd == "I" && td == "I" {
            return;
        }
        if fd == "I" && td == "J" {
            if this.is_uint_leash(from_t) {
                this.cur_method.op(JOp.I2L, 1);
                this.long_const(0, 0 - 1);
                this.cur_method.op(JOp.LAND, -2);
            } else {
                this.cur_method.op(JOp.I2L, 1);
            }
            return;
        }
        if fd == "J" && td == "I" {
            this.cur_method.op(JOp.L2I, -1);
            this.narrow_to(to_t);
            return;
        }
        if fd == "I" && td == "D" {
            if this.is_uint_leash(from_t) {
                this.cur_method.op(JOp.I2L, 1);
                this.long_const(0, 0 - 1);
                this.cur_method.op(JOp.LAND, -2);
                this.cur_method.op(JOp.L2D, 0);
            } else {
                this.cur_method.op(JOp.I2D, 1);
            }
            return;
        }
        if fd == "J" && td == "D" {
            this.cur_method.op(JOp.L2D, 0);
            return;
        }
        if fd == "D" && td == "I" {
            if this.is_uint_leash(to_t) {
                // double (2 slots) -> long (2 slots)
                this.cur_method.op(JOp.D2L, 0);
            } else {
                this.cur_method.op(JOp.D2I, -1);
            }
            this.narrow_to(to_t);
            return;
        }
        if fd == "D" && td == "J" {
            this.cur_method.op(JOp.D2L, 0);
            return;
        }
        if fd == "D" && td == "D" { return; }
    }

    pub fnc long_const(hi int, lo int) : void {
        idx: int = this.cur_cp.long_const(hi, lo);
        this.cur_method.emit_u8(JOp.LDC2_W);
        this.cur_method.emit_u8((idx >> 8) & 255);
        this.cur_method.emit_u8(idx & 255);
        this.cur_method.adjust(2);
    }

    // --- Expressions --------------------------------------------------
    // Every branch leaves exactly one value (slots per descriptor).
    pub fnc gen_expr(e Expr) : void {
        if e == null {
            this.jvm_unsupported("null expression");
            return;
        }
        if e.kind == ExprKind.INT {
            // Out-of-int64 decimal text becomes a BigInteger directly
            // (full precision for 128/256/512-bit targets).
            if e.sval.size > 0 && this.is_plain_decimal(e.sval) && !this.lit_fits_i64(e.sval) {
                this.ldc_string(e.sval);
                this.bigint_from_string();
                return;
            }
            // Literals beyond int32 carry their full value as a long
            // (native parity: the reference keeps the literal text and
            // truncates only at narrow stores). expr_type reports them
            // as int<64> so downstream coercions see the right width.
            if e.ival > 2147483647 || e.ival < 0 - 2147483648 {
                hi64: int<64> = e.ival >> 32;
                hi: int = hi64;
                lo64: int<64> = e.ival - (hi64 << 32);
                lo: int = lo64;
                this.long_const(hi, lo);
                return;
            }
            res_t: string = this.expr_type(e);
            rd: string = this.jdesc(res_t);
            if rd == "J" {
                hi64: int<64> = e.ival >> 32;
                hi: int = hi64;
                lo64: int<64> = e.ival - (hi64 << 32);
                lo: int = lo64;
                this.long_const(hi, lo);
            } else {
                this.iconst(e.ival);
                this.narrow_to(res_t);
            }
            return;
        }
        if e.kind == ExprKind.FLOAT {
            // Exact decimal parsing happens on the JVM itself. Folded
            // constants carry no text (like the LLVM backend, which
            // embeds tostring(fval) there); C-printf spellings of
            // non-finite values differ from parseDouble's.
            lit: string = e.sval;
            if lit.size == 0 { lit = tostring(e.fval); }
            if lit == "inf" || lit == "Inf" || lit == "INF" { lit = "Infinity"; }
            also lit == "-inf" || lit == "-Inf" || lit == "-INF" { lit = "-Infinity"; }
            also lit == "nan" || lit == "NaN" || lit == "NAN" { lit = "NaN"; }
            this.ldc_string(lit);
            this.emit_invoke(JOp.INVOKESTATIC, "java/lang/Double", "parseDouble", "(Ljava/lang/String;)D");
            return;
        }
        if e.kind == ExprKind.STRING {
            this.ldc_string(e.sval);
            return;
        }
        if e.kind == ExprKind.CHAR {
            this.iconst(e.cval + 0);
            return;
        }
        if e.kind == ExprKind.BOOL {
            if e.bval {
                this.cur_method.op(JOp.ICONST_1, 1);
            } else {
                this.cur_method.op(JOp.ICONST_0, 1);
            }
            return;
        }
        if e.kind == ExprKind.NIL {
            this.cur_method.op(JOp.ACONST_NULL, 1);
            return;
        }
        if e.kind == ExprKind.IDENT {
            this.gen_ident(e.sval);
            return;
        }
        if e.kind == ExprKind.BINOP {
            this.gen_binop(e);
            return;
        }
        if e.kind == ExprKind.UNARY {
            this.gen_unary(e);
            return;
        }
        if e.kind == ExprKind.CALL {
            this.gen_call(e);
            return;
        }
        if e.kind == ExprKind.TERNARY {
            this.gen_ternary(e);
            return;
        }
        if e.kind == ExprKind.METHOD_CALL {
            this.gen_method_call(e);
            return;
        }
        if e.kind == ExprKind.MEMBER {
            this.gen_member(e);
            return;
        }
        if e.kind == ExprKind.INDEX {
            this.gen_index(e);
            return;
        }
        if e.kind == ExprKind.CAST {
            this.gen_cast(e);
            return;
        }
        if e.kind == ExprKind.STRUCT_INIT {
            this.gen_struct_init(e);
            return;
        }
        if e.kind == ExprKind.ARRAY_LIT {
            this.gen_array_lit(e);
            return;
        }
        if e.kind == ExprKind.POINTER_MEMBER {
            plt: string = this.deref_t(this.expr_type(e.left));
            if this.tc.structs.isin(plt) || this.tc.classes.isin(plt) {
                this.gen_expr(e.left);
                // Pointer/borrow receivers arrive as Object (see jdesc);
                // narrow before field access or the JVM verifier rejects
                // the GETFIELD (redundant when already exact).
                this.emit_checkcast(plt);
                ft: string = this.struct_field_type(plt, e.sval);
                if ft.size == 0 {
                    this.jvm_unsupported("field '" + e.sval + "' of '" + plt + "'");
                    return;
                }
                fd: string = this.jdesc(ft);
                if fd.size == 0 {
                    this.jvm_unsupported("field type '" + ft + "'");
                    return;
                }
                idx: int = this.cur_cp.fieldref(plt, e.sval, fd);
                this.cur_method.op_field(JOp.GETFIELD, idx, this.slots_of(fd) - 1);
                return;
            }
            this.jvm_unsupported("pointer member access '->' (unsafe interop is not supported on jvm)");
            return;
        }
        this.jvm_unsupported("expression kind " + tostring(e.kind));
    }

    pub fnc enum_const_val(name string) : int {
        if this.tc.enum_consts.isin(name) { return this.tc.enum_consts[name]; }
        return 0;
    }

    // The `self` keyword: the current function's own name (with the
    // native stripping rules for `_error_` wrappers and Class_method
    // owner mangling); self::Class / self::Parent give class names.
    pub fnc self_name_now() : string {
        self_name: string = this.current_func_name;
        if self_name.size > 7 && self_name[0] == '_' && self_name[1] == 'e' && self_name[2] == 'r'
           && self_name[3] == 'r' && self_name[4] == 'o' && self_name[5] == 'r' && self_name[6] == '_' {
            err_only: string = "";
            ei: int = 7;
            while ei < self_name.size {
                err_only = err_only + self_name[ei];
                ei = ei + 1;
            }
            self_name = err_only;
        }
        if this.current_class.size > 0 && self_name.size > this.current_class.size + 1 && self_name[this.current_class.size] == '_' {
            sn_guard: int = 0;
            sn_ok: bool = true;
            while sn_guard < this.current_class.size {
                if self_name[sn_guard] != this.current_class[sn_guard] { sn_ok = false; stop; }
                sn_guard = sn_guard + 1;
            }
            if sn_ok {
                stripped: string = "";
                si2: int = this.current_class.size + 1;
                while si2 < self_name.size {
                    stripped = stripped + self_name[si2];
                    si2 = si2 + 1;
                }
                self_name = stripped;
            }
        }
        return self_name;
    }

    pub fnc gen_ident(name string) : void {
        if name == "_" {
            // Discard sink reads as zero (native parity).
            this.iconst(0);
            return;
        }
        if name == "self" && !this.var_slots.isin("self") {
            this.ldc_string(this.self_name_now());
            return;
        }
        if name == "self::Class" && !this.var_slots.isin("self") {
            this.ldc_string(this.current_class);
            return;
        }
        if name == "self::Parent" && !this.var_slots.isin("self") {
            par: string = "";
            if this.tc.classes.isin(this.current_class) {
                par = this.tc.classes[this.current_class].parent;
            }
            this.ldc_string(par);
            return;
        }
        if name == "_PLATFORM" {
            this.ldc_string("jvm");
            return;
        }
        if name == "_FILEPATH" {
            this.ldc_string(this.src_file);
            return;
        }
        if name == "_FILENAME" {
            this.ldc_string(this.base_name(this.src_file));
            return;
        }
        if this.tc.enum_str_consts.isin(name) {
            this.ldc_string(this.tc.enum_str_consts[name]);
            return;
        }
        if this.tc.enum_consts.isin(name) {
            this.iconst(this.tc.enum_consts[name]);
            return;
        }
        if this.var_slots.isin(name) {
            t: string = "";
            if this.var_types.isin(name) { t = this.var_types[name]; }
            this.cur_method.load_local(this.jdesc(t), this.var_slots[name]);
            return;
        }
        if this.cg.global_vars.isin(name) {
            gt: string = this.cg.global_vars[name];
            gd: string = this.jdesc(gt);
            if gd.size == 0 {
                this.jvm_unsupported("global '" + name + "' of type '" + gt + "'");
                return;
            }
            if this.is_fusion_int(name, gt) {
                this.fusion_get(name, gt, gd);
                return;
            }
            idx: int = this.cur_cp.fieldref(this.main_class, "g_" + name, gd);
            this.cur_method.op_field(JOp.GETSTATIC, idx, this.slots_of(gd));
            return;
        }
        this.jvm_unsupported("unknown identifier '" + name + "'");
    }

    // Widen the narrower int operand to the wider (literals embed as-is).
    // Returns the common descriptor ("I", "J" or "D").
    pub fnc unify_int(lv string, lt string, rv string, rt string) : string {
        ld: string = this.jdesc(lt);
        rd: string = this.jdesc(rt);
        if ld == rd { return ld; }
        if (ld == "I" || ld == "J") && (rd == "I" || rd == "J") {
            if ld == "J" {
                if rv.size > 0 && rv[0] != '%' {
                    return "J";
                }
                this.cur_method.op(JOp.I2L, 1);
                return "J";
            }
            if lv.size > 0 && lv[0] != '%' {
                return "I";
            }
            this.cur_method.op(JOp.I2L, 1);
            return "J";
        }
        return "";
    }

    // Generate an operand coerced to the common descriptor.
    pub fnc gen_common(e Expr, common string, common_leash string) : void {
        t: string = this.expr_type(e);
        this.gen_expr(e);
        if common == "J" && this.jdesc(t) == "I" {
            if this.is_uint_leash(t) {
                this.cur_method.op(JOp.I2L, 1);
                this.long_const(0, 0 - 1);
                this.cur_method.op(JOp.LAND, -2);
            } else {
                this.cur_method.op(JOp.I2L, 1);
            }
        } also common == "D" {
            this.jvm_coerce(t, common_leash);
        } also common == "I" && this.jdesc(t) == "J" {
            this.cur_method.op(JOp.L2I, -1);
        }
    }

    // String-concat operand conversion: chars materialize as single-char
    // strings (native parity); everything else uses tostring().
    pub fnc jvm_concat_operand(t string) : void {
        if t == "char" {
            this.cur_method.op(JOp.I2C, 0);
            this.emit_invoke(JOp.INVOKESTATIC, "java/lang/String", "valueOf", "(C)Ljava/lang/String;");
            return;
        }
        this.jvm_tostring(t);
    }

    pub fnc gen_binop(e Expr) : void {
        lt: string = this.expr_type(e.left);
        rt: string = this.expr_type(e.right);
        res_t: string = this.expr_type(e);
        // String concatenation and removal.
        if (lt == "string" || rt == "string") && e.op == "+" {
            this.gen_expr(e.left);
            if lt != "string" {
                this.jvm_concat_operand(lt);
            }
            this.gen_expr(e.right);
            if rt != "string" {
                this.jvm_concat_operand(rt);
            }
            this.emit_invoke(JOp.INVOKEVIRTUAL, "java/lang/String", "concat", "(Ljava/lang/String;)Ljava/lang/String;");
            return;
        }
        if (lt == "string" || rt == "string") && e.op == "-" {
            // Removal: all occurrences (native leash_sh_str_sub parity).
            this.gen_expr(e.left);
            if lt != "string" {
                this.jvm_concat_operand(lt);
            }
            ls: int = this.cur_method.alloc_local(1);
            this.cur_method.store_local("Ljava/lang/String;", ls);
            this.gen_expr(e.right);
            if rt != "string" {
                this.jvm_concat_operand(rt);
            }
            rs: int = this.cur_method.alloc_local(1);
            this.cur_method.store_local("Ljava/lang/String;", rs);
            do_lbl: string = this.new_label("ssub_do");
            end_lbl: string = this.new_label("ssub_end");
            this.cur_method.load_local("Ljava/lang/String;", rs);
            this.emit_invoke(JOp.INVOKEVIRTUAL, "java/lang/String", "length", "()I");
            this.cur_method.branch(JOp.IFNE, do_lbl, 1);
            this.cur_method.load_local("Ljava/lang/String;", ls);
            this.cur_method.branch(JOp.GOTO, end_lbl, 0);
            this.cur_method.mark(do_lbl);
            this.cur_method.load_local("Ljava/lang/String;", ls);
            this.cur_method.load_local("Ljava/lang/String;", rs);
            this.ldc_string("");
            this.emit_invoke(JOp.INVOKEVIRTUAL, "java/lang/String", "replace", "(Ljava/lang/CharSequence;Ljava/lang/CharSequence;)Ljava/lang/String;");
            this.cur_method.mark(end_lbl);
            return;
        }
        if e.op == "&&" || e.op == "||" {
            this.gen_logic(e);
            return;
        }
        if e.op == "==" || e.op == "!=" || e.op == "<" || e.op == "<=" || e.op == ">" || e.op == ">=" || e.op == "is" || e.op == "isnt" || e.op == "isT" || e.op == "isntT" {
            this.gen_compare(e, lt, rt);
            return;
        }
        if e.op == "<>" {
            this.gen_membership(e, lt, rt);
            return;
        }
        bd_bi: string = this.jdesc(lt);
        rd_bi: string = this.jdesc(rt);
        if (bd_bi == "Ljava/math/BigInteger;" || rd_bi == "Ljava/math/BigInteger;") {
            if e.op == "+" || e.op == "-" || e.op == "*" || e.op == "/" || e.op == "%" || e.op == "<<" || e.op == ">>" || e.op == "&" || e.op == "|" || e.op == "^" {
                this.gen_expr(e.left);
                this.coerce_to_bigint(lt);
                lhs: int = this.cur_method.alloc_local(1);
                this.cur_method.store_local("X", lhs);
                this.gen_expr(e.right);
                this.coerce_to_bigint(rt);
                rhs: int = this.cur_method.alloc_local(1);
                this.cur_method.store_local("X", rhs);
                this.cur_method.load_local("X", lhs);
                this.cur_method.load_local("X", rhs);
                this.bigint_binop(e.op);
                this.bigint_wrap_to(this.bigint_wider(lt, rt));
                return;
            }
            this.jvm_unsupported("binary '" + e.op + "' on 128-bit");
            return;
        }
        // Numeric ops: common descriptor, coerce both sides, operate,
        // narrow the result back to the expression type.
        ld: string = this.jdesc(lt);
        rd: string = this.jdesc(rt);
        common: string = "I";
        common_leash: string = "int";
        if ld == "D" || rd == "D" {
            common = "D";
            common_leash = "float";
        } also ld == "J" || rd == "J" {
            common = "J";
            common_leash = "int<64>";
        }
        if common != "I" && common != "J" && common != "D" {
            this.jvm_unsupported("binary '" + e.op + "' on '" + lt + "' and '" + rt + "'");
            return;
        }
        this.gen_common(e.left, common, common_leash);
        this.gen_common(e.right, common, common_leash);
        is_uint_op: bool = this.is_uint_leash(lt);
        if e.op == "+" { this.int_op(common, JOp.IADD, JOp.LADD, JOp.DADD); }
        also e.op == "-" { this.int_op(common, JOp.ISUB, JOp.LSUB, JOp.DSUB); }
        also e.op == "*" { this.int_op(common, JOp.IMUL, JOp.LMUL, JOp.DMUL); }
        also e.op == "/" {
            if common == "D" { this.cur_method.op(JOp.DDIV, -2); }
            also common == "J" {
                this.check_nonzero("J");
                if is_uint_op {
                    this.emit_invoke(JOp.INVOKESTATIC, "java/lang/Long", "divideUnsigned", "(JJ)J");
                } else {
                    this.cur_method.op(JOp.LDIV, -2);
                }
            } else {
                this.check_nonzero("I");
                if is_uint_op {
                    this.emit_invoke(JOp.INVOKESTATIC, "java/lang/Integer", "divideUnsigned", "(II)I");
                } else {
                    this.cur_method.op(JOp.IDIV, -1);
                }
            }
        } also e.op == "%" {
            if common == "D" { this.cur_method.op(JOp.DREM, -2); }
            also common == "J" {
                this.check_nonzero("J");
                if is_uint_op {
                    this.emit_invoke(JOp.INVOKESTATIC, "java/lang/Long", "remainderUnsigned", "(JJ)J");
                } else {
                    this.cur_method.op(JOp.LREM, -2);
                }
            } else {
                this.check_nonzero("I");
                if is_uint_op {
                    this.emit_invoke(JOp.INVOKESTATIC, "java/lang/Integer", "remainderUnsigned", "(II)I");
                } else {
                    this.cur_method.op(JOp.IREM, -1);
                }
            }
        } also e.op == "&" || e.op == "|" || e.op == "^" {
            if common == "D" {
                this.jvm_unsupported("bitwise '" + e.op + "' on floats");
                return;
            }
            if e.op == "&" { this.int_op(common, JOp.IAND, JOp.LAND, JOp.DADD); }
            also e.op == "|" { this.int_op(common, JOp.IOR, JOp.LOR, JOp.DADD); }
            else { this.int_op(common, JOp.IXOR, JOp.LXOR, JOp.DADD); }
        } also e.op == "<<" || e.op == ">>" {
            // JVM shifts take an int distance: narrow a long rhs back.
            if common == "J" { this.cur_method.op(JOp.L2I, -1); }
            if e.op == "<<" {
                if common == "J" { this.cur_method.op(JOp.LSHL, -1); }
                else { this.cur_method.op(JOp.ISHL, -1); }
            } else {
                if common == "J" {
                    if is_uint_op { this.cur_method.op(JOp.LUSHR, -1); } else { this.cur_method.op(JOp.LSHR, -1); }
                } else {
                    if is_uint_op { this.cur_method.op(JOp.IUSHR, -1); } else { this.cur_method.op(JOp.ISHR, -1); }
                }
            }
        } else {
            this.jvm_unsupported("binary operator '" + e.op + "'");
            return;
        }
        this.narrow_to(res_t);
    }

    pub fnc int_op(common string, iop int, lop int, dop int) : void {
        if common == "D" { this.cur_method.op(dop, -2); }
        also common == "J" { this.cur_method.op(lop, -2); }
        else { this.cur_method.op(iop, -1); }
    }

    // Abort with a message when the divisor on the stack top is zero
    // (reference parity: message to stdout, exit 1). Consumes nothing.
    pub fnc check_nonzero(idesc string) : void {
        // Spill/restore through a temp: dup_x1/swap/dup2 break
        // old-verifier joins (verified empirically on the target JVM),
        // while plain dup/pop and locals are safe.
        ok_lbl: string = this.new_label("nz_ok");
        tslot: int = this.cur_method.temp_slot(idesc);
        this.cur_method.store_local(idesc, tslot);
        this.cur_method.load_local(idesc, tslot);
        if idesc == "J" {
            this.cur_method.op(JOp.LCONST_0, 2);
            this.cur_method.op(JOp.LCMP, -3);
        }
        this.cur_method.branch(JOp.IFNE, ok_lbl, 1);
        // Fail block: fresh [out, msg] pair (the spilled divisor stays in
        // its temp; the dividend below is dead after exit, so no juggling).
        this.emit_getstatic_out();
        this.ldc_string("Runtime error: Division by zero.\n");
        this.emit_invoke(JOp.INVOKEVIRTUAL, "java/io/PrintStream", "print", "(Ljava/lang/String;)V");
        this.iconst(1);
        this.emit_invoke(JOp.INVOKESTATIC, "java/lang/System", "exit", "(I)V");
        this.cur_method.branch(JOp.GOTO, ok_lbl, 0);
        this.cur_method.mark(ok_lbl);
        this.cur_method.load_local(idesc, tslot);
    }

    // Comparisons yield 0/1 ints. Strings compare by content
    // (null-safe Objects.equals); doubles use ordered compares so NaN
    // behaves like the native backend; refs compare by identity.
    // value <> collection: substring (strings), contains (vecs),
    // element scan (arrays). Yields bool.
    pub fnc gen_membership(e Expr, lt string, rt string) : void {
        rd: string = this.jdesc(rt);
        // string <> string: haystack contains needle (receiver first).
        if rt == "string" {
            at: string = this.expr_type(e.left);
            this.gen_expr(e.left);
            this.jvm_coerce(at, "string");
            tmp: int = this.cur_method.alloc_local(1);
            this.cur_method.store_local("Ljava/lang/String;", tmp);
            this.gen_expr(e.right);
            this.cur_method.load_local("Ljava/lang/String;", tmp);
            this.emit_invoke(JOp.INVOKEVIRTUAL, "java/lang/String", "contains", "(Ljava/lang/CharSequence;)Z");
            return;
        }
        // value <> vec<T>: list.contains(boxed value).
        if rd == "Ljava/util/ArrayList;" && this.is_vec_leash(rt) {
            inner: string = this.vec_inner_type(rt);
            at2: string = this.expr_type(e.left);
            this.gen_expr(e.left);
            if !this.coerce_val(at2, inner) {
                this.jvm_coerce(at2, inner);
                this.narrow_to(inner);
            }
            this.box_for(inner);
            tmp2: int = this.cur_method.alloc_local(1);
            this.cur_method.store_local("X", tmp2);
            this.gen_expr(e.right);
            this.cur_method.load_local("X", tmp2);
            this.emit_invoke(JOp.INVOKEVIRTUAL, "java/util/ArrayList", "contains", "(Ljava/lang/Object;)Z");
            return;
        }
        // value <> array: element scan with per-lane equality.
        if rd.size > 0 && rd[0] == '[' {
            at3: string = this.expr_type(e.left);
            ad3: string = this.jdesc(at3);
            this.gen_expr(e.left);
            if ad3 == "I" {
                this.cur_method.op(JOp.I2L, 1);
                ad3 = "J";
            } also ad3 != "J" {
                this.jvm_tostring(at3);
                ad3 = "Ljava/lang/String;";
            }
            vs: int = 0;
            if ad3 == "J" {
                vs = this.cur_method.alloc_local(2);
                this.cur_method.store_local("J", vs);
            } else {
                vs = this.cur_method.alloc_local(1);
                this.cur_method.store_local("X", vs);
            }
            this.gen_expr(e.right);
            arr: int = this.cur_method.alloc_local(1);
            this.cur_method.store_local("X", arr);
            this.iconst(0);
            res: int = this.cur_method.alloc_local(1);
            this.cur_method.store_local("I", res);
            this.iconst(0);
            i: int = this.cur_method.alloc_local(1);
            this.cur_method.store_local("I", i);
            loop_lbl: string = this.new_label("mem_loop");
            next_lbl: string = this.new_label("mem_next");
            end_lbl: string = this.new_label("mem_end");
            this.cur_method.mark(loop_lbl);
            this.cur_method.load_local("I", i);
            this.cur_method.load_local("X", arr);
            this.cur_method.op(JOp.ARRAYLENGTH, 0);
            this.cur_method.branch(JOp.IF_ICMPGE, end_lbl, 2);
            this.cur_method.load_local("X", arr);
            this.cur_method.load_local("I", i);
            if rd == "[I" || rd == "[J" || rd == "[D" {
                if rd == "[I" {
                    this.cur_method.op(JOp.IALOAD, -1);
                    this.cur_method.op(JOp.I2L, 1);
                } also rd == "[J" {
                    this.cur_method.op(JOp.LALOAD, 0);
                } else {
                    this.cur_method.op(JOp.DALOAD, 0);
                }
            } else {
                this.cur_method.op(JOp.AALOAD, -1);
            }
            // Compare elem against the value local.
            if ad3 == "J" && (rd == "[I" || rd == "[J") {
                this.cur_method.load_local("J", vs);
                this.cur_method.op(JOp.LCMP, -3);
                // LCMP == 0 means EQUAL: fall through to mark found.
                this.cur_method.branch(JOp.IFNE, next_lbl, 1);
            } also ad3 == "Ljava/lang/String;" {
                this.cur_method.load_local("X", vs);
                this.emit_invoke(JOp.INVOKESTATIC, "java/util/Objects", "equals", "(Ljava/lang/Object;Ljava/lang/Object;)Z");
                this.cur_method.branch(JOp.IFEQ, next_lbl, 1);
            } also rd == "[D" {
                // Skip double-lane membership (unsupported combination).
                this.cur_method.op(JOp.POP2, -2);
                this.cur_method.branch(JOp.GOTO, next_lbl, 0);
            } else {
                this.cur_method.op(JOp.POP, -1);
                this.cur_method.branch(JOp.GOTO, next_lbl, 0);
            }
            this.iconst(1);
            this.cur_method.store_local("I", res);
            this.cur_method.branch(JOp.GOTO, end_lbl, 0);
            this.cur_method.mark(next_lbl);
            this.cur_method.load_local("I", i);
            this.iconst(1);
            this.cur_method.op(JOp.IADD, -1);
            this.cur_method.store_local("I", i);
            this.cur_method.branch(JOp.GOTO, loop_lbl, 0);
            this.cur_method.mark(end_lbl);
            this.cur_method.load_local("I", res);
            return;
        }
        this.jvm_unsupported("membership '<>' on '" + rt + "'");
    }

    pub fnc gen_compare(e Expr, lt string, rt string) : void {
        ld: string = this.jdesc(lt);
        rd: string = this.jdesc(rt);
        // Booleans compare as ints.
        if ld == "Z" { ld = "I"; }
        if rd == "Z" { rd = "I"; }
        // `is`/`isnt` share the ==/!= paths for scalars and strings;
        // containers compare deep via equals; anything else is false.
        op2: string = e.op;
        // `x is Type` / `x isnt Type`: compile-time type check.
        if e.op == "isT" || e.op == "isntT" {
            lt_r: string = this.tc.resolve_type_alias(lt);
            rt_r: string = this.tc.resolve_type_alias(e.right.sval);
            if this.tc.structs.isin(e.right.sval) || this.tc.classes.isin(e.right.sval) { rt_r = e.right.sval; }
            eq_c: bool = lt_r == rt_r;
            if e.op == "isntT" { eq_c = !eq_c; }
            if eq_c {
                this.cur_method.op(JOp.ICONST_1, 1);
            } else {
                this.cur_method.op(JOp.ICONST_0, 1);
            }
            return;
        }
        // Deep `is` for containers (arrays via Arrays.equals, vecs via
        // List.equals); scalars/strings fall through to the == paths.
        if e.op == "is" || e.op == "isnt" {
            if ld.size > 0 && ld[0] == '[' && rd.size > 0 && rd[0] == '[' {
                this.gen_expr(e.left);
                this.gen_expr(e.right);
                if ld == "[I" || ld == "[J" || ld == "[D" || ld == "[Z" || ld == "[C" || ld == "[B" || ld == "[S" {
                    this.emit_invoke(JOp.INVOKESTATIC, "java/util/Arrays", "equals", "(" + ld + ld + ")Z");
                } else {
                    this.emit_invoke(JOp.INVOKESTATIC, "java/util/Arrays", "equals", "([Ljava/lang/Object;[Ljava/lang/Object;)Z");
                }
                if e.op == "isnt" {
                    this.cur_method.op(JOp.ICONST_1, 1);
                    this.cur_method.op(JOp.IXOR, -1);
                }
                return;
            }
            if ld == "Ljava/util/ArrayList;" && rd == "Ljava/util/ArrayList;" {
                this.gen_expr(e.left);
                this.gen_expr(e.right);
                this.emit_invoke(JOp.INVOKEVIRTUAL, "java/util/ArrayList", "equals", "(Ljava/lang/Object;)Z");
                if e.op == "isnt" {
                    this.cur_method.op(JOp.ICONST_1, 1);
                    this.cur_method.op(JOp.IXOR, -1);
                }
                return;
            }
        }
        if op2 == "is" { op2 = "=="; }
        also op2 == "isnt" { op2 = "!="; }
        t_lbl: string = this.new_label("cmp_t");
        e_lbl: string = this.new_label("cmp_e");
        // Value == nil: native nil is the zero bit pattern (C null), so
        // compare against the type's zero. Refs fall through to identity.
        if (lt == "nil" || rt == "nil") && (op2 == "==" || op2 == "!=") {
            nil_v: string = lt;
            other_v: string = rt;
            if lt != "nil" { other_v = lt; nil_v = rt; }
            od_n: string = this.jdesc(other_v);
            if od_n == "I" || od_n == "Z" {
                this.gen_expr(lt == "nil" ? e.right : e.left);
                this.cur_method.op(JOp.ICONST_0, 1);
                if op2 == "==" {
                    this.cur_method.branch(JOp.IF_ICMPEQ, t_lbl, 2);
                } else {
                    this.cur_method.branch(JOp.IF_ICMPNE, t_lbl, 2);
                }
                this.cur_method.op(JOp.ICONST_0, 1);
                this.cur_method.branch(JOp.GOTO, e_lbl, 0);
                this.cur_method.mark(t_lbl);
                this.cur_method.op(JOp.ICONST_1, 1);
                this.cur_method.mark(e_lbl);
                return;
            }
            if od_n == "J" {
                this.gen_expr(lt == "nil" ? e.right : e.left);
                this.cur_method.op(JOp.LCONST_0, 2);
                this.cur_method.op(JOp.LCMP, -3);
                if op2 == "==" {
                    this.cur_method.branch(JOp.IFEQ, t_lbl, 1);
                } else {
                    this.cur_method.branch(JOp.IFNE, t_lbl, 1);
                }
                this.cur_method.op(JOp.ICONST_0, 1);
                this.cur_method.branch(JOp.GOTO, e_lbl, 0);
                this.cur_method.mark(t_lbl);
                this.cur_method.op(JOp.ICONST_1, 1);
                this.cur_method.mark(e_lbl);
                return;
            }
            if od_n == "D" {
                this.gen_expr(lt == "nil" ? e.right : e.left);
                this.cur_method.op(JOp.DCONST_0, 2);
                this.cur_method.op(JOp.DCMPL, -3);
                if op2 == "==" {
                    this.cur_method.branch(JOp.IFEQ, t_lbl, 1);
                } else {
                    this.cur_method.branch(JOp.IFNE, t_lbl, 1);
                }
                this.cur_method.op(JOp.ICONST_0, 1);
                this.cur_method.branch(JOp.GOTO, e_lbl, 0);
                this.cur_method.mark(t_lbl);
                this.cur_method.op(JOp.ICONST_1, 1);
                this.cur_method.mark(e_lbl);
                return;
            }
        }
        // compareTo is null-hostile (unlike Objects.equals), so nil
        // operands keep the old path.
        if (lt == "string" || rt == "string" || ld == "Ljava/lang/String;" || rd == "Ljava/lang/String;") && lt != "nil" && rt != "nil" && (op2 == "==" || op2 == "!=" || op2 == "<" || op2 == "<=" || op2 == ">" || op2 == ">=") {
            this.gen_expr(e.left);
            if ld != "Ljava/lang/String;" && lt != "nil" {
                this.jvm_tostring(lt);
            }
            this.gen_expr(e.right);
            if rd != "Ljava/lang/String;" && rt != "nil" {
                this.jvm_tostring(rt);
            }
            if op2 == "==" || op2 == "!=" {
                this.emit_invoke(JOp.INVOKESTATIC, "java/util/Objects", "equals", "(Ljava/lang/Object;Ljava/lang/Object;)Z");
                if op2 == "!=" {
                    this.cur_method.op(JOp.ICONST_1, 1);
                    this.cur_method.op(JOp.IXOR, -1);
                }
                return;
            }
            // Lexicographic ordering via String.compareTo (never reference
            // order). Both sides are Strings here (tostring'd above when
            // the static type was not already a string).
            this.emit_invoke(JOp.INVOKEVIRTUAL, "java/lang/String", "compareTo", "(Ljava/lang/String;)I");
            if op2 == "<" {
                this.cur_method.branch(JOp.IFLT, t_lbl, 1);
            } also op2 == "<=" {
                this.cur_method.branch(JOp.IFLE, t_lbl, 1);
            } also op2 == ">" {
                this.cur_method.branch(JOp.IFGT, t_lbl, 1);
            } else {
                this.cur_method.branch(JOp.IFGE, t_lbl, 1);
            }
            this.cur_method.op(JOp.ICONST_0, 1);
            this.cur_method.branch(JOp.GOTO, e_lbl, 0);
            this.cur_method.mark(t_lbl);
            this.cur_method.op(JOp.ICONST_1, 1);
            this.cur_method.mark(e_lbl);
            return;
        }
        if (ld == "Ljava/math/BigInteger;" || rd == "Ljava/math/BigInteger;") && (op2 == "==" || op2 == "!=" || op2 == "<" || op2 == "<=" || op2 == ">" || op2 == ">=") {
            this.gen_expr(e.left);
            this.coerce_to_bigint(lt);
            lhs: int = this.cur_method.alloc_local(1);
            this.cur_method.store_local("X", lhs);
            this.gen_expr(e.right);
            this.coerce_to_bigint(rt);
            rhs: int = this.cur_method.alloc_local(1);
            this.cur_method.store_local("X", rhs);
            this.cur_method.load_local("X", lhs);
            this.cur_method.load_local("X", rhs);
            this.emit_invoke(JOp.INVOKEVIRTUAL, "java/math/BigInteger", "compareTo", "(Ljava/math/BigInteger;)I");
            if op2 == "==" {
                this.cur_method.branch(JOp.IFEQ, t_lbl, 1);
            } also op2 == "!=" {
                this.cur_method.branch(JOp.IFNE, t_lbl, 1);
            } also op2 == "<" {
                this.cur_method.branch(JOp.IFLT, t_lbl, 1);
            } also op2 == "<=" {
                this.cur_method.branch(JOp.IFLE, t_lbl, 1);
            } also op2 == ">" {
                this.cur_method.branch(JOp.IFGT, t_lbl, 1);
            } else {
                this.cur_method.branch(JOp.IFGE, t_lbl, 1);
            }
            this.cur_method.op(JOp.ICONST_0, 1);
            this.cur_method.branch(JOp.GOTO, e_lbl, 0);
            this.cur_method.mark(t_lbl);
            this.cur_method.op(JOp.ICONST_1, 1);
            this.cur_method.mark(e_lbl);
            return;
        }
        if op2 == "==" || op2 == "!=" {
            // `is`/`isnt` on structs/classes is constantly false/true
            // (native parity); `==`/`!=` use identity below.
            if (e.op == "is" || e.op == "isnt") && this.both_refs(ld, rd) && !this.is_vec_leash(lt) && !this.is_hash_leash(lt) && !this.is_vec_leash(rt) && !this.is_hash_leash(rt) && ld[0] != '[' {
                if e.op == "is" {
                    this.cur_method.op(JOp.ICONST_0, 1);
                } else {
                    this.cur_method.op(JOp.ICONST_1, 1);
                }
                return;
            }
            // Reference identity for ==/!= on objects (`is` keeps its
            // own constant-false semantics in the fallback below).
            // Containers and arrays compare deep in later branches.
            if (e.op == "==" || e.op == "!=") && this.both_refs(ld, rd) && !this.is_vec_leash(lt) && !this.is_hash_leash(lt) && !this.is_vec_leash(rt) && !this.is_hash_leash(rt) && ld[0] != '[' {
                this.gen_expr(e.left);
                this.gen_expr(e.right);
                if op2 == "==" {
                    this.cur_method.branch(JOp.IF_ACMPEQ, t_lbl, 2);
                } else {
                    this.cur_method.branch(JOp.IF_ACMPNE, t_lbl, 2);
                }
                this.cur_method.op(JOp.ICONST_0, 1);
                this.cur_method.branch(JOp.GOTO, e_lbl, 0);
                this.cur_method.mark(t_lbl);
                this.cur_method.op(JOp.ICONST_1, 1);
                this.cur_method.mark(e_lbl);
                return;
            }
            if ld == "D" || rd == "D" {
                this.gen_expr(e.left);
                if ld != "D" { this.jvm_coerce(lt, "float"); }
                this.gen_expr(e.right);
                if rd != "D" { this.jvm_coerce(rt, "float"); }
                this.cur_method.op(JOp.DCMPL, -3);
                if op2 == "==" {
                    this.cur_method.branch(JOp.IFEQ, t_lbl, 1);
                } else {
                    this.cur_method.branch(JOp.IFNE, t_lbl, 1);
                }
            } also ld == "J" || rd == "J" {
                this.gen_expr(e.left);
                if ld != "J" { this.jvm_coerce(lt, "int<64>"); }
                this.gen_expr(e.right);
                if rd != "J" { this.jvm_coerce(rt, "int<64>"); }
                this.cur_method.op(JOp.LCMP, -3);
                if op2 == "==" {
                    this.cur_method.branch(JOp.IFEQ, t_lbl, 1);
                } else {
                    this.cur_method.branch(JOp.IFNE, t_lbl, 1);
                }
            } else {
                if ld != "I" && ld != "Z" && rd != "I" && rd != "Z" {
                    this.jvm_unsupported("comparison '" + e.op + "' on '" + lt + "' and '" + rt + "'");
                    return;
                }
                this.gen_expr(e.left);
                this.gen_expr(e.right);
                if op2 == "==" {
                    this.cur_method.branch(JOp.IF_ICMPEQ, t_lbl, 2);
                } else {
                    this.cur_method.branch(JOp.IF_ICMPNE, t_lbl, 2);
                }
            }
            this.cur_method.op(JOp.ICONST_0, 1);
            this.cur_method.branch(JOp.GOTO, e_lbl, 0);
            this.cur_method.mark(t_lbl);
            this.cur_method.op(JOp.ICONST_1, 1);
            this.cur_method.mark(e_lbl);
            return;
        }
        // Ordered comparisons.
        if ld == "D" || rd == "D" {
            this.gen_expr(e.left);
            if ld != "D" { this.jvm_coerce(lt, "float"); }
            this.gen_expr(e.right);
            if rd != "D" { this.jvm_coerce(rt, "float"); }
            this.cur_method.op(JOp.DCMPG, -3);
            this.ordered_branch(e.op, t_lbl, e_lbl);
            return;
        }
        if ld == "J" || rd == "J" {
            if this.is_uint_leash(lt) || this.is_uint_leash(rt) {
                this.gen_expr(e.left);
                if ld != "J" { this.jvm_coerce(lt, "int<64>"); }
                this.gen_expr(e.right);
                if rd != "J" { this.jvm_coerce(rt, "int<64>"); }
                this.emit_invoke(JOp.INVOKESTATIC, "java/lang/Long", "compareUnsigned", "(JJ)I");
                this.ordered_branch(e.op, t_lbl, e_lbl);
            } else {
                this.gen_expr(e.left);
                if ld != "J" { this.jvm_coerce(lt, "int<64>"); }
                this.gen_expr(e.right);
                if rd != "J" { this.jvm_coerce(rt, "int<64>"); }
                this.cur_method.op(JOp.LCMP, -3);
                this.ordered_branch(e.op, t_lbl, e_lbl);
            }
            return;
        }
        if ld == "I" && rd == "I" {
            if this.is_uint_leash(lt) || this.is_uint_leash(rt) {
                this.gen_expr(e.left);
                this.gen_expr(e.right);
                this.emit_invoke(JOp.INVOKESTATIC, "java/lang/Integer", "compareUnsigned", "(II)I");
                this.ordered_branch(e.op, t_lbl, e_lbl);
            } else {
                this.gen_expr(e.left);
                this.gen_expr(e.right);
                this.int_ordered_branch(e.op, t_lbl, e_lbl);
            }
            return;
        }
        if (ld == "Ljava/lang/String;" || rd == "Ljava/lang/String;") && (e.op == "<" || e.op == "<=" || e.op == ">" || e.op == ">=") {
            this.jvm_unsupported("ordered comparison on strings");
            return;
        }
        // Containers compare deep via equals (native parity).
        if (ld.size > 0 && ld[0] == '[') || ld == "Ljava/util/ArrayList;" || ld == "Ljava/util/HashMap;" {
            this.gen_expr(e.left);
            this.gen_expr(e.right);
            eq_desc: string = "(Ljava/lang/Object;Ljava/lang/Object;)Z";
            eq_owner: string = "java/util/Objects";
            eq_name: string = "equals";
            if ld.size > 0 && ld[0] == '[' {
                eq_owner = "java/util/Arrays";
                eq_name = "equals";
                eq_desc = "(" + ld + rd + ")Z";
            }
            this.emit_invoke(JOp.INVOKESTATIC, eq_owner, eq_name, eq_desc);
            if op2 == "!=" {
                this.cur_method.op(JOp.ICONST_1, 1);
                this.cur_method.op(JOp.IXOR, -1);
            }
            return;
        }
        // Nil and raw pointers compare by identity; scalars against
        // nil compare against zero (native parity).
        if lt == "nil" && rt == "nil" {
            if op2 == "==" {
                this.cur_method.op(JOp.ICONST_1, 1);
            } else {
                this.cur_method.op(JOp.ICONST_0, 1);
            }
            return;
        }
        if lt == "nil" || rt == "nil" {
            other_t: string = rt;
            if lt != "nil" { other_t = lt; }
            od: string = this.jdesc(other_t);
            if other_t == lt {
                this.gen_expr(e.left);
            } else {
                this.gen_expr(e.right);
            }
            if od == "I" || od == "Z" {
                this.cur_method.op(JOp.ICONST_0, 1);
                if op2 == "==" {
                    this.cur_method.branch(JOp.IF_ICMPEQ, t_lbl, 2);
                } else {
                    this.cur_method.branch(JOp.IF_ICMPNE, t_lbl, 2);
                }
            } also od == "J" {
                this.cur_method.op(JOp.LCONST_0, 2);
                this.cur_method.op(JOp.LCMP, -3);
                if op2 == "==" {
                    this.cur_method.branch(JOp.IFEQ, t_lbl, 1);
                } else {
                    this.cur_method.branch(JOp.IFNE, t_lbl, 1);
                }
            } also od == "D" {
                this.cur_method.op(JOp.DCONST_0, 2);
                this.cur_method.op(JOp.DCMPL, -3);
                if op2 == "==" {
                    this.cur_method.branch(JOp.IFEQ, t_lbl, 1);
                } else {
                    this.cur_method.branch(JOp.IFNE, t_lbl, 1);
                }
            } else {
                if op2 == "==" {
                    this.cur_method.branch(JOp.IFNULL, t_lbl, 1);
                } else {
                    this.cur_method.branch(JOp.IFNONNULL, t_lbl, 1);
                }
            }
            this.cur_method.op(JOp.ICONST_0, 1);
            this.cur_method.branch(JOp.GOTO, e_lbl, 0);
            this.cur_method.mark(t_lbl);
            this.cur_method.op(JOp.ICONST_1, 1);
            this.cur_method.mark(e_lbl);
            return;
        }
        if (lt.size > 0 && lt[0] == '*') || (rt.size > 0 && rt[0] == '*') {
            this.gen_expr(e.left);
            this.gen_expr(e.right);
            if op2 == "==" {
                this.cur_method.branch(JOp.IF_ACMPEQ, t_lbl, 2);
            } else {
                this.cur_method.branch(JOp.IF_ACMPNE, t_lbl, 2);
            }
            this.cur_method.op(JOp.ICONST_0, 1);
            this.cur_method.branch(JOp.GOTO, e_lbl, 0);
            this.cur_method.mark(t_lbl);
            this.cur_method.op(JOp.ICONST_1, 1);
            this.cur_method.mark(e_lbl);
            return;
        }
        // Anything else (structs, classes, exotic refs): `is` is always
        // false (native parity); `==` compares reference identity.
        if e.op == "is" {
            this.cur_method.op(JOp.ICONST_0, 1);
        } also e.op == "isnt" {
            this.cur_method.op(JOp.ICONST_1, 1);
        } else {
            this.gen_expr(e.left);
            this.gen_expr(e.right);
            if op2 == "==" {
                this.cur_method.branch(JOp.IF_ACMPEQ, t_lbl, 2);
            } else {
                this.cur_method.branch(JOp.IF_ACMPNE, t_lbl, 2);
            }
            this.cur_method.op(JOp.ICONST_0, 1);
            this.cur_method.branch(JOp.GOTO, e_lbl, 0);
            this.cur_method.mark(t_lbl);
            this.cur_method.op(JOp.ICONST_1, 1);
            this.cur_method.mark(e_lbl);
        }
    }

    // ifXX on an int comparison result already on the stack.
    pub fnc ordered_branch(op string, t_lbl string, e_lbl string) : void {
        if op == "<" { this.cur_method.branch(JOp.IFLT, t_lbl, 1); }
        also op == "<=" { this.cur_method.branch(JOp.IFLE, t_lbl, 1); }
        also op == ">" { this.cur_method.branch(JOp.IFGT, t_lbl, 1); }
        also op == ">=" { this.cur_method.branch(JOp.IFGE, t_lbl, 1); }
        else {
            this.jvm_unsupported("ordered comparison '" + op + "'");
            return;
        }
        this.cur_method.op(JOp.ICONST_0, 1);
        this.cur_method.branch(JOp.GOTO, e_lbl, 0);
        this.cur_method.mark(t_lbl);
        this.cur_method.op(JOp.ICONST_1, 1);
        this.cur_method.mark(e_lbl);
    }

    // Direct integer-pair branches (no compare instruction needed).
    pub fnc int_ordered_branch(op string, t_lbl string, e_lbl string) : void {
        if op == "<" { this.cur_method.branch(JOp.IF_ICMPLT, t_lbl, 2); }
        also op == "<=" { this.cur_method.branch(JOp.IF_ICMPLE, t_lbl, 2); }
        also op == ">" { this.cur_method.branch(JOp.IF_ICMPGT, t_lbl, 2); }
        also op == ">=" { this.cur_method.branch(JOp.IF_ICMPGE, t_lbl, 2); }
        else {
            this.jvm_unsupported("ordered comparison '" + op + "'");
            return;
        }
        this.cur_method.op(JOp.ICONST_0, 1);
        this.cur_method.branch(JOp.GOTO, e_lbl, 0);
        this.cur_method.mark(t_lbl);
        this.cur_method.op(JOp.ICONST_1, 1);
        this.cur_method.mark(e_lbl);
    }

    // Short-circuit && / || over truthy values.
    pub fnc gen_logic(e Expr) : void {
        t_lbl: string = this.new_label("logic_t");
        e_lbl: string = this.new_label("logic_e");
        if e.op == "&&" {
            r_lbl: string = this.new_label("logic_r");
            ok_lbl: string = this.new_label("logic_ok");
            this.gen_truthy(e.left, r_lbl);
            this.cur_method.branch(JOp.GOTO, e_lbl, 0);
            this.cur_method.mark(r_lbl);
            this.gen_truthy(e.right, ok_lbl);
            this.cur_method.branch(JOp.GOTO, e_lbl, 0);
            this.cur_method.mark(ok_lbl);
            this.cur_method.op(JOp.ICONST_1, 1);
            this.cur_method.branch(JOp.GOTO, t_lbl, 0);
            this.cur_method.mark(e_lbl);
            this.cur_method.op(JOp.ICONST_0, 1);
            this.cur_method.mark(t_lbl);
        } else {
            this.gen_truthy(e.left, t_lbl);
            this.gen_truthy(e.right, t_lbl);
            this.cur_method.op(JOp.ICONST_0, 1);
            this.cur_method.branch(JOp.GOTO, e_lbl, 0);
            this.cur_method.mark(t_lbl);
            this.cur_method.op(JOp.ICONST_1, 1);
            this.cur_method.mark(e_lbl);
        }
    }

    // Branch to yes_lbl when the value is truthy (falls through else).
    pub fnc gen_truthy(arg Expr, yes_lbl string) : void {
        t: string = this.expr_type(arg);
        d: string = this.jdesc(t);
        this.gen_expr(arg);
        if d == "Z" || d == "I" {
            this.cur_method.branch(JOp.IFNE, yes_lbl, 1);
        } also d == "J" {
            this.cur_method.op(JOp.LCONST_0, 2);
            this.cur_method.op(JOp.LCMP, -3);
            this.cur_method.branch(JOp.IFNE, yes_lbl, 1);
        } also d == "D" {
            this.cur_method.op(JOp.DCONST_0, 2);
            this.cur_method.op(JOp.DCMPL, -3);
            this.cur_method.branch(JOp.IFNE, yes_lbl, 1);
        } else {
            this.cur_method.branch(JOp.IFNONNULL, yes_lbl, 1);
        }
    }

    pub fnc gen_unary(e Expr) : void {
        if e.op == "await" {
            // CompletableFuture.join (unchecked): no exception tables.
            ot: string = this.expr_type(e.left);
            this.gen_expr(e.left);
            this.emit_checkcast("java/util/concurrent/CompletableFuture");
            this.emit_invoke(JOp.INVOKEVIRTUAL, "java/util/concurrent/CompletableFuture", "join", "()Ljava/lang/Object;");
            inner: string = this.future_inner_type(ot);
            if inner == "void" || inner.size == 0 {
                this.cur_method.op(JOp.POP, -1);
            } else {
                this.unbox_to(inner);
            }
            return;
        }
        if e.op == "!" {
            t: string = this.expr_type(e.left);
            d: string = this.jdesc(t);
            this.gen_expr(e.left);
            if d == "J" {
                this.cur_method.op(JOp.LCONST_0, 2);
                this.cur_method.op(JOp.LCMP, -3);
            } also d == "D" {
                this.cur_method.op(JOp.DCONST_0, 2);
                this.cur_method.op(JOp.DCMPL, -3);
            }
            this.cur_method.op(JOp.ICONST_1, 1);
            this.cur_method.op(JOp.IXOR, -1);
            return;
        }
        if e.op == "++p" || e.op == "--p" || e.op == "++" || e.op == "--" {
            is_prefix: bool = e.op == "++p" || e.op == "--p";
            is_inc: bool = e.op == "++p" || e.op == "++";
            this.gen_incr_expr(e.left, is_prefix, is_inc);
            return;
        }
        if e.op == "-" {
            t: string = this.expr_type(e.left);
            d: string = this.jdesc(t);
            if d == "Ljava/math/BigInteger;" {
                this.gen_expr(e.left);
                this.coerce_to_bigint(t);
                this.emit_invoke(JOp.INVOKEVIRTUAL, "java/math/BigInteger", "negate", "()Ljava/math/BigInteger;");
                this.bigint_wrap_to(t);
                return;
            }
            this.gen_expr(e.left);
            if d == "J" {
                this.cur_method.op(JOp.LNEG, 0);
            } also d == "D" {
                this.cur_method.op(JOp.DNEG, 0);
            } else {
                this.cur_method.op(JOp.INEG, 0);
                this.narrow_to(t);
            }
            return;
        }
        if e.op == "~" {
            t: string = this.expr_type(e.left);
            d: string = this.jdesc(t);
            if d == "Ljava/math/BigInteger;" {
                this.gen_expr(e.left);
                this.coerce_to_bigint(t);
                this.emit_invoke(JOp.INVOKEVIRTUAL, "java/math/BigInteger", "not", "()Ljava/math/BigInteger;");
                this.bigint_wrap_to(t);
                return;
            }
            if d != "I" && d != "J" {
                this.jvm_unsupported("unary '~' on '" + t + "'");
                return;
            }
            this.gen_expr(e.left);
            if d == "J" {
                this.long_const(-1, -1);
                this.cur_method.op(JOp.LXOR, -2);
            } else {
                this.iconst(-1);
                this.cur_method.op(JOp.IXOR, -1);
            }
            this.narrow_to(t);
            return;
        }
        if e.op == "++p" || e.op == "--p" || e.op == "++" || e.op == "--" {
            this.jvm_unsupported("inc/dec '" + e.op + "' (wiring in progress)");
            return;
        }
        // Address-of / deref on struct/class pointees: pointers ride as
        // plain references on the JVM, so both are identity (no copy —
        // &x must alias, matching native borrow-into-pointer).
        if e.op == "&" {
            lt: string = this.deref_t(this.expr_type(e.left));
            if this.tc.structs.isin(lt) || this.tc.classes.isin(lt) {
                this.gen_expr(e.left);
                return;
            }
        }
        if e.op == "*" {
            lt: string = this.deref_t(this.expr_type(e.left));
            if this.tc.structs.isin(lt) || this.tc.classes.isin(lt) {
                this.gen_expr(e.left);
                return;
            }
        }
        this.jvm_unsupported("unary operator '" + e.op + "'");
    }

    // Inc/dec in expression position: prefix yields new, postfix old.
    // IDENT cells lower directly (fusion stays atomic); anything else
    // reads once and stores back through a synthesized assignment.
    pub fnc gen_incr_expr(t Expr, is_prefix bool, is_inc bool) : void {
        if t.kind == ExprKind.IDENT && this.var_slots.isin(t.sval) {
            vt: string = "";
            if this.var_types.isin(t.sval) { vt = this.var_types[t.sval]; }
            vd: string = this.jdesc(vt);
            slot: int = this.var_slots[t.sval];
            this.cur_method.load_local(vd, slot);
            if vd == "J" || vd == "D" {
                this.cur_method.op(JOp.DUP2, 2);
            } else {
                this.cur_method.op(JOp.DUP, 1);
            }
            if is_prefix {
                // [old] -> incr -> [new] -> dup -> store one -> yield new
                this.incr_top(vt, vd, is_inc);
                if vd == "J" || vd == "D" {
                    this.cur_method.op(JOp.DUP2, 2);
                } else {
                    this.cur_method.op(JOp.DUP, 1);
                }
                this.cur_method.store_local(vd, slot);
            } else {
                // [old] -> dup already above -> incr top -> store -> yield old
                this.incr_top(vt, vd, is_inc);
                this.cur_method.store_local(vd, slot);
            }
            return;
        }
        if t.kind == ExprKind.IDENT && !this.var_slots.isin(t.sval) && this.cg.global_vars.isin(t.sval) {
            gt: string = this.cg.global_vars[t.sval];
            gd: string = this.jdesc(gt);
            if this.is_fusion_int(t.sval, gt) {
                this.fusion_ref(t.sval, gd);
                if gd == "J" {
                    if is_inc {
                        this.long_const(0, 1);
                    } else {
                        this.long_const(0, 1);
                        this.cur_method.op(JOp.LNEG, 0);
                    }
                    this.emit_invoke(JOp.INVOKEVIRTUAL, "java/util/concurrent/atomic/AtomicLong", "getAndAdd", "(J)J");
                } else {
                    this.iconst(1);
                    if !is_inc {
                        this.cur_method.op(JOp.INEG, 0);
                    }
                    this.emit_invoke(JOp.INVOKEVIRTUAL, "java/util/concurrent/atomic/AtomicInteger", "getAndAdd", "(I)I");
                }
                if is_prefix {
                    // old -> new = old +/- 1
                    if gd == "J" {
                        if is_inc {
                            this.long_const(0, 1);
                            this.cur_method.op(JOp.LADD, -2);
                        } else {
                            this.long_const(0, 1);
                            this.cur_method.op(JOp.LSUB, -2);
                        }
                    } else {
                        this.iconst(1);
                        if is_inc {
                            this.cur_method.op(JOp.IADD, -1);
                        } else {
                            this.cur_method.op(JOp.ISUB, -1);
                        }
                        this.narrow_to(gt);
                    }
                }
                return;
            }
            // Plain global: load, dup, incr, store.
            idx: int = this.cur_cp.fieldref(this.main_class, "g_" + t.sval, gd);
            this.cur_method.op_field(JOp.GETSTATIC, idx, this.slots_of(gd));
            if gd == "J" || gd == "D" {
                this.cur_method.op(JOp.DUP2, 2);
            } else {
                this.cur_method.op(JOp.DUP, 1);
            }
            if is_prefix {
                this.incr_top(gt, gd, is_inc);
                if gd == "J" || gd == "D" {
                    this.cur_method.op(JOp.DUP2, 2);
                } else {
                    this.cur_method.op(JOp.DUP, 1);
                }
                this.emit_putstatic(t.sval, gd);
            } else {
                this.incr_top(gt, gd, is_inc);
                this.emit_putstatic(t.sval, gd);
            }
            return;
        }
        // General lvalues: read once, write back through assignment.
        told: string = this.expr_type(t);
        this.gen_expr(t);
        if is_prefix {
            pf_op: string = "+";
            if !is_inc { pf_op = "-"; }
            pf_rhs: Expr = Expr.make_int(1);
            if this.is_float_desc(this.jdesc(told)) { pf_rhs = Expr.make_float(1.0); }
            sta: Stmt = Stmt.make_assign(t, "=", Expr.make_binop(pf_op, t, pf_rhs));
            this.gen_statement(sta);
            // The old value is still on top: advance it to new.
            this.incr_top(told, this.jdesc(told), is_inc);
            return;
        }
        one_e: Expr = Expr.make_int(1);
        if this.is_float_desc(this.jdesc(told)) { one_e = Expr.make_float(1.0); }
        sta2_op: string = "+";
        if !is_inc { sta2_op = "-"; }
        sta2: Stmt = Stmt.make_assign(t, "=", Expr.make_binop(sta2_op, t, one_e));
        this.gen_statement(sta2);
    }

    // old +/- 1 on the stack top (int widths narrow; 1.0 for floats).
    pub fnc incr_top(t string, d string, is_inc bool) : void {
        if d == "Ljava/math/BigInteger;" {
            oidx: int = this.cur_cp.fieldref("java/math/BigInteger", "ONE", "Ljava/math/BigInteger;");
            this.cur_method.op_field(JOp.GETSTATIC, oidx, 1);
            if is_inc {
                this.emit_invoke(JOp.INVOKEVIRTUAL, "java/math/BigInteger", "add", "(Ljava/math/BigInteger;)Ljava/math/BigInteger;");
            } else {
                this.emit_invoke(JOp.INVOKEVIRTUAL, "java/math/BigInteger", "subtract", "(Ljava/math/BigInteger;)Ljava/math/BigInteger;");
            }
            this.bigint_wrap_to(t);
            return;
        }
        if d == "J" {
            if is_inc {
                this.long_const(0, 1);
                this.cur_method.op(JOp.LADD, -2);
            } else {
                this.long_const(0, 1);
                this.cur_method.op(JOp.LSUB, -2);
            }
            return;
        }
        if d == "D" {
            this.ldc_double_one();
            if is_inc {
                this.cur_method.op(JOp.DADD, -2);
            } else {
                this.cur_method.op(JOp.DSUB, -2);
            }
            return;
        }
        this.iconst(1);
        if is_inc {
            this.cur_method.op(JOp.IADD, -1);
        } else {
            this.cur_method.op(JOp.ISUB, -1);
        }
        this.narrow_to(t);
    }

    pub fnc is_float_desc(d string) : bool {
        return d == "D";
    }

    // --- Functions ----------------------------------------------------
    // Descriptor piece for extern parameters: unrepresentable C
    // types (pointer<pointer<char>>, ...) ride as Object. The stub never
    // reads them; call sites pass references, which verify as Objects.
    pub fnc extern_piece(t string) : string {
        d: string = this.jdesc(t);
        if d.size > 0 { return d; }
        if t.size > 0 && t[0] == '*' { return "Ljava/lang/Object;"; }
        if t.size > 8 && t[0] == 'p' && t[1] == 'o' && t[2] == 'i' && t[3] == 'n' && t[4] == 't' && t[5] == 'e' && t[6] == 'r' && t[7] == '<' {
            return "Ljava/lang/Object;";
        }
        // First-class function values have no JVM lane; extern stubs and
        // skipped signatures carry them as Object (nothing on the JVM can
        // produce one, so the value never flows).
        if t.size > 3 && t[0] == 'f' && t[1] == 'n' && t[2] == 'c' {
            return "Ljava/lang/Object;";
        }
        return "";
    }

    pub fnc extern_desc(f FuncDecl) : string {
        desc: string = "(";
        foreach _, p in<vector> f.params {
            pd: string = this.extern_piece(p.typ);
            if pd.size == 0 { return ""; }
            desc = desc + pd;
        }
        desc = desc + ")";
        rd: string = this.jdesc(f.ret_type);
        if rd.size == 0 { return ""; }
        desc = desc + rd;
        return desc;
    }

    pub fnc method_desc(f FuncDecl) : string {
        desc: string = "(";
        foreach _, p in<vector> f.params {
            pd: string = this.jdesc(p.typ);
            if pd.size == 0 { return ""; }
            desc = desc + pd;
        }
        desc = desc + ")";
        rd: string = this.jdesc(f.ret_type);
        if rd.size == 0 { return ""; }
        desc = desc + rd;
        return desc;
    }

    // ===================== async/await on the JVM =====================
    // future<T> rides as CompletableFuture (Java 8+; programs using async
    // need a Java 8 runtime, everything else stays v49). Each `async fnc`
    // becomes a body method plus a stub that submits a Supplier task to a
    // shared cached pool; `await` joins (unchecked, no exception tables).

    pub fnc future_inner_type(t string) : string {
        start: int = 7;
        depth: int = 0;
        i: int = start;
        while i < t.size {
            c: char = t[i];
            if c == '<' { depth = depth + 1; }
            also c == '>' {
                if depth == 0 {
                    inner: string = "";
                    k: int = start;
                    while k < i {
                        inner = inner + t[k];
                        k = k + 1;
                    }
                    return inner;
                }
                depth = depth - 1;
            }
            i = i + 1;
        }
        return "";
    }

    pub fnc boxed_desc(t string) : string {
        d: string = this.jdesc(t);
        if d == "I" {
            if t == "char" { return "Ljava/lang/Character;"; }
            if this.is_uint_leash(t) { return "Ljava/lang/Long;"; }
            return "Ljava/lang/Integer;";
        }
        if d == "J" { return "Ljava/lang/Long;"; }
        if d == "D" { return "Ljava/lang/Double;"; }
        if d == "Z" { return "Ljava/lang/Boolean;"; }
        return d;
    }

    // Boxed box_for mirror check is by construction (see boxed_desc).

    pub fnc prog_uses_async(prog Program) : bool {
        foreach _, f in<vector> prog.funcs {
            if f.is_async && f.owner.size == 0 { return true; }
            if f.is_worker && f.owner.size == 0 { return true; }
        }
        return false;
    }

    // Emit body (as name__async_body) + stub (as name) + Supplier task.
    pub fnc gen_async_function(f FuncDecl, cls JvmClass) : void {
        // Body first (plain static emission under the mangled name).
        this.gen_function(f, cls, f.name + "__async_body");
        ptypes: vec<string>;
        pi0: int = 0;
        while pi0 < f.params.size {
            ptypes.pushb(f.params.get(pi0).typ);
            pi0 = pi0 + 1;
        }
        this.gen_supplier_task(f.name + "__task", ptypes, this.main_class, f.name + "__async_body", this.async_body_desc(f), f.ret_type);
        // ---- Stub on the main class ----
        this.cur_cp = cls.cp;
        sm: JvmMethod = JvmMethod.make(cls.cp.utf8(f.name), cls.cp.utf8(this.async_stub_desc(f)), JAcc.PUBLIC + JAcc.STATIC);
        this.cur_method = sm;
        si: int = 0;
        slots: vec<int>;
        while si < f.params.size {
            pt: string = f.params.get(si).typ;
            sl: int = sm.alloc_local(this.slots_of(this.jdesc(pt)));
            slots.pushb(sl);
            si = si + 1;
        }
        this.cur_method.op(JOp.NEW, 1);
        taskn: string = f.name + "__task";
        ti: int = cls.cp.class_entry(taskn);
        this.cur_method.emit_u8((ti >> 8) & 255);
        this.cur_method.emit_u8(ti & 255);
        this.cur_method.op(JOp.DUP, 1);
        si = 0;
        while si < f.params.size {
            pt: string = f.params.get(si).typ;
            this.cur_method.load_local(this.jdesc(pt), slots.get(si));
            this.box_for(pt);
            si = si + 1;
        }
        this.emit_invoke(JOp.INVOKESPECIAL, taskn, "<init>", this.async_ctor_desc(f));
        pf: int = cls.cp.fieldref(this.main_class, "__pool", "Ljava/util/concurrent/ExecutorService;");
        this.cur_method.op_field(JOp.GETSTATIC, pf, 1);
        this.emit_invoke(JOp.INVOKESTATIC, "java/util/concurrent/CompletableFuture", "supplyAsync", "(Ljava/util/function/Supplier;Ljava/util/concurrent/Executor;)Ljava/util/concurrent/CompletableFuture;");
        this.cur_method.op(JOp.ARETURN, -1);
        if !sm.finalize(cls.cp) {
            foreach _, e in<vector> sm.errors {
                this.fail(e);
            }
        } else {
            cls.add_method(sm);
        }
    }

    // Supplier task class shared by async stubs and spawn sites.
    pub fnc gen_supplier_task(task_name string, ptypes vec<string>, body_class string, body_name string, body_desc string, ret_type string) : void {
        saved_cp: JvmCp = this.cur_cp;
        saved_m: JvmMethod = this.cur_method;
        tk: JvmClass = JvmClass.make(task_name, "java/lang/Object");
        tk.ifaces.pushb("java/util/function/Supplier");
        // Fields (boxed params).
        pi: int = 0;
        while pi < ptypes.size {
            pt: string = ptypes.get(pi);
            tk.add_field(JAcc.PRIVATE, "a" + tostring(pi), this.boxed_desc(pt));
            pi = pi + 1;
        }
        this.klass_idx.push(task_name, this.klasses.size);
        this.klasses.pushb(tk);
        this.cur_cp = tk.cp;
        // Constructor.
        cm: JvmMethod = JvmMethod.make(tk.cp.utf8("<init>"), tk.cp.utf8(this.async_ctor_desc_typed(ptypes)), JAcc.PUBLIC);
        this.cur_method = cm;
        cm.alloc_local(1);
        ai: int = 0;
        while ai < ptypes.size {
            cm.alloc_local(1);
            ai = ai + 1;
        }
        this.cur_method.op(JOp.ALOAD_0, 1);
        this.emit_invoke(JOp.INVOKESPECIAL, "java/lang/Object", "<init>", "()V");
        ai = 0;
        while ai < ptypes.size {
            this.cur_method.op(JOp.ALOAD_0, 1);
            this.cur_method.load_local("X", 1 + ai);
            fi: int = tk.cp.fieldref(task_name, "a" + tostring(ai), this.boxed_desc(ptypes.get(ai)));
            this.cur_method.op_field(JOp.PUTFIELD, fi, -2);
            ai = ai + 1;
        }
        this.cur_method.op(JOp.RETURN, 0);
        if !cm.finalize(tk.cp) {
            foreach _, e in<vector> cm.errors {
                this.fail(e);
            }
        } else {
            tk.add_method(cm);
        }
        // get()Object: unbox fields, call the body, box (or null).
        gm: JvmMethod = JvmMethod.make(tk.cp.utf8("get"), tk.cp.utf8("()Ljava/lang/Object;"), JAcc.PUBLIC);
        this.cur_method = gm;
        gm.alloc_local(1);
        ai = 0;
        while ai < ptypes.size {
            pt: string = ptypes.get(ai);
            this.cur_method.op(JOp.ALOAD_0, 1);
            fi: int = tk.cp.fieldref(task_name, "a" + tostring(ai), this.boxed_desc(pt));
            this.cur_method.op_field(JOp.GETFIELD, fi, 0);
            this.unbox_to(pt);
            ai = ai + 1;
        }
        this.emit_invoke(JOp.INVOKESTATIC, body_class, body_name, body_desc);
        if ret_type == "void" {
            this.cur_method.op(JOp.ACONST_NULL, 1);
        } else {
            this.box_for(ret_type);
        }
        this.cur_method.op(JOp.ARETURN, -1);
        if !gm.finalize(tk.cp) {
            foreach _, e in<vector> gm.errors {
                this.fail(e);
            }
        } else {
            tk.add_method(gm);
        }
        this.cur_cp = saved_cp;
        this.cur_method = saved_m;
    }

    pub fnc async_ctor_desc_typed(ptypes vec<string>) : string {
        desc: string = "(";
        pi: int = 0;
        while pi < ptypes.size {
            desc = desc + this.boxed_desc(ptypes.get(pi));
            pi = pi + 1;
        }
        desc = desc + ")V";
        return desc;
    }

    pub fnc async_ctor_desc(f FuncDecl) : string {
        desc: string = "(";
        pi: int = 0;
        while pi < f.params.size {
            desc = desc + this.boxed_desc(f.params.get(pi).typ);
            pi = pi + 1;
        }
        desc = desc + ")V";
        return desc;
    }

    pub fnc async_body_desc(f FuncDecl) : string {
        desc: string = "(";
        pi: int = 0;
        while pi < f.params.size {
            pd: string = this.jdesc(f.params.get(pi).typ);
            if pd.size == 0 { return ""; }
            desc = desc + pd;
            pi = pi + 1;
        }
        desc = desc + ")";
        rd: string = this.jdesc(f.ret_type);
        if rd.size == 0 { return ""; }
        desc = desc + rd;
        return desc;
    }

    pub fnc async_stub_desc(f FuncDecl) : string {
        desc: string = "(";
        pi: int = 0;
        while pi < f.params.size {
            pd: string = this.jdesc(f.params.get(pi).typ);
            if pd.size == 0 { return ""; }
            desc = desc + pd;
            pi = pi + 1;
        }
        desc = desc + ")Ljava/util/concurrent/CompletableFuture;";
        return desc;
    }

    pub fnc gen_function(f FuncDecl, cls JvmClass, rename string) : void {
        // Worker bodies emit as plain static methods; `spawn` runs them
        // on the shared pool through a Supplier task.
        if f.is_async && rename.size == 0 {
            this.jvm_unsupported("async function '" + f.name + "' (not supported on jvm)");
            return;
        }
        if f.is_external {
            // Runtime-throwing stub (Leash throw semantics: message +
            // exit). Importing a native module stays possible; calling
            // into it fails loudly instead of silently.
            desc: string = this.extern_desc(f);
            if desc.size == 0 {
                this.jvm_unsupported("native (@from) function '" + f.name + "' (unrepresentable signature)");
                return;
            }
            m: JvmMethod = JvmMethod.make(cls.cp.utf8(f.name), cls.cp.utf8(desc), JAcc.PUBLIC + JAcc.STATIC);
            this.cur_cp = cls.cp;
            this.cur_method = m;
            // Reserve argument slots (max_locals must cover them even
            // though the stub body never touches them).
            di: int = 1;
            while di < desc.size && desc[di] != ')' {
                dc: char = desc[di];
                if dc == 'J' || dc == 'D' {
                    m.alloc_local(2);
                    di = di + 1;
                } also dc == 'L' {
                    m.alloc_local(1);
                    while di < desc.size && desc[di] != ';' { di = di + 1; }
                    di = di + 1;
                } also dc == '[' {
                    m.alloc_local(1);
                    while di < desc.size && desc[di] == '[' { di = di + 1; }
                    if di < desc.size && desc[di] == 'L' {
                        while di < desc.size && desc[di] != ';' { di = di + 1; }
                    }
                    di = di + 1;
                } else {
                    m.alloc_local(1);
                    di = di + 1;
                }
            }
            this.print_lit("\nRuntime error: native function '" + f.name + "' is not supported on the jvm target\n");
            this.iconst(1);
            this.emit_invoke(JOp.INVOKESTATIC, "java/lang/System", "exit", "(I)V");
            this.jvm_default(this.jdesc(f.ret_type));
            rd: string = this.jdesc(f.ret_type);
            if rd == "V" {
                m.op(JOp.RETURN, 0);
            } also rd == "J" {
                m.op(JOp.LRETURN, -2);
            } also rd == "D" {
                m.op(JOp.DRETURN, -2);
            } also rd.size > 0 && rd[0] == 'L' {
                m.op(JOp.ARETURN, -1);
            } else {
                m.op(JOp.IRETURN, -1);
            }
            if !m.finalize(cls.cp) {
                foreach _, e in<vector> m.errors {
                    this.fail(e);
                }
                return;
            }
            cls.add_method(m);
            this.cur_cp = cls.cp;
            return;
        }
        // Owner-bound methods: instance (this in slot 0) unless the
        // class table marks them static.
        is_method: bool = f.owner.size > 0;
        is_static: bool = true;
        if is_method {
            is_static = false;
            if this.tc.classes.isin(f.owner) {
                is_static = this.tc.classes[f.owner].is_method_static(f.name);
            }
        }
        desc: string = this.method_desc(f);
        if desc.size == 0 {
            // No JVM lane for this signature (e.g. function-typed
            // parameters): skip the definition. Any call site still fails
            // loudly via method_sig ("signature of ..."), so nothing goes
            // silent — uncalled code simply stays out of the class file.
            return;
        }
        mname: string = f.name;
        if rename.size > 0 { mname = rename; }
        acc: int = JAcc.PUBLIC;
        if is_static { acc = acc + JAcc.STATIC; }
        m: JvmMethod = JvmMethod.make(cls.cp.utf8(mname), cls.cp.utf8(desc), acc);
        this.cur_cp = cls.cp;
        this.cur_method = m;
        this.current_class = f.owner;
        // Fresh locals per function.
        empty_vt: hash<string, string>;
        empty_vs: hash<string, int>;
        empty_cp: hash<string, string>;
        this.var_types = empty_vt;
        this.var_slots = empty_vs;
        this.cg.var_types = empty_vt;
        this.cg.var_ptrs = empty_cp;
        empty_defers: vec<Stmt>;
        this.defer_stack = empty_defers;
        empty_hh: vec<string>;
        empty_he: vec<string>;
        this.loop_heads = empty_hh;
        this.loop_exits = empty_he;
        this.current_func_ret = f.ret_type;
        this.current_func_name = f.name;
        this.current_func_unsafe = f.is_unsafe;
        this.array_base_override = "";
        this.opdef_inner = "";
        if f.name.size > 7 && f.name[0] == '_' && f.name[1] == 'o' && f.name[2] == 'p'
           && f.name[3] == 'd' && f.name[4] == 'e' && f.name[5] == 'f' && f.name[6] == '_' {
            foreach _, op in<vector> f.params {
                opt: string = op.typ;
                if opt.size > 5 && opt[0] == 'v' && opt[1] == 'e' && opt[2] == 'c' && opt[3] == '<' {
                    this.opdef_inner = this.vec_inner_type(opt);
                }
                also opt.size > 6 && opt[0] == 'h' && opt[1] == 'a' && opt[2] == 's' && opt[3] == 'h' && opt[4] == '<' {
                    this.opdef_inner = this.hash_val_type(opt);
                }
            }
        }
        this.tmap_owner = "";
        if this.tc.inst_tmaps.isin(f.owner) { this.tmap_owner = f.owner; }
        if is_method && !is_static {
            tslot: int = m.alloc_local(1);
            this.define_var("this", f.owner, tslot);
        }
        foreach _, p in<vector> f.params {
            pd: string = this.jdesc(p.typ);
            slot: int = m.alloc_local(this.slots_of(pd));
            // Callers narrow arguments to parameter types (see gen_call),
            // so slots start with in-range values.
            this.define_var(p.name, p.typ, slot);
        }
        this.gen_block(f.body);
        // Fallthrough return (drains defers like the reference).
        this.drain_defers();
        rd: string = this.jdesc(f.ret_type);
        if rd == "V" {
            m.op(JOp.RETURN, 0);
        } also rd == "J" || rd == "D" {
            this.jvm_default(rd);
            if rd == "J" {
                m.op(JOp.LRETURN, -2);
            } else {
                m.op(JOp.DRETURN, -2);
            }
        } also rd == "I" || rd == "Z" || rd == "B" || rd == "S" || rd == "C" {
            m.op(JOp.ICONST_0, 1);
            m.op(JOp.IRETURN, -1);
        } else {
            m.op(JOp.ACONST_NULL, 1);
            m.op(JOp.ARETURN, -1);
        }
        if !m.finalize(cls.cp) {
            foreach _, e in<vector> m.errors {
                this.fail(e);
            }
            return;
        }
        cls.add_method(m);
    }

    pub fnc gen_program(prog Program, cls JvmClass) : void {
        // Extern (@from) functions emit runtime-throwing stubs so mixed
        // modules stay importable; calls fail loudly only when executed.
        foreach _, ef in<vector> prog.funcs {
            if ef.is_external && ef.owner.size == 0 {
                this.extern_names.push(ef.name, true);
            }
        }
        this.cur_cp = cls.cp;
        // Globals become static fields (fusion integers become atomics).
        foreach _, g in<vector> prog.globals {
            this.cg.global_vars.push(g.name, g.typ);
            if g.is_fusion { this.fusion_names.push(g.name, true); }
            gd: string = this.jdesc(g.typ);
            if gd.size == 0 {
                this.jvm_unsupported("global '" + g.name + "' of type '" + g.typ + "'");
                continue;
            }
            if g.is_fusion && (gd == "I" || gd == "J") {
                acls: string = "java/util/concurrent/atomic/AtomicInteger";
                if gd == "J" { acls = "java/util/concurrent/atomic/AtomicLong"; }
                cls.add_field(JAcc.PRIVATE + JAcc.STATIC, "g_" + g.name, "L" + acls + ";");
            } else {
                if g.is_fusion {
                    this.jvm_unsupported("fusion global '" + g.name + "' of non-integer type '" + g.typ + "'");
                    continue;
                }
                cls.add_field(JAcc.PRIVATE + JAcc.STATIC, "g_" + g.name, gd);
            }
        }
        // Enum variant-name tables (for .name lookups).
        foreach _, e in<vector> prog.enums {
            cls.add_field(JAcc.PRIVATE + JAcc.STATIC, "enum_" + e.name + "_names", "[Ljava/lang/String;");
        }
        // Runtime-helper state: shared Random + program-start nanos.
        cls.add_field(JAcc.PRIVATE + JAcc.STATIC, "__rng_key", "[I");
        cls.add_field(JAcc.PRIVATE + JAcc.STATIC, "__rng_ctr", "J");
        cls.add_field(JAcc.PRIVATE + JAcc.STATIC, "__rng_buf", "[I");
        cls.add_field(JAcc.PRIVATE + JAcc.STATIC, "__rng_pos", "I");
        cls.add_field(JAcc.PRIVATE + JAcc.STATIC, "__pool", "Ljava/util/concurrent/ExecutorService;");
        cls.add_field(JAcc.PRIVATE + JAcc.STATIC, "__showb", "Ljava/lang/StringBuffer;");
        cls.add_field(JAcc.PRIVATE + JAcc.STATIC, "__t0", "J");
        this.emit_helpers(cls);
        // Structs and classes become emitted classes (fields only here;
        // methods are routed to their class below).
        foreach _, s in<vector> prog.structs {
            this.emit_struct_shell(s.name, s.fields, "java/lang/Object");
        }
        foreach _, c in<vector> prog.classes {
            if this.tc.generic_classes.isin(c.name) {
                continue;
            }
            sup: string = "java/lang/Object";
            if c.parent.size > 0 { sup = c.parent; }
            this.emit_struct_shell(c.name, c.fields, sup);
        }
        // Owner-bound methods declared outside decls (fnc C.m style).
        foreach _, f in<vector> prog.funcs {
            if this.tc.generic_funcs.isin(f.name) { continue; }
            if f.is_async && f.owner.size == 0 {
                this.gen_async_function(f, cls);
                continue;
            }
            if f.name == "main" && f.owner.size == 0 { continue; }
            if f.owner.size > 0 {
                if !this.klass_idx.isin(f.owner) {
                    this.jvm_unsupported("method '" + f.name + "' of unknown '" + f.owner + "'");
                    continue;
                }
                ki: int = this.klass_idx[f.owner];
                this.gen_function(f, this.klasses.get(ki), "");
            } else {
                this.gen_function(f, cls, "");
            }
        }
        // Methods declared inside class/struct bodies.
        foreach _, c in<vector> prog.classes {
            if this.tc.generic_classes.isin(c.name) { continue; }
            if !this.klass_idx.isin(c.name) { continue; }
            ki: int = this.klass_idx[c.name];
            foreach _, m in<vector> c.methods {
                if this.tc.generic_funcs.isin(c.name + "_" + m.name) { continue; }
                m2: FuncDecl = m;
                m2.owner = c.name;
                this.gen_function(m2, this.klasses.get(ki), "");
            }
        }
        foreach _, s in<vector> prog.structs {
            if !this.klass_idx.isin(s.name) { continue; }
            ki: int = this.klass_idx[s.name];
            foreach _, m in<vector> s.methods {
                m2: FuncDecl = m;
                m2.owner = s.name;
                this.gen_function(m2, this.klasses.get(ki), "");
            }
        }
        // Entry point + global initializers.
        this.gen_entry(prog, cls);
    }

    // Emit a struct/class shell: fields + default constructor (which
    // auto-constructs container fields, mirroring local defaults).
    pub fnc emit_struct_shell(name string, fields vec<FieldDecl>, sup string) : void {
        kc: JvmClass = JvmClass.make(name, sup);
        foreach _, fd in<vector> fields {
            dd: string = this.jdesc(fd.typ);
            if dd.size == 0 {
                this.jvm_unsupported("field '" + fd.name + "' of type '" + fd.typ + "'");
                continue;
            }
            if fd.is_static {
                kc.add_field(JAcc.PUBLIC + JAcc.STATIC, fd.name, dd);
            } else {
                kc.add_field(JAcc.PUBLIC, fd.name, dd);
            }
        }
        this.klass_idx.push(name, this.klasses.size);
        this.klasses.pushb(kc);
        // Default constructor: super() + container field construction.
        this.cur_cp = kc.cp;
        init: JvmMethod = JvmMethod.make(kc.cp.utf8("<init>"), kc.cp.utf8("()V"), JAcc.PUBLIC);
        this.cur_cp = kc.cp;
        this.cur_method = init;
        init.alloc_local(1);
        this.cur_method.op(JOp.ALOAD_0, 1);
        this.emit_invoke(JOp.INVOKESPECIAL, sup, "<init>", "()V");
        foreach _, fd in<vector> fields {
            if fd.is_static { continue; }
            dd: string = this.jdesc(fd.typ);
            if dd == "Ljava/util/ArrayList;" || dd == "Ljava/util/HashMap;" {
                this.cur_method.op(JOp.ALOAD_0, 1);
                if dd == "Ljava/util/ArrayList;" {
                    this.emit_new_list();
                } else {
                    this.emit_new_map();
                }
                fi: int = kc.cp.fieldref(name, fd.name, dd);
                this.cur_method.op_field(JOp.PUTFIELD, fi, -2);
            } also dd.size > 0 && dd[0] == '[' {
                n: int = this.array_size_of(fd.typ);
                if n >= 0 {
                    this.cur_method.op(JOp.ALOAD_0, 1);
                    this.emit_new_array(fd.typ, n);
                    fi: int = kc.cp.fieldref(name, fd.name, dd);
                    this.cur_method.op_field(JOp.PUTFIELD, fi, -2);
                }
            }
            // Field default initializers (`name: string = "x"`): literal
            // defaults apply in <init> (native parity); explicit struct
            // literals overwrite them afterward.
            if fd.init != null && (fd.init.kind == ExprKind.INT || fd.init.kind == ExprKind.FLOAT
                || fd.init.kind == ExprKind.STRING || fd.init.kind == ExprKind.CHAR || fd.init.kind == ExprKind.BOOL) {
                it: string = this.expr_type(fd.init);
                this.cur_method.op(JOp.ALOAD_0, 1);
                this.gen_expr(fd.init);
                if !this.coerce_val(it, fd.typ) {
                    this.jvm_coerce(it, fd.typ);
                    this.narrow_to(fd.typ);
                }
                fi2: int = kc.cp.fieldref(name, fd.name, dd);
                this.cur_method.op_field(JOp.PUTFIELD, fi2, -2);
            }
        }
        this.cur_method.op(JOp.RETURN, 0);
        if !init.finalize(kc.cp) {
            foreach _, e in<vector> init.errors {
                this.fail(e);
            }
            return;
        }
        kc.add_method(init);
    }

    // Entry `main(String[])`: runs global initializers, then the user
    // main. The user main itself is emitted as __leash_user_main (any
    // signature) so it can never clash with the entry descriptor.
    pub fnc gen_entry(prog Program, cls JvmClass) : void {
        has_main: bool = false;
        main_ret: string = "void";
        main_params: vec<string>;
        foreach _, f in<vector> prog.funcs {
            if f.name == "main" && f.owner.size == 0 {
                has_main = true;
                main_ret = f.ret_type;
                foreach _, p in<vector> f.params {
                    main_params.pushb(p.typ);
                }
            }
        }
        if !has_main {
            this.jvm_unsupported("program has no 'main' function");
            return;
        }
        this.has_entry = true;
        // Re-emit the user main under a fixed name (descriptor freedom).
        foreach _, f in<vector> prog.funcs {
            if f.name == "main" && f.owner.size == 0 {
                this.gen_function(f, cls, "__leash_user_main");
            }
        }
        m: JvmMethod = JvmMethod.make(cls.cp.utf8("main"), cls.cp.utf8("([Ljava/lang/String;)V"), JAcc.PUBLIC + JAcc.STATIC);
        this.cur_cp = cls.cp;
        this.cur_method = m;
        // Incoming argv lives in slot 0.
        m.alloc_local(1);
        // Async worker pool (only when the program uses async; the
        // cached pool's non-daemon threads would otherwise hang exit).
        if this.prog_uses_async(prog) {
            this.emit_invoke(JOp.INVOKESTATIC, "java/util/concurrent/Executors", "newCachedThreadPool", "()Ljava/util/concurrent/ExecutorService;");
            pfi: int = this.cur_cp.fieldref(this.main_class, "__pool", "Ljava/util/concurrent/ExecutorService;");
            this.cur_method.op_field(JOp.PUTSTATIC, pfi, -1);
        }
        // Runtime-helper state: start time (RNG state lazily seeded).
        this.emit_invoke(JOp.INVOKESTATIC, "java/lang/System", "nanoTime", "()J");
        tfi: int = this.cur_cp.fieldref(this.main_class, "__t0", "J");
        this.cur_method.op_field(JOp.PUTSTATIC, tfi, -2);
        // Global initializers.
        foreach _, g in<vector> prog.globals {
            gd: string = this.jdesc(g.typ);
            if gd.size == 0 { continue; }
            if g.is_fusion && (gd == "I" || gd == "J") {
                acls: string = "java/util/concurrent/atomic/AtomicInteger";
                adesc: string = "(I)V";
                if gd == "J" {
                    acls = "java/util/concurrent/atomic/AtomicLong";
                    adesc = "(J)V";
                }
                this.cur_method.op(JOp.NEW, 1);
                ni: int = this.cur_cp.class_entry(acls);
                this.cur_method.emit_u8((ni >> 8) & 255);
                this.cur_method.emit_u8(ni & 255);
                this.cur_method.op(JOp.DUP, 1);
                if g.init_val != null {
                    it: string = this.expr_type(g.init_val);
                    this.gen_expr(g.init_val);
                    this.jvm_coerce(it, g.typ);
                    this.narrow_to(g.typ);
                } else {
                    this.cur_method.op(JOp.ICONST_0, 1);
                    if gd == "J" {
                        this.cur_method.op(JOp.I2L, 1);
                    }
                }
                this.emit_invoke(JOp.INVOKESPECIAL, acls, "<init>", adesc);
                fi: int = this.cur_cp.fieldref(this.main_class, "g_" + g.name, "L" + acls + ";");
                this.cur_method.op_field(JOp.PUTSTATIC, fi, -1);
                continue;
            }
            if g.init_val != null {
                it2: string = this.expr_type(g.init_val);
                this.gen_expr(g.init_val);
                if !this.coerce_val(it2, g.typ) {
                    this.jvm_coerce(it2, g.typ);
                    this.narrow_to(g.typ);
                }
            } else {
                this.jvm_default_for(g.typ);
            }
            fi2: int = this.cur_cp.fieldref(this.main_class, "g_" + g.name, gd);
            this.cur_method.op_field(JOp.PUTSTATIC, fi2, 0 - this.slots_of(gd));
        }
        // Static field initializers (class/struct statics; same phase).
        foreach _, c in<vector> prog.classes {
            if this.tc.generic_classes.isin(c.name) { continue; }
            foreach _, fd in<vector> c.fields {
                if !fd.is_static || fd.init == null { continue; }
                sfd: string = this.jdesc(fd.typ);
                if sfd.size == 0 { continue; }
                it: string = this.expr_type(fd.init);
                this.gen_expr(fd.init);
                if !this.coerce_val(it, fd.typ) {
                    this.jvm_coerce(it, fd.typ);
                    this.narrow_to(fd.typ);
                }
                fi: int = this.cur_cp.fieldref(c.name, fd.name, sfd);
                this.cur_method.op_field(JOp.PUTSTATIC, fi, 0 - this.slots_of(sfd));
            }
        }
        foreach _, st in<vector> prog.structs {
            foreach _, fd in<vector> st.fields {
                if !fd.is_static || fd.init == null { continue; }
                sfd: string = this.jdesc(fd.typ);
                if sfd.size == 0 { continue; }
                it: string = this.expr_type(fd.init);
                this.gen_expr(fd.init);
                if !this.coerce_val(it, fd.typ) {
                    this.jvm_coerce(it, fd.typ);
                    this.narrow_to(fd.typ);
                }
                fi: int = this.cur_cp.fieldref(st.name, fd.name, sfd);
                this.cur_method.op_field(JOp.PUTSTATIC, fi, 0 - this.slots_of(sfd));
            }
        }
        // Enum variant-name tables.
        foreach _, e in<vector> prog.enums {
            names: vec<string>;
            if this.tc.enum_names.isin(e.name) {
                names = this.tc.enum_names[e.name];
            }
            this.iconst(names.size);
            stri: int = this.cur_cp.class_entry("java/lang/String");
            this.cur_method.emit_u8(JOp.ANEWARRAY);
            this.cur_method.emit_u8((stri >> 8) & 255);
            this.cur_method.emit_u8(stri & 255);
            this.cur_method.adjust(0);
            arr_slot: int = this.cur_method.alloc_local(1);
            this.cur_method.store_local("X", arr_slot);
            ni: int = 0;
            while ni < names.size {
                this.cur_method.load_local("X", arr_slot);
                this.iconst(ni);
                this.ldc_string(names.get(ni));
                this.cur_method.op(JOp.AASTORE, -3);
                ni = ni + 1;
            }
            this.cur_method.load_local("X", arr_slot);
            fi: int = this.cur_cp.fieldref(this.main_class, "enum_" + e.name + "_names", "[Ljava/lang/String;");
            this.cur_method.op_field(JOp.PUTSTATIC, fi, -1);
        }
        // Dispatch to the user main.
        wants_args: bool = main_params.size == 1;
        if wants_args && main_params.get(0) != "string[]" {
            this.jvm_unsupported("main() parameters other than 'string[]'");
            return;
        }
        udesc: string = "(";
        if wants_args { udesc = udesc + "[Ljava/lang/String;"; }
        udesc = udesc + ")";
        urd: string = this.jdesc(main_ret);
        if urd.size == 0 {
            this.jvm_unsupported("main() return type '" + main_ret + "'");
            return;
        }
        udesc = udesc + urd;
        // Native argv[0] is the program name; the entry prepends the
        // class name so indices and size match (value differs by
        // invocation path even natively).
        if wants_args {
            this.cur_method.op(JOp.ALOAD_0, 1);
            this.cur_method.op(JOp.ARRAYLENGTH, 0);
            len_slot: int = this.cur_method.alloc_local(1);
            this.cur_method.store_local("I", len_slot);
            this.cur_method.load_local("I", len_slot);
            this.iconst(1);
            this.cur_method.op(JOp.IADD, -1);
            stri: int = this.cur_cp.class_entry("java/lang/String");
            this.cur_method.emit_u8(JOp.ANEWARRAY);
            this.cur_method.emit_u8((stri >> 8) & 255);
            this.cur_method.emit_u8(stri & 255);
            this.cur_method.adjust(0);
            arr_slot: int = this.cur_method.alloc_local(1);
            this.cur_method.store_local("X", arr_slot);
            this.cur_method.load_local("X", arr_slot);
            this.iconst(0);
            this.ldc_string(this.main_class);
            this.cur_method.op(JOp.AASTORE, -3);
            this.cur_method.op(JOp.ALOAD_0, 1);
            this.iconst(0);
            this.cur_method.load_local("X", arr_slot);
            this.iconst(1);
            this.cur_method.load_local("I", len_slot);
            this.emit_invoke(JOp.INVOKESTATIC, "java/lang/System", "arraycopy", "(Ljava/lang/Object;ILjava/lang/Object;II)V");
            this.cur_method.load_local("X", arr_slot);
        }
        this.emit_invoke(JOp.INVOKESTATIC, this.main_class, "__leash_user_main", udesc);
        // Drain buffered showb output (native exit-flush parity).
        this.emit_showb_flush_call();
        if urd == "I" {
            this.emit_invoke(JOp.INVOKESTATIC, "java/lang/System", "exit", "(I)V");
        } else {
            if urd == "J" {
                this.cur_method.op(JOp.L2I, -1);
                this.emit_invoke(JOp.INVOKESTATIC, "java/lang/System", "exit", "(I)V");
            } else {
                if urd == "D" {
                    this.cur_method.op(JOp.POP2, -2);
                } also urd != "V" {
                    this.cur_method.op(JOp.POP, -1);
                }
            }
            if urd == "V" && this.prog_uses_async(prog) {
                this.iconst(0);
                this.emit_invoke(JOp.INVOKESTATIC, "java/lang/System", "exit", "(I)V");
            }
        }
        // Always terminate the entry: System.exit never returns but the
        // verifier still requires a reachable RETURN ("falling off the
        // end" is a VerifyError).
        this.cur_method.op(JOp.RETURN, 0);
        if !m.finalize(cls.cp) {
            foreach _, e in<vector> m.errors {
                this.fail(e);
            }
            return;
        }
        cls.add_method(m);
    }

    // Static call to a same-class function (recursion and forward
    // references resolve at JVM link time).
    // Compile-time byte-count for bytestoint/bytestofloat: int literal
    // or sizeof(type) (native parses the folded literal the same way).
    pub fnc byte_size_const(e Expr) : int {
        if e.kind == ExprKind.INT { return e.ival; }
        if e.kind == ExprKind.CALL && e.sval == "sizeof" && e.args.size == 1 {
            a0: Expr = e.args.get(0);
            st: string = "";
            if a0.kind == ExprKind.STRING { st = a0.sval; }
            else { st = this.expr_type(a0); }
            return this.type_size_of(st);
        }
        return 0 - 1;
    }

    pub fnc gen_call(e Expr) : void {
        fname: string = e.sval;
        if fname == "tostring" {
            this.gen_tostring_call(e);
            return;
        }
        if fname == "cstr" || fname == "toint" || fname == "tofloat" || fname == "tochar" || fname == "typeof" || fname == "sizeof" || fname == "scast" || fname == "get" || fname == "seed" || fname == "rand" || fname == "randf" || fname == "choose" || fname == "wait" || fname == "timepass" || fname == "getenv" || fname == "exit" {
            this.gen_builtin(e);
            return;
        }
        if fname == "exec" {
            this.gen_exec(e);
            return;
        }
        if fname == "printf" {
            this.gen_printf(e);
            return;
        }
        // The JVM collects automatically; explicit collections are no-ops
        // (native parity of observable behavior: live data stays valid).
        if fname == "gc_collect" {
            return;
        }
        if fname == "gc_stats" {
            this.emit_getstatic_out();
            this.ldc_string("[jvm gc: automatic]");
            this.emit_invoke(JOp.INVOKEVIRTUAL, "java/io/PrintStream", "println", "(Ljava/lang/String;)V");
            return;
        }
        // Raw C heap and scanning need real addresses/buffers; the JVM
        // has neither, so fail loudly instead of emitting dead calls.
        if fname == "malloc" || fname == "calloc" || fname == "realloc" || fname == "free" || fname == "strcpy" || fname == "strncpy" || fname == "strcat" || fname == "memcpy" || fname == "memmove" || fname == "memset" {
            this.jvm_unsupported("'" + fname + "' needs the raw C heap (not supported on jvm; use vec/string)");
            return;
        }
        if fname == "scanf" || fname == "fscanf" || fname == "sscanf" || fname == "fprintf" || fname == "sprintf" || fname == "snprintf" {
            this.jvm_unsupported("'" + fname + "' (C stdio buffers are not supported on jvm)");
            return;
        }
        if fname == "tounion" {
            if e.args.size != 2 {
                this.jvm_unsupported("tounion() needs 2 arguments");
                return;
            }
            uname: string = e.args.get(0).sval;
            if !this.tc.unions.isin(uname) {
                this.jvm_unsupported("tounion() of unknown union '" + uname + "'");
                return;
            }
            at: string = this.expr_type(e.args.get(1));
            this.gen_expr(e.args.get(1));
            this.union_auto_store(uname, at);
            return;
        }
        if fname == "lstr" {
            // char[] -> String (native lstr on a slice).
            at: string = this.expr_type(e.args.get(0));
            this.gen_expr(e.args.get(0));
            this.jvm_coerce(at, "char[]");
            this.emit_string_from_chars();
            return;
        }
        if fname == "normescape" {
            at2: string = this.expr_type(e.args.get(0));
            this.gen_expr(e.args.get(0));
            this.jvm_coerce(at2, "string");
            this.emit_invoke(JOp.INVOKESTATIC, this.main_class, "__normescape", "(Ljava/lang/String;)Ljava/lang/String;");
            return;
        }
        if fname == "inttobytes" || fname == "floattobytes" {
            if e.args.size != 2 {
                this.jvm_unsupported(fname + "() needs 2 arguments");
                return;
            }
            vt: string = this.expr_type(e.args.get(1));
            vd: string = this.jdesc(vt);
            st: string = this.expr_type(e.args.get(0));
            this.gen_expr(e.args.get(0));
            this.jvm_coerce(st, "int");
            sz_slot: int = this.cur_method.alloc_local(1);
            this.cur_method.store_local("I", sz_slot);
            this.gen_expr(e.args.get(1));
            if fname == "inttobytes" {
                if vd == "I" {
                    this.cur_method.op(JOp.I2L, 1);
                    this.iconst(4);
                } also vd == "J" {
                    this.iconst(8);
                } else {
                    this.jvm_unsupported("inttobytes() of '" + vt + "'");
                    return;
                }
            } else {
                if vd != "D" {
                    this.jvm_unsupported("floattobytes() of '" + vt + "'");
                    return;
                }
                this.emit_invoke(JOp.INVOKESTATIC, "java/lang/Double", "doubleToRawLongBits", "(D)J");
                this.iconst(8);
            }
            this.cur_method.load_local("I", sz_slot);
            this.emit_invoke(JOp.INVOKESTATIC, this.main_class, "__bytes_from_long", "(JII)[C");
            return;
        }
        if fname == "bytestoint" || fname == "bytestofloat" {
            if e.args.size != 2 {
                this.jvm_unsupported(fname + "() needs 2 arguments");
                return;
            }
            sz: int = this.byte_size_const(e.args.get(0));
            if sz < 1 {
                this.jvm_unsupported(fname + "() needs a constant size");
                return;
            }
            if fname == "bytestofloat" && sz > 8 { sz = 8; }
            this.gen_expr(e.args.get(1));
            this.iconst(sz);
            this.emit_invoke(JOp.INVOKESTATIC, this.main_class, "__bytes_to_long", "([CI)J");
            if fname == "bytestoint" {
                this.cur_method.op(JOp.L2I, -1);
            } else {
                this.emit_invoke(JOp.INVOKESTATIC, "java/lang/Double", "longBitsToDouble", "(J)D");
            }
            return;
        }
        if fname == "__tupget" {
            if e.args.size != 2 {
                this.jvm_unsupported("__tupget() needs 2 arguments");
                return;
            }
            this.gen_expr(e.args.get(0));
            it: string = this.expr_type(e.args.get(1));
            this.gen_expr(e.args.get(1));
            this.jvm_coerce(it, "int");
            this.cur_method.op(JOp.AALOAD, -1);
            tt: string = this.expr_type(e.args.get(0));
            tidx: int = e.args.get(1).ival;
            this.unbox_to(this.tuple_elem(tt, tidx));
            return;
        }
        if fname == "__toint_conv" && e.args.size == 2 {
            // Parser-generated conversion node: __toint_conv(Target, val).
            tgt: string = e.args.get(0).sval;
            at: string = this.expr_type(e.args.get(1));
            this.gen_expr(e.args.get(1));
            this.jvm_coerce(at, tgt);
            this.narrow_to(tgt);
            return;
        }
        if e.is_create {
            this.gen_create(e);
            return;
        }
        if !this.tc.funcs.isin(fname) {
            this.jvm_unsupported("call to unknown function '" + fname + "'");
            return;
        }
        ptypes: vec<string>;
        if this.tc.func_params.isin(fname) {
            ptypes = this.tc.func_params[fname];
        }
        is_ext: bool = this.extern_names.isin(fname);
        desc: string = "(";
        ai: int = 0;
        while ai < e.args.size {
            pt: string = "int";
            if ai < ptypes.size { pt = ptypes.get(ai); }
            pd: string = this.jdesc(pt);
            if pd.size == 0 && is_ext {
                // C pointer soup rides as Object in extern stubs/calls.
                pd = this.extern_piece(pt);
            }
            if pd.size == 0 {
                this.jvm_unsupported("parameter type '" + pt + "'");
                return;
            }
            desc = desc + pd;
            ai = ai + 1;
        }
        desc = desc + ")";
        ret_t: string = this.tc.funcs[fname];
        rd: string = this.jdesc(ret_t);
        if rd.size == 0 {
            this.jvm_unsupported("return type '" + ret_t + "'");
            return;
        }
        desc = desc + rd;
        ai = 0;
        while ai < e.args.size {
            pt: string = "int";
            if ai < ptypes.size { pt = ptypes.get(ai); }
            at: string = this.expr_type(e.args.get(ai));
            arg: Expr = e.args.get(ai);
            if is_ext && arg.kind == ExprKind.UNARY && arg.op == "&" && arg.left != null {
                // C out-param (&local): the stub never reads it; pass the
                // local's value so the call verifies (box primitives to
                // the Object the stub declares). Dead on arrival: the
                // stub throws before touching arguments.
                lat: string = this.expr_type(arg.left);
                this.gen_expr(arg.left);
                if this.extern_piece(pt) == "Ljava/lang/Object;" {
                    ld: string = this.jdesc(lat);
                    if ld == "I" || ld == "J" || ld == "D" || ld == "Z" || ld == "C" || ld == "B" || ld == "S" {
                        this.box_for(lat);
                    }
                } else {
                    if !this.coerce_val(lat, pt) {
                        this.jvm_coerce(lat, pt);
                        this.narrow_to(pt);
                    }
                }
            } else {
                this.gen_expr(e.args.get(ai));
                if !this.coerce_val(at, pt) {
                    this.jvm_coerce(at, pt);
                    this.narrow_to(pt);
                }
            }
            // Struct value args copy (native pass-by-value parity).
            // Borrow (&T) params never copy: the callee mutates through.
            if this.tc.structs.isin(pt) && this.tc.structs.isin(this.deref_t(at)) {
                this.gen_struct_copy(pt);
            }
            ai = ai + 1;
        }
        this.emit_invoke(JOp.INVOKESTATIC, this.main_class, fname, desc);
        this.narrow_to(ret_t);
    }

    pub fnc gen_tostring_call(e Expr) : void {
        if e.args.size < 1 {
            this.jvm_unsupported("tostring() without arguments");
            return;
        }
        at: string = this.expr_type(e.args.get(0));
        this.gen_expr(e.args.get(0));
        if at == "string" { return; }
        this.jvm_tostring(at);
    }

    // Builtin calls: conversions, types, random, stdin, time.

    // exec(cmd, mode) via java ProcessBuilder (stdout captured, modeled).
    pub fnc gen_exec(e Expr) : void {
        // cmd
        ct: string = this.expr_type(e.args.get(0));
        this.gen_expr(e.args.get(0));
        this.jvm_coerce(ct, "string");
        cmd_slot: int = this.cur_method.alloc_local(1);
        this.cur_method.store_local("Ljava/lang/String;", cmd_slot);
        // mode (optional)
        mode_slot: int = this.cur_method.alloc_local(1);
        this.cur_method.op(JOp.ACONST_NULL, 1);
        this.cur_method.store_local("Ljava/lang/String;", mode_slot);
        if e.args.size >= 2 {
            mt: string = this.expr_type(e.args.get(1));
            this.gen_expr(e.args.get(1));
            this.jvm_coerce(mt, "string");
            this.cur_method.store_local("Ljava/lang/String;", mode_slot);
        }
        // args = {"/bin/sh","-c",cmd}
        this.iconst(3);
        this.cur_method.emit_u8(JOp.ANEWARRAY);
        ci: int = this.cur_cp.class_entry("java/lang/String");
        this.cur_method.emit_u8((ci >> 8) & 255);
        this.cur_method.emit_u8(ci & 255);
        this.cur_method.adjust(0);
        arr_slot: int = this.cur_method.alloc_local(1);
        this.cur_method.store_local("X", arr_slot);
        this.cur_method.load_local("X", arr_slot);
        this.iconst(0);
        this.ldc_string("/bin/sh");
        this.cur_method.op(JOp.AASTORE, -3);
        this.cur_method.load_local("X", arr_slot);
        this.iconst(1);
        this.ldc_string("-c");
        this.cur_method.op(JOp.AASTORE, -3);
        this.cur_method.load_local("X", arr_slot);
        this.iconst(2);
        this.cur_method.load_local("Ljava/lang/String;", cmd_slot);
        this.cur_method.op(JOp.AASTORE, -3);
        // ProcessBuilder pb = new ProcessBuilder(args); then merge stderr
        this.cur_method.op(JOp.NEW, 1);
        pi: int = this.cur_cp.class_entry("java/lang/ProcessBuilder");
        this.cur_method.emit_u8((pi >> 8) & 255);
        this.cur_method.emit_u8(pi & 255);
        this.cur_method.op(JOp.DUP, 1);
        this.cur_method.load_local("X", arr_slot);
        this.emit_invoke(JOp.INVOKESPECIAL, "java/lang/ProcessBuilder", "<init>", "([Ljava/lang/String;)V");
        pb_slot: int = this.cur_method.alloc_local(1);
        this.cur_method.store_local("X", pb_slot);
        this.cur_method.load_local("X", pb_slot);
        this.iconst(1);
        this.emit_invoke(JOp.INVOKEVIRTUAL, "java/lang/ProcessBuilder", "redirectErrorStream", "(Z)Ljava/lang/ProcessBuilder;");
        this.cur_method.op(JOp.POP, -1);
        // redirect output to temp file
        this.ldc_string("leash_exec_");
        this.ldc_string(".out");
        this.emit_invoke(JOp.INVOKESTATIC, "java/io/File", "createTempFile", "(Ljava/lang/String;Ljava/lang/String;)Ljava/io/File;");
        tmpf_slot: int = this.cur_method.alloc_local(1);
        this.cur_method.store_local("X", tmpf_slot);
        this.cur_method.load_local("X", tmpf_slot);
        this.emit_invoke(JOp.INVOKEVIRTUAL, "java/io/File", "getAbsolutePath", "()Ljava/lang/String;");
        tmp_path_slot: int = this.cur_method.alloc_local(1);
        this.cur_method.store_local("Ljava/lang/String;", tmp_path_slot);
        this.cur_method.load_local("X", pb_slot);
        this.cur_method.load_local("X", tmpf_slot);
        this.emit_invoke(JOp.INVOKEVIRTUAL, "java/lang/ProcessBuilder", "redirectOutput", "(Ljava/io/File;)Ljava/lang/ProcessBuilder;");
        this.cur_method.op(JOp.POP, -1);
        // Process p = pb.start(); capture exit via waitFor()
        this.cur_method.load_local("X", pb_slot);
        this.emit_invoke(JOp.INVOKEVIRTUAL, "java/lang/ProcessBuilder", "start", "()Ljava/lang/Process;");
        proc_slot: int = this.cur_method.alloc_local(1);
        this.cur_method.store_local("X", proc_slot);
        this.cur_method.load_local("X", proc_slot);
        this.emit_invoke(JOp.INVOKEVIRTUAL, "java/lang/Process", "waitFor", "()I");
        exit_slot: int = this.cur_method.alloc_local(1);
        this.cur_method.store_local("I", exit_slot);
        // read stdout from temp file via Files.readAllBytes
        this.cur_method.op(JOp.NEW, 1);
        si: int = this.cur_cp.class_entry("java/lang/String");
        this.cur_method.emit_u8((si >> 8) & 255);
        this.cur_method.emit_u8(si & 255);
        this.cur_method.op(JOp.DUP, 1);
        this.cur_method.load_local("Ljava/lang/String;", tmp_path_slot);
        this.iconst(0);
        this.cur_method.emit_u8(JOp.ANEWARRAY);
        sei: int = this.cur_cp.class_entry("java/lang/String");
        this.cur_method.emit_u8((sei >> 8) & 255);
        this.cur_method.emit_u8(sei & 255);
        this.cur_method.adjust(0);
        this.emit_invoke(JOp.INVOKESTATIC, "java/nio/file/Paths", "get", "(Ljava/lang/String;[Ljava/lang/String;)Ljava/nio/file/Path;");
        this.emit_invoke(JOp.INVOKESTATIC, "java/nio/file/Files", "readAllBytes", "(Ljava/nio/file/Path;)[B");
        this.ldc_string("ISO-8859-1");
        this.emit_invoke(JOp.INVOKESPECIAL, "java/lang/String", "<init>", "([BLjava/lang/String;)V");
        out_slot: int = this.cur_method.alloc_local(1);
        this.cur_method.store_local("Ljava/lang/String;", out_slot);
        // delete temp file (best-effort, popped)
        this.cur_method.load_local("X", tmpf_slot);
        this.emit_invoke(JOp.INVOKEVIRTUAL, "java/io/File", "delete", "()Z");
        this.cur_method.op(JOp.POP, -1);
        // Decide return: "code"/"run" yield the exit code, anything
        // else (null/"wait") yields stdout. Each path leaves exactly one
        // String: the code path jumps over the stdout load.
        code_lbl: string = this.new_label("ex_code");
        out_lbl: string = this.new_label("ex_out");
        end_lbl: string = this.new_label("ex_end");
        this.cur_method.load_local("Ljava/lang/String;", mode_slot);
        this.cur_method.branch(JOp.IFNULL, out_lbl, 1);
        this.cur_method.load_local("Ljava/lang/String;", mode_slot);
        this.ldc_string("code");
        this.emit_invoke(JOp.INVOKEVIRTUAL, "java/lang/String", "equals", "(Ljava/lang/Object;)Z");
        this.cur_method.branch(JOp.IFNE, code_lbl, 1);
        this.cur_method.load_local("Ljava/lang/String;", mode_slot);
        this.ldc_string("run");
        this.emit_invoke(JOp.INVOKEVIRTUAL, "java/lang/String", "equals", "(Ljava/lang/Object;)Z");
        this.cur_method.branch(JOp.IFEQ, out_lbl, 1);
        this.cur_method.mark(code_lbl);
        this.cur_method.load_local("I", exit_slot);
        this.emit_invoke(JOp.INVOKESTATIC, "java/lang/Integer", "toString", "(I)Ljava/lang/String;");
        this.cur_method.branch(JOp.GOTO, end_lbl, 0);
        this.cur_method.mark(out_lbl);
        // nil mode: forward the captured stdout to ours (native
        // mode-less exec passthrough parity), then yield "".
        this.emit_getstatic_out();
        this.cur_method.load_local("Ljava/lang/String;", out_slot);
        this.emit_invoke(JOp.INVOKEVIRTUAL, "java/io/PrintStream", "print", "(Ljava/lang/String;)V");
        this.ldc_string("");
        this.cur_method.mark(end_lbl);
    }

    // printf(fmt, args...) via String.format (Java Formatter covers the
    // common C specifiers: %d %s %f %x %c %% with 6-digit %f default).
    // Prints exactly (no added newline) and yields the char count, as C.
    pub fnc gen_printf(e Expr) : void {
        if e.args.size < 1 {
            this.jvm_unsupported("printf() needs a format string");
            return;
        }
        ft: string = this.expr_type(e.args.get(0));
        this.gen_expr(e.args.get(0));
        this.jvm_coerce(ft, "string");
        fmt_slot: int = this.cur_method.alloc_local(1);
        this.cur_method.store_local("Ljava/lang/String;", fmt_slot);
        n: int = e.args.size - 1;
        this.iconst(n);
        this.emit_anewarray_object(n);
        arr: int = this.cur_method.alloc_local(1);
        this.cur_method.store_local("X", arr);
        i: int = 0;
        while i < n {
            at: string = this.expr_type(e.args.get(i + 1));
            ad: string = this.jdesc(at);
            if ad.size == 0 {
                this.jvm_unsupported("printf() argument of type '" + at + "'");
                return;
            }
            this.cur_method.load_local("X", arr);
            this.iconst(i);
            this.gen_expr(e.args.get(i + 1));
            if ad[0] == 'L' && at != "string" && at != "*char" && !this.is_bigint(at) {
                // No Formatter mapping (vec/struct/...): Leash text first.
                this.jvm_tostring(at);
            } else {
                this.box_for(at);
            }
            this.cur_method.op(JOp.AASTORE, -3);
            i = i + 1;
        }
        // Locale.ROOT: C printf spells decimals with '.', but the JVM
        // default locale may not (e.g. pt-BR gives ',').
        this.emit_locale_root();
        this.cur_method.load_local("Ljava/lang/String;", fmt_slot);
        this.cur_method.load_local("X", arr);
        this.emit_invoke(JOp.INVOKESTATIC, "java/lang/String", "format", "(Ljava/util/Locale;Ljava/lang/String;[Ljava/lang/Object;)Ljava/lang/String;");
        out: int = this.cur_method.alloc_local(1);
        this.cur_method.store_local("Ljava/lang/String;", out);
        this.emit_getstatic_out();
        this.cur_method.load_local("Ljava/lang/String;", out);
        this.emit_invoke(JOp.INVOKEVIRTUAL, "java/io/PrintStream", "print", "(Ljava/lang/String;)V");
        this.cur_method.load_local("Ljava/lang/String;", out);
        this.emit_invoke(JOp.INVOKEVIRTUAL, "java/lang/String", "length", "()I");
    }

    // ===================== File I/O on the JVM =====================
    // `File` maps to java.io.RandomAccessFile (see jdesc). Statics route
    // through gen_file_static; instance methods through gen_file_method.
    // Stack discipline: every label string is created exactly once and
    // every branch path ends in an explicit GOTO to its merge point.

    pub fnc gen_file_static(e Expr) : void {
        m: string = e.sval;
        if m == "open" {
            pt: string = this.expr_type(e.args.get(0));
            this.gen_expr(e.args.get(0));
            this.jvm_coerce(pt, "string");
            path_slot: int = this.cur_method.alloc_local(1);
            this.cur_method.store_local("Ljava/lang/String;", path_slot);
            mt: string = this.expr_type(e.args.get(1));
            this.gen_expr(e.args.get(1));
            this.jvm_coerce(mt, "string");
            mode_slot: int = this.cur_method.alloc_local(1);
            this.cur_method.store_local("Ljava/lang/String;", mode_slot);
            // c = mode[0] — dispatch on the first character only.
            this.cur_method.load_local("Ljava/lang/String;", mode_slot);
            this.iconst(0);
            this.emit_invoke(JOp.INVOKEVIRTUAL, "java/lang/String", "charAt", "(I)C");
            c_slot: int = this.cur_method.alloc_local(1);
            this.cur_method.store_local("I", c_slot);
            // Labels: create each exactly once.
            r_lbl: string = this.new_label("fo_r");
            r_ok: string = this.new_label("fo_rok");
            a_lbl: string = this.new_label("fo_a");
            w_lbl: string = this.new_label("fo_w");
            null_lbl: string = this.new_label("fo_null");
            end_lbl: string = this.new_label("fo_end");
