// Use case: Voxel sandbox game
// Compile (linux64):   leash compile examples/usecases/minecraft_clone.lsh to out/usecases/minecraft_clone-linux64 --target linux64
// Compile (linux32  ): leash compile examples/usecases/minecraft_clone.lsh to out/usecases/minecraft_clone-linux32 --target linux32
// Compile (linux-arm): leash compile examples/usecases/minecraft_clone.lsh to out/usecases/minecraft_clone-linux-arm --target linux-arm
// Compile (win64    ): leash compile examples/usecases/minecraft_clone.lsh to out/usecases/minecraft_clone-win64 --target win64
// Compile (macos    ): leash compile examples/usecases/minecraft_clone.lsh to out/usecases/minecraft_clone-macos --target macos
// Compile (macos-arm): leash compile examples/usecases/minecraft_clone.lsh to out/usecases/minecraft_clone-macos-arm --target macos-arm
// Compile (jvm      ): leash compile examples/usecases/minecraft_clone.lsh to out/usecases/minecraft_clone-jvm --target jvm
// Run:                  leash run examples/usecases/minecraft_clone.lsh --other-imports installthis
// Optional: --headless or LEASH_VOXEL_HEADLESS=1 forces the offscreen
// renderer; --frames N caps an interactive session after N frames (useful
// for captures and tests).

use utils::math::Math;
use sys::env::Env;
use opengl::opengl::*;

// A first-person voxel sandbox. A real X11/GLX window is opened when a
// display is available: mouse look, WASD movement, jumping, mining and
// placing blocks, a chunked static mesh, directional light, fog, clouds and
// an uncapped FPS counter. Without a display the same renderer runs against
// an offscreen framebuffer and prints a deterministic preview.

def World : struct {
    sx: int;
    sy: int;
    sz: int;
    blocks: vec<int>;
}

def Player : struct {
    x: float;
    y: float;
    z: float;
    vx: float;
    vy: float;
    vz: float;
    yaw: float;
    pitch: float;
    bob: float;
    on_ground: bool;
    hour: float;
    mined: int;
    placed: int;
}

def RayHit : struct {
    hit: bool;
    bx: int;
    by: int;
    bz: int;
    px: int;
    py: int;
    pz: int;
}

fnc clampf(v float, lo float, hi float) : float {
    if v < lo { return lo; }
    if v > hi { return hi; }
    return v;
}

fnc absf(v float) : float {
    if v < 0.0 { return -v; }
    return v;
}

fnc mixf(a float, b float, t float) : float {
    return a + (b - a) * t;
}

fnc chunk_size() : int {
    return 16;
}

fnc chunks_per_side(w World) : int {
    return (w.sx + chunk_size() - 1) / chunk_size();
}

// ---------------------------------------------------------------- world data

fnc make_world(w int, h int, d int) : World {
    b: vec<int>;
    i: int = 0;
    while i < w * h * d {
        b.pushb(0);
        i = i + 1;
    }
    return World { sx: w, sy: h, sz: d, blocks: b };
}

fnc widx(w World, x int, y int, z int) : int {
    return (y * w.sz + z) * w.sx + x;
}

fnc winside(w World, x int, y int, z int) : bool {
    return x >= 0 && x < w.sx && y >= 0 && y < w.sy && z >= 0 && z < w.sz;
}

fnc wget(w World, x int, y int, z int) : int {
    if !winside(w, x, y, z) { return 0; }
    return w.blocks.get(widx(w, x, y, z));
}

fnc wset(w World, x int, y int, z int, v int) : void {
    if winside(w, x, y, z) {
        w.blocks.set(widx(w, x, y, z), v);
    }
}

fnc solid_at(w World, x int, y int, z int) : bool {
    if y < 0 { return true; }
    if x < 0 || x >= w.sx || z < 0 || z >= w.sz { return true; }
    if y >= w.sy { return false; }
    return w.blocks.get(widx(w, x, y, z)) != 0;
}

fnc top_at(w World, x int, z int) : int {
    y: int = w.sy - 1;
    while y >= 0 {
        if wget(w, x, y, z) != 0 { return y; }
        y = y - 1;
    }
    return 0;
}

// ------------------------------------------------------------ terrain noise

fnc hash_int(x int, z int, seed int) : int {
    h: int = x * 374761393 + z * 668265263 + seed * 1442695041;
    h = (h ^ (h >> 13)) * 1274126177;
    h = h ^ (h >> 16);
    return h & 0x7fffffff;
}

fnc noise01(x int, z int, seed int) : float {
    return tofloat(float, hash_int(x, z, seed) % 1024) / 1023.0;
}

fnc smoothstep(t float) : float {
    return t * t * (3.0 - 2.0 * t);
}

fnc value_noise(x float, z float, scale float, seed int) : float {
    fx: float = x / scale;
    fz: float = z / scale;
    ix: int = toint(int, Math.floor(fx));
    iz: int = toint(int, Math.floor(fz));
    tx: float = smoothstep(fx - tofloat(float, ix));
    tz: float = smoothstep(fz - tofloat(float, iz));
    a: float = noise01(ix, iz, seed);
    b: float = noise01(ix + 1, iz, seed);
    c: float = noise01(ix, iz + 1, seed);
    d: float = noise01(ix + 1, iz + 1, seed);
    top: float = a * (1.0 - tx) + b * tx;
    bottom: float = c * (1.0 - tx) + d * tx;
    return top * (1.0 - tz) + bottom * tz;
}

fnc wgenerate(w World) : void {
    // Regeneration (R key) must also clear player-placed blocks.
    clear: int = 0;
    while clear < w.blocks.size {
        w.blocks.set(clear, 0);
        clear = clear + 1;
    }
    x: int = 0;
    z: int = 0;
    while x < w.sx {
        z = 0;
        while z < w.sz {
            fx: float = tofloat(float, x);
            fz: float = tofloat(float, z);
            base: float = 6.0 + value_noise(fx, fz, 16.0, 7) * 8.0
                              + value_noise(fx, fz, 6.0, 23) * 2.0;
            dx: int = x - w.sx / 2;
            dz: int = z - w.sz / 2;
            d2: int = dx * dx + dz * dz;
            if d2 < 25 {
                base = 8.0;
            } also d2 < 81 {
                base = 8.0 + (base - 8.0) * (tofloat(float, d2 - 25) / 56.0);
            }
            h: int = toint(int, base);
            if h < 3 { h = 3; }
            if h > w.sy - 6 { h = w.sy - 6; }

            y: int = 0;
            while y <= h {
                b: int = 3;
                if y == h {
                    if h <= 5 { b = 6; } else { b = 1; }
                } also y >= h - 2 {
                    if h <= 5 { b = 6; } else { b = 2; }
                }
                wset(w, x, y, z, b);
                y = y + 1;
            }
            z = z + 1;
        }
        x = x + 1;
    }

    // Trees are placed after the terrain so leaves are not overwritten.
    x = 3;
    while x < w.sx - 3 {
        z = 3;
        while z < w.sz - 3 {
            dx: int = x - w.sx / 2;
            dz: int = z - w.sz / 2;
            if dx * dx + dz * dz > 90 && hash_int(x, z, 77) % 100 < 4 {
                top: int = top_at(w, x, z);
                if wget(w, x, top, z) == 1 && top + 7 < w.sy {
                    th: int = 4 + hash_int(x, z, 78) % 3;
                    y: int = 1;
                    while y <= th {
                        wset(w, x, top + y, z, 4);
                        y = y + 1;
                    }
                    ly: int = top + th - 2;
                    while ly <= top + th + 1 {
                        lx: int = -2;
                        while lx <= 2 {
                            lz: int = -2;
                            while lz <= 2 {
                                ax: int = lx;
                                az: int = lz;
                                if ax < 0 { ax = -ax; }
                                if az < 0 { az = -az; }
                                if ax + az < 4 || (lx == 0 && lz == 0) {
                                    if wget(w, x + lx, ly, z + lz) == 0 {
                                        wset(w, x + lx, ly, z + lz, 5);
                                    }
                                }
                                lz = lz + 1;
                            }
                            lx = lx + 1;
                        }
                        ly = ly + 1;
                    }
                }
            }
            z = z + 1;
        }
        x = x + 1;
    }
}

// -------------------------------------------------------------- block look

fnc block_name(b int) : string {
    if b == 1 { return "GRASS"; }
    if b == 2 { return "DIRT"; }
    if b == 3 { return "STONE"; }
    if b == 4 { return "WOOD"; }
    if b == 5 { return "LEAVES"; }
    if b == 6 { return "SAND"; }
    if b == 7 { return "PLANKS"; }
    if b == 8 { return "COBBLE"; }
    if b == 9 { return "BRICK"; }
    return "AIR";
}

fnc block_color(b int) : (float, float, float) {
    if b == 1 { return 0.30, 0.66, 0.22; }
    if b == 2 { return 0.50, 0.34, 0.19; }
    if b == 3 { return 0.53, 0.53, 0.56; }
    if b == 4 { return 0.47, 0.30, 0.15; }
    if b == 5 { return 0.18, 0.46, 0.16; }
    if b == 6 { return 0.84, 0.76, 0.50; }
    if b == 7 { return 0.69, 0.46, 0.23; }
    if b == 8 { return 0.42, 0.42, 0.45; }
    if b == 9 { return 0.56, 0.23, 0.18; }
    return 0.5, 0.5, 0.5;
}

fnc face_tint(b int, face int, x int, y int, z int) : (float, float, float) {
    r, g, bl: float, float, float = block_color(b);
    if b == 1 && face != 0 {
        r = 0.50;
        g = 0.34;
        bl = 0.19;
    }
    if b == 4 && (face == 0 || face == 1) {
        r = 0.62;
        g = 0.44;
        bl = 0.23;
    }
    variation: float = tofloat(float, hash_int(x * 7 + z, y, 5) % 100) / 100.0 - 0.5;
    if b == 5 {
        variation = variation * 0.22;
    } else {
        variation = variation * 0.07;
    }
    r = clampf(r + variation, 0.0, 1.0);
    g = clampf(g + variation, 0.0, 1.0);
    bl = clampf(bl + variation, 0.0, 1.0);
    if face == 1 {
        r = r * 0.78;
        g = g * 0.78;
        bl = bl * 0.78;
    } also face == 2 || face == 3 {
        r = r * 0.94;
        g = g * 0.94;
        bl = bl * 0.94;
    } also face == 4 || face == 5 {
        r = r * 0.86;
        g = g * 0.86;
        bl = bl * 0.86;
    }
    return r, g, bl;
}

// --------------------------------------------------------------------- font

fnc glyph_rows(c int) : int<64> {
    if c == 33 { return 0x00100421084; }
    if c == 35 { return 0x00295f57d4a; }
    if c == 37 { return 0x004d6820b59; }
    if c == 39 { return 0x00000002084; }
    if c == 40 { return 0x00088842082; }
    if c == 41 { return 0x00208210888; }
    if c == 42 { return 0x0002aefbaa0; }
    if c == 43 { return 0x000084f9080; }
    if c == 44 { return 0x00208400000; }
    if c == 45 { return 0x000000f8000; }
    if c == 46 { return 0x00108000000; }
    if c == 47 { return 0x00410820841; }
    if c == 48 { return 0x003a39ace2e; }
    if c == 49 { return 0x00388421184; }
    if c == 50 { return 0x007d041062e; }
    if c == 51 { return 0x0078217043e; }
    if c == 52 { return 0x00085f928c2; }
    if c == 53 { return 0x003a210fa1f; }
    if c == 54 { return 0x003a31f4106; }
    if c == 55 { return 0x0021082083f; }
    if c == 56 { return 0x003a317462e; }
    if c == 57 { return 0x0030417c62e; }
    if c == 58 { return 0x00008401080; }
    if c == 60 { return 0x00088882082; }
    if c == 61 { return 0x00001f07c00; }
    if c == 62 { return 0x00208208888; }
    if c == 63 { return 0x0010041062e; }
    if c == 65 { return 0x004631fc62e; }
    if c == 66 { return 0x007a31f463e; }
    if c == 67 { return 0x003a308422e; }
    if c == 68 { return 0x007a318c63e; }
    if c == 69 { return 0x007e10f421f; }
    if c == 70 { return 0x004210f421f; }
    if c == 71 { return 0x003e31bc22e; }
    if c == 72 { return 0x004631fc631; }
    if c == 73 { return 0x0038842108e; }
    if c == 74 { return 0x00324210847; }
    if c == 75 { return 0x004654c5251; }
    if c == 76 { return 0x007e1084210; }
    if c == 77 { return 0x004631ad771; }
    if c == 78 { return 0x0046319d731; }
    if c == 79 { return 0x003a318c62e; }
    if c == 80 { return 0x004210f463e; }
    if c == 81 { return 0x0036558c62e; }
    if c == 82 { return 0x004654f463e; }
    if c == 83 { return 0x0078217420f; }
    if c == 84 { return 0x0010842109f; }
    if c == 85 { return 0x003a318c631; }
    if c == 86 { return 0x0011518c631; }
    if c == 87 { return 0x002ab5ac631; }
    if c == 88 { return 0x00462a22a31; }
    if c == 89 { return 0x00108422a31; }
    if c == 90 { return 0x007e082083f; }
    if c == 91 { return 0x0039084210e; }
    if c == 93 { return 0x0038421084e; }
    if c == 95 { return 0x007c0000000; }
    return 0;
}

fnc text_width(s string, scale int) : int {
    if s.bsize == 0 { return 0; }
    return s.bsize * 6 * scale - scale;
}

fnc text_pixels(x int, y int, s string, scale int) : void {
    if s.bsize == 0 { return; }
    Gl.begin(Gl.quads());
    i: int = 0;
    while i < s.bsize {
        c: int = toint(int, s[i]);
        if c >= 97 && c <= 122 { c = c - 32; }
        rows: int<64> = glyph_rows(c);
        if rows != 0 {
            row: int = 0;
            while row < 7 {
                bits: int = toint(int, (rows >> (row * 5)) & 31);
                col: int = 0;
                while col < 5 {
                    if ((bits >> (4 - col)) & 1) == 1 {
                        px: float = tofloat(float, x + i * 6 * scale + col * scale);
                        py: float = tofloat(float, y + row * scale);
                        ps: float = tofloat(float, scale);
                        Gl.vertex2(px, py);
                        Gl.vertex2(px + ps, py);
                        Gl.vertex2(px + ps, py + ps);
                        Gl.vertex2(px, py + ps);
                    }
                    col = col + 1;
                }
                row = row + 1;
            }
        }
        i = i + 1;
    }
    Gl.end();
}

fnc draw_text(x int, y int, s string, scale int,
              r float, g float, b float) : void {
    Gl.color(0.0, 0.0, 0.0, 0.78);
    text_pixels(x + scale, y + scale, s, scale);
    Gl.color(r, g, b, 1.0);
    text_pixels(x, y, s, scale);
}

fnc fill_rect(x float, y float, w float, h float,
              r float, g float, b float, a float) : void {
    Gl.color(r, g, b, a);
    Gl.begin(Gl.quads());
    Gl.vertex2(x, y);
    Gl.vertex2(x + w, y);
    Gl.vertex2(x + w, y + h);
    Gl.vertex2(x, y + h);
    Gl.end();
}

// ------------------------------------------------------------ static meshes

fnc emit_face(w World, x int, y int, z int, face int, b int) : void {
    r, g, bl: float, float, float = face_tint(b, face, x, y, z);
    Gl.color(r, g, bl, 1.0);
    if face == 0 { Gl.normal3(0.0, 1.0, 0.0); }
    also face == 1 { Gl.normal3(0.0, -1.0, 0.0); }
    also face == 2 { Gl.normal3(1.0, 0.0, 0.0); }
    also face == 3 { Gl.normal3(-1.0, 0.0, 0.0); }
    also face == 4 { Gl.normal3(0.0, 0.0, 1.0); }
    else { Gl.normal3(0.0, 0.0, -1.0); }

    x0: float = tofloat(float, x);
    y0: float = tofloat(float, y);
    z0: float = tofloat(float, z);
    x1: float = x0 + 1.0;
    y1: float = y0 + 1.0;
    z1: float = z0 + 1.0;
    Gl.begin(Gl.quads());
    if face == 0 {
        Gl.vertex3(x0, y1, z0);
        Gl.vertex3(x0, y1, z1);
        Gl.vertex3(x1, y1, z1);
        Gl.vertex3(x1, y1, z0);
    } also face == 1 {
        Gl.vertex3(x0, y0, z1);
        Gl.vertex3(x0, y0, z0);
        Gl.vertex3(x1, y0, z0);
        Gl.vertex3(x1, y0, z1);
    } also face == 2 {
        Gl.vertex3(x1, y0, z1);
        Gl.vertex3(x1, y0, z0);
        Gl.vertex3(x1, y1, z0);
        Gl.vertex3(x1, y1, z1);
    } also face == 3 {
        Gl.vertex3(x0, y0, z0);
        Gl.vertex3(x0, y0, z1);
        Gl.vertex3(x0, y1, z1);
        Gl.vertex3(x0, y1, z0);
    } also face == 4 {
        Gl.vertex3(x0, y0, z1);
        Gl.vertex3(x1, y0, z1);
        Gl.vertex3(x1, y1, z1);
        Gl.vertex3(x0, y1, z1);
    } else {
        Gl.vertex3(x1, y0, z0);
        Gl.vertex3(x0, y0, z0);
        Gl.vertex3(x0, y1, z0);
        Gl.vertex3(x1, y1, z0);
    }
    Gl.end();
}

fnc build_chunk(w World, cx int, cz int) : (int, int) {
    id: int = Gl.new_list();
    faces: int = 0;
    x0: int = cx * chunk_size();
    z0: int = cz * chunk_size();
    x1: int = x0 + chunk_size();
    z1: int = z0 + chunk_size();
    if x1 > w.sx { x1 = w.sx; }
    if z1 > w.sz { z1 = w.sz; }

    x: int = x0;
    while x < x1 {
        z: int = z0;
        while z < z1 {
            y: int = 0;
            while y < w.sy {
                b: int = wget(w, x, y, z);
                if b != 0 {
                    if wget(w, x, y + 1, z) == 0 {
                        emit_face(w, x, y, z, 0, b);
                        faces = faces + 1;
                    }
                    if y > 0 && wget(w, x, y - 1, z) == 0 {
                        emit_face(w, x, y, z, 1, b);
                        faces = faces + 1;
                    }
                    if wget(w, x + 1, y, z) == 0 {
                        emit_face(w, x, y, z, 2, b);
                        faces = faces + 1;
                    }
                    if wget(w, x - 1, y, z) == 0 {
                        emit_face(w, x, y, z, 3, b);
                        faces = faces + 1;
                    }
                    if wget(w, x, y, z + 1) == 0 {
                        emit_face(w, x, y, z, 4, b);
                        faces = faces + 1;
                    }
                    if wget(w, x, y, z - 1) == 0 {
                        emit_face(w, x, y, z, 5, b);
                        faces = faces + 1;
                    }
                }
                y = y + 1;
            }
            z = z + 1;
        }
        x = x + 1;
    }
    if id != 0 { Gl.end_list(); }
    return id, faces;
}

fnc build_all(w World, ids vec<int>, counts vec<int>) : int {
    cps: int = chunks_per_side(w);
    i: int = 0;
    total: int = 0;
    while i < cps * cps {
        old: int = ids.get(i);
        if old != 0 { Gl.delete_list(old); }
        cx: int = i % cps;
        cz: int = i / cps;
        id, faces: int, int = build_chunk(w, cx, cz);
        ids.set(i, id);
        counts.set(i, faces);
        total = total + faces;
        i = i + 1;
    }
    return total;
}

fnc sum_counts(counts vec<int>) : int {
    total: int = 0;
    i: int = 0;
    while i < counts.size {
        total = total + counts.get(i);
        i = i + 1;
    }
    return total;
}

fnc rebuild_at(w World, ids vec<int>, counts vec<int>, cx int, cz int) : void {
    cps: int = chunks_per_side(w);
    if cx < 0 || cz < 0 || cx >= cps || cz >= cps { return; }
    idx: int = cz * cps + cx;
    old: int = ids.get(idx);
    if old != 0 { Gl.delete_list(old); }
    id, faces: int, int = build_chunk(w, cx, cz);
    ids.set(idx, id);
    counts.set(idx, faces);
}

fnc rebuild_block(w World, ids vec<int>, counts vec<int>,
                  bx int, by int, bz int) : void {
    cx: int = bx / chunk_size();
    cz: int = bz / chunk_size();
    rebuild_at(w, ids, counts, cx, cz);
    if bx % chunk_size() == 0 { rebuild_at(w, ids, counts, cx - 1, cz); }
    if bx % chunk_size() == chunk_size() - 1 {
        rebuild_at(w, ids, counts, cx + 1, cz);
    }
    if bz % chunk_size() == 0 { rebuild_at(w, ids, counts, cx, cz - 1); }
    if bz % chunk_size() == chunk_size() - 1 {
        rebuild_at(w, ids, counts, cx, cz + 1);
    }
}

fnc build_clouds(w World) : int {
    id: int = Gl.new_list();
    if id == 0 { return 0; }
    i: int = 0;
    while i < 90 {
        hx: int = hash_int(i, 3, 41) % w.sx;
        hz: int = hash_int(i, 9, 42) % w.sz;
        cw: int = 3 + hash_int(i, 5, 43) % 6;
        cd: int = 3 + hash_int(i, 7, 44) % 6;
        cy: float = 30.0 + tofloat(float, hash_int(i, 11, 45) % 3);
        x0: float = tofloat(float, hx);
        z0: float = tofloat(float, hz);
        x1: float = x0 + tofloat(float, cw);
        z1: float = z0 + tofloat(float, cd);
        Gl.begin(Gl.quads());
        Gl.vertex3(x0, cy, z0);
        Gl.vertex3(x0, cy, z1);
        Gl.vertex3(x1, cy, z1);
        Gl.vertex3(x1, cy, z0);
        Gl.end();
        i = i + 1;
    }
    Gl.end_list();
    return id;
}

// ------------------------------------------------------------------- player

fnc spawn_player(w World, p &Player) : void {
    cx: int = w.sx / 2;
    cz: int = w.sz / 2;
    top: int = top_at(w, cx, cz);
    p.x = tofloat(float, cx) + 0.5;
    p.z = tofloat(float, cz) + 0.5;
    p.y = tofloat(float, top + 1);
    p.vx = 0.0;
    p.vy = 0.0;
    p.vz = 0.0;
    p.yaw = 0.72;
    p.pitch = -0.16;
    p.bob = 0.0;
    p.on_ground = true;
    p.hour = 8.0;
    p.mined = 0;
    p.placed = 0;
}

fnc new_player(w World) : Player {
    p: Player = Player { x: 0.0, y: 0.0, z: 0.0,
                         vx: 0.0, vy: 0.0, vz: 0.0,
                         yaw: 0.0, pitch: 0.0, bob: 0.0,
                         on_ground: false, hour: 8.0, mined: 0, placed: 0 };
    spawn_player(w, p);
    return p;
}

fnc collides(w World, px float, py float, pz float) : bool {
    radius: float = 0.30;
    height: float = 1.80;
    x0: int = toint(int, Math.floor(px - radius));
    x1: int = toint(int, Math.floor(px + radius));
    y0: int = toint(int, Math.floor(py));
    y1: int = toint(int, Math.floor(py + height));
    z0: int = toint(int, Math.floor(pz - radius));
    z1: int = toint(int, Math.floor(pz + radius));
    if x0 < 0 || z0 < 0 || x1 >= w.sx || z1 >= w.sz || y0 < 0 {
        return true;
    }
    y: int = y0;
    while y <= y1 && y < w.sy {
        x: int = x0;
        while x <= x1 {
            z: int = z0;
            while z <= z1 {
                if wget(w, x, y, z) != 0 { return true; }
                z = z + 1;
            }
            x = x + 1;
        }
        y = y + 1;
    }
    return false;
}

fnc move_player(w World, p &Player, dt float) : void {
    speed: float = 4.4;
    if Gl.key_down(Gl.key_shift()) { speed = 7.2; }

    fx: float = Math.sin(p.yaw);
    fz: float = -Math.cos(p.yaw);
    rx: float = Math.cos(p.yaw);
    rz: float = Math.sin(p.yaw);
    wx: float = 0.0;
    wz: float = 0.0;
    if Gl.key_down(Gl.key_w()) { wx = wx + fx; wz = wz + fz; }
    if Gl.key_down(Gl.key_s()) { wx = wx - fx; wz = wz - fz; }
    if Gl.key_down(Gl.key_d()) { wx = wx + rx; wz = wz + rz; }
    if Gl.key_down(Gl.key_a()) { wx = wx - rx; wz = wz - rz; }
    length: float = Math.sqrt(wx * wx + wz * wz);
    if length > 0.001 {
        wx = wx / length;
        wz = wz / length;
        p.bob = p.bob + dt * speed * 1.8;
    }
    accel: float = dt * 12.0;
    if accel > 1.0 { accel = 1.0; }
    p.vx = p.vx + (wx * speed - p.vx) * accel;
    p.vz = p.vz + (wz * speed - p.vz) * accel;

    p.vy = p.vy - 25.0 * dt;
    if p.on_ground && Gl.key_down(Gl.key_space()) {
        p.vy = 8.4;
        p.on_ground = false;
    }

    step: float = p.vx * dt;
    p.x = p.x + step;
    if collides(w, p.x, p.y, p.z) {
        p.x = p.x - step;
        if p.on_ground && !collides(w, p.x + step, p.y + 1.0, p.z) {
            p.y = p.y + 1.0;
            p.x = p.x + step;
        } else {
            p.vx = 0.0;
        }
    }
    step = p.vz * dt;
    p.z = p.z + step;
    if collides(w, p.x, p.y, p.z) {
        p.z = p.z - step;
        if p.on_ground && !collides(w, p.x, p.y + 1.0, p.z + step) {
            p.y = p.y + 1.0;
            p.z = p.z + step;
        } else {
            p.vz = 0.0;
        }
    }

    p.on_ground = false;
    step = p.vy * dt;
    p.y = p.y + step;
    if collides(w, p.x, p.y, p.z) {
        p.y = p.y - step;
        if p.vy < 0.0 { p.on_ground = true; }
        p.vy = 0.0;
    }
    if p.y < -4.0 {
        spawn_player(w, p);
    }
}

fnc look_x(p &Player) : float {
    return Math.sin(p.yaw) * Math.cos(p.pitch);
}

fnc look_y(p &Player) : float {
    return Math.sin(p.pitch);
}

fnc look_z(p &Player) : float {
    return -Math.cos(p.yaw) * Math.cos(p.pitch);
}

fnc raycast(w World, ox float, oy float, oz float,
            dx float, dy float, dz float, maxd float) : RayHit {
    t: float = 0.0;
    lastx: int = toint(int, Math.floor(ox));
    lasty: int = toint(int, Math.floor(oy));
    lastz: int = toint(int, Math.floor(oz));
    while t <= maxd {
        bx: int = toint(int, Math.floor(ox + dx * t));
        by: int = toint(int, Math.floor(oy + dy * t));
        bz: int = toint(int, Math.floor(oz + dz * t));
        if wget(w, bx, by, bz) != 0 {
            return RayHit { hit: true, bx: bx, by: by, bz: bz,
                            px: lastx, py: lasty, pz: lastz };
        }
        lastx = bx;
        lasty = by;
        lastz = bz;
        t = t + 0.02;
    }
    return RayHit { hit: false, bx: 0, by: 0, bz: 0,
                    px: 0, py: 0, pz: 0 };
}

fnc block_hits_player(p &Player, x int, y int, z int) : bool {
    return p.x + 0.30 > tofloat(float, x)
        && p.x - 0.30 < tofloat(float, x + 1)
        && p.z + 0.30 > tofloat(float, z)
        && p.z - 0.30 < tofloat(float, z + 1)
        && p.y + 1.80 > tofloat(float, y)
        && p.y < tofloat(float, y + 1);
}

fnc mine_block(w World, ids vec<int>, counts vec<int>,
               p &Player, inv vec<int>) : void {
    ex: float = p.x;
    ey: float = p.y + 1.62;
    ez: float = p.z;
    h: RayHit = raycast(w, ex, ey, ez, look_x(p), look_y(p), look_z(p), 5.5);
    if !h.hit { return; }
    b: int = wget(w, h.bx, h.by, h.bz);
    if b == 0 { return; }
    wset(w, h.bx, h.by, h.bz, 0);
    inv.set(b, inv.get(b) + 1);
    p.mined = p.mined + 1;
    rebuild_block(w, ids, counts, h.bx, h.by, h.bz);
}

fnc place_block(w World, ids vec<int>, counts vec<int>,
                p &Player, inv vec<int>, sel int) : void {
    if sel < 1 || sel > 9 { return; }
    if inv.get(sel) <= 0 { return; }
    ex: float = p.x;
    ey: float = p.y + 1.62;
    ez: float = p.z;
    h: RayHit = raycast(w, ex, ey, ez, look_x(p), look_y(p), look_z(p), 5.5);
    if !h.hit { return; }
    tx: int = h.px;
    ty: int = h.py;
    tz: int = h.pz;
    if !winside(w, tx, ty, tz) { return; }
    if wget(w, tx, ty, tz) != 0 { return; }
    if block_hits_player(p, tx, ty, tz) { return; }
    wset(w, tx, ty, tz, sel);
    inv.set(sel, inv.get(sel) - 1);
    p.placed = p.placed + 1;
    rebuild_block(w, ids, counts, tx, ty, tz);
}

// ------------------------------------------------------------------- sky/fx

fnc sun_angle(hour float) : float {
    return (hour - 6.0) / 12.0 * 3.14159265;
}

fnc day_amount(raw_y float) : float {
    return clampf(raw_y * 1.6 + 0.10, 0.0, 1.0);
}

fnc dusk_amount(raw_y float) : float {
    d: float = clampf(1.0 - absf(raw_y) * 5.0, 0.0, 1.0);
    if raw_y < -0.05 { d = 0.0; }
    return d;
}

fnc project_dir(dx float, dy float, dz float, yaw float, pitch float,
                aspect float) : (bool, float, float) {
    cp: float = Math.cos(pitch);
    sp: float = Math.sin(pitch);
    fx: float = Math.sin(yaw) * cp;
    fy: float = sp;
    fz: float = -Math.cos(yaw) * cp;
    rx: float = Math.cos(yaw);
    rz: float = Math.sin(yaw);
    ux: float = -Math.sin(yaw) * sp;
    uy: float = cp;
    uz: float = Math.cos(yaw) * sp;
    denom: float = dx * fx + dy * fy + dz * fz;
    if denom < 0.08 { return false, 0.0, 0.0; }
    sx: float = (dx * rx + dz * rz) / denom;
    sy: float = (dx * ux + dy * uy + dz * uz) / denom;
    nx: float = sx / (0.7002 * aspect);
    ny: float = sy / 0.7002;
    return true, nx, ny;
}

fnc draw_stars(yaw float, pitch float, aspect float, night float) : void {
    if night < 0.05 { return; }
    Gl.enable(Gl.blend_cap());
    Gl.disable(Gl.depth_test());
    Gl.begin(Gl.quads());
    i: int = 0;
    while i < 150 {
        a: float = tofloat(float, i) * 2.399963;
        e: float = tofloat(float, (i * 53 + 17) % 2000) / 1000.0 - 1.0;
        ce: float = Math.sqrt(1.0 - e * e);
        dx: float = Math.cos(a) * ce;
        dy: float = e;
        dz: float = Math.sin(a) * ce;
        visible, nx, ny: bool, float, float =
            project_dir(dx, dy, dz, yaw, pitch, aspect);
        if visible && absf(nx) < 1.0 && absf(ny) < 1.0 {
            size: float = 0.0025 + tofloat(float, i % 3) * 0.0015;
            alpha: float = night * (0.35 + tofloat(float, i % 4) * 0.14);
            Gl.color(0.92, 0.96, 1.0, alpha);
            Gl.vertex2(nx - size / aspect, ny - size);
            Gl.vertex2(nx + size / aspect, ny - size);
            Gl.vertex2(nx + size / aspect, ny + size);
            Gl.vertex2(nx - size / aspect, ny + size);
        }
        i = i + 1;
    }
    Gl.end();
    Gl.disable(Gl.blend_cap());
}

fnc draw_celestial(yaw float, pitch float, aspect float,
                   dx float, dy float, dz float,
                   r float, g float, b float, strength float) : void {
    if strength <= 0.02 { return; }
    visible, nx, ny: bool, float, float =
        project_dir(dx, dy, dz, yaw, pitch, aspect);
    if !visible { return; }
    if absf(nx) > 1.35 || absf(ny) > 1.35 { return; }
    Gl.enable(Gl.blend_cap());
    Gl.disable(Gl.depth_test());
    Gl.color(r, g, b, 0.10 * strength);
    Gl.begin(Gl.quads());
    Gl.vertex2(nx - 0.60 / aspect, ny - 0.60);
    Gl.vertex2(nx + 0.60 / aspect, ny - 0.60);
    Gl.vertex2(nx + 0.60 / aspect, ny + 0.60);
    Gl.vertex2(nx - 0.60 / aspect, ny + 0.60);
    Gl.end();
    Gl.color(r, g, b, 0.30 * strength);
    Gl.begin(Gl.quads());
    Gl.vertex2(nx - 0.26 / aspect, ny - 0.26);
    Gl.vertex2(nx + 0.26 / aspect, ny - 0.26);
    Gl.vertex2(nx + 0.26 / aspect, ny + 0.26);
    Gl.vertex2(nx - 0.26 / aspect, ny + 0.26);
    Gl.end();
    Gl.color(r, g, b, 0.95 * strength);
    Gl.begin(Gl.quads());
    Gl.vertex2(nx - 0.105 / aspect, ny - 0.105);
    Gl.vertex2(nx + 0.105 / aspect, ny - 0.105);
    Gl.vertex2(nx + 0.105 / aspect, ny + 0.105);
    Gl.vertex2(nx - 0.105 / aspect, ny + 0.105);
    Gl.end();
    Gl.disable(Gl.blend_cap());
}

fnc draw_sky(yaw float, pitch float, aspect float, day float, dusk float,
             zr float, zg float, zb float,
             hr float, hg float, hb float) : void {
    Gl.disable(Gl.depth_test());
    Gl.disable(Gl.fog_cap());
    Gl.disable(Gl.lighting_cap());
    Gl.disable(Gl.blend_cap());
    Gl.matrix(Gl.projection());
    Gl.identity();
    Gl.matrix(Gl.modelview());
    Gl.identity();
    Gl.shade_smooth();

    horizon_y: float = -Math.tan(pitch) / 0.7002;
    if horizon_y > 1.2 { horizon_y = 1.2; }
    if horizon_y < -1.2 { horizon_y = -1.2; }

    Gl.begin(Gl.quads());
    Gl.color(zr, zg, zb, 1.0);
    Gl.vertex2(-1.0, 1.0);
    Gl.vertex2(1.0, 1.0);
    Gl.color(hr, hg, hb, 1.0);
    Gl.vertex2(1.0, horizon_y);
    Gl.vertex2(-1.0, horizon_y);
    Gl.end();

    gr: float = hr * 0.55;
    gg: float = hg * 0.55;
    gb: float = hb * 0.55;
    Gl.begin(Gl.quads());
    Gl.color(hr, hg, hb, 1.0);
    Gl.vertex2(-1.0, horizon_y);
    Gl.vertex2(1.0, horizon_y);
    Gl.color(gr, gg, gb, 1.0);
    Gl.vertex2(1.0, -1.0);
    Gl.vertex2(-1.0, -1.0);
    Gl.end();

    Gl.shade_flat();
    draw_stars(yaw, pitch, aspect, 1.0 - day);
}

fnc draw_sun_moon(yaw float, pitch float, aspect float,
                  sx float, sy float, sz float, day float) : void {
    if sy > -0.03 {
        draw_celestial(yaw, pitch, aspect, sx, sy, sz,
                       1.0, 0.82, 0.42, clampf(day + 0.15, 0.0, 1.0));
    }
    if sy < 0.03 {
        draw_celestial(yaw, pitch, aspect, -sx, -sy, -sz,
                       0.72, 0.80, 0.95, clampf(-sy * 3.0, 0.0, 1.0));
    }
}

fnc draw_clouds(id int, day float) : void {
    if id == 0 { return; }
    Gl.disable(Gl.lighting_cap());
    Gl.disable(Gl.fog_cap());
    Gl.enable(Gl.blend_cap());
    Gl.depth_mask(false);
    cr: float = mixf(0.10, 0.94, day);
    cg: float = mixf(0.12, 0.97, day);
    cb: float = mixf(0.20, 1.00, day);
    Gl.color(cr, cg, cb, 0.08 + day * 0.34);
    Gl.call_list(id);
    Gl.depth_mask(true);
    Gl.disable(Gl.blend_cap());
}

fnc draw_highlight(h RayHit, day float) : void {
    if !h.hit { return; }
    x0: float = tofloat(float, h.bx) - 0.003;
    y0: float = tofloat(float, h.by) - 0.003;
    z0: float = tofloat(float, h.bz) - 0.003;
    x1: float = tofloat(float, h.bx + 1) + 0.003;
    y1: float = tofloat(float, h.by + 1) + 0.003;
    z1: float = tofloat(float, h.bz + 1) + 0.003;
    Gl.disable(Gl.lighting_cap());
    Gl.disable(Gl.fog_cap());
    Gl.line_width(2.0);
    if day > 0.45 { Gl.color(0.02, 0.02, 0.02, 0.9); }
    else { Gl.color(1.0, 1.0, 0.92, 0.9); }
    Gl.begin(Gl.lines());
    Gl.vertex3(x0, y0, z0); Gl.vertex3(x1, y0, z0);
    Gl.vertex3(x1, y0, z0); Gl.vertex3(x1, y0, z1);
    Gl.vertex3(x1, y0, z1); Gl.vertex3(x0, y0, z1);
    Gl.vertex3(x0, y0, z1); Gl.vertex3(x0, y0, z0);
    Gl.vertex3(x0, y1, z0); Gl.vertex3(x1, y1, z0);
    Gl.vertex3(x1, y1, z0); Gl.vertex3(x1, y1, z1);
    Gl.vertex3(x1, y1, z1); Gl.vertex3(x0, y1, z1);
    Gl.vertex3(x0, y1, z1); Gl.vertex3(x0, y1, z0);
    Gl.vertex3(x0, y0, z0); Gl.vertex3(x0, y1, z0);
    Gl.vertex3(x1, y0, z0); Gl.vertex3(x1, y1, z0);
    Gl.vertex3(x1, y0, z1); Gl.vertex3(x1, y1, z1);
    Gl.vertex3(x0, y0, z1); Gl.vertex3(x0, y1, z1);
    Gl.end();
    Gl.line_width(1.0);
}

// ---------------------------------------------------------------------- HUD

fnc pad2(n int) : string {
    if n < 10 { return "0" + tostring(n); }
    return tostring(n);
}

fnc draw_block_icon(cx float, cy float, size float, b int, lit bool) : void {
    r, g, bl: float, float, float = block_color(b);
    dim: float = 1.0;
    alpha: float = 1.0;
    if !lit {
        dim = 0.42;
        alpha = 0.55;
    }
    top: float = size * 0.52;
    side: float = size * 0.50;
    Gl.color(r * 1.18 * dim, g * 1.18 * dim, bl * 1.18 * dim, alpha);
    Gl.begin(Gl.quads());
    Gl.vertex2(cx, cy - top);
    Gl.vertex2(cx + top, cy);
    Gl.vertex2(cx, cy + top);
    Gl.vertex2(cx - top, cy);
    Gl.end();
    Gl.color(r * 0.66 * dim, g * 0.66 * dim, bl * 0.66 * dim, alpha);
    Gl.begin(Gl.quads());
    Gl.vertex2(cx - top, cy);
    Gl.vertex2(cx, cy + top);
    Gl.vertex2(cx, cy + top + side);
    Gl.vertex2(cx - top, cy + side);
    Gl.end();
    Gl.color(r * 0.84 * dim, g * 0.84 * dim, bl * 0.84 * dim, alpha);
    Gl.begin(Gl.quads());
    Gl.vertex2(cx + top, cy);
    Gl.vertex2(cx, cy + top);
    Gl.vertex2(cx, cy + top + side);
    Gl.vertex2(cx + top, cy + side);
    Gl.end();
}

fnc draw_crosshair(w int, h int) : void {
    cx: float = tofloat(float, w) / 2.0;
    cy: float = tofloat(float, h) / 2.0;
    fill_rect(cx - 11.0, cy - 1.0, 8.0, 2.0, 0.0, 0.0, 0.0, 0.75);
    fill_rect(cx + 3.0, cy - 1.0, 8.0, 2.0, 0.0, 0.0, 0.0, 0.75);
    fill_rect(cx - 1.0, cy - 11.0, 2.0, 8.0, 0.0, 0.0, 0.0, 0.75);
    fill_rect(cx - 1.0, cy + 3.0, 2.0, 8.0, 0.0, 0.0, 0.0, 0.75);
    fill_rect(cx - 9.0, cy - 1.0, 6.0, 2.0, 1.0, 1.0, 1.0, 0.95);
    fill_rect(cx + 3.0, cy - 1.0, 6.0, 2.0, 1.0, 1.0, 1.0, 0.95);
    fill_rect(cx - 1.0, cy - 9.0, 2.0, 6.0, 1.0, 1.0, 1.0, 0.95);
    fill_rect(cx - 1.0, cy + 3.0, 2.0, 6.0, 1.0, 1.0, 1.0, 0.95);
}

fnc draw_hud(vw int, vh int, p Player, sel int, inv vec<int>,
             fps int, frame_ms int, faces int, captured bool,
             show_help bool) : void {
    Gl.disable(Gl.depth_test());
    Gl.disable(Gl.lighting_cap());
    Gl.disable(Gl.fog_cap());
    Gl.enable(Gl.blend_cap());
    Gl.matrix(Gl.projection());
    Gl.identity();
    Gl.matrix(Gl.modelview());
    Gl.identity();
    Gl.ortho(0.0, tofloat(float, vw), tofloat(float, vh), 0.0, -1.0, 1.0);

    draw_crosshair(vw, vh);

    // FPS and frame time, measured with VSync disabled.
    draw_text(14, 12, "FPS " + tostring(fps), 2, 1.0, 0.94, 0.72);
    draw_text(14, 32, tostring(frame_ms) + " MS", 1, 0.78, 0.82, 0.90);
    draw_text(14, 46, "FACES " + tostring(faces), 1, 0.62, 0.66, 0.74);

    // Position and game time, top right.
    px: int = toint(int, p.x);
    py: int = toint(int, p.y);
    pz: int = toint(int, p.z);
    pos: string = "X " + tostring(px) + "  Y " + tostring(py) + "  Z " + tostring(pz);
    pw: int = text_width(pos, 1);
    draw_text(vw - pw - 14, 12, pos, 1, 0.78, 0.84, 0.92);
    hour_i: int = toint(int, p.hour);
    minute_i: int = toint(int, (p.hour - tofloat(float, hour_i)) * 60.0);
    clock: string = pad2(hour_i) + ":" + pad2(minute_i);
    cw: int = text_width(clock, 2);
    draw_text(vw - cw - 14, 28, clock, 2, 1.0, 0.90, 0.62);
    phase: string = "NIGHT";
    if p.hour >= 6.0 && p.hour < 18.0 { phase = "DAY"; }
    also p.hour >= 5.0 && p.hour < 20.0 { phase = "DUSK"; }
    pw2: int = text_width(phase, 1);
    draw_text(vw - pw2 - 14, 52, phase, 1, 0.64, 0.72, 0.86);

    // Hotbar.
    slot: float = 44.0;
    gap: float = 4.0;
    total: float = 9.0 * slot + 8.0 * gap;
    x0: float = tofloat(float, vw) / 2.0 - total / 2.0;
    y0: float = tofloat(float, vh) - 58.0;
    fill_rect(x0 - 8.0, y0 - 8.0, total + 16.0, slot + 16.0,
              0.02, 0.025, 0.04, 0.74);
    i: int = 0;
    while i < 9 {
        bid: int = i + 1;
        x: float = x0 + tofloat(float, i) * (slot + gap);
        selected: bool = bid == sel;
        if selected {
            fill_rect(x - 2.0, y0 - 2.0, slot + 4.0, slot + 4.0,
                      1.0, 0.78, 0.26, 0.95);
        }
        fill_rect(x, y0, slot, slot, 0.09, 0.11, 0.15, 0.90);
        count: int = inv.get(bid);
        draw_block_icon(x + slot / 2.0, y0 + slot / 2.0 - 3.0, 14.0, bid, count > 0);
        draw_text(toint(int, x + 3.0), toint(int, y0 + 2.0),
                  tostring(bid), 1, 0.62, 0.66, 0.74);
        cs: string = tostring(count);
        cw2: int = text_width(cs, 1);
        draw_text(toint(int, x + slot - 4.0 - tofloat(float, cw2)),
                  toint(int, y0 + slot - 10.0), cs, 1,
                  0.95, 0.95, 0.95);
        i = i + 1;
    }

    name: string = block_name(sel);
    nw: int = text_width(name, 2);
    draw_text(vw / 2 - nw / 2, toint(int, y0 - 28.0), name, 2,
              1.0, 0.90, 0.66);

    if show_help {
        draw_text(14, vh - 88, "WASD MOVE   SHIFT SPRINT   SPACE JUMP", 1,
                  0.82, 0.86, 0.94);
        draw_text(14, vh - 74, "LMB MINE   RMB PLACE   1-9 SELECT", 1,
                  0.82, 0.86, 0.94);
        draw_text(14, vh - 60, "R RESET   ESC QUIT", 1, 0.82, 0.86, 0.94);
    }

    if !captured {
        fill_rect(0.0, 0.0, tofloat(float, vw), tofloat(float, vh),
                  0.01, 0.015, 0.03, 0.45);
        click: string = "CLICK TO PLAY";
        ckw: int = text_width(click, 3);
        draw_text(vw / 2 - ckw / 2, vh / 2 - 42, click, 3,
                  1.0, 0.92, 0.68);
        sub: string = "MOUSE LOOK  /  BUILD";
        sw: int = text_width(sub, 1);
        draw_text(vw / 2 - sw / 2, vh / 2 + 4, sub, 1, 0.82, 0.86, 0.94);
    }
    Gl.disable(Gl.blend_cap());
}

// ------------------------------------------------------------------ render

fnc draw_world_lists(w World, ids vec<int>, counts vec<int>,
                     ex float, ey float, ez float,
                     fx float, fy float, fz float) : int {
    cps: int = chunks_per_side(w);
    i: int = 0;
    drawn: int = 0;
    while i < ids.size {
        cx: int = i % cps;
        cz: int = i / cps;
        ccx: float = tofloat(float, cx * chunk_size() + chunk_size() / 2);
        ccz: float = tofloat(float, cz * chunk_size() + chunk_size() / 2);
        ccy: float = tofloat(float, w.sy / 2);
        dx: float = ccx - ex;
        dy: float = ccy - ey;
        dz: float = ccz - ez;
        dist2: float = dx * dx + dy * dy + dz * dz;
        if dist2 < 82.0 * 82.0 {
            if dx * fx + dy * fy + dz * fz > -22.0 {
                Gl.call_list(ids.get(i));
                drawn = drawn + 1;
            }
        }
        i = i + 1;
    }
    return drawn;
}

fnc draw_frame(w World, ids vec<int>, counts vec<int>, p Player,
               sel int, inv vec<int>, fps int, frame_ms int,
               vw int, vh int, hud bool, captured bool,
               show_help bool, clouds int) : int {
    if vw < 8 { vw = 8; }
    if vh < 8 { vh = 8; }
    Gl.viewport(vw, vh);
    aspect: float = tofloat(float, vw) / tofloat(float, vh);

    ang: float = sun_angle(p.hour);
    raw_y: float = Math.sin(ang);
    day: float = day_amount(raw_y);
    dusk: float = dusk_amount(raw_y);

    sx: float = Math.cos(ang);
    sy: float = raw_y;
    sz: float = 0.32;
    slen: float = Math.sqrt(sx * sx + sy * sy + sz * sz);
    sx = sx / slen;
    sy = sy / slen;
    sz = sz / slen;

    zr: float = clampf(mixf(0.015, 0.17, day) + dusk * 0.10, 0.0, 1.0);
    zg: float = clampf(mixf(0.020, 0.42, day) + dusk * 0.05, 0.0, 1.0);
    zb: float = clampf(mixf(0.080, 0.86, day), 0.0, 1.0);
    hr: float = clampf(mixf(0.040, 0.63, day) + dusk * 0.55, 0.0, 1.0);
    hg: float = clampf(mixf(0.050, 0.80, day) + dusk * 0.20, 0.0, 1.0);
    hb: float = clampf(mixf(0.120, 0.98, day) + dusk * 0.02, 0.0, 1.0);

    Gl.clear_color(hr, hg, hb, 1.0);
    Gl.clear();
    draw_sky(p.yaw, p.pitch, aspect, day, dusk, zr, zg, zb, hr, hg, hb);
    draw_sun_moon(p.yaw, p.pitch, aspect, sx, sy, sz, day);

    Gl.enable(Gl.depth_test());
    Gl.depth_func(Gl.lequal());
    Gl.depth_mask(true);
    Gl.disable(Gl.blend_cap());
    Gl.lighting(true);
    Gl.light_ambient(mixf(0.26, 0.48, day),
                     mixf(0.28, 0.50, day),
                     mixf(0.36, 0.58, day), 1.0);
    lx: float = sx;
    ly: float = sy;
    lz: float = sz;
    if ly < 0.0 {
        lx = -lx;
        ly = -ly;
        lz = -lz;
    }
    Gl.light_directional(lx, ly, lz,
                         mixf(0.10, 0.78, day),
                         mixf(0.12, 0.75, day),
                         mixf(0.22, 0.68, day));

    Gl.matrix(Gl.projection());
    Gl.identity();
    near: float = 0.08;
    far: float = 180.0;
    half: float = near * 0.7002;
    Gl.frustum(-half * aspect, half * aspect, -half, half, near, far);
    Gl.matrix(Gl.modelview());
    Gl.identity();
    Gl.rotate(-p.pitch * 57.29578, 1.0, 0.0, 0.0);
    Gl.rotate(p.yaw * 57.29578, 0.0, 1.0, 0.0);
    ex: float = p.x;
    ey: float = p.y + 1.62 + Math.sin(p.bob) * 0.035;
    ez: float = p.z;
    Gl.translate(-ex, -ey, -ez);
    Gl.fog(26.0, 70.0, hr * 0.92, hg * 0.92, hb * 0.94);

    fx: float = look_x(p);
    fy: float = look_y(p);
    fz: float = look_z(p);
    draw_world_lists(w, ids, counts, ex, ey, ez, fx, fy, fz);

    draw_highlight(raycast(w, ex, ey, ez, fx, fy, fz, 5.5), day);
    draw_clouds(clouds, day);

    if hud {
        draw_hud(vw, vh, p, sel, inv, fps, frame_ms, sum_counts(counts),
                 captured, show_help);
    }
    return sum_counts(counts);
}

// --------------------------------------------------------------- headless

fnc preview_gl() : void {
    out: string = "";
    row: int = 0;
    while row < 8 {
        col: int = 0;
        while col < 16 {
            // The framebuffer origin is bottom-left; sample a grid over the
            // whole frame instead of a strip along the lower edge.
            px: int = Gl.pixel(2 + col * 4, 60 - row * 8);
            r: int = (px >> 24) & 255;
            g: int = (px >> 16) & 255;
            bl: int = (px >> 8) & 255;
            lum: int = (r + g + bl) / 3;
            if lum > 190 { out = out + "#"; }
            also lum > 140 { out = out + "*"; }
            also lum > 90 { out = out + "+"; }
            else { out = out + "."; }
            col = col + 1;
        }
        out = out + "\n";
        row = row + 1;
    }
    show(out);
}

fnc parse_count(s string) : int {
    if s.bsize == 0 { return 0; }
    i: int = 0;
    while i < s.bsize {
        c: char = s[i];
        if c < '0' || c > '9' { return 0; }
        i = i + 1;
    }
    n: int = toint(int, s);
    if n < 1 { return 0; }
    if n > 100000 { return 100000; }
    return n;
}

fnc initial_inventory() : vec<int> {
    inv: vec<int>;
    i: int = 0;
    while i < 10 {
        inv.pushb(0);
        i = i + 1;
    }
    inv.set(1, 24);
    inv.set(2, 24);
    inv.set(3, 24);
    inv.set(4, 12);
    inv.set(5, 12);
    inv.set(6, 24);
    inv.set(7, 16);
    inv.set(8, 16);
    inv.set(9, 16);
    return inv;
}

fnc main(args string[]) : void {
    w: World = make_world(64, 24, 64);
    wgenerate(w);
    p: Player = new_player(w);
    inv: vec<int> = initial_inventory();
    sel: int = 1;

    max_frames: int = 0;
    force_headless: bool = Env.get_or("LEASH_VOXEL_HEADLESS", "") == "1";
    i: int = 0;
    while i < args.size {
        a: string = args[i];
        if a == "--frames" && i + 1 < args.size {
            max_frames = parse_count(args[i + 1]);
            i = i + 1;
        } else if a == "--headless" {
            force_headless = true;
        }
        i = i + 1;
    }

    ctx: pointer<void> = null;
    if !force_headless {
        ctx = Gl.open_window(960, 600, "Leash Voxel Sandbox");
    }

    if ctx != null {
        Gl.set_vsync(false);
        Gl.mouse_capture(true);
        ids: vec<int>;
        counts: vec<int>;
        cps: int = chunks_per_side(w);
        i = 0;
        while i < cps * cps {
            ids.pushb(0);
            counts.pushb(0);
            i = i + 1;
        }
        total_faces: int = build_all(w, ids, counts);
        clouds: int = build_clouds(w);
        show("window=open ", Gl.width(), "x", Gl.height(),
             " vsync=off renderer=", Gl.renderer());
        show("controls: WASD move, mouse look, LMB mine, RMB place, ",
             "1-9 select, Space jump, Shift sprint, R reset, Esc quit");

        start: int<64> = Gl.time_ms();
        last_frame: int<64> = start;
        fps_time: int<64> = start;
        fps_frames: int = 0;
        fps: int = 0;
        frame_ms: int = 0;
        frames: int = 0;
        while !Gl.should_close() {
            now: int<64> = Gl.time_ms();
            dt: float = tofloat(float, now - last_frame) / 1000.0;
            if dt < 0.001 { dt = 0.001; }
            if dt > 0.05 { dt = 0.05; }
            last_frame = now;
            Gl.poll_events();
            if Gl.should_close() || Gl.key_pressed(Gl.key_escape()) { stop; }

            fps_frames = fps_frames + 1;
            if now - fps_time >= 500 {
                elapsed: int = toint(int, now - fps_time);
                fps = fps_frames * 1000 / elapsed;
                frame_ms = elapsed / fps_frames;
                fps_frames = 0;
                fps_time = now;
            }

            if !Gl.mouse_captured() {
                if Gl.mouse_pressed(Gl.mouse_left()) {
                    Gl.mouse_capture(true);
                }
            } else {
                mdx: int = Gl.mouse_dx();
                mdy: int = Gl.mouse_dy();
                p.yaw = p.yaw + tofloat(float, mdx) * 0.0023;
                p.pitch = clampf(p.pitch - tofloat(float, mdy) * 0.0023,
                                 -1.50, 1.50);
            }

            move_player(w, p, dt);

            n: int = 1;
            while n <= 9 {
                if Gl.key_pressed(Gl.key_num(n)) { sel = n; }
                n = n + 1;
            }
            if Gl.key_pressed(Gl.key_r()) {
                wgenerate(w);
                total_faces = build_all(w, ids, counts);
                p = new_player(w);
            }
            if Gl.key_pressed(Gl.key_g()) {
                mine_block(w, ids, counts, p, inv);
            }
            if Gl.key_pressed(Gl.key_f()) {
                place_block(w, ids, counts, p, inv, sel);
            }
            if Gl.mouse_captured() {
                if Gl.mouse_pressed(Gl.mouse_left()) {
                    mine_block(w, ids, counts, p, inv);
                }
                if Gl.mouse_pressed(Gl.mouse_right()) {
                    place_block(w, ids, counts, p, inv, sel);
                }
            }

            p.hour = Math.fmod(8.0 + tofloat(float, now - start) / 3000.0, 24.0);
            total_faces = draw_frame(w, ids, counts, p, sel, inv, fps,
                                     frame_ms, Gl.width(), Gl.height(),
                                     true, Gl.mouse_captured(), frames < 600,
                                     clouds);
            if frames == 0 {
                show("faces=", total_faces, " center_pixel=",
                     Gl.pixel(Gl.width() / 2, Gl.height() / 2));
            }
            Gl.swap_buffers();
            frames = frames + 1;
            if max_frames > 0 && frames >= max_frames { stop; }
        }
        Gl.close(ctx);
        show("window=closed frames=", frames, " mined=", p.mined,
             " placed=", p.placed, " fps=", fps);
        return;
    }

    show("window=unavailable; using headless renderer");
    ctx = Gl.init();
    ids: vec<int>;
    counts: vec<int>;
    cps: int = chunks_per_side(w);
    i = 0;
    while i < cps * cps {
        ids.pushb(0);
        counts.pushb(0);
        i = i + 1;
    }
    total_faces: int = build_all(w, ids, counts);
    clouds: int = build_clouds(w);

    // A deterministic session: look at the terrain, mine a block, place one.
    mine_block(w, ids, counts, p, inv);
    place_block(w, ids, counts, p, inv, sel);
    total_faces = draw_frame(w, ids, counts, p, sel, inv, 0, 0,
                             64, 64, false, false, false, clouds);
    show("=== VOXEL SANDBOX ===");
    show("GL renderer=", Gl.version());
    show("faces=", total_faces, " center=", Gl.pixel(32, 32),
         " mid=", Gl.pixel(48, 40));
    preview_gl();
    Gl.close(ctx);
    show("player=", toint(int, p.x), ",", toint(int, p.z),
         " yaw=", toint(int, p.yaw), " hour=", toint(int, p.hour));
    show("mined=", p.mined, " placed=", p.placed,
         " grass=", inv.get(1), " dirt=", inv.get(2), " stone=", inv.get(3));
    show("world=", wget(w, 32, top_at(w, 32, 32), 32),
         " sky=", wget(w, 32, 23, 32));
}
