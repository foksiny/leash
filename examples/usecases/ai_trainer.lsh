// Use case: Train a tiny neural net
// Compile (linux64):   leash compile examples/usecases/ai_trainer.lsh to out/usecases/ai_trainer-linux64 --target linux64
// Compile (linux32  ): leash compile examples/usecases/ai_trainer.lsh to out/usecases/ai_trainer-linux32 --target linux32
// Compile (linux-arm): leash compile examples/usecases/ai_trainer.lsh to out/usecases/ai_trainer-linux-arm --target linux-arm
// Compile (win64    ): leash compile examples/usecases/ai_trainer.lsh to out/usecases/ai_trainer-win64 --target win64
// Compile (macos    ): leash compile examples/usecases/ai_trainer.lsh to out/usecases/ai_trainer-macos --target macos
// Compile (macos-arm): leash compile examples/usecases/ai_trainer.lsh to out/usecases/ai_trainer-macos-arm --target macos-arm
// Compile (jvm      ): leash compile examples/usecases/ai_trainer.lsh to out/usecases/ai_trainer-jvm --target jvm
// Run:                  leash run examples/usecases/ai_trainer.lsh --other-imports installthis

// A single-neuron perceptron trained on OR with online gradient descent.
// Shows model creation, training, inference and evaluation in ~40 lines.

def Sample : struct { x: int; y: int; want: int; }

fnc train(samples vec<Sample>, epochs int, rate float) : vec<float> {
    w: vec<float>;
    w.pushb(0.1);
    w.pushb(-0.1);
    w.pushb(0.05); // bias
    e: int = 0;
    while e < epochs {
        i: int = 0;
        while i < samples.size {
            s: Sample = samples.get(i);
            z: float = w.get(0) * tofloat(float, s.x) + w.get(1) * tofloat(float, s.y) + w.get(2);
            pred: int = z > 0.0 ? 1 : 0;
            err: int = s.want - pred;
            w.set(0, w.get(0) + rate * tofloat(float, err * s.x));
            w.set(1, w.get(1) + rate * tofloat(float, err * s.y));
            w.set(2, w.get(2) + rate * tofloat(float, err));
            i = i + 1;
        }
        e = e + 1;
    }
    return w;
}

fnc main() {
    data: vec<Sample>;
    a: Sample = Sample { x: 0, y: 0, want: 0 };
    b: Sample = Sample { x: 0, y: 1, want: 1 };
    c: Sample = Sample { x: 1, y: 0, want: 1 };
    d: Sample = Sample { x: 1, y: 1, want: 1 };
    data.pushb(a); data.pushb(b); data.pushb(c); data.pushb(d);

    w := train(data, 60, 0.1);
    correct: int = 0;
    i: int = 0;
    while i < data.size {
        s: Sample = data.get(i);
        z: float = w.get(0) * tofloat(float, s.x) + w.get(1) * tofloat(float, s.y) + w.get(2);
        pred: int = z > 0.0 ? 1 : 0;
        if pred == s.want { correct = correct + 1; }
        i = i + 1;
    }
    show("weights=", w.get(0), ",", w.get(1), ",", w.get(2));
    show("accuracy=", correct, "/", data.size);
}
