// Recursive structs: a linked list built from struct l-values.
// A struct may reference itself through a pointer (`next: *Node`),
// and two structs may reference each other regardless of order.
def Node : struct {
    value: int;
    next: *Node;
};

// Recursive traversal over raw pointers requires an unsafe function
// because it dereferences with '->'.
unsafe fnc sum(n : *Node) : int {
    if n == null { return 0; }
    return n->value + sum(n->next);
}

unsafe fnc length(n : *Node) : int {
    if n == null { return 0; }
    return 1 + length(n->next);
}

// Struct l-values: mutate fields deep inside the chain.
unsafe fnc set_at(n : *Node, idx : int, v : int) : void {
    if idx == 0 {
        n->value = v;
        return;
    }
    set_at(n->next, idx - 1, v);
}

unsafe fnc main() : void {
    c: Node = Node { value: 30, next: null };
    b: Node = Node { value: 20, next: &c };
    a: Node = Node { value: 10, next: &b };

    show("len=", length(&a));
    show("sum=", sum(&a));

    set_at(&a, 1, 99);
    show("b.value=", b.value);

    // whole-struct assignment copies by value
    copy: Node = b;
    copy.value = 1234;
    show("copy.value=", copy.value, " b.value=", b.value);

    // compound assignment on nested field l-value
    a.next->value += 1;
    show("b.value=", b.value);
}
