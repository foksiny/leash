pub def Crc : class {
    static pub fnc crc32(data string) : int<64> {
        crc: uint<32> = (uint<32>)0xFFFFFFFF;
        foreach _, ch in<string> data {
            b: uint<32> = (uint<32>)(toint(int, ch) & 255);
            crc = crc ^ b;
            for k: int = 0; k < 8; k = k + 1 {
                if (crc & (uint<32>)1) == (uint<32>)1 {
                    crc = (crc >> 1) ^ (uint<32>)0xEDB88320;
                } else {
                    crc = crc >> 1;
                }
            }
        }
        return Crc.to_i64(crc ^ (uint<32>)0xFFFFFFFF);
    }

    static pub fnc crc32_bytes(bytes vec<char>) : int<64> {
        crc: uint<32> = (uint<32>)0xFFFFFFFF;
        foreach _, ch in<vector> bytes {
            b: uint<32> = (uint<32>)(toint(int, ch) & 255);
            crc = crc ^ b;
            for k: int = 0; k < 8; k = k + 1 {
                if (crc & (uint<32>)1) == (uint<32>)1 {
                    crc = (crc >> 1) ^ (uint<32>)0xEDB88320;
                } else {
                    crc = crc >> 1;
                }
            }
        }
        return Crc.to_i64(crc ^ (uint<32>)0xFFFFFFFF);
    }

    static priv fnc to_i64(x uint<32>) : int<64> {
        hi: int<64> = toint(int<64>, toint(int, (x >> 16) & (uint<32>)0xFFFF));
        lo: int<64> = toint(int<64>, toint(int, x & (uint<32>)0xFFFF));
        return hi * 65536 + lo;
    }

    static pub fnc crc32_hex(data string) : string {
        v: int<64> = Crc.crc32(data);
        out: string;
        for shift: int = 28; shift >= 0; shift = shift - 4 {
            nib: int = toint(int, (v >> shift) & 0xF);
            if nib < 10 {
                out = out + (char)('0' + nib);
            } else {
                out = out + (char)('a' + nib - 10);
            }
        }
        return out;
    }

    static pub fnc crc16_ccitt(data string) : int {
        crc: int = 0xFFFF;
        foreach _, ch in<string> data {
            b: int = toint(int, ch) & 255;
            crc = crc ^ (b << 8);
            for k: int = 0; k < 8; k = k + 1 {
                if (crc & 0x8000) != 0 {
                    crc = ((crc << 1) ^ 0x1021) & 0xFFFF;
                } else {
                    crc = (crc << 1) & 0xFFFF;
                }
            }
        }
        return crc;
    }

    static pub fnc adler32(data string) : int<64> {
        a: int<64> = 1;
        b: int<64> = 0;
        count: int = 0;
        foreach _, ch in<string> data {
            a = (a + toint(int<64>, toint(int, ch) & 255)) % 65521;
            b = (b + a) % 65521;
            count = count + 1;
        }
        _ = count;
        return b * 65536 + a;
    }

    static pub fnc checksum_file(path string) : int<64> {
        f: File = File.open(path, "r");
        if f == nil {
            return 0 - 1;
        }
        content: string = f.read();
        f.close();
        return Crc.crc32(content);
    }
};
