// MAC address (aa:bb:cc:dd:ee:ff) validation and uniform formatting.
//
//   use net::mac::Mac;
//   show(Mac.normalize("aabb.ccdd.eeff"));   // "aa:bb:cc:dd:ee:ff"

pub def Mac : class {
    static pub fnc is_valid(s string) : bool {
        n: int = s.size;
        if n != 17 && n != 14 {
            return false;
        }
        if n == 17 {
            for i: int = 0; i < n; i = i + 1 {
                c: char = s[i];
                if (i + 1) % 3 == 0 {
                    if c != ':' {
                        return false;
                    }
                } also !Mac.is_hex(c) {
                    return false;
                }
            }
            return true;
        }
        // aa.bb.cc dotted-pair form: "aa bb.cc dd.ee ff"
        for i2: int = 0; i2 < n; i2 = i2 + 1 {
            c2: char = s[i2];
            if (i2 + 1) % 5 == 0 && i2 + 1 < n {
                if c2 != '.' {
                    return false;
                }
            } also !Mac.is_hex(c2) {
                return false;
            }
        }
        return n == 14 && s[4] == '.' && s[9] == '.';
    }

    // Canonical lowercase colon form (accepts ":" or "." splits).
    static pub fnc normalize(s string) : string {
        if !Mac.is_valid(s) {
            return "";
        }
        out: string = "";
        k: int = 0;
        for i: int = 0; i < s.size; i = i + 1 {
            ch: char = s[i];
            if ch == ':' || ch == '.' {
                continue;
            }
            if ch >= 'A' && ch <= 'F' {
                ch = (char)(ch + 32);
            }
            if k > 0 && k % 2 == 0 {
                out = out + ':';
            }
            out = out + ch;
            k = k + 1;
        }
        return out;
    }

    static priv fnc is_hex(c char) : bool {
        return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F');
    }
};
