// N-gram extraction from text (n = consecutive words/chars).
//
//   use text::ngrams::Ngrams;
//   v: vec<string> = Ngrams.words("the quick brown fox", 2);   // "the quick", ...

pub def Ngrams : class {
    // Word n-grams (e.g. bigrams of words) joined by a single space.
    static pub fnc words(text string, n int) : vec<string> {
        out: vec<string>;
        if n <= 0 {
            return out;
        }
        ws: vec<string>;
        p: int = 0;
        count: int = text.size;
        while p < count {
            while p < count && (text[p] == ' ' || text[p] == '\t' || text[p] == '\n') {
                p = p + 1;
            }
            if p >= count {
                stop;
            }
            start: int = p;
            while p < count && text[p] != ' ' && text[p] != '\t' && text[p] != '\n' {
                p = p + 1;
            }
            ws.pushb(Ngrams.slice(text, start, p));
        }
        if ws.size < n {
            return out;
        }
        for i: int = 0; i + n <= ws.size; i = i + 1 {
            out.pushb(Ngrams.join_words(ws, i, n));
        }
        return out;
    }

    // Character n-grams (sliding window over the text).
    static pub fnc chars(text string, n int) : vec<string> {
        out: vec<string>;
        if n <= 0 || n > text.size {
            return out;
        }
        for i: int = 0; i + n <= text.size; i = i + 1 {
            out.pushb(Ngrams.slice(text, i, i + n));
        }
        return out;
    }

    static priv fnc join_words(ws vec<string>, start int, n int) : string {
        out: string = "";
        for k: int = 0; k < n; k = k + 1 {
            if k > 0 {
                out = out + " ";
            }
            out = out + ws.get(start + k);
        }
        return out;
    }

    static priv fnc slice(text string, start int, end int) : string {
        out: string = "";
        for i: int = start; i < end; i = i + 1 {
            out = out + text[i];
        }
        return out;
    }
};
