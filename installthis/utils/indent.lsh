// Line indentation helpers for multi-line text.
//
//   use utils::indent::Indent;
//   show(Indent.text("hello\nworld", 2));

pub def Indent : class {
    // Indents every non-empty line by `n` spaces.
    static pub fnc text(s string, n int) : string {
        return Indent.by(s, Indent.spaces(n));
    }

    // Adds `prefix` to the start of every non-empty line.
    static pub fnc by(s string, prefix string) : string {
        out: string = "";
        at_start: bool = true;
        foreach _, c in<string> s {
            if at_start && c != '\n' && c != '\r' {
                out = out + prefix;
                at_start = false;
            }
            out = out + c;
            if c == '\n' {
                at_start = true;
            }
        }
        return out;
    }

    // Removes the largest uniform leading-space run shared by all lines
    // that contain non-whitespace. Tabs count as whitespace.
    static pub fnc dedent(s string) : string {
        min: int = -1;
        i: int = 0;
        n: int = s.size;
        while i < n {
            line_end: int = Indent.find_nl(s, i);
            run: int = Indent.leading_ws(s, i, line_end);
            has_content: bool = run < line_end - i;
            if has_content && (min < 0 || run < min) {
                min = run;
            }
            i = line_end + 1;
        }
        if min <= 0 {
            return s;
        }
        out: string = "";
        i = 0;
        while i < n {
            line_end = Indent.find_nl(s, i);
            drop: int = min;
            if i + drop > line_end {
                drop = line_end - i;
            }
            for j: int = i + drop; j <= line_end; j = j + 1 {
                if j < n {
                    out = out + s[j];
                }
            }
            i = line_end + 1;
        }
        return out;
    }

    static priv fnc spaces(n int) : string {
        out: string = "";
        for i: int = 0; i < n; i = i + 1 {
            out = out + " ";
        }
        return out;
    }

    static priv fnc find_nl(s string, start int) : int {
        for i: int = start; i < s.size; i = i + 1 {
            if s[i] == '\n' {
                return i;
            }
        }
        return s.size;
    }

    static priv fnc leading_ws(s string, start int, end int) : int {
        k: int = 0;
        while start + k < end && (s[start + k] == ' ' || s[start + k] == '\t') {
            k = k + 1;
        }
        return k;
    }
};
