pub def Base64 : class {
    static pub fnc chr(d int) : char {
        if d >= 0 && d < 26 {
            return (char)('A' + d);
        }
        if d >= 26 && d < 52 {
            return (char)('a' + d - 26);
        }
        if d >= 52 && d < 62 {
            return (char)('0' + d - 52);
        }
        if d == 62 {
            return '+';
        }
        if d == 63 {
            return '/';
        }
        return '?';
    }

    static pub fnc val(c char) : int {
        if c >= 'A' && c <= 'Z' {
            return c - 'A';
        }
        if c >= 'a' && c <= 'z' {
            return c - 'a' + 26;
        }
        if c >= '0' && c <= '9' {
            return c - '0' + 52;
        }
        if c == '+' {
            return 62;
        }
        if c == '/' {
            return 63;
        }
        return -1;
    }

    static pub fnc encode(s string) : string {
        out: string;
        n: int = s.size;
        i: int = 0;
        while i + 2 < n {
            b0: int = toint(int, s[i]);
            b1: int = toint(int, s[i + 1]);
            b2: int = toint(int, s[i + 2]);
            out = out + Base64.chr(b0 / 4);
            out = out + Base64.chr((b0 % 4) * 16 + b1 / 16);
            out = out + Base64.chr((b1 % 16) * 4 + b2 / 64);
            out = out + Base64.chr(b2 % 64);
            i = i + 3;
        }
        if n - i == 1 {
            p0: int = toint(int, s[i]);
            out = out + Base64.chr(p0 / 4);
            out = out + Base64.chr((p0 % 4) * 16);
            out = out + "==";
        } also n - i == 2 {
            q0: int = toint(int, s[i]);
            q1: int = toint(int, s[i + 1]);
            out = out + Base64.chr(q0 / 4);
            out = out + Base64.chr((q0 % 4) * 16 + q1 / 16);
            out = out + Base64.chr((q1 % 16) * 4);
            out = out + "=";
        }
        return out;
    }

    static pub fnc decode_bytes(s string) : vec<char> {
        out: vec<char>;
        buf: vec<int>;
        n: int = 0;
        pad: int = 0;
        in_pad: bool = false;
        foreach _, c in<string> s {
            _ = _ + 1 - 1;
            if c == ' ' || c == '\t' || c == '\n' || c == '\r' {
                continue;
            }
            if c == '=' {
                if in_pad == false {
                    in_pad = true;
                }
                pad = pad + 1;
            } else {
                if in_pad {
                    out.clear();
                    return out;
                }
                v: int = Base64.val(c);
                if v < 0 {
                    out.clear();
                    return out;
                }
                buf.pushb(v);
                n = n + 1;
            }
        }
        if pad > 2 {
            out.clear();
            return out;
        }
        if (n + pad) % 4 != 0 {
            out.clear();
            return out;
        }
        if n % 4 == 1 {
            out.clear();
            return out;
        }
        i: int = 0;
        while i + 3 < n {
            a0: int = buf.get(i);
            a1: int = buf.get(i + 1);
            a2: int = buf.get(i + 2);
            a3: int = buf.get(i + 3);
            out.pushb((char)(a0 * 4 + a1 / 16));
            out.pushb((char)((a1 % 16) * 16 + a2 / 4));
            out.pushb((char)((a2 % 4) * 64 + a3));
            i = i + 4;
        }
        if n - i == 2 {
            c0: int = buf.get(i);
            c1: int = buf.get(i + 1);
            if c1 % 16 != 0 {
                out.clear();
                return out;
            }
            out.pushb((char)(c0 * 4 + c1 / 16));
        } also n - i == 3 {
            d0: int = buf.get(i);
            d1: int = buf.get(i + 1);
            d2: int = buf.get(i + 2);
            if d2 % 4 != 0 {
                out.clear();
                return out;
            }
            out.pushb((char)(d0 * 4 + d1 / 16));
            out.pushb((char)((d1 % 16) * 16 + d2 / 4));
        }
        return out;
    }

    static pub fnc decode(s string) : string {
        bytes: vec<char> = Base64.decode_bytes(s);
        out: string;
        for i: int = 0; i < bytes.size; i = i + 1 {
            out = out + bytes.get(i);
        }
        return out;
    }

    static pub fnc valid(s string) : bool {
        pad: int = 0;
        in_pad: bool = false;
        foreach _, c in<string> s {
            _ = _ + 1 - 1;
            if c == ' ' || c == '\t' || c == '\n' || c == '\r' {
                continue;
            }
            if c == '=' {
                if in_pad == false {
                    in_pad = true;
                }
                pad = pad + 1;
            } else {
                if in_pad {
                    return false;
                }
                if Base64.val(c) < 0 {
                    return false;
                }
            }
        }
        if pad > 2 {
            return false;
        }
        return true;
    }
};