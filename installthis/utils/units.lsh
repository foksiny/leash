// Human-friendly unit conversions and data-size formatting.
//
//   use utils::units::Units;
//   show(Units.bytes(1536));      // "1.5 KB"
//   show(Units.mi_to_km(10.0));   // 16.09...

pub def Units : class {
    //====================================================
    // Data sizes (103-clamped to show "KB"/"MB"/"GB"/"TB")
    //====================================================

    static pub fnc bytes(n int) : string {
        return Units.bytes64(n);
    }

    static pub fnc bytes64(n int<64>) : string {
        if n < 1024 {
            return tostring(n) + " B";
        }
        v: float = tofloat(float, toint(int, n));
        if v < 1048576.0 {
            return Units.f1(v / 1024.0) + " KB";
        }
        if v < 1073741824.0 {
            return Units.f1(v / 1048576.0) + " MB";
        }
        if v < 1099511627776.0 {
            return Units.f1(v / 1073741824.0) + " GB";
        }
        return Units.f1(v / 1099511627776.0) + " TB";
    }

    //====================================================
    // Temperature
    //====================================================

    static pub fnc c_to_f(celsius float) : float {
        return celsius * 9.0 / 5.0 + 32.0;
    }

    static pub fnc f_to_c(fahrenheit float) : float {
        return (fahrenheit - 32.0) * 5.0 / 9.0;
    }

    //====================================================
    // Length
    //====================================================

    static pub fnc km_to_mi(km float) : float {
        return km * 0.621371192;
    }

    static pub fnc mi_to_km(mi float) : float {
        return mi / 0.621371192;
    }

    static pub fnc m_to_ft(m float) : float {
        return m * 3.280839895;
    }

    static pub fnc ft_to_m(ft float) : float {
        return ft / 3.280839895;
    }

    //====================================================
    // Mass
    //====================================================

    static pub fnc kg_to_lb(kg float) : float {
        return kg * 2.204622622;
    }

    static pub fnc lb_to_kg(lb float) : float {
        return lb / 2.204622622;
    }

    //====================================================
    // Formatting helper: one decimal, deterministic
    //====================================================

    static pub fnc f1(x float) : string {
        neg: bool = x < 0.0;
        u: float = x;
        if neg {
            u = 0.0 - u;
        }
        i: int = toint(int, u);
        d: int = toint(int, (u - tofloat(float, i)) * 10.0 + 0.5);
        if d >= 10 {
            i = i + 1;
            d = 0;
        }
        if neg {
            return "-" + tostring(i) + "." + tostring(d);
        }
        return tostring(i) + "." + tostring(d);
    }
};
