// A tiny single-layer perceptron for binary classification.
//
//   use ai::perceptron::Perceptron;
//   p: Perceptron = Perceptron.make(2);
//   p.train(...);

pub def Perceptron : class {
    priv w: vec<float>;
    priv b: float;
    pub epochs: int;

    static pub fnc make(inputs int) : Perceptron {
        ws: vec<float>;
        for i: int = 0; i < inputs; i = i + 1 {
            ws.pushb(0.0);
        }
        return Perceptron { w: ws, b: 0.0, epochs: 50 };
    }

    static pub fnc make_with_bias(inputs int, bias float) : Perceptron {
        ws: vec<float>;
        for i: int = 0; i < inputs; i = i + 1 {
            ws.pushb(0.0);
        }
        return Perceptron { w: ws, b: bias, epochs: 50 };
    }

    // Raw score (dot product + bias).
    pub fnc score(x vec<float>) : float {
        s: float = this.b;
        for i: int = 0; i < this.w.size && i < x.size; i = i + 1 {
            s = s + this.w.get(i) * x.get(i);
        }
        return s;
    }

    // Classify to 0 or 1 via the perceptron's threshold on score.
    pub fnc predict(x vec<float>) : int {
        if this.score(x) >= 0.0 {
            return 1;
        }
        return 0;
    }

    // One training pass with perceptron updates; returns the number of
    // misclassified samples left after this pass.
    pub fnc train(xs vec<float>, ys vec<int>) : int {
        n: int = ys.size;
        d: int = this.w.size;
        errors: int = 0;
        for i: int = 0; i < n; i = i + 1 {
            // slice x row
            row: vec<float>;
            for j: int = 0; j < d; j = j + 1 {
                idx: int = i * d + j;
                if idx < xs.size {
                    row.pushb(xs.get(idx));
                } else {
                    row.pushb(0.0);
                }
            }
            want: int = ys.get(i);
            got: int = this.predict(row);
            err: int = want - got;
            if err != 0 {
                errors = errors + 1;
                lr: float = 0.1;
                lr_e: float = lr * (float)err;
                for k: int = 0; k < d; k = k + 1 {
                    this.w.set(k, this.w.get(k) + lr_e * row.get(k));
                }
                this.b = this.b + lr_e;
            }
        }
        return errors;
    }
};
