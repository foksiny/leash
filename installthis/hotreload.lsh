priv use utils::str::Str;

pub def Reloader : class {
    priv filename: string;

    static pub fnc new(name string) : Reloader {
        return Reloader { filename: name };
    }

    pub Reloader(name string) {
        this.filename = name;
    }

    pub fnc start() : void {
        if !Str.ends(this.filename, _FILENAME) {
            show("Hot Reloader Error: You can't hot reload the hot reloader");
            exit(1);
        }
        
        f: File = File.open(this.filename, "r");
        if f == null {
            show("Hot Reloader Error: cannot open '", this.filename, "'");
            exit(1);
        }

        old_code: string = "";

        while true {
            f.rewind();
            new_code: string = f.read();

            if new_code != old_code {
                show("\n======== Reloading... ========\n");
                old_code = new_code;
                // exec() uses /bin/sh: quote the path so a filename cannot
                // inject additional commands.
                quoted: string = "'";
                qi: int = 0;
                while qi < this.filename.bsize {
                    if this.filename[qi] == '\'' { quoted = quoted + "'\\''"; }
                    else { quoted = quoted + this.filename[qi]; }
                    qi = qi + 1;
                }
                quoted = quoted + "'";
                exec("leash run " + quoted, nil);
                show("\n========== Reloaded ==========\n");
            }

            wait(0.1);
        }
    }
}