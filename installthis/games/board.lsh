// A 3x3 tic-tac-toe board: moves, win detection, draw.
//
//   use games::board::Board;
//   b: Board = Board.make();
//   b.play(0, 'X'); b.play(4, 'O'); ...

pub def Board : class {
    priv cells: vec<char>;

    static pub fnc make() : Board {
        c: vec<char>;
        for i: int = 0; i < 9; i = i + 1 {
            c.pushb(' ');
        }
        return Board { cells: c };
    }

    // A nicer display: "X O\n X \n  O"
    pub fnc render() : string {
        out: string = "";
        for r: int = 0; r < 3; r = r + 1 {
            for c: int = 0; c < 3; c = c + 1 {
                v: char = this.cells.get(r * 3 + c);
                if v == ' ' {
                    out = out + '.';
                } else {
                    out = out + v;
                }
            }
            if r < 2 {
                out = out + "\n";
            }
        }
        return out;
    }

    pub fnc play(idx int, mark char) : bool {
        if idx < 0 || idx > 8 {
            return false;
        }
        if this.cells.get(idx) != ' ' {
            return false;
        }
        this.cells.set(idx, mark);
        return true;
    }

    // 'X', 'O' or ' ' (no winner yet).
    pub fnc winner() : char {
        wins: vec<int>;
        // rows, cols, diagonals
        wins.pushb(0); wins.pushb(1); wins.pushb(2);
        wins.pushb(3); wins.pushb(4); wins.pushb(5);
        wins.pushb(6); wins.pushb(7); wins.pushb(8);
        wins.pushb(0); wins.pushb(3); wins.pushb(6);
        wins.pushb(1); wins.pushb(4); wins.pushb(7);
        wins.pushb(2); wins.pushb(5); wins.pushb(8);
        wins.pushb(0); wins.pushb(4); wins.pushb(8);
        wins.pushb(2); wins.pushb(4); wins.pushb(6);
        i: int = 0;
        while i + 2 < wins.size {
            a: char = this.cells.get(wins.get(i));
            b: char = this.cells.get(wins.get(i + 1));
            c: char = this.cells.get(wins.get(i + 2));
            if a != ' ' && a == b && b == c {
                return a;
            }
            i = i + 3;
        }
        return ' ';
    }

    pub fnc is_draw() : bool {
        if this.winner() != ' ' {
            return false;
        }
        for i: int = 0; i < 9; i = i + 1 {
            if this.cells.get(i) == ' ' {
                return false;
            }
        }
        return true;
    }
};
