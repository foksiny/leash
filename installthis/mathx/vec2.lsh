use utils::math::Math;

// 2D vectors for games/geometry.
//
//   use mathx::vec2::Vec2;
//   a: Vec2 = Vec2.xy(1.0, 2.0);

pub def Vec2 : class {
    pub x: float;
    pub y: float;

    static pub fnc xy(x float, y float) : Vec2 {
        return Vec2 { x: x, y: y };
    }

    static pub fnc zero() : Vec2 {
        return Vec2 { x: 0.0, y: 0.0 };
    }

    pub fnc VAL_Vec2() : string {
        return "Vec2{" + tostring(this.x) + ", " + tostring(this.y) + "}";
    }

    pub fnc add(o Vec2) : Vec2 {
        return Vec2.xy(this.x + o.x, this.y + o.y);
    }

    pub fnc sub(o Vec2) : Vec2 {
        return Vec2.xy(this.x - o.x, this.y - o.y);
    }

    pub fnc scale(k float) : Vec2 {
        return Vec2.xy(this.x * k, this.y * k);
    }

    pub fnc dot(o Vec2) : float {
        return this.x * o.x + this.y * o.y;
    }

    pub fnc length_sq() : float {
        return this.x * this.x + this.y * this.y;
    }

    pub fnc length() : float {
        return Math.sqrt((double)this.length_sq());
    }

    pub fnc normalized() : Vec2 {
        l: float = this.length();
        if l == 0.0 {
            return Vec2.zero();
        }
        return Vec2.xy(this.x / l, this.y / l);
    }

    pub fnc dist(o Vec2) : float {
        return this.sub(o).length();
    }
};
