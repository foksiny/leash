// Whole-vector utilities (return new vectors — vec params are by-value in
// Leash, so in-place helpers receive a copy).
//
//   use collections::vecops::Vecs;
//   v: vec<int> = Vecs.reverse((vec<int>){1, 2, 3});

pub def Vecs : class {
    static pub fnc reverse_ints(v vec<int>) : vec<int> {
        out: vec<int>;
        for i: int = v.size - 1; i >= 0; i = i - 1 {
            out.pushb(v.get(i));
        }
        return out;
    }

    static pub fnc reverse_strings(v vec<string>) : vec<string> {
        out: vec<string>;
        for i: int = v.size - 1; i >= 0; i = i - 1 {
            out.pushb(v.get(i));
        }
        return out;
    }

    static pub fnc take_ints(v vec<int>, n int) : vec<int> {
        out: vec<int>;
        for i: int = 0; i < v.size && i < n; i = i + 1 {
            out.pushb(v.get(i));
        }
        return out;
    }

    static pub fnc drop_ints(v vec<int>, n int) : vec<int> {
        out: vec<int>;
        for i: int = n; i < v.size; i = i + 1 {
            out.pushb(v.get(i));
        }
        return out;
    }

    // Interleave two vectors: zip((a,b,c),(x,y)) = (a,x,b,y,c)
    static pub fnc zip_ints(a vec<int>, b vec<int>) : vec<int> {
        out: vec<int>;
        i: int = 0;
        j: int = 0;
        flip: bool = true;
        while i < a.size && j < b.size {
            if flip {
                out.pushb(a.get(i));
                i = i + 1;
            } else {
                out.pushb(b.get(j));
                j = j + 1;
            }
            flip = !flip;
        }
        while i < a.size {
            out.pushb(a.get(i));
            i = i + 1;
        }
        while j < b.size {
            out.pushb(b.get(j));
            j = j + 1;
        }
        return out;
    }

    static pub fnc unique_ints(v vec<int>) : vec<int> {
        out: vec<int>;
        foreach _, x in<vector> v {
            if !out.isin(x) {
                out.pushb(x);
            }
        }
        return out;
    }

    static pub fnc unique_strings(v vec<string>) : vec<string> {
        out: vec<string>;
        foreach _, x in<vector> v {
            if !out.isin(x) {
                out.pushb(x);
            }
        }
        return out;
    }

    static pub fnc intersect_ints(a vec<int>, b vec<int>) : vec<int> {
        out: vec<int>;
        foreach _, x in<vector> a {
            if b.isin(x) && !out.isin(x) {
                out.pushb(x);
            }
        }
        return out;
    }

    static pub fnc sum_ints(v vec<int>) : int {
        s: int = 0;
        foreach _, x in<vector> v {
            s = s + x;
        }
        return s;
    }

    static pub fnc min_ints(v vec<int>) : int {
        if v.size == 0 {
            return 0;
        }
        m: int = v.get(0);
        for i: int = 1; i < v.size; i = i + 1 {
            if v.get(i) < m {
                m = v.get(i);
            }
        }
        return m;
    }

    static pub fnc max_ints(v vec<int>) : int {
        if v.size == 0 {
            return 0;
        }
        m: int = v.get(0);
        for i: int = 1; i < v.size; i = i + 1 {
            if v.get(i) > m {
                m = v.get(i);
            }
        }
        return m;
    }

    static pub fnc in_range_ints(v vec<int>, lo int, hi int) : vec<int> {
        out: vec<int>;
        foreach _, x in<vector> v {
            if x >= lo && x <= hi {
                out.pushb(x);
            }
        }
        return out;
    }
};
