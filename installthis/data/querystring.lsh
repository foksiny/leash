// application/x-www-form-urlencoded ("a=1&b=2") helpers.
//
//   use data::querystring::QueryString;
//   q: QueryString = QueryString.parse("a=1&b=2");
//   show(q.get("a"));

pub def QueryString : class {
    priv keys: vec<string>;
    priv vals: vec<string>;

    static pub fnc parse(q string) : QueryString {
        ks: vec<string>;
        vs: vec<string>;
        out: QueryString = QueryString { keys: ks, vals: vs };
        if q.size == 0 {
            return out;
        }
        start: int = 0;
        if q[0] == '?' {
            start = 1;
        }
        n: int = q.size;
        i: int = start;
        while i < n {
            amp: int = i;
            while amp < n && q[amp] != '&' {
                amp = amp + 1;
            }
            eq: int = -1;
            for j: int = i; j < amp; j = j + 1 {
                if q[j] == '=' {
                    eq = j;
                    stop;
                }
            }
            aseg: string = QueryString.slice(q, i, amp);
            if eq >= 0 {
                out.keys.pushb(QueryString.qs_decode(QueryString.slice(q, i, eq)));
                out.vals.pushb(QueryString.qs_decode(QueryString.slice(q, eq + 1, amp)));
            } else {
                if QueryString.slice(q, i, amp).size > 0 {
                    out.keys.pushb(QueryString.qs_decode(aseg));
                    out.vals.pushb("");
                }
            }
            i = amp + 1;
        }
        return out;
    }

    pub fnc get(key string) : string {
        for i: int = 0; i < this.keys.size; i = i + 1 {
            if this.keys.get(i) == key {
                return this.vals.get(i);
            }
        }
        return "";
    }

    pub fnc has(key string) : bool {
        for i: int = 0; i < this.keys.size; i = i + 1 {
            if this.keys.get(i) == key {
                return true;
            }
        }
        return false;
    }

    pub fnc count() : int {
        return this.keys.size;
    }

    // Percent-decode a single %xx char run and '+' -> ' '.
    static priv fnc qs_decode(s string) : string {
        out: string = "";
        i: int = 0;
        n: int = s.size;
        while i < n {
            c: char = s[i];
            if c == '+' {
                out = out + ' ';
                i = i + 1;
            } else {
                if c == '%' && i + 2 < n + 1 {
                    hi: int = QueryString.hv(s[i + 1]);
                    lo: int = QueryString.hv(s[i + 2]);
                    if hi >= 0 && lo >= 0 {
                        out = out + (char)(hi * 16 + lo);
                        i = i + 3;
                    } else {
                        out = out + c;
                        i = i + 1;
                    }
                } else {
                    out = out + c;
                    i = i + 1;
                }
            }
        }
        return out;
    }

    static priv fnc hv(c char) : int {
        if c >= '0' && c <= '9' {
            return toint(int, c) - toint(int, '0');
        }
        if c >= 'a' && c <= 'f' {
            return toint(int, c) - toint(int, 'a') + 10;
        }
        if c >= 'A' && c <= 'F' {
            return toint(int, c) - toint(int, 'A') + 10;
        }
        return 0 - 1;
    }

    static priv fnc slice(s string, from int, to int) : string {
        out: string = "";
        for i: int = from; i < to && i < s.size; i = i + 1 {
            out = out + s[i];
        }
        return out;
    }
};
