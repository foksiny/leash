// .env file parsing (KEY=value lines) — strings only, no getenv.
//
//   use data::env::EnvFile;
//   e: EnvFile = EnvFile.parse("PORT=8080\nDEBUG=1\n");
//   show(e.get("PORT"));

pub def EnvFile : class {
    priv keys: vec<string>;
    priv vals: vec<string>;

    static pub fnc parse(text string) : EnvFile {
        ks: vec<string>;
        vs: vec<string>;
        out: EnvFile = EnvFile { keys: ks, vals: vs };
        n: int = text.size;
        i: int = 0;
        while i < n {
            le: int = EnvFile.find_nl(text, i);
            line: string = EnvFile.trim(EnvFile.slice(text, i, le));
            if line.size > 0 && line[0] != '#' {
                eq: int = EnvFile.find_eq(line);
                if eq > 0 {
                    k: string = EnvFile.trim(EnvFile.slice(line, 0, eq));
                    v: string = EnvFile.trim(EnvFile.slice(line, eq + 1, line.size));
                    // strip surrounding quotes
                    if v.size >= 2 &&
                       ((v[0] == '"' && v[v.size - 1] == '"') ||
                        (v[0] == '\'' && v[v.size - 1] == '\'')) {
                        v = EnvFile.slice(v, 1, v.size - 1);
                    }
                    if k.size > 0 {
                        out.keys.pushb(k);
                        out.vals.pushb(v);
                    }
                }
            }
            i = le + 1;
        }
        return out;
    }

    pub fnc get(key string) : string {
        for i: int = 0; i < this.keys.size; i = i + 1 {
            if this.keys.get(i) == key {
                return this.vals.get(i);
            }
        }
        return "";
    }

    pub fnc has(key string) : bool {
        for i: int = 0; i < this.keys.size; i = i + 1 {
            if this.keys.get(i) == key {
                return true;
            }
        }
        return false;
    }

    pub fnc count() : int {
        return this.keys.size;
    }

    static priv fnc find_nl(s string, from int) : int {
        for i: int = from; i < s.size; i = i + 1 {
            if s[i] == '\n' {
                return i;
            }
        }
        return s.size;
    }

    static priv fnc find_eq(s string) : int {
        for i: int = 0; i < s.size; i = i + 1 {
            if s[i] == '=' {
                return i;
            }
        }
        return 0 - 1;
    }

    static priv fnc slice(s string, from int, to int) : string {
        out: string = "";
        for i: int = from; i < to && i < s.size; i = i + 1 {
            out = out + s[i];
        }
        return out;
    }

    static priv fnc trim(s string) : string {
        start: int = 0;
        end: int = s.size;
        while start < end && (s[start] == ' ' || s[start] == '\t' || s[start] == '\r') {
            start = start + 1;
        }
        while end > start && (s[end - 1] == ' ' || s[end - 1] == '\t' || s[end - 1] == '\r') {
            end = end - 1;
        }
        return EnvFile.slice(s, start, end);
    }
};
