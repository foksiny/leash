// Environment variable helpers (built on the runtime's getenv).
//
//   use sys::env::Env;
//   show(Env.get_or("HOME", "/tmp"));
//   show(Env.has("PATH"));

pub def Env : class {
    // getenv — returns "" when the variable is not set.
    static pub fnc get(name string) : string {
        p: pointer<char> = getenv(name);
        if p == null {
            return "";
        }
        return tostring(p);
    }

    static pub fnc get_or(name string, fallback string) : string {
        v: string = Env.get(name);
        if v.size == 0 {
            return fallback;
        }
        return v;
    }

    static pub fnc has(name string) : bool {
        p: pointer<char> = getenv(name);
        if p == null {
            return false;
        }
        return true;
    }

    // Home directory (HOME on POSIX, USERPROFILE on Windows).
    static pub fnc home() : string {
        v: string = Env.get("HOME");
        if v.size > 0 {
            return v;
        }
        return Env.get("USERPROFILE");
    }

    static pub fnc user() : string {
        v: string = Env.get("USER");
        if v.size > 0 {
            return v;
        }
        return Env.get("USERNAME");
    }
};
