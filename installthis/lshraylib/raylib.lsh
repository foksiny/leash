if _PLATFORM == "win64" {
    pub use win::main::*;
} also _PLATFORM == "linux64" {
    pub use linux::main::*;
} also _PLATFORM == "linux-arm" {
    pub use arm64::main::*;
}

def LIGHTGRAY : macro() |> Color { r: 200, g: 200, b: 200, a: 255 };
def GRAY : macro() |> Color { r: 130, g: 130, b: 130, a: 255 };
def DARKGRAY : macro() |> Color { r: 80, g: 80, b: 80, a: 255 };
def YELLOW : macro() |> Color { r: 253, g: 249, b: 0, a: 255 };
def GOLD : macro() |> Color { r: 255, g: 203, b: 0, a: 255 };
def ORANGE : macro() |> Color { r: 255, g: 161, b: 0, a: 255 };
def PINK : macro() |> Color { r: 255, g: 109, b: 194, a: 255 };
def RED : macro() |> Color { r: 230, g: 41, b: 55, a: 255 };
def MAROON : macro() |> Color { r: 190, g: 33, b: 55, a: 255 };
def GREEN : macro() |> Color { r: 0, g: 228, b: 48, a: 255 };
def LIME : macro() |> Color { r: 0, g: 158, b: 47, a: 255 };
