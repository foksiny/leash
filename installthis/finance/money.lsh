// Money formatting with cents precision.
//
//   use finance::money::Money;
//   show(Money.usd(1234567));     // "$12,345.67"  (cents)
//   show(Money.fmt(599, "EUR"));  // "EUR 5.99"

pub def Money : class {
    // cents -> "$X,XXX.XX"
    static pub fnc usd(cents int) : string {
        return "$" + Money.fmt(cents, "");
    }

    // cents -> "1,234.56" plus a currency suffix when given.
    static pub fnc fmt(cents int, sym string) : string {
        neg: bool = cents < 0;
        v: int = cents;
        if neg {
            v = 0 - v;
        }
        whole: int = v / 100;
        part: int = v - whole * 100;
        w: string = Money.commas(whole);
        p: string = tostring(part);
        if part < 10 {
            p = "0" + p;
        }
        out: string = w + "." + p;
        if neg {
            out = "-" + out;
        }
        if sym.size > 0 {
            out = sym + " " + out;
        }
        return out;
    }

    // cents -> "12" (truncated dollars)
    static pub fnc whole(cents int) : string {
        v: int = cents / 100;
        return tostring(v);
    }

    static priv fnc commas(n int) : string {
        digits: string = tostring(n);
        out: string = "";
        k: int = 0;
        for i: int = digits.size; i > 0; i = i - 1 {
            out = digits[i - 1] + out;
            k = k + 1;
            if k == 3 && i - 1 > 0 {
                out = "," + out;
                k = 0;
            }
        }
        return out;
    }
};
