{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Leash",
    "scopeName": "source.leash",
    "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#numbers" },
        { "include": "#constants" },
        { "include": "#keywords" },
        { "include": "#types" },
        { "include": "#builtins" },
        { "include": "#attributes" },
        { "include": "#operators" },
        { "include": "#function-call" }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.double-slash.leash",
                    "match": "//.*$"
                },
                {
                    "name": "comment.block.leash",
                    "begin": "/\\*",
                    "end": "\\*/"
                }
            ]
        },
        "escape-sequence": {
            "patterns": [
                {
                    "name": "constant.character.escape.leash",
                    "match": "\\\\([0abfnrtv?'\"\\\\{}])"
                },
                {
                    "name": "constant.character.escape.hex.leash",
                    "match": "\\\\x[0-9a-fA-F]{2}"
                },
                {
                    "name": "constant.character.escape.unicode.leash",
                    "match": "\\\\u[0-9a-fA-F]{4}"
                },
                {
                    "name": "constant.character.escape.unicode.long.leash",
                    "match": "\\\\U[0-9a-fA-F]{8}"
                }
            ]
        },
        "interpolation": {
            "begin": "(?<!\\\\)\\{",
            "end": "(?<!\\\\)\\}",
            "name": "meta.interpolation.leash",
            "patterns": [
                { "include": "#interpolation" },
                { "include": "#strings" },
                { "include": "#comments" },
                { "include": "#numbers" },
                { "include": "#constants" },
                { "include": "#builtins" },
                { "include": "#operators" },
                { "include": "#keywords" },
                { "include": "#types" },
                { "include": "#function-call" }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.triple.double.leash",
                    "begin": "\"\"\"",
                    "end": "\"\"\"",
                    "patterns": [
                        { "include": "#escape-sequence" },
                        { "include": "#interpolation" }
                    ]
                },
                {
                    "name": "string.quoted.triple.single.leash",
                    "begin": "'''",
                    "end": "'''",
                    "patterns": [
                        { "include": "#escape-sequence" }
                    ]
                },
                {
                    "name": "string.quoted.double.leash",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [
                        { "include": "#escape-sequence" },
                        { "include": "#interpolation" }
                    ]
                },
                {
                    "name": "string.quoted.single.leash",
                    "begin": "'",
                    "end": "'",
                    "patterns": [
                        { "include": "#escape-sequence" }
                    ]
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.leash",
                    "match": "\\b(return|if|else|unless|also|alsou|while|with|for|do|foreach|loop|in|stop|continue|empty|ignore|switch|case|default|defer|throw|works|otherwise|spawn)\\b"
                },
                {
                    "name": "keyword.declaration.leash",
                    "match": "\\b(fnc|def|struct|union|enum|class|type|template|macro|opdef|error|pub|priv|static|pubif|unsafe|nogc|as|inline|imut|create|del|extern|use|alias|worker|shared|fusion)\\b"
                },
                {
                    "name": "keyword.other.leash",
                    "match": "\\b(this|thisop|self|thisworker|is|isnt)\\b"
                }
            ]
        },
        "types": {
            "patterns": [
                {
                    "name": "support.type.bitwidth.leash",
                    "match": "\\b(int|uint|float)<\\d+>"
                },
                {
                    "name": "support.type.generic.leash",
                    "match": "\\b(array|vec|vector|hash|pointer|matrix)<[a-zA-Z0-9_,\\. ]+>"
                },
                {
                    "name": "support.type.leash",
                    "match": "\\b(int|uint|float|bool|string|char|void|array|vec|vector|hash|pointer|matrix)\\b"
                },
                {
                    "name": "entity.name.type.leash",
                    "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
                },
                {
                    "name": "keyword.operator.pointer.leash",
                    "match": "[*&](?=[a-zA-Z_])"
                }
            ]
        },
        "builtins": {
            "patterns": [
                {
                    "name": "support.function.builtin.leash",
                    "match": "\\b(show|showb|get|keyget|set|toint|tofloat|tounion|scast|tostring|cstr|lstr|normescape|sizeof|typeof|size|cur|name|pushb|popb|pushf|popf|insert|insertv|inserta|clear|remove|extend|extendv|isin|rand|randf|seed|choose|wait|timepass|exit|exec|inttobytes|bytestoint|floattobytes|bytestofloat|getKey|getkey|keys|values|push|pop|front|back|malloc|calloc|realloc|free|atoi|atol|atoll|strtol|strtoul|strtof|strtod|abs|labs|abort|atexit|getenv|qsort|bsearch|printf|sprintf|snprintf|fprintf|scanf|fscanf|sscanf|fopen|fclose|fread|fwrite|fgets|fputs|fgetc|fputc|ungetc|fseek|ftell|rewind|rename|remove|fflush|feof|perror|puts|getchar|putchar|tmpfile|setbuf|setvbuf|popen|pclose|fileno|strlen|strcpy|strncpy|strcat|strncat|strcmp|strncmp|strcasecmp|strchr|strrchr|strstr|strtok|strdup|memcpy|memmove|memset|memcmp|memchr|strpbrk|strspn|strcspn|isalnum|isalpha|iscntrl|isdigit|isgraph|islower|isprint|ispunct|isspace|isupper|isxdigit|tolower|toupper|sqrt|cbrt|fabs|ceil|floor|round|trunc|exp|log|log10|sin|cos|tan|asin|acos|atan|sinh|cosh|tanh|pow|atan2|fmod|clock|difftime|time|mktime|localtime|gmtime|asctime|ctime|panic|assert|swap|min|max|clamp|len|trim|split|join|replace|contains|startswith|endswith|upper|lower|substr|find|parseint|parsefloat|tobool|tochar|isnum|println|print)\\b"
                }
            ]
        },
        "constants": {
            "patterns": [
                {
                    "name": "constant.language.boolean.leash",
                    "match": "\\b(true|false)\\b"
                },
                {
                    "name": "constant.language.null.leash",
                    "match": "\\b(null|nil)\\b"
                },
                {
                    "name": "variable.language.builtin.leash",
                    "match": "\\b(_FILEPATH|_FILENAME|_PLATFORM|_ARGS)\\b"
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.hex.leash",
                    "match": "\\b0[xX][0-9a-fA-F]+(?:\\.[0-9a-fA-F]*)?(?:[pP][+-]?\\d+)?\\b"
                },
                {
                    "name": "constant.numeric.binary.leash",
                    "match": "\\b0[bB][01]+\\b"
                },
                {
                    "name": "constant.numeric.octal.leash",
                    "match": "\\b0[oO][0-7]+\\b"
                },
                {
                    "name": "constant.numeric.float.leash",
                    "match": "(?<![\\w.])[\\d]*\\.\\d+(?:[eE][+-]?\\d+)?|\\b\\d+(?:\\.\\d*)?[eE][+-]?\\d+"
                },
                {
                    "name": "constant.numeric.decimal.leash",
                    "match": "\\b\\d+\\b"
                }
            ]
        },
        "attributes": {
            "patterns": [
                {
                    "name": "meta.annotation.leash",
                    "begin": "@from\\s*\\(",
                    "end": "\\)",
                    "patterns": [
                        { "include": "#strings" }
                    ]
                },
                {
                    "name": "meta.annotation.leash",
                    "match": "@from\\b"
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.pointer.leash",
                    "match": "->"
                },
                {
                    "name": "keyword.operator.in.leash",
                    "match": "<>"
                },
                {
                    "name": "keyword.operator.namespace.leash",
                    "match": "::"
                },
                {
                    "name": "keyword.operator.assignment.leash",
                    "match": ":="
                },
                {
                    "name": "keyword.operator.leash",
                    "match": "\\|>|<<=|>>=|&&|\\|\\||<<|>>|\\+\\+|--|[+\\-*/%&|^~!<>=]=?"
                }
            ]
        },
        "function-call": {
            "patterns": [
                {
                    "name": "entity.name.function.definition.leash",
                    "match": "(?<=\\bfnc\\s+)[a-zA-Z_][a-zA-Z0-9_]*"
                },
                {
                    "name": "entity.name.function.leash",
                    "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*(?=\\s*\\()"
                }
            ]
        }
    }
}