use games::dice::Dice;
fnc main() : void {
    show(Dice.d6() >= 1 && Dice.d6() <= 6);
    show(Dice.d20() >= 1 && Dice.d20() <= 20);
    show(Dice.roll(8) >= 1 && Dice.roll(8) <= 8);
    s: int = Dice.roll_sum(3, 6);
    show(s >= 3 && s <= 18);
    r: vec<int> = Dice.rolls(5, 6);
    show(r.size);
}
